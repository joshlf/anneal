/-- **Closed non-vacuity canary for the two-layer retag alignment &
dereferenceability boundary** (`tbm_retag_ptr_raw_and_pinned_noop`,
`tbm_retag_ptr_ignores_alignment`, `tbm_retag_ptr_safe_dereferenceable_ub`,
`checkPtrM_tb_safe_vs_raw_boundary`, `checkPtrM_tb_safe_ok_iff`,
`tbm_retag_ptr_pointee_data_irrelevant`,
`evalStatementM_tb_validate_safe_vs_raw_boundary`; zero hypotheses):
1. `#[rustc_no_writable]` `&mut u32` (`fnIw = false`, `fnEntry = true`):
   - aligned out-of-bounds pointer (`addr = 264`, 4-byte aligned, just past 8-byte alloc `[256, 264)`)
     is rejected at BOTH `TreeBorrowsMemory.retag_ptr`
     (`"dereferencing pointer outside the bounds of its allocation"`) AND
     `checkPtrM` (`"Value::Ptr: non-dereferenceable safe pointer"`);
   - in-bounds misaligned pointer (`addr = 257`, `align = 4`) SUCCEEDS at bare
     `TreeBorrowsMemory.retag_ptr` (and agrees identically with `align = 1` via
     `tbm_retag_ptr_ignores_alignment`), yet FAILS with exact
     `.ub "Value::Ptr: unaligned safe pointer"` at `checkPtrM` even when
     `fn.implicit_writes = false`!
2. Misaligned ZST `#[rustc_no_writable]` `&mut ()` (`size = 0`, `align = 4`,
   `addr = 257`): accepted by bare `TreeBorrowsMemory.retag_ptr`, yet rejected by
   `checkPtrM` with exact `.ub "Value::Ptr: unaligned safe pointer"`!
3. Static `&S` preserved (`Ref .Immutable`) vs. erased (`Raw .None`):
   - preserved `&S` rejects OOB at BOTH `retag_ptr` and `checkPtrM`, and
     rejects misaligned in-bounds at `checkPtrM`;
   - erased `Raw .None` accepts null (`addr = 0`), misaligned (`addr = 257`),
     and OOB (`addr = 264`) unconditionally at BOTH `TreeBorrowsMemory.retag_ptr`
     AND `checkPtrM`!
4. Success side of `checkPtrM_tb_safe_ok_iff` (fired through its `←` direction, so
   all of its hypotheses and its right-hand side are jointly satisfiable): an
   aligned in-bounds `&mut u32` (`addr = 256`) via the live-in-bounds disjunct, and
   an `al = 1` ZST `&mut ()` one byte BELOW the base (`addr = 255`) via the
   `sz = 0` disjunct, both pass `checkPtrM`.
5. `tbm_retag_ptr_pointee_data_irrelevant` on two memories that genuinely differ
   (`.Init` bytes vs. eight `.Uninit` bytes, related by `TbmSameMetaDiffData`): the
   `#[rustc_no_writable]` `FnEntry` retag of the same `&mut u32` succeeds on both
   with the identical returned pointer and protector list, into post-states that
   are again `TbmSameMetaDiffData`-related. -/
theorem canary_retag_alignment_and_deref_boundary :
    let tbm8 : Gen.TreeBorrowsMemory Gen.x86_64 :=
      { params := ⟨true⟩
        mem := { allocations := [mkRootAllocTB (tbU32Bytes 1 ++ tbU32Bytes 2) 256 4 .Global],
                 _phantom := ⟨⟩ } }
    let m0 : MachTB := a2_mkSingleThreadMachTB tbm8
    let mutU32Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 [])
    let mutU32Al1Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 4 1 [])
    let zstAl4Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 4 [])
    let staticSRefTy : Gen.PtrType := .Ref .Immutable (staticPointeeInfoMR staticShapeCDesc 4)
    let ptrOob : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 264, provenance := some (⟨0⟩, []) } none
    let ptrMis : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 257, provenance := some (⟨0⟩, []) } none
    let ptrNull : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 0, provenance := none } none
    let ptrOk : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 256, provenance := some (⟨0⟩, []) } none
    let ptrBelow : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 255, provenance := some (⟨0⟩, []) } none
    let zstAl1Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 [])
    let tbm8Uninit : Gen.TreeBorrowsMemory Gen.x86_64 :=
      { params := ⟨true⟩
        mem := { allocations := [mkRootAllocTB (List.replicate 8 .Uninit) 256 4 .Global],
                 _phantom := ⟨⟩ } }
    -- 1. #[rustc_no_writable] &mut u32: OOB fails both; misaligned passes retag_ptr (ignoring align), fails checkPtrM
    TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOob mutU32Ty true false
        nwsrVtableLookup =
      .error (.ub "dereferencing pointer outside the bounds of its allocation") ∧
    checkPtrM ptrOob mutU32Ty (some m0) =
      .error (.ub "Value::Ptr: non-dereferenceable safe pointer") ∧
    (∃ r, TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Ty true false
        nwsrVtableLookup = .ok r ∧
      TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Al1Ty true false
        nwsrVtableLookup = .ok r) ∧
    checkPtrM ptrMis mutU32Ty (some m0) =
      .error (.ub "Value::Ptr: unaligned safe pointer") ∧
    -- 2. Misaligned ZST #[rustc_no_writable] &mut () fails checkPtrM
    (∃ r, TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis zstAl4Ty true false
        nwsrVtableLookup = .ok r) ∧
    checkPtrM ptrMis zstAl4Ty (some m0) =
      .error (.ub "Value::Ptr: unaligned safe pointer") ∧
    -- 3. Static &S preserved vs erased Raw .None
    TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOob staticSRefTy false true
        nwsrVtableLookup =
      .error (.ub "dereferencing pointer outside the bounds of its allocation") ∧
    checkPtrM ptrMis staticSRefTy (some m0) =
      .error (.ub "Value::Ptr: unaligned safe pointer") ∧
    TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrNull (.Raw .None) false true
        nwsrVtableLookup = .ok (ptrNull, tbm8, TreeBorrowsMemory.new_call) ∧
    checkPtrM ptrNull (.Raw .None) (some m0) = .ok () ∧
    checkPtrM ptrMis (.Raw .None) (some m0) = .ok () ∧
    checkPtrM ptrOob (.Raw .None) (some m0) = .ok () ∧
    -- 4. Success side of checkPtrM_tb_safe_ok_iff: aligned in-bounds &mut u32, and ZST &mut () below the base
    checkPtrM ptrOk mutU32Ty (some m0) = .ok () ∧
    checkPtrM ptrBelow zstAl1Ty (some m0) = .ok () ∧
    -- 5. Initialized vs. all-Uninit pointee bytes retag in exact lockstep
    TbmSameMetaDiffData tbm8 tbm8Uninit ∧
    (∃ p t1 t2 fe,
      TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
        nwsrVtableLookup = .ok (p, t1, fe) ∧
      TreeBorrowsMemory.retag_ptr tbm8Uninit TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
        nwsrVtableLookup = .ok (p, t2, fe) ∧
      TbmSameMetaDiffData t1 t2) := by
  dsimp only
  let tbm8 : Gen.TreeBorrowsMemory Gen.x86_64 :=
    { params := ⟨true⟩
      mem := { allocations := [mkRootAllocTB (tbU32Bytes 1 ++ tbU32Bytes 2) 256 4 .Global],
               _phantom := ⟨⟩ } }
  let tbm8Uninit : Gen.TreeBorrowsMemory Gen.x86_64 :=
    { params := ⟨true⟩
      mem := { allocations := [mkRootAllocTB (List.replicate 8 .Uninit) 256 4 .Global],
               _phantom := ⟨⟩ } }
  let ptrOk : Gen.Pointer Gen.TreeBorrowsProvenance :=
    ThinPointer.widen { addr := 256, provenance := some (⟨0⟩, []) } none
  let ptrBelow : Gen.Pointer Gen.TreeBorrowsProvenance :=
    ThinPointer.widen { addr := 255, provenance := some (⟨0⟩, []) } none
  let zstAl1Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 [])
  let m0 : MachTB := a2_mkSingleThreadMachTB tbm8
  let mutU32Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 [])
  let mutU32Al1Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 4 1 [])
  let zstAl4Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 4 [])
  let staticSRefTy : Gen.PtrType := .Ref .Immutable (staticPointeeInfoMR staticShapeCDesc 4)
  let ptrOob : Gen.Pointer Gen.TreeBorrowsProvenance :=
    ThinPointer.widen { addr := 264, provenance := some (⟨0⟩, []) } none
  let ptrMis : Gen.Pointer Gen.TreeBorrowsProvenance :=
    ThinPointer.widen { addr := 257, provenance := some (⟨0⟩, []) } none
  let ptrNull : Gen.Pointer Gen.TreeBorrowsProvenance :=
    ThinPointer.widen { addr := 0, provenance := none } none
  have h1 := ((tbm_retag_ptr_safe_dereferenceable_ub tbm8 TreeBorrowsMemory.new_call ptrOob
    (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 []) 4 ⟨4⟩ [] [true, true, true, true]
    rfl (by decide) rfl rfl mutU32Ty (Or.inr ⟨rfl, Or.inl rfl⟩) true false nwsrVtableLookup).2
    0 [] _ rfl rfl).2 rfl (Or.inr (by decide))
  have h2 := ((checkPtrM_tb_safe_vs_raw_boundary m0 ptrOob rfl (by decide)).2
    mutU32Ty (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 []) 4 ⟨4⟩ rfl rfl (by decide)).2.2.2
    (by decide) (by decide) rfl (by decide) (Or.inr ⟨0, [], _, rfl, rfl, Or.inr (Or.inr (by decide))⟩)
  have h4 := ((checkPtrM_tb_safe_vs_raw_boundary m0 ptrMis rfl (by decide)).2
    mutU32Ty (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 []) 4 ⟨4⟩ rfl rfl (by decide)).2.1
    (by decide) (by decide)
  have h6 := ((checkPtrM_tb_safe_vs_raw_boundary m0 ptrMis rfl (by decide)).2
    zstAl4Ty (pointeeInfoOfFacts ⟨true, true, true⟩ 0 4 []) 0 ⟨4⟩ rfl rfl (by decide)).2.1
    (by decide) (by decide)
  have h7 := ((tbm_retag_ptr_safe_dereferenceable_ub tbm8 TreeBorrowsMemory.new_call ptrOob
    (staticPointeeInfoMR staticShapeCDesc 4) 8 ⟨4⟩ [(⟨4⟩, ⟨4⟩)]
    [true, true, true, true, false, false, false, false]
    rfl (by decide) rfl rfl staticSRefTy (Or.inl rfl) false true nwsrVtableLookup).2
    0 [] _ rfl rfl).2 rfl (Or.inr (by decide))
  have h8 := ((checkPtrM_tb_safe_vs_raw_boundary m0 ptrMis rfl (by decide)).2
    staticSRefTy (staticPointeeInfoMR staticShapeCDesc 4) 8 ⟨4⟩ rfl rfl (by decide)).2.1
    (by decide) (by decide)
  have h9 := (tbm_retag_ptr_raw_and_pinned_noop tbm8 TreeBorrowsMemory.new_call ptrNull false true
    nwsrVtableLookup).1 .None
  have h10 := (checkPtrM_tb_safe_vs_raw_boundary m0 ptrNull rfl (by decide)).1
  have h11 := (checkPtrM_tb_safe_vs_raw_boundary m0 ptrMis rfl (by decide)).1
  have h12 := (checkPtrM_tb_safe_vs_raw_boundary m0 ptrOob rfl (by decide)).1
  have h3chk : (TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Ty true false
      nwsrVtableLookup).isOk = true := by decide +kernel
  have h3ign : TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Ty true false
        nwsrVtableLookup =
      TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Al1Ty true false
        nwsrVtableLookup :=
    (tbm_retag_ptr_ignores_alignment tbm8 TreeBorrowsMemory.new_call ptrMis
      ⟨4⟩ ⟨4⟩ ⟨1⟩ true true true [] true false nwsrVtableLookup).2.1
  have h3 : ∃ r, TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Ty true false
      nwsrVtableLookup = .ok r ∧
      TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Al1Ty true false
      nwsrVtableLookup = .ok r := by
    cases h : TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis mutU32Ty true false
        nwsrVtableLookup with
    | ok r => exact ⟨r, rfl, h3ign.symm.trans h⟩
    | error _ => rw [h] at h3chk; cases h3chk
  have h5chk : (TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis zstAl4Ty true false
      nwsrVtableLookup).isOk = true := by decide +kernel
  have h5 : ∃ r, TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis zstAl4Ty true false
      nwsrVtableLookup = .ok r := by
    cases h : TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrMis zstAl4Ty true false
        nwsrVtableLookup with
    | ok r => exact ⟨r, rfl⟩ | error _ => rw [h] at h5chk; cases h5chk
  have h13 : checkPtrM ptrOk mutU32Ty (some m0) = .ok () :=
    (checkPtrM_tb_safe_ok_iff m0 ptrOk rfl (by decide) mutU32Ty
      (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 []) 4 ⟨4⟩ rfl rfl (by decide)).mpr
      ⟨by decide, by decide, rfl, Or.inr ⟨0, [], _, rfl, rfl, rfl, by decide, by decide⟩⟩
  have h14 : checkPtrM ptrBelow zstAl1Ty (some m0) = .ok () :=
    (checkPtrM_tb_safe_ok_iff m0 ptrBelow rfl (by decide) zstAl1Ty
      (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 []) 0 ⟨1⟩ rfl rfl (by decide)).mpr
      ⟨by decide, by decide, rfl, Or.inl rfl⟩
  have h15 : TbmSameMetaDiffData tbm8 tbm8Uninit := by
    refine ⟨rfl, rfl, fun i a1 a2 h1 h2 => ?_⟩
    cases i with
    | zero => cases h1; cases h2; exact ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩
    | succ _ => cases h1
  have h16chk : (TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
      nwsrVtableLookup).isOk = true := by decide +kernel
  have h16 : ∃ p t1 t2 fe,
      TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
        nwsrVtableLookup = .ok (p, t1, fe) ∧
      TreeBorrowsMemory.retag_ptr tbm8Uninit TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
        nwsrVtableLookup = .ok (p, t2, fe) ∧
      TbmSameMetaDiffData t1 t2 := by
    cases h : TreeBorrowsMemory.retag_ptr tbm8 TreeBorrowsMemory.new_call ptrOk mutU32Ty true false
        nwsrVtableLookup with
    | error _ => rw [h] at h16chk; cases h16chk
    | ok r =>
      obtain ⟨p, t1, fe⟩ := r
      obtain ⟨t2, hr2, hs, _⟩ := (tbm_retag_ptr_pointee_data_irrelevant tbm8 tbm8Uninit h15
        TreeBorrowsMemory.new_call ptrOk mutU32Ty true false nwsrVtableLookup).2.2 p t1 fe h
      exact ⟨p, t1, t2, fe, rfl, hr2, hs⟩
  exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16⟩

/-- **Closed non-vacuity canary for `tbm_retag_ptr_zst_safe_skips_dereferenceable`**
(zero hypotheses) on a DEAD 4-byte allocation at `[256, 260)`, contrasting a
`#[rustc_no_writable]` `FnEntry` `&mut u8`, a `#[rustc_no_writable]` `FnEntry`
ZST `&mut ()`, and a raw pointer:
1. non-ZST `&mut u8` at `256`: exact `.ub "dereferencing pointer to dead allocation"`;
2. ZST `&mut ()` at `256` (inside the dead allocation) and at `100000` (far past
   its end): the retag SUCCEEDS and pushes the protector `(0, [0])`;
3. ZST `&mut ()` at `255` (one byte below the base): exact
   `.specPanic "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()"`;
4. ZST `&mut ()` without provenance at `255`, and a raw pointer at `255`: no-ops. -/
theorem canary_retag_ptr_zst_dead_oob_and_specPanic :
    let deadAlloc : Gen.Allocation Gen.Path Gen.TreeBorrowsAllocationExtra :=
      { mkRootAllocTB (tbU32Bytes 1) 256 4 .Global with live := false }
    let tbmD : Gen.TreeBorrowsMemory Gen.x86_64 :=
      { params := ⟨true⟩, mem := { allocations := [deadAlloc], _phantom := ⟨⟩ } }
    let zstTy : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 [])
    let u8Ty : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 1 1 [])
    let ptrAt : Int → Gen.Pointer Gen.TreeBorrowsProvenance := fun a =>
      ThinPointer.widen { addr := a, provenance := some (⟨0⟩, []) } none
    let ptrNoProv : Gen.Pointer Gen.TreeBorrowsProvenance :=
      ThinPointer.widen { addr := 255, provenance := none } none
    TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 256) u8Ty true false
        nwsrVtableLookup = .error (.ub "dereferencing pointer to dead allocation") ∧
    (∃ r, TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 256) zstTy true false
        nwsrVtableLookup = .ok r ∧
      TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 256) zstTy true true
        nwsrVtableLookup = .ok r ∧
      r.2.2.protectors = [(⟨0⟩, [0])]) ∧
    (∃ r, TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 100000) zstTy true false
        nwsrVtableLookup = .ok r ∧ r.2.2.protectors = [(⟨0⟩, [0])]) ∧
    TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 255) zstTy true false
        nwsrVtableLookup =
      .error (.specPanic "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()") ∧
    TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call ptrNoProv zstTy true false
        nwsrVtableLookup = .ok (ptrNoProv, tbmD, TreeBorrowsMemory.new_call) ∧
    TreeBorrowsMemory.retag_ptr tbmD TreeBorrowsMemory.new_call (ptrAt 255) (.Raw .None) true false
        nwsrVtableLookup = .ok (ptrAt 255, tbmD, TreeBorrowsMemory.new_call) := by
  dsimp only
  have hz := fun (p : Gen.Pointer Gen.TreeBorrowsProvenance) =>
    tbm_retag_ptr_zst_safe_skips_dereferenceable
      { params := ⟨true⟩, mem := { allocations :=
        [{ mkRootAllocTB (tbU32Bytes 1) 256 4 .Global with live := false }], _phantom := ⟨⟩ } }
      TreeBorrowsMemory.new_call p (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 []) ⟨1⟩ [] [] rfl rfl rfl
      (.Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 [])) (Or.inr ⟨rfl, Or.inl rfl⟩)
      true false nwsrVtableLookup
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact ((tbm_retag_ptr_safe_dereferenceable_ub _ TreeBorrowsMemory.new_call _
      (pointeeInfoOfFacts ⟨true, true, true⟩ 1 1 []) 1 ⟨1⟩ [] [true] rfl (by decide) rfl rfl
      _ (Or.inr ⟨rfl, Or.inl rfl⟩) true false nwsrVtableLookup).2 0 [] _ rfl rfl).1 rfl
  · have h256 := hz (ThinPointer.widen { addr := 256, provenance := some (⟨0⟩, []) } none)
    obtain ⟨_, _, _, _, _, _, _, hok⟩ := (h256.2.2 0 [] _ rfl rfl).2 (by decide) _ rfl
    exact ⟨_, hok, h256.1.symm.trans hok, rfl⟩
  · obtain ⟨_, _, _, _, _, _, _, hok⟩ :=
      ((hz (ThinPointer.widen { addr := 100000, provenance := some (⟨0⟩, []) } none)).2.2 0 [] _ rfl rfl).2
        (by decide) _ rfl
    exact ⟨_, hok, rfl⟩
  · exact ((hz (ThinPointer.widen { addr := 255, provenance := some (⟨0⟩, []) } none)).2.2 0 [] _ rfl
      rfl).1 (by decide)
  · exact (hz (ThinPointer.widen { addr := 255, provenance := none } none)).2.1 rfl
  · rfl

/-- Helper encoding a thin pointer into 8 `AbstractByte`s for `MachTB`
`Statement.Validate` canaries. -/
private def a3_encodeThinPtr (addr : Int) (prov : Option Gen.TreeBorrowsProvenance) :
    List (Gen.AbstractByte Gen.TreeBorrowsProvenance) :=
  match Endianness.encode x86_64.ENDIANNESS .Unsigned x86_64.PTR_SIZE addr with
  | some bs => encodePtrBytesM (M := TBM) prov 0 bs
  | none => []

/-- Minimal 1-frame `MachTB` state whose allocation `0` is a 4-byte allocation
at `[256, 260)` (`live := targetLive`, `data := targetData`) and whose allocation
`1` is local `_1 : .Ptr ptrTy` at `[512, 520)` storing `ptrBytes`, positioned to
execute `Statement.Validate (.Local (localName 1)) true` under
`Function.implicit_writes := fnIw`. -/
def mkValidateLocalMachTB (targetLive : Bool)
    (targetData : List (Gen.AbstractByte Gen.TreeBorrowsProvenance))
    (ptrTy : Gen.PtrType) (ptrBytes : List (Gen.AbstractByte Gen.TreeBorrowsProvenance))
    (fnIw : Bool) : MachTB :=
  let fn0 : Gen.Function := {
    locals := ⟨[(localName 0, unitTyMR), (localName 1, .Ptr ptrTy)]⟩
    args := []
    ret := localName 0
    calling_convention := .Rust
    blocks := ⟨[(bbName 0, ⟨[.Validate (.Local (localName 1)) true], .Return, .Regular⟩)]⟩
    start := bbName 0
    implicit_writes := fnIw
  }
  let alloc0 : Gen.Allocation Gen.Path Gen.TreeBorrowsAllocationExtra :=
    { mkRootAllocTB targetData 256 4 .Global with live := targetLive }
  let alloc1 : Gen.Allocation Gen.Path Gen.TreeBorrowsAllocationExtra :=
    mkRootAllocTB ptrBytes 512 8 .Stack
  let fr0 : Gen.StackFrame TBM := {
    func := fn0
    locals := ⟨[(localName 1, { addr := 512, provenance := some (⟨1⟩, []) })]⟩
    stack_pop_action := .BackToCaller none none { addr := 512, provenance := some (⟨1⟩, []) }
    next_block := bbName 0
    next_stmt := 0
    extra := TreeBorrowsMemory.new_call
  }
  { prog := { functions := ⟨[(fnName 0, fn0)]⟩, start := fnName 0, globals := ⟨[]⟩,
              traits := ⟨[]⟩, vtables := ⟨[]⟩ }
    mem := { memory := { params := ⟨true⟩, mem := { allocations := [alloc0, alloc1], _phantom := ⟨⟩ } },
             accesses := [] }
    intptrcast := ⟨⟨[]⟩⟩
    threads := [{ stack := [fr0], state := .Enabled, unwind_payloads := [] }]
    active_thread := 0
    synchronized_threads := ⟨[]⟩
    locks := []
    global_ptrs := ⟨[]⟩
    fn_ptrs := ⟨[]⟩
    vtable_ptrs := ⟨[]⟩
    stdout := ⟨[]⟩
    stderr := ⟨[]⟩ }

/-- **Closed `MachTB` `Statement.Validate` canary contrasting ZST alignment
(`al = 1` vs. `al = 4`), reachable ZST `specPanic`, raw pointers, and
uninitialized pointer vs. uninitialized pointee bytes** (zero hypotheses):
1. ZST `&mut ()` (`al = 1`) to DEAD alloc `0` at `addr = 256` and past-the-end
   `addr = 100000`: `evalStatementM` SUCCEEDS in `MachTB` and pushes protector `(0, [0])`;
2. ZST `&mut ()` (`al = 1`) at `addr = 255` (below base `256`): passes `checkPtrM`
   (the `sz = 0` disjunct of `checkPtrM_tb_safe_ok_iff`, fired in closed form by
   item 4 of `canary_retag_alignment_and_deref_boundary`) and reaches `.error (.specPanic
   "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()")` in real `MachTB`!;
3. ZST `&mut Align4Zst` (`al = 4`) at `addr = 255`: caught FIRST by `checkPtrM` as
   `.error (.ub "Value::Ptr: unaligned safe pointer")`;
4. ZST `&mut Align4Zst` (`al = 4`) at `addr = 252` (4-byte aligned, below base
   `256`): passes `checkPtrM` and reaches `.error (.specPanic
   "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()")` in real `MachTB`!;
5. Raw pointer `*const ()` (`PtrType.Raw .None`) at `addr = 255` (and at null `0`):
   `evalStatementM` SUCCEEDS with `0` protectors pushed;
6. Uninitialized pointer representation (`List.replicate 8 .Uninit` in `_1`):
   raises `.error (.ub "load at type but the data in memory violates the language invariant")`
   for BOTH safe `&mut ()` AND raw `*const ()` (firing `evalStatementM_tb_validate_uninit_ptr_ub`);
7. Uninitialized pointee bytes (`List.replicate 4 .Uninit` in live alloc `0`) with
   valid `&mut u32` in `_1`: `evalStatementM` SUCCEEDS under BOTH `#[rustc_no_writable]`
   (`fnIw = false`) and standard (`fnIw = true`), preserving `MachTB.wfLive` and
   leaving alloc `0`'s `.Uninit` bytes untouched (the `MachTB`-level counterpart of
   `tbm_retag_ptr_pointee_data_irrelevant`, which is itself fired in closed form by
   item 5 of `canary_retag_alignment_and_deref_boundary`). -/
theorem canary_machTB_validate_zst_align_uninit_and_specPanic :
    let zstAl1 : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 1 [])
    let zstAl4 : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 0 4 [])
    let mutU32 : Gen.PtrType := .Ref .Mutable (pointeeInfoOfFacts ⟨true, true, true⟩ 4 4 [])
    let rawTy : Gen.PtrType := .Raw .None
    let stmt : Gen.Statement := .Validate (.Local (localName 1)) true
    let mkDead := fun (ty : Gen.PtrType) (addr : Int) =>
      mkValidateLocalMachTB false (tbU32Bytes 1) ty (a3_encodeThinPtr addr (some (⟨0⟩, []))) false
    let mkUninitPtr := fun (ty : Gen.PtrType) =>
      mkValidateLocalMachTB true (tbU32Bytes 1) ty (List.replicate 8 .Uninit) false
    let mkUninitPointee := fun (fnIw : Bool) =>
      mkValidateLocalMachTB true (List.replicate 4 .Uninit) mutU32
        (a3_encodeThinPtr 256 (some (⟨0⟩, []))) fnIw
    (∃ m', evalStatementM (mkDead zstAl1 256) stmt = .ok m' ∧
      (m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some [(⟨0⟩, [0])]) ∧
    (∃ m', evalStatementM (mkDead zstAl1 100000) stmt = .ok m' ∧
      (m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some [(⟨0⟩, [0])]) ∧
    evalStatementM (mkDead zstAl1 255) stmt =
      .error (.specPanic "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()") ∧
    evalStatementM (mkDead zstAl4 255) stmt =
      .error (.ub "Value::Ptr: unaligned safe pointer") ∧
    evalStatementM (mkDead zstAl4 252) stmt =
      .error (.specPanic "Offset::from_bytes(ptr.addr - allocation.addr).unwrap()") ∧
    (∃ m', evalStatementM (mkDead rawTy 255) stmt = .ok m' ∧
      (m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some []) ∧
    (∃ m', evalStatementM (mkDead rawTy 0) stmt = .ok m' ∧
      (m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some []) ∧
    evalStatementM (mkUninitPtr zstAl1) stmt =
      .error (.ub "load at type but the data in memory violates the language invariant") ∧
    evalStatementM (mkUninitPtr rawTy) stmt =
      .error (.ub "load at type but the data in memory violates the language invariant") ∧
    (∃ m', evalStatementM (mkUninitPointee false) stmt = .ok m' ∧ MachTB.wfLive m' ∧
      m'.mem.memory.mem.allocations[0]?.map (·.data) = some (List.replicate 4 .Uninit)) ∧
    (∃ m', evalStatementM (mkUninitPointee true) stmt = .ok m' ∧ MachTB.wfLive m' ∧
      m'.mem.memory.mem.allocations[0]?.map (·.data) = some (List.replicate 4 .Uninit)) := by
  dsimp only
  have hokProt : ∀ (m : MachTB) (expected : List (Gen.AllocId × Gen.Path)),
      (match evalStatementM m (.Validate (.Local (localName 1)) true) with
       | .ok m' => decide ((m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some expected)
       | .error _ => false) = true →
      ∃ m', evalStatementM m (.Validate (.Local (localName 1)) true) = .ok m' ∧
        (m'.threads[0]?.bind (fun t => t.stack.getLast?)).map (·.extra.protectors) = some expected := by
    intro m expected h
