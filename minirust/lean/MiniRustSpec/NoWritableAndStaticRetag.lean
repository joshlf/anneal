  dsimp only
  cases hpv : selectFnEntryPolicy facts kind attrs with
  | skipRetag => exact absurd hpv hpolNotSkip
  | rustcNoWritable =>
    have hnew' : ReborrowSettings.new lookup ptr (ptrTypeOfParamKind kind info) true tbm.params
