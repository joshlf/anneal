      · rename_i m2 hst
        obtain ⟨m3, hm3, h⟩ := nwsr_bind_ok h
        obtain rfl := d1_pure_ok hm3
        exact d1_initFrameArgsM_tb_wfLive frame ls args (typedStoreM_tb_wfLive hwf hst) h
      all_goals
        obtain ⟨_, hbad, _⟩ := nwsr_bind_ok h
