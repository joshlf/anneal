            change n'.isProtected (w.activeProtectors.filter (· != protId)) = true at hp''
            rw [hisP] at hp''; cases hp''
          · have hprotNe : n'.protector ≠ some protId := hnm.2.2.1.symm ▸ hprotUnique n hn htagNe
