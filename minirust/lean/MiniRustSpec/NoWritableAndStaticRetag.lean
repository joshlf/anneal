private theorem d1_cm_tb_end_call_wfLive_choiceFree {cm cm' : Gen.ConcurrentMemory TBM}
    {extra : Gen.TreeBorrowsFrameExtra}
    (hwf : TreeBorrowsMemory.wfLive cm.memory)
    (h : ConcurrentMemory.end_call cm extra = .ok cm') :
