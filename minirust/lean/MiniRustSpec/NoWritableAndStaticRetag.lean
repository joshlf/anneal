    (htbmParams : tbm.params = ⟨attrs.implicitWrites⟩)
    (id : Nat) (alloc : Gen.Allocation Gen.Path Gen.TreeBorrowsAllocationExtra)
    (off len align : Nat) (hlen : 0 < len)
