  nextTag := 4
  nextProtector := 10

/-- MiniRust borrow tree mirroring `endCallDivWorld` with child `[1, 0]` holding `childPerm`. -/
def endCallDivTreeMR (childPerm : Gen.Permission) : Gen.Node :=
