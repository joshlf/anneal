        .storageLive 4,
        .assign { local_ := 2, projection := [] } (.ref (.mut false) { local_ := 1, projection := [] }),
        .assign { local_ := 3, projection := [] } (.ref .shared { local_ := 1, projection := [] })
      ] : List StatementKind).map (fun k => { kind := k, span := "witness" })
      terminator := {
        kind := .call
          (.constant {
