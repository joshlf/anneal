        simp only [stepNodeOnRangeRead, hov, Bool.not_true, Bool.false_eq_true, ↓reduceIte] at herr
        cases herr
    | disabled =>
      cases isLocal <;> refine ⟨.Prot .Disabled, rfl, ?_, ?_⟩
      · intro n' hok
