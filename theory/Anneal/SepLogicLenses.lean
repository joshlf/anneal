/-! ## 4. Relational `TypedAt` / `DisjointSlice` Lenses Over Trusted `AbstractByte`s

Byte-addressed views of one allocation (`ByteMem := List AbstractByte`) whose reads
and writes are the *trusted* `sliceAbstractBytes` / `writeAbstractBytesAt`
primitives (closed forms `sliceAbstractBytes_eq`, `writeAbstractBytesAt_eq_splice`,
`writeAbstractBytesAt_eq_none`, `writeAbstractBytesAt_some_inv`).

* `ByteLensCodec α width` is a fixed-width byte codec (`unit`, `u8`, `uintLE`,
  `u16LE`, `u32LE`, `prod`, `padUninit`, `padRight`, and the padded pair
  `laidOutPair`), bridged to scalar and boolean `ValueCodec`s through the trusted
  `encodeScalarBytes` / `decodeScalarBytes` (`encodeScalarBytes_uintLE_encode`,
  `decodeScalarBytes_uintLE_encode`, `valueCodec_uintLE_bridge`,
  `scalarNatValueCodec_uintLE_bridge`, `rustBool_u8_bridge`).
* `TypedAt c base v mem` is *relational* (the `width`-byte window at `base`
  decodes to `v`), so padding may hold arbitrary bytes; `CanonicalAt` is the
  exact-encoding variant. Frame laws (`TypedAt.frame_write`,
  `TypedAt.frame_writeBytes`, `TypedAt.frame_write_adjacent`) take `O(1)` rewrite
  steps and never unfold a codec or a byte list.
* Padded structs: `typedAt_laidOutPair_iff`, `typedAt_laidOutPair_write_fst`,
  `typedAt_laidOutPair_write_snd`, `typedAt_laidOutPair_padding_write`,
  `typedAt_laidOutPair_init_padding`, `typedAt_laidOutPair_of_fieldsValid`, and
  `typedAt_laidOutPair_applyFieldWrites`.
* Lens bridges: `fieldLens` / `FieldsValid` give `LawfulMutLens` and
  `IndependentLenses` witnesses (`subplaceFieldLens_disjoint`, `structLens_lawful`
  via `prodMutLens_lawful`), `subplaceFieldLens_of_borrowSubplace_disjointOn`
  connects `BorrowSubplace.disjointOn` to `DisjointSlice`, and `applyFieldWrites_spec`
  discharges `K` sequential field writes with one lens law each. Relational
  `FieldsTyped` (`applyFieldWrites_fieldsTyped_spec`) covers field codecs with
  initialized internal padding, where `LawfulMutLens` provably fails
  (`not_lawfulMutLens_fieldLens_laidOutPair_typedAt`).
-/

section TypedAtLenses

private theorem takeAbstractBytes_eq_take :
    ∀ (n : Nat) (bs : List AbstractByte), takeAbstractBytes n bs = bs.take n
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, b :: bs => congrArg (b :: ·) (takeAbstractBytes_eq_take k bs)

private theorem dropAbstractBytes_eq_drop :
    ∀ (n : Nat) (bs : List AbstractByte), dropAbstractBytes n bs = bs.drop n
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, _ :: bs => dropAbstractBytes_eq_drop k bs

/-! ### Fixed-width byte codecs (`ByteLensCodec`) -/

/-- A fixed-width codec between values of type `α` and `width`-byte windows of
trusted `AbstractByte`s. Unlike `ValueCodec` (which encodes into MIR `Value`s), a
`ByteLensCodec` describes the in-memory byte representation read by
`sliceAbstractBytes` and written by `writeAbstractBytesAt`. -/
structure ByteLensCodec (α : Type) (width : Nat) : Type where
  /-- Serialize a value into exactly `width` bytes. -/
  encode : α → List AbstractByte
  /-- Attempt to deserialize a value from a byte window. -/
  decode : List AbstractByte → Option α
  /-- Every encoding is exactly `width` bytes long. -/
  encode_len : ∀ x : α, (encode x).length = width
  /-- Decoding an encoding recovers the value. -/
  decode_encode : ∀ x : α, decode (encode x) = some x

namespace ByteLensCodec

/-- The byte width of a codec. -/
@[reducible] def width {α : Type} {n : Nat} (_ : ByteLensCodec α n) : Nat := n

theorem encode_injective {α : Type} {n : Nat} (c : ByteLensCodec α n) {x y : α}
    (h : c.encode x = c.encode y) : x = y := by
  have hx := c.decode_encode x
  rw [h, c.decode_encode y] at hx
  exact (Option.some.inj hx).symm

/-- Zero-width codec for `Unit`. -/
def unit : ByteLensCodec Unit 0 where
  encode _ := []
  decode bs := match bs with | [] => some () | _ :: _ => none
  encode_len _ := rfl
  decode_encode _ := rfl

/-- Single-byte `u8` codec (rejecting `.uninit` and wrong-length windows). -/
def u8 : ByteLensCodec UInt8 1 where
  encode b := [.init b none]
  decode bs := match bs with | [.init b _] => some b | _ => none
  encode_len _ := rfl
  decode_encode _ := rfl

theorem length_encodeLE : ∀ (bits sz : Nat) (prov : Option (Nat × Nat)),
    (encodeLittleEndianBytes bits sz prov).length = sz
  | _, 0, _ => rfl
  | bits, sz + 1, prov => congrArg (· + 1) (length_encodeLE (Nat.div bits 256) sz prov)

/-- The trusted little-endian decoder inverts the trusted encoder below `256 ^ sz`. -/
theorem decodeLE_encodeLE : ∀ (sz bits : Nat) (prov : Option (Nat × Nat)), bits < 256 ^ sz →
    (decodeLittleEndianBytes (encodeLittleEndianBytes bits sz prov)).map Prod.fst = some bits
  | 0, bits, _, h => by
    have h0 : bits = 0 := Nat.lt_one_iff.mp h
    subst h0
    rfl
  | sz + 1, bits, prov, h => by
    have hlt : Nat.div bits 256 < 256 ^ sz :=
      (Nat.div_lt_iff_lt_mul (by decide)).mpr (by rw [Nat.pow_succ] at h; exact h)
    have ih := decodeLE_encodeLE sz (Nat.div bits 256) prov hlt
    have hb : (UInt8.ofNat bits).toBitVec.toNat = bits % 256 := BitVec.toNat_ofNat bits 8
    show (match decodeLittleEndianBytes (encodeLittleEndianBytes (Nat.div bits 256) sz prov) with
      | some (highBits, restProv) =>
          some (Nat.add (UInt8.ofNat bits).toBitVec.toNat (Nat.mul 256 highBits),
            mergeByteProvenance prov restProv)
      | none => none).map Prod.fst = some bits
    cases hd : decodeLittleEndianBytes (encodeLittleEndianBytes (Nat.div bits 256) sz prov) with
    | none => rw [hd] at ih; exact absurd ih (fun h' => nomatch h')
    | some p =>
      obtain ⟨hi, rp⟩ := p
      rw [hd] at ih
      have hhi : hi = Nat.div bits 256 := Option.some.inj ih
      subst hhi
      show some (Nat.add (UInt8.ofNat bits).toBitVec.toNat (Nat.mul 256 (Nat.div bits 256))) = some bits
      rw [hb]
      exact congrArg some (Nat.mod_add_div bits 256)

/-- Little-endian unsigned codec of byte width `sz` over the trusted
`encodeLittleEndianBytes` / `decodeLittleEndianBytes` (values below `256 ^ sz`). -/
def uintLE (sz : Nat) : ByteLensCodec {v : Nat // v < 256 ^ sz} sz where
  encode v := encodeLittleEndianBytes v.val sz none
  decode bs :=
    match decodeLittleEndianBytes bs with
    | some (v, _) => if h : v < 256 ^ sz then some ⟨v, h⟩ else none
    | none => none
  encode_len v := length_encodeLE v.val sz none
  decode_encode v := by
    have hd := decodeLE_encodeLE sz v.val none v.property
    cases he : decodeLittleEndianBytes (encodeLittleEndianBytes v.val sz none) with
    | none => rw [he] at hd; exact absurd hd (fun h' => nomatch h')
    | some p =>
      obtain ⟨w, rp⟩ := p
      rw [he] at hd
      have hw : w = v.val := Option.some.inj hd
      subst hw
      show (if h : v.val < 256 ^ sz then some ⟨v.val, h⟩ else none) = some v
      rw [dite_eq_left v.property]

/-- Little-endian `u16` codec. -/
abbrev u16LE : ByteLensCodec {v : Nat // v < 256 ^ 2} 2 := uintLE 2

/-- Little-endian `u32` codec. -/
abbrev u32LE : ByteLensCodec {v : Nat // v < 256 ^ 4} 4 := uintLE 4

/-- Little-endian `u64` codec. -/
abbrev u64LE : ByteLensCodec {v : Nat // v < 256 ^ 8} 8 := uintLE 8

/-- **Trusted scalar-encoder bridge**: the trusted `encodeScalarBytes` maps the
scalar `{ bits := v, sizeBytes := sz }` to the `uintLE sz` byte encoding of `v`. -/
theorem encodeScalarBytes_uintLE_encode {sz : Nat} (hsz : 0 < sz)
    (v : {v : Nat // v < 256 ^ sz}) :
    encodeScalarBytes { bits := v.val, sizeBytes := sz } none = some ((uintLE sz).encode v) := by
  obtain ⟨k, rfl⟩ : ∃ k, sz = k + 1 := ⟨sz - 1, (Nat.succ_pred_eq_of_pos hsz).symm⟩
  rfl

/-- **Trusted scalar-decoder bridge**: the trusted `decodeScalarBytes` decodes the
`uintLE sz` bytes of `v` to the scalar `{ bits := v, sizeBytes := sz }`. -/
theorem decodeScalarBytes_uintLE_encode {sz : Nat} (hsz : 0 < sz)
    (v : {v : Nat // v < 256 ^ sz}) :
    ∃ prov, decodeScalarBytes ((uintLE sz).encode v) =
      some ({ bits := v.val, sizeBytes := sz }, prov) := by
  obtain ⟨k, rfl⟩ : ∃ k, sz = k + 1 := ⟨sz - 1, (Nat.succ_pred_eq_of_pos hsz).symm⟩
  have hd := decodeLE_encodeLE (k + 1) v.val none v.property
  cases he : decodeLittleEndianBytes (encodeLittleEndianBytes v.val (k + 1) none) with
  | none => rw [he] at hd; exact absurd hd (fun h' => nomatch h')
  | some p =>
    obtain ⟨w, rp⟩ := p
    rw [he] at hd
    have hw : w = v.val := Option.some.inj hd
    subst hw
    refine ⟨rp, ?_⟩
    have hds : ∀ bytes : List AbstractByte, Trusted.Sequence.length bytes = k + 1 →
        decodeLittleEndianBytes bytes = some (v.val, rp) →
        decodeScalarBytes bytes = some ({ bits := v.val, sizeBytes := k + 1 }, rp) := by
      intro bytes hl hd'
      unfold decodeScalarBytes
      rw [hl]
      show (match decodeLittleEndianBytes bytes with
        | some (bits, prov) => some (({ bits := bits, sizeBytes := k + 1 } : ScalarVal), prov)
        | none => none) = _
      rw [hd']
    exact hds _ ((uintLE (k + 1)).encode_len v) he

/-- **Bridge to `ValueCodec`**: for every value codec that encodes `n` as the scalar
`{ bits := n, sizeBytes := sz }` and decodes it back (such as `scalarNatValueCodec sz`),
the trusted scalar byte encoding of `vc.encode v` is the `uintLE sz` encoding of `v`,
and decoding those bytes with `decodeScalarBytes` and then `vc` recovers `v`. -/
theorem valueCodec_uintLE_bridge (vc : ValueCodec Nat) {sz : Nat} (hsz : 0 < sz)
    (henc : ∀ n, vc.encode n = .scalar { bits := n, sizeBytes := sz })
    (hdec : ∀ n, vc.decode (.scalar { bits := n, sizeBytes := sz }) = some n)
    (v : {v : Nat // v < 256 ^ sz}) :
    (∃ sc, vc.encode v.val = .scalar sc ∧ encodeScalarBytes sc none = some ((uintLE sz).encode v)) ∧
      ∃ sc prov, decodeScalarBytes ((uintLE sz).encode v) = some (sc, prov) ∧
        vc.decode (.scalar sc) = some v.val := by
  obtain ⟨prov, hds⟩ := decodeScalarBytes_uintLE_encode hsz v
  exact ⟨⟨_, henc v.val, encodeScalarBytes_uintLE_encode hsz v⟩,
    ⟨_, prov, hds, hdec v.val⟩⟩

/-- Constructive (`⊆ {propext, Quot.sound}`) fixed-width unsigned scalar `Nat`
`ValueCodec` whose `encode`, `decode`, and `default` fields are definitionally
(`rfl`) identical to `ValueCodec.scalarNat`, while proving `decode_encode` via
`nat_beq_self_eq_true` (`decide_eq_true rfl`) rather than classical `beq_self_eq_true`. -/
def scalarNatValueCodec (sizeBytes : Nat) : ValueCodec Nat where
  encode n := .scalar { bits := n, sizeBytes := sizeBytes }
  decode
    | .scalar sc => if sc.sizeBytes == sizeBytes then some sc.bits else none
    | _ => none
  default := 0
  decode_encode n := by
    show (if (sizeBytes == sizeBytes) = true then some n else none) = some n
    rw [nat_beq_self_eq_true, ite_eq_left rfl]

/-- **Concrete scalar `ValueCodec` ↔ `uintLE` bridge**: `scalarNatValueCodec sz`
encodes and decodes identically to `ByteLensCodec.uintLE sz` across trusted
`encodeScalarBytes` / `decodeScalarBytes` for every `sz > 0`. -/
theorem scalarNatValueCodec_uintLE_bridge {sz : Nat} (hsz : 0 < sz)
    (v : {v : Nat // v < 256 ^ sz}) :
    (∃ sc, (scalarNatValueCodec sz).encode v.val = .scalar sc ∧
        encodeScalarBytes sc none = some ((uintLE sz).encode v)) ∧
      ∃ sc prov, decodeScalarBytes ((uintLE sz).encode v) = some (sc, prov) ∧
        (scalarNatValueCodec sz).decode (.scalar sc) = some v.val :=
  valueCodec_uintLE_bridge (scalarNatValueCodec sz) hsz (fun _ => rfl)
    (fun n => (scalarNatValueCodec sz).decode_encode n) v

/-- **Concrete `ValueCodec.rustBool` ↔ `ByteLensCodec.u8` bridge**: the live
`ValueCodec.rustBool` encodes `b : Bool` to `.scalar (boolToScalar b)`, whose
trusted byte encoding equals `ByteLensCodec.u8.encode (UInt8.ofNat (boolToScalar b).bits)`
and round-trips through `decodeScalarBytes` and `ValueCodec.rustBool.decode`. -/
theorem rustBool_u8_bridge (b : Bool) :
    let byte : UInt8 := UInt8.ofNat (boolToScalar b).bits
    (ValueCodec.rustBool.encode b = .scalar (boolToScalar b) ∧
      encodeScalarBytes (boolToScalar b) none = some (u8.encode byte)) ∧
      ∃ sc prov, decodeScalarBytes (u8.encode byte) = some (sc, prov) ∧
        ValueCodec.rustBool.decode (.scalar sc) = some b := by
  cases b <;> exact ⟨⟨rfl, rfl⟩, _, none, rfl, rfl⟩

/-- Contiguous product of two fixed-width codecs (exact-width decode). -/
def prod {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁) (c₂ : ByteLensCodec β n₂) :
    ByteLensCodec (α × β) (n₁ + n₂) where
  encode p := c₁.encode p.1 ++ c₂.encode p.2
  decode bs :=
    match Nat.beq bs.length (n₁ + n₂) with
    | false => none
    | true =>
      match c₁.decode (bs.take n₁), c₂.decode (bs.drop n₁) with
      | some a, some b => some (a, b)
      | _, _ => none
  encode_len p := by rw [List.length_append, c₁.encode_len p.1, c₂.encode_len p.2]
  decode_encode p := by
    obtain ⟨a, b⟩ := p
    have hLen : (c₁.encode a ++ c₂.encode b).length = n₁ + n₂ := by
      rw [List.length_append, c₁.encode_len a, c₂.encode_len b]
    have hBeq : Nat.beq (c₁.encode a ++ c₂.encode b).length (n₁ + n₂) = true :=
      Nat.beq_eq.mpr hLen
    dsimp only
    rw [hBeq]
    dsimp only
    rw [List.take_left' (c₁.encode_len a), List.drop_left' (c₁.encode_len a),
      c₁.decode_encode a, c₂.decode_encode b]

theorem length_replicateUninitBytes : ∀ n : Nat, (replicateUninitBytes n).length = n
  | 0 => rfl
  | n + 1 => congrArg (· + 1) (length_replicateUninitBytes n)

theorem replicateUninitBytes_eq_replicate : ∀ n : Nat,
    replicateUninitBytes n = List.replicate n .uninit
  | 0 => rfl
  | n + 1 => congrArg (AbstractByte.uninit :: ·) (replicateUninitBytes_eq_replicate n)

/-- Uninitialized padding of width `pad`: encodes to `.uninit` bytes and accepts
every `pad`-byte window. -/
def padUninit (pad : Nat) : ByteLensCodec Unit pad where
  encode _ := replicateUninitBytes pad
  decode bs := if Nat.beq bs.length pad then some () else none
  encode_len _ := length_replicateUninitBytes pad
  decode_encode _ := by
    show (if Nat.beq (replicateUninitBytes pad).length pad then some () else none) = some ()
    rw [length_replicateUninitBytes, Nat.beq_refl]
    rfl

/-- Append `pad` uninitialized padding bytes after `c`. -/
def padRight {α : Type} {n : Nat} (c : ByteLensCodec α n) (pad : Nat) :
    ByteLensCodec α (n + pad) where
  encode x := c.encode x ++ replicateUninitBytes pad
  decode bs := ((prod c (padUninit pad)).decode bs).map Prod.fst
  encode_len x := by rw [List.length_append, c.encode_len, length_replicateUninitBytes]
  decode_encode x := by
    show ((prod c (padUninit pad)).decode ((prod c (padUninit pad)).encode (x, ()))).map
      Prod.fst = some x
    rw [(prod c (padUninit pad)).decode_encode]
    rfl

theorem padRight_encode_eq {α : Type} {n : Nat} (c : ByteLensCodec α n) (pad : Nat) (x : α) :
    (padRight c pad).encode x = c.encode x ++ replicateUninitBytes pad := rfl

/-- Slicing at offset `pre.length` for width `n` recovers `c.encode x` verbatim. -/
theorem sliceAbstractBytes_append_encode {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (pre post : List AbstractByte) (x : α) :
    sliceAbstractBytes (pre ++ c.encode x ++ post) pre.length n = some (c.encode x) := by
  have hLen : pre.length + n ≤ (pre ++ c.encode x ++ post).length := by
    simp only [List.length_append, c.encode_len x]
    omega
  have hBle : Nat.ble (Nat.add pre.length n) (Trusted.Sequence.length (pre ++ c.encode x ++ post)) =
      true := Nat.ble_eq_true_of_le hLen
  unfold sliceAbstractBytes
  rw [hBle]
  dsimp only
  rw [takeAbstractBytes_eq_take, dropAbstractBytes_eq_drop, List.append_assoc,
    List.drop_left' rfl, List.take_left' (c.encode_len x)]

end ByteLensCodec

/-! ### Byte memory, splices, and the trusted byte primitives -/

/-- Byte-addressed memory of one allocation (trusted `AbstractByte`s). -/
abbrev ByteMem := List AbstractByte

/-- Pure splice `buf[off, off + w.length) := w`. -/
def splice {α : Type} (buf : List α) (off : Nat) (w : List α) : List α :=
  buf.take off ++ w ++ buf.drop (off + w.length)

theorem length_splice {α : Type} {buf w : List α} {off : Nat}
    (h : off + w.length ≤ buf.length) : (splice buf off w).length = buf.length := by
  simp only [splice, List.length_append, List.length_take, List.length_drop]
  omega

theorem getElem?_slice {α : Type} (buf : List α) (off len i : Nat) :
    ((buf.drop off).take len)[i]? = if i < len then buf[off + i]? else none := by
  by_cases hi : i < len
  · simp [hi, List.getElem?_drop]
  · simp [List.getElem?_take, hi]

theorem getElem?_splice {α : Type} {buf w : List α} {off : Nat}
    (h : off + w.length ≤ buf.length) (i : Nat) :
    (splice buf off w)[i]? =
      if i < off then buf[i]? else if i < off + w.length then w[i - off]? else buf[i]? := by
  unfold splice
  have htake : (buf.take off).length = off := by simp only [List.length_take]; omega
  by_cases h1 : i < off
  · rw [ite_eq_left h1, List.append_assoc, List.getElem?_append_left (by omega), List.getElem?_take]
    simp [h1]
  · rw [ite_eq_right h1]
    by_cases h2 : i < off + w.length
    · rw [ite_eq_left h2, List.getElem?_append_left (by simp only [List.length_append, htake]; omega),
        List.getElem?_append_right (by omega), htake]
    · rw [ite_eq_right h2, List.getElem?_append_right (by simp only [List.length_append, htake]; omega),
        List.getElem?_drop]
      simp only [List.length_append, htake]
      congr 1
      omega

/-- Constructive `drop`/`take` interchange (the core `List.drop_take` is classical). -/
theorem drop_take_add {α : Type} : ∀ (l : List α) (m k : Nat), (l.take (m + k)).drop m = (l.drop m).take k
  | l, 0, k => by rw [Nat.zero_add, List.drop_zero, List.drop_zero]
  | [], m + 1, k => by simp only [List.take_nil, List.drop_nil]
  | x :: xs, m + 1, k => by
    rw [Nat.add_right_comm, List.take_succ_cons, List.drop_succ_cons, List.drop_succ_cons]
    exact drop_take_add xs m k

/-- Reading back a spliced window returns the written bytes. -/
theorem slice_splice_same {α : Type} {buf w : List α} {off : Nat}
    (h : off + w.length ≤ buf.length) :
    ((splice buf off w).drop off).take w.length = w := by
  apply List.ext_getElem?
  intro i
  rw [getElem?_slice]
  by_cases hi : i < w.length
  · rw [ite_eq_left hi, getElem?_splice h, ite_eq_right (by omega), ite_eq_left (by omega)]
    congr 1
    omega
  · rw [ite_eq_right hi]
    exact (List.getElem?_eq_none (by omega)).symm

/-- Splicing preserves every disjoint window. -/
theorem slice_splice_disjoint {α : Type} {buf w : List α} {off₁ off₂ len₂ : Nat}
    (h : off₁ + w.length ≤ buf.length)
    (hd : w.length = 0 ∨ len₂ = 0 ∨ off₁ + w.length ≤ off₂ ∨ off₂ + len₂ ≤ off₁) :
    ((splice buf off₁ w).drop off₂).take len₂ = (buf.drop off₂).take len₂ := by
  apply List.ext_getElem?
  intro i
  rw [getElem?_slice, getElem?_slice]
  by_cases hi : i < len₂
  · rw [ite_eq_left hi, ite_eq_left hi, getElem?_splice h]
    by_cases h1 : off₂ + i < off₁
    · rw [ite_eq_left h1]
    · rw [ite_eq_right h1, ite_eq_right (by omega)]
  · rw [ite_eq_right hi, ite_eq_right hi]

/-- Writing back the bytes already present is the identity. -/
theorem splice_self {α : Type} {buf w : List α} {off : Nat}
    (h : off + w.length ≤ buf.length) (hw : (buf.drop off).take w.length = w) :
    splice buf off w = buf := by
  apply List.ext_getElem?
  intro i
  rw [getElem?_splice h]
  by_cases h1 : i < off
  · rw [ite_eq_left h1]
  · rw [ite_eq_right h1]
    by_cases h2 : i < off + w.length
    · rw [ite_eq_left h2, ← hw, getElem?_slice, ite_eq_left (by omega)]
      congr 1
      omega
    · rw [ite_eq_right h2]

/-- A second splice at the same window overrides the first. -/
theorem splice_splice_same {α : Type} {buf w₁ w₂ : List α} {off : Nat}
    (h : off + w₁.length ≤ buf.length) (hlen : w₂.length = w₁.length) :
    splice (splice buf off w₁) off w₂ = splice buf off w₂ := by
  have h₂ : off + w₂.length ≤ buf.length := by omega
  have h' : off + w₂.length ≤ (splice buf off w₁).length := by rw [length_splice h]; exact h₂
  apply List.ext_getElem?
  intro i
  rw [getElem?_splice h' i, getElem?_splice h₂ i, getElem?_splice h i, hlen]
  by_cases h1 : i < off <;> by_cases h2 : i < off + w₁.length <;> simp only [h1, h2, ↓reduceIte]

/-- Splices at disjoint windows commute. -/
theorem splice_comm {α : Type} {buf w₁ w₂ : List α} {off₁ off₂ : Nat}
    (h₁ : off₁ + w₁.length ≤ buf.length) (h₂ : off₂ + w₂.length ≤ buf.length)
    (hd : off₁ + w₁.length ≤ off₂ ∨ off₂ + w₂.length ≤ off₁) :
    splice (splice buf off₁ w₁) off₂ w₂ = splice (splice buf off₂ w₂) off₁ w₁ := by
  have h₂' : off₂ + w₂.length ≤ (splice buf off₁ w₁).length := by rw [length_splice h₁]; exact h₂
  have h₁' : off₁ + w₁.length ≤ (splice buf off₂ w₂).length := by rw [length_splice h₂]; exact h₁
  apply List.ext_getElem?
  intro i
  rw [getElem?_splice h₂', getElem?_splice h₁', getElem?_splice h₁, getElem?_splice h₂]
  by_cases a1 : i < off₁ <;> by_cases a2 : i < off₂ <;>
    by_cases b1 : i < off₁ + w₁.length <;> by_cases b2 : i < off₂ + w₂.length <;>
    simp only [a1, a2, b1, b2, ↓reduceIte] <;> (exfalso; omega)

/-- Closed form of the trusted `sliceAbstractBytes`. -/
theorem sliceAbstractBytes_eq (bytes : ByteMem) (off len : Nat) :
    sliceAbstractBytes bytes off len =
      if off + len ≤ bytes.length then some ((bytes.drop off).take len) else none := by
  unfold sliceAbstractBytes
  simp only [takeAbstractBytes_eq_take, dropAbstractBytes_eq_drop]
  split
  · next h =>
    have hgt : ¬ off + len ≤ bytes.length := fun hle => by
      have h2 : Nat.ble (Nat.add off len) (Trusted.Sequence.length bytes) = true :=
        Nat.ble_eq_true_of_le hle
      rw [h] at h2
      exact Bool.false_ne_true h2
    rw [ite_eq_right hgt]
  · next h =>
    have hle : off + len ≤ bytes.length := Nat.le_of_ble_eq_true h
    rw [ite_eq_left hle]

private theorem writeAbstractBytesAt_cons :
    ∀ (buf : ByteMem) (off : Nat) (x : AbstractByte) (ws : ByteMem),
      writeAbstractBytesAt buf off (x :: ws) =
        if off + (ws.length + 1) ≤ buf.length then some (splice buf off (x :: ws)) else none
  | [], off, x, ws => by
    have : ¬ off + (ws.length + 1) ≤ ([] : ByteMem).length := by simp
    rw [ite_eq_right this]
  | b :: rest, 0, x, [] => by
    have : 0 + ([] : ByteMem).length + 1 ≤ (b :: rest).length := by simp
    show (match writeAbstractBytesAt rest 0 [] with
      | some tail' => some (x :: tail') | none => none) = _
    have hnil : writeAbstractBytesAt rest 0 [] = some rest := by cases rest <;> rfl
    rw [hnil, ite_eq_left (by simp)]
    rfl
  | b :: rest, 0, x, y :: ws => by
    show (match writeAbstractBytesAt rest 0 (y :: ws) with
      | some tail' => some (x :: tail') | none => none) = _
    rw [writeAbstractBytesAt_cons rest 0 y ws]
    by_cases hle : 0 + (ws.length + 1) ≤ rest.length
    · rw [ite_eq_left hle, ite_eq_left (by simp only [List.length_cons]; omega)]
      simp [splice]
    · rw [ite_eq_right hle, ite_eq_right (by simp only [List.length_cons]; omega)]
  | b :: rest, k + 1, x, ws => by
    show (match writeAbstractBytesAt rest k (x :: ws) with
      | some tail' => some (b :: tail') | none => none) = _
    rw [writeAbstractBytesAt_cons rest k x ws]
    by_cases hle : k + (ws.length + 1) ≤ rest.length
    · rw [ite_eq_left hle, ite_eq_left (by simp only [List.length_cons]; omega)]
      simp [splice, Nat.add_right_comm k 1]
    · rw [ite_eq_right hle, ite_eq_right (by simp only [List.length_cons]; omega)]

/-- In-bounds trusted writes are splices. -/
theorem writeAbstractBytesAt_eq_splice {buf w : ByteMem} {off : Nat}
    (h : off + w.length ≤ buf.length) :
    writeAbstractBytesAt buf off w = some (splice buf off w) := by
  cases w with
  | nil =>
    have hnil : writeAbstractBytesAt buf off [] = some buf := by cases buf <;> cases off <;> rfl
    rw [hnil]
    simp [splice, List.take_append_drop]
  | cons x ws =>
    rw [writeAbstractBytesAt_cons, ite_eq_left (by simpa using h)]

/-- Non-empty out-of-bounds trusted writes fail. -/
theorem writeAbstractBytesAt_eq_none {buf : ByteMem} {off : Nat} {x : AbstractByte} {ws : ByteMem}
    (h : buf.length < off + (ws.length + 1)) :
    writeAbstractBytesAt buf off (x :: ws) = none := by
  rw [writeAbstractBytesAt_cons, ite_eq_right (by omega)]

/-- Successful trusted writes are in bounds or empty, and are splices. -/
theorem writeAbstractBytesAt_some_inv {buf w mem' : ByteMem} {off : Nat}
    (hw : writeAbstractBytesAt buf off w = some mem') :
    (w.length = 0 ∧ mem' = buf) ∨ (off + w.length ≤ buf.length ∧ mem' = splice buf off w) := by
  cases w with
  | nil =>
    have hnil : writeAbstractBytesAt buf off [] = some buf := by cases buf <;> cases off <;> rfl
    rw [hnil] at hw
    exact Or.inl ⟨rfl, (Option.some.inj hw).symm⟩
  | cons x ws =>
    rw [writeAbstractBytesAt_cons] at hw
    by_cases hle : off + (ws.length + 1) ≤ buf.length
    · rw [ite_eq_left hle] at hw
      exact Or.inr ⟨by simpa using hle, (Option.some.inj hw).symm⟩
    · rw [ite_eq_right hle] at hw
      cases hw

/-- Typed read of a value through a `ByteLensCodec`. -/
def readTyped {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (mem : ByteMem) : Option α :=
  (sliceAbstractBytes mem base n).bind c.decode

/-- Typed write through the trusted `writeAbstractBytesAt`. -/
def writeTyped {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (v : α) (mem : ByteMem) :
    Option ByteMem :=
  writeAbstractBytesAt mem base (c.encode v)

/-- **Relational `TypedAt`**: the `n`-byte window at `base` decodes to `v`
(padding bytes may hold anything the codec's decoder accepts). -/
def TypedAt {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (v : α) (mem : ByteMem) : Prop :=
  readTyped c base mem = some v

/-- `TypedAt` determines the decoded value uniquely. -/
theorem TypedAt.unique {α : Type} {n : Nat} {c : ByteLensCodec α n} {base : Nat}
    {v₁ v₂ : α} {mem : ByteMem}
    (h₁ : TypedAt c base v₁ mem) (h₂ : TypedAt c base v₂ mem) : v₁ = v₂ := by
  unfold TypedAt at h₁ h₂
  rw [h₁] at h₂
  exact Option.some.inj h₂

/-- **`DisjointSlice`**: empty windows are disjoint from everything; otherwise
the half-open windows do not overlap. -/
def DisjointSlice (base₁ len₁ base₂ len₂ : Nat) : Prop :=
  len₁ = 0 ∨ len₂ = 0 ∨ base₁ + len₁ ≤ base₂ ∨ base₂ + len₂ ≤ base₁

theorem DisjointSlice.symm {base₁ len₁ base₂ len₂ : Nat}
    (h : DisjointSlice base₁ len₁ base₂ len₂) : DisjointSlice base₂ len₂ base₁ len₁ := by
  unfold DisjointSlice at *
  omega

/-- **Adjacent-slice boundary**: `[b, b + l₁)` and `[b + l₁, b + l₁ + l₂)` are disjoint. -/
theorem DisjointSlice.adjacent (base len₁ len₂ : Nat) :
    DisjointSlice base len₁ (base + len₁) len₂ :=
  Or.inr (Or.inr (Or.inl (Nat.le_refl _)))

theorem typedAt_iff {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (v : α) (mem : ByteMem) :
    TypedAt c base v mem ↔ base + n ≤ mem.length ∧ c.decode ((mem.drop base).take n) = some v := by
  unfold TypedAt readTyped
  rw [sliceAbstractBytes_eq]
  by_cases h : base + n ≤ mem.length
  · rw [ite_eq_left h]
    exact ⟨fun hd => ⟨h, hd⟩, fun hd => hd.2⟩
  · rw [ite_eq_right h]
    exact ⟨(fun hd => nomatch hd), (fun hd => absurd hd.1 h)⟩

/-- Bridge to the `ByteLensCodec.sliceAbstractBytes_append_encode`: an
encoding embedded at offset `pre.length` is `TypedAt` there. -/
theorem typedAt_append_encode {α : Type} {n : Nat} (c : ByteLensCodec α n) (pre post : ByteMem)
    (x : α) : TypedAt c pre.length x (pre ++ c.encode x ++ post) := by
  unfold TypedAt readTyped
  rw [ByteLensCodec.sliceAbstractBytes_append_encode]
  exact c.decode_encode x

theorem writeTyped_eq_splice {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat} (v : α)
    {mem : ByteMem} (h : base + n ≤ mem.length) :
    writeTyped c base v mem = some (splice mem base (c.encode v)) :=
  writeAbstractBytesAt_eq_splice (by rw [c.encode_len]; exact h)

theorem writeTyped_length {α : Type} {n : Nat} {c : ByteLensCodec α n} {base : Nat} {v : α}
    {mem mem' : ByteMem} (hw : writeTyped c base v mem = some mem') : mem'.length = mem.length := by
  rcases writeAbstractBytesAt_some_inv hw with ⟨_, rfl⟩ | ⟨hle, rfl⟩
  · rfl
  · exact length_splice hle

/-- **`TypedAt.read_write_same`**: an in-bounds typed write succeeds, preserves
the length, and establishes `TypedAt` for the written value. -/
theorem TypedAt.read_write_same {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat}
    (v : α) {mem : ByteMem} (h : base + n ≤ mem.length) :
    ∃ mem', writeTyped c base v mem = some mem' ∧ TypedAt c base v mem' ∧ mem'.length = mem.length := by
  have hlen : base + (c.encode v).length ≤ mem.length := by rw [c.encode_len]; exact h
  refine ⟨splice mem base (c.encode v), writeTyped_eq_splice c v h, ?_, length_splice hlen⟩
  rw [typedAt_iff]
  refine ⟨by rw [length_splice hlen]; exact h, ?_⟩
  have hs := slice_splice_same hlen
  rw [c.encode_len] at hs
  rw [hs, c.decode_encode]

/-- Raw-byte frame rule: a successful byte write leaves every disjoint `TypedAt`
intact (no unfolding of the codec or of the byte lists). -/
theorem TypedAt.frame_writeBytes {α : Type} {n₂ : Nat} {c₂ : ByteLensCodec α n₂}
    {base₂ off : Nat} {v₂ : α} {w mem mem' : ByteMem}
    (hd : DisjointSlice off w.length base₂ n₂)
    (hw : writeAbstractBytesAt mem off w = some mem')
    (h : TypedAt c₂ base₂ v₂ mem) : TypedAt c₂ base₂ v₂ mem' := by
  rcases writeAbstractBytesAt_some_inv hw with ⟨_, rfl⟩ | ⟨hle, rfl⟩
  · exact h
  · rw [typedAt_iff] at h ⊢
    refine ⟨by rw [length_splice hle]; exact h.1, ?_⟩
    rw [slice_splice_disjoint hle hd]
    exact h.2

/-- **`TypedAt.frame_write`** (`read_write_disjoint`): a successful typed write
at a disjoint window preserves `TypedAt`, in `O(1)` rewrite steps. -/
theorem TypedAt.frame_write {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {c₂ : ByteLensCodec β n₂} {base₁ base₂ : Nat} {v₁ : α} {v₂ : β} {mem mem' : ByteMem}
    (hd : DisjointSlice base₁ n₁ base₂ n₂)
    (hw : writeTyped c₁ base₁ v₁ mem = some mem')
    (h : TypedAt c₂ base₂ v₂ mem) : TypedAt c₂ base₂ v₂ mem' :=
  TypedAt.frame_writeBytes (by rw [c₁.encode_len]; exact hd) hw h

/-- Adjacent-window instance of the frame rule (boundary `base₁ + n₁ = base₂`). -/
theorem TypedAt.frame_write_adjacent {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {c₂ : ByteLensCodec β n₂} {base : Nat} {v₁ : α} {v₂ : β} {mem mem' : ByteMem}
    (hw : writeTyped c₁ base v₁ mem = some mem')
    (h : TypedAt c₂ (base + n₁) v₂ mem) : TypedAt c₂ (base + n₁) v₂ mem' :=
  TypedAt.frame_write (DisjointSlice.adjacent base n₁ n₂) hw h

/-- **Out-of-bounds write failure**: a non-zero-width write that does not fit fails. -/
theorem writeTyped_eq_none_of_oob {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat}
    (v : α) {mem : ByteMem} (hn : 0 < n) (h : mem.length < base + n) :
    writeTyped c base v mem = none := by
  unfold writeTyped
  have hl := c.encode_len v
  cases he : c.encode v with
  | nil => rw [he] at hl; simp at hl; omega
  | cons x ws =>
    rw [he] at hl
    exact writeAbstractBytesAt_eq_none (by simp at hl; omega)

/-- Characterization: a non-zero-width typed write succeeds iff it fits. -/
theorem writeTyped_isSome_iff {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat)
    (v : α) (mem : ByteMem) (hn : 0 < n) :
    (writeTyped c base v mem).isSome = true ↔ base + n ≤ mem.length := by
  constructor
  · intro hs
    by_cases h : base + n ≤ mem.length
    · exact h
    · rw [writeTyped_eq_none_of_oob c v hn (by omega)] at hs
      cases hs
  · intro h
    rw [writeTyped_eq_splice c v h]
    rfl

theorem not_typedAt_of_oob {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat} {v : α}
    {mem : ByteMem} (h : mem.length < base + n) : ¬ TypedAt c base v mem := by
  rw [typedAt_iff]
  intro hd
  omega

/-- **Zero-width boundary (writes)**: a zero-width typed write is a no-op at
*every* base, including out-of-bounds bases. -/
theorem writeTyped_zero_width {α : Type} (c : ByteLensCodec α 0) (base : Nat) (v : α) (mem : ByteMem) :
    writeTyped c base v mem = some mem := by
  unfold writeTyped
  have hl := c.encode_len v
  cases he : c.encode v with
  | nil => cases mem <;> cases base <;> rfl
  | cons x ws => rw [he] at hl; simp at hl

/-- **Zero-width boundary (reads)**: a zero-width `TypedAt` additionally
requires `base ≤ mem.length`. -/
theorem typedAt_zero_width_iff {α : Type} (c : ByteLensCodec α 0) (base : Nat) (v : α)
    (mem : ByteMem) : TypedAt c base v mem ↔ base ≤ mem.length ∧ c.decode [] = some v := by
  rw [typedAt_iff]
  simp only [Nat.add_zero, List.take_zero]

/-- The zero-width read/write asymmetry of the trusted primitives, witnessed by
the `ByteLensCodec.unit` codec one byte past the end. -/
theorem zeroWidth_write_read_asymmetry (mem : ByteMem) :
    writeTyped ByteLensCodec.unit (mem.length + 1) () mem = some mem ∧
      ¬ TypedAt ByteLensCodec.unit (mem.length + 1) () mem := by
  refine ⟨writeTyped_zero_width _ _ _ _, ?_⟩
  rw [typedAt_zero_width_iff]
  intro h
  omega

/-- `#[repr(C)]`-style padded pair `struct { a: A, _pad: [uninit; pad], b: B }`
built from the `prod` / `padRight` combinators. -/
def laidOutPair {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁) (pad : Nat)
    (c₂ : ByteLensCodec β n₂) : ByteLensCodec (α × β) (n₁ + pad + n₂) :=
  ByteLensCodec.prod (ByteLensCodec.padRight c₁ pad) c₂

theorem prod_decode_eq_some_iff {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) (bs : ByteMem) (a : α) (b : β) (h : bs.length = n₁ + n₂) :
    (ByteLensCodec.prod c₁ c₂).decode bs = some (a, b) ↔
      c₁.decode (bs.take n₁) = some a ∧ c₂.decode (bs.drop n₁) = some b := by
  simp only [ByteLensCodec.prod, h, Nat.beq_refl]
  cases h₁ : c₁.decode (bs.take n₁) <;> cases h₂ : c₂.decode (bs.drop n₁) <;> simp

theorem padRight_decode_of_length {α : Type} {n : Nat} (c : ByteLensCodec α n) (pad : Nat)
    (bs : ByteMem) (h : bs.length = n + pad) :
    (ByteLensCodec.padRight c pad).decode bs = c.decode (bs.take n) := by
  have hpad : (bs.drop n).length = pad := by simp only [List.length_drop]; omega
  simp only [ByteLensCodec.padRight, ByteLensCodec.prod, ByteLensCodec.padUninit, h, hpad,
    Nat.beq_refl, ↓reduceIte]
  cases c.decode (bs.take n) <;> rfl

/-- **`TypedAt` across a padded codec**: a padded pair is typed at `base` iff
the window fits and both fields are typed at their offsets; the padding bytes
are unconstrained. -/
theorem typedAt_laidOutPair_iff {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (pad : Nat) (c₂ : ByteLensCodec β n₂) (base : Nat) (a : α) (b : β) (mem : ByteMem) :
    TypedAt (laidOutPair c₁ pad c₂) base (a, b) mem ↔
      base + (n₁ + pad + n₂) ≤ mem.length ∧ TypedAt c₁ base a mem ∧
        TypedAt c₂ (base + n₁ + pad) b mem := by
  rw [typedAt_iff, typedAt_iff, typedAt_iff]
  constructor
  · rintro ⟨hb, hd⟩
    have hlen : ((mem.drop base).take (n₁ + pad + n₂)).length = n₁ + pad + n₂ := by
      simp only [List.length_take, List.length_drop]; omega
    rw [laidOutPair, prod_decode_eq_some_iff _ _ _ _ _ hlen,
      padRight_decode_of_length _ _ _ (by simp only [List.length_take, List.length_drop]; omega)] at hd
    obtain ⟨h₁, h₂⟩ := hd
    rw [List.take_take, Nat.min_eq_left (by omega), List.take_take,
      Nat.min_eq_left (by omega)] at h₁
    rw [drop_take_add, List.drop_drop, ← Nat.add_assoc] at h₂
    exact ⟨hb, ⟨by omega, h₁⟩, ⟨by omega, h₂⟩⟩
  · rintro ⟨hb, ⟨_, h₁⟩, ⟨_, h₂⟩⟩
    refine ⟨hb, ?_⟩
    have hlen : ((mem.drop base).take (n₁ + pad + n₂)).length = n₁ + pad + n₂ := by
      simp only [List.length_take, List.length_drop]; omega
    rw [laidOutPair, prod_decode_eq_some_iff _ _ _ _ _ hlen,
      padRight_decode_of_length _ _ _ (by simp only [List.length_take, List.length_drop]; omega)]
    refine ⟨?_, ?_⟩
    · rw [List.take_take, Nat.min_eq_left (by omega), List.take_take, Nat.min_eq_left (by omega)]
      exact h₁
    · rw [drop_take_add, List.drop_drop, ← Nat.add_assoc]
      exact h₂

/-- Writing the second field of a padded pair updates the pair value in place. -/
theorem typedAt_laidOutPair_write_snd {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {pad : Nat} {c₂ : ByteLensCodec β n₂} {base : Nat} {a : α} {b b' : β} {mem mem' : ByteMem}
    (h : TypedAt (laidOutPair c₁ pad c₂) base (a, b) mem)
    (hw : writeTyped c₂ (base + n₁ + pad) b' mem = some mem') :
    TypedAt (laidOutPair c₁ pad c₂) base (a, b') mem' := by
  rw [typedAt_laidOutPair_iff] at h ⊢
  obtain ⟨hb, h₁, h₂⟩ := h
  have hlen := writeTyped_length hw
  obtain ⟨m₂, hw₂, ht₂, _⟩ := TypedAt.read_write_same c₂ b' ((typedAt_iff _ _ _ _).mp h₂).1
  rw [hw₂] at hw
  cases hw
  refine ⟨by omega, ?_, ht₂⟩
  exact TypedAt.frame_write (by unfold DisjointSlice; omega) hw₂ h₁

/-- **Padding is semantically irrelevant**: overwriting the padding window with
arbitrary (even initialized) bytes preserves the padded pair's `TypedAt`. -/
theorem typedAt_laidOutPair_padding_write {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {pad : Nat} {c₂ : ByteLensCodec β n₂} {base : Nat} {a : α} {b : β} {junk mem mem' : ByteMem}
    (hj : junk.length = pad)
    (h : TypedAt (laidOutPair c₁ pad c₂) base (a, b) mem)
    (hw : writeAbstractBytesAt mem (base + n₁) junk = some mem') :
    TypedAt (laidOutPair c₁ pad c₂) base (a, b) mem' := by
  rw [typedAt_laidOutPair_iff] at h ⊢
  obtain ⟨hb, h₁, h₂⟩ := h
  have hlen : mem'.length = mem.length := by
    rcases writeAbstractBytesAt_some_inv hw with ⟨_, rfl⟩ | ⟨hle, rfl⟩
    · rfl
    · exact length_splice hle
  refine ⟨by omega, ?_, ?_⟩
  · exact TypedAt.frame_writeBytes (by unfold DisjointSlice; omega) hw h₁
  · exact TypedAt.frame_writeBytes (by unfold DisjointSlice; omega) hw h₂

/-- The padded pair's *encoding* carries `.uninit` padding (`padRight_encode_eq`), so an
exact-bytes predicate would reject the initialized-padding memories that `TypedAt`
(correctly) accepts. -/
theorem laidOutPair_encode_eq {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁) (pad : Nat)
    (c₂ : ByteLensCodec β n₂) (a : α) (b : β) :
    (laidOutPair c₁ pad c₂).encode (a, b) = c₁.encode a ++ List.replicate pad .uninit ++ c₂.encode b := by
  simp [laidOutPair, ByteLensCodec.prod, ByteLensCodec.padRight_encode_eq,
    ByteLensCodec.replicateUninitBytes_eq_replicate]

/-- Concrete witness: a `u8`/`u8` pair whose padding byte is *initialized* is
still typed (relational decode), even though it differs from the encoding. -/
theorem typedAt_laidOutPair_init_padding (a b p : UInt8) :
    TypedAt (laidOutPair ByteLensCodec.u8 1 ByteLensCodec.u8) 0
      (a, b) [.init a none, .init p none, .init b none] ∧
    (laidOutPair ByteLensCodec.u8 1 ByteLensCodec.u8).encode (a, b) ≠
      [.init a none, .init p none, .init b none] := by
  refine ⟨rfl, ?_⟩
  intro h
  rw [laidOutPair_encode_eq] at h
  simp [ByteLensCodec.u8] at h

/-- Canonical (exact) encoding of some value at a window. -/
def CanonicalAt {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (mem : ByteMem) : Prop :=
  ∃ v, sliceAbstractBytes mem base n = some (c.encode v)

/-- Lens validity for two struct fields: both windows hold canonical encodings. -/
def FieldsValid {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁) (base₁ : Nat)
    (c₂ : ByteLensCodec β n₂) (base₂ : Nat) (mem : ByteMem) : Prop :=
  CanonicalAt c₁ base₁ mem ∧ CanonicalAt c₂ base₂ mem

/-- Field lens over trusted memory (`Anneal.FunctionalTranslation.MutLens`):
reads decode the window, writes use the trusted `writeAbstractBytesAt`. -/
def fieldLens {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (dflt : α) :
    Anneal.FunctionalTranslation.MutLens ByteMem α where
  readView mem := (readTyped c base mem).getD dflt
  writeBack v mem := (writeTyped c base v mem).getD mem

theorem canonicalAt_iff {α : Type} {n : Nat} (c : ByteLensCodec α n) (base : Nat) (mem : ByteMem) :
    CanonicalAt c base mem ↔ base + n ≤ mem.length ∧ ∃ v, (mem.drop base).take n = c.encode v := by
  unfold CanonicalAt
  rw [sliceAbstractBytes_eq]
  by_cases h : base + n ≤ mem.length
  · rw [ite_eq_left h]
    exact ⟨(fun ⟨v, hv⟩ => ⟨h, v, Option.some.inj hv⟩), (fun ⟨_, v, hv⟩ => ⟨v, by rw [hv]⟩)⟩
  · rw [ite_eq_right h]
    exact ⟨(fun ⟨_, hv⟩ => nomatch hv), (fun hd => absurd hd.1 h)⟩

/-- `CanonicalAt` implies `TypedAt` for the canonical witness. -/
theorem CanonicalAt.toTypedAt {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {base : Nat} {mem : ByteMem} (h : CanonicalAt c base mem) :
    ∃ v, sliceAbstractBytes mem base n = some (c.encode v) ∧ TypedAt c base v mem := by
  rcases h with ⟨v, hv⟩
  refine ⟨v, hv, ?_⟩
  unfold TypedAt readTyped
  rw [hv]
  exact c.decode_encode v

theorem fieldLens_writeBack_eq {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat}
    (dflt v : α) {mem : ByteMem} (h : base + n ≤ mem.length) :
    (fieldLens c base dflt).writeBack v mem = splice mem base (c.encode v) := by
  show (writeTyped c base v mem).getD mem = _
  rw [writeTyped_eq_splice c v h]
  rfl

theorem canonicalAt_splice_same {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat}
    (v : α) {mem : ByteMem} (h : base + n ≤ mem.length) :
    CanonicalAt c base (splice mem base (c.encode v)) := by
  have hlen : base + (c.encode v).length ≤ mem.length := by rw [c.encode_len]; exact h
  rw [canonicalAt_iff, length_splice hlen]
  refine ⟨h, v, ?_⟩
  have hs := slice_splice_same hlen
  rw [c.encode_len] at hs
  exact hs

theorem canonicalAt_splice_disjoint {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) {base₁ base₂ : Nat} (v : α) {mem : ByteMem}
    (h : base₁ + n₁ ≤ mem.length) (hd : DisjointSlice base₁ n₁ base₂ n₂)
    (hc : CanonicalAt c₂ base₂ mem) : CanonicalAt c₂ base₂ (splice mem base₁ (c₁.encode v)) := by
  have hlen : base₁ + (c₁.encode v).length ≤ mem.length := by rw [c₁.encode_len]; exact h
  rw [canonicalAt_iff] at hc ⊢
  obtain ⟨hb, w, hw⟩ := hc
  refine ⟨by rw [length_splice hlen]; exact hb, w, ?_⟩
  rw [slice_splice_disjoint hlen (by rw [c₁.encode_len]; exact hd)]
  exact hw

theorem readTyped_splice_same {α : Type} {n : Nat} (c : ByteLensCodec α n) {base : Nat}
    (v : α) {mem : ByteMem} (h : base + n ≤ mem.length) :
    readTyped c base (splice mem base (c.encode v)) = some v := by
  obtain ⟨m, hw, ht, _⟩ := TypedAt.read_write_same c v h
  rw [writeTyped_eq_splice c v h] at hw
  cases hw
  exact ht

theorem readTyped_splice_disjoint {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) {base₁ base₂ : Nat} (v : α) {mem : ByteMem}
    (h : base₁ + n₁ ≤ mem.length) (hd : DisjointSlice base₁ n₁ base₂ n₂) :
    readTyped c₂ base₂ (splice mem base₁ (c₁.encode v)) = readTyped c₂ base₂ mem := by
  have hlen : base₁ + (c₁.encode v).length ≤ mem.length := by rw [c₁.encode_len]; exact h
  unfold readTyped
  rw [sliceAbstractBytes_eq, sliceAbstractBytes_eq, length_splice hlen,
    slice_splice_disjoint hlen (by rw [c₁.encode_len]; exact hd)]

/-- Lawfulness of one field lens on `FieldsValid` states. -/
theorem fieldLens_lawful {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) (base₁ base₂ : Nat) (d₁ : α)
    (hd : DisjointSlice base₁ n₁ base₂ n₂) :
    Anneal.FunctionalTranslation.LawfulMutLens (fieldLens c₁ base₁ d₁)
      (FieldsValid c₁ base₁ c₂ base₂) where
  valid_writeBack a mem hv := by
    obtain ⟨hb, _⟩ := (canonicalAt_iff c₁ base₁ mem).mp hv.1
    rw [fieldLens_writeBack_eq c₁ d₁ a hb]
    exact ⟨canonicalAt_splice_same c₁ a hb, canonicalAt_splice_disjoint c₁ c₂ a hb hd hv.2⟩
  readView_writeBack a mem hv := by
    obtain ⟨hb, _⟩ := (canonicalAt_iff c₁ base₁ mem).mp hv.1
    rw [fieldLens_writeBack_eq c₁ d₁ a hb]
    show (readTyped c₁ base₁ (splice mem base₁ (c₁.encode a))).getD d₁ = a
    rw [readTyped_splice_same c₁ a hb]
    rfl
  writeBack_readView mem hv := by
    obtain ⟨hb, v, hv₁⟩ := (canonicalAt_iff c₁ base₁ mem).mp hv.1
    have hr : (fieldLens c₁ base₁ d₁).readView mem = v := by
      show (readTyped c₁ base₁ mem).getD d₁ = v
      unfold readTyped
      rw [sliceAbstractBytes_eq, ite_eq_left hb, hv₁]
      show (c₁.decode (c₁.encode v)).getD d₁ = v
      rw [c₁.decode_encode]
      rfl
    rw [hr, fieldLens_writeBack_eq c₁ d₁ v hb]
    have hlen : base₁ + (c₁.encode v).length ≤ mem.length := by rw [c₁.encode_len]; exact hb
    exact splice_self hlen (by rw [c₁.encode_len]; exact hv₁)
  writeBack_writeBack a₁ a₂ mem hv := by
    obtain ⟨hb, _⟩ := (canonicalAt_iff c₁ base₁ mem).mp hv.1
    have hlen : base₁ + (c₁.encode a₁).length ≤ mem.length := by rw [c₁.encode_len]; exact hb
    have hb' : base₁ + n₁ ≤ (splice mem base₁ (c₁.encode a₁)).length := by
      rw [length_splice hlen]; exact hb
    rw [fieldLens_writeBack_eq c₁ d₁ a₁ hb, fieldLens_writeBack_eq c₁ d₁ a₂ hb',
      fieldLens_writeBack_eq c₁ d₁ a₂ hb,
      splice_splice_same hlen (by rw [c₁.encode_len, c₁.encode_len])]

theorem fieldsValid_symm {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {c₂ : ByteLensCodec β n₂} {base₁ base₂ : Nat} {mem : ByteMem} :
    FieldsValid c₁ base₁ c₂ base₂ mem ↔ FieldsValid c₂ base₂ c₁ base₁ mem :=
  ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

/-- **`subplaceFieldLens_disjoint`**: two struct fields at disjoint windows give
`LawfulMutLens` witnesses for both field lenses and a `Anneal.SepLogicLenses.IndependentLenses` witness for the pair. -/
theorem subplaceFieldLens_disjoint {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) (base₁ base₂ : Nat) (d₁ : α) (d₂ : β)
    (hd : DisjointSlice base₁ n₁ base₂ n₂) :
    Anneal.FunctionalTranslation.LawfulMutLens (fieldLens c₁ base₁ d₁)
        (FieldsValid c₁ base₁ c₂ base₂) ∧
      Anneal.FunctionalTranslation.LawfulMutLens (fieldLens c₂ base₂ d₂)
        (FieldsValid c₁ base₁ c₂ base₂) ∧
      Anneal.SepLogicLenses.IndependentLenses (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂)
        (FieldsValid c₁ base₁ c₂ base₂) := by
  have hL₁ := fieldLens_lawful c₁ c₂ base₁ base₂ d₁ hd
  have hL₂' := fieldLens_lawful c₂ c₁ base₂ base₁ d₂ hd.symm
  have hL₂ : Anneal.FunctionalTranslation.LawfulMutLens (fieldLens c₂ base₂ d₂)
      (FieldsValid c₁ base₁ c₂ base₂) :=
    { valid_writeBack := fun b m hv =>
        fieldsValid_symm.mpr (hL₂'.valid_writeBack b m (fieldsValid_symm.mp hv))
      readView_writeBack := fun b m hv => hL₂'.readView_writeBack b m (fieldsValid_symm.mp hv)
      writeBack_readView := fun m hv => hL₂'.writeBack_readView m (fieldsValid_symm.mp hv)
      writeBack_writeBack := fun b₁ b₂ m hv =>
        hL₂'.writeBack_writeBack b₁ b₂ m (fieldsValid_symm.mp hv) }
  refine ⟨hL₁, hL₂, ?_⟩
  refine
    { valid_writeBack_left := hL₁.valid_writeBack
      valid_writeBack_right := hL₂.valid_writeBack
      readView_right_of_writeBack_left := ?_
      readView_left_of_writeBack_right := ?_
      writeBack_comm := ?_ }
  · intro a m hv
    obtain ⟨hb, _⟩ := (canonicalAt_iff c₁ base₁ m).mp hv.1
    rw [fieldLens_writeBack_eq c₁ d₁ a hb]
    show (readTyped c₂ base₂ _).getD d₂ = (readTyped c₂ base₂ m).getD d₂
    rw [readTyped_splice_disjoint c₁ c₂ a hb hd]
  · intro b m hv
    obtain ⟨hb, _⟩ := (canonicalAt_iff c₂ base₂ m).mp hv.2
    rw [fieldLens_writeBack_eq c₂ d₂ b hb]
    show (readTyped c₁ base₁ _).getD d₁ = (readTyped c₁ base₁ m).getD d₁
    rw [readTyped_splice_disjoint c₂ c₁ b hb hd.symm]
  · intro a b m hv
    obtain ⟨hb₁, _⟩ := (canonicalAt_iff c₁ base₁ m).mp hv.1
    obtain ⟨hb₂, _⟩ := (canonicalAt_iff c₂ base₂ m).mp hv.2
    have hl₁ : base₁ + (c₁.encode a).length ≤ m.length := by rw [c₁.encode_len]; exact hb₁
    have hl₂ : base₂ + (c₂.encode b).length ≤ m.length := by rw [c₂.encode_len]; exact hb₂
    rw [fieldLens_writeBack_eq c₁ d₁ a hb₁, fieldLens_writeBack_eq c₂ d₂ b hb₂,
      fieldLens_writeBack_eq c₂ d₂ b (by rw [length_splice hl₁]; exact hb₂),
      fieldLens_writeBack_eq c₁ d₁ a (by rw [length_splice hl₂]; exact hb₁)]
    unfold DisjointSlice at hd
    rcases hd with h0 | h0 | h0 | h0
    · have he : c₁.encode a = [] := List.eq_nil_of_length_eq_zero (by rw [c₁.encode_len]; exact h0)
      rw [he]
      simp only [splice, List.length_nil, Nat.add_zero, List.append_nil, List.take_append_drop]
    · have he : c₂.encode b = [] := List.eq_nil_of_length_eq_zero (by rw [c₂.encode_len]; exact h0)
      rw [he]
      simp only [splice, List.length_nil, Nat.add_zero, List.append_nil, List.take_append_drop]
    · exact splice_comm hl₁ hl₂ (by rw [c₁.encode_len]; left; exact h0)
    · exact splice_comm hl₁ hl₂ (by rw [c₂.encode_len]; right; exact h0)

/-- The whole-struct product lens (`prodMutLens`) is lawful by the `prodMutLens_lawful`. -/
theorem structLens_lawful {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (c₂ : ByteLensCodec β n₂) (base₁ base₂ : Nat) (d₁ : α) (d₂ : β)
    (hd : DisjointSlice base₁ n₁ base₂ n₂) :
    Anneal.FunctionalTranslation.LawfulMutLens
      (Anneal.SepLogicLenses.prodMutLens (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂))
      (FieldsValid c₁ base₁ c₂ base₂) :=
  let ⟨hL₁, hL₂, hI⟩ := subplaceFieldLens_disjoint c₁ c₂ base₁ base₂ d₁ d₂ hd
  Anneal.SepLogicLenses.prodMutLens_lawful hL₁ hL₂ hI

/-- `K` sequential field mutations (`.inl` writes field 1, `.inr` field 2). -/
def applyFieldWrites {α β : Type} (L₁ : Anneal.FunctionalTranslation.MutLens ByteMem α)
    (L₂ : Anneal.FunctionalTranslation.MutLens ByteMem β) : List (α ⊕ β) → ByteMem → ByteMem
  | [], m => m
  | .inl a :: ws, m => applyFieldWrites L₁ L₂ ws (L₁.writeBack a m)
  | .inr b :: ws, m => applyFieldWrites L₁ L₂ ws (L₂.writeBack b m)

/-- Last value written to field 1 (or `a` if none). -/
def lastLeft {α β : Type} : List (α ⊕ β) → α → α
  | [], a => a
  | .inl a :: ws, _ => lastLeft ws a
  | .inr _ :: ws, a => lastLeft ws a

/-- Last value written to field 2 (or `b` if none). -/
def lastRight {α β : Type} : List (α ⊕ β) → β → β
  | [], b => b
  | .inl _ :: ws, b => lastRight ws b
  | .inr b :: ws, _ => lastRight ws b

/-- **`K` sequential struct-field mutations in `O(1)` lens steps each**: each
mutation is discharged by one lens law; no byte list is ever unfolded. -/
theorem applyFieldWrites_spec {α β : Type} {L₁ : Anneal.FunctionalTranslation.MutLens ByteMem α}
    {L₂ : Anneal.FunctionalTranslation.MutLens ByteMem β} {V : ByteMem → Prop}
    (hL₁ : Anneal.FunctionalTranslation.LawfulMutLens L₁ V)
    (hL₂ : Anneal.FunctionalTranslation.LawfulMutLens L₂ V)
    (hI : Anneal.SepLogicLenses.IndependentLenses L₁ L₂ V) :
    ∀ (ws : List (α ⊕ β)) (m : ByteMem), V m →
      V (applyFieldWrites L₁ L₂ ws m) ∧
        L₁.readView (applyFieldWrites L₁ L₂ ws m) = lastLeft ws (L₁.readView m) ∧
        L₂.readView (applyFieldWrites L₁ L₂ ws m) = lastRight ws (L₂.readView m)
  | [], _, hv => ⟨hv, rfl, rfl⟩
  | .inl a :: ws, m, hv => by
    have ih := applyFieldWrites_spec hL₁ hL₂ hI ws (L₁.writeBack a m) (hL₁.valid_writeBack a m hv)
    refine ⟨ih.1, ?_, ?_⟩
    · rw [show applyFieldWrites L₁ L₂ (.inl a :: ws) m = applyFieldWrites L₁ L₂ ws (L₁.writeBack a m)
        from rfl, ih.2.1, hL₁.readView_writeBack a m hv]
      rfl
    · rw [show applyFieldWrites L₁ L₂ (.inl a :: ws) m = applyFieldWrites L₁ L₂ ws (L₁.writeBack a m)
        from rfl, ih.2.2, hI.readView_right_of_writeBack_left a m hv]
      rfl
  | .inr b :: ws, m, hv => by
    have ih := applyFieldWrites_spec hL₁ hL₂ hI ws (L₂.writeBack b m) (hL₂.valid_writeBack b m hv)
    refine ⟨ih.1, ?_, ?_⟩
    · rw [show applyFieldWrites L₁ L₂ (.inr b :: ws) m = applyFieldWrites L₁ L₂ ws (L₂.writeBack b m)
        from rfl, ih.2.1, hI.readView_left_of_writeBack_right b m hv]
      rfl
    · rw [show applyFieldWrites L₁ L₂ (.inr b :: ws) m = applyFieldWrites L₁ L₂ ws (L₂.writeBack b m)
        from rfl, ih.2.2, hL₂.readView_writeBack b m hv]
      rfl

/-- Two `u8` fields of a padded struct `{ a: u8, _pad, b: u8 }` (offsets `0` and `2`). -/
def u8FieldA : Anneal.FunctionalTranslation.MutLens ByteMem UInt8 :=
  fieldLens ByteLensCodec.u8 0 0

def u8FieldB : Anneal.FunctionalTranslation.MutLens ByteMem UInt8 :=
  fieldLens ByteLensCodec.u8 2 0

def u8FieldsValid : ByteMem → Prop :=
  FieldsValid ByteLensCodec.u8 0 ByteLensCodec.u8 2

theorem u8Fields_lenses :
    Anneal.FunctionalTranslation.LawfulMutLens u8FieldA u8FieldsValid ∧
      Anneal.FunctionalTranslation.LawfulMutLens u8FieldB u8FieldsValid ∧
      Anneal.SepLogicLenses.IndependentLenses u8FieldA u8FieldB u8FieldsValid :=
  subplaceFieldLens_disjoint _ _ 0 2 0 0 (Or.inr (Or.inr (Or.inl (by decide))))

theorem u8FieldsValid_init (a p b : UInt8) :
    u8FieldsValid [.init a none, .init p none, .init b none] :=
  ⟨⟨a, rfl⟩, ⟨b, rfl⟩⟩

/-- Six symbolic field mutations on trusted bytes, discharged by
`applyFieldWrites_spec` (no byte-list unfolding). -/
theorem u8Fields_six_mutations (a p b x₁ x₂ x₃ x₄ x₅ x₆ : UInt8) :
    let m := applyFieldWrites u8FieldA u8FieldB
      [.inl x₁, .inr x₂, .inl x₃, .inl x₄, .inr x₅, .inr x₆] [.init a none, .init p none, .init b none]
    u8FieldA.readView m = x₄ ∧ u8FieldB.readView m = x₆ := by
  obtain ⟨hL₁, hL₂, hI⟩ := u8Fields_lenses
  obtain ⟨_, h₁, h₂⟩ := applyFieldWrites_spec hL₁ hL₂ hI
    [.inl x₁, .inr x₂, .inl x₃, .inl x₄, .inr x₅, .inr x₆] _ (u8FieldsValid_init a p b)
  exact ⟨h₁, h₂⟩

/-- `CanonicalAt` implies `TypedAt` for the lens view at `base`. -/
theorem typedAt_of_canonicalAt {α : Type} {n : Nat} {c : ByteLensCodec α n} {base : Nat}
    {mem : ByteMem} (hc : CanonicalAt c base mem) (dflt : α) :
    TypedAt c base ((fieldLens c base dflt).readView mem) mem := by
  obtain ⟨hb, v, hv⟩ := (canonicalAt_iff c base mem).mp hc
  have hr : readTyped c base mem = some v := by
    unfold readTyped
    rw [sliceAbstractBytes_eq, ite_eq_left hb, hv]
    exact c.decode_encode v
  show readTyped c base mem = some ((readTyped c base mem).getD dflt)
  rw [hr]
  rfl

/-- Writing the first field of a padded pair updates the pair value in place
without disturbing the padding or second field. -/
theorem typedAt_laidOutPair_write_fst {α β : Type} {n₁ n₂ : Nat} {c₁ : ByteLensCodec α n₁}
    {pad : Nat} {c₂ : ByteLensCodec β n₂} {base : Nat} {a a' : α} {b : β} {mem mem' : ByteMem}
    (h : TypedAt (laidOutPair c₁ pad c₂) base (a, b) mem)
    (hw : writeTyped c₁ base a' mem = some mem') :
    TypedAt (laidOutPair c₁ pad c₂) base (a', b) mem' := by
  rw [typedAt_laidOutPair_iff] at h ⊢
  obtain ⟨hb, h₁, h₂⟩ := h
  have hlen := writeTyped_length hw
  obtain ⟨m₁, hw₁, ht₁, _⟩ := TypedAt.read_write_same c₁ a' ((typedAt_iff _ _ _ _).mp h₁).1
  rw [hw₁] at hw
  cases hw
  refine ⟨by omega, ht₁, ?_⟩
  exact TypedAt.frame_write (by unfold DisjointSlice; omega) hw₁ h₂

/-- **`FieldsValid` implies whole-struct `TypedAt` across a padded `laidOutPair`**:
regardless of arbitrary initialized/uninitialized bytes in the padding window
`[base + n₁, base + n₁ + pad)`, `FieldsValid` at `base` and `base + n₁ + pad`
establishes `TypedAt (laidOutPair c₁ pad c₂)` for the pair of lens views. -/
theorem typedAt_laidOutPair_of_fieldsValid {α β : Type} {n₁ n₂ : Nat}
    (c₁ : ByteLensCodec α n₁) (pad : Nat) (c₂ : ByteLensCodec β n₂)
    (base : Nat) (d₁ : α) (d₂ : β) {mem : ByteMem}
    (hv : FieldsValid c₁ base c₂ (base + n₁ + pad) mem) :
    TypedAt (laidOutPair c₁ pad c₂) base
      ((fieldLens c₁ base d₁).readView mem, (fieldLens c₂ (base + n₁ + pad) d₂).readView mem) mem := by
  rw [typedAt_laidOutPair_iff]
  obtain ⟨hb₂, _⟩ := (canonicalAt_iff c₂ (base + n₁ + pad) mem).mp hv.2
  exact ⟨by omega, typedAt_of_canonicalAt hv.1 d₁, typedAt_of_canonicalAt hv.2 d₂⟩

/-- **End-to-end `applyFieldWrites` → whole-struct `TypedAt (laidOutPair …)`**:
after any sequence `ws` of field-lens writes on a padded struct, the resulting
memory satisfies `TypedAt (laidOutPair c₁ pad c₂)` for `(lastLeft ws a₀, lastRight ws b₀)`
across arbitrary padding bytes. -/
theorem typedAt_laidOutPair_applyFieldWrites {α β : Type} {n₁ n₂ : Nat}
    (c₁ : ByteLensCodec α n₁) (pad : Nat) (c₂ : ByteLensCodec β n₂)
    (base : Nat) (d₁ : α) (d₂ : β) (ws : List (α ⊕ β)) {mem : ByteMem}
    (hv : FieldsValid c₁ base c₂ (base + n₁ + pad) mem) :
    TypedAt (laidOutPair c₁ pad c₂) base
      (lastLeft ws ((fieldLens c₁ base d₁).readView mem),
       lastRight ws ((fieldLens c₂ (base + n₁ + pad) d₂).readView mem))
      (applyFieldWrites (fieldLens c₁ base d₁) (fieldLens c₂ (base + n₁ + pad) d₂) ws mem) := by
  have hd : DisjointSlice base n₁ (base + n₁ + pad) n₂ := by
    unfold DisjointSlice
    exact Or.inr (Or.inr (Or.inl (by omega)))
  obtain ⟨hL₁, hL₂, hI⟩ := subplaceFieldLens_disjoint c₁ c₂ base (base + n₁ + pad) d₁ d₂ hd
  obtain ⟨hv', h₁, h₂⟩ := applyFieldWrites_spec hL₁ hL₂ hI ws mem hv
  rw [← h₁, ← h₂]
  exact typedAt_laidOutPair_of_fieldsValid c₁ pad c₂ base d₁ d₂ hv'

/-- **Bridge from `Anneal.SepLogicLenses.BorrowSubplace.disjointOn` to
`DisjointSlice`, `LawfulMutLens`, and `IndependentLenses`**: on a shared
aggregate allocation (`k₁.allocId = k₂.allocId`), `BorrowSubplace.disjointOn`
implies distinct field indices `f₁ ≠ f₂`, which under any non-overlapping
struct layout yields disjoint byte windows and independent field lenses. -/
theorem subplaceFieldLens_of_borrowSubplace_disjointOn
    {α β : Type} {subplaceOf : Anneal.UnsafeObligations.RawPtrVal → Anneal.SepLogicLenses.BorrowSubplace}
    {k₁ k₂ : Anneal.UnsafeObligations.RawPtrVal}
    (fieldOff fieldLen : Trusted.Rustc.V2026_06_01.MirAst.FieldIdx → Nat)
    (hLayout : ∀ f₁ f₂, f₁ ≠ f₂ →
      DisjointSlice (fieldOff f₁) (fieldLen f₁) (fieldOff f₂) (fieldLen f₂))
    (hDisj : Anneal.SepLogicLenses.BorrowSubplace.disjointOn subplaceOf k₁ k₂)
    (hSameAlloc : k₁.allocId = k₂.allocId) :
    ∃ f₁ ty₁ f₂ ty₂,
      subplaceOf k₁ = .field f₁ ty₁ ∧
      subplaceOf k₂ = .field f₂ ty₂ ∧
      f₁ ≠ f₂ ∧
      DisjointSlice (fieldOff f₁) (fieldLen f₁) (fieldOff f₂) (fieldLen f₂) ∧
      ∀ (c₁ : ByteLensCodec α (fieldLen f₁)) (c₂ : ByteLensCodec β (fieldLen f₂))
        (d₁ : α) (d₂ : β),
        Anneal.FunctionalTranslation.LawfulMutLens
          (fieldLens c₁ (fieldOff f₁) d₁)
          (FieldsValid c₁ (fieldOff f₁) c₂ (fieldOff f₂)) ∧
        Anneal.FunctionalTranslation.LawfulMutLens
          (fieldLens c₂ (fieldOff f₂) d₂)
          (FieldsValid c₁ (fieldOff f₁) c₂ (fieldOff f₂)) ∧
        Anneal.SepLogicLenses.IndependentLenses
          (fieldLens c₁ (fieldOff f₁) d₁) (fieldLens c₂ (fieldOff f₂) d₂)
          (FieldsValid c₁ (fieldOff f₁) c₂ (fieldOff f₂)) := by
  rcases hDisj.2 with hNeAlloc | ⟨f₁, ty₁, f₂, ty₂, hS₁, hS₂, hNeF⟩
  · exact absurd hSameAlloc hNeAlloc
  · have hSlice := hLayout f₁ f₂ hNeF
    exact ⟨f₁, ty₁, f₂, ty₂, hS₁, hS₂, hNeF, hSlice,
      fun c₁ c₂ d₁ d₂ => subplaceFieldLens_disjoint c₁ c₂ (fieldOff f₁) (fieldOff f₂) d₁ d₂ hSlice⟩

/-- Non-vacuity of `subplaceFieldLens_of_borrowSubplace_disjointOn`: the layout
hypothesis (quantified over *every* pair of distinct field indices) is satisfiable
by a concrete two-field layout (field `f` at offset `2 f`, one byte wide for
`f ≤ 1` and zero-width otherwise), and two distinctly tagged pointers into fields
`0` and `1` of one allocation satisfy the `BorrowSubplace.disjointOn`. -/
theorem subplaceFieldLens_of_borrowSubplace_disjointOn_nonvacuous
    (ty : Trusted.Rustc.V2026_06_01.MirAst.Ty) :
    (∀ f₁ f₂ : Trusted.Rustc.V2026_06_01.MirAst.FieldIdx, f₁ ≠ f₂ →
      DisjointSlice (2 * f₁) (if f₁ ≤ 1 then 1 else 0) (2 * f₂) (if f₂ ≤ 1 then 1 else 0)) ∧
    Anneal.SepLogicLenses.BorrowSubplace.disjointOn (fun k => .field k.offset ty)
      { allocId := 0, offset := 0, tag := 1 } { allocId := 0, offset := 1, tag := 2 } := by
  refine ⟨fun f₁ f₂ hne => ?_, ⟨by decide, Or.inr ⟨0, ty, 1, ty, rfl, rfl, by decide⟩⟩⟩
  unfold DisjointSlice
  by_cases h₁ : f₁ ≤ 1
  · rw [ite_eq_left h₁]
    by_cases h₂ : f₂ ≤ 1
    · rw [ite_eq_left h₂]
      rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
      · exact Or.inr (Or.inr (Or.inl (by omega)))
      · exact Or.inr (Or.inr (Or.inr (by omega)))
    · rw [ite_eq_right h₂]
      exact Or.inr (Or.inl rfl)
  · rw [ite_eq_right h₁]
    exact Or.inl rfl

/-- Relational two-field validity (`TypedAt` at each field window, permitting
arbitrary initialized or uninitialized internal padding inside nested padded
field codecs, unlike `FieldsValid` / `CanonicalAt`). -/
def FieldsTyped {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁) (base₁ : Nat)
    (c₂ : ByteLensCodec β n₂) (base₂ : Nat) (mem : ByteMem) : Prop :=
  (∃ a, TypedAt c₁ base₁ a mem) ∧ (∃ b, TypedAt c₂ base₂ b mem)

theorem fieldsTyped_of_fieldsValid {α β : Type} {n₁ n₂ : Nat} (c₁ : ByteLensCodec α n₁)
    (base₁ : Nat) (c₂ : ByteLensCodec β n₂) (base₂ : Nat) {mem : ByteMem}
    (d₁ : α) (d₂ : β) (hv : FieldsValid c₁ base₁ c₂ base₂ mem) :
    FieldsTyped c₁ base₁ c₂ base₂ mem :=
  ⟨⟨_, typedAt_of_canonicalAt hv.1 d₁⟩, ⟨_, typedAt_of_canonicalAt hv.2 d₂⟩⟩

/-- **Nested padded sub-structs separate `FieldsTyped` from `FieldsValid`**:
when field 1 is itself a padded pair `laidOutPair u8 1 u8` with an initialized
padding byte `.init p none`, relational `FieldsTyped` holds while canonical
`FieldsValid` fails. -/
theorem fieldsTyped_nested_init_padding_not_fieldsValid (a b p c : UInt8) :
    let c₁ := laidOutPair ByteLensCodec.u8 1 ByteLensCodec.u8
    let c₂ := ByteLensCodec.u8
    let mem : ByteMem := [.init a none, .init p none, .init b none, .init c none]
    FieldsTyped c₁ 0 c₂ 3 mem ∧ ¬ FieldsValid c₁ 0 c₂ 3 mem := by
  intro c₁ c₂ mem
  refine ⟨⟨⟨(a, b), rfl⟩, ⟨c, rfl⟩⟩, ?_⟩
  rintro ⟨⟨⟨a', b'⟩, hslice⟩, _⟩
  have hsl : sliceAbstractBytes mem 0 3 = some [.init a none, .init p none, .init b none] := rfl
  rw [hsl, Option.some.injEq] at hslice
  have henc := laidOutPair_encode_eq ByteLensCodec.u8 1
    ByteLensCodec.u8 a' b'
  rw [← hslice] at henc
  simp [ByteLensCodec.u8] at henc

/-- **Exact obstruction to `LawfulMutLens` without `CanonicalAt`**: on a padded
codec `laidOutPair u8 1 u8`, `fieldLens` is *not* a `LawfulMutLens` over
relational `∃ ab, TypedAt … mem`, because `writeBack_readView` overwrites an
initialized padding byte `.init 1 none` with `.uninit`. -/
theorem not_lawfulMutLens_fieldLens_laidOutPair_typedAt (d : UInt8 × UInt8) :
    let c := laidOutPair ByteLensCodec.u8 1 ByteLensCodec.u8
    ¬ Anneal.FunctionalTranslation.LawfulMutLens (fieldLens c 0 d)
        (fun mem => ∃ ab, TypedAt c 0 ab mem) := by
  intro c hLaw
  have hv : ∃ ab, TypedAt c 0 ab ([.init 0 none, .init 1 none, .init 2 none] : ByteMem) := ⟨(0, 2), rfl⟩
  have hgetput := hLaw.writeBack_readView ([.init 0 none, .init 1 none, .init 2 none] : ByteMem) hv
  change ([.init 0 none, .uninit, .init 2 none] : ByteMem) = [.init 0 none, .init 1 none, .init 2 none] at hgetput
  injection hgetput with _ htl
  injection htl with hmid _
  cases hmid

/-- **Relational `FieldsTyped` suffices for `K` sequential `fieldLens` writes**:
because `applyFieldWrites` uses only put-get and disjoint-field framing (never
`writeBack_readView`), `applyFieldWrites` preserves `FieldsTyped` and computes
`lastLeft`/`lastRight` even when the field codecs contain internal padding with
non-canonical initialized bytes. -/
theorem applyFieldWrites_fieldsTyped_spec {α β : Type} {n₁ n₂ : Nat}
    (c₁ : ByteLensCodec α n₁) (c₂ : ByteLensCodec β n₂) (base₁ base₂ : Nat)
    (d₁ : α) (d₂ : β) (hd : DisjointSlice base₁ n₁ base₂ n₂) :
    ∀ (ws : List (α ⊕ β)) (mem : ByteMem),
      FieldsTyped c₁ base₁ c₂ base₂ mem →
      FieldsTyped c₁ base₁ c₂ base₂
          (applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) ws mem) ∧
        (fieldLens c₁ base₁ d₁).readView
          (applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) ws mem) =
          lastLeft ws ((fieldLens c₁ base₁ d₁).readView mem) ∧
        (fieldLens c₂ base₂ d₂).readView
          (applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) ws mem) =
          lastRight ws ((fieldLens c₂ base₂ d₂).readView mem)
  | [], _, hv => ⟨hv, rfl, rfl⟩
  | .inl a :: ws, m, ⟨⟨a₀, ha₀⟩, ⟨b₀, hb₀⟩⟩ => by
    have hb₁ : base₁ + n₁ ≤ m.length := ((typedAt_iff c₁ base₁ a₀ m).mp ha₀).1
    have hwb : (fieldLens c₁ base₁ d₁).writeBack a m = splice m base₁ (c₁.encode a) :=
      fieldLens_writeBack_eq c₁ d₁ a hb₁
    have ha' : TypedAt c₁ base₁ a (splice m base₁ (c₁.encode a)) :=
      readTyped_splice_same c₁ a hb₁
    have hb' : TypedAt c₂ base₂ b₀ (splice m base₁ (c₁.encode a)) := by
      show readTyped c₂ base₂ (splice m base₁ (c₁.encode a)) = some b₀
      rw [readTyped_splice_disjoint c₁ c₂ a hb₁ hd]
      exact hb₀
    have ih := applyFieldWrites_fieldsTyped_spec c₁ c₂ base₁ base₂ d₁ d₂ hd ws
      (splice m base₁ (c₁.encode a)) ⟨⟨a, ha'⟩, ⟨b₀, hb'⟩⟩
    rw [show applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) (.inl a :: ws) m =
        applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) ws (splice m base₁ (c₁.encode a))
      from by simp only [applyFieldWrites, hwb]]
    refine ⟨ih.1, ?_, ?_⟩
    · rw [ih.2.1]
      have hr : (fieldLens c₁ base₁ d₁).readView (splice m base₁ (c₁.encode a)) = a := by
        show (readTyped c₁ base₁ (splice m base₁ (c₁.encode a))).getD d₁ = a
        rw [ha']
        rfl
      rw [hr]
      rfl
    · rw [ih.2.2]
      have hr : (fieldLens c₂ base₂ d₂).readView (splice m base₁ (c₁.encode a)) =
          (fieldLens c₂ base₂ d₂).readView m := by
        show (readTyped c₂ base₂ (splice m base₁ (c₁.encode a))).getD d₂ =
          (readTyped c₂ base₂ m).getD d₂
        rw [readTyped_splice_disjoint c₁ c₂ a hb₁ hd]
      rw [hr]
      rfl
  | .inr b :: ws, m, ⟨⟨a₀, ha₀⟩, ⟨b₀, hb₀⟩⟩ => by
    have hb₂ : base₂ + n₂ ≤ m.length := ((typedAt_iff c₂ base₂ b₀ m).mp hb₀).1
    have hwb : (fieldLens c₂ base₂ d₂).writeBack b m = splice m base₂ (c₂.encode b) :=
      fieldLens_writeBack_eq c₂ d₂ b hb₂
    have hb' : TypedAt c₂ base₂ b (splice m base₂ (c₂.encode b)) :=
      readTyped_splice_same c₂ b hb₂
    have ha' : TypedAt c₁ base₁ a₀ (splice m base₂ (c₂.encode b)) := by
      show readTyped c₁ base₁ (splice m base₂ (c₂.encode b)) = some a₀
      rw [readTyped_splice_disjoint c₂ c₁ b hb₂ hd.symm]
      exact ha₀
    have ih := applyFieldWrites_fieldsTyped_spec c₁ c₂ base₁ base₂ d₁ d₂ hd ws
      (splice m base₂ (c₂.encode b)) ⟨⟨a₀, ha'⟩, ⟨b, hb'⟩⟩
    rw [show applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) (.inr b :: ws) m =
        applyFieldWrites (fieldLens c₁ base₁ d₁) (fieldLens c₂ base₂ d₂) ws (splice m base₂ (c₂.encode b))
      from by simp only [applyFieldWrites, hwb]]
    refine ⟨ih.1, ?_, ?_⟩
    · rw [ih.2.1]
      have hr : (fieldLens c₁ base₁ d₁).readView (splice m base₂ (c₂.encode b)) =
          (fieldLens c₁ base₁ d₁).readView m := by
        show (readTyped c₁ base₁ (splice m base₂ (c₂.encode b))).getD d₁ =
          (readTyped c₁ base₁ m).getD d₁
        rw [readTyped_splice_disjoint c₂ c₁ b hb₂ hd.symm]
      rw [hr]
      rfl
    · rw [ih.2.2]
      have hr : (fieldLens c₂ base₂ d₂).readView (splice m base₂ (c₂.encode b)) = b := by
        show (readTyped c₂ base₂ (splice m base₂ (c₂.encode b))).getD d₂ = b
        rw [hb']
        rfl
      rw [hr]
      rfl

/-- Non-vacuity of the little-endian codecs as relational views: a padded header
`{ len: u16, _pad: [_; 2], crc: u32 }` is `TypedAt` over *arbitrary* padding
bytes, and a `crc` field write updates the header in place. -/
theorem typedAt_u16LE_u32LE_header (len : {v : Nat // v < 256 ^ 2})
    (crc crc' : {v : Nat // v < 256 ^ 4}) (p₁ p₂ : AbstractByte) :
    let c := laidOutPair ByteLensCodec.u16LE 2 ByteLensCodec.u32LE
    let mem : ByteMem := ByteLensCodec.u16LE.encode len ++ [p₁, p₂] ++ ByteLensCodec.u32LE.encode crc
    TypedAt c 0 (len, crc) mem ∧
      ∃ mem', writeTyped ByteLensCodec.u32LE 4 crc' mem = some mem' ∧ TypedAt c 0 (len, crc') mem' := by
  intro c mem
  have hlen₁ : (ByteLensCodec.u16LE.encode len).length = 2 := ByteLensCodec.u16LE.encode_len len
  have hlen₂ : (ByteLensCodec.u32LE.encode crc).length = 4 := ByteLensCodec.u32LE.encode_len crc
  have hmem : mem.length = 8 := by
    simp only [mem, List.length_append, hlen₁, hlen₂, List.length_cons, List.length_nil]
  have h₁ : TypedAt ByteLensCodec.u16LE 0 len mem := by
    have h := typedAt_append_encode ByteLensCodec.u16LE [] ([p₁, p₂] ++ ByteLensCodec.u32LE.encode crc) len
    rw [List.nil_append, ← List.append_assoc] at h
    exact h
  have h₂ : TypedAt ByteLensCodec.u32LE (0 + 2 + 2) crc mem := by
    have h := typedAt_append_encode ByteLensCodec.u32LE (ByteLensCodec.u16LE.encode len ++ [p₁, p₂]) [] crc
    rw [List.append_nil] at h
    have hpre : (ByteLensCodec.u16LE.encode len ++ [p₁, p₂]).length = 0 + 2 + 2 := by
      simp only [List.length_append, hlen₁, List.length_cons, List.length_nil]
    rwa [hpre] at h
  have hT : TypedAt c 0 (len, crc) mem :=
    (typedAt_laidOutPair_iff _ _ _ 0 len crc mem).mpr ⟨by rw [hmem]; exact Nat.le_refl _, h₁, h₂⟩
  obtain ⟨mem', hw, -, -⟩ := TypedAt.read_write_same ByteLensCodec.u32LE crc' (base := 4) (mem := mem)
    (by rw [hmem]; exact Nat.le_refl _)
  exact ⟨hT, mem', hw, typedAt_laidOutPair_write_snd hT hw⟩

end TypedAtLenses

/-! ## 5. Two-Stage Tree Borrows Protector Release & Pre-Release `reborrowFootprint` Specs

A self-contained per-location Tree Borrows model (namespace
`Anneal.SepLogicLenses.TreeBorrowsModel`) pinned cell-by-cell to the trusted
`MirSemantics` automaton, used to state and prove reborrow specifications of
trusted callees (`TrustedFnSpec`) across the protector-release return path.

* **Trusted conformance.** `Permission` embeds injectively into the trusted
  `TreeBorrowPerm` (`ofLiveTreeBorrowPerm?_toLiveTreeBorrowPerm`,
  `toLiveTreeBorrowPerm_ofLiveTreeBorrowPerm?`); `performTransition` equals the
  trusted `treeBorrowNodeAccess` on accessed locations
  (`performTransition_accessed_eq_live`, `performTransition_accessed_isSome_eq_live`)
  and `treeBorrowPermTransition` on unaccessed ones
  (`performTransition_unaccessed_eq_live`); `isTagProtected_eq_live`,
  `performTransition_entry_eq_live`, `nodeAccessRelatedness_visit_eq_live_writer`,
  `borrowEntryWriteConflicts_eq_live`, `restoreCallerProtectors_eq_live`, and
  `liveBorrowEntryRange_contains_iff` bridge `BorrowEntry` protectors, the
  `parentTag` hierarchy, and the return-path protector pop.
* **Two-stage release.** `BorrowTree` (arbitrary depth, `TreeWF`), the active
  call-id set, stage 1 `applyReleaseProtector` (implicit protector-end access with
  `ChildrenVisitMode.skipChildrenOfAccessed`), and stage 2
  `removeActiveProtector` (`GlobalState.endCall`). `TrustedFnSpec` applies its
  `reborrowFootprint : List (ByteRange × Mutability)` *before* release:
  `reborrow_return_unique_write_perm` (+ after callee / parent writes, and the
  negative dual `callee_parent_write_after_reborrow_disables_child`),
  `split_at_mut_unique_write_perm` (every `mid ≤ len`, `split_at_mut_mid_zero`,
  `split_at_mut_mid_len`, `split_at_mut_rootTree_nonvacuous`), and the controls
  `same_tag_split_unsound_control`,
  `overlapping_reborrowFootprint_write_disables_sibling`, and
  `shared_reborrowFootprint_read_ok_write_ub`.
* **Stage-2-only soundness boundary.** The trusted return path drops callee
  protectors without the stage-1 implicit access (`TrustedFnSpec.runStage2Only`).
  For every UB-free `TrustedFnSpec` call the stage-1 release is UB-free
  (`trustedFnSpec_release_noUB`, via `ReleaseReadable`) and the two post-call
  trees are `LatchEquiv` (`trustedFnSpec_run_latchEquiv_stage2Only`, via
  `ReadReleaseSafe`), a relation preserved by every tree operation
  (`LatchEquiv.access`, `.retag`, `.release`) under which every access and release
  has the same verdict (`LatchEquiv.noUB_iff`, `.releaseNoUB_iff`,
  `trustedFnSpec_run_stage2Only_same_verdicts`,
  `trustedSpec_stage2Only_reborrow_equivalence`). Once a protected `&mut`
  argument is *activated* by a callee write, the stage-1 implicit write is
  observable (`stage1_write_release_observable_ub_separation`), so stage-2-only
  reasoning is restricted to non-activating `TrustedFnSpec` shapes and
  descendant-only reborrows
  (`reborrow_return_after_parent_write_stage2Only_unique_write_perm`).
-/

namespace TreeBorrowsModel

open Trusted.Rustc.V2026_06_01.MirAst (Mutability)

abbrev BorTag := Nat
abbrev CallId := Nat

/-- Half-open byte range `[lo, hi)`. -/
structure ByteRange where
  lo : Nat
  hi : Nat
  deriving DecidableEq, Repr

def ByteRange.contains (r : ByteRange) (b : Nat) : Bool :=
  Nat.ble r.lo b && Nat.blt b r.hi

theorem ByteRange.contains_iff (r : ByteRange) (b : Nat) :
    r.contains b = true ↔ r.lo ≤ b ∧ b < r.hi := by
  simp only [ByteRange.contains, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq]

theorem ByteRange.contains_eq_false (r : ByteRange) (b : Nat) (h : ¬ (r.lo ≤ b ∧ b < r.hi)) :
    r.contains b = false := by
  cases hc : r.contains b with
  | false => rfl
  | true => exact absurd ((r.contains_iff b).mp hc) h

def ByteRange.Sub (r₁ r₂ : ByteRange) : Prop :=
  ∀ b, r₁.contains b = true → r₂.contains b = true

def ByteRange.Disjoint (r₁ r₂ : ByteRange) : Prop :=
  ∀ b, r₁.contains b = true → r₂.contains b = false

theorem ByteRange.Sub.refl (r : ByteRange) : r.Sub r := fun _ h => h

theorem ByteRange.Disjoint.symm {r₁ r₂ : ByteRange} (h : r₁.Disjoint r₂) : r₂.Disjoint r₁ := by
  intro b hb2
  cases hb1 : r₁.contains b with
  | false => rfl
  | true =>
    have h2 := h b hb1
    rw [hb2] at h2
    cases h2

/-- Argument range of `slice::split_at_mut` on `[base, base + len)`. -/
def wholeRange (base len : Nat) : ByteRange := ⟨base, base + len⟩

/-- Left half `[base, base + mid)`. -/
def splitLeft (base mid : Nat) : ByteRange := ⟨base, base + mid⟩

/-- Right half `[base + mid, base + len)`. -/
def splitRight (base mid len : Nat) : ByteRange := ⟨base + mid, base + len⟩

theorem split_disjoint (base mid len : Nat) : (splitLeft base mid).Disjoint (splitRight base mid len) := by
  intro b hb
  rw [ByteRange.contains_iff] at hb
  apply ByteRange.contains_eq_false
  simp only [splitRight, splitLeft] at hb ⊢
  omega

theorem splitLeft_sub {base mid len : Nat} (hmid : mid ≤ len) :
    (splitLeft base mid).Sub (wholeRange base len) := by
  intro b hb
  rw [ByteRange.contains_iff] at hb ⊢
  simp only [splitLeft, wholeRange] at hb ⊢
  exact ⟨by omega, by omega⟩

theorem splitRight_sub (base mid len : Nat) : (splitRight base mid len).Sub (wholeRange base len) := by
  intro b hb
  rw [ByteRange.contains_iff] at hb ⊢
  simp only [splitRight, wholeRange] at hb ⊢
  exact ⟨by omega, by omega⟩

/-- The two halves cover the whole argument range (for `mid ≤ len`). -/
theorem split_cover (base mid len : Nat) (b : Nat)
    (hb : (wholeRange base len).contains b = true) :
    (splitLeft base mid).contains b = true ∨ (splitRight base mid len).contains b = true := by
  rw [ByteRange.contains_iff] at hb
  simp only [wholeRange] at hb
  by_cases h : b < base + mid
  · left; rw [ByteRange.contains_iff]; simp only [splitLeft]; exact ⟨by omega, by omega⟩
  · right; rw [ByteRange.contains_iff]; simp only [splitRight]; exact ⟨by omega, by omega⟩

/-- Tree Borrows permissions: `ReservedFrz`, `ReservedIM`, `Active` (Miri's
`Unique`), `Frozen`, `Disabled` (`Cell` is out of scope: no interior mutability). -/
inductive Permission where
  | reservedFrz (conflicted : Bool)
  | reservedIM
  | active
  | frozen
  | disabled
  deriving DecidableEq, Repr

/-- Per-byte state of a tag: permission and the `accessed` (initialized) flag. -/
structure LocationState where
  perm : Permission
  accessed : Bool
  deriving DecidableEq, Repr

inductive AccessKind where
  | read
  | write
  deriving DecidableEq, Repr

inductive AccessRelatedness where
  | localAccess
  | foreignAccess
  deriving DecidableEq, Repr

inductive ProtectorKind where
  | weak (callId : CallId)
  | strong (callId : CallId)
  deriving DecidableEq, Repr

def ProtectorKind.callId : ProtectorKind → CallId
  | .weak c => c
  | .strong c => c

/-- Implicit access performed at protector end for an accessed location. -/
def Permission.associatedAccess : Permission → AccessKind
  | .active => .write
  | _ => .read

/-- Per-location transition; `none` is undefined behavior.  This is Miri's
`perform_access` (per-permission transition, then the `ProtectedDisabled`
protector check guarded by `accessed`), with Miri's `skip_if_known_noop` rule that
a foreign access to a `Disabled` node is a no-op, and with a protected
`ReservedIM` (an invariant violation that Miri asserts away) failing closed.
`performTransition_accessed_eq_live` / `performTransition_unaccessed_eq_live`
prove it equal to the trusted `treeBorrowNodeAccess` /
`treeBorrowPermTransition`. -/
def performTransition (kind : AccessKind) (rel : AccessRelatedness) (isProtected : Bool)
    (st : LocationState) : Option LocationState :=
  match rel, kind with
  | .localAccess, .read =>
    match st.perm with
    | .disabled => none
    | p => some ⟨p, true⟩
  | .localAccess, .write =>
    match st.perm with
    | .reservedFrz true => if isProtected then none else some ⟨.active, true⟩
    | .reservedFrz false => some ⟨.active, true⟩
    | .reservedIM => some ⟨.active, true⟩
    | .active => some ⟨.active, true⟩
    | .frozen => none
    | .disabled => none
  | .foreignAccess, .read =>
    match st.perm with
    | .reservedFrz c => some ⟨.reservedFrz (isProtected || c), st.accessed⟩
    | .reservedIM => if isProtected then none else some ⟨.reservedIM, st.accessed⟩
    | .active =>
      if isProtected then (if st.accessed then none else some ⟨.disabled, st.accessed⟩)
      else some ⟨.frozen, st.accessed⟩
    | .frozen => some ⟨.frozen, st.accessed⟩
    | .disabled => some ⟨.disabled, st.accessed⟩
  | .foreignAccess, .write =>
    match st.perm with
    | .reservedIM => if isProtected then none else some ⟨.reservedIM, st.accessed⟩
    | .disabled => some ⟨.disabled, st.accessed⟩
    | _ => if isProtected && st.accessed then none else some ⟨.disabled, st.accessed⟩

inductive ChildrenVisitMode where
  | visitChildrenOfAccessed
  | skipChildrenOfAccessed
  deriving DecidableEq, Repr

/-- Arbitrary-depth, arbitrary-branching borrow tree of one allocation. -/
structure BorrowTree where
  present : BorTag → Bool
  isAnc : BorTag → BorTag → Bool
  protector : BorTag → Option ProtectorKind
  locState : BorTag → Nat → LocationState

/-- Well-formed ancestry (a forest order with linearly ordered ancestors). -/
structure TreeWF (tree : BorrowTree) : Prop where
  isAnc_refl : ∀ t, tree.present t = true → tree.isAnc t t = true
  isAnc_trans : ∀ a b c, tree.isAnc a b = true → tree.isAnc b c = true → tree.isAnc a c = true
  isAnc_antisymm : ∀ a b, tree.isAnc a b = true → tree.isAnc b a = true → a = b
  isAnc_present_left : ∀ a b, tree.isAnc a b = true → tree.present a = true
  isAnc_present_right : ∀ a b, tree.isAnc a b = true → tree.present b = true
  anc_linear : ∀ a b c, tree.isAnc a c = true → tree.isAnc b c = true →
    tree.isAnc a b = true ∨ tree.isAnc b a = true

/-- Set of active call ids (`GlobalState` protector frames). -/
abbrev ActiveProtectors := CallId → Bool

def BorrowTree.isTagProtected (tree : BorrowTree) (t : BorTag) (active : ActiveProtectors) : Bool :=
  match tree.protector t with
  | some p => active p.callId
  | none => false

/-- Relatedness of node `n` to an access at `start`; `skipChildrenOfAccessed`
skips strict descendants of `start` (`none`). -/
def nodeAccessRelatedness (tree : BorrowTree) (start : BorTag) (mode : ChildrenVisitMode)
    (n : BorTag) : Option AccessRelatedness :=
  if tree.isAnc n start then some .localAccess
  else
    match mode with
    | .visitChildrenOfAccessed => some .foreignAccess
    | .skipChildrenOfAccessed => if tree.isAnc start n then none else some .foreignAccess

/-- No node traps on an access of `kind` at `start` over `range`. -/
def TreeAccessNoUB (tree : BorrowTree) (start : BorTag) (kind : AccessKind) (range : ByteRange)
    (active : ActiveProtectors) (mode : ChildrenVisitMode) : Prop :=
  ∀ n b, tree.present n = true → range.contains b = true →
    match nodeAccessRelatedness tree start mode n with
    | some rel =>
      (performTransition kind rel (tree.isTagProtected n active) (tree.locState n b)).isSome = true
    | none => True

/-- Tree update for an access (paired with `TreeAccessNoUB` for UB-freedom). -/
def applyTreeAccess (tree : BorrowTree) (start : BorTag) (kind : AccessKind) (range : ByteRange)
    (active : ActiveProtectors) (mode : ChildrenVisitMode) : BorrowTree :=
  { tree with
    locState := fun n b =>
      if tree.present n && range.contains b then
        match nodeAccessRelatedness tree start mode n with
        | some rel =>
          match performTransition kind rel (tree.isTagProtected n active) (tree.locState n b) with
          | some st' => st'
          | none => tree.locState n b
        | none => tree.locState n b
      else tree.locState n b }

theorem applyTreeAccess_locState_in (tree : BorrowTree) (start : BorTag) (kind : AccessKind)
    (range : ByteRange) (active : ActiveProtectors) (mode : ChildrenVisitMode) (n : BorTag)
    (b : Nat) (hPres : tree.present n = true) (hb : range.contains b = true) :
    (applyTreeAccess tree start kind range active mode).locState n b =
      match nodeAccessRelatedness tree start mode n with
      | some rel =>
        match performTransition kind rel (tree.isTagProtected n active) (tree.locState n b) with
        | some st' => st'
        | none => tree.locState n b
      | none => tree.locState n b := by
  simp only [applyTreeAccess, hPres, hb, Bool.and_self, ↓reduceIte]

theorem applyTreeAccess_locState_out (tree : BorrowTree) (start : BorTag) (kind : AccessKind)
    (range : ByteRange) (active : ActiveProtectors) (mode : ChildrenVisitMode) (n : BorTag)
    (b : Nat) (hb : range.contains b = false) :
    (applyTreeAccess tree start kind range active mode).locState n b = tree.locState n b := by
  simp only [applyTreeAccess, hb, Bool.and_false, Bool.false_eq_true, ↓reduceIte]

/-- Insert a fresh child node (before the retag's initial child read). -/
def insertChildNode (tree : BorrowTree) (t_parent t_child : BorTag) (prot : Option ProtectorKind)
    (initPerm : Permission) : BorrowTree where
  present t := decide (t = t_child) || tree.present t
  isAnc a d :=
    if d = t_child then decide (a = t_child) || tree.isAnc a t_parent
    else if a = t_child then false
    else tree.isAnc a d
  protector t := if t = t_child then prot else tree.protector t
  locState t b := if t = t_child then ⟨initPerm, false⟩ else tree.locState t b

/-- Retag (`Miri` `RetagMode::Default` / `FnEntry`): insert a child and perform
the initial child read over `range`. -/
def retagChild (tree : BorrowTree) (t_parent t_child : BorTag) (prot : Option ProtectorKind)
    (initPerm : Permission) (range : ByteRange) (active : ActiveProtectors) : BorrowTree :=
  applyTreeAccess (insertChildNode tree t_parent t_child prot initPerm) t_child .read range active
    .visitChildrenOfAccessed

/-- Stage 1 of protector release is UB-free (implicit access with
`skipChildrenOfAccessed` while the call id is still active). -/
def releaseProtectorNoUB (tree : BorrowTree) (t_rel : BorTag) (active : ActiveProtectors) : Prop :=
  ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
    match nodeAccessRelatedness tree t_rel .skipChildrenOfAccessed n with
    | some rel =>
      (performTransition (tree.locState t_rel b).perm.associatedAccess rel
        (tree.isTagProtected n active) (tree.locState n b)).isSome = true
    | none => True

/-- Stage 1 of protector release (`ChildrenVisitMode.SkipChildrenOfAccessed`
while the call id is active). -/
def applyReleaseProtector (tree : BorrowTree) (t_rel : BorTag) (active : ActiveProtectors) :
    BorrowTree :=
  { tree with
    locState := fun n b =>
      if tree.present n && (tree.locState t_rel b).accessed then
        match nodeAccessRelatedness tree t_rel .skipChildrenOfAccessed n with
        | some rel =>
          match performTransition (tree.locState t_rel b).perm.associatedAccess rel
              (tree.isTagProtected n active) (tree.locState n b) with
          | some st' => st'
          | none => tree.locState n b
        | none => tree.locState n b
      else tree.locState n b }

theorem applyReleaseProtector_locState_acc (tree : BorrowTree) (t_rel : BorTag)
    (active : ActiveProtectors) (n : BorTag) (b : Nat) (hPres : tree.present n = true)
    (hAcc : (tree.locState t_rel b).accessed = true) :
    (applyReleaseProtector tree t_rel active).locState n b =
      match nodeAccessRelatedness tree t_rel .skipChildrenOfAccessed n with
      | some rel =>
        match performTransition (tree.locState t_rel b).perm.associatedAccess rel
            (tree.isTagProtected n active) (tree.locState n b) with
        | some st' => st'
        | none => tree.locState n b
      | none => tree.locState n b := by
  simp only [applyReleaseProtector, hPres, hAcc, Bool.and_self, ↓reduceIte]

theorem applyReleaseProtector_locState_unacc (tree : BorrowTree) (t_rel : BorTag)
    (active : ActiveProtectors) (n : BorTag) (b : Nat)
    (hAcc : (tree.locState t_rel b).accessed = false) :
    (applyReleaseProtector tree t_rel active).locState n b = tree.locState n b := by
  simp only [applyReleaseProtector, hAcc, Bool.and_false, Bool.false_eq_true, ↓reduceIte]

/-- Stage 2 of protector release (`GlobalState.endCall`): drop the call id. -/
def removeActiveProtector (active : ActiveProtectors) (callId : CallId) : ActiveProtectors :=
  fun c => if c = callId then false else active c

/-- Function entry pushes a fresh call id. -/
def insertActiveProtector (active : ActiveProtectors) (callId : CallId) : ActiveProtectors :=
  fun c => decide (c = callId) || active c

/-- Ancestor states that support local reads and writes without protector UB. -/
def AncestorWritable (st : LocationState) : Prop :=
  st.perm = .active ∨ st.perm = .reservedFrz false ∨ st.perm = .reservedIM

instance (st : LocationState) : Decidable (AncestorWritable st) :=
  inferInstanceAs (Decidable (st.perm = .active ∨ st.perm = .reservedFrz false ∨ st.perm = .reservedIM))

/-- Non-ancestor states that never trap under foreign reads or writes: unprotected,
or unaccessed (Miri's `accessed` guard on the protector check) and not the
fail-closed protected `ReservedIM`. -/
def NonAncestorSafe (st : LocationState) (isProt : Bool) : Prop :=
  isProt = false ∨ (st.accessed = false ∧ st.perm ≠ .reservedIM)

instance (st : LocationState) (isProt : Bool) : Decidable (NonAncestorSafe st isProt) :=
  inferInstanceAs (Decidable (isProt = false ∨ (st.accessed = false ∧ st.perm ≠ .reservedIM)))

/-- **`HasUniqueWritePerm`**: every ancestor of `tag` is writable on `range` and
every non-ancestor is isolated (`NonAncestorSafe`). -/
structure HasUniqueWritePerm (tree : BorrowTree) (tag : BorTag) (range : ByteRange)
    (active : ActiveProtectors) : Prop where
  wf : TreeWF tree
  tag_present : tree.present tag = true
  ancestors_writable : ∀ anc b, tree.isAnc anc tag = true → range.contains b = true →
    AncestorWritable (tree.locState anc b)
  non_ancestors_safe : ∀ other b, tree.present other = true → tree.isAnc other tag = false →
    range.contains b = true → NonAncestorSafe (tree.locState other b) (tree.isTagProtected other active)

theorem performTransition_local_of_ancestorWritable (kind : AccessKind) (isProt : Bool)
    (st : LocationState) (h : AncestorWritable st) :
    ∃ st', performTransition kind .localAccess isProt st = some st' ∧
      AncestorWritable st' ∧ st'.accessed = true := by
  rcases st with ⟨perm, acc⟩
  rcases h with h | h | h <;> (simp only at h; subst h) <;> cases kind <;> cases acc <;>
    exact ⟨_, rfl, by decide, rfl⟩

theorem performTransition_local_write_of_ancestorWritable (isProt : Bool) (st : LocationState)
    (h : AncestorWritable st) :
    performTransition .write .localAccess isProt st = some ⟨.active, true⟩ := by
  rcases st with ⟨perm, acc⟩
  rcases h with h | h | h <;> (simp only at h; subst h) <;> rfl

theorem performTransition_foreign_of_nonAncestorSafe (kind : AccessKind) (isProt : Bool)
    (st : LocationState) (h : NonAncestorSafe st isProt) :
    ∃ st', performTransition kind .foreignAccess isProt st = some st' ∧
      NonAncestorSafe st' isProt ∧ st'.accessed = st.accessed := by
  rcases st with ⟨perm, acc⟩
  rcases perm with (_ | _) | _ | _ | _ | _ <;> cases kind <;> cases isProt <;> cases acc <;>
    first
    | exact ⟨_, rfl, by decide, rfl⟩
    | exact absurd h (by decide)

theorem nonAncestorSafe_mono_unprotect (st : LocationState) (isProt1 isProt2 : Bool)
    (hSafe : NonAncestorSafe st isProt1) (hImp : isProt2 = true → isProt1 = true) :
    NonAncestorSafe st isProt2 := by
  rcases hSafe with hUnprot | hUnacc
  · left
    cases h2 : isProt2 with
    | false => rfl
    | true =>
      have h1 := hImp h2
      rw [hUnprot] at h1
      cases h1
  · exact Or.inr hUnacc

theorem insertChildNode_present (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (t : BorTag) :
    (insertChildNode tree t_parent t_child prot initPerm).present t =
      (decide (t = t_child) || tree.present t) := rfl

theorem insertChildNode_isAnc_child (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (a : BorTag) :
    (insertChildNode tree t_parent t_child prot initPerm).isAnc a t_child =
      (decide (a = t_child) || tree.isAnc a t_parent) := by
  show (if t_child = t_child then _ else _) = _
  rw [ite_eq_left rfl]

theorem insertChildNode_isAnc_of_ne (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) {a d : BorTag}
    (hd : d ≠ t_child) (ha : a ≠ t_child) :
    (insertChildNode tree t_parent t_child prot initPerm).isAnc a d = tree.isAnc a d := by
  show (if d = t_child then _ else if a = t_child then false else _) = _
  rw [ite_eq_right hd, ite_eq_right ha]

theorem insertChildNode_isAnc_from_child (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) {d : BorTag} (hd : d ≠ t_child) :
    (insertChildNode tree t_parent t_child prot initPerm).isAnc t_child d = false := by
  show (if d = t_child then _ else if t_child = t_child then false else _) = _
  rw [ite_eq_right hd, ite_eq_left rfl]

theorem insertChildNode_locState_of_ne (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) {t : BorTag} (ht : t ≠ t_child) (b : Nat) :
    (insertChildNode tree t_parent t_child prot initPerm).locState t b = tree.locState t b := by
  show (if t = t_child then _ else _) = _
  rw [ite_eq_right ht]

theorem insertChildNode_locState_child (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (b : Nat) :
    (insertChildNode tree t_parent t_child prot initPerm).locState t_child b = ⟨initPerm, false⟩ := by
  show (if t_child = t_child then _ else _) = _
  rw [ite_eq_left rfl]

theorem insertChildNode_isTagProtected_of_ne (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) {t : BorTag} (ht : t ≠ t_child)
    (active : ActiveProtectors) :
    (insertChildNode tree t_parent t_child prot initPerm).isTagProtected t active =
      tree.isTagProtected t active := by
  unfold BorrowTree.isTagProtected
  show (match (if t = t_child then prot else tree.protector t) with
    | some p => active p.callId | none => false) = _
  rw [ite_eq_right ht]

theorem insertChildNode_isTagProtected_child_none (tree : BorrowTree) (t_parent t_child : BorTag)
    (initPerm : Permission) (active : ActiveProtectors) :
    (insertChildNode tree t_parent t_child none initPerm).isTagProtected t_child active = false := by
  unfold BorrowTree.isTagProtected
  show (match (if t_child = t_child then none else tree.protector t_child) with
    | some p => active p.callId | none => false) = _
  rw [ite_eq_left rfl]

theorem ne_of_present_of_fresh {tree : BorrowTree} {x t : BorTag}
    (hx : tree.present x = true) (hFresh : tree.present t = false) : x ≠ t := by
  intro hEq
  rw [hEq, hFresh] at hx
  cases hx

theorem insertChildNode_wf (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (hwf : TreeWF tree)
    (hFresh : tree.present t_child = false) :
    TreeWF (insertChildNode tree t_parent t_child prot initPerm) := by
  have hNe : ∀ x, tree.present x = true → x ≠ t_child := fun x hx => ne_of_present_of_fresh hx hFresh
  -- ancestry into the child: `a` is the child or an ancestor of the parent
  have hIntoChild : ∀ a, (insertChildNode tree t_parent t_child prot initPerm).isAnc a t_child = true →
      a = t_child ∨ tree.isAnc a t_parent = true := by
    intro a h
    rw [insertChildNode_isAnc_child, Bool.or_eq_true, decide_eq_true_iff] at h
    exact h
  -- ancestry not involving the child is the old ancestry
  have hOld : ∀ a d, d ≠ t_child →
      (insertChildNode tree t_parent t_child prot initPerm).isAnc a d = true →
      a ≠ t_child ∧ tree.isAnc a d = true := by
    intro a d hd h
    by_cases ha : a = t_child
    · subst ha
      rw [insertChildNode_isAnc_from_child _ _ _ _ _ hd] at h
      cases h
    · exact ⟨ha, by rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hd ha] at h⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t ht
    by_cases htc : t = t_child
    · subst htc
      rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
    · rw [insertChildNode_isAnc_of_ne _ _ _ _ _ htc htc]
      rw [insertChildNode_present, decide_eq_false htc, Bool.false_or] at ht
      exact hwf.isAnc_refl t ht
  · intro a b c hab hbc
    by_cases hct : c = t_child
    · subst hct
      rw [insertChildNode_isAnc_child, Bool.or_eq_true, decide_eq_true_iff]
      rcases hIntoChild b hbc with hb | hb
      · subst hb
        rcases hIntoChild a hab with ha | ha
        · exact Or.inl ha
        · exact Or.inr ha
      · have hbne : b ≠ c := hNe b (hwf.isAnc_present_left b t_parent hb)
        obtain ⟨_, hab'⟩ := hOld a b hbne hab
        exact Or.inr (hwf.isAnc_trans a b t_parent hab' hb)
    · obtain ⟨hbne, hbc'⟩ := hOld b c hct hbc
      obtain ⟨hane, hab'⟩ := hOld a b hbne hab
      rw [insertChildNode_isAnc_of_ne _ _ _ _ _ hct hane]
      exact hwf.isAnc_trans a b c hab' hbc'
  · intro a b hab hba
    by_cases hbt : b = t_child
    · subst hbt
      by_cases hat : a = b
      · exact hat
      · obtain ⟨hbne, _⟩ := hOld b a hat hba
        exact absurd rfl hbne
    · obtain ⟨hane, hab'⟩ := hOld a b hbt hab
      obtain ⟨_, hba'⟩ := hOld b a hane hba
      exact hwf.isAnc_antisymm a b hab' hba'
  · intro a b hab
    rw [insertChildNode_present, Bool.or_eq_true, decide_eq_true_iff]
    by_cases hbt : b = t_child
    · subst hbt
      rcases hIntoChild a hab with ha | ha
      · exact Or.inl ha
      · exact Or.inr (hwf.isAnc_present_left a t_parent ha)
    · obtain ⟨_, hab'⟩ := hOld a b hbt hab
      exact Or.inr (hwf.isAnc_present_left a b hab')
  · intro a b hab
    rw [insertChildNode_present, Bool.or_eq_true, decide_eq_true_iff]
    by_cases hbt : b = t_child
    · exact Or.inl hbt
    · obtain ⟨_, hab'⟩ := hOld a b hbt hab
      exact Or.inr (hwf.isAnc_present_right a b hab')
  · intro a b c hac hbc
    by_cases hct : c = t_child
    · rw [hct] at hac hbc
      rcases hIntoChild a hac with ha | ha
      · right
        rw [ha]
        exact hbc
      · rcases hIntoChild b hbc with hb | hb
        · left
          rw [hb]
          exact hac
        · have hane := hNe a (hwf.isAnc_present_left a t_parent ha)
          have hbne := hNe b (hwf.isAnc_present_left b t_parent hb)
          rw [insertChildNode_isAnc_of_ne _ _ _ _ _ hbne hane,
            insertChildNode_isAnc_of_ne _ _ _ _ _ hane hbne]
          exact hwf.anc_linear a b t_parent ha hb
    · obtain ⟨hane, hac'⟩ := hOld a c hct hac
      obtain ⟨hbne, hbc'⟩ := hOld b c hct hbc
      rw [insertChildNode_isAnc_of_ne _ _ _ _ _ hbne hane,
        insertChildNode_isAnc_of_ne _ _ _ _ _ hane hbne]
      exact hwf.anc_linear a b c hac' hbc'

theorem applyTreeAccess_wf (tree : BorrowTree) (start : BorTag) (kind : AccessKind)
    (range : ByteRange) (active : ActiveProtectors) (mode : ChildrenVisitMode)
    (hwf : TreeWF tree) : TreeWF (applyTreeAccess tree start kind range active mode) :=
  ⟨hwf.isAnc_refl, hwf.isAnc_trans, hwf.isAnc_antisymm,
   hwf.isAnc_present_left, hwf.isAnc_present_right, hwf.anc_linear⟩

theorem applyReleaseProtector_wf (tree : BorrowTree) (t_rel : BorTag) (active : ActiveProtectors)
    (hwf : TreeWF tree) : TreeWF (applyReleaseProtector tree t_rel active) :=
  ⟨hwf.isAnc_refl, hwf.isAnc_trans, hwf.isAnc_antisymm,
   hwf.isAnc_present_left, hwf.isAnc_present_right, hwf.anc_linear⟩

theorem nodeAccessRelatedness_anc {tree : BorrowTree} {start n : BorTag} {mode : ChildrenVisitMode}
    (h : tree.isAnc n start = true) : nodeAccessRelatedness tree start mode n = some .localAccess := by
  unfold nodeAccessRelatedness
  rw [ite_eq_left h]

theorem nodeAccessRelatedness_visit_foreign {tree : BorrowTree} {start n : BorTag}
    (h : tree.isAnc n start = false) :
    nodeAccessRelatedness tree start .visitChildrenOfAccessed n = some .foreignAccess := by
  unfold nodeAccessRelatedness
  rw [ite_eq_right (by rw [h]; exact Bool.false_ne_true)]

theorem nodeAccessRelatedness_skip_desc {tree : BorrowTree} {start n : BorTag}
    (h : tree.isAnc n start = false) (hd : tree.isAnc start n = true) :
    nodeAccessRelatedness tree start .skipChildrenOfAccessed n = none := by
  unfold nodeAccessRelatedness
  rw [ite_eq_right (by rw [h]; exact Bool.false_ne_true)]
  show (if tree.isAnc start n = true then none else some AccessRelatedness.foreignAccess) = none
  rw [ite_eq_left hd]

theorem nodeAccessRelatedness_skip_foreign {tree : BorrowTree} {start n : BorTag}
    (h : tree.isAnc n start = false) (hd : tree.isAnc start n = false) :
    nodeAccessRelatedness tree start .skipChildrenOfAccessed n = some .foreignAccess := by
  unfold nodeAccessRelatedness
  rw [ite_eq_right (by rw [h]; exact Bool.false_ne_true)]
  show (if tree.isAnc start n = true then none else some AccessRelatedness.foreignAccess) = _
  rw [ite_eq_right (by rw [hd]; exact Bool.false_ne_true)]

theorem hasUniqueWritePerm_narrow {tree : BorrowTree} {tag : BorTag} {r₁ r₂ : ByteRange}
    {active : ActiveProtectors} (hPerm : HasUniqueWritePerm tree tag r₂ active) (hSub : r₁.Sub r₂) :
    HasUniqueWritePerm tree tag r₁ active where
  wf := hPerm.wf
  tag_present := hPerm.tag_present
  ancestors_writable := fun anc b hAnc hb => hPerm.ancestors_writable anc b hAnc (hSub b hb)
  non_ancestors_safe := fun other b hPres hNotAnc hb =>
    hPerm.non_ancestors_safe other b hPres hNotAnc (hSub b hb)

/-- Local accesses through `tag` inside its range are UB-free and preserve
`HasUniqueWritePerm`. -/
theorem local_access_preserves_hasUniqueWritePerm {tree : BorrowTree} {tag : BorTag}
    {range subRange : ByteRange} {active : ActiveProtectors} (kind : AccessKind)
    (hPerm : HasUniqueWritePerm tree tag range active) (hSub : subRange.Sub range) :
    TreeAccessNoUB tree tag kind subRange active .visitChildrenOfAccessed ∧
      HasUniqueWritePerm (applyTreeAccess tree tag kind subRange active .visitChildrenOfAccessed)
        tag range active := by
  constructor
  · intro n b hPres hbSub
    have hbRange := hSub b hbSub
    cases hAnc : tree.isAnc n tag with
    | true =>
      rw [nodeAccessRelatedness_anc hAnc]
      obtain ⟨st', hEq, _⟩ := performTransition_local_of_ancestorWritable kind
        (tree.isTagProtected n active) (tree.locState n b) (hPerm.ancestors_writable n b hAnc hbRange)
      show (performTransition kind .localAccess _ _).isSome = true
      rw [hEq]; rfl
    | false =>
      rw [nodeAccessRelatedness_visit_foreign hAnc]
      obtain ⟨st', hEq, _⟩ := performTransition_foreign_of_nonAncestorSafe kind
        (tree.isTagProtected n active) (tree.locState n b)
        (hPerm.non_ancestors_safe n b hPres hAnc hbRange)
      show (performTransition kind .foreignAccess _ _).isSome = true
      rw [hEq]; rfl
  · refine ⟨applyTreeAccess_wf tree tag kind subRange active .visitChildrenOfAccessed hPerm.wf,
      hPerm.tag_present, ?_, ?_⟩
    · intro anc b hAnc hbRange
      have hAncOrig : tree.isAnc anc tag = true := hAnc
      have hPresAnc : tree.present anc = true := hPerm.wf.isAnc_present_left anc tag hAncOrig
      cases hbSub : subRange.contains b with
      | true =>
        rw [applyTreeAccess_locState_in tree tag kind subRange active .visitChildrenOfAccessed
          anc b hPresAnc hbSub, nodeAccessRelatedness_anc hAncOrig]
        obtain ⟨st', hEq, hAw, _⟩ := performTransition_local_of_ancestorWritable kind
          (tree.isTagProtected anc active) (tree.locState anc b)
          (hPerm.ancestors_writable anc b hAncOrig hbRange)
        show AncestorWritable (match performTransition kind .localAccess _ _ with
          | some st' => st' | none => _)
        rw [hEq]
        exact hAw
      | false =>
        rw [applyTreeAccess_locState_out tree tag kind subRange active .visitChildrenOfAccessed
          anc b hbSub]
        exact hPerm.ancestors_writable anc b hAncOrig hbRange
    · intro other b hPres hNotAnc hbRange
      have hPresOrig : tree.present other = true := hPres
      have hNotAncOrig : tree.isAnc other tag = false := hNotAnc
      show NonAncestorSafe _ (tree.isTagProtected other active)
      cases hbSub : subRange.contains b with
      | true =>
        rw [applyTreeAccess_locState_in tree tag kind subRange active .visitChildrenOfAccessed
          other b hPresOrig hbSub, nodeAccessRelatedness_visit_foreign hNotAncOrig]
        obtain ⟨st', hEq, hSafe, _⟩ := performTransition_foreign_of_nonAncestorSafe kind
          (tree.isTagProtected other active) (tree.locState other b)
          (hPerm.non_ancestors_safe other b hPresOrig hNotAncOrig hbRange)
        show NonAncestorSafe (match performTransition kind .foreignAccess _ _ with
          | some st' => st' | none => _) _
        rw [hEq]
        exact hSafe
      | false =>
        rw [applyTreeAccess_locState_out tree tag kind subRange active .visitChildrenOfAccessed
          other b hbSub]
        exact hPerm.non_ancestors_safe other b hPresOrig hNotAncOrig hbRange

/-- A local write through `tag` activates `tag` and all its ancestors on the
written bytes. -/
theorem local_write_activates_ancestors {tree : BorrowTree} {tag anc : BorTag}
    {range subRange : ByteRange} {active : ActiveProtectors} {b : Nat}
    (hPerm : HasUniqueWritePerm tree tag range active) (hSub : subRange.Sub range)
    (hAnc : tree.isAnc anc tag = true) (hb : subRange.contains b = true) :
    (applyTreeAccess tree tag .write subRange active .visitChildrenOfAccessed).locState anc b =
      ⟨.active, true⟩ := by
  have hPresAnc : tree.present anc = true := hPerm.wf.isAnc_present_left anc tag hAnc
  rw [applyTreeAccess_locState_in tree tag .write subRange active .visitChildrenOfAccessed
    anc b hPresAnc hb, nodeAccessRelatedness_anc hAnc]
  show (match performTransition .write .localAccess _ _ with | some st' => st' | none => _) = _
  rw [performTransition_local_write_of_ancestorWritable _ _
    (hPerm.ancestors_writable anc b hAnc (hSub b hb))]

/-- Retagging a fresh child `t_child` (with a writable initial permission) under
`t_parent` on `childRange ⊆ parentRange` is UB-free and establishes
`HasUniqueWritePerm` for the child. -/
theorem retagChild_hasUniqueWritePerm {tree : BorrowTree} {t_parent t_child : BorTag}
    {parentRange childRange : ByteRange} {active : ActiveProtectors}
    (prot : Option ProtectorKind) {initPerm : Permission}
    (hInit : AncestorWritable ⟨initPerm, false⟩)
    (hPerm : HasUniqueWritePerm tree t_parent parentRange active)
    (hSub : childRange.Sub parentRange) (hFresh : tree.present t_child = false) :
    TreeAccessNoUB (insertChildNode tree t_parent t_child prot initPerm) t_child .read childRange
        active .visitChildrenOfAccessed ∧
      HasUniqueWritePerm (retagChild tree t_parent t_child prot initPerm childRange active)
        t_child childRange active := by
  have hwf1 := insertChildNode_wf tree t_parent t_child prot initPerm hPerm.wf hFresh
  have hPre : HasUniqueWritePerm (insertChildNode tree t_parent t_child prot initPerm) t_child
      childRange active := by
    refine ⟨hwf1, by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or], ?_, ?_⟩
    · intro anc b hAnc hbChild
      rw [insertChildNode_isAnc_child, Bool.or_eq_true, decide_eq_true_iff] at hAnc
      by_cases hac : anc = t_child
      · rw [hac, insertChildNode_locState_child]
        exact hInit
      · rw [insertChildNode_locState_of_ne _ _ _ _ _ hac]
        rcases hAnc with h | h
        · exact absurd h hac
        · exact hPerm.ancestors_writable anc b h (hSub b hbChild)
    · intro other b hPres hNotAnc hbChild
      rw [insertChildNode_isAnc_child, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hNotAnc
      obtain ⟨hOtherNe, hNotAncOrig⟩ := hNotAnc
      rw [insertChildNode_present, decide_eq_false hOtherNe, Bool.false_or] at hPres
      rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ hOtherNe,
        insertChildNode_locState_of_ne _ _ _ _ _ hOtherNe]
      exact hPerm.non_ancestors_safe other b hPres hNotAncOrig (hSub b hbChild)
  exact local_access_preserves_hasUniqueWritePerm .read hPre (ByteRange.Sub.refl _)

/-- Retagging an unprotected child keeps the parent's `HasUniqueWritePerm`. -/
theorem retagUnprotectedChild_preserves_parent_hasUniqueWritePerm {tree : BorrowTree}
    {t_parent t_child : BorTag} {parentRange childRange : ByteRange} {active : ActiveProtectors}
    {initPerm : Permission}
    (hPerm : HasUniqueWritePerm tree t_parent parentRange active)
    (hFresh : tree.present t_child = false) :
    HasUniqueWritePerm (retagChild tree t_parent t_child none initPerm childRange active)
      t_parent parentRange active := by
  have hParentNe : t_parent ≠ t_child := ne_of_present_of_fresh hPerm.tag_present hFresh
  let tree1 := insertChildNode tree t_parent t_child none initPerm
  have hwf1 : TreeWF tree1 := insertChildNode_wf tree t_parent t_child none initPerm hPerm.wf hFresh
  refine ⟨applyTreeAccess_wf tree1 t_child .read childRange active .visitChildrenOfAccessed hwf1,
    ?_, ?_, ?_⟩
  · show tree1.present t_parent = true
    rw [insertChildNode_present, hPerm.tag_present, Bool.or_true]
  · intro anc b hAnc hbParent
    have hAnc1 : tree1.isAnc anc t_parent = true := hAnc
    have hAncNe : anc ≠ t_child := by
      intro hEq
      rw [hEq] at hAnc1
      have : tree1.isAnc t_child t_parent = false :=
        insertChildNode_isAnc_from_child _ _ _ _ _ hParentNe
      rw [this] at hAnc1
      cases hAnc1
    have hAncOrig : tree.isAnc anc t_parent = true := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hParentNe hAncNe] at hAnc1
    have hPresAnc : tree.present anc = true := hPerm.wf.isAnc_present_left anc t_parent hAncOrig
    have hPres1 : tree1.present anc = true := by
      rw [insertChildNode_present, hPresAnc, Bool.or_true]
    have hAncChild1 : tree1.isAnc anc t_child = true := by
      rw [insertChildNode_isAnc_child, hAncOrig, Bool.or_true]
    have hLoc1 : tree1.locState anc b = tree.locState anc b :=
      insertChildNode_locState_of_ne _ _ _ _ _ hAncNe b
    show AncestorWritable ((applyTreeAccess tree1 t_child .read childRange active
      .visitChildrenOfAccessed).locState anc b)
    cases hbChild : childRange.contains b with
    | true =>
      rw [applyTreeAccess_locState_in tree1 t_child .read childRange active .visitChildrenOfAccessed
        anc b hPres1 hbChild, nodeAccessRelatedness_anc hAncChild1, hLoc1]
      obtain ⟨st', hEq, hAw, _⟩ := performTransition_local_of_ancestorWritable .read
        (tree1.isTagProtected anc active) (tree.locState anc b)
        (hPerm.ancestors_writable anc b hAncOrig hbParent)
      show AncestorWritable (match performTransition .read .localAccess _ _ with
        | some st' => st' | none => _)
      rw [hEq]
      exact hAw
    | false =>
      rw [applyTreeAccess_locState_out tree1 t_child .read childRange active .visitChildrenOfAccessed
        anc b hbChild, hLoc1]
      exact hPerm.ancestors_writable anc b hAncOrig hbParent
  · intro other b hPres hNotAnc hbParent
    have hPres1 : tree1.present other = true := hPres
    have hNotAnc1 : tree1.isAnc other t_parent = false := hNotAnc
    show NonAncestorSafe _ (tree1.isTagProtected other active)
    by_cases hOther : other = t_child
    · left
      rw [hOther]
      exact insertChildNode_isTagProtected_child_none _ _ _ _ _
    · have hPresOrig : tree.present other = true := by
        rwa [insertChildNode_present, decide_eq_false hOther, Bool.false_or] at hPres1
      have hNotAncOrig : tree.isAnc other t_parent = false := by
        rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hParentNe hOther] at hNotAnc1
      have hNotAncChild1 : tree1.isAnc other t_child = false := by
        rw [insertChildNode_isAnc_child, decide_eq_false hOther, hNotAncOrig, Bool.false_or]
      have hLoc1 : tree1.locState other b = tree.locState other b :=
        insertChildNode_locState_of_ne _ _ _ _ _ hOther b
      have hProt1 : tree1.isTagProtected other active = tree.isTagProtected other active :=
        insertChildNode_isTagProtected_of_ne _ _ _ _ _ hOther active
      rw [hProt1]
      show NonAncestorSafe ((applyTreeAccess tree1 t_child .read childRange active
        .visitChildrenOfAccessed).locState other b) (tree.isTagProtected other active)
      cases hbChild : childRange.contains b with
      | true =>
        rw [applyTreeAccess_locState_in tree1 t_child .read childRange active .visitChildrenOfAccessed
          other b hPres1 hbChild, nodeAccessRelatedness_visit_foreign hNotAncChild1, hLoc1, hProt1]
        obtain ⟨st', hEq, hSafe, _⟩ := performTransition_foreign_of_nonAncestorSafe .read
          (tree.isTagProtected other active) (tree.locState other b)
          (hPerm.non_ancestors_safe other b hPresOrig hNotAncOrig hbParent)
        show NonAncestorSafe (match performTransition .read .foreignAccess _ _ with
          | some st' => st' | none => _) _
        rw [hEq]
        exact hSafe
      | false =>
        rw [applyTreeAccess_locState_out tree1 t_child .read childRange active .visitChildrenOfAccessed
          other b hbChild, hLoc1]
        exact hPerm.non_ancestors_safe other b hPresOrig hNotAncOrig hbParent

theorem retagChild_present (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (range : ByteRange)
    (active : ActiveProtectors) (t : BorTag) :
    (retagChild tree t_parent t_child prot initPerm range active).present t =
      (decide (t = t_child) || tree.present t) := rfl

theorem retagChild_isAnc (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (range : ByteRange)
    (active : ActiveProtectors) :
    (retagChild tree t_parent t_child prot initPerm range active).isAnc =
      (insertChildNode tree t_parent t_child prot initPerm).isAnc := rfl

theorem retagChild_isTagProtected (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (range : ByteRange)
    (active act2 : ActiveProtectors) (t : BorTag) :
    (retagChild tree t_parent t_child prot initPerm range active).isTagProtected t act2 =
      (insertChildNode tree t_parent t_child prot initPerm).isTagProtected t act2 := rfl

theorem retagChild_locState_out (tree : BorrowTree) (t_parent t_child : BorTag)
    (prot : Option ProtectorKind) (initPerm : Permission) (range : ByteRange)
    (active : ActiveProtectors) (n : BorTag) (b : Nat) (hbOut : range.contains b = false) :
    (retagChild tree t_parent t_child prot initPerm range active).locState n b =
      (insertChildNode tree t_parent t_child prot initPerm).locState n b :=
  applyTreeAccess_locState_out _ _ _ _ _ _ n b hbOut

/-- The retagged child is accessed exactly on its range. -/
theorem retagChild_child_accessed {tree : BorrowTree} {t_parent t_child : BorTag}
    {prot : Option ProtectorKind} {initPerm : Permission} {range : ByteRange}
    {active : ActiveProtectors} (hInit : initPerm ≠ .disabled) (b : Nat) :
    ((retagChild tree t_parent t_child prot initPerm range active).locState t_child b).accessed =
      range.contains b := by
  cases hb : range.contains b with
  | true =>
    rw [show retagChild tree t_parent t_child prot initPerm range active =
      applyTreeAccess (insertChildNode tree t_parent t_child prot initPerm) t_child .read range
        active .visitChildrenOfAccessed from rfl,
      applyTreeAccess_locState_in _ _ _ _ _ _ _ _
        (by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or]) hb,
      nodeAccessRelatedness_anc (by rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]),
      insertChildNode_locState_child]
    cases initPerm with
    | disabled => exact absurd rfl hInit
    | _ => rfl
  | false =>
    rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hb, insertChildNode_locState_child]

/-- State during a call: `FnEntry`-protected `t_arg` on `parentRange` and an
unprotected descendant `t_ret` on `subRange ⊆ parentRange`. -/
structure CalleeReborrowState (tree : BorrowTree) (t_arg t_ret : BorTag)
    (parentRange subRange : ByteRange) (activeCaller : ActiveProtectors) (callId : CallId) : Prop where
  sub_range : subRange.Sub parentRange
  arg_perm : HasUniqueWritePerm tree t_arg parentRange (insertActiveProtector activeCaller callId)
  ret_present : tree.present t_ret = true
  arg_anc_ret : tree.isAnc t_arg t_ret = true
  ret_ne_arg : t_ret ≠ t_arg
  arg_accessed_in_parent : ∀ b, (tree.locState t_arg b).accessed = true → parentRange.contains b = true
  ret_ancestors_writable : ∀ anc b, tree.isAnc anc t_ret = true → subRange.contains b = true →
    AncestorWritable (tree.locState anc b)
  descendants_unprotected_in_caller : ∀ d, tree.isAnc t_arg d = true → d ≠ t_arg →
    tree.isTagProtected d activeCaller = false

theorem isTagProtected_insert_of_caller {tree : BorrowTree} {t : BorTag}
    {activeCaller : ActiveProtectors} {callId : CallId}
    (h : tree.isTagProtected t activeCaller = true) :
    tree.isTagProtected t (insertActiveProtector activeCaller callId) = true := by
  unfold BorrowTree.isTagProtected at h ⊢
  cases hp : tree.protector t with
  | none => rw [hp] at h; cases h
  | some p =>
    rw [hp] at h
    change activeCaller p.callId = true at h
    show (decide (p.callId = callId) || activeCaller p.callId) = true
    rw [h, Bool.or_true]

/-- **Two-stage release preserves a pre-release reborrow**: stage 1
(`skipChildrenOfAccessed` while `callId` is active) is UB-free, skips the
descendant `t_ret` entirely, and stage 2 (`endCall`) leaves `t_ret` with
`HasUniqueWritePerm` in the caller. -/
theorem releaseProtector_preserves_reborrow_child {tree : BorrowTree} {t_arg t_ret : BorTag}
    {parentRange subRange : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hState : CalleeReborrowState tree t_arg t_ret parentRange subRange activeCaller callId) :
    releaseProtectorNoUB tree t_arg (insertActiveProtector activeCaller callId) ∧
      (∀ b, (applyReleaseProtector tree t_arg (insertActiveProtector activeCaller callId)).locState
        t_ret b = tree.locState t_ret b) ∧
      HasUniqueWritePerm (applyReleaseProtector tree t_arg (insertActiveProtector activeCaller callId))
        t_ret subRange activeCaller := by
  have hwf := hState.arg_perm.wf
  have hRetNotAncArg : tree.isAnc t_ret t_arg = false := by
    cases h : tree.isAnc t_ret t_arg with
    | false => rfl
    | true => exact absurd (hwf.isAnc_antisymm t_ret t_arg h hState.arg_anc_ret) hState.ret_ne_arg
  have hArgAw : ∀ b, parentRange.contains b = true → AncestorWritable (tree.locState t_arg b) :=
    fun b hb => hState.arg_perm.ancestors_writable t_arg b (hwf.isAnc_refl t_arg hState.arg_perm.tag_present) hb
  refine ⟨?_, ?_, ?_⟩
  · intro n b hPres hAcc
    have hbParent := hState.arg_accessed_in_parent b hAcc
    cases hAnc : tree.isAnc n t_arg with
    | true =>
      rw [nodeAccessRelatedness_anc hAnc]
      obtain ⟨st', hEq, _⟩ := performTransition_local_of_ancestorWritable
        (tree.locState t_arg b).perm.associatedAccess _ (tree.locState n b)
        (hState.arg_perm.ancestors_writable n b hAnc hbParent)
      show (performTransition _ .localAccess _ _).isSome = true
      rw [hEq]; rfl
    | false =>
      cases hDesc : tree.isAnc t_arg n with
      | true => rw [nodeAccessRelatedness_skip_desc hAnc hDesc]; trivial
      | false =>
        rw [nodeAccessRelatedness_skip_foreign hAnc hDesc]
        obtain ⟨st', hEq, _⟩ := performTransition_foreign_of_nonAncestorSafe
          (tree.locState t_arg b).perm.associatedAccess _ (tree.locState n b)
          (hState.arg_perm.non_ancestors_safe n b hPres hAnc hbParent)
        show (performTransition _ .foreignAccess _ _).isSome = true
        rw [hEq]; rfl
  · intro b
    cases hAcc : (tree.locState t_arg b).accessed with
    | false => exact applyReleaseProtector_locState_unacc tree t_arg _ t_ret b hAcc
    | true =>
      rw [applyReleaseProtector_locState_acc tree t_arg _ t_ret b hState.ret_present hAcc,
        nodeAccessRelatedness_skip_desc hRetNotAncArg hState.arg_anc_ret]
  · refine ⟨applyReleaseProtector_wf tree t_arg _ hwf, hState.ret_present, ?_, ?_⟩
    · intro anc b hAncRet hbSub
      have hPresAnc : tree.present anc = true := hwf.isAnc_present_left anc t_ret hAncRet
      have hbParent : parentRange.contains b = true := hState.sub_range b hbSub
      cases hAcc : (tree.locState t_arg b).accessed with
      | true =>
        rw [applyReleaseProtector_locState_acc tree t_arg _ anc b hPresAnc hAcc]
        cases hAncArg : tree.isAnc anc t_arg with
        | true =>
          rw [nodeAccessRelatedness_anc hAncArg]
          obtain ⟨st', hEq, hAw, _⟩ := performTransition_local_of_ancestorWritable
            (tree.locState t_arg b).perm.associatedAccess _ (tree.locState anc b)
            (hState.arg_perm.ancestors_writable anc b hAncArg hbParent)
          show AncestorWritable (match performTransition _ .localAccess _ _ with
            | some st' => st' | none => _)
          rw [hEq]
          exact hAw
        | false =>
          have hDescArg : tree.isAnc t_arg anc = true := by
            rcases hwf.anc_linear anc t_arg t_ret hAncRet hState.arg_anc_ret with h1 | h2
            · rw [hAncArg] at h1; cases h1
            · exact h2
          rw [nodeAccessRelatedness_skip_desc hAncArg hDescArg]
          exact hState.ret_ancestors_writable anc b hAncRet hbSub
      | false =>
        rw [applyReleaseProtector_locState_unacc tree t_arg _ anc b hAcc]
        exact hState.ret_ancestors_writable anc b hAncRet hbSub
    · intro other b hPres hNotAncRet hbSub
      have hPresOrig : tree.present other = true := hPres
      have hNotAncRetOrig : tree.isAnc other t_ret = false := hNotAncRet
      have hbParent : parentRange.contains b = true := hState.sub_range b hbSub
      show NonAncestorSafe _ (tree.isTagProtected other activeCaller)
      cases hDescArg : tree.isAnc t_arg other with
      | true =>
        have hOtherNeArg : other ≠ t_arg := by
          intro hEq
          rw [hEq, hState.arg_anc_ret] at hNotAncRetOrig
          cases hNotAncRetOrig
        exact Or.inl (hState.descendants_unprotected_in_caller other hDescArg hOtherNeArg)
      | false =>
        have hNotAncArg : tree.isAnc other t_arg = false := by
          cases h : tree.isAnc other t_arg with
          | false => rfl
          | true =>
            have hAncRet := hwf.isAnc_trans other t_arg t_ret h hState.arg_anc_ret
            rw [hNotAncRetOrig] at hAncRet
            cases hAncRet
        have hSafePre := hState.arg_perm.non_ancestors_safe other b hPresOrig hNotAncArg hbParent
        have hImp : tree.isTagProtected other activeCaller = true →
            tree.isTagProtected other (insertActiveProtector activeCaller callId) = true :=
          isTagProtected_insert_of_caller
        cases hAcc : (tree.locState t_arg b).accessed with
        | true =>
          rw [applyReleaseProtector_locState_acc tree t_arg _ other b hPresOrig hAcc,
            nodeAccessRelatedness_skip_foreign hNotAncArg hDescArg]
          obtain ⟨st', hEq, hSafePost, _⟩ := performTransition_foreign_of_nonAncestorSafe
            (tree.locState t_arg b).perm.associatedAccess _ (tree.locState other b) hSafePre
          show NonAncestorSafe (match performTransition _ .foreignAccess _ _ with
            | some st' => st' | none => _) _
          rw [hEq]
          exact nonAncestorSafe_mono_unprotect st' _ _ hSafePost hImp
        | false =>
          rw [applyReleaseProtector_locState_unacc tree t_arg _ other b hAcc]
          exact nonAncestorSafe_mono_unprotect _ _ _ hSafePre hImp

/-- Initial permission of a reborrow: `&mut` starts unconflicted `ReservedFrz`,
`&` starts `Frozen`. -/
def initPermOf : Mutability → Permission
  | .mut => .reservedFrz false
  | .not => .frozen

theorem initPermOf_mut_writable : AncestorWritable ⟨initPermOf .mut, false⟩ :=
  Or.inr (Or.inl rfl)

theorem fnEntry_writable : AncestorWritable ⟨.reservedFrz false, false⟩ := Or.inr (Or.inl rfl)

/-- Adding a fresh call id does not change the protection of existing tags. -/
theorem hasUniqueWritePerm_insert_fresh_callId {tree : BorrowTree} {tag : BorTag}
    {range : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hFreshCallId : ∀ n, tree.present n = true → ∀ p, tree.protector n = some p → p.callId ≠ callId)
    (hPerm : HasUniqueWritePerm tree tag range activeCaller) :
    HasUniqueWritePerm tree tag range (insertActiveProtector activeCaller callId) := by
  refine ⟨hPerm.wf, hPerm.tag_present, hPerm.ancestors_writable, ?_⟩
  intro other b hPres hNotAnc hb
  have hEq : tree.isTagProtected other (insertActiveProtector activeCaller callId) =
      tree.isTagProtected other activeCaller := by
    unfold BorrowTree.isTagProtected
    cases hp : tree.protector other with
    | none => rfl
    | some p =>
      show (decide (p.callId = callId) || activeCaller p.callId) = activeCaller p.callId
      rw [decide_eq_false (hFreshCallId other hPres p hp), Bool.false_or]
  rw [hEq]
  exact hPerm.non_ancestors_safe other b hPres hNotAnc hb

/-- Stage 2 with a call id that was fresh for the caller restores the caller's set. -/
theorem removeActiveProtector_insert {active : ActiveProtectors} {callId : CallId}
    (h : active callId = false) :
    removeActiveProtector (insertActiveProtector active callId) callId = active := by
  funext c
  unfold removeActiveProtector insertActiveProtector
  by_cases hc : c = callId
  · rw [ite_eq_left hc, hc, h]
  · rw [ite_eq_right hc, decide_eq_false hc, Bool.false_or]

theorem isAnc_child_of_retag {tree : BorrowTree} {t_parent t_child : BorTag}
    {prot : Option ProtectorKind} {initPerm : Permission} {range : ByteRange}
    {active : ActiveProtectors} (hwf : TreeWF tree) (hPres : tree.present t_parent = true) :
    (retagChild tree t_parent t_child prot initPerm range active).isAnc t_parent t_child = true := by
  rw [retagChild_isAnc, insertChildNode_isAnc_child, hwf.isAnc_refl t_parent hPres, Bool.or_true]

/-- In the tree after one call-entry retag and pre-release child retags, only
the minted children descend from the argument tag. -/
theorem retag_desc_cases {tree : BorrowTree} {t_parent t_child : BorTag}
    {prot : Option ProtectorKind} {initPerm : Permission} {range : ByteRange}
    {active : ActiveProtectors} {a d : BorTag}
    (h : (retagChild tree t_parent t_child prot initPerm range active).isAnc a d = true)
    (hd : d ≠ t_child) (ha : a ≠ t_child) : tree.isAnc a d = true := by
  rwa [retagChild_isAnc, insertChildNode_isAnc_of_ne _ _ _ _ _ hd ha] at h

theorem retag_not_desc_of_new {tree : BorrowTree} {t_parent t_child : BorTag}
    {prot : Option ProtectorKind} {initPerm : Permission} {range : ByteRange}
    {active : ActiveProtectors} {d : BorTag} (hd : d ≠ t_child) :
    (retagChild tree t_parent t_child prot initPerm range active).isAnc t_child d = false := by
  rw [retagChild_isAnc]
  exact insertChildNode_isAnc_from_child _ _ _ _ _ hd

/-- **`reborrow_return_unique_write_perm`** (`get_mut`): entry retag of the
argument with a strong protector, a pre-release `&mut` sub-range reborrow, and
two-stage release leave the returned reference with `HasUniqueWritePerm`
(including `NonAncestorSafe` isolation) for the caller's post-call protector
set; the caller's subsequent write through it is UB-free and preserves it. -/
theorem reborrow_return_unique_write_perm {tree0 : BorrowTree} {t_parent t_arg t_ret : BorTag}
    {parentRange subRange : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent parentRange activeCaller)
    (hSub : subRange.Sub parentRange)
    (hFreshArg : tree0.present t_arg = false) (hFreshRet : tree0.present t_ret = false)
    (hRetNeArg : t_ret ≠ t_arg)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      parentRange active1
    let tree2 := retagChild tree1 t_arg t_ret none (initPermOf .mut) subRange active1
    let tree_post := applyReleaseProtector tree2 t_arg active1
    let active_post := removeActiveProtector active1 callId
    releaseProtectorNoUB tree2 t_arg active1 ∧
      HasUniqueWritePerm tree_post t_ret subRange active_post ∧
      TreeAccessNoUB tree_post t_ret .write subRange active_post .visitChildrenOfAccessed ∧
      HasUniqueWritePerm (applyTreeAccess tree_post t_ret .write subRange active_post
        .visitChildrenOfAccessed) t_ret subRange active_post := by
  intro active1 tree1 tree2 tree_post active_post
  have hAct : active_post = activeCaller := removeActiveProtector_insert hCallFresh
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg parentRange active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  have hFreshRet1 : tree1.present t_ret = false := by
    rw [retagChild_present, decide_eq_false hRetNeArg, Bool.false_or]; exact hFreshRet
  have hTree2ArgPerm : HasUniqueWritePerm tree2 t_arg parentRange active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree1Perm hFreshRet1
  have hTree2RetPerm : HasUniqueWritePerm tree2 t_ret subRange active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm hSub hFreshRet1).2
  have hState : CalleeReborrowState tree2 t_arg t_ret parentRange subRange activeCaller callId := by
    refine ⟨hSub, hTree2ArgPerm, hTree2RetPerm.tag_present,
      isAnc_child_of_retag hTree1Perm.wf hTree1Perm.tag_present, hRetNeArg, ?_,
      hTree2RetPerm.ancestors_writable, ?_⟩
    · intro b hAcc
      cases hbP : parentRange.contains b with
      | true => rfl
      | false =>
        have hbS : subRange.contains b = false := by
          cases h : subRange.contains b with
          | false => rfl
          | true => have := hSub b h; rw [hbP] at this; cases this
        have h2 : (tree2.locState t_arg b) = tree1.locState t_arg b := by
          show (retagChild tree1 t_arg t_ret none (initPermOf .mut) subRange active1).locState t_arg b = _
          rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbS,
            insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hRetNeArg)]
        have h1 : (tree1.locState t_arg b).accessed = parentRange.contains b :=
          retagChild_child_accessed (by intro h; cases h) b
        rw [h2, h1, hbP] at hAcc
        cases hAcc
    · intro d hDesc hdNe
      by_cases hdRet : d = t_ret
      · rw [hdRet]
        show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isTagProtected t_ret activeCaller = false
        exact insertChildNode_isTagProtected_child_none _ _ _ _ _
      · have h1 : tree1.isAnc t_arg d = true :=
          retag_desc_cases hDesc hdRet (Ne.symm hRetNeArg)
        rw [retag_not_desc_of_new hdNe] at h1
        cases h1
  obtain ⟨hRelNoUB, _, hPostPerm⟩ := releaseProtector_preserves_reborrow_child hState
  rw [hAct]
  obtain ⟨hWriteNoUB, hAfter⟩ :=
    local_access_preserves_hasUniqueWritePerm .write hPostPerm (ByteRange.Sub.refl _)
  exact ⟨hRelNoUB, hPostPerm, hWriteNoUB, hAfter⟩

/-- **`reborrow_return_after_callee_write_unique_write_perm`**: the same holds
when the callee writes through the returned child before returning (so the
argument is `Active` on the sub-range and emits an implicit write at release). -/
theorem reborrow_return_after_callee_write_unique_write_perm {tree0 : BorrowTree}
    {t_parent t_arg t_ret : BorTag} {parentRange subRange : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent parentRange activeCaller)
    (hSub : subRange.Sub parentRange)
    (hFreshArg : tree0.present t_arg = false) (hFreshRet : tree0.present t_ret = false)
    (hRetNeArg : t_ret ≠ t_arg)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      parentRange active1
    let tree2 := retagChild tree1 t_arg t_ret none (initPermOf .mut) subRange active1
    let tree3 := applyTreeAccess tree2 t_ret .write subRange active1 .visitChildrenOfAccessed
    let tree_post := applyReleaseProtector tree3 t_arg active1
    let active_post := removeActiveProtector active1 callId
    TreeAccessNoUB tree2 t_ret .write subRange active1 .visitChildrenOfAccessed ∧
      releaseProtectorNoUB tree3 t_arg active1 ∧
      HasUniqueWritePerm tree_post t_ret subRange active_post := by
  intro active1 tree1 tree2 tree3 tree_post active_post
  have hAct : active_post = activeCaller := removeActiveProtector_insert hCallFresh
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg parentRange active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  have hFreshRet1 : tree1.present t_ret = false := by
    rw [retagChild_present, decide_eq_false hRetNeArg, Bool.false_or]; exact hFreshRet
  have hTree2ArgPerm : HasUniqueWritePerm tree2 t_arg parentRange active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree1Perm hFreshRet1
  have hTree2RetPerm : HasUniqueWritePerm tree2 t_ret subRange active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm hSub hFreshRet1).2
  obtain ⟨hWriteNoUB, hTree3RetPerm⟩ :=
    local_access_preserves_hasUniqueWritePerm .write hTree2RetPerm (ByteRange.Sub.refl _)
  have hArgAncRet : tree2.isAnc t_arg t_ret = true :=
    isAnc_child_of_retag hTree1Perm.wf hTree1Perm.tag_present
  have hTree3ArgPerm : HasUniqueWritePerm tree3 t_arg parentRange active1 := by
    refine ⟨applyTreeAccess_wf _ _ _ _ _ _ hTree2ArgPerm.wf, hTree2ArgPerm.tag_present, ?_, ?_⟩
    · intro anc b hAncArg hbParent
      have hAncArg2 : tree2.isAnc anc t_arg = true := hAncArg
      have hAncRet : tree2.isAnc anc t_ret = true :=
        hTree2ArgPerm.wf.isAnc_trans anc t_arg t_ret hAncArg2 hArgAncRet
      cases hbSub : subRange.contains b with
      | true => exact hTree3RetPerm.ancestors_writable anc b hAncRet hbSub
      | false =>
        show AncestorWritable ((applyTreeAccess tree2 t_ret .write subRange active1
          .visitChildrenOfAccessed).locState anc b)
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ anc b hbSub]
        exact hTree2ArgPerm.ancestors_writable anc b hAncArg2 hbParent
    · intro other b hPres hNotAncArg hbParent
      have hPres2 : tree2.present other = true := hPres
      have hNotAncArg2 : tree2.isAnc other t_arg = false := hNotAncArg
      by_cases hOther : other = t_ret
      · left
        rw [hOther]
        show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isTagProtected t_ret active1 = false
        exact insertChildNode_isTagProtected_child_none _ _ _ _ _
      · have hNotAncRet : tree2.isAnc other t_ret = false := by
          show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isAnc other t_ret = false
          rw [insertChildNode_isAnc_child, decide_eq_false hOther, Bool.false_or]
          have : tree2.isAnc other t_arg =
              (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isAnc other t_arg := rfl
          rw [this, insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hRetNeArg) hOther] at hNotAncArg2
          exact hNotAncArg2
        cases hbSub : subRange.contains b with
        | true => exact hTree3RetPerm.non_ancestors_safe other b hPres2 hNotAncRet hbSub
        | false =>
          show NonAncestorSafe ((applyTreeAccess tree2 t_ret .write subRange active1
            .visitChildrenOfAccessed).locState other b) (tree2.isTagProtected other active1)
          rw [applyTreeAccess_locState_out _ _ _ _ _ _ other b hbSub]
          exact hTree2ArgPerm.non_ancestors_safe other b hPres2 hNotAncArg2 hbParent
  have hState : CalleeReborrowState tree3 t_arg t_ret parentRange subRange activeCaller callId := by
    refine ⟨hSub, hTree3ArgPerm, hTree3RetPerm.tag_present, hArgAncRet, hRetNeArg, ?_,
      hTree3RetPerm.ancestors_writable, ?_⟩
    · intro b hAcc
      cases hbP : parentRange.contains b with
      | true => rfl
      | false =>
        have hbS : subRange.contains b = false := by
          cases h : subRange.contains b with
          | false => rfl
          | true => have := hSub b h; rw [hbP] at this; cases this
        have h3 : tree3.locState t_arg b = tree2.locState t_arg b :=
          applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hbS
        have h2 : tree2.locState t_arg b = tree1.locState t_arg b := by
          show (retagChild tree1 t_arg t_ret none (initPermOf .mut) subRange active1).locState t_arg b = _
          rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbS,
            insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hRetNeArg)]
        have h1 : (tree1.locState t_arg b).accessed = parentRange.contains b :=
          retagChild_child_accessed (by intro h; cases h) b
        rw [h3, h2, h1, hbP] at hAcc
        cases hAcc
    · intro d hDesc hdNe
      have hDesc2 : tree2.isAnc t_arg d = true := hDesc
      by_cases hdRet : d = t_ret
      · rw [hdRet]
        show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isTagProtected t_ret activeCaller = false
        exact insertChildNode_isTagProtected_child_none _ _ _ _ _
      · have h1 : tree1.isAnc t_arg d = true := retag_desc_cases hDesc2 hdRet (Ne.symm hRetNeArg)
        rw [retag_not_desc_of_new hdNe] at h1
        cases h1
  obtain ⟨hRelNoUB, _, hPostPerm⟩ := releaseProtector_preserves_reborrow_child hState
  rw [hAct]
  exact ⟨hWriteNoUB, hRelNoUB, hPostPerm⟩

/-- Frame rule: an access over a disjoint range preserves `HasUniqueWritePerm`. -/
theorem disjoint_access_preserves_hasUniqueWritePerm {tree : BorrowTree} {t_right : BorTag}
    {leftRange rightRange : ByteRange} {active : ActiveProtectors}
    (t_left : BorTag) (kind : AccessKind) (mode : ChildrenVisitMode)
    (hRightPerm : HasUniqueWritePerm tree t_right rightRange active)
    (hDisj : leftRange.Disjoint rightRange) :
    HasUniqueWritePerm (applyTreeAccess tree t_left kind leftRange active mode) t_right rightRange active := by
  have hDisjRL := hDisj.symm
  refine ⟨applyTreeAccess_wf _ _ _ _ _ _ hRightPerm.wf, hRightPerm.tag_present, ?_, ?_⟩
  · intro anc b hAnc hbRight
    show AncestorWritable ((applyTreeAccess tree t_left kind leftRange active mode).locState anc b)
    rw [applyTreeAccess_locState_out _ _ _ _ _ _ anc b (hDisjRL b hbRight)]
    exact hRightPerm.ancestors_writable anc b hAnc hbRight
  · intro other b hPres hNotAnc hbRight
    show NonAncestorSafe ((applyTreeAccess tree t_left kind leftRange active mode).locState other b)
      (tree.isTagProtected other active)
    rw [applyTreeAccess_locState_out _ _ _ _ _ _ other b (hDisjRL b hbRight)]
    exact hRightPerm.non_ancestors_safe other b hPres hNotAnc hbRight

/-- Retagging a fresh child under a sibling over a disjoint range preserves
`HasUniqueWritePerm` of `t_right`. -/
theorem disjoint_retagChild_preserves_hasUniqueWritePerm {tree : BorrowTree}
    {t_left t_child t_right : BorTag} {leftRange rightRange : ByteRange} {active : ActiveProtectors}
    (prot : Option ProtectorKind) (initPerm : Permission) (hInit : initPerm ≠ .reservedIM)
    (hRightPerm : HasUniqueWritePerm tree t_right rightRange active)
    (hDisj : leftRange.Disjoint rightRange) (hFresh : tree.present t_child = false) :
    HasUniqueWritePerm (retagChild tree t_left t_child prot initPerm leftRange active)
      t_right rightRange active := by
  have hRightNe : t_right ≠ t_child := ne_of_present_of_fresh hRightPerm.tag_present hFresh
  let tree1 := insertChildNode tree t_left t_child prot initPerm
  have hwf1 : TreeWF tree1 := insertChildNode_wf tree t_left t_child prot initPerm hRightPerm.wf hFresh
  have hRightPerm1 : HasUniqueWritePerm tree1 t_right rightRange active := by
    refine ⟨hwf1, by rw [insertChildNode_present, hRightPerm.tag_present, Bool.or_true], ?_, ?_⟩
    · intro anc b hAnc hbRight
      have hAncNe : anc ≠ t_child := by
        intro hEq
        rw [hEq] at hAnc
        have : tree1.isAnc t_child t_right = false := insertChildNode_isAnc_from_child _ _ _ _ _ hRightNe
        rw [this] at hAnc
        cases hAnc
      have hAncOrig : tree.isAnc anc t_right = true := by
        rwa [show tree1.isAnc anc t_right = tree.isAnc anc t_right from
          insertChildNode_isAnc_of_ne _ _ _ _ _ hRightNe hAncNe] at hAnc
      rw [insertChildNode_locState_of_ne _ _ _ _ _ hAncNe]
      exact hRightPerm.ancestors_writable anc b hAncOrig hbRight
    · intro other b hPres hNotAnc hbRight
      by_cases hOther : other = t_child
      · rw [hOther, insertChildNode_locState_child]
        exact Or.inr ⟨rfl, hInit⟩
      · have hPresOrig : tree.present other = true := by
          rwa [insertChildNode_present, decide_eq_false hOther, Bool.false_or] at hPres
        have hNotAncOrig : tree.isAnc other t_right = false := by
          rwa [show tree1.isAnc other t_right = tree.isAnc other t_right from
            insertChildNode_isAnc_of_ne _ _ _ _ _ hRightNe hOther] at hNotAnc
        rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ hOther,
          insertChildNode_locState_of_ne _ _ _ _ _ hOther]
        exact hRightPerm.non_ancestors_safe other b hPresOrig hNotAncOrig hbRight
  exact disjoint_access_preserves_hasUniqueWritePerm t_child .read .visitChildrenOfAccessed
    hRightPerm1 hDisj

/-- **`split_at_mut_unique_write_perm`** for `[base, base + len)` split at any
`mid ≤ len` (including `mid = 0` and `mid = len`): entry retag, two pre-release
`&mut` reborrows `[base, base + mid)` / `[base + mid, base + len)`, and two-stage
release yield distinct child tags with unique write permission; writing either
half preserves the other's permission; after both writes the halves are
`Active` on disjoint footprints; and a cross-half write through the left slice
into the right half is undefined behavior. -/
theorem split_at_mut_unique_write_perm {tree0 : BorrowTree} {t_parent t_arg t_left t_right : BorTag}
    {base mid len : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hmid : mid ≤ len)
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFreshArg : tree0.present t_arg = false) (hFreshLeft : tree0.present t_left = false)
    (hFreshRight : tree0.present t_right = false)
    (hLeftNeArg : t_left ≠ t_arg) (hRightNeArg : t_right ≠ t_arg) (hRightNeLeft : t_right ≠ t_left)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      (wholeRange base len) active1
    let tree2 := retagChild tree1 t_arg t_left none (initPermOf .mut) (splitLeft base mid) active1
    let tree3 := retagChild tree2 t_arg t_right none (initPermOf .mut) (splitRight base mid len) active1
    let tree_post := applyReleaseProtector tree3 t_arg active1
    let active_post := removeActiveProtector active1 callId
    let tree_wl := applyTreeAccess tree_post t_left .write (splitLeft base mid) active_post
      .visitChildrenOfAccessed
    let tree_w := applyTreeAccess tree_wl t_right .write (splitRight base mid len) active_post
      .visitChildrenOfAccessed
    releaseProtectorNoUB tree3 t_arg active1 ∧
      HasUniqueWritePerm tree_post t_left (splitLeft base mid) active_post ∧
      HasUniqueWritePerm tree_post t_right (splitRight base mid len) active_post ∧
      TreeAccessNoUB tree_post t_left .write (splitLeft base mid) active_post .visitChildrenOfAccessed ∧
      HasUniqueWritePerm tree_wl t_right (splitRight base mid len) active_post ∧
      HasUniqueWritePerm (applyTreeAccess tree_post t_right .write (splitRight base mid len)
        active_post .visitChildrenOfAccessed) t_left (splitLeft base mid) active_post ∧
      TreeAccessNoUB tree_wl t_right .write (splitRight base mid len) active_post
        .visitChildrenOfAccessed ∧
      (∀ b, (splitLeft base mid).contains b = true → tree_w.locState t_left b = ⟨.active, true⟩) ∧
      (∀ b, (splitRight base mid len).contains b = true → tree_w.locState t_right b = ⟨.active, true⟩) ∧
      (∀ b, (splitRight base mid len).contains b = true →
        ¬ TreeAccessNoUB tree_w t_left .write ⟨b, b + 1⟩ active_post .visitChildrenOfAccessed) := by
  intro active1 tree1 tree2 tree3 tree_post active_post tree_wl tree_w
  have hAct : active_post = activeCaller := removeActiveProtector_insert hCallFresh
  have hDisj := split_disjoint base mid len
  have hDisjSymm := hDisj.symm
  have hSubL := splitLeft_sub (base := base) hmid
  have hSubR := splitRight_sub base mid len
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg (wholeRange base len) active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  have hFreshLeft1 : tree1.present t_left = false := by
    rw [retagChild_present, decide_eq_false hLeftNeArg, Bool.false_or]; exact hFreshLeft
  have hTree2ArgPerm : HasUniqueWritePerm tree2 t_arg (wholeRange base len) active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree1Perm hFreshLeft1
  have hTree2LeftPerm : HasUniqueWritePerm tree2 t_left (splitLeft base mid) active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm hSubL hFreshLeft1).2
  have hFreshRight2 : tree2.present t_right = false := by
    rw [retagChild_present, decide_eq_false hRightNeLeft, Bool.false_or, retagChild_present,
      decide_eq_false hRightNeArg, Bool.false_or]
    exact hFreshRight
  have hTree3ArgPerm : HasUniqueWritePerm tree3 t_arg (wholeRange base len) active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree2ArgPerm hFreshRight2
  have hTree3RightPerm : HasUniqueWritePerm tree3 t_right (splitRight base mid len) active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm hSubR hFreshRight2).2
  have hTree3LeftPerm : HasUniqueWritePerm tree3 t_left (splitLeft base mid) active1 :=
    disjoint_retagChild_preserves_hasUniqueWritePerm none (initPermOf .mut) (by intro h; cases h)
      hTree2LeftPerm hDisjSymm hFreshRight2
  have hArgAcc : ∀ b, (tree3.locState t_arg b).accessed = true → (wholeRange base len).contains b = true := by
    intro b hAcc
    cases hbP : (wholeRange base len).contains b with
    | true => rfl
    | false =>
      have hbL : (splitLeft base mid).contains b = false := by
        cases h : (splitLeft base mid).contains b with
        | false => rfl
        | true => have := hSubL b h; rw [hbP] at this; cases this
      have hbR : (splitRight base mid len).contains b = false := by
        cases h : (splitRight base mid len).contains b with
        | false => rfl
        | true => have := hSubR b h; rw [hbP] at this; cases this
      have h3 : tree3.locState t_arg b = tree2.locState t_arg b := by
        show (retagChild tree2 t_arg t_right none (initPermOf .mut) (splitRight base mid len) active1).locState t_arg b = _
        rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbR,
          insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hRightNeArg)]
      have h2 : tree2.locState t_arg b = tree1.locState t_arg b := by
        show (retagChild tree1 t_arg t_left none (initPermOf .mut) (splitLeft base mid) active1).locState t_arg b = _
        rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbL,
          insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hLeftNeArg)]
      have h1 : (tree1.locState t_arg b).accessed = (wholeRange base len).contains b :=
        retagChild_child_accessed (by intro h; cases h) b
      rw [h3, h2, h1, hbP] at hAcc
      cases hAcc
  have hDescUnprot : ∀ d, tree3.isAnc t_arg d = true → d ≠ t_arg →
      tree3.isTagProtected d activeCaller = false := by
    intro d hDesc hdNe
    by_cases hdR : d = t_right
    · rw [hdR]
      show (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isTagProtected t_right activeCaller = false
      exact insertChildNode_isTagProtected_child_none _ _ _ _ _
    · by_cases hdL : d = t_left
      · rw [hdL]
        show (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isTagProtected t_left activeCaller = false
        rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ (Ne.symm hRightNeLeft)]
        show (insertChildNode tree1 t_arg t_left none (initPermOf .mut)).isTagProtected t_left activeCaller = false
        exact insertChildNode_isTagProtected_child_none _ _ _ _ _
      · have h2 : tree2.isAnc t_arg d = true := retag_desc_cases hDesc hdR (Ne.symm hRightNeArg)
        have h1 : tree1.isAnc t_arg d = true := retag_desc_cases h2 hdL (Ne.symm hLeftNeArg)
        rw [retag_not_desc_of_new hdNe] at h1
        cases h1
  have hArgAncLeft3 : tree3.isAnc t_arg t_left = true := by
    show (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isAnc t_arg t_left = true
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hRightNeLeft) (Ne.symm hRightNeArg)]
    exact isAnc_child_of_retag hTree1Perm.wf hTree1Perm.tag_present
  have hArgAncRight3 : tree3.isAnc t_arg t_right = true :=
    isAnc_child_of_retag hTree2ArgPerm.wf hTree2ArgPerm.tag_present
  have hStateL : CalleeReborrowState tree3 t_arg t_left (wholeRange base len) (splitLeft base mid)
      activeCaller callId :=
    ⟨hSubL, hTree3ArgPerm, hTree3LeftPerm.tag_present, hArgAncLeft3, hLeftNeArg, hArgAcc,
      hTree3LeftPerm.ancestors_writable, hDescUnprot⟩
  have hStateR : CalleeReborrowState tree3 t_arg t_right (wholeRange base len) (splitRight base mid len)
      activeCaller callId :=
    ⟨hSubR, hTree3ArgPerm, hTree3RightPerm.tag_present, hArgAncRight3, hRightNeArg, hArgAcc,
      hTree3RightPerm.ancestors_writable, hDescUnprot⟩
  obtain ⟨hRelNoUB, hSkipL, hPostL0⟩ := releaseProtector_preserves_reborrow_child hStateL
  obtain ⟨_, _, hPostR0⟩ := releaseProtector_preserves_reborrow_child hStateR
  have hPostL : HasUniqueWritePerm tree_post t_left (splitLeft base mid) active_post := by
    rw [hAct]; exact hPostL0
  have hPostR : HasUniqueWritePerm tree_post t_right (splitRight base mid len) active_post := by
    rw [hAct]; exact hPostR0
  have hWLNoUB := (local_access_preserves_hasUniqueWritePerm .write hPostL (ByteRange.Sub.refl _)).1
  have hWLL := (local_access_preserves_hasUniqueWritePerm .write hPostL (ByteRange.Sub.refl _)).2
  have hWLR : HasUniqueWritePerm tree_wl t_right (splitRight base mid len) active_post :=
    disjoint_access_preserves_hasUniqueWritePerm t_left .write .visitChildrenOfAccessed hPostR hDisj
  have hWRL := disjoint_access_preserves_hasUniqueWritePerm (kind := .write)
    (mode := .visitChildrenOfAccessed) t_right hPostL hDisjSymm
  have hWRNoUB := (local_access_preserves_hasUniqueWritePerm .write hWLR (ByteRange.Sub.refl _)).1
  refine ⟨hRelNoUB, hPostL, hPostR, hWLNoUB, hWLR, hWRL, hWRNoUB, ?_, ?_, ?_⟩
  · intro b hb
    show (applyTreeAccess tree_wl t_right .write (splitRight base mid len) active_post
      .visitChildrenOfAccessed).locState t_left b = _
    rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ (hDisj b hb)]
    exact local_write_activates_ancestors hPostL (ByteRange.Sub.refl _)
      (hPostL.wf.isAnc_refl t_left hPostL.tag_present) hb
  · intro b hb
    exact local_write_activates_ancestors hWLR (ByteRange.Sub.refl _)
      (hWLR.wf.isAnc_refl t_right hWLR.tag_present) hb
  · intro b hb hNoUB
    have hbL : (splitLeft base mid).contains b = false := hDisjSymm b hb
    -- `t_left` is a strict sibling of `t_right` and unprotected
    have hLnotAncR : tree3.isAnc t_left t_right = false := by
      show (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isAnc t_left t_right = false
      rw [insertChildNode_isAnc_child, decide_eq_false (Ne.symm hRightNeLeft), Bool.false_or]
      exact retag_not_desc_of_new (Ne.symm hLeftNeArg)
    have hLprot : ∀ act, tree3.isTagProtected t_left act = false := by
      intro act
      show (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isTagProtected t_left act = false
      rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ (Ne.symm hRightNeLeft)]
      show (insertChildNode tree1 t_arg t_left none (initPermOf .mut)).isTagProtected t_left act = false
      exact insertChildNode_isTagProtected_child_none _ _ _ _ _
    have hLpres : tree3.present t_left = true := hTree3LeftPerm.tag_present
    have hL2 : tree2.locState t_left b = ⟨.reservedFrz false, false⟩ := by
      show (retagChild tree1 t_arg t_left none (initPermOf .mut) (splitLeft base mid) active1).locState t_left b = _
      rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbL, insertChildNode_locState_child]
      rfl
    have hLpresI : (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).present t_left = true :=
      hLpres
    have hLnotAncRI : (insertChildNode tree2 t_arg t_right none (initPermOf .mut)).isAnc t_left t_right =
        false := hLnotAncR
    have hL3 : tree3.locState t_left b = ⟨.reservedFrz false, false⟩ := by
      show (applyTreeAccess (insertChildNode tree2 t_arg t_right none (initPermOf .mut)) t_right .read
        (splitRight base mid len) active1 .visitChildrenOfAccessed).locState t_left b = _
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hLpresI hb,
        nodeAccessRelatedness_visit_foreign hLnotAncRI]
      show (match performTransition .read .foreignAccess (tree3.isTagProtected t_left active1)
        ((insertChildNode tree2 t_arg t_right none (initPermOf .mut)).locState t_left b) with
        | some st' => st' | none => _) = _
      rw [hLprot active1, insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hRightNeLeft), hL2]
      rfl
    have hLpost : tree_post.locState t_left b = ⟨.reservedFrz false, false⟩ := by
      rw [hSkipL b, hL3]
    have hLwl : tree_wl.locState t_left b = ⟨.reservedFrz false, false⟩ := by
      show (applyTreeAccess tree_post t_left .write (splitLeft base mid) active_post
        .visitChildrenOfAccessed).locState t_left b = _
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hbL, hLpost]
    have hLpresWl : tree_wl.present t_left = true := hLpres
    have hLnotAncRWl : tree_wl.isAnc t_left t_right = false := hLnotAncR
    have hLw : tree_w.locState t_left b = ⟨.disabled, false⟩ := by
      show (applyTreeAccess tree_wl t_right .write (splitRight base mid len) active_post
        .visitChildrenOfAccessed).locState t_left b = _
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hLpresWl hb,
        nodeAccessRelatedness_visit_foreign hLnotAncRWl]
      show (match performTransition .write .foreignAccess (tree3.isTagProtected t_left active_post)
        (tree_wl.locState t_left b) with | some st' => st' | none => _) = _
      rw [hLprot active_post, hLwl]
      rfl
    have hLpresW : tree_w.present t_left = true := hLpres
    have hReflW : tree_w.isAnc t_left t_left = true := hTree3LeftPerm.wf.isAnc_refl t_left hLpres
    have hAt := hNoUB t_left b hLpresW
      ((ByteRange.contains_iff _ _).mpr ⟨Nat.le_refl b, Nat.lt_succ_self b⟩)
    rw [nodeAccessRelatedness_anc hReflW] at hAt
    change (performTransition .write .localAccess _ (tree_w.locState t_left b)).isSome = true at hAt
    rw [hLw] at hAt
    cases hAt

/-- Boundary `mid = 0`: the right slice owns the whole range, the left is empty. -/
theorem split_at_mut_mid_zero {tree0 : BorrowTree} {t_parent t_arg t_left t_right : BorTag}
    {base len : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFreshArg : tree0.present t_arg = false) (hFreshLeft : tree0.present t_left = false)
    (hFreshRight : tree0.present t_right = false)
    (hLeftNeArg : t_left ≠ t_arg) (hRightNeArg : t_right ≠ t_arg) (hRightNeLeft : t_right ≠ t_left)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      (wholeRange base len) active1
    let tree2 := retagChild tree1 t_arg t_left none (initPermOf .mut) (splitLeft base 0) active1
    let tree3 := retagChild tree2 t_arg t_right none (initPermOf .mut) (splitRight base 0 len) active1
    let tree_post := applyReleaseProtector tree3 t_arg active1
    HasUniqueWritePerm tree_post t_right (wholeRange base len) (removeActiveProtector active1 callId) ∧
      (∀ b, (splitLeft base 0).contains b = false) := by
  intro active1 tree1 tree2 tree3 tree_post
  obtain ⟨_, _, hR, _⟩ := split_at_mut_unique_write_perm (Nat.zero_le len) hPerm0 hFreshArg hFreshLeft
    hFreshRight hLeftNeArg hRightNeArg hRightNeLeft hFreshCallId hCallFresh
  refine ⟨hR, fun b => ByteRange.contains_eq_false _ _ ?_⟩
  simp only [splitLeft, Nat.add_zero]
  omega

/-- Boundary `mid = len`: the left slice owns the whole range, the right is empty. -/
theorem split_at_mut_mid_len {tree0 : BorrowTree} {t_parent t_arg t_left t_right : BorTag}
    {base len : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFreshArg : tree0.present t_arg = false) (hFreshLeft : tree0.present t_left = false)
    (hFreshRight : tree0.present t_right = false)
    (hLeftNeArg : t_left ≠ t_arg) (hRightNeArg : t_right ≠ t_arg) (hRightNeLeft : t_right ≠ t_left)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      (wholeRange base len) active1
    let tree2 := retagChild tree1 t_arg t_left none (initPermOf .mut) (splitLeft base len) active1
    let tree3 := retagChild tree2 t_arg t_right none (initPermOf .mut) (splitRight base len len) active1
    let tree_post := applyReleaseProtector tree3 t_arg active1
    HasUniqueWritePerm tree_post t_left (wholeRange base len) (removeActiveProtector active1 callId) ∧
      (∀ b, (splitRight base len len).contains b = false) := by
  intro active1 tree1 tree2 tree3 tree_post
  obtain ⟨_, hL, _⟩ := split_at_mut_unique_write_perm (Nat.le_refl len) hPerm0 hFreshArg hFreshLeft
    hFreshRight hLeftNeArg hRightNeArg hRightNeLeft hFreshCallId hCallFresh
  refine ⟨hL, fun b => ByteRange.contains_eq_false _ _ ?_⟩
  simp only [splitRight]
  omega

/-- Two-stage release keeps the released tag itself uniquely writable for the
caller when it has no protected strict descendants. -/
theorem releaseProtector_preserves_self {tree : BorrowTree} {t_arg : BorTag} {range : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm : HasUniqueWritePerm tree t_arg range (insertActiveProtector activeCaller callId))
    (hAccIn : ∀ b, (tree.locState t_arg b).accessed = true → range.contains b = true)
    (hDescUnprot : ∀ d, tree.isAnc t_arg d = true → d ≠ t_arg →
      tree.isTagProtected d activeCaller = false) :
    releaseProtectorNoUB tree t_arg (insertActiveProtector activeCaller callId) ∧
      HasUniqueWritePerm (applyReleaseProtector tree t_arg (insertActiveProtector activeCaller callId))
        t_arg range activeCaller := by
  have hwf := hPerm.wf
  refine ⟨?_, ?_⟩
  · intro n b hPres hAcc
    have hb := hAccIn b hAcc
    cases hAnc : tree.isAnc n t_arg with
    | true =>
      rw [nodeAccessRelatedness_anc hAnc]
      obtain ⟨st', hEq, _⟩ := performTransition_local_of_ancestorWritable
        (tree.locState t_arg b).perm.associatedAccess _ (tree.locState n b)
        (hPerm.ancestors_writable n b hAnc hb)
      show (performTransition _ .localAccess _ _).isSome = true
      rw [hEq]; rfl
    | false =>
      cases hDesc : tree.isAnc t_arg n with
      | true => rw [nodeAccessRelatedness_skip_desc hAnc hDesc]; trivial
      | false =>
        rw [nodeAccessRelatedness_skip_foreign hAnc hDesc]
        obtain ⟨st', hEq, _⟩ := performTransition_foreign_of_nonAncestorSafe
          (tree.locState t_arg b).perm.associatedAccess _ (tree.locState n b)
          (hPerm.non_ancestors_safe n b hPres hAnc hb)
        show (performTransition _ .foreignAccess _ _).isSome = true
        rw [hEq]; rfl
  · refine ⟨applyReleaseProtector_wf _ _ _ hwf, hPerm.tag_present, ?_, ?_⟩
    · intro anc b hAnc hb
      have hAnc' : tree.isAnc anc t_arg = true := hAnc
      have hPresAnc : tree.present anc = true := hwf.isAnc_present_left anc t_arg hAnc'
      cases hAcc : (tree.locState t_arg b).accessed with
      | true =>
        rw [applyReleaseProtector_locState_acc tree t_arg _ anc b hPresAnc hAcc,
          nodeAccessRelatedness_anc hAnc']
        obtain ⟨st', hEq, hAw, _⟩ := performTransition_local_of_ancestorWritable
          (tree.locState t_arg b).perm.associatedAccess _ (tree.locState anc b)
          (hPerm.ancestors_writable anc b hAnc' hb)
        show AncestorWritable (match performTransition _ .localAccess _ _ with
          | some st' => st' | none => _)
        rw [hEq]
        exact hAw
      | false =>
        rw [applyReleaseProtector_locState_unacc tree t_arg _ anc b hAcc]
        exact hPerm.ancestors_writable anc b hAnc' hb
    · intro other b hPres hNotAnc hb
      have hPres' : tree.present other = true := hPres
      have hNotAnc' : tree.isAnc other t_arg = false := hNotAnc
      show NonAncestorSafe _ (tree.isTagProtected other activeCaller)
      have hImp : tree.isTagProtected other activeCaller = true →
          tree.isTagProtected other (insertActiveProtector activeCaller callId) = true :=
        isTagProtected_insert_of_caller
      cases hDesc : tree.isAnc t_arg other with
      | true =>
        have hNe : other ≠ t_arg := by
          intro hEq
          rw [hEq, hwf.isAnc_refl t_arg hPerm.tag_present] at hNotAnc'
          cases hNotAnc'
        exact Or.inl (hDescUnprot other hDesc hNe)
      | false =>
        have hSafe := hPerm.non_ancestors_safe other b hPres' hNotAnc' hb
        cases hAcc : (tree.locState t_arg b).accessed with
        | true =>
          rw [applyReleaseProtector_locState_acc tree t_arg _ other b hPres' hAcc,
            nodeAccessRelatedness_skip_foreign hNotAnc' hDesc]
          obtain ⟨st', hEq, hSafePost, _⟩ := performTransition_foreign_of_nonAncestorSafe
            (tree.locState t_arg b).perm.associatedAccess _ (tree.locState other b) hSafe
          show NonAncestorSafe (match performTransition _ .foreignAccess _ _ with
            | some st' => st' | none => _) _
          rw [hEq]
          exact nonAncestorSafe_mono_unprotect st' _ _ hSafePost hImp
        | false =>
          rw [applyReleaseProtector_locState_unacc tree t_arg _ other b hAcc]
          exact nonAncestorSafe_mono_unprotect _ _ _ hSafe hImp

/-- **`TrustedFnSpec`**: a declarative trusted-function contract carrying the
argument range and an explicit pre-release `reborrowFootprint`. -/
structure TrustedFnSpec where
  argRange : ByteRange
  reborrowFootprint : List (ByteRange × Mutability)

/-- Pre-release footprint: mint fresh tags `next, next + 1, …` as unprotected
children of the (still protected) argument tag. -/
def applyFootprint (t_arg : BorTag) (active : ActiveProtectors) :
    BorrowTree → BorTag → List (ByteRange × Mutability) → BorrowTree × List BorTag
  | tree, _, [] => (tree, [])
  | tree, next, (r, m) :: rest =>
    let res := applyFootprint t_arg active (retagChild tree t_arg next none (initPermOf m) r active)
      (next + 1) rest
    (res.1, next :: res.2)

/-- Outcome of a call: post-release tree, post-call protector set, returned tags. -/
structure CallOutcome where
  tree : BorrowTree
  active : ActiveProtectors
  rets : List BorTag

/-- Spec execution: `FnEntry` retag, **pre-release** footprint, stage-1 release
(`skipChildrenOfAccessed` while `callId` is active), stage-2 `endCall`. -/
def TrustedFnSpec.run (spec : TrustedFnSpec) (tree₀ : BorrowTree) (activeCaller : ActiveProtectors)
    (t_parent t_arg : BorTag) (callId : CallId) : CallOutcome :=
  let active₁ := insertActiveProtector activeCaller callId
  let tree₁ := retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    spec.argRange active₁
  let fp := applyFootprint t_arg active₁ tree₁ (t_arg + 1) spec.reborrowFootprint
  { tree := applyReleaseProtector fp.1 t_arg active₁
    active := removeActiveProtector active₁ callId
    rets := fp.2 }

/-- Negative-control semantics that *omits* the footprint: no tag is minted
before release, so every declared output aliases the argument tag. -/
def TrustedFnSpec.runNoFootprint (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId) : CallOutcome :=
  let active₁ := insertActiveProtector activeCaller callId
  let tree₁ := retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    spec.argRange active₁
  { tree := applyReleaseProtector tree₁ t_arg active₁
    active := removeActiveProtector active₁ callId
    rets := spec.reborrowFootprint.map (fun _ => t_arg) }

/-- Declarative contract of `slice::split_at_mut(&mut [T; base..base+len], mid)`. -/
def splitAtMutSpec (base mid len : Nat) : TrustedFnSpec :=
  ⟨wholeRange base len, [(splitLeft base mid, .mut), (splitRight base mid len, .mut)]⟩

/-- Declarative contract of a `get_mut`-style projection `&mut x[off..off+sz]`. -/
def getMutSpec (argRange : ByteRange) (off sz : Nat) : TrustedFnSpec :=
  ⟨argRange, [(⟨off, off + sz⟩, .mut)]⟩

/-- **`same_tag_split_unsound_control`**: omitting the pre-release
`reborrowFootprint` returns two `&mut` slices that alias the argument tag, and a
cross-slice write after writing the other slice is UB-free in that model, while
the faithful pre-release footprint mints distinct tags under which the identical
access is undefined behavior (so the footprint-less spec is unsound). -/
theorem same_tag_split_unsound_control {tree0 : BorrowTree} {t_parent t_arg : BorTag}
    {base mid len : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hmid : mid ≤ len)
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFresh : ∀ t, t_arg ≤ t → tree0.present t = false)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) (b : Nat)
    (hb : (splitRight base mid len).contains b = true) :
    let naive := (splitAtMutSpec base mid len).runNoFootprint tree0 activeCaller t_parent t_arg callId
    let faithful := (splitAtMutSpec base mid len).run tree0 activeCaller t_parent t_arg callId
    naive.rets = [t_arg, t_arg] ∧
      TreeAccessNoUB
        (applyTreeAccess
          (applyTreeAccess naive.tree t_arg .write (splitLeft base mid) naive.active
            .visitChildrenOfAccessed)
          t_arg .write (splitRight base mid len) naive.active .visitChildrenOfAccessed)
        t_arg .write ⟨b, b + 1⟩ naive.active .visitChildrenOfAccessed ∧
      faithful.rets = [t_arg + 1, t_arg + 1 + 1] ∧
      ¬ TreeAccessNoUB
        (applyTreeAccess
          (applyTreeAccess faithful.tree (t_arg + 1) .write (splitLeft base mid) faithful.active
            .visitChildrenOfAccessed)
          (t_arg + 1 + 1) .write (splitRight base mid len) faithful.active .visitChildrenOfAccessed)
        (t_arg + 1) .write ⟨b, b + 1⟩ faithful.active .visitChildrenOfAccessed := by
  intro naive faithful
  have hAct : removeActiveProtector (insertActiveProtector activeCaller callId) callId = activeCaller :=
    removeActiveProtector_insert hCallFresh
  refine ⟨rfl, ?_, rfl, ?_⟩
  · -- footprint omitted: the argument tag keeps unique write permission over the whole range
    have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
    have hFreshArg : tree0.present t_arg = false := hFresh t_arg (Nat.le_refl _)
    have hT1 := (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl (wholeRange base len)) hFreshArg).2
    have hAccIn : ∀ b', ((retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
        (wholeRange base len) (insertActiveProtector activeCaller callId)).locState t_arg b').accessed = true →
        (wholeRange base len).contains b' = true := by
      intro b' h
      rwa [retagChild_child_accessed (by intro h; cases h) b'] at h
    have hDesc : ∀ d, (retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
        (wholeRange base len) (insertActiveProtector activeCaller callId)).isAnc t_arg d = true →
        d ≠ t_arg → (retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
        (wholeRange base len) (insertActiveProtector activeCaller callId)).isTagProtected d
          activeCaller = false := by
      intro d hd hne
      rw [retag_not_desc_of_new hne] at hd
      cases hd
    obtain ⟨_, hPost⟩ := releaseProtector_preserves_self hT1 hAccIn hDesc
    have hPostN : HasUniqueWritePerm naive.tree t_arg (wholeRange base len) naive.active := by
      show HasUniqueWritePerm _ t_arg (wholeRange base len)
        (removeActiveProtector (insertActiveProtector activeCaller callId) callId)
      rw [hAct]
      exact hPost
    have hW1 := (local_access_preserves_hasUniqueWritePerm .write hPostN
      (splitLeft_sub (base := base) hmid)).2
    have hW2 := (local_access_preserves_hasUniqueWritePerm .write hW1 (splitRight_sub base mid len)).2
    have hSubB : (ByteRange.mk b (b + 1)).Sub (wholeRange base len) := by
      intro b' hb'
      rw [ByteRange.contains_iff] at hb' hb ⊢
      dsimp only at hb'
      simp only [splitRight, wholeRange] at hb ⊢
      exact ⟨by omega, by omega⟩
    exact (local_access_preserves_hasUniqueWritePerm .write hW2 hSubB).1
  · -- faithful footprint: exactly the split-at-mut cross-half fault
    have hFreshArg : tree0.present t_arg = false := hFresh t_arg (Nat.le_refl _)
    have hFreshL : tree0.present (t_arg + 1) = false := hFresh (t_arg + 1) (Nat.le_succ _)
    have hle2 : t_arg ≤ t_arg + 1 + 1 := Nat.le_succ_of_le (Nat.le_succ t_arg)
    have hFreshR : tree0.present (t_arg + 1 + 1) = false := hFresh (t_arg + 1 + 1) hle2
    have hne1 : t_arg + 1 ≠ t_arg := Nat.succ_ne_self t_arg
    have hne2 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
    have hne3 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
    obtain ⟨_, _, _, _, _, _, _, _, _, hCross⟩ := split_at_mut_unique_write_perm hmid hPerm0
      hFreshArg hFreshL hFreshR hne1 hne2 hne3 hFreshCallId hCallFresh
    exact hCross b hb

/-- Concrete callee instructions (the MIR shape of `split_at_mut` / `get_mut`). -/
inductive CalleeOp where
  /-- `assert!(a <= b)` (the call panics otherwise). -/
  | assertLe (a b : Nat)
  /-- `dst = src as *mut _`: raw pointers keep the source tag. -/
  | rawPtr (dst src : Nat)
  /-- `dst = &mut (*src)[r]` (or `&`), retagged with a fresh tag (`RetagMode::Default`). -/
  | reborrow (dst src : Nat) (r : ByteRange) (m : Mutability)

/-- Callee machine state: borrow tree, tag registers, and the tag counter. -/
structure CalleeState where
  tree : BorrowTree
  regs : List (Option BorTag)
  nextTag : BorTag

/-- Concrete UB-checked callee step relation (no derivation = stuck/UB/panic). -/
inductive CalleeStep (active : ActiveProtectors) : CalleeState → CalleeOp → CalleeState → Prop
  | assertLe {st : CalleeState} {a b : Nat} (h : a ≤ b) : CalleeStep active st (.assertLe a b) st
  | rawPtr {st : CalleeState} {dst src : Nat} {t : BorTag}
      (hsrc : st.regs[src]? = some (some t)) (hdst : dst < st.regs.length) :
      CalleeStep active st (.rawPtr dst src) ⟨st.tree, st.regs.set dst (some t), st.nextTag⟩
  | reborrow {st : CalleeState} {dst src : Nat} {r : ByteRange} {m : Mutability} {t : BorTag}
      (hsrc : st.regs[src]? = some (some t)) (hdst : dst < st.regs.length)
      (hfresh : st.tree.present st.nextTag = false)
      (hnoUB : TreeAccessNoUB (insertChildNode st.tree t st.nextTag none (initPermOf m)) st.nextTag
        .read r active .visitChildrenOfAccessed) :
      CalleeStep active st (.reborrow dst src r m)
        ⟨retagChild st.tree t st.nextTag none (initPermOf m) r active,
          st.regs.set dst (some st.nextTag), st.nextTag + 1⟩

inductive CalleeRun (active : ActiveProtectors) : CalleeState → List CalleeOp → CalleeState → Prop
  | nil {st : CalleeState} : CalleeRun active st [] st
  | cons {st st' st'' : CalleeState} {op : CalleeOp} {ops : List CalleeOp}
      (h : CalleeStep active st op st') (hrest : CalleeRun active st' ops st'') :
      CalleeRun active st (op :: ops) st''

/-- Read the returned registers. -/
def collectRegs (regs : List (Option BorTag)) : List Nat → Option (List BorTag)
  | [] => some []
  | i :: is =>
    match regs[i]?, collectRegs regs is with
    | some (some t), some ts => some (t :: ts)
    | _, _ => none

/-- Callee entry state: register `0` holds the `FnEntry`-retagged argument tag. -/
def calleeEntryState (tree₀ : BorrowTree) (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag)
    (argRange : ByteRange) (callId : CallId) : CalleeState :=
  ⟨retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false) argRange
      (insertActiveProtector activeCaller callId), [some t_arg, none, none, none], t_arg + 1⟩

/-- **Concrete MIR callee execution**: UB-checked entry retag, the callee body,
the returned registers, and the UB-checked two-stage protector release. -/
inductive ConcreteCall (tree₀ : BorrowTree) (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag)
    (argRange : ByteRange) (callId : CallId) (body : List CalleeOp) (retRegs : List Nat) :
    CallOutcome → Prop
  | mk {stEnd : CalleeState} {rets : List BorTag}
      (hfresh : tree₀.present t_arg = false)
      (hentry : TreeAccessNoUB (insertChildNode tree₀ t_parent t_arg (some (.strong callId))
        (.reservedFrz false)) t_arg .read argRange (insertActiveProtector activeCaller callId)
        .visitChildrenOfAccessed)
      (hrun : CalleeRun (insertActiveProtector activeCaller callId)
        (calleeEntryState tree₀ activeCaller t_parent t_arg argRange callId) body stEnd)
      (hrets : collectRegs stEnd.regs retRegs = some rets)
      (hrel : releaseProtectorNoUB stEnd.tree t_arg (insertActiveProtector activeCaller callId)) :
      ConcreteCall tree₀ activeCaller t_parent t_arg argRange callId body retRegs
        ⟨applyReleaseProtector stEnd.tree t_arg (insertActiveProtector activeCaller callId),
          removeActiveProtector (insertActiveProtector activeCaller callId) callId, rets⟩

/-- `split_at_mut`: `assert!(mid <= len); let p = self.as_mut_ptr();
(from_raw_parts_mut(p, mid), from_raw_parts_mut(p.add(mid), len - mid))`. -/
def splitAtMutBody (base mid len : Nat) : List CalleeOp :=
  [.assertLe mid len, .rawPtr 1 0, .reborrow 2 1 (splitLeft base mid) .mut,
    .reborrow 3 1 (splitRight base mid len) .mut]

/-- `get_mut`-style projection: `&mut (*self)[off..off + sz]`. -/
def getMutBody (off sz : Nat) : List CalleeOp := [.reborrow 1 0 ⟨off, off + sz⟩ .mut]

/-- The concrete `split_at_mut` body panics unless `mid ≤ len`. -/
theorem concreteSplitAtMut_requires_mid_le {tree0 : BorrowTree} {activeCaller : ActiveProtectors}
    {t_parent t_arg : BorTag} {base mid len : Nat} {callId : CallId} {out : CallOutcome}
    (h : ConcreteCall tree0 activeCaller t_parent t_arg (wholeRange base len) callId
      (splitAtMutBody base mid len) [2, 3] out) : mid ≤ len := by
  cases h with
  | mk _ _ hrun _ _ =>
    cases hrun with
    | cons h1 _ =>
      cases h1 with
      | assertLe hle => exact hle

/-- **`trustedSpec_reborrow_equivalence`**: the declarative `TrustedFnSpec`
with a pre-release `reborrowFootprint` is equivalent to concrete callee
execution for both `split_at_mut` and `get_mut`: the concrete call succeeds and
produces exactly the spec's outcome (progress), and every concrete outcome is
the spec's outcome (determinism); hence concrete executions inherit the spec's
`HasUniqueWritePerm` postconditions. -/
theorem trustedSpec_reborrow_equivalence {tree0 : BorrowTree} {t_parent t_arg : BorTag}
    {base mid len off sz : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hmid : mid ≤ len) (hsub : base ≤ off ∧ off + sz ≤ base + len)
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFresh : ∀ t, t_arg ≤ t → tree0.present t = false)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let splitSpec := (splitAtMutSpec base mid len).run tree0 activeCaller t_parent t_arg callId
    let getSpec := (getMutSpec (wholeRange base len) off sz).run tree0 activeCaller t_parent t_arg callId
    (ConcreteCall tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (splitAtMutBody base mid len) [2, 3] splitSpec ∧
      ∀ out, ConcreteCall tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (splitAtMutBody base mid len) [2, 3] out → out = splitSpec) ∧
    (ConcreteCall tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (getMutBody off sz) [1] getSpec ∧
      ∀ out, ConcreteCall tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (getMutBody off sz) [1] out → out = getSpec) ∧
    HasUniqueWritePerm splitSpec.tree (t_arg + 1) (splitLeft base mid) splitSpec.active ∧
    HasUniqueWritePerm splitSpec.tree (t_arg + 1 + 1) (splitRight base mid len) splitSpec.active ∧
    HasUniqueWritePerm getSpec.tree (t_arg + 1) ⟨off, off + sz⟩ getSpec.active := by
  intro splitSpec getSpec
  have hFreshArg : tree0.present t_arg = false := hFresh t_arg (Nat.le_refl _)
  have hFreshL : tree0.present (t_arg + 1) = false := hFresh (t_arg + 1) (Nat.le_succ _)
  have hFreshR : tree0.present (t_arg + 1 + 1) = false :=
    hFresh (t_arg + 1 + 1) (Nat.le_succ_of_le (Nat.le_succ t_arg))
  have hne1 : t_arg + 1 ≠ t_arg := Nat.succ_ne_self t_arg
  have hne2 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
  have hne3 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
  have hSubG : (ByteRange.mk off (off + sz)).Sub (wholeRange base len) := by
    intro b hb
    rw [ByteRange.contains_iff] at hb ⊢
    dsimp only at hb
    simp only [wholeRange]
    exact ⟨by omega, by omega⟩
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  obtain ⟨hEntryNoUB, hTree1Perm⟩ := retagChild_hasUniqueWritePerm (some (.strong callId))
    fnEntry_writable hPerm0' (ByteRange.Sub.refl (wholeRange base len)) hFreshArg
  have hFreshL1 : (retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      (wholeRange base len) (insertActiveProtector activeCaller callId)).present (t_arg + 1) = false := by
    rw [retagChild_present, decide_eq_false hne1, Bool.false_or]; exact hFreshL
  obtain ⟨hNoUBL, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm
    (splitLeft_sub (base := base) hmid) hFreshL1
  obtain ⟨hNoUBG, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm
    hSubG hFreshL1
  have hTree2ArgPerm := retagUnprotectedChild_preserves_parent_hasUniqueWritePerm
    (childRange := splitLeft base mid) (initPerm := initPermOf .mut) hTree1Perm hFreshL1
  have hFreshR2 : (retagChild (retagChild tree0 t_parent t_arg (some (.strong callId))
      (.reservedFrz false) (wholeRange base len) (insertActiveProtector activeCaller callId))
      t_arg (t_arg + 1) none (initPermOf .mut) (splitLeft base mid)
      (insertActiveProtector activeCaller callId)).present (t_arg + 1 + 1) = false := by
    rw [retagChild_present, decide_eq_false hne3, Bool.false_or, retagChild_present,
      decide_eq_false hne2, Bool.false_or]
    exact hFreshR
  obtain ⟨hNoUBR, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm
    (splitRight_sub base mid len) hFreshR2
  obtain ⟨hRelS, hLS, hRS, _⟩ := split_at_mut_unique_write_perm hmid hPerm0 hFreshArg hFreshL hFreshR
    hne1 hne2 hne3 hFreshCallId hCallFresh
  obtain ⟨hRelG, hPostG, _⟩ := reborrow_return_unique_write_perm hPerm0 hSubG hFreshArg hFreshL hne1
    hFreshCallId hCallFresh
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, hLS, hRS, hPostG⟩
  · exact ConcreteCall.mk hFreshArg hEntryNoUB
      (CalleeRun.cons (CalleeStep.assertLe hmid)
        (CalleeRun.cons (CalleeStep.rawPtr rfl (show (1 : Nat) < 4 from by decide))
          (CalleeRun.cons (CalleeStep.reborrow rfl (show (2 : Nat) < 4 from by decide) hFreshL1 hNoUBL)
            (CalleeRun.cons (CalleeStep.reborrow rfl (show (3 : Nat) < 4 from by decide) hFreshR2 hNoUBR)
              CalleeRun.nil))))
      rfl hRelS
  · intro out hout
    cases hout with
    | mk _ _ hrun hrets _ =>
      cases hrun with
      | cons h1 hr1 =>
        cases h1 with
        | assertLe _ =>
          cases hr1 with
          | cons h2 hr2 =>
            cases h2 with
            | rawPtr hsrc2 _ =>
              simp only [calleeEntryState, List.getElem?_cons_zero, Option.some.injEq] at hsrc2
              subst hsrc2
              cases hr2 with
              | cons h3 hr3 =>
                cases h3 with
                | reborrow hsrc3 _ _ _ =>
                  simp only [calleeEntryState, List.set_cons_succ, List.set_cons_zero,
                    List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hsrc3
                  subst hsrc3
                  cases hr3 with
                  | cons h4 hr4 =>
                    cases h4 with
                    | reborrow hsrc4 _ _ _ =>
                      simp only [calleeEntryState, List.set_cons_succ, List.set_cons_zero,
                        List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hsrc4
                      subst hsrc4
                      cases hr4 with
                      | nil =>
                        simp only [calleeEntryState, collectRegs, List.set_cons_succ,
                          List.set_cons_zero, List.getElem?_cons_succ, List.getElem?_cons_zero,
                          Option.some.injEq] at hrets
                        subst hrets
                        rfl
  · exact ConcreteCall.mk hFreshArg hEntryNoUB
      (CalleeRun.cons (CalleeStep.reborrow rfl (show (1 : Nat) < 4 from by decide) hFreshL1 hNoUBG)
        CalleeRun.nil) rfl hRelG
  · intro out hout
    cases hout with
    | mk _ _ hrun hrets _ =>
      cases hrun with
      | cons h1 hr1 =>
        cases h1 with
        | reborrow hsrc1 _ _ _ =>
          simp only [calleeEntryState, List.getElem?_cons_zero, Option.some.injEq] at hsrc1
          subst hsrc1
          cases hr1 with
          | nil =>
            simp only [calleeEntryState, collectRegs, List.set_cons_succ, List.set_cons_zero,
              List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hrets
            subst hrets
            rfl

/-- A one-tag allocation: the root tag is `Active` everywhere and unprotected. -/
def rootTree (root : BorTag) : BorrowTree where
  present t := decide (t = root)
  isAnc a d := decide (a = root) && decide (d = root)
  protector _ := none
  locState _ _ := ⟨.active, true⟩

theorem rootTree_hasUniqueWritePerm (root : BorTag) (range : ByteRange) (active : ActiveProtectors) :
    HasUniqueWritePerm (rootTree root) root range active := by
  have hIsAnc : ∀ a d, (rootTree root).isAnc a d = true → a = root ∧ d = root := by
    intro a d h
    simp only [rootTree, Bool.and_eq_true, decide_eq_true_eq] at h
    exact h
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · intro t ht
    simp only [rootTree, decide_eq_true_eq] at ht
    simp only [rootTree, ht, decide_true, Bool.and_self]
  · intro a b c hab hbc
    obtain ⟨ha, _⟩ := hIsAnc a b hab
    obtain ⟨_, hc⟩ := hIsAnc b c hbc
    simp only [rootTree, ha, hc, decide_true, Bool.and_self]
  · intro a b hab _
    obtain ⟨ha, hb⟩ := hIsAnc a b hab
    rw [ha, hb]
  · intro a b hab
    obtain ⟨ha, _⟩ := hIsAnc a b hab
    simp only [rootTree, ha, decide_true]
  · intro a b hab
    obtain ⟨_, hb⟩ := hIsAnc a b hab
    simp only [rootTree, hb, decide_true]
  · intro a b c hac hbc
    left
    obtain ⟨ha, _⟩ := hIsAnc a c hac
    obtain ⟨hb, _⟩ := hIsAnc b c hbc
    simp only [rootTree, ha, hb, decide_true, Bool.and_self]
  · simp only [rootTree, decide_true]
  · intro anc b _ _
    exact Or.inl rfl
  · intro other b hPres hNotAnc _
    simp only [rootTree, decide_eq_true_eq] at hPres
    simp only [rootTree, hPres, decide_true, Bool.and_self] at hNotAnc
    cases hNotAnc

/-- **Non-vacuity**: the hypotheses of `split_at_mut_unique_write_perm` are
satisfiable for every `mid ≤ len` (including both boundaries) on a concrete
one-tag allocation, yielding both halves' unique write permissions and the
cross-half fault. -/
theorem split_at_mut_rootTree_nonvacuous (base mid len : Nat) (hmid : mid ≤ len) :
    let active1 := insertActiveProtector (fun _ => false) 0
    let tree1 := retagChild (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false)
      (wholeRange base len) active1
    let tree2 := retagChild tree1 1 2 none (initPermOf .mut) (splitLeft base mid) active1
    let tree3 := retagChild tree2 1 3 none (initPermOf .mut) (splitRight base mid len) active1
    let tree_post := applyReleaseProtector tree3 1 active1
    let active_post := removeActiveProtector active1 0
    let tree_w := applyTreeAccess (applyTreeAccess tree_post 2 .write (splitLeft base mid) active_post
      .visitChildrenOfAccessed) 3 .write (splitRight base mid len) active_post .visitChildrenOfAccessed
    HasUniqueWritePerm tree_post 2 (splitLeft base mid) active_post ∧
      HasUniqueWritePerm tree_post 3 (splitRight base mid len) active_post ∧
      (∀ b, (splitRight base mid len).contains b = true →
        ¬ TreeAccessNoUB tree_w 2 .write ⟨b, b + 1⟩ active_post .visitChildrenOfAccessed) := by
  intro active1 tree1 tree2 tree3 tree_post active_post tree_w
  obtain ⟨_, hL, hR, _, _, _, _, _, _, hX⟩ := split_at_mut_unique_write_perm
    (t_parent := 0) (t_arg := 1) (t_left := 2) (t_right := 3) (callId := 0)
    (activeCaller := fun _ => false) hmid (rootTree_hasUniqueWritePerm 0 _ _) rfl rfl rfl
    (by decide) (by decide) (by decide) (fun _ _ _ hp => nomatch hp) rfl
  exact ⟨hL, hR, hX⟩

/-- **Parent-write-before-reborrow soundness**: when the callee writes through
the protected argument `t_arg` on `parentRange` *before* reborrowing `t_ret` on
`subRange ⊆ parentRange`, `t_arg` becomes `Active` across all of `parentRange`
and emits an implicit write at two-stage release under `skipChildrenOfAccessed`,
yet `t_ret` still retains `HasUniqueWritePerm` after release. -/
theorem reborrow_return_after_parent_write_unique_write_perm {tree0 : BorrowTree}
    {t_parent t_arg t_ret : BorTag} {parentRange subRange : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent parentRange activeCaller)
    (hSub : subRange.Sub parentRange)
    (hFreshArg : tree0.present t_arg = false) (hFreshRet : tree0.present t_ret = false)
    (hRetNeArg : t_ret ≠ t_arg)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      parentRange active1
    let tree2 := applyTreeAccess tree1 t_arg .write parentRange active1 .visitChildrenOfAccessed
    let tree3 := retagChild tree2 t_arg t_ret none (initPermOf .mut) subRange active1
    let tree_post := applyReleaseProtector tree3 t_arg active1
    let active_post := removeActiveProtector active1 callId
    TreeAccessNoUB tree1 t_arg .write parentRange active1 .visitChildrenOfAccessed ∧
      releaseProtectorNoUB tree3 t_arg active1 ∧
      HasUniqueWritePerm tree_post t_ret subRange active_post ∧
      TreeAccessNoUB tree_post t_ret .write subRange active_post .visitChildrenOfAccessed := by
  intro active1 tree1 tree2 tree3 tree_post active_post
  have hAct : active_post = activeCaller := removeActiveProtector_insert hCallFresh
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg parentRange active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  obtain ⟨hParentWriteNoUB, hTree2ArgPerm⟩ :=
    local_access_preserves_hasUniqueWritePerm .write hTree1Perm (ByteRange.Sub.refl _)
  have hFreshRet2 : tree2.present t_ret = false := by
    show tree1.present t_ret = false
    rw [retagChild_present, decide_eq_false hRetNeArg, Bool.false_or]
    exact hFreshRet
  have hTree3ArgPerm : HasUniqueWritePerm tree3 t_arg parentRange active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree2ArgPerm hFreshRet2
  have hTree3RetPerm : HasUniqueWritePerm tree3 t_ret subRange active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm hSub hFreshRet2).2
  have hState : CalleeReborrowState tree3 t_arg t_ret parentRange subRange activeCaller callId := by
    refine ⟨hSub, hTree3ArgPerm, hTree3RetPerm.tag_present,
      isAnc_child_of_retag hTree2ArgPerm.wf hTree2ArgPerm.tag_present, hRetNeArg, ?_,
      hTree3RetPerm.ancestors_writable, ?_⟩
    · intro b hAcc
      cases hbP : parentRange.contains b with
      | true => rfl
      | false =>
        have hbS : subRange.contains b = false := by
          cases h : subRange.contains b with
          | false => rfl
          | true => have := hSub b h; rw [hbP] at this; cases this
        have h3 : tree3.locState t_arg b = tree2.locState t_arg b := by
          show (retagChild tree2 t_arg t_ret none (initPermOf .mut) subRange active1).locState t_arg b = _
          rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbS,
            insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hRetNeArg)]
        have h2 : tree2.locState t_arg b = tree1.locState t_arg b :=
          applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hbP
        have h1 : (tree1.locState t_arg b).accessed = parentRange.contains b :=
          retagChild_child_accessed (by intro h; cases h) b
        rw [h3, h2, h1, hbP] at hAcc
        cases hAcc
    · intro d hDesc hdNe
      by_cases hdRet : d = t_ret
      · rw [hdRet]
        show (insertChildNode tree2 t_arg t_ret none (initPermOf .mut)).isTagProtected t_ret activeCaller = false
        exact insertChildNode_isTagProtected_child_none _ _ _ _ _
      · have h2 : tree2.isAnc t_arg d = true :=
          retag_desc_cases hDesc hdRet (Ne.symm hRetNeArg)
        have h1 : tree1.isAnc t_arg d = true := h2
        rw [retag_not_desc_of_new hdNe] at h1
        cases h1
  obtain ⟨hRelNoUB, _, hPostPerm⟩ := releaseProtector_preserves_reborrow_child hState
  rw [hAct]
  obtain ⟨hCallerWriteNoUB, _⟩ :=
    local_access_preserves_hasUniqueWritePerm .write hPostPerm (ByteRange.Sub.refl _)
  exact ⟨hParentWriteNoUB, hRelNoUB, hPostPerm, hCallerWriteNoUB⟩

/-- **Parent-write-after-reborrow disables child**: if the callee writes through
`t_arg` on `subRange` *after* reborrowing `t_ret` under `t_arg`, the write is
foreign to `t_ret`, disabling `t_ret` at every byte `b ∈ subRange` so subsequent
writes through `t_ret` fault. -/
theorem callee_parent_write_after_reborrow_disables_child {tree0 : BorrowTree}
    {t_parent t_arg t_ret : BorTag} {parentRange subRange : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId} {b : Nat}
    (hRetNeArg : t_ret ≠ t_arg)
    (hb : subRange.contains b = true) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      parentRange active1
    let tree2 := retagChild tree1 t_arg t_ret none (initPermOf .mut) subRange active1
    let tree3 := applyTreeAccess tree2 t_arg .write subRange active1 .visitChildrenOfAccessed
    tree3.locState t_ret b = ⟨.disabled, true⟩ ∧
      ¬ TreeAccessNoUB tree3 t_ret .write ⟨b, b + 1⟩ active1 .visitChildrenOfAccessed := by
  intro active1 tree1 tree2 tree3
  have hRetPres2 : tree2.present t_ret = true := by
    rw [retagChild_present, decide_eq_true rfl, Bool.true_or]
  have hRetNotAncArg : tree2.isAnc t_ret t_arg = false :=
    retag_not_desc_of_new (tree := tree1) (t_parent := t_arg) (t_child := t_ret)
      (prot := none) (initPerm := initPermOf .mut) (range := subRange) (active := active1)
      (Ne.symm hRetNeArg)
  have hRetProt : tree2.isTagProtected t_ret active1 = false := by
    show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isTagProtected t_ret active1 = false
    exact insertChildNode_isTagProtected_child_none _ _ _ _ _
  have hRetLoc2 : tree2.locState t_ret b = ⟨.reservedFrz false, true⟩ := by
    show (applyTreeAccess (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)) t_ret .read
      subRange active1 .visitChildrenOfAccessed).locState t_ret b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _
      (by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or]) hb,
      nodeAccessRelatedness_anc (by rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]),
      insertChildNode_locState_child]
    rfl
  have hRetLoc3 : tree3.locState t_ret b = ⟨.disabled, true⟩ := by
    show (applyTreeAccess tree2 t_arg .write subRange active1 .visitChildrenOfAccessed).locState t_ret b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hRetPres2 hb,
      nodeAccessRelatedness_visit_foreign hRetNotAncArg]
    show (match performTransition .write .foreignAccess (tree2.isTagProtected t_ret active1)
      (tree2.locState t_ret b) with | some st' => st' | none => _) = _
    rw [hRetProt, hRetLoc2]
    rfl
  refine ⟨hRetLoc3, ?_⟩
  intro hNoUB
  have hRefl3 : tree3.isAnc t_ret t_ret = true := by
    show (insertChildNode tree1 t_arg t_ret none (initPermOf .mut)).isAnc t_ret t_ret = true
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  have hAt := hNoUB t_ret b hRetPres2
    ((ByteRange.contains_iff _ _).mpr ⟨Nat.le_refl b, Nat.lt_succ_self b⟩)
  rw [nodeAccessRelatedness_anc hRefl3] at hAt
  change (performTransition .write .localAccess _ (tree3.locState t_ret b)).isSome = true at hAt
  rw [hRetLoc3] at hAt
  cases hAt

/-- **Overlapping `reborrowFootprint` failure**: if a `TrustedFnSpec` declares
two `&mut` reborrows `(r₁, .mut)` and `(r₂, .mut)` that overlap at byte `b`
(`r₁.contains b = true ∧ r₂.contains b = true`), writing through the first
returned reference (`t_arg + 1`) at `r₁` disables the second returned reference
(`t_arg + 1 + 1`) at `b`, refuting `HasUniqueWritePerm` and causing both reads
and writes through `t_arg + 1 + 1` at `⟨b, b + 1⟩` to fault. -/
theorem overlapping_reborrowFootprint_write_disables_sibling {tree0 : BorrowTree}
    {t_parent t_arg : BorTag} {argRange r₁ r₂ : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId} {b : Nat}
    (hb1 : r₁.contains b = true) (hb2 : r₂.contains b = true) :
    let spec : TrustedFnSpec := ⟨argRange, [(r₁, .mut), (r₂, .mut)]⟩
    let out := spec.run tree0 activeCaller t_parent t_arg callId
    let tree_w1 := applyTreeAccess out.tree (t_arg + 1) .write r₁ out.active .visitChildrenOfAccessed
    out.rets = [t_arg + 1, t_arg + 1 + 1] ∧
      (tree_w1.locState (t_arg + 1 + 1) b).perm = .disabled ∧
      ¬ HasUniqueWritePerm tree_w1 (t_arg + 1 + 1) r₂ out.active ∧
      ¬ TreeAccessNoUB tree_w1 (t_arg + 1 + 1) .write ⟨b, b + 1⟩ out.active .visitChildrenOfAccessed ∧
      ¬ TreeAccessNoUB tree_w1 (t_arg + 1 + 1) .read ⟨b, b + 1⟩ out.active .visitChildrenOfAccessed := by
  intro spec out tree_w1
  have hne21 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
  have hne20 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
  let active1 := insertActiveProtector activeCaller callId
  let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    argRange active1
  let tree2 := retagChild tree1 t_arg (t_arg + 1) none (initPermOf .mut) r₁ active1
  let tree3 := retagChild tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut) r₂ active1
  have hRPres3 : tree3.present (t_arg + 1 + 1) = true := by
    rw [retagChild_present, decide_eq_true rfl, Bool.true_or]
  have hRNotAncArg3 : tree3.isAnc (t_arg + 1 + 1) t_arg = false :=
    retag_not_desc_of_new (Ne.symm hne20)
  have hArgAncR3 : tree3.isAnc t_arg (t_arg + 1 + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isAnc t_arg (t_arg + 1 + 1) = true
    rw [insertChildNode_isAnc_child]
    have hArgPres2 : tree2.present t_arg = true := by
      rw [retagChild_present, retagChild_present, decide_eq_true rfl, Bool.true_or, Bool.or_true]
    have hArgRefl1 : (insertChildNode tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)).isAnc
        t_arg t_arg = true := by
      rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
    have hArgRefl2 : tree2.isAnc t_arg t_arg = true := by
      show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .mut)).isAnc t_arg t_arg = true
      rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm (Nat.succ_ne_self t_arg))
        (Ne.symm (Nat.succ_ne_self t_arg))]
      exact hArgRefl1
    rw [hArgRefl2, Bool.or_true]
  have hRLoc3 : tree3.locState (t_arg + 1 + 1) b = ⟨.reservedFrz false, true⟩ := by
    show (applyTreeAccess (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut))
      (t_arg + 1 + 1) .read r₂ active1 .visitChildrenOfAccessed).locState (t_arg + 1 + 1) b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _
      (by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or]) hb2,
      nodeAccessRelatedness_anc (by rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]),
      insertChildNode_locState_child]
    rfl
  have hRLocPost : out.tree.locState (t_arg + 1 + 1) b = ⟨.reservedFrz false, true⟩ := by
    show (applyReleaseProtector tree3 t_arg active1).locState (t_arg + 1 + 1) b = _
    cases hAcc : (tree3.locState t_arg b).accessed with
    | false =>
      rw [applyReleaseProtector_locState_unacc tree3 t_arg active1 (t_arg + 1 + 1) b hAcc, hRLoc3]
    | true =>
      rw [applyReleaseProtector_locState_acc tree3 t_arg active1 (t_arg + 1 + 1) b hRPres3 hAcc,
        nodeAccessRelatedness_skip_desc hRNotAncArg3 hArgAncR3, hRLoc3]
  have hRNotAncL : out.tree.isAnc (t_arg + 1 + 1) (t_arg + 1) = false := by
    show tree3.isAnc (t_arg + 1 + 1) (t_arg + 1) = false
    exact retag_not_desc_of_new (tree := tree2) (t_parent := t_arg) (t_child := t_arg + 1 + 1)
      (prot := none) (initPerm := initPermOf .mut) (range := r₂) (active := active1)
      (Ne.symm hne21)
  have hRProt : out.tree.isTagProtected (t_arg + 1 + 1) out.active = false := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isTagProtected
      (t_arg + 1 + 1) out.active = false
    exact insertChildNode_isTagProtected_child_none _ _ _ _ _
  have hRLocW1 : tree_w1.locState (t_arg + 1 + 1) b = ⟨.disabled, true⟩ := by
    show (applyTreeAccess out.tree (t_arg + 1) .write r₁ out.active
      .visitChildrenOfAccessed).locState (t_arg + 1 + 1) b = _
    rw [applyTreeAccess_locState_in out.tree _ _ _ _ _ _ _ hRPres3 hb1,
      nodeAccessRelatedness_visit_foreign hRNotAncL]
    show (match performTransition .write .foreignAccess
      (out.tree.isTagProtected (t_arg + 1 + 1) out.active)
      (out.tree.locState (t_arg + 1 + 1) b) with | some st' => st' | none => _) = _
    rw [hRProt, hRLocPost]
    rfl
  have hReflR : tree_w1.isAnc (t_arg + 1 + 1) (t_arg + 1 + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isAnc
      (t_arg + 1 + 1) (t_arg + 1 + 1) = true
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  have hInB : (ByteRange.mk b (b + 1)).contains b = true :=
    (ByteRange.contains_iff _ _).mpr ⟨Nat.le_refl b, Nat.lt_succ_self b⟩
  refine ⟨rfl, by rw [hRLocW1], ?_, ?_, ?_⟩
  · intro hPerm
    have hAw := hPerm.ancestors_writable (t_arg + 1 + 1) b hReflR hb2
    rw [hRLocW1] at hAw
    rcases hAw with h | h | h <;> cases h
  · intro hNoUB
    have hAt := hNoUB (t_arg + 1 + 1) b hRPres3 hInB
    rw [nodeAccessRelatedness_anc hReflR] at hAt
    change (performTransition .write .localAccess _ (tree_w1.locState (t_arg + 1 + 1) b)).isSome = true at hAt
    rw [hRLocW1] at hAt
    cases hAt
  · intro hNoUB
    have hAt := hNoUB (t_arg + 1 + 1) b hRPres3 hInB
    rw [nodeAccessRelatedness_anc hReflR] at hAt
    change (performTransition .read .localAccess _ (tree_w1.locState (t_arg + 1 + 1) b)).isSome = true at hAt
    rw [hRLocW1] at hAt
    cases hAt

/-- Embedding of `Permission` into the trusted
`Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowPerm`. -/
def Permission.toLiveTreeBorrowPerm :
    Permission → Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowPerm
  | .reservedFrz c => .reservedFrz c
  | .reservedIM => .reservedIM
  | .active => .unique
  | .frozen => .frozen
  | .disabled => .disabled

/-- Partial inverse from the trusted `TreeBorrowPerm` (`Cell` is mapped to `none`). -/
def Permission.ofLiveTreeBorrowPerm? :
    Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowPerm → Option Permission
  | .cell => none
  | .reservedFrz c => some (.reservedFrz c)
  | .reservedIM => some .reservedIM
  | .unique => some .active
  | .frozen => some .frozen
  | .disabled => some .disabled

/-- **Bridge to the trusted `TreeBorrowPerm`**: `Permission` embeds injectively as
the exact non-`Cell` fragment of the trusted `TreeBorrowPerm`. -/
theorem ofLiveTreeBorrowPerm?_toLiveTreeBorrowPerm (p : Permission) :
    Permission.ofLiveTreeBorrowPerm? p.toLiveTreeBorrowPerm = some p := by
  cases p <;> rfl

theorem toLiveTreeBorrowPerm_ofLiveTreeBorrowPerm?
    {lp : Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowPerm} {p : Permission}
    (h : Permission.ofLiveTreeBorrowPerm? lp = some p) :
    p.toLiveTreeBorrowPerm = lp := by
  cases lp <;> simp [Permission.ofLiveTreeBorrowPerm?] at h <;> subst h <;> rfl

/-- Byte-range projection of a trusted `Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry`. -/
def liveBorrowEntryRange (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) : ByteRange :=
  ⟨e.rangeOffset, e.rangeOffset + e.rangeLen⟩

/-- Protector projection of a trusted `BorrowEntry`. -/
def liveBorrowEntryProtector (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) :
    Option ProtectorKind :=
  e.protector.map ProtectorKind.strong

theorem liveBorrowEntryRange_contains_iff
    (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) (b : Nat) :
    (liveBorrowEntryRange e).contains b = true ↔
      e.rangeOffset ≤ b ∧ b < e.rangeOffset + e.rangeLen :=
  ByteRange.contains_iff _ _

/-- Trusted access kind of a model access. -/
def AccessKind.toLive : AccessKind → Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowAccessKind
  | .read => .read
  | .write => .write

/-- Trusted relatedness of a model relatedness. -/
def AccessRelatedness.toLive :
    AccessRelatedness → Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowRelatedness
  | .localAccess => .localAccess
  | .foreignAccess => .foreignAccess

/-- Read a trusted per-node outcome back into the model: trusted UB (`.ub`) and the
fail-closed `.protectedReservedIM` become `none`; a trusted transition to a
non-`Cell` permission yields that permission with `accessed := acc`. -/
def ofLiveTransition (acc : Bool) :
    Trusted.Rustc.V2026_06_01.MirSemantics.TreeBorrowTransition → Option LocationState
  | .transition q => (Permission.ofLiveTreeBorrowPerm? q).map (fun p => ⟨p, acc⟩)
  | .ub => none
  | .protectedReservedIM => none

/-- **Semantic bridge to the trusted Tree Borrows automaton**: on every
accessed location (the trusted model's invariant: each trusted `BorrowEntry` stands for an
accessed location), `performTransition` *is* the trusted `treeBorrowNodeAccess`
(Miri's per-permission transition, the `ProtectedDisabled` protector check, and the
foreign-access skip of `Disabled` nodes), for all access kinds, relatednesses,
protector settings, and permissions. -/
theorem performTransition_accessed_eq_live (kind : AccessKind) (rel : AccessRelatedness)
    (isProt : Bool) (p : Permission) :
    performTransition kind rel isProt ⟨p, true⟩ =
      ofLiveTransition true
        (Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowNodeAccess kind.toLive rel.toLive
          p.toLiveTreeBorrowPerm isProt) := by
  cases kind <;> cases rel <;> cases isProt <;> rcases p with (_ | _) | _ | _ | _ | _ <;> rfl

/-- **Miri's `accessed` guard** on lazily initialized locations (which the trusted
model does not represent): on an unaccessed location, a child access is the trusted
per-permission transition (and marks the location accessed), and a foreign access is
the trusted per-permission transition *without* the `ProtectedDisabled` check. -/
theorem performTransition_unaccessed_eq_live (kind : AccessKind) (rel : AccessRelatedness)
    (isProt : Bool) (p : Permission) :
    performTransition kind rel isProt ⟨p, false⟩ =
      ofLiveTransition (match rel with | .localAccess => true | .foreignAccess => false)
        (Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowPermTransition kind.toLive rel.toLive
          p.toLiveTreeBorrowPerm isProt) := by
  cases kind <;> cases rel <;> cases isProt <;> rcases p with (_ | _) | _ | _ | _ | _ <;> rfl

/-- UB detection on accessed locations coincides with the trusted
`treeBorrowTransitionIsUB`. -/
theorem performTransition_accessed_isSome_eq_live (kind : AccessKind) (rel : AccessRelatedness)
    (isProt : Bool) (p : Permission) :
    (performTransition kind rel isProt ⟨p, true⟩).isSome =
      !Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowTransitionIsUB
        (Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowNodeAccess kind.toLive rel.toLive
          p.toLiveTreeBorrowPerm isProt) := by
  cases kind <;> cases rel <;> cases isProt <;> rcases p with (_ | _) | _ | _ | _ | _ <;> rfl

/-- Protector-status bridge: a tag carrying a trusted entry's protector is protected
under the active set `natListContainsBool l` exactly when the trusted
`isBorrowProtected l e` holds. -/
theorem isTagProtected_eq_live (tree : BorrowTree) (t : BorTag) (l : List Nat)
    (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry)
    (h : tree.protector t = liveBorrowEntryProtector e) :
    tree.isTagProtected t (Trusted.Rustc.V2026_06_01.MirSemantics.natListContainsBool l) =
      Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowProtected l e := by
  unfold BorrowTree.isTagProtected Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowProtected
  rw [h]
  unfold liveBorrowEntryProtector
  cases e.protector <;> rfl

/-- **Per-entry bridge**: for a tag mirroring a trusted `BorrowEntry` `e` (same
non-`Cell` permission and protector), the model's per-location update under the
trusted active-protector list `l` is the trusted per-entry outcome
`treeBorrowNodeAccess … e.perm (isBorrowProtected l e)`. -/
theorem performTransition_entry_eq_live (kind : AccessKind) (rel : AccessRelatedness)
    (tree : BorrowTree) (t : BorTag) (l : List Nat) (p : Permission)
    (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry)
    (hPerm : e.perm = p.toLiveTreeBorrowPerm) (hProt : tree.protector t = liveBorrowEntryProtector e) :
    performTransition kind rel
        (tree.isTagProtected t (Trusted.Rustc.V2026_06_01.MirSemantics.natListContainsBool l))
        ⟨p, true⟩ =
      ofLiveTransition true
        (Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowNodeAccess kind.toLive rel.toLive e.perm
          (Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowProtected l e)) := by
  rw [isTagProtected_eq_live tree t l e hProt, hPerm]
  exact performTransition_accessed_eq_live kind rel _ p

/-- Regression: a foreign write to a protected, accessed `Disabled`
location is a no-op (Miri `skip_if_known_noop`, trusted `treeBorrowNodeAccess`), not UB. -/
theorem foreign_write_disabled_protected_noop :
    performTransition .write .foreignAccess true ⟨.disabled, true⟩ = some ⟨.disabled, true⟩ := rfl

/-- Regression: a protected `ReservedIM` fails closed under every foreign
access, accessed or not (trusted `.protectedReservedIM`). -/
theorem protected_reservedIM_foreign_fails_closed (kind : AccessKind) (acc : Bool) :
    performTransition kind .foreignAccess true ⟨.reservedIM, acc⟩ = none := by
  cases kind <;> rfl

/-- Unprotecting a call id preserves `HasUniqueWritePerm`. -/
theorem hasUniqueWritePerm_remove_callId {tree : BorrowTree} {tag : BorTag}
    {range : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hCallFresh : activeCaller callId = false)
    (hPerm : HasUniqueWritePerm tree tag range (insertActiveProtector activeCaller callId)) :
    HasUniqueWritePerm tree tag range
      (removeActiveProtector (insertActiveProtector activeCaller callId) callId) := by
  rw [removeActiveProtector_insert hCallFresh]
  refine ⟨hPerm.wf, hPerm.tag_present, hPerm.ancestors_writable, ?_⟩
  intro other b hPres hNotAnc hb
  exact nonAncestorSafe_mono_unprotect _ _ _
    (hPerm.non_ancestors_safe other b hPres hNotAnc hb) isTagProtected_insert_of_caller

/-- Stage-2-only spec execution (modeling the trusted `restoreCallerProtectors`
return path in `Terminators.lean`, which drops `callId` without stage-1
`applyReleaseProtector`). -/
def TrustedFnSpec.runStage2Only (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId) : CallOutcome :=
  let active₁ := insertActiveProtector activeCaller callId
  let tree₁ := retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    spec.argRange active₁
  let fp := applyFootprint t_arg active₁ tree₁ (t_arg + 1) spec.reborrowFootprint
  { tree := fp.1
    active := removeActiveProtector active₁ callId
    rets := fp.2 }

/-- **`split_at_mut_stage2Only_unique_write_perm`**: under the trusted stage-2-only
return path (`TrustedFnSpec.runStage2Only`, matching `restoreCallerProtectors`),
`split_at_mut` still establishes `HasUniqueWritePerm` on both returned `&mut`
slices and still faults on cross-half writes after activating both halves. -/
theorem split_at_mut_stage2Only_unique_write_perm {tree0 : BorrowTree} {t_parent t_arg : BorTag}
    {base mid len : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hmid : mid ≤ len)
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFresh : ∀ t, t_arg ≤ t → tree0.present t = false)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let out := (splitAtMutSpec base mid len).runStage2Only tree0 activeCaller t_parent t_arg callId
    let tree_wl := applyTreeAccess out.tree (t_arg + 1) .write (splitLeft base mid) out.active
      .visitChildrenOfAccessed
    let tree_w := applyTreeAccess tree_wl (t_arg + 1 + 1) .write (splitRight base mid len) out.active
      .visitChildrenOfAccessed
    out.rets = [t_arg + 1, t_arg + 1 + 1] ∧
      HasUniqueWritePerm out.tree (t_arg + 1) (splitLeft base mid) out.active ∧
      HasUniqueWritePerm out.tree (t_arg + 1 + 1) (splitRight base mid len) out.active ∧
      (∀ b, (splitRight base mid len).contains b = true →
        ¬ TreeAccessNoUB tree_w (t_arg + 1) .write ⟨b, b + 1⟩ out.active .visitChildrenOfAccessed) := by
  intro out tree_wl tree_w
  have hFreshArg : tree0.present t_arg = false := hFresh t_arg (Nat.le_refl _)
  have hFreshL : tree0.present (t_arg + 1) = false := hFresh (t_arg + 1) (Nat.le_succ _)
  have hFreshR : tree0.present (t_arg + 1 + 1) = false :=
    hFresh (t_arg + 1 + 1) (Nat.le_succ_of_le (Nat.le_succ t_arg))
  have hne1 : t_arg + 1 ≠ t_arg := Nat.succ_ne_self t_arg
  have hne2 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
  have hne3 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
  have hDisj := split_disjoint base mid len
  have hDisjSymm := hDisj.symm
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  let active1 := insertActiveProtector activeCaller callId
  let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    (wholeRange base len) active1
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg (wholeRange base len) active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  have hFreshL1 : tree1.present (t_arg + 1) = false := by
    rw [retagChild_present, decide_eq_false hne1, Bool.false_or]; exact hFreshL
  let tree2 := retagChild tree1 t_arg (t_arg + 1) none (initPermOf .mut) (splitLeft base mid) active1
  have hTree2ArgPerm : HasUniqueWritePerm tree2 t_arg (wholeRange base len) active1 :=
    retagUnprotectedChild_preserves_parent_hasUniqueWritePerm hTree1Perm hFreshL1
  have hTree2LPerm : HasUniqueWritePerm tree2 (t_arg + 1) (splitLeft base mid) active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm
      (splitLeft_sub (base := base) hmid) hFreshL1).2
  have hFreshR2 : tree2.present (t_arg + 1 + 1) = false := by
    rw [retagChild_present, decide_eq_false hne3, Bool.false_or, retagChild_present,
      decide_eq_false hne2, Bool.false_or]
    exact hFreshR
  have hTree3RPerm : HasUniqueWritePerm out.tree (t_arg + 1 + 1) (splitRight base mid len) active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm
      (splitRight_sub base mid len) hFreshR2).2
  have hTree3LPerm : HasUniqueWritePerm out.tree (t_arg + 1) (splitLeft base mid) active1 :=
    disjoint_retagChild_preserves_hasUniqueWritePerm (t_left := t_arg) (t_child := t_arg + 1 + 1)
      none (initPermOf .mut) (by intro h; cases h) hTree2LPerm hDisjSymm hFreshR2
  have hPostL : HasUniqueWritePerm out.tree (t_arg + 1) (splitLeft base mid) out.active :=
    hasUniqueWritePerm_remove_callId hCallFresh hTree3LPerm
  have hPostR : HasUniqueWritePerm out.tree (t_arg + 1 + 1) (splitRight base mid len) out.active :=
    hasUniqueWritePerm_remove_callId hCallFresh hTree3RPerm
  refine ⟨rfl, hPostL, hPostR, ?_⟩
  intro b hb hNoUB
  have hbL : (splitLeft base mid).contains b = false := hDisjSymm b hb
  have hLnotAncR : out.tree.isAnc (t_arg + 1) (t_arg + 1 + 1) = false := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isAnc
      (t_arg + 1) (t_arg + 1 + 1) = false
    rw [insertChildNode_isAnc_child, decide_eq_false (Ne.symm hne3), Bool.false_or]
    exact retag_not_desc_of_new (Ne.symm hne1)
  have hLprot : ∀ act, out.tree.isTagProtected (t_arg + 1) act = false := by
    intro act
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isTagProtected
      (t_arg + 1) act = false
    rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ (Ne.symm hne3)]
    show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .mut)).isTagProtected
      (t_arg + 1) act = false
    exact insertChildNode_isTagProtected_child_none _ _ _ _ _
  have hLpres : out.tree.present (t_arg + 1) = true := hPostL.tag_present
  have hL2 : tree2.locState (t_arg + 1) b = ⟨.reservedFrz false, false⟩ := by
    show (retagChild tree1 t_arg (t_arg + 1) none (initPermOf .mut)
      (splitLeft base mid) active1).locState (t_arg + 1) b = _
    rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hbL, insertChildNode_locState_child]
    rfl
  have hLpresI : (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).present
      (t_arg + 1) = true := hLpres
  have hLnotAncRI : (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).isAnc
      (t_arg + 1) (t_arg + 1 + 1) = false := hLnotAncR
  have hL3 : out.tree.locState (t_arg + 1) b = ⟨.reservedFrz false, false⟩ := by
    show (applyTreeAccess (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut))
      (t_arg + 1 + 1) .read (splitRight base mid len) active1 .visitChildrenOfAccessed).locState
      (t_arg + 1) b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hLpresI hb,
      nodeAccessRelatedness_visit_foreign hLnotAncRI]
    show (match performTransition .read .foreignAccess (out.tree.isTagProtected (t_arg + 1) active1)
      ((insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .mut)).locState (t_arg + 1) b)
      with | some st' => st' | none => _) = _
    rw [hLprot active1, insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hne3), hL2]
    rfl
  have hLwl : tree_wl.locState (t_arg + 1) b = ⟨.reservedFrz false, false⟩ := by
    show (applyTreeAccess out.tree (t_arg + 1) .write (splitLeft base mid) out.active
      .visitChildrenOfAccessed).locState (t_arg + 1) b = _
    rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hbL, hL3]
  have hLpresWl : tree_wl.present (t_arg + 1) = true := hLpres
  have hLnotAncRWl : tree_wl.isAnc (t_arg + 1) (t_arg + 1 + 1) = false := hLnotAncR
  have hLw : tree_w.locState (t_arg + 1) b = ⟨.disabled, false⟩ := by
    show (applyTreeAccess tree_wl (t_arg + 1 + 1) .write (splitRight base mid len) out.active
      .visitChildrenOfAccessed).locState (t_arg + 1) b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hLpresWl hb,
      nodeAccessRelatedness_visit_foreign hLnotAncRWl]
    show (match performTransition .write .foreignAccess
      (out.tree.isTagProtected (t_arg + 1) out.active)
      (tree_wl.locState (t_arg + 1) b) with | some st' => st' | none => _) = _
    rw [hLprot out.active, hLwl]
    rfl
  have hReflL : tree_w.isAnc (t_arg + 1) (t_arg + 1) = true :=
    hPostL.wf.isAnc_refl (t_arg + 1) hLpres
  have hLpresW : tree_w.present (t_arg + 1) = true := hLpres
  have hAt := hNoUB (t_arg + 1) b hLpresW
    ((ByteRange.contains_iff _ _).mpr ⟨Nat.le_refl b, Nat.lt_succ_self b⟩)
  rw [nodeAccessRelatedness_anc hReflL] at hAt
  change (performTransition .write .localAccess _ (tree_w.locState (t_arg + 1) b)).isSome = true at hAt
  rw [hLw] at hAt
  cases hAt

/-- **Exact separation between Miri's stage-1 protector release and stage-2-only
release**: on a concrete UB-free two-argument call `foo(x, y)` receiving two
two-phase `&mut` borrows under `rootTree 0`, releasing `t_arg_x`'s protector in
stage 1 while `callId` is still active marks `t_arg_y` conflicted
(`⟨.reservedFrz true, true⟩`), whereas stage-2-only release leaves `t_arg_y`
unconflicted (`⟨.reservedFrz false, true⟩`). -/
theorem stage1_vs_stage2Only_two_arg_release_differs (r : ByteRange) (b : Nat)
    (hb : r.contains b = true) :
    let active1 := insertActiveProtector (fun _ => false) 0
    let tree1 := retagChild (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false) r active1
    let tree2 := retagChild tree1 0 2 (some (.strong 0)) (.reservedFrz false) r active1
    TreeAccessNoUB (insertChildNode (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false))
        1 .read r active1 .visitChildrenOfAccessed ∧
      TreeAccessNoUB (insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false))
        2 .read r active1 .visitChildrenOfAccessed ∧
      releaseProtectorNoUB tree2 1 active1 ∧
      (applyReleaseProtector tree2 1 active1).locState 2 b = ⟨.reservedFrz true, true⟩ ∧
      tree2.locState 2 b = ⟨.reservedFrz false, true⟩ := by
  intro active1 tree1 tree2
  have hPerm0 := rootTree_hasUniqueWritePerm 0 r active1
  obtain ⟨hNoUB1, _⟩ := retagChild_hasUniqueWritePerm (t_child := 1) (some (.strong 0)) fnEntry_writable
    hPerm0 (ByteRange.Sub.refl r) rfl
  have hNoUB2 : TreeAccessNoUB (insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false))
      2 .read r active1 .visitChildrenOfAccessed := by
    intro n b' hPres hb'
    let tI := insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)
    by_cases hn2 : n = 2
    · subst hn2
      have hAnc : tI.isAnc 2 2 = true := rfl
      rw [nodeAccessRelatedness_anc hAnc]
      rfl
    · by_cases hn0 : n = 0
      · subst hn0
        have hAnc : tI.isAnc 0 2 = true := rfl
        rw [nodeAccessRelatedness_anc hAnc]
        have hLoc : tI.locState 0 b' = ⟨.active, true⟩ := by
          show tree1.locState 0 b' = _
          rw [show tree1 = applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0))
            (.reservedFrz false)) 1 .read r active1 .visitChildrenOfAccessed from rfl,
            applyTreeAccess_locState_in _ _ _ _ _ _ 0 b' rfl hb',
            nodeAccessRelatedness_anc rfl]
          rfl
        show (performTransition .read .localAccess _ (tI.locState 0 b')).isSome = true
        rw [hLoc]
        rfl
      · have hn1 : n = 1 := by
          simp only [insertChildNode, tree1, retagChild, applyTreeAccess, rootTree,
            Bool.or_eq_true, decide_eq_true_eq] at hPres
          rcases hPres with rfl | rfl | rfl
          · exact absurd rfl hn2
          · rfl
          · exact absurd rfl hn0
        subst hn1
        have hNotAnc : tI.isAnc 1 2 = false := rfl
        rw [nodeAccessRelatedness_visit_foreign hNotAnc]
        have hLoc : tI.locState 1 b' = ⟨.reservedFrz false, true⟩ := by
          show tree1.locState 1 b' = _
          rw [show tree1 = applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0))
            (.reservedFrz false)) 1 .read r active1 .visitChildrenOfAccessed from rfl,
            applyTreeAccess_locState_in _ _ _ _ _ _ 1 b' rfl hb',
            nodeAccessRelatedness_anc rfl]
          rfl
        show (performTransition .read .foreignAccess (tI.isTagProtected 1 active1)
          (tI.locState 1 b')).isSome = true
        rw [hLoc]
        rfl
  have hAcc1 : ∀ b', (tree2.locState 1 b').accessed = true → r.contains b' = true := by
    intro b' hAcc
    cases hb' : r.contains b' with
    | true => rfl
    | false =>
      have h2 : tree2.locState 1 b' = tree1.locState 1 b' := by
        show (retagChild tree1 0 2 (some (.strong 0)) (.reservedFrz false) r active1).locState 1 b' = _
        rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hb',
          insertChildNode_locState_of_ne _ _ _ _ _ (by decide)]
      have h1 : (tree1.locState 1 b').accessed = r.contains b' :=
        retagChild_child_accessed (tree := rootTree 0) (t_parent := 0) (t_child := 1)
          (prot := some (.strong 0)) (initPerm := .reservedFrz false) (range := r)
          (active := active1) (by decide) b'
      rw [h2, h1, hb'] at hAcc
      cases hAcc
  have hLoc1In : ∀ b', r.contains b' = true → tree2.locState 1 b' = ⟨.reservedFrz true, true⟩ := by
    intro b' hb'
    have h1 : tree1.locState 1 b' = ⟨.reservedFrz false, true⟩ := by
      rw [show tree1 = applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0))
        (.reservedFrz false)) 1 .read r active1 .visitChildrenOfAccessed from rfl,
        applyTreeAccess_locState_in _ _ _ _ _ _ 1 b' rfl hb',
        nodeAccessRelatedness_anc rfl]
      rfl
    rw [show tree2 = applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0))
      (.reservedFrz false)) 2 .read r active1 .visitChildrenOfAccessed from rfl,
      applyTreeAccess_locState_in _ _ _ _ _ _ 1 b' rfl hb',
      nodeAccessRelatedness_visit_foreign rfl]
    show (match performTransition .read .foreignAccess true
      ((insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)).locState 1 b')
      with | some st' => st' | none => _) = _
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (by decide), h1]
    rfl
  have hLoc2In : ∀ b', r.contains b' = true → tree2.locState 2 b' = ⟨.reservedFrz false, true⟩ := by
    intro b' hb'
    rw [show tree2 = applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0))
      (.reservedFrz false)) 2 .read r active1 .visitChildrenOfAccessed from rfl,
      applyTreeAccess_locState_in _ _ _ _ _ _ 2 b' rfl hb',
      nodeAccessRelatedness_anc rfl]
    rfl
  have hLoc0In : ∀ b', r.contains b' = true → tree2.locState 0 b' = ⟨.active, true⟩ := by
    intro b' hb'
    have h1 : tree1.locState 0 b' = ⟨.active, true⟩ := by
      rw [show tree1 = applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0))
        (.reservedFrz false)) 1 .read r active1 .visitChildrenOfAccessed from rfl,
        applyTreeAccess_locState_in _ _ _ _ _ _ 0 b' rfl hb',
        nodeAccessRelatedness_anc rfl]
      rfl
    rw [show tree2 = applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0))
      (.reservedFrz false)) 2 .read r active1 .visitChildrenOfAccessed from rfl,
      applyTreeAccess_locState_in _ _ _ _ _ _ 0 b' rfl hb',
      nodeAccessRelatedness_anc rfl]
    show (match performTransition .read .localAccess _
      ((insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)).locState 0 b')
      with | some st' => st' | none => _) = _
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (by decide), h1]
    rfl
  have hRelNoUB : releaseProtectorNoUB tree2 1 active1 := by
    intro n b' hPres hAcc
    have hb' := hAcc1 b' hAcc
    have h1 := hLoc1In b' hb'
    simp only [tree2, retagChild, applyTreeAccess, insertChildNode, tree1, rootTree,
      Bool.or_eq_true, decide_eq_true_eq] at hPres
    rcases hPres with rfl | rfl | rfl
    · rw [nodeAccessRelatedness_skip_foreign rfl rfl]
      show (performTransition (tree2.locState 1 b').perm.associatedAccess .foreignAccess
        (tree2.isTagProtected 2 active1) (tree2.locState 2 b')).isSome = true
      rw [h1, hLoc2In b' hb']
      rfl
    · rw [nodeAccessRelatedness_anc rfl]
      show (performTransition (tree2.locState 1 b').perm.associatedAccess .localAccess
        (tree2.isTagProtected 1 active1) (tree2.locState 1 b')).isSome = true
      rw [h1]
      rfl
    · rw [nodeAccessRelatedness_anc rfl]
      show (performTransition (tree2.locState 1 b').perm.associatedAccess .localAccess
        (tree2.isTagProtected 0 active1) (tree2.locState 0 b')).isSome = true
      rw [h1, hLoc0In b' hb']
      rfl
  refine ⟨hNoUB1, hNoUB2, hRelNoUB, ?_, hLoc2In b hb⟩
  have hAccB : (tree2.locState 1 b).accessed = true := by rw [hLoc1In b hb]
  rw [applyReleaseProtector_locState_acc tree2 1 active1 2 b rfl hAccB,
    nodeAccessRelatedness_skip_foreign rfl rfl]
  show (match performTransition (tree2.locState 1 b).perm.associatedAccess .foreignAccess
    (tree2.isTagProtected 2 active1) (tree2.locState 2 b) with | some st' => st' | none => _) = _
  rw [hLoc1In b hb, hLoc2In b hb]
  have hProt2 : tree2.isTagProtected 2 active1 = true := rfl
  rw [hProt2]
  rfl

/-! #### Conflict latches of unprotected tags are semantically inert

The state difference exhibited by `stage1_vs_stage2Only_two_arg_release_differs` is a
`ReservedFrz` conflict latch.  `LatchEquiv` relates trees that differ at most in the
latches of tags that are unprotected; it is preserved by every tree operation of the
model (accesses, retags, stage-1 release, call-id changes) and never changes a UB
verdict, so such a difference is unobservable. -/

/-- Erase the `ReservedFrz` conflict latch. -/
def LocationState.eraseLatch (st : LocationState) : LocationState :=
  match st.perm with
  | .reservedFrz _ => ⟨.reservedFrz false, st.accessed⟩
  | _ => st

theorem LocationState.eraseLatch_accessed (st : LocationState) :
    st.eraseLatch.accessed = st.accessed := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;> rfl

theorem LocationState.eraseLatch_associatedAccess (st : LocationState) :
    st.eraseLatch.perm.associatedAccess = st.perm.associatedAccess := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;> rfl

theorem LocationState.ne_active_of_eraseLatch_eq {st st' : LocationState}
    (h : st.eraseLatch = st'.eraseLatch) (h' : st'.perm ≠ .active) : st.perm ≠ .active := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;> rcases st' with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;>
    first
    | exact fun h₀ => Permission.noConfusion h₀
    | exact absurd rfl h'
    | exact absurd (congrArg LocationState.perm h) (fun h₀ => Permission.noConfusion h₀)

/-- **Per-location latch inertness**: on an unprotected location the conflict latch
changes neither the UB verdict nor the successor state (up to the latch). -/
theorem performTransition_unprotected_eraseLatch (kind : AccessKind) (rel : AccessRelatedness)
    (st : LocationState) :
    (performTransition kind rel false st).map LocationState.eraseLatch =
      (performTransition kind rel false st.eraseLatch).map LocationState.eraseLatch := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;> cases kind <;> cases rel <;> rfl

theorem performTransition_unprotected_isSome_eraseLatch (kind : AccessKind)
    (rel : AccessRelatedness) (st : LocationState) :
    (performTransition kind rel false st).isSome =
      (performTransition kind rel false st.eraseLatch).isSome := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _⟩ <;> cases kind <;> cases rel <;> rfl

theorem eraseLatch_update_unprotected (kind : AccessKind) (rel : AccessRelatedness)
    {st₁ st₂ : LocationState} (h : st₁.eraseLatch = st₂.eraseLatch) :
    (match performTransition kind rel false st₁ with
      | some st' => st' | none => st₁).eraseLatch =
    (match performTransition kind rel false st₂ with
      | some st' => st' | none => st₂).eraseLatch := by
  have hmap : (performTransition kind rel false st₁).map LocationState.eraseLatch =
      (performTransition kind rel false st₂).map LocationState.eraseLatch := by
    rw [performTransition_unprotected_eraseLatch kind rel st₁, h,
      ← performTransition_unprotected_eraseLatch kind rel st₂]
  cases h₁ : performTransition kind rel false st₁ with
  | none =>
    cases h₂ : performTransition kind rel false st₂ with
    | none => exact h
    | some b => rw [h₁, h₂] at hmap; cases hmap
  | some a =>
    cases h₂ : performTransition kind rel false st₂ with
    | none => rw [h₁, h₂] at hmap; cases hmap
    | some b => rw [h₁, h₂] at hmap; exact Option.some.inj hmap

theorem nodeAccessRelatedness_congr {t₁ t₂ : BorrowTree} (h : t₁.isAnc = t₂.isAnc)
    (start : BorTag) (mode : ChildrenVisitMode) (n : BorTag) :
    nodeAccessRelatedness t₁ start mode n = nodeAccessRelatedness t₂ start mode n := by
  unfold nodeAccessRelatedness
  rw [h]

theorem isTagProtected_congr {t₁ t₂ : BorrowTree} (h : t₁.protector = t₂.protector)
    (n : BorTag) (active : ActiveProtectors) :
    t₁.isTagProtected n active = t₂.isTagProtected n active := by
  unfold BorrowTree.isTagProtected
  rw [h]

theorem applyTreeAccess_locState_absent (tree : BorrowTree) (start : BorTag) (kind : AccessKind)
    (range : ByteRange) (active : ActiveProtectors) (mode : ChildrenVisitMode) (n : BorTag)
    (b : Nat) (h : tree.present n = false) :
    (applyTreeAccess tree start kind range active mode).locState n b = tree.locState n b := by
  simp only [applyTreeAccess, h, Bool.false_and, Bool.false_eq_true, ↓reduceIte]

theorem applyReleaseProtector_locState_absent (tree : BorrowTree) (t_rel : BorTag)
    (active : ActiveProtectors) (n : BorTag) (b : Nat) (h : tree.present n = false) :
    (applyReleaseProtector tree t_rel active).locState n b = tree.locState n b := by
  simp only [applyReleaseProtector, h, Bool.false_and, Bool.false_eq_true, ↓reduceIte]

/-- Trees that agree except possibly on the conflict latches of tags that are
unprotected under `active`. -/
structure LatchEquiv (t₁ t₂ : BorrowTree) (active : ActiveProtectors) : Prop where
  present_eq : t₁.present = t₂.present
  isAnc_eq : t₁.isAnc = t₂.isAnc
  protector_eq : t₁.protector = t₂.protector
  erase_eq : ∀ n b, (t₁.locState n b).eraseLatch = (t₂.locState n b).eraseLatch
  protected_eq : ∀ n b, t₁.isTagProtected n active = true → t₁.locState n b = t₂.locState n b

theorem LatchEquiv.refl (t : BorrowTree) (active : ActiveProtectors) : LatchEquiv t t active :=
  ⟨rfl, rfl, rfl, fun _ _ => rfl, fun _ _ _ => rfl⟩

theorem LatchEquiv.symm {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) : LatchEquiv t₂ t₁ active :=
  ⟨h.present_eq.symm, h.isAnc_eq.symm, h.protector_eq.symm, fun n b => (h.erase_eq n b).symm,
    fun n b hn => (h.protected_eq n b (by rwa [isTagProtected_congr h.protector_eq])).symm⟩

theorem LatchEquiv.trans {t₁ t₂ t₃ : BorrowTree} {active : ActiveProtectors}
    (h₁₂ : LatchEquiv t₁ t₂ active) (h₂₃ : LatchEquiv t₂ t₃ active) :
    LatchEquiv t₁ t₃ active :=
  ⟨h₁₂.present_eq.trans h₂₃.present_eq, h₁₂.isAnc_eq.trans h₂₃.isAnc_eq,
    h₁₂.protector_eq.trans h₂₃.protector_eq,
    fun n b => (h₁₂.erase_eq n b).trans (h₂₃.erase_eq n b),
    fun n b hn => (h₁₂.protected_eq n b hn).trans
      (h₂₃.protected_eq n b (by rwa [← isTagProtected_congr h₁₂.protector_eq]))⟩

/-- Fewer protected tags (e.g. `GlobalState.endCall`, or a fresh call id that no
existing tag uses) preserve the equivalence. -/
theorem LatchEquiv.of_active {t₁ t₂ : BorrowTree} {active active' : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active)
    (hact : ∀ n, t₁.isTagProtected n active' = true → t₁.isTagProtected n active = true) :
    LatchEquiv t₁ t₂ active' :=
  ⟨h.present_eq, h.isAnc_eq, h.protector_eq, h.erase_eq,
    fun n b hn => h.protected_eq n b (hact n hn)⟩

theorem LatchEquiv.transition_isSome {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (kind : AccessKind) (rel : AccessRelatedness) (n : BorTag)
    (b : Nat) :
    (performTransition kind rel (t₁.isTagProtected n active) (t₁.locState n b)).isSome =
      (performTransition kind rel (t₂.isTagProtected n active) (t₂.locState n b)).isSome := by
  rw [← isTagProtected_congr h.protector_eq]
  cases hp : t₁.isTagProtected n active with
  | true => rw [h.protected_eq n b hp]
  | false =>
    rw [performTransition_unprotected_isSome_eraseLatch kind rel (t₁.locState n b), h.erase_eq n b,
      ← performTransition_unprotected_isSome_eraseLatch kind rel (t₂.locState n b)]

/-- **Every access has the same UB verdict** on latch-equivalent trees. -/
theorem LatchEquiv.noUB_iff {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (start : BorTag) (kind : AccessKind) (range : ByteRange)
    (mode : ChildrenVisitMode) :
    TreeAccessNoUB t₁ start kind range active mode ↔
      TreeAccessNoUB t₂ start kind range active mode := by
  constructor
  · intro H n b hPres hb
    have H₁ := H n b (by rw [h.present_eq]; exact hPres) hb
    rw [nodeAccessRelatedness_congr h.isAnc_eq] at H₁
    revert H₁
    cases nodeAccessRelatedness t₂ start mode n with
    | none => exact fun _ => trivial
    | some rel =>
      intro H₁
      show (performTransition kind rel (t₂.isTagProtected n active) (t₂.locState n b)).isSome = true
      rw [← h.transition_isSome kind rel n b]
      exact H₁
  · intro H n b hPres hb
    have H₂ := H n b (by rw [← h.present_eq]; exact hPres) hb
    rw [← nodeAccessRelatedness_congr h.isAnc_eq] at H₂
    revert H₂
    cases nodeAccessRelatedness t₁ start mode n with
    | none => exact fun _ => trivial
    | some rel =>
      intro H₂
      show (performTransition kind rel (t₁.isTagProtected n active) (t₁.locState n b)).isSome = true
      rw [h.transition_isSome kind rel n b]
      exact H₂

/-- Accesses preserve latch equivalence. -/
theorem LatchEquiv.access {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (start : BorTag) (kind : AccessKind) (range : ByteRange)
    (mode : ChildrenVisitMode) :
    LatchEquiv (applyTreeAccess t₁ start kind range active mode)
      (applyTreeAccess t₂ start kind range active mode) active := by
  have hstep : ∀ n b, t₁.present n = true → range.contains b = true →
      (applyTreeAccess t₂ start kind range active mode).locState n b =
        match nodeAccessRelatedness t₁ start mode n with
        | some rel =>
          match performTransition kind rel (t₁.isTagProtected n active) (t₂.locState n b) with
          | some st' => st'
          | none => t₂.locState n b
        | none => t₂.locState n b := by
    intro n b hP hb
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ (by rw [← h.present_eq]; exact hP) hb,
      ← nodeAccessRelatedness_congr h.isAnc_eq, ← isTagProtected_congr h.protector_eq]
  refine ⟨h.present_eq, h.isAnc_eq, h.protector_eq, fun n b => ?_, fun n b hn => ?_⟩
  · cases hP : t₁.present n with
    | false =>
      rw [applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ hP,
        applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ (by rw [← h.present_eq]; exact hP)]
      exact h.erase_eq n b
    | true =>
      cases hb : range.contains b with
      | false =>
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
          applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb]
        exact h.erase_eq n b
      | true =>
        rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP hb, hstep n b hP hb]
        cases nodeAccessRelatedness t₁ start mode n with
        | none => exact h.erase_eq n b
        | some rel =>
          cases hx : t₁.isTagProtected n active with
          | true => rw [h.protected_eq n b hx]
          | false => exact eraseLatch_update_unprotected kind rel (h.erase_eq n b)
  · have hn' : t₁.isTagProtected n active = true := hn
    have hs := h.protected_eq n b hn'
    cases hP : t₁.present n with
    | false =>
      rw [applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ hP,
        applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ (by rw [← h.present_eq]; exact hP), hs]
    | true =>
      cases hb : range.contains b with
      | false =>
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
          applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb, hs]
      | true => rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP hb, hstep n b hP hb, hs]

/-- Inserting the same fresh node preserves latch equivalence. -/
theorem LatchEquiv.insert {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (t_parent t_child : BorTag) (prot : Option ProtectorKind)
    (initPerm : Permission) :
    LatchEquiv (insertChildNode t₁ t_parent t_child prot initPerm)
      (insertChildNode t₂ t_parent t_child prot initPerm) active := by
  refine ⟨?_, ?_, ?_, fun n b => ?_, fun n b hn => ?_⟩
  · show (fun t => decide (t = t_child) || t₁.present t) = (fun t => decide (t = t_child) || t₂.present t)
    rw [h.present_eq]
  · show (fun a d => if d = t_child then decide (a = t_child) || t₁.isAnc a t_parent
        else if a = t_child then false else t₁.isAnc a d) =
      (fun a d => if d = t_child then decide (a = t_child) || t₂.isAnc a t_parent
        else if a = t_child then false else t₂.isAnc a d)
    rw [h.isAnc_eq]
  · show (fun t => if t = t_child then prot else t₁.protector t) =
      (fun t => if t = t_child then prot else t₂.protector t)
    rw [h.protector_eq]
  · by_cases hc : n = t_child
    · rw [hc, insertChildNode_locState_child, insertChildNode_locState_child]
    · rw [insertChildNode_locState_of_ne _ _ _ _ _ hc, insertChildNode_locState_of_ne _ _ _ _ _ hc]
      exact h.erase_eq n b
  · by_cases hc : n = t_child
    · rw [hc, insertChildNode_locState_child, insertChildNode_locState_child]
    · rw [insertChildNode_locState_of_ne _ _ _ _ _ hc, insertChildNode_locState_of_ne _ _ _ _ _ hc]
      rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ hc] at hn
      exact h.protected_eq n b hn

/-- Retags preserve latch equivalence. -/
theorem LatchEquiv.retag {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (t_parent t_child : BorTag) (prot : Option ProtectorKind)
    (initPerm : Permission) (range : ByteRange) :
    LatchEquiv (retagChild t₁ t_parent t_child prot initPerm range active)
      (retagChild t₂ t_parent t_child prot initPerm range active) active :=
  (h.insert t_parent t_child prot initPerm).access t_child .read range
    .visitChildrenOfAccessed

theorem LatchEquiv.released_eq {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (t_rel : BorTag) (b : Nat) :
    (t₂.locState t_rel b).accessed = (t₁.locState t_rel b).accessed ∧
      (t₂.locState t_rel b).perm.associatedAccess = (t₁.locState t_rel b).perm.associatedAccess := by
  refine ⟨?_, ?_⟩
  · rw [← LocationState.eraseLatch_accessed (t₂.locState t_rel b), ← h.erase_eq t_rel b,
      LocationState.eraseLatch_accessed]
  · rw [← LocationState.eraseLatch_associatedAccess (t₂.locState t_rel b), ← h.erase_eq t_rel b,
      LocationState.eraseLatch_associatedAccess]

/-- Stage-1 release preserves latch equivalence. -/
theorem LatchEquiv.release {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (t_rel : BorTag) :
    LatchEquiv (applyReleaseProtector t₁ t_rel active)
      (applyReleaseProtector t₂ t_rel active) active := by
  have hstep : ∀ n b, t₁.present n = true → (t₁.locState t_rel b).accessed = true →
      (applyReleaseProtector t₂ t_rel active).locState n b =
        match nodeAccessRelatedness t₁ t_rel .skipChildrenOfAccessed n with
        | some rel =>
          match performTransition (t₁.locState t_rel b).perm.associatedAccess rel
              (t₁.isTagProtected n active) (t₂.locState n b) with
          | some st' => st'
          | none => t₂.locState n b
        | none => t₂.locState n b := by
    intro n b hP hA
    obtain ⟨hacc, hkind⟩ := h.released_eq t_rel b
    rw [applyReleaseProtector_locState_acc _ _ _ _ _ (by rw [← h.present_eq]; exact hP)
      (by rw [hacc]; exact hA), ← nodeAccessRelatedness_congr h.isAnc_eq,
      ← isTagProtected_congr h.protector_eq, hkind]
  have hunacc : ∀ n b, (t₁.locState t_rel b).accessed = false →
      (applyReleaseProtector t₂ t_rel active).locState n b = t₂.locState n b := by
    intro n b hA
    exact applyReleaseProtector_locState_unacc _ _ _ _ _
      (by rw [(h.released_eq t_rel b).1]; exact hA)
  refine ⟨h.present_eq, h.isAnc_eq, h.protector_eq, fun n b => ?_, fun n b hn => ?_⟩
  · cases hP : t₁.present n with
    | false =>
      rw [applyReleaseProtector_locState_absent _ _ _ _ _ hP,
        applyReleaseProtector_locState_absent _ _ _ _ _ (by rw [← h.present_eq]; exact hP)]
      exact h.erase_eq n b
    | true =>
      cases hA : (t₁.locState t_rel b).accessed with
      | false =>
        rw [applyReleaseProtector_locState_unacc _ _ _ _ _ hA, hunacc n b hA]
        exact h.erase_eq n b
      | true =>
        rw [applyReleaseProtector_locState_acc _ _ _ _ _ hP hA, hstep n b hP hA]
        cases nodeAccessRelatedness t₁ t_rel .skipChildrenOfAccessed n with
        | none => exact h.erase_eq n b
        | some rel =>
          cases hx : t₁.isTagProtected n active with
          | true => rw [h.protected_eq n b hx]
          | false => exact eraseLatch_update_unprotected _ rel (h.erase_eq n b)
  · have hn' : t₁.isTagProtected n active = true := hn
    have hs := h.protected_eq n b hn'
    cases hP : t₁.present n with
    | false =>
      rw [applyReleaseProtector_locState_absent _ _ _ _ _ hP,
        applyReleaseProtector_locState_absent _ _ _ _ _ (by rw [← h.present_eq]; exact hP), hs]
    | true =>
      cases hA : (t₁.locState t_rel b).accessed with
      | false => rw [applyReleaseProtector_locState_unacc _ _ _ _ _ hA, hunacc n b hA, hs]
      | true => rw [applyReleaseProtector_locState_acc _ _ _ _ _ hP hA, hstep n b hP hA, hs]

/-- Stage-1 release has the same UB verdict on latch-equivalent trees. -/
theorem LatchEquiv.releaseNoUB_iff {t₁ t₂ : BorrowTree} {active : ActiveProtectors}
    (h : LatchEquiv t₁ t₂ active) (t_rel : BorTag) :
    releaseProtectorNoUB t₁ t_rel active ↔ releaseProtectorNoUB t₂ t_rel active := by
  constructor
  · intro H n b hPres hA
    obtain ⟨hacc, hkind⟩ := h.released_eq t_rel b
    have H₁ := H n b (by rw [h.present_eq]; exact hPres) (by rw [← hacc]; exact hA)
    rw [nodeAccessRelatedness_congr h.isAnc_eq] at H₁
    revert H₁
    cases nodeAccessRelatedness t₂ t_rel .skipChildrenOfAccessed n with
    | none => exact fun _ => trivial
    | some rel =>
      intro H₁
      show (performTransition (t₂.locState t_rel b).perm.associatedAccess rel
        (t₂.isTagProtected n active) (t₂.locState n b)).isSome = true
      rw [hkind, ← h.transition_isSome _ rel n b]
      exact H₁
  · intro H n b hPres hA
    obtain ⟨hacc, hkind⟩ := h.released_eq t_rel b
    have H₂ := H n b (by rw [← h.present_eq]; exact hPres) (by rw [hacc]; exact hA)
    rw [← nodeAccessRelatedness_congr h.isAnc_eq] at H₂
    revert H₂
    cases nodeAccessRelatedness t₁ t_rel .skipChildrenOfAccessed n with
    | none => exact fun _ => trivial
    | some rel =>
      intro H₂
      show (performTransition (t₁.locState t_rel b).perm.associatedAccess rel
        (t₁.isTagProtected n active) (t₁.locState n b)).isSome = true
      rw [h.transition_isSome _ rel n b, ← hkind]
      exact H₂

theorem nodeAccessRelatedness_isAnc_of_local {tree : BorrowTree} {start n : BorTag}
    {mode : ChildrenVisitMode} (h : nodeAccessRelatedness tree start mode n = some .localAccess) :
    tree.isAnc n start = true := by
  cases hA : tree.isAnc n start with
  | true => rfl
  | false =>
    unfold nodeAccessRelatedness at h
    rw [ite_eq_right (by rw [hA]; exact Bool.false_ne_true)] at h
    cases mode with
    | visitChildrenOfAccessed => cases h
    | skipChildrenOfAccessed =>
      by_cases hd : tree.isAnc start n = true
      · rw [ite_eq_left hd] at h
        cases h
      · rw [ite_eq_right hd] at h
        cases h

theorem nodeAccessRelatedness_not_isAnc_of_foreign {tree : BorrowTree} {start n : BorTag}
    {mode : ChildrenVisitMode} (h : nodeAccessRelatedness tree start mode n = some .foreignAccess) :
    tree.isAnc n start = false := by
  cases hA : tree.isAnc n start with
  | false => rfl
  | true =>
    rw [nodeAccessRelatedness_anc hA] at h
    cases h

theorem Permission.associatedAccess_of_ne_active {p : Permission} (h : p ≠ .active) :
    p.associatedAccess = .read := by
  cases p <;> first | rfl | exact absurd rfl h

theorem eraseLatch_update_localRead (prot : Bool) {st : LocationState} (h : st.accessed = true) :
    (match performTransition .read .localAccess prot st with
      | some st' => st' | none => st).eraseLatch = st.eraseLatch := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> first | (cases prot <;> rfl) | cases h

theorem eraseLatch_update_foreignRead (prot : Bool) {st : LocationState} (h : st.perm ≠ .active) :
    (match performTransition .read .foreignAccess prot st with
      | some st' => st' | none => st).eraseLatch = st.eraseLatch := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> first | (cases prot <;> rfl) | exact absurd rfl h

theorem performTransition_update_accessed_mono (kind : AccessKind) (rel : AccessRelatedness)
    (prot : Bool) {st : LocationState} (h : st.accessed = true) :
    (match performTransition kind rel prot st with | some st' => st' | none => st).accessed = true := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases kind <;> cases rel <;> cases prot <;>
    first | rfl | cases h

theorem performTransition_update_read_ne_active (rel : AccessRelatedness) (prot : Bool)
    {st : LocationState} (h : st.perm ≠ .active) :
    (match performTransition .read rel prot st with | some st' => st' | none => st).perm ≠ .active := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases rel <;> cases prot <;>
    first | decide | exact absurd rfl h

/-- Accesses never clear the `accessed` flag. -/
theorem applyTreeAccess_accessed_mono (tree : BorrowTree) (start : BorTag) (kind : AccessKind)
    (range : ByteRange) (active : ActiveProtectors) (mode : ChildrenVisitMode) (n : BorTag)
    (b : Nat) (h : (tree.locState n b).accessed = true) :
    ((applyTreeAccess tree start kind range active mode).locState n b).accessed = true := by
  cases hP : tree.present n with
  | false => rw [applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ hP]; exact h
  | true =>
    cases hb : range.contains b with
    | false => rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb]; exact h
    | true =>
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP hb]
      cases nodeAccessRelatedness tree start mode n with
      | none => exact h
      | some rel => exact performTransition_update_accessed_mono kind rel _ h

/-- Read accesses never create `Active`. -/
theorem applyTreeAccess_read_ne_active (tree : BorrowTree) (start : BorTag) (range : ByteRange)
    (active : ActiveProtectors) (mode : ChildrenVisitMode) (n : BorTag) (b : Nat)
    (h : (tree.locState n b).perm ≠ .active) :
    ((applyTreeAccess tree start .read range active mode).locState n b).perm ≠ .active := by
  cases hP : tree.present n with
  | false => rw [applyTreeAccess_locState_absent _ _ _ _ _ _ _ _ hP]; exact h
  | true =>
    cases hb : range.contains b with
    | false => rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb]; exact h
    | true =>
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP hb]
      cases nodeAccessRelatedness tree start mode n with
      | none => exact h
      | some rel => exact performTransition_update_read_ne_active rel _ h

theorem nodeAccessRelatedness_skip_not_desc_of_foreign {tree : BorrowTree} {start n : BorTag}
    (h : nodeAccessRelatedness tree start .skipChildrenOfAccessed n = some .foreignAccess) :
    tree.isAnc start n = false := by
  cases hd : tree.isAnc start n with
  | false => rfl
  | true =>
    cases hA : tree.isAnc n start with
    | true => rw [nodeAccessRelatedness_anc hA] at h; cases h
    | false => rw [nodeAccessRelatedness_skip_desc hA hd] at h; cases h

/-- **A protector-end read only flips conflict latches**: if the released tag is not
`Active` where it is accessed (so the implicit access is a read), every local node is
already accessed there, and no foreign *non-descendant* node is `Active` there
(descendants are skipped by `ChildrenVisitMode.skipChildrenOfAccessed`), then stage-1
release changes every location only up to its conflict latch. -/
theorem applyReleaseProtector_read_eraseLatch {tree : BorrowTree} {t_rel : BorTag}
    {active : ActiveProtectors}
    (hRead : ∀ b, (tree.locState t_rel b).accessed = true → (tree.locState t_rel b).perm ≠ .active)
    (hLocal : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = true → (tree.locState n b).accessed = true)
    (hForeign : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = false → tree.isAnc t_rel n = false → (tree.locState n b).perm ≠ .active)
    (n : BorTag) (b : Nat) :
    ((applyReleaseProtector tree t_rel active).locState n b).eraseLatch =
      (tree.locState n b).eraseLatch := by
  cases hP : tree.present n with
  | false => rw [applyReleaseProtector_locState_absent _ _ _ _ _ hP]
  | true =>
    cases hA : (tree.locState t_rel b).accessed with
    | false => rw [applyReleaseProtector_locState_unacc _ _ _ _ _ hA]
    | true =>
      rw [applyReleaseProtector_locState_acc _ _ _ _ _ hP hA,
        Permission.associatedAccess_of_ne_active (hRead b hA)]
      cases hR : nodeAccessRelatedness tree t_rel .skipChildrenOfAccessed n with
      | none => rfl
      | some rel =>
        cases rel with
        | localAccess =>
          exact eraseLatch_update_localRead _
            (hLocal n b hP hA (nodeAccessRelatedness_isAnc_of_local hR))
        | foreignAccess =>
          exact eraseLatch_update_foreignRead _
            (hForeign n b hP hA (nodeAccessRelatedness_not_isAnc_of_foreign hR)
              (nodeAccessRelatedness_skip_not_desc_of_foreign hR))

/-- **The stage-1 / stage-2-only separation of
`stage1_vs_stage2Only_two_arg_release_differs` is unobservable**: after Miri's complete
stage-1 release (both protected arguments, in order) and `GlobalState.endCall`, the tree
is latch-equivalent to the stage-2-only tree under the post-call protector set, so every
later access, retag, or release has the same UB verdict (`LatchEquiv.noUB_iff`,
`LatchEquiv.access`, `LatchEquiv.retag`, `LatchEquiv.release`,
`LatchEquiv.releaseNoUB_iff`). -/
theorem stage1_vs_stage2Only_two_arg_release_unobservable (r : ByteRange) :
    let active1 := insertActiveProtector (fun _ => false) 0
    let tree1 := retagChild (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false) r active1
    let tree2 := retagChild tree1 0 2 (some (.strong 0)) (.reservedFrz false) r active1
    LatchEquiv (applyReleaseProtector (applyReleaseProtector tree2 1 active1) 2 active1) tree2
      (removeActiveProtector active1 0) := by
  intro active1 tree1 tree2
  have hPres : ∀ n, tree2.present n = true → n = 0 ∨ n = 1 ∨ n = 2 := by
    intro n hn
    simp only [tree2, tree1, retagChild, applyTreeAccess, insertChildNode, rootTree,
      Bool.or_eq_true, decide_eq_true_eq] at hn
    rcases hn with rfl | rfl | rfl
    · exact Or.inr (Or.inr rfl)
    · exact Or.inr (Or.inl rfl)
    · exact Or.inl rfl
  have hAcc0 : ∀ b, (tree2.locState 0 b).accessed = true := by
    intro b
    show ((applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)) 2 .read
      r active1 .visitChildrenOfAccessed).locState 0 b).accessed = true
    apply applyTreeAccess_accessed_mono
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (by decide : (0 : Nat) ≠ 2)]
    show ((applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false)) 1
      .read r active1 .visitChildrenOfAccessed).locState 0 b).accessed = true
    apply applyTreeAccess_accessed_mono
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (by decide : (0 : Nat) ≠ 1)]
    rfl
  have hNA1 : ∀ b, (tree2.locState 1 b).perm ≠ .active := by
    intro b
    show ((applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)) 2 .read
      r active1 .visitChildrenOfAccessed).locState 1 b).perm ≠ .active
    apply applyTreeAccess_read_ne_active
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (by decide : (1 : Nat) ≠ 2)]
    show ((applyTreeAccess (insertChildNode (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false)) 1
      .read r active1 .visitChildrenOfAccessed).locState 1 b).perm ≠ .active
    apply applyTreeAccess_read_ne_active
    rw [insertChildNode_locState_child]
    decide
  have hNA2 : ∀ b, (tree2.locState 2 b).perm ≠ .active := by
    intro b
    show ((applyTreeAccess (insertChildNode tree1 0 2 (some (.strong 0)) (.reservedFrz false)) 2 .read
      r active1 .visitChildrenOfAccessed).locState 2 b).perm ≠ .active
    apply applyTreeAccess_read_ne_active
    rw [insertChildNode_locState_child]
    decide
  have hE1 : ∀ n b, ((applyReleaseProtector tree2 1 active1).locState n b).eraseLatch =
      (tree2.locState n b).eraseLatch := by
    refine applyReleaseProtector_read_eraseLatch (fun b _ => hNA1 b) ?_ ?_
    · intro n b hP hA hAnc
      rcases hPres n hP with rfl | rfl | rfl
      · exact hAcc0 b
      · exact hA
      · exact absurd hAnc (Bool.ne_true_of_eq_false rfl)
    · intro n b hP _ hAnc _
      rcases hPres n hP with rfl | rfl | rfl
      · exact absurd hAnc (Bool.ne_false_of_eq_true rfl)
      · exact absurd hAnc (Bool.ne_false_of_eq_true rfl)
      · exact hNA2 b
  let tree3 := applyReleaseProtector tree2 1 active1
  have hAcc3 : ∀ n b, (tree3.locState n b).accessed = (tree2.locState n b).accessed := by
    intro n b
    rw [← LocationState.eraseLatch_accessed (tree3.locState n b), hE1 n b,
      LocationState.eraseLatch_accessed]
  have hE2 : ∀ n b, ((applyReleaseProtector tree3 2 active1).locState n b).eraseLatch =
      (tree3.locState n b).eraseLatch := by
    refine applyReleaseProtector_read_eraseLatch
      (fun b _ => LocationState.ne_active_of_eraseLatch_eq (hE1 2 b) (hNA2 b)) ?_ ?_
    · intro n b hP hA hAnc
      rcases hPres n hP with rfl | rfl | rfl
      · rw [hAcc3]; exact hAcc0 b
      · exact absurd hAnc (Bool.ne_true_of_eq_false rfl)
      · exact hA
    · intro n b hP _ hAnc _
      rcases hPres n hP with rfl | rfl | rfl
      · exact absurd hAnc (Bool.ne_false_of_eq_true rfl)
      · exact LocationState.ne_active_of_eraseLatch_eq (hE1 1 b) (hNA1 b)
      · exact absurd hAnc (Bool.ne_false_of_eq_true rfl)
  have hNoProt : ∀ n, (applyReleaseProtector tree3 2 active1).isTagProtected n
      (removeActiveProtector active1 0) = false := by
    intro n
    rw [show removeActiveProtector active1 0 = (fun _ => false) from removeActiveProtector_insert rfl]
    unfold BorrowTree.isTagProtected
    cases (applyReleaseProtector tree3 2 active1).protector n <;> rfl
  exact ⟨rfl, rfl, rfl, fun n b => (hE2 n b).trans (hE1 n b),
    fun n b hn => by rw [hNoProt n] at hn; cases hn⟩

/-- Consequence of `stage1_vs_stage2Only_two_arg_release_unobservable`: every later access
has the same UB verdict after stage-1 + stage-2 release as after stage-2-only release. -/
theorem stage1_vs_stage2Only_two_arg_release_same_verdicts (r : ByteRange) (start : BorTag)
    (kind : AccessKind) (range : ByteRange) (mode : ChildrenVisitMode) :
    let active1 := insertActiveProtector (fun _ => false) 0
    let tree1 := retagChild (rootTree 0) 0 1 (some (.strong 0)) (.reservedFrz false) r active1
    let tree2 := retagChild tree1 0 2 (some (.strong 0)) (.reservedFrz false) r active1
    TreeAccessNoUB (applyReleaseProtector (applyReleaseProtector tree2 1 active1) 2 active1) start
        kind range (removeActiveProtector active1 0) mode ↔
      TreeAccessNoUB tree2 start kind range (removeActiveProtector active1 0) mode :=
  (stage1_vs_stage2Only_two_arg_release_unobservable r).noUB_iff start kind range mode

theorem update_localRead_eq_self (prot : Bool) {st : LocationState} (h : st.accessed = true) :
    (match performTransition .read .localAccess prot st with
      | some st' => st' | none => st) = st := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> first | (cases prot <;> rfl) | cases h

theorem update_foreignRead_eq_self (prot : Bool) {st : LocationState} (h₁ : st.perm ≠ .active)
    (h₂ : st.perm ≠ .reservedFrz false) :
    (match performTransition .read .foreignAccess prot st with
      | some st' => st' | none => st) = st := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;>
    first | (cases prot <;> rfl) | exact absurd rfl h₁ | exact absurd rfl h₂

/-- **General read-release unobservability**: if the released tag is not
`Active` wherever it is accessed (so stage 1 is an implicit *read*), its ancestors are
already accessed there, no foreign *non-descendant* tag is `Active` there, and no foreign
non-descendant tag that stays protected after the call (`active'`) is an unconflicted
`ReservedFrz` there, then stage-1 release is latch-equivalent under `active'` to skipping
it.  All four conditions are automatically discharged for every UB-free `TrustedFnSpec`
execution by `trustedFnSpec_run_latchEquiv_stage2Only`. -/
theorem applyReleaseProtector_read_latchEquiv {tree : BorrowTree} {t_rel : BorTag}
    {active active' : ActiveProtectors}
    (hRead : ∀ b, (tree.locState t_rel b).accessed = true → (tree.locState t_rel b).perm ≠ .active)
    (hLocal : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = true → (tree.locState n b).accessed = true)
    (hForeign : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = false → tree.isAnc t_rel n = false → (tree.locState n b).perm ≠ .active)
    (hOutlive : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = false → tree.isAnc t_rel n = false →
      tree.isTagProtected n active' = true → (tree.locState n b).perm ≠ .reservedFrz false) :
    LatchEquiv (applyReleaseProtector tree t_rel active) tree active' := by
  refine ⟨rfl, rfl, rfl, applyReleaseProtector_read_eraseLatch hRead hLocal hForeign, ?_⟩
  intro n b hn
  have hn' : tree.isTagProtected n active' = true := hn
  cases hP : tree.present n with
  | false => exact applyReleaseProtector_locState_absent _ _ _ _ _ hP
  | true =>
    cases hA : (tree.locState t_rel b).accessed with
    | false => exact applyReleaseProtector_locState_unacc _ _ _ _ _ hA
    | true =>
      rw [applyReleaseProtector_locState_acc _ _ _ _ _ hP hA,
        Permission.associatedAccess_of_ne_active (hRead b hA)]
      cases hR : nodeAccessRelatedness tree t_rel .skipChildrenOfAccessed n with
      | none => rfl
      | some rel =>
        cases rel with
        | localAccess =>
          exact update_localRead_eq_self _
            (hLocal n b hP hA (nodeAccessRelatedness_isAnc_of_local hR))
        | foreignAccess =>
          have hNotAnc := nodeAccessRelatedness_not_isAnc_of_foreign hR
          have hNotDesc := nodeAccessRelatedness_skip_not_desc_of_foreign hR
          exact update_foreignRead_eq_self _ (hForeign n b hP hA hNotAnc hNotDesc)
            (hOutlive n b hP hA hNotAnc hNotDesc hn')

/-- Consequence of `applyReleaseProtector_read_latchEquiv`: under its side conditions,
every later access has the same UB verdict after stage-1 release as without it. -/
theorem applyReleaseProtector_read_same_verdicts {tree : BorrowTree} {t_rel : BorTag}
    {active active' : ActiveProtectors}
    (hRead : ∀ b, (tree.locState t_rel b).accessed = true → (tree.locState t_rel b).perm ≠ .active)
    (hLocal : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = true → (tree.locState n b).accessed = true)
    (hForeign : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = false → tree.isAnc t_rel n = false → (tree.locState n b).perm ≠ .active)
    (hOutlive : ∀ n b, tree.present n = true → (tree.locState t_rel b).accessed = true →
      tree.isAnc n t_rel = false → tree.isAnc t_rel n = false →
      tree.isTagProtected n active' = true → (tree.locState n b).perm ≠ .reservedFrz false)
    (start : BorTag) (kind : AccessKind) (range : ByteRange) (mode : ChildrenVisitMode) :
    TreeAccessNoUB (applyReleaseProtector tree t_rel active) start kind range active' mode ↔
      TreeAccessNoUB tree start kind range active' mode :=
  (applyReleaseProtector_read_latchEquiv hRead hLocal hForeign hOutlive).noUB_iff start kind range mode

/-- **Shared (`Mutability.not`) `reborrowFootprint` soundness**: when a
`TrustedFnSpec` declares two overlapping shared `&` reborrows `[(r, .not), (r, .not)]`,
both returned references emerge `Frozen` (`⟨.frozen, true⟩`) on `r`, reading
through the first preserves the second's `Frozen` permission (unlike overlapping
`&mut` in `overlapping_reborrowFootprint_write_disables_sibling`), and writes
through either reference fault with UB. -/
theorem shared_reborrowFootprint_read_ok_write_ub {tree0 : BorrowTree}
    {t_parent t_arg : BorTag} {argRange r : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId} {b : Nat}
    (hb : r.contains b = true) :
    let spec : TrustedFnSpec := ⟨argRange, [(r, .not), (r, .not)]⟩
    let out := spec.run tree0 activeCaller t_parent t_arg callId
    let tree_r1 := applyTreeAccess out.tree (t_arg + 1) .read r out.active .visitChildrenOfAccessed
    out.rets = [t_arg + 1, t_arg + 1 + 1] ∧
      out.tree.locState (t_arg + 1) b = ⟨.frozen, true⟩ ∧
      out.tree.locState (t_arg + 1 + 1) b = ⟨.frozen, true⟩ ∧
      tree_r1.locState (t_arg + 1 + 1) b = ⟨.frozen, true⟩ ∧
      ¬ TreeAccessNoUB out.tree (t_arg + 1) .write ⟨b, b + 1⟩ out.active .visitChildrenOfAccessed ∧
      ¬ TreeAccessNoUB tree_r1 (t_arg + 1 + 1) .write ⟨b, b + 1⟩ out.active .visitChildrenOfAccessed := by
  intro spec out tree_r1
  have hne10 : t_arg + 1 ≠ t_arg := Nat.succ_ne_self t_arg
  have hne21 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
  have hne20 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
  let active1 := insertActiveProtector activeCaller callId
  let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
    argRange active1
  let tree2 := retagChild tree1 t_arg (t_arg + 1) none (initPermOf .not) r active1
  let tree3 := retagChild tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not) r active1
  have hLPres2 : tree2.present (t_arg + 1) = true := by
    rw [retagChild_present, decide_eq_true rfl, Bool.true_or]
  have hLPres3 : tree3.present (t_arg + 1) = true := by
    rw [retagChild_present, hLPres2, Bool.or_true]
  have hRPres3 : tree3.present (t_arg + 1 + 1) = true := by
    rw [retagChild_present, decide_eq_true rfl, Bool.true_or]
  have hArgRefl1 : tree1.isAnc t_arg t_arg = true := by
    show (insertChildNode tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)).isAnc
      t_arg t_arg = true
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  have hArgAncL2 : tree2.isAnc t_arg (t_arg + 1) = true := by
    show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .not)).isAnc t_arg (t_arg + 1) = true
    rw [insertChildNode_isAnc_child, hArgRefl1, Bool.or_true]
  have hArgAncL3 : tree3.isAnc t_arg (t_arg + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc t_arg (t_arg + 1) = true
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hne21) (Ne.symm hne20)]
    exact hArgAncL2
  have hArgRefl2 : tree2.isAnc t_arg t_arg = true := by
    show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .not)).isAnc t_arg t_arg = true
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hne10) (Ne.symm hne10)]
    exact hArgRefl1
  have hArgAncR3 : tree3.isAnc t_arg (t_arg + 1 + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc
      t_arg (t_arg + 1 + 1) = true
    rw [insertChildNode_isAnc_child, hArgRefl2, Bool.or_true]
  have hLNotAncArg3 : tree3.isAnc (t_arg + 1) t_arg = false := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc
      (t_arg + 1) t_arg = false
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hne20) (Ne.symm hne21)]
    exact retag_not_desc_of_new (Ne.symm hne10)
  have hRNotAncArg3 : tree3.isAnc (t_arg + 1 + 1) t_arg = false :=
    retag_not_desc_of_new (Ne.symm hne20)
  have hLNotAncR : (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc
      (t_arg + 1) (t_arg + 1 + 1) = false := by
    rw [insertChildNode_isAnc_child, decide_eq_false (Ne.symm hne21), Bool.false_or]
    exact retag_not_desc_of_new (Ne.symm hne10)
  have hLProtI : (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isTagProtected
      (t_arg + 1) active1 = false := by
    rw [insertChildNode_isTagProtected_of_ne _ _ _ _ _ (Ne.symm hne21)]
    show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .not)).isTagProtected
      (t_arg + 1) active1 = false
    exact insertChildNode_isTagProtected_child_none _ _ _ _ _
  have hLLoc2 : tree2.locState (t_arg + 1) b = ⟨.frozen, true⟩ := by
    show (applyTreeAccess (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .not))
      (t_arg + 1) .read r active1 .visitChildrenOfAccessed).locState (t_arg + 1) b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _
      (by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or]) hb,
      nodeAccessRelatedness_anc (by rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]),
      insertChildNode_locState_child]
    rfl
  have hLLoc3 : tree3.locState (t_arg + 1) b = ⟨.frozen, true⟩ := by
    show (applyTreeAccess (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not))
      (t_arg + 1 + 1) .read r active1 .visitChildrenOfAccessed).locState (t_arg + 1) b = _
    rw [applyTreeAccess_locState_in (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not))
      _ _ _ _ _ _ _ hLPres3 hb,
      nodeAccessRelatedness_visit_foreign hLNotAncR]
    show (match performTransition .read .foreignAccess _ _ with | some st' => st' | none => _) = _
    rw [hLProtI, insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hne21), hLLoc2]
    rfl
  have hRLoc3 : tree3.locState (t_arg + 1 + 1) b = ⟨.frozen, true⟩ := by
    show (applyTreeAccess (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not))
      (t_arg + 1 + 1) .read r active1 .visitChildrenOfAccessed).locState (t_arg + 1 + 1) b = _
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _
      (by rw [insertChildNode_present, decide_eq_true rfl, Bool.true_or]) hb,
      nodeAccessRelatedness_anc (by rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]),
      insertChildNode_locState_child]
    rfl
  have hLLocPost : out.tree.locState (t_arg + 1) b = ⟨.frozen, true⟩ := by
    show (applyReleaseProtector tree3 t_arg active1).locState (t_arg + 1) b = _
    cases hAcc : (tree3.locState t_arg b).accessed with
    | false => rw [applyReleaseProtector_locState_unacc tree3 t_arg active1 _ b hAcc, hLLoc3]
    | true =>
      rw [applyReleaseProtector_locState_acc tree3 t_arg active1 _ b hLPres3 hAcc,
        nodeAccessRelatedness_skip_desc hLNotAncArg3 hArgAncL3, hLLoc3]
  have hRLocPost : out.tree.locState (t_arg + 1 + 1) b = ⟨.frozen, true⟩ := by
    show (applyReleaseProtector tree3 t_arg active1).locState (t_arg + 1 + 1) b = _
    cases hAcc : (tree3.locState t_arg b).accessed with
    | false => rw [applyReleaseProtector_locState_unacc tree3 t_arg active1 _ b hAcc, hRLoc3]
    | true =>
      rw [applyReleaseProtector_locState_acc tree3 t_arg active1 _ b hRPres3 hAcc,
        nodeAccessRelatedness_skip_desc hRNotAncArg3 hArgAncR3, hRLoc3]
  have hRNotAncL : out.tree.isAnc (t_arg + 1 + 1) (t_arg + 1) = false :=
    retag_not_desc_of_new (tree := tree2) (t_parent := t_arg) (t_child := t_arg + 1 + 1)
      (prot := none) (initPerm := initPermOf .not) (range := r) (active := active1) (Ne.symm hne21)
  have hRProt : out.tree.isTagProtected (t_arg + 1 + 1) out.active = false := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isTagProtected
      (t_arg + 1 + 1) out.active = false
    exact insertChildNode_isTagProtected_child_none _ _ _ _ _
  have hRLocR1 : tree_r1.locState (t_arg + 1 + 1) b = ⟨.frozen, true⟩ := by
    show (applyTreeAccess out.tree (t_arg + 1) .read r out.active
      .visitChildrenOfAccessed).locState (t_arg + 1 + 1) b = _
    rw [applyTreeAccess_locState_in out.tree _ _ _ _ _ _ _ hRPres3 hb,
      nodeAccessRelatedness_visit_foreign hRNotAncL]
    show (match performTransition .read .foreignAccess
      (out.tree.isTagProtected (t_arg + 1 + 1) out.active)
      (out.tree.locState (t_arg + 1 + 1) b) with | some st' => st' | none => _) = _
    rw [hRProt, hRLocPost]
    rfl
  have hInB : (ByteRange.mk b (b + 1)).contains b = true :=
    (ByteRange.contains_iff _ _).mpr ⟨Nat.le_refl b, Nat.lt_succ_self b⟩
  have hReflL : out.tree.isAnc (t_arg + 1) (t_arg + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc
      (t_arg + 1) (t_arg + 1) = true
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hne21) (Ne.symm hne21)]
    show (insertChildNode tree1 t_arg (t_arg + 1) none (initPermOf .not)).isAnc
      (t_arg + 1) (t_arg + 1) = true
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  have hReflR : tree_r1.isAnc (t_arg + 1 + 1) (t_arg + 1 + 1) = true := by
    show (insertChildNode tree2 t_arg (t_arg + 1 + 1) none (initPermOf .not)).isAnc
      (t_arg + 1 + 1) (t_arg + 1 + 1) = true
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  refine ⟨rfl, hLLocPost, hRLocPost, hRLocR1, ?_, ?_⟩
  · intro hNoUB
    have hAt := hNoUB (t_arg + 1) b hLPres3 hInB
    rw [nodeAccessRelatedness_anc hReflL] at hAt
    change (performTransition .write .localAccess _ (out.tree.locState (t_arg + 1) b)).isSome = true at hAt
    rw [hLLocPost] at hAt
    cases hAt
  · intro hNoUB
    have hAt := hNoUB (t_arg + 1 + 1) b hRPres3 hInB
    rw [nodeAccessRelatedness_anc hReflR] at hAt
    change (performTransition .write .localAccess _ (tree_r1.locState (t_arg + 1 + 1) b)).isSome = true at hAt
    rw [hRLocR1] at hAt
    cases hAt

/-- Reflexivity of the trusted `isBorrowDescendantOrSelf` hierarchy traversal. -/
theorem isBorrowDescendantOrSelf_refl
    (borrows : List Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) (tag : Nat) :
    Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelf borrows tag tag = true := by
  unfold Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelf
  cases Trusted.Sequence.length borrows with
  | zero => exact Nat.beq_refl tag
  | succ f =>
    unfold Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelfAux
    rw [Nat.beq_refl]

/-- **Trusted hierarchy relatedness bridge**: when `tree.isAnc e.tag wTag` agrees
with trusted `isBorrowDescendantOrSelf allBorrows wTag e.tag`, the model's
`nodeAccessRelatedness` under `.visitChildrenOfAccessed` equals the trusted
`treeBorrowWriterRelatedness` after `resolveTreeBorrowWriterTag`. -/
theorem nodeAccessRelatedness_visit_eq_live_writer (tree : BorrowTree)
    (allBorrows : List Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry)
    (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) (wTag : BorTag)
    (hAnc : tree.isAnc e.tag wTag =
      Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelf allBorrows wTag e.tag) :
    (nodeAccessRelatedness tree wTag .visitChildrenOfAccessed e.tag).map AccessRelatedness.toLive =
      some (Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowWriterRelatedness e
        (Trusted.Rustc.V2026_06_01.MirSemantics.resolveTreeBorrowWriterTag allBorrows e (some wTag))) := by
  unfold nodeAccessRelatedness
    Trusted.Rustc.V2026_06_01.MirSemantics.resolveTreeBorrowWriterTag
    Trusted.Rustc.V2026_06_01.MirSemantics.treeBorrowWriterRelatedness
  rw [hAnc]
  dsimp only
  cases hDesc : Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelf allBorrows wTag e.tag with
  | true =>
    dsimp only
    rw [Nat.beq_refl]
    rfl
  | false =>
    have hNe : Nat.beq e.tag wTag = false := by
      cases hb : Nat.beq e.tag wTag with
      | false => rfl
      | true =>
        have heq := Nat.eq_of_beq_eq_true hb
        rw [heq, isBorrowDescendantOrSelf_refl] at hDesc
        cases hDesc
    dsimp only
    rw [hNe]
    rfl

/-- **Trusted protected-write conflict bridge**: on any trusted `BorrowEntry` `e`
matching permission `p`, `borrowEntryWriteConflicts` after
`resolveTreeBorrowWriterTag` equals `!(performTransition .write rel true ⟨p, true⟩).isSome`. -/
theorem borrowEntryWriteConflicts_eq_live (tree : BorrowTree)
    (allBorrows : List Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry)
    (e : Trusted.Rustc.V2026_06_01.MirSemantics.BorrowEntry) (wTag : BorTag) (p : Permission)
    (hPerm : e.perm = p.toLiveTreeBorrowPerm)
    (hAnc : tree.isAnc e.tag wTag =
      Trusted.Rustc.V2026_06_01.MirSemantics.isBorrowDescendantOrSelf allBorrows wTag e.tag) :
    Trusted.Rustc.V2026_06_01.MirSemantics.borrowEntryWriteConflicts e
      (Trusted.Rustc.V2026_06_01.MirSemantics.resolveTreeBorrowWriterTag allBorrows e (some wTag)) =
      !(performTransition .write
        (if tree.isAnc e.tag wTag then .localAccess else .foreignAccess)
        true ⟨p, true⟩).isSome := by
  have hRel := nodeAccessRelatedness_visit_eq_live_writer tree allBorrows e wTag hAnc
  unfold nodeAccessRelatedness at hRel
  unfold Trusted.Rustc.V2026_06_01.MirSemantics.borrowEntryWriteConflicts
  rw [hPerm]
  cases hA : tree.isAnc e.tag wTag with
  | true =>
    rw [hA] at hRel
    simp only [↓reduceIte, Option.map, Option.some.injEq] at hRel ⊢
    rw [← hRel, performTransition_accessed_isSome_eq_live, Bool.not_not]
    rfl
  | false =>
    rw [hA] at hRel
    simp only [Bool.false_eq_true, ↓reduceIte, Option.map, Option.some.injEq] at hRel ⊢
    rw [← hRel, performTransition_accessed_isSome_eq_live, Bool.not_not]
    rfl

/-- **Trusted return-path protector bridge**: when `caller.callerProtector = none`
(as pushed by `pushCalleeFrame`), trusted `restoreCallerProtectors` equals
`removeActiveProtector (insertActiveProtector … callId) callId` for any fresh
callee protector `callId`. -/
theorem restoreCallerProtectors_eq_live
    (caller : Trusted.Rustc.V2026_06_01.MirSemantics.SavedCallerFrame)
    (hNoCallerProt : caller.callerProtector = none)
    (callId : CallId) (c : CallId)
    (hFresh : Trusted.Rustc.V2026_06_01.MirSemantics.natListContainsBool
      caller.calleeProtectors callId = false) :
    Trusted.Rustc.V2026_06_01.MirSemantics.natListContainsBool
      (Trusted.Rustc.V2026_06_01.MirSemantics.restoreCallerProtectors caller) c =
      removeActiveProtector
        (insertActiveProtector
          (Trusted.Rustc.V2026_06_01.MirSemantics.natListContainsBool caller.calleeProtectors)
          callId)
        callId c := by
  rw [removeActiveProtector_insert hFresh]
  unfold Trusted.Rustc.V2026_06_01.MirSemantics.restoreCallerProtectors
  rw [hNoCallerProt]

/-- **Observable post-return UB separation between Miri's stage-1 + stage-2
release and stage-2-only release under function-entry + LIFO protector
discipline**: on `rootTree 0`, a callee enters (`callId = 0`) with a protected
`&mut` argument `t_arg = 1` on `⟨0, 1⟩`, writes byte `0` through `t_arg`
(promoting `t_arg` to `Active` on byte `0`), and then reborrows an unprotected
sibling `t_sib = 2` from `0` on neighboring range `⟨1, 2⟩` before returning.
Every step in the callee and at return is UB-free, yet:
- under Miri's two-stage release (`applyReleaseProtector` + `endCall`),
  `t_arg`'s `Active` permission fires an implicit `AccessKind.write` at exit
  that disables `t_sib` on byte `0` (`⟨.disabled, false⟩`), so post-return
  caller reads and writes of byte `0` through `t_sib` fault with UB;
- under stage-2-only release (`removeActiveProtector` / `restoreCallerProtectors`
  without stage 1), `t_sib` remains `⟨.reservedFrz false, false⟩` on byte `0`,
  so the identical post-return caller reads and writes succeed UB-free. -/
theorem stage1_write_release_observable_ub_separation :
    let active0 : ActiveProtectors := fun _ => false
    let active1 := insertActiveProtector active0 0
    let r0 : ByteRange := ⟨0, 1⟩
    let r1 : ByteRange := ⟨1, 2⟩
    let tree0 := rootTree 0
    let tree1 := retagChild tree0 0 1 (some (.strong 0)) (.reservedFrz false) r0 active1
    let tree2 := applyTreeAccess tree1 1 .write r0 active1 .visitChildrenOfAccessed
    let tree3 := retagChild tree2 0 2 none (.reservedFrz false) r1 active1
    let activePost := removeActiveProtector active1 0
    let treeStage12 := applyReleaseProtector tree3 1 active1
    let treeStage2Only := tree3
    TreeAccessNoUB (insertChildNode tree0 0 1 (some (.strong 0)) (.reservedFrz false))
        1 .read r0 active1 .visitChildrenOfAccessed ∧
      TreeAccessNoUB tree1 1 .write r0 active1 .visitChildrenOfAccessed ∧
      TreeAccessNoUB (insertChildNode tree2 0 2 none (.reservedFrz false))
        2 .read r1 active1 .visitChildrenOfAccessed ∧
      releaseProtectorNoUB tree3 1 active1 ∧
      treeStage12.locState 2 0 = ⟨.disabled, false⟩ ∧
      treeStage2Only.locState 2 0 = ⟨.reservedFrz false, false⟩ ∧
      ¬ TreeAccessNoUB treeStage12 2 .read r0 activePost .visitChildrenOfAccessed ∧
      ¬ TreeAccessNoUB treeStage12 2 .write r0 activePost .visitChildrenOfAccessed ∧
      TreeAccessNoUB treeStage2Only 2 .read r0 activePost .visitChildrenOfAccessed ∧
      TreeAccessNoUB treeStage2Only 2 .write r0 activePost .visitChildrenOfAccessed := by
  intro active0 active1 r0 r1 tree0 tree1 tree2 tree3 activePost treeStage12 treeStage2Only
  have hb0 : ∀ b, r0.contains b = true → b = 0 := by
    intro b hb
    have h := (ByteRange.contains_iff r0 b).mp hb
    dsimp [r0] at h
    omega
  have hb1 : ∀ b, r1.contains b = true → b = 1 := by
    intro b hb
    have h := (ByteRange.contains_iff r1 b).mp hb
    dsimp [r1] at h
    omega
  have hPres1 : ∀ n, (insertChildNode tree0 0 1 (some (.strong 0)) (.reservedFrz false)).present n = true →
      n = 1 ∨ n = 0 := by
    intro n hn
    simp only [insertChildNode, tree0, rootTree, Bool.or_eq_true, decide_eq_true_eq] at hn
    exact hn
  have hPres2 : ∀ n, tree1.present n = true → n = 1 ∨ n = 0 := hPres1
  have hPres3I : ∀ n, (insertChildNode tree2 0 2 none (.reservedFrz false)).present n = true →
      n = 2 ∨ n = 1 ∨ n = 0 := by
    intro n hn
    simp only [insertChildNode, tree2, applyTreeAccess, tree1, retagChild, tree0, rootTree,
      Bool.or_eq_true, decide_eq_true_eq] at hn
    exact hn
  have hPres3 : ∀ n, tree3.present n = true → n = 2 ∨ n = 1 ∨ n = 0 := hPres3I
  have hAcc3 : ∀ b, (tree3.locState 1 b).accessed = true → b = 0 := by
    intro b hAcc
    by_cases hb : b = 0
    · exact hb
    · exfalso
      have hnr0 : r0.contains b = false := by
        cases hc : r0.contains b with
        | false => rfl
        | true => exact absurd (hb0 b hc) hb
      by_cases h1 : b = 1
      · subst h1
        cases hAcc
      · have hnr1 : r1.contains b = false := by
          cases hc : r1.contains b with
          | false => rfl
          | true => exact absurd (hb1 b hc) h1
        have h3 : tree3.locState 1 b = tree2.locState 1 b := by
          show (applyTreeAccess (insertChildNode tree2 0 2 none (.reservedFrz false)) 2 .read r1
            active1 .visitChildrenOfAccessed).locState 1 b = _
          rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hnr1,
            insertChildNode_locState_of_ne _ _ _ _ _ (by decide)]
        rw [h3] at hAcc
        have h2 : tree2.locState 1 b = tree1.locState 1 b :=
          applyTreeAccess_locState_out tree1 1 .write r0 active1 .visitChildrenOfAccessed 1 b hnr0
        rw [h2] at hAcc
        have h1' : tree1.locState 1 b = ⟨.reservedFrz false, false⟩ := by
          show (retagChild tree0 0 1 (some (.strong 0)) (.reservedFrz false) r0 active1).locState 1 b = _
          rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hnr0, insertChildNode_locState_child]
        rw [h1'] at hAcc
        cases hAcc
  refine ⟨?_, ?_, ?_, ?_, rfl, rfl, ?_, ?_, ?_, ?_⟩
  · intro n b hP hb
    have h := hb0 b hb; subst h
    rcases hPres1 n hP with rfl | rfl <;> rfl
  · intro n b hP hb
    have h := hb0 b hb; subst h
    rcases hPres2 n hP with rfl | rfl <;> rfl
  · intro n b hP hb
    have h := hb1 b hb; subst h
    rcases hPres3I n hP with rfl | rfl | rfl <;> rfl
  · intro n b hP hAcc
    have h := hAcc3 b hAcc; subst h
    rcases hPres3 n hP with rfl | rfl | rfl <;> rfl
  · intro hNoUB
    have h := hNoUB 2 0 rfl rfl
    cases h
  · intro hNoUB
    have h := hNoUB 2 0 rfl rfl
    cases h
  · intro n b hP hb
    have h := hb0 b hb; subst h
    rcases hPres3 n hP with rfl | rfl | rfl <;> rfl
  · intro n b hP hb
    have h := hb0 b hb; subst h
    rcases hPres3 n hP with rfl | rfl | rfl <;> rfl

/-- **Child reborrows remain sound under stage-2-only release even after the
callee activates `t_arg`**: unlike foreign sibling tags (which separate stage-1
from stage-2-only in `stage1_write_release_observable_ub_separation`), a child
`t_ret` reborrowed *under* `t_arg` after the callee writes through `t_arg` is a
descendant skipped by `ChildrenVisitMode.skipChildrenOfAccessed` and retains
`HasUniqueWritePerm` under stage-2-only `removeActiveProtector`. -/
theorem reborrow_return_after_parent_write_stage2Only_unique_write_perm {tree0 : BorrowTree}
    {t_parent t_arg t_ret : BorTag} {parentRange subRange : ByteRange}
    {activeCaller : ActiveProtectors} {callId : CallId}
    (hPerm0 : HasUniqueWritePerm tree0 t_parent parentRange activeCaller)
    (hSub : subRange.Sub parentRange)
    (hFreshArg : tree0.present t_arg = false) (hFreshRet : tree0.present t_ret = false)
    (hRetNeArg : t_ret ≠ t_arg)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let active1 := insertActiveProtector activeCaller callId
    let tree1 := retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      parentRange active1
    let tree2 := applyTreeAccess tree1 t_arg .write parentRange active1 .visitChildrenOfAccessed
    let tree3 := retagChild tree2 t_arg t_ret none (initPermOf .mut) subRange active1
    let active_post := removeActiveProtector active1 callId
    TreeAccessNoUB tree1 t_arg .write parentRange active1 .visitChildrenOfAccessed ∧
      HasUniqueWritePerm tree3 t_ret subRange active_post ∧
      TreeAccessNoUB tree3 t_ret .write subRange active_post .visitChildrenOfAccessed := by
  intro active1 tree1 tree2 tree3 active_post
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  have hTree1Perm : HasUniqueWritePerm tree1 t_arg parentRange active1 :=
    (retagChild_hasUniqueWritePerm (some (.strong callId)) fnEntry_writable hPerm0'
      (ByteRange.Sub.refl _) hFreshArg).2
  obtain ⟨hParentWriteNoUB, hTree2ArgPerm⟩ :=
    local_access_preserves_hasUniqueWritePerm .write hTree1Perm (ByteRange.Sub.refl _)
  have hFreshRet2 : tree2.present t_ret = false := by
    show tree1.present t_ret = false
    rw [retagChild_present, decide_eq_false hRetNeArg, Bool.false_or]
    exact hFreshRet
  have hTree3RetPerm : HasUniqueWritePerm tree3 t_ret subRange active1 :=
    (retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm hSub hFreshRet2).2
  have hPost : HasUniqueWritePerm tree3 t_ret subRange active_post :=
    hasUniqueWritePerm_remove_callId hCallFresh hTree3RetPerm
  exact ⟨hParentWriteNoUB, hPost,
    (local_access_preserves_hasUniqueWritePerm .write hPost (ByteRange.Sub.refl _)).1⟩

/-- **Descendant exclusion in `hForeign` is genuine**: on a 2-node tree where
child `1` under `t_rel = 0` is `Active` (violating A3's unguarded `isAnc n t_rel = false → perm ≠ .active`),
`ChildrenVisitMode.skipChildrenOfAccessed` skips `1` and `applyReleaseProtector_read_latchEquiv`
still establishes `LatchEquiv`. -/
theorem read_latchEquiv_ignores_active_descendant :
    let tree : BorrowTree :=
      { present := fun t => decide (t = 0) || decide (t = 1)
        isAnc := fun a d =>
          (decide (a = 0) && (decide (d = 0) || decide (d = 1))) || (decide (a = 1) && decide (d = 1))
        protector := fun _ => none
        locState := fun t _ => if t = 0 then ⟨.reservedFrz false, true⟩ else ⟨.active, true⟩ }
    let active : ActiveProtectors := fun _ => false
    (¬ ∀ n b, tree.present n = true → (tree.locState 0 b).accessed = true →
        tree.isAnc n 0 = false → (tree.locState n b).perm ≠ .active) ∧
      LatchEquiv (applyReleaseProtector tree 0 active) tree active := by
  intro tree active
  refine ⟨?_, ?_⟩
  · intro hOld
    exact hOld 1 0 rfl rfl rfl rfl
  · refine applyReleaseProtector_read_latchEquiv
      (fun _ _ h => nomatch h) ?_ ?_ (fun _ _ _ _ _ _ hn => by cases hn)
    · intro n b hP _ hAnc
      simp only [tree, Bool.or_eq_true, decide_eq_true_eq] at hP
      rcases hP with rfl | rfl
      · rfl
      · cases hAnc
    · intro n b hP _ hNotAnc hNotDesc
      simp only [tree, Bool.or_eq_true, decide_eq_true_eq] at hP
      rcases hP with rfl | rfl
      · cases hNotAnc
      · cases hNotDesc

/-- **Necessity of `hOutlive` in `applyReleaseProtector_read_latchEquiv`**: when
`hRead`, `hLocal`, and `hForeign` all hold, but a foreign sibling tag `2`
protected by an outliving caller protector (`0`) is still unconflicted
(`ReservedFrz false`) at an accessed byte of `t_rel = 1` (violating `hOutlive`),
stage-1 read release flips `2`'s latch to `ReservedFrz true`, making a subsequent
local write through `2` UB (`¬ TreeAccessNoUB`) under stage-1 release yet UB-free
(`TreeAccessNoUB`) without stage-1. -/
theorem stage1_read_release_outliving_unconflicted_separates :
    let active' : ActiveProtectors := insertActiveProtector (fun _ => false) 0
    let active : ActiveProtectors := insertActiveProtector active' 1
    let tree : BorrowTree :=
      { present := fun t => decide (t = 0) || decide (t = 1) || decide (t = 2)
        isAnc := fun a d =>
          (decide (a = 0) && (decide (d = 0) || decide (d = 1) || decide (d = 2))) ||
          (decide (a = 1) && decide (d = 1)) ||
          (decide (a = 2) && decide (d = 2))
        protector := fun t =>
          if t = 1 then some (.strong 1) else if t = 2 then some (.strong 0) else none
        locState := fun t b =>
          if b = 0 then
            if t = 0 then ⟨.active, true⟩ else ⟨.reservedFrz false, true⟩
          else ⟨.active, false⟩ }
    (∀ b, (tree.locState 1 b).accessed = true → (tree.locState 1 b).perm ≠ .active) ∧
      (∀ n b, tree.present n = true → (tree.locState 1 b).accessed = true →
        tree.isAnc n 1 = true → (tree.locState n b).accessed = true) ∧
      (∀ n b, tree.present n = true → (tree.locState 1 b).accessed = true →
        tree.isAnc n 1 = false → tree.isAnc 1 n = false → (tree.locState n b).perm ≠ .active) ∧
      releaseProtectorNoUB tree 1 active ∧
      ¬ TreeAccessNoUB (applyReleaseProtector tree 1 active) 2 .write ⟨0, 1⟩ active'
          .visitChildrenOfAccessed ∧
      TreeAccessNoUB tree 2 .write ⟨0, 1⟩ active' .visitChildrenOfAccessed := by
  intro active' active tree
  have hAcc0 : ∀ b, (tree.locState 1 b).accessed = true → b = 0 := by
    intro b hAcc
    by_cases hb : b = 0
    · exact hb
    · dsimp [tree] at hAcc
      rw [ite_eq_right hb] at hAcc
      cases hAcc
  have hPres : ∀ n, tree.present n = true → n = 0 ∨ n = 1 ∨ n = 2 := by
    intro n hn
    simp only [tree, Bool.or_eq_true, decide_eq_true_eq] at hn
    rcases hn with (rfl | rfl) | rfl
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
  have hb0 : ∀ b, (ByteRange.mk 0 1).contains b = true → b = 0 := by
    intro b hb
    have h := (ByteRange.contains_iff ⟨0, 1⟩ b).mp hb
    dsimp at h
    omega
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro b hAcc
    have h := hAcc0 b hAcc; subst h
    decide
  · intro n b hP hAcc hAnc
    have h := hAcc0 b hAcc; subst h
    rcases hPres n hP with rfl | rfl | rfl <;> first | rfl | cases hAnc
  · intro n b hP hAcc hNotAnc _
    have h := hAcc0 b hAcc; subst h
    rcases hPres n hP with rfl | rfl | rfl <;> first | decide | cases hNotAnc
  · intro n b hP hAcc
    have h := hAcc0 b hAcc; subst h
    rcases hPres n hP with rfl | rfl | rfl <;> rfl
  · intro hNoUB
    have h := hNoUB 2 0 rfl rfl
    cases h
  · intro n b hP hb
    have h := hb0 b hb; subst h
    rcases hPres n hP with rfl | rfl | rfl <;> rfl

theorem performTransition_localRead_accessed_of_isSome (prot : Bool) {st : LocationState}
    (h : (performTransition .read .localAccess prot st).isSome = true) :
    (match performTransition .read .localAccess prot st with | some st' => st' | none => st).accessed =
      true := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases prot <;> first | rfl | cases h

theorem performTransition_foreignRead_ne_active_of_isSome (prot : Bool) {st : LocationState}
    (h : (performTransition .read .foreignAccess prot st).isSome = true) :
    (match performTransition .read .foreignAccess prot st with | some st' => st' | none => st).perm ≠
      .active := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases prot <;> first | decide | cases h

theorem performTransition_foreignRead_protected_ne_unconflicted_of_isSome {st : LocationState}
    (h : (performTransition .read .foreignAccess true st).isSome = true) :
    (match performTransition .read .foreignAccess true st with | some st' => st' | none => st).perm ≠
      .reservedFrz false := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> first | decide | cases h

/-- Inductive invariant established by UB-free `FnEntry` retag and preserved by
every UB-free `reborrowFootprint` retag under `t_arg`, discharging all four side
conditions of `applyReleaseProtector_read_latchEquiv` under arbitrary outliving
caller protectors `activeCaller`. -/
structure ReadReleaseSafe (tree : BorrowTree) (t_arg : BorTag)
    (activeCaller : ActiveProtectors) : Prop where
  arg_present : tree.present t_arg = true
  arg_refl : tree.isAnc t_arg t_arg = true
  arg_ne_active : ∀ b, (tree.locState t_arg b).perm ≠ .active
  local_acc : ∀ n b, tree.present n = true → (tree.locState t_arg b).accessed = true →
    tree.isAnc n t_arg = true → (tree.locState n b).accessed = true
  foreign_ne_active : ∀ n b, tree.present n = true → (tree.locState t_arg b).accessed = true →
    tree.isAnc n t_arg = false → tree.isAnc t_arg n = false → (tree.locState n b).perm ≠ .active
  outlive_conflicted : ∀ n b, tree.present n = true → (tree.locState t_arg b).accessed = true →
    tree.isAnc n t_arg = false → tree.isAnc t_arg n = false →
    tree.isTagProtected n activeCaller = true → (tree.locState n b).perm ≠ .reservedFrz false

theorem readReleaseSafe_of_fnEntry {tree₀ : BorrowTree} {t_parent t_arg : BorTag}
    {argRange : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hEntryNoUB : TreeAccessNoUB
      (insertChildNode tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false))
      t_arg .read argRange (insertActiveProtector activeCaller callId) .visitChildrenOfAccessed) :
    ReadReleaseSafe
      (retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false) argRange
        (insertActiveProtector activeCaller callId))
      t_arg activeCaller := by
  let active₁ := insertActiveProtector activeCaller callId
  let treeI := insertChildNode tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
  have hRefl : treeI.isAnc t_arg t_arg = true := by
    rw [insertChildNode_isAnc_child, decide_eq_true rfl, Bool.true_or]
  have hAccIn : ∀ b, ((retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      argRange active₁).locState t_arg b).accessed = true → argRange.contains b = true := by
    intro b hAcc
    cases hb : argRange.contains b with
    | true => rfl
    | false =>
      rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hb, insertChildNode_locState_child] at hAcc
      cases hAcc
  refine ⟨?_, hRefl, ?_, ?_, ?_, ?_⟩
  · rw [retagChild_present, decide_eq_true rfl, Bool.true_or]
  · intro b
    apply applyTreeAccess_read_ne_active
    rw [insertChildNode_locState_child]
    decide
  · intro n b hP hAcc hAnc
    have hb := hAccIn b hAcc
    have hP' : treeI.present n = true := hP
    have hAnc' : treeI.isAnc n t_arg = true := hAnc
    have hSome := hEntryNoUB n b hP' hb
    rw [nodeAccessRelatedness_anc hAnc'] at hSome
    show ((applyTreeAccess treeI t_arg .read argRange active₁ .visitChildrenOfAccessed).locState n b).accessed = true
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_anc hAnc']
    exact performTransition_localRead_accessed_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc _
    have hb := hAccIn b hAcc
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hSome := hEntryNoUB n b hP' hb
    rw [nodeAccessRelatedness_visit_foreign hNotAnc'] at hSome
    show ((applyTreeAccess treeI t_arg .read argRange active₁ .visitChildrenOfAccessed).locState n b).perm ≠ .active
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_visit_foreign hNotAnc']
    exact performTransition_foreignRead_ne_active_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc _ hProtCaller
    have hb := hAccIn b hAcc
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hProt₁ : treeI.isTagProtected n active₁ = true :=
      isTagProtected_insert_of_caller hProtCaller
    have hSome := hEntryNoUB n b hP' hb
    rw [nodeAccessRelatedness_visit_foreign hNotAnc', hProt₁] at hSome
    show ((applyTreeAccess treeI t_arg .read argRange active₁ .visitChildrenOfAccessed).locState n b).perm ≠
      .reservedFrz false
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb,
      nodeAccessRelatedness_visit_foreign hNotAnc', hProt₁]
    exact performTransition_foreignRead_protected_ne_unconflicted_of_isSome hSome

theorem readReleaseSafe_retagChild {tree : BorrowTree} {t_arg next : BorTag}
    {m : Mutability} {r : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hSafe : ReadReleaseSafe tree t_arg activeCaller)
    (hNe : next ≠ t_arg)
    (hStepNoUB : TreeAccessNoUB (insertChildNode tree t_arg next none (initPermOf m))
      next .read r (insertActiveProtector activeCaller callId) .visitChildrenOfAccessed) :
    ReadReleaseSafe
      (retagChild tree t_arg next none (initPermOf m) r (insertActiveProtector activeCaller callId))
      t_arg activeCaller := by
  let active₁ := insertActiveProtector activeCaller callId
  let treeI := insertChildNode tree t_arg next none (initPermOf m)
  have hArgAncNext : treeI.isAnc t_arg next = true := by
    rw [insertChildNode_isAnc_child, hSafe.arg_refl, Bool.or_true]
  have hNextNotAncArg : treeI.isAnc next t_arg = false :=
    insertChildNode_isAnc_from_child _ _ _ _ _ (Ne.symm hNe)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [retagChild_present, hSafe.arg_present, Bool.or_true]
  · show treeI.isAnc t_arg t_arg = true
    rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) (Ne.symm hNe)]
    exact hSafe.arg_refl
  · intro b
    apply applyTreeAccess_read_ne_active
    rw [insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hNe)]
    exact hSafe.arg_ne_active b
  · intro n b hP hAcc hAnc
    have hP' : treeI.present n = true := hP
    have hAnc' : treeI.isAnc n t_arg = true := hAnc
    have hnNe : n ≠ next := by
      intro heq
      rw [heq, hNextNotAncArg] at hAnc'
      cases hAnc'
    have hAncOld : tree.isAnc n t_arg = true := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) hnNe] at hAnc'
    cases hb : r.contains b with
    | false =>
      have hAccOld : (tree.locState t_arg b).accessed = true := by
        change ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState t_arg b).accessed = true at hAcc
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
          insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hNe)] at hAcc
        exact hAcc
      have hPresOld : tree.present n = true := by
        rw [insertChildNode_present, decide_eq_false hnNe, Bool.false_or] at hP'
        exact hP'
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).accessed = true
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
        insertChildNode_locState_of_ne _ _ _ _ _ hnNe]
      exact hSafe.local_acc n b hPresOld hAccOld hAncOld
    | true =>
      have hAncNext : treeI.isAnc n next = true := by
        rw [insertChildNode_isAnc_child, hAncOld, Bool.or_true]
      have hSome := hStepNoUB n b hP' hb
      rw [nodeAccessRelatedness_anc hAncNext] at hSome
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).accessed = true
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_anc hAncNext]
      exact performTransition_localRead_accessed_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc hNotDesc
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hNotDesc' : treeI.isAnc t_arg n = false := hNotDesc
    have hnNe : n ≠ next := by
      intro heq
      rw [heq, hArgAncNext] at hNotDesc'
      cases hNotDesc'
    have hNotAncOld : tree.isAnc n t_arg = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) hnNe] at hNotAnc'
    have hNotDescOld : tree.isAnc t_arg n = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hnNe (Ne.symm hNe)] at hNotDesc'
    cases hb : r.contains b with
    | false =>
      have hAccOld : (tree.locState t_arg b).accessed = true := by
        change ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState t_arg b).accessed = true at hAcc
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
          insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hNe)] at hAcc
        exact hAcc
      have hPresOld : tree.present n = true := by
        rw [insertChildNode_present, decide_eq_false hnNe, Bool.false_or] at hP'
        exact hP'
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠ .active
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
        insertChildNode_locState_of_ne _ _ _ _ _ hnNe]
      exact hSafe.foreign_ne_active n b hPresOld hAccOld hNotAncOld hNotDescOld
    | true =>
      have hNotAncNext : treeI.isAnc n next = false := by
        rw [insertChildNode_isAnc_child, decide_eq_false hnNe, Bool.false_or]
        exact hNotAncOld
      have hSome := hStepNoUB n b hP' hb
      rw [nodeAccessRelatedness_visit_foreign hNotAncNext] at hSome
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠ .active
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb,
        nodeAccessRelatedness_visit_foreign hNotAncNext]
      exact performTransition_foreignRead_ne_active_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc hNotDesc hProtCaller
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hNotDesc' : treeI.isAnc t_arg n = false := hNotDesc
    have hnNe : n ≠ next := by
      intro heq
      rw [heq, hArgAncNext] at hNotDesc'
      cases hNotDesc'
    have hNotAncOld : tree.isAnc n t_arg = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) hnNe] at hNotAnc'
    have hNotDescOld : tree.isAnc t_arg n = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hnNe (Ne.symm hNe)] at hNotDesc'
    have hProtCallerI : treeI.isTagProtected n activeCaller = true := hProtCaller
    cases hb : r.contains b with
    | false =>
      have hAccOld : (tree.locState t_arg b).accessed = true := by
        change ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState t_arg b).accessed = true at hAcc
        rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
          insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hNe)] at hAcc
        exact hAcc
      have hPresOld : tree.present n = true := by
        rw [insertChildNode_present, decide_eq_false hnNe, Bool.false_or] at hP'
        exact hP'
      have hProtOld : tree.isTagProtected n activeCaller = true := by
        rwa [insertChildNode_isTagProtected_of_ne _ _ _ _ _ hnNe] at hProtCallerI
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠
        .reservedFrz false
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
        insertChildNode_locState_of_ne _ _ _ _ _ hnNe]
      exact hSafe.outlive_conflicted n b hPresOld hAccOld hNotAncOld hNotDescOld hProtOld
    | true =>
      have hNotAncNext : treeI.isAnc n next = false := by
        rw [insertChildNode_isAnc_child, decide_eq_false hnNe, Bool.false_or]
        exact hNotAncOld
      have hProt₁ : treeI.isTagProtected n active₁ = true :=
        isTagProtected_insert_of_caller hProtCallerI
      have hSome := hStepNoUB n b hP' hb
      rw [nodeAccessRelatedness_visit_foreign hNotAncNext, hProt₁] at hSome
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠
        .reservedFrz false
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb,
        nodeAccessRelatedness_visit_foreign hNotAncNext, hProt₁]
      exact performTransition_foreignRead_protected_ne_unconflicted_of_isSome hSome

/-- Step-by-step UB-freedom of `applyFootprint`. -/
def ApplyFootprintNoUB (t_arg : BorTag) (active : ActiveProtectors) :
    BorrowTree → BorTag → List (ByteRange × Mutability) → Prop
  | _, _, [] => True
  | tree, next, (r, m) :: rest =>
    TreeAccessNoUB (insertChildNode tree t_arg next none (initPermOf m)) next .read r active
        .visitChildrenOfAccessed ∧
      ApplyFootprintNoUB t_arg active (retagChild tree t_arg next none (initPermOf m) r active)
        (next + 1) rest

/-- Pre-release UB-freedom of a `TrustedFnSpec` call (`FnEntry` retag plus all
`reborrowFootprint` retags). -/
def TrustedFnSpec.NoUB (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId) : Prop :=
  let active₁ := insertActiveProtector activeCaller callId
  TreeAccessNoUB (insertChildNode tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false))
      t_arg .read spec.argRange active₁ .visitChildrenOfAccessed ∧
    ApplyFootprintNoUB t_arg active₁
      (retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false) spec.argRange active₁)
      (t_arg + 1) spec.reborrowFootprint

theorem applyFootprint_preserves_readReleaseSafe {t_arg : BorTag}
    {activeCaller : ActiveProtectors} {callId : CallId} :
    ∀ (fps : List (ByteRange × Mutability)) (tree : BorrowTree) (next : BorTag),
      t_arg < next →
      ReadReleaseSafe tree t_arg activeCaller →
      ApplyFootprintNoUB t_arg (insertActiveProtector activeCaller callId) tree next fps →
      ReadReleaseSafe
        (applyFootprint t_arg (insertActiveProtector activeCaller callId) tree next fps).1
        t_arg activeCaller
  | [], _, _, _, hSafe, _ => hSafe
  | (r, m) :: rest, tree, next, hlt, hSafe, ⟨hStep, hRest⟩ =>
    applyFootprint_preserves_readReleaseSafe rest
      (retagChild tree t_arg next none (initPermOf m) r (insertActiveProtector activeCaller callId))
      (next + 1) (Nat.lt_succ_of_lt hlt)
      (readReleaseSafe_retagChild hSafe (Nat.ne_of_gt hlt) hStep) hRest

/-- **Mechanized LIFO discharge of `applyReleaseProtector_read_latchEquiv` for
every UB-free `TrustedFnSpec` call**: for *any* `BorrowTree` `tree₀`, *any*
outliving caller protector set `activeCaller` (`activeCaller callId = false`),
and *any* `spec : TrustedFnSpec` whose `FnEntry` and `reborrowFootprint` retags
are UB-free (`spec.NoUB`), Miri's two-stage `spec.run` and the trusted stage-2-only
`spec.runStage2Only` produce `LatchEquiv` post-call trees. -/
theorem trustedFnSpec_run_latchEquiv_stage2Only (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId)
    (hCallFresh : activeCaller callId = false)
    (hNoUB : spec.NoUB tree₀ activeCaller t_parent t_arg callId) :
    LatchEquiv
      (spec.run tree₀ activeCaller t_parent t_arg callId).tree
      (spec.runStage2Only tree₀ activeCaller t_parent t_arg callId).tree
      (spec.run tree₀ activeCaller t_parent t_arg callId).active := by
  obtain ⟨hEntry, hFp⟩ := hNoUB
  have hSafe := applyFootprint_preserves_readReleaseSafe spec.reborrowFootprint _ (t_arg + 1)
    (Nat.lt_succ_self t_arg) (readReleaseSafe_of_fnEntry hEntry) hFp
  show LatchEquiv (applyReleaseProtector _ t_arg _) _
    (removeActiveProtector (insertActiveProtector activeCaller callId) callId)
  rw [removeActiveProtector_insert hCallFresh]
  exact applyReleaseProtector_read_latchEquiv
    (fun b _ => hSafe.arg_ne_active b)
    hSafe.local_acc hSafe.foreign_ne_active hSafe.outlive_conflicted

/-- **Observational equivalence of `TrustedFnSpec.run` and `TrustedFnSpec.runStage2Only`
across all post-return accesses**: every subsequent read or write has the identical
`TreeAccessNoUB` verdict under Miri's two-stage release and under stage-2-only
`restoreCallerProtectors`. -/
theorem trustedFnSpec_run_stage2Only_same_verdicts (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId)
    (hCallFresh : activeCaller callId = false)
    (hNoUB : spec.NoUB tree₀ activeCaller t_parent t_arg callId)
    (start : BorTag) (kind : AccessKind) (range : ByteRange) (mode : ChildrenVisitMode) :
    TreeAccessNoUB (spec.run tree₀ activeCaller t_parent t_arg callId).tree start kind range
        (spec.run tree₀ activeCaller t_parent t_arg callId).active mode ↔
      TreeAccessNoUB (spec.runStage2Only tree₀ activeCaller t_parent t_arg callId).tree start kind range
        (spec.runStage2Only tree₀ activeCaller t_parent t_arg callId).active mode :=
  (trustedFnSpec_run_latchEquiv_stage2Only spec tree₀ activeCaller t_parent t_arg callId
    hCallFresh hNoUB).noUB_iff start kind range mode

theorem performTransition_localRead_ne_disabled_of_isSome (prot : Bool) {st : LocationState}
    (h : (performTransition .read .localAccess prot st).isSome = true) :
    (match performTransition .read .localAccess prot st with | some st' => st' | none => st).perm ≠
      .disabled := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases prot <;> first | decide | cases h

theorem performTransition_localRead_isSome_of_ne_disabled (prot : Bool) {st : LocationState}
    (h : st.perm ≠ .disabled) : (performTransition .read .localAccess prot st).isSome = true := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases prot <;> first | rfl | exact absurd rfl h

/-- Foreign reads are UB-idempotent: a location that survived a foreign read survives
another one under the same protector status. -/
theorem performTransition_foreignRead_isSome_idem (prot : Bool) {st : LocationState}
    (h : (performTransition .read .foreignAccess prot st).isSome = true) :
    (performTransition .read .foreignAccess prot
      (match performTransition .read .foreignAccess prot st with
        | some st' => st' | none => st)).isSome = true := by
  rcases st with ⟨(_ | _) | _ | _ | _ | _, _ | _⟩ <;> cases prot <;> first | rfl | cases h

/-- Release-read UB-freedom invariant: wherever `t_arg` is accessed, its
ancestors are not `Disabled` and every foreign non-descendant tag survives a foreign read
under the call's protector set `active₁`. -/
structure ReleaseReadable (tree : BorrowTree) (t_arg : BorTag) (active₁ : ActiveProtectors) :
    Prop where
  local_ne_disabled : ∀ n b, tree.present n = true → (tree.locState t_arg b).accessed = true →
    tree.isAnc n t_arg = true → (tree.locState n b).perm ≠ .disabled
  foreign_readable : ∀ n b, tree.present n = true → (tree.locState t_arg b).accessed = true →
    tree.isAnc n t_arg = false → tree.isAnc t_arg n = false →
    (performTransition .read .foreignAccess (tree.isTagProtected n active₁)
      (tree.locState n b)).isSome = true

theorem releaseReadable_of_fnEntry {tree₀ : BorrowTree} {t_parent t_arg : BorTag}
    {argRange : ByteRange} {activeCaller : ActiveProtectors} {callId : CallId}
    (hEntryNoUB : TreeAccessNoUB
      (insertChildNode tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false))
      t_arg .read argRange (insertActiveProtector activeCaller callId) .visitChildrenOfAccessed) :
    ReleaseReadable
      (retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false) argRange
        (insertActiveProtector activeCaller callId))
      t_arg (insertActiveProtector activeCaller callId) := by
  let active₁ := insertActiveProtector activeCaller callId
  let treeI := insertChildNode tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
  have hAccIn : ∀ b, ((retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      argRange active₁).locState t_arg b).accessed = true → argRange.contains b = true := by
    intro b hAcc
    cases hb : argRange.contains b with
    | true => rfl
    | false =>
      rw [retagChild_locState_out _ _ _ _ _ _ _ _ _ hb, insertChildNode_locState_child] at hAcc
      cases hAcc
  refine ⟨?_, ?_⟩
  · intro n b hP hAcc hAnc
    have hb := hAccIn b hAcc
    have hP' : treeI.present n = true := hP
    have hAnc' : treeI.isAnc n t_arg = true := hAnc
    have hSome := hEntryNoUB n b hP' hb
    rw [nodeAccessRelatedness_anc hAnc'] at hSome
    show ((applyTreeAccess treeI t_arg .read argRange active₁ .visitChildrenOfAccessed).locState n b).perm ≠
      .disabled
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_anc hAnc']
    exact performTransition_localRead_ne_disabled_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc _
    have hb := hAccIn b hAcc
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hSome := hEntryNoUB n b hP' hb
    rw [nodeAccessRelatedness_visit_foreign hNotAnc'] at hSome
    show (performTransition .read .foreignAccess (treeI.isTagProtected n active₁)
      ((applyTreeAccess treeI t_arg .read argRange active₁ .visitChildrenOfAccessed).locState n b)).isSome =
      true
    rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_visit_foreign hNotAnc']
    exact performTransition_foreignRead_isSome_idem _ hSome

theorem releaseReadable_retagChild {tree : BorrowTree} {t_arg next : BorTag}
    {m : Mutability} {r : ByteRange} {active₁ : ActiveProtectors}
    (hInv : ReleaseReadable tree t_arg active₁) (hArgRefl : tree.isAnc t_arg t_arg = true)
    (hNe : next ≠ t_arg)
    (hStepNoUB : TreeAccessNoUB (insertChildNode tree t_arg next none (initPermOf m))
      next .read r active₁ .visitChildrenOfAccessed) :
    ReleaseReadable (retagChild tree t_arg next none (initPermOf m) r active₁) t_arg active₁ := by
  let treeI := insertChildNode tree t_arg next none (initPermOf m)
  have hArgAncNext : treeI.isAnc t_arg next = true := by
    rw [insertChildNode_isAnc_child, hArgRefl, Bool.or_true]
  have hNextNotAncArg : treeI.isAnc next t_arg = false :=
    insertChildNode_isAnc_from_child _ _ _ _ _ (Ne.symm hNe)
  have hAccOld : ∀ b, r.contains b = false →
      ((retagChild tree t_arg next none (initPermOf m) r active₁).locState t_arg b).accessed = true →
      (tree.locState t_arg b).accessed = true := by
    intro b hb hAcc
    change ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState t_arg b).accessed =
      true at hAcc
    rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb,
      insertChildNode_locState_of_ne _ _ _ _ _ (Ne.symm hNe)] at hAcc
    exact hAcc
  refine ⟨?_, ?_⟩
  · intro n b hP hAcc hAnc
    have hP' : treeI.present n = true := hP
    have hAnc' : treeI.isAnc n t_arg = true := hAnc
    have hnNe : n ≠ next := by
      intro heq
      rw [heq, hNextNotAncArg] at hAnc'
      cases hAnc'
    have hAncOld : tree.isAnc n t_arg = true := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) hnNe] at hAnc'
    cases hb : r.contains b with
    | false =>
      have hPresOld : tree.present n = true := by
        rw [insertChildNode_present, decide_eq_false hnNe, Bool.false_or] at hP'
        exact hP'
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠
        .disabled
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb, insertChildNode_locState_of_ne _ _ _ _ _ hnNe]
      exact hInv.local_ne_disabled n b hPresOld (hAccOld b hb hAcc) hAncOld
    | true =>
      have hAncNext : treeI.isAnc n next = true := by
        rw [insertChildNode_isAnc_child, hAncOld, Bool.or_true]
      have hSome := hStepNoUB n b hP' hb
      rw [nodeAccessRelatedness_anc hAncNext] at hSome
      show ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b).perm ≠
        .disabled
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb, nodeAccessRelatedness_anc hAncNext]
      exact performTransition_localRead_ne_disabled_of_isSome _ hSome
  · intro n b hP hAcc hNotAnc hNotDesc
    have hP' : treeI.present n = true := hP
    have hNotAnc' : treeI.isAnc n t_arg = false := hNotAnc
    have hNotDesc' : treeI.isAnc t_arg n = false := hNotDesc
    have hnNe : n ≠ next := by
      intro heq
      rw [heq, hArgAncNext] at hNotDesc'
      cases hNotDesc'
    have hNotAncOld : tree.isAnc n t_arg = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm hNe) hnNe] at hNotAnc'
    have hNotDescOld : tree.isAnc t_arg n = false := by
      rwa [insertChildNode_isAnc_of_ne _ _ _ _ _ hnNe (Ne.symm hNe)] at hNotDesc'
    have hProtEq : treeI.isTagProtected n active₁ = tree.isTagProtected n active₁ :=
      insertChildNode_isTagProtected_of_ne _ _ _ _ _ hnNe active₁
    cases hb : r.contains b with
    | false =>
      have hPresOld : tree.present n = true := by
        rw [insertChildNode_present, decide_eq_false hnNe, Bool.false_or] at hP'
        exact hP'
      show (performTransition .read .foreignAccess (treeI.isTagProtected n active₁)
        ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b)).isSome =
        true
      rw [applyTreeAccess_locState_out _ _ _ _ _ _ _ _ hb, insertChildNode_locState_of_ne _ _ _ _ _ hnNe,
        hProtEq]
      exact hInv.foreign_readable n b hPresOld (hAccOld b hb hAcc) hNotAncOld hNotDescOld
    | true =>
      have hNotAncNext : treeI.isAnc n next = false := by
        rw [insertChildNode_isAnc_child, decide_eq_false hnNe, Bool.false_or]
        exact hNotAncOld
      have hSome := hStepNoUB n b hP' hb
      rw [nodeAccessRelatedness_visit_foreign hNotAncNext] at hSome
      show (performTransition .read .foreignAccess (treeI.isTagProtected n active₁)
        ((applyTreeAccess treeI next .read r active₁ .visitChildrenOfAccessed).locState n b)).isSome =
        true
      rw [applyTreeAccess_locState_in _ _ _ _ _ _ _ _ hP' hb,
        nodeAccessRelatedness_visit_foreign hNotAncNext]
      exact performTransition_foreignRead_isSome_idem _ hSome

theorem applyFootprint_preserves_releaseReadable {t_arg : BorTag} {active₁ : ActiveProtectors} :
    ∀ (fps : List (ByteRange × Mutability)) (tree : BorrowTree) (next : BorTag),
      t_arg < next → tree.isAnc t_arg t_arg = true →
      ReleaseReadable tree t_arg active₁ →
      ApplyFootprintNoUB t_arg active₁ tree next fps →
      ReleaseReadable (applyFootprint t_arg active₁ tree next fps).1 t_arg active₁
  | [], _, _, _, _, hInv, _ => hInv
  | (r, m) :: rest, tree, next, hlt, hRefl, hInv, ⟨hStep, hRest⟩ =>
    applyFootprint_preserves_releaseReadable rest
      (retagChild tree t_arg next none (initPermOf m) r active₁) (next + 1) (Nat.lt_succ_of_lt hlt)
      (by
        show (insertChildNode tree t_arg next none (initPermOf m)).isAnc t_arg t_arg = true
        rw [insertChildNode_isAnc_of_ne _ _ _ _ _ (Ne.symm (Nat.ne_of_gt hlt))
          (Ne.symm (Nat.ne_of_gt hlt))]
        exact hRefl)
      (releaseReadable_retagChild hInv hRefl (Nat.ne_of_gt hlt) hStep) hRest

/-- The two invariants together make a stage-1 release UB-free. -/
theorem releaseProtectorNoUB_of_readReleaseSafe {tree : BorrowTree} {t_arg : BorTag}
    {activeCaller active₁ : ActiveProtectors} (hSafe : ReadReleaseSafe tree t_arg activeCaller)
    (hInv : ReleaseReadable tree t_arg active₁) : releaseProtectorNoUB tree t_arg active₁ := by
  intro n b hP hA
  rw [Permission.associatedAccess_of_ne_active (hSafe.arg_ne_active b)]
  cases hR : nodeAccessRelatedness tree t_arg .skipChildrenOfAccessed n with
  | none => trivial
  | some rel =>
    cases rel with
    | localAccess =>
      exact performTransition_localRead_isSome_of_ne_disabled _
        (hInv.local_ne_disabled n b hP hA (nodeAccessRelatedness_isAnc_of_local hR))
    | foreignAccess =>
      exact hInv.foreign_readable n b hP hA (nodeAccessRelatedness_not_isAnc_of_foreign hR)
        (nodeAccessRelatedness_skip_not_desc_of_foreign hR)

/-- **The stage-1 release of every UB-free `TrustedFnSpec` call is itself UB-free**.
Without this, `trustedFnSpec_run_latchEquiv_stage2Only` would leave open that
Miri's two-stage return reports UB at the release itself while the stage-2-only return
continues; with it, the two returns agree on every step, including the return. -/
theorem trustedFnSpec_release_noUB (spec : TrustedFnSpec) (tree₀ : BorrowTree)
    (activeCaller : ActiveProtectors) (t_parent t_arg : BorTag) (callId : CallId)
    (hNoUB : spec.NoUB tree₀ activeCaller t_parent t_arg callId) :
    releaseProtectorNoUB
      (applyFootprint t_arg (insertActiveProtector activeCaller callId)
        (retagChild tree₀ t_parent t_arg (some (.strong callId)) (.reservedFrz false) spec.argRange
          (insertActiveProtector activeCaller callId))
        (t_arg + 1) spec.reborrowFootprint).1
      t_arg (insertActiveProtector activeCaller callId) := by
  obtain ⟨hEntry, hFp⟩ := hNoUB
  have hSafe0 := readReleaseSafe_of_fnEntry hEntry
  exact releaseProtectorNoUB_of_readReleaseSafe
    (applyFootprint_preserves_readReleaseSafe spec.reborrowFootprint _ (t_arg + 1)
      (Nat.lt_succ_self t_arg) hSafe0 hFp)
    (applyFootprint_preserves_releaseReadable spec.reborrowFootprint _ (t_arg + 1)
      (Nat.lt_succ_self t_arg) hSafe0.arg_refl (releaseReadable_of_fnEntry hEntry) hFp)

/-- **Concrete MIR callee execution under the trusted stage-2-only return path**
(`restoreCallerProtectors`, without stage-1 `applyReleaseProtector`). -/
inductive ConcreteCallStage2Only (tree₀ : BorrowTree) (activeCaller : ActiveProtectors)
    (t_parent t_arg : BorTag) (argRange : ByteRange) (callId : CallId) (body : List CalleeOp)
    (retRegs : List Nat) : CallOutcome → Prop
  | mk {stEnd : CalleeState} {rets : List BorTag}
      (hfresh : tree₀.present t_arg = false)
      (hentry : TreeAccessNoUB (insertChildNode tree₀ t_parent t_arg (some (.strong callId))
        (.reservedFrz false)) t_arg .read argRange (insertActiveProtector activeCaller callId)
        .visitChildrenOfAccessed)
      (hrun : CalleeRun (insertActiveProtector activeCaller callId)
        (calleeEntryState tree₀ activeCaller t_parent t_arg argRange callId) body stEnd)
      (hrets : collectRegs stEnd.regs retRegs = some rets) :
      ConcreteCallStage2Only tree₀ activeCaller t_parent t_arg argRange callId body retRegs
        ⟨stEnd.tree, removeActiveProtector (insertActiveProtector activeCaller callId) callId, rets⟩

/-- **Stage-2-only concrete/declarative equivalence and `LatchEquiv` to two-stage
`ConcreteCall`**: for both `split_at_mut` and `get_mut`, `ConcreteCallStage2Only`
succeeds with `TrustedFnSpec.runStage2Only`, determines it uniquely, and is
`LatchEquiv` to Miri's two-stage `TrustedFnSpec.run`. -/
theorem trustedSpec_stage2Only_reborrow_equivalence {tree0 : BorrowTree} {t_parent t_arg : BorTag}
    {base mid len off sz : Nat} {activeCaller : ActiveProtectors} {callId : CallId}
    (hmid : mid ≤ len) (hsub : base ≤ off ∧ off + sz ≤ base + len)
    (hPerm0 : HasUniqueWritePerm tree0 t_parent (wholeRange base len) activeCaller)
    (hFresh : ∀ t, t_arg ≤ t → tree0.present t = false)
    (hFreshCallId : ∀ n, tree0.present n = true → ∀ p, tree0.protector n = some p → p.callId ≠ callId)
    (hCallFresh : activeCaller callId = false) :
    let splitS2 := (splitAtMutSpec base mid len).runStage2Only tree0 activeCaller t_parent t_arg callId
    let splitS12 := (splitAtMutSpec base mid len).run tree0 activeCaller t_parent t_arg callId
    let getS2 := (getMutSpec (wholeRange base len) off sz).runStage2Only tree0 activeCaller t_parent t_arg callId
    let getS12 := (getMutSpec (wholeRange base len) off sz).run tree0 activeCaller t_parent t_arg callId
    (ConcreteCallStage2Only tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (splitAtMutBody base mid len) [2, 3] splitS2 ∧
      ∀ out, ConcreteCallStage2Only tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (splitAtMutBody base mid len) [2, 3] out → out = splitS2) ∧
    (ConcreteCallStage2Only tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (getMutBody off sz) [1] getS2 ∧
      ∀ out, ConcreteCallStage2Only tree0 activeCaller t_parent t_arg (wholeRange base len) callId
        (getMutBody off sz) [1] out → out = getS2) ∧
    LatchEquiv splitS12.tree splitS2.tree splitS12.active ∧
    LatchEquiv getS12.tree getS2.tree getS12.active := by
  intro splitS2 splitS12 getS2 getS12
  have hFreshArg : tree0.present t_arg = false := hFresh t_arg (Nat.le_refl _)
  have hFreshL : tree0.present (t_arg + 1) = false := hFresh (t_arg + 1) (Nat.le_succ _)
  have hFreshR : tree0.present (t_arg + 1 + 1) = false :=
    hFresh (t_arg + 1 + 1) (Nat.le_succ_of_le (Nat.le_succ t_arg))
  have hne1 : t_arg + 1 ≠ t_arg := Nat.succ_ne_self t_arg
  have hne2 : t_arg + 1 + 1 ≠ t_arg := Nat.ne_of_gt (Nat.lt_succ_of_lt (Nat.lt_succ_self t_arg))
  have hne3 : t_arg + 1 + 1 ≠ t_arg + 1 := Nat.succ_ne_self (t_arg + 1)
  have hSubG : (ByteRange.mk off (off + sz)).Sub (wholeRange base len) := by
    intro b hb
    rw [ByteRange.contains_iff] at hb ⊢
    dsimp only at hb
    simp only [wholeRange]
    exact ⟨by omega, by omega⟩
  have hPerm0' := hasUniqueWritePerm_insert_fresh_callId hFreshCallId hPerm0
  obtain ⟨hEntryNoUB, hTree1Perm⟩ := retagChild_hasUniqueWritePerm (some (.strong callId))
    fnEntry_writable hPerm0' (ByteRange.Sub.refl (wholeRange base len)) hFreshArg
  have hFreshL1 : (retagChild tree0 t_parent t_arg (some (.strong callId)) (.reservedFrz false)
      (wholeRange base len) (insertActiveProtector activeCaller callId)).present (t_arg + 1) = false := by
    rw [retagChild_present, decide_eq_false hne1, Bool.false_or]; exact hFreshL
  obtain ⟨hNoUBL, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm
    (splitLeft_sub (base := base) hmid) hFreshL1
  obtain ⟨hNoUBG, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree1Perm
    hSubG hFreshL1
  have hTree2ArgPerm := retagUnprotectedChild_preserves_parent_hasUniqueWritePerm
    (childRange := splitLeft base mid) (initPerm := initPermOf .mut) hTree1Perm hFreshL1
  have hFreshR2 : (retagChild (retagChild tree0 t_parent t_arg (some (.strong callId))
      (.reservedFrz false) (wholeRange base len) (insertActiveProtector activeCaller callId))
      t_arg (t_arg + 1) none (initPermOf .mut) (splitLeft base mid)
      (insertActiveProtector activeCaller callId)).present (t_arg + 1 + 1) = false := by
    rw [retagChild_present, decide_eq_false hne3, Bool.false_or, retagChild_present,
      decide_eq_false hne2, Bool.false_or]
    exact hFreshR
  obtain ⟨hNoUBR, _⟩ := retagChild_hasUniqueWritePerm none initPermOf_mut_writable hTree2ArgPerm
    (splitRight_sub base mid len) hFreshR2
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩,
    trustedFnSpec_run_latchEquiv_stage2Only (splitAtMutSpec base mid len) tree0 activeCaller
      t_parent t_arg callId hCallFresh ⟨hEntryNoUB, hNoUBL, hNoUBR, trivial⟩,
    trustedFnSpec_run_latchEquiv_stage2Only (getMutSpec (wholeRange base len) off sz) tree0
      activeCaller t_parent t_arg callId hCallFresh ⟨hEntryNoUB, hNoUBG, trivial⟩⟩
  · exact ConcreteCallStage2Only.mk hFreshArg hEntryNoUB
      (CalleeRun.cons (CalleeStep.assertLe hmid)
        (CalleeRun.cons (CalleeStep.rawPtr rfl (show (1 : Nat) < 4 from by decide))
          (CalleeRun.cons (CalleeStep.reborrow rfl (show (2 : Nat) < 4 from by decide) hFreshL1 hNoUBL)
            (CalleeRun.cons (CalleeStep.reborrow rfl (show (3 : Nat) < 4 from by decide) hFreshR2 hNoUBR)
              CalleeRun.nil))))
      rfl
  · intro out hout
    cases hout with
    | mk _ _ hrun hrets =>
      cases hrun with
      | cons h1 hr1 =>
        cases h1 with
        | assertLe _ =>
          cases hr1 with
          | cons h2 hr2 =>
            cases h2 with
            | rawPtr hsrc2 _ =>
              simp only [calleeEntryState, List.getElem?_cons_zero, Option.some.injEq] at hsrc2
              subst hsrc2
              cases hr2 with
              | cons h3 hr3 =>
                cases h3 with
                | reborrow hsrc3 _ _ _ =>
                  simp only [calleeEntryState, List.set_cons_succ, List.set_cons_zero,
                    List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hsrc3
                  subst hsrc3
                  cases hr3 with
                  | cons h4 hr4 =>
                    cases h4 with
                    | reborrow hsrc4 _ _ _ =>
                      simp only [calleeEntryState, List.set_cons_succ, List.set_cons_zero,
                        List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hsrc4
                      subst hsrc4
                      cases hr4 with
                      | nil =>
                        simp only [calleeEntryState, collectRegs, List.set_cons_succ,
                          List.set_cons_zero, List.getElem?_cons_succ, List.getElem?_cons_zero,
                          Option.some.injEq] at hrets
                        subst hrets
                        rfl
  · exact ConcreteCallStage2Only.mk hFreshArg hEntryNoUB
      (CalleeRun.cons (CalleeStep.reborrow rfl (show (1 : Nat) < 4 from by decide) hFreshL1 hNoUBG)
        CalleeRun.nil) rfl
  · intro out hout
    cases hout with
    | mk _ _ hrun hrets =>
      cases hrun with
      | cons h1 hr1 =>
        cases h1 with
        | reborrow hsrc1 _ _ _ =>
          simp only [calleeEntryState, List.getElem?_cons_zero, Option.some.injEq] at hsrc1
          subst hsrc1
          cases hr1 with
          | nil =>
            simp only [calleeEntryState, collectRegs, List.set_cons_succ,
              List.set_cons_zero, List.getElem?_cons_succ, List.getElem?_cons_zero,
              Option.some.injEq] at hrets
            subst hrets
            rfl

end TreeBorrowsModel

/-! ## 6. Lens-State Entry & Single-Pass Lens-Lifting Combinators

`sepLensStateInv_single_root_borrow` is the entry combinator for stateful lens
proofs whose precondition fixes the borrow table to one parentless active root
entry for a caller-frame slot (the shape of `&mut T` arguments created by the
harness): it discharges `SepLensStateInv` for the singleton binding `[(rp, v)]`
from the entry's field values, via `ExclusiveActiveBorrow.toTree`, without
unfolding `lookupBorrow` at the call site. `LiftLensStmt.pureAssign_checked` /
`LiftLensStmt.pureAssign_uninit_checked` and `LiftLensBlockToJoin`
(`LiftLensBlockToJoin.toReturn`) provide single-pass statement lifting and
CPS join / `return`-block sharing across all `LiftLensBlock` terminators. -/

/-- `lookupBorrow` on a one-entry borrow table whose tag matches. -/
theorem lookupBorrow_singleton_of_tag {entry : BorrowEntry} {tag : Nat} (h_tag : entry.tag = tag) :
    lookupBorrow [entry] tag = .some entry := by
  show (match Nat.beq entry.tag tag with
    | true => some entry
    | false => lookupBorrow [] tag) = some entry
  rw [h_tag, Nat.beq_refl]

/-- **Single root-borrow entry**: a caller-frame slot `rp.allocId ≥ frameLen` holding
`v`, borrowed by exactly one parentless, whole-slot, active entry for `rp.tag`,
satisfies the lens-state invariant for the singleton binding `[(rp, v)]`. -/
theorem sepLensStateInv_single_root_borrow
    {frameLen : Nat} {rp : RawPtrVal} {v : Value} {m : Memory} {entry : BorrowEntry}
    (h_stack : m.callStack = []) (h_callee : m.activeCallee = .none)
    (h_borrows : m.borrows = [entry])
    (h_tag : entry.tag = rp.tag) (h_local : entry.targetLocal = rp.allocId)
    (h_proj : entry.targetProjection = []) (h_perm : entry.perm = .active)
    (h_rangeOff : entry.rangeOffset = 0) (h_rangeLen : entry.rangeLen = 0)
    (h_parent : entry.parentTag = .none)
    (h_off : rp.offset = 0) (h_frame : frameLen ≤ rp.allocId)
    (h_slot : get? m.callerLocals rp.allocId = .some (.init v)) :
    SepLensStateInv frameLen [(rp, v)] m := by
  have hLook : lookupBorrow m.borrows rp.tag = .some entry := by
    rw [h_borrows]
    exact lookupBorrow_singleton_of_tag h_tag
  have hExcl : ExclusiveActiveBorrow rp m :=
    { offset_zero := h_off
      lookup_active := ⟨entry, hLook, h_local, h_proj, h_perm, h_rangeOff, h_rangeLen⟩
      root_parent_none := fun e he => by
        rw [hLook] at he
        cases he
        exact h_parent
      exclusive_on_alloc := fun b hb _ => by
        rw [h_borrows] at hb
        cases List.mem_singleton.mp hb
        exact Or.inl ⟨h_tag, h_perm, h_proj, h_rangeOff, h_rangeLen⟩ }
  exact
    { callStack_nil := h_stack
      activeCallee_none := h_callee
      borrows_above_frame := fun b hb => by
        rw [h_borrows] at hb
        cases List.mem_singleton.mp hb
        rw [h_local]
        exact h_frame
      entries_valid := fun rp' v' hMem => by
        cases List.mem_singleton.mp hMem
        exact ⟨h_off, h_frame, h_slot, hExcl.toTree⟩
      pairwise_disjoint := List.Pairwise.cons (fun _ h => nomatch h) List.Pairwise.nil }

/-! ### Single-pass & join-sharing lens-lifting combinators

`LiftLensStmt.pureAssign_checked` computes the post-assignment environment with the
single-pass `setSpineChecked?` (instead of the two-pass
`(set? env loc s).bind forcePureEnv?`), and `LiftLensBlockToJoin`
(`LiftLensBlockToJoin.toReturn`) lifts a shared join or statement-free `return`
block once across all predecessors (`LiftLensBlock.goto_return` is the
single-predecessor shorthand). -/

/-- Single-pass form of `LiftPureAssign.mk` for a pure root-local assignment. -/
theorem LiftLensStmt.pureAssign_checked {localDecls : List LocalDecl} {layouts : LayoutTable}
    {env env₁ env₂ : PureEnv} {entries : List (RawPtrVal × Value)} {dst : Local}
    {rv : Rvalue} {val : Value} {oldSlot : LocalSlot} {span : String}
    (hRv : LiftLensRvalue localDecls layouts env entries rv val env₁)
    (hGet : get? env₁ dst = .some oldSlot) (hLive : oldSlot ≠ .dead)
    (hSet : setSpineChecked? env₁ dst (.init val) = .some env₂) :
    LiftLensStmt localDecls layouts env entries
      { kind := .assign { local_ := dst, projection := [] } rv, span := span } env₂ entries :=
  .pureAssign (.mk hRv hGet hLive (set?_of_setSpineChecked? hSet))

/-- `LiftLensStmt.pureAssign_checked` into a storage-live, not yet assigned slot. -/
theorem LiftLensStmt.pureAssign_uninit_checked {localDecls : List LocalDecl}
    {layouts : LayoutTable} {env env₁ env₂ : PureEnv} {entries : List (RawPtrVal × Value)}
    {dst : Local} {rv : Rvalue} {val : Value} {span : String}
    (hRv : LiftLensRvalue localDecls layouts env entries rv val env₁)
    (hGet : get? env₁ dst = .some .uninit)
    (hSet : setSpineChecked? env₁ dst (.init val) = .some env₂) :
    LiftLensStmt localDecls layouts env entries
      { kind := .assign { local_ := dst, projection := [] } rv, span := span } env₂ entries :=
  LiftLensStmt.pureAssign_checked hRv hGet (fun h => nomatch h) hSet

/-- Postcondition-parametric lens-state lifting from `bbIdx` to a shared join block
`joinBb` under invariant `JoinInv` (the stateful `SepLogicLenses` counterpart to
`MirLiftCore.LiftBlockToJoin`), so `joinBb` is lifted once across all predecessors. -/
def LiftLensBlockToJoin (body : CapturedMir) (bbIdx : BasicBlockIdx)
    (env : PureEnv) (entries : List (RawPtrVal × Value))
    (joinBb : BasicBlockIdx)
    (JoinInv : PureEnv → List (RawPtrVal × Value) → Prop) : Prop :=
  ∀ (retVal : Value) (entriesFinal : List (RawPtrVal × Value)),
    (∀ envJ entriesJ, JoinInv envJ entriesJ →
      LiftLensBlock body joinBb envJ entriesJ retVal entriesFinal) →
    LiftLensBlock body bbIdx env entries retVal entriesFinal

theorem LiftLensBlockToJoin.refl {body : CapturedMir} {joinBb : BasicBlockIdx}
    {env : PureEnv} {entries : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hInv : JoinInv env entries) :
    LiftLensBlockToJoin body joinBb env entries joinBb JoinInv :=
  fun _ _ k => k env entries hInv

theorem LiftLensBlockToJoin.trans {body : CapturedMir} {bb₀ bb₁ bb₂ : BasicBlockIdx}
    {env₀ : PureEnv} {entries₀ : List (RawPtrVal × Value)}
    {MidInv JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (h₁ : LiftLensBlockToJoin body bb₀ env₀ entries₀ bb₁ MidInv)
    (h₂ : ∀ env₁ entries₁, MidInv env₁ entries₁ →
      LiftLensBlockToJoin body bb₁ env₁ entries₁ bb₂ JoinInv) :
    LiftLensBlockToJoin body bb₀ env₀ entries₀ bb₂ JoinInv :=
  fun retVal entriesFinal k =>
    h₁ retVal entriesFinal fun env₁ entries₁ hMid =>
      h₂ env₁ entries₁ hMid retVal entriesFinal k

theorem LiftLensBlockToJoin.mono {body : CapturedMir} {bbIdx joinBb : BasicBlockIdx}
    {env : PureEnv} {entries : List (RawPtrVal × Value)}
    {Inv₁ Inv₂ : PureEnv → List (RawPtrVal × Value) → Prop}
    (hImp : ∀ e es, Inv₁ e es → Inv₂ e es)
    (h : LiftLensBlockToJoin body bbIdx env entries joinBb Inv₁) :
    LiftLensBlockToJoin body bbIdx env entries joinBb Inv₂ :=
  fun retVal entriesFinal k =>
    h retVal entriesFinal fun e es h₁ => k e es (hImp e es h₁)

theorem LiftLensBlockToJoin.goto {body : CapturedMir} {bbIdx target joinBb : BasicBlockIdx}
    {bb : BasicBlockData} {env env₁ : PureEnv}
    {entries entries₁ : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .goto target)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env₁ entries₁)
    (hNext : LiftLensBlockToJoin body target env₁ entries₁ joinBb JoinInv) :
    LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv :=
  fun retVal entriesFinal k => .goto hPhase hBb hTerm hStmts (hNext retVal entriesFinal k)

theorem LiftLensBlockToJoin.assert {body : CapturedMir} {bbIdx target joinBb : BasicBlockIdx}
    {bb : BasicBlockData} {cond : Operand} {expected : Bool} {unwind : UnwindAction}
    {env env₁ env₂ : PureEnv} {sc : ScalarInt}
    {entries entries₁ : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .assert cond expected target unwind)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env₁ entries₁)
    (hCond : LiftLensOperandAny .nil body.layouts env₁ entries₁ cond (.scalar sc) env₂)
    (hBit : sc.bits = assertBit expected)
    (hNext : LiftLensBlockToJoin body target env₂ entries₁ joinBb JoinInv) :
    LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv :=
  fun retVal entriesFinal k =>
    .assert hPhase hBb hTerm hStmts hCond hBit (hNext retVal entriesFinal k)

theorem LiftLensBlockToJoin.switchInt {body : CapturedMir} {bbIdx target joinBb : BasicBlockIdx}
    {bb : BasicBlockData} {discr : Operand} {targets : SwitchTargets}
    {env env₁ env₂ : PureEnv} {sc : ScalarInt}
    {entries entries₁ : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .switchInt discr targets)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env₁ entries₁)
    (hDiscr : LiftLensOperandAny .nil body.layouts env₁ entries₁ discr (.scalar sc) env₂)
    (hTarget : lookupSwitchTarget sc.bits targets.branches targets.otherwise = target)
    (hNext : LiftLensBlockToJoin body target env₂ entries₁ joinBb JoinInv) :
    LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv :=
  fun retVal entriesFinal k =>
    .switchInt hPhase hBb hTerm hStmts hDiscr hTarget (hNext retVal entriesFinal k)

theorem LiftLensBlockToJoin.drop_local {body : CapturedMir} {bbIdx target joinBb : BasicBlockIdx}
    {bb : BasicBlockData} {loc : Local} {unwind : UnwindAction} {oldSlot : LocalSlot}
    {env env₁ env₂ : PureEnv}
    {entries entries₁ : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .drop { local_ := loc, projection := [] } target unwind)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env₁ entries₁)
    (hGet : get? env₁ loc = .some oldSlot)
    (hLive : oldSlot ≠ .dead)
    (hSet : set? env₁ loc .uninit = .some env₂)
    (hNext : LiftLensBlockToJoin body target env₂ entries₁ joinBb JoinInv) :
    LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv :=
  fun retVal entriesFinal k =>
    .drop_local hPhase hBb hTerm hStmts hGet hLive hSet (hNext retVal entriesFinal k)

/-- Single-pass `setSpineChecked?` variant of `LiftLensBlockToJoin.drop_local`. -/
theorem LiftLensBlockToJoin.drop_local_checked {body : CapturedMir}
    {bbIdx target joinBb : BasicBlockIdx} {bb : BasicBlockData}
    {loc : Local} {unwind : UnwindAction} {oldSlot : LocalSlot}
    {env env₁ env₂ : PureEnv}
    {entries entries₁ : List (RawPtrVal × Value)}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .drop { local_ := loc, projection := [] } target unwind)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env₁ entries₁)
    (hGet : get? env₁ loc = .some oldSlot)
    (hLive : oldSlot ≠ .dead)
    (hSet : setSpineChecked? env₁ loc .uninit = .some env₂)
    (hNext : LiftLensBlockToJoin body target env₂ entries₁ joinBb JoinInv) :
    LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv :=
  .drop_local hPhase hBb hTerm hStmts hGet hLive (set?_of_setSpineChecked? hSet) hNext

theorem LiftLensBlockToJoin.toBlock {body : CapturedMir} {bbIdx joinBb : BasicBlockIdx}
    {env : PureEnv} {entries entriesFinal : List (RawPtrVal × Value)} {retVal : Value}
    {JoinInv : PureEnv → List (RawPtrVal × Value) → Prop}
    (hPath : LiftLensBlockToJoin body bbIdx env entries joinBb JoinInv)
    (hJoin : ∀ envJ entriesJ, JoinInv envJ entriesJ →
      LiftLensBlock body joinBb envJ entriesJ retVal entriesFinal) :
    LiftLensBlock body bbIdx env entries retVal entriesFinal :=
  hPath retVal entriesFinal hJoin

/-- Discharge `LiftLensBlock` by lifting paths from `bbIdx` to a shared
statement-free `return` block `retBb`, lifting `retBb` itself once across all
predecessors. -/
theorem LiftLensBlockToJoin.toReturn {body : CapturedMir} {bbIdx retBb : BasicBlockIdx}
    {retBlock : BasicBlockData} {env : PureEnv}
    {entries entriesFinal : List (RawPtrVal × Value)} {retVal : Value}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hRetBb : get? body.basicBlocks retBb = .some retBlock)
    (hRetTerm : retBlock.terminator.kind = .return_)
    (hRetNil : retBlock.statements = [])
    (hPath : LiftLensBlockToJoin body bbIdx env entries retBb
      (fun envJ entriesJ =>
        get? envJ 0 = .some (.init retVal) ∧ entriesJ = entriesFinal))
    (hInit : valueContainsUninit retVal = false := by rfl) :
    LiftLensBlock body bbIdx env entries retVal entriesFinal :=
  hPath retVal entriesFinal fun _ _ ⟨hRet, hEq⟩ =>
    hEq ▸ .return_ hPhase hRetBb hRetTerm (hRetNil ▸ .nil) hRet hInit

/-- Compose a single `goto retBb` predecessor directly with a statement-free
`return` block (for genuine multi-predecessor sharing of `retBb`, use
`LiftLensBlockToJoin.toReturn`). -/
theorem LiftLensBlock.goto_return {body : CapturedMir} {bbIdx retBb : BasicBlockIdx}
    {bb retBlock : BasicBlockData} {env env' : PureEnv}
    {entries entries' : List (RawPtrVal × Value)} {retVal : Value}
    (hPhase : isRuntimeMirPhase body.phase = true)
    (hBb : get? body.basicBlocks bbIdx = .some bb)
    (hTerm : bb.terminator.kind = .goto retBb)
    (hStmts : LiftLensStmts body.localDecls body.layouts env entries bb.statements env' entries')
    (hRetBb : get? body.basicBlocks retBb = .some retBlock)
    (hRetTerm : retBlock.terminator.kind = .return_)
    (hRetNil : retBlock.statements = [])
    (hRet : get? env' 0 = .some (.init retVal))
    (hInit : valueContainsUninit retVal = false := by rfl) :
    LiftLensBlock body bbIdx env entries retVal entries' :=
  LiftLensBlockToJoin.toReturn hPhase hRetBb hRetTerm hRetNil
    (.goto hPhase hBb hTerm hStmts (.refl ⟨hRet, rfl⟩)) hInit

/-! ### Constructive `MirBoolPredicateHolds` adequacy & signature combinators -/

section SignatureCombinators

open Anneal.ITreeWP
open Anneal.PureMirExec
open Anneal.Scalars
open Anneal.Rustc.V2026_06_01.Lower
open Anneal.Rustc.V2026_06_01.SymbolicEval

/-- Constructive (`⊆ {propext, Quot.sound}`) sufficiency bridge from symbolic
`wpMirSym` to `MirBoolPredicateHolds`, routing through `treeSafe_and_ret_of_mirWpConverges`
rather than classical `dwlp_pure_adequacy`. -/
theorem mirBoolPredicateHolds_of_wpMirSym_true_constructive
    (fuel : Nat) (specBody : CapturedMir) (args : List Value)
    (h : Anneal.Rustc.V2026_06_01.SymbolicEval.wpMirSym fuel specBody
      (initMachineState specBody args) boolTruePost) :
    MirBoolPredicateHolds specBody args := by
  intro a ha
  subst ha
  have ⟨h_safe, h_ret⟩ :=
    Anneal.PureMirExec.treeSafe_and_ret_of_mirWpConverges
      (body := specBody) (s := initMachineState specBody a) (post := boolTruePost) ⟨fuel, h⟩
  refine ⟨h_safe, fun outPair h_r _ retVal mem' h_out => ?_⟩
  have h_bp : boolTruePost outPair.2 := h_ret outPair.1 outPair.2 h_r
  exact h_bp retVal mem' h_out

/-- Constructive (`⊆ {propext, Quot.sound}`) equivalence between `wpExecGen` and `wpCfgStep`
(replacing `beq_self_eq_true` on `Nat` with `nat_beq_self_eq_true`). -/
theorem wpCfgStep_eq_constructive
    (zeroVal : Prop) (body : CapturedMir)
    (post : MirOutcome → Prop)
    (h_phase : body.phase = .runtimeOptimized) :
    ∀ (fuel : Nat) (cur : Option (Nat × Nat × List Statement × Terminator))
      (st : MirExecState),
      (∀ bIdx sIdx stmts term,
        cur = .some (bIdx, sIdx, stmts, term) →
        ∃ bb pfx,
          get? body.basicBlocks bIdx = some bb ∧
          sIdx = length pfx ∧
          bb.statements = pfx ++ stmts ∧
          term = bb.terminator) →
      wpExecGen zeroVal body post fuel st =
        wpCfgStep zeroVal body post fuel cur st := by
  intro fuel
  induction fuel with
  | zero => intros; rfl
  | succ fuel' ih =>
    intro cur st h_cur
    cases st with
    | halted _ =>
      cases cur with
      | none => rfl
      | some tup => rcases tup with ⟨_, _, stmts, _⟩; cases stmts <;> rfl
    | faulted _ =>
      cases cur with
      | none => rfl
      | some tup => rcases tup with ⟨_, _, stmts, _⟩; cases stmts <;> rfl
    | running s =>
      cases cur with
      | none =>
        dsimp only [wpCfgStep, wpExecFallback]
        cases h_ac : s.memory.activeCallee with
        | some _ => rfl
        | none =>
          dsimp only
          cases h_si : Nat.beq s.frame.stmtIdx 0 with
          | false => rfl
          | true =>
            dsimp only [lookupBlock]
            have h_si_eq : s.frame.stmtIdx = 0 := Nat.eq_of_beq_eq_true h_si
            dsimp only [wpExecGen, stepMirSymTreeFast]
            rw [h_ac]
            dsimp only
            rw [h_phase]
            dsimp only
            cases h_bb : get? body.basicBlocks s.frame.blockIdx with
            | none =>
              dsimp only [evalSymNodeTree, MirStepNode.fail, dispatchBlock]
            | some bb =>
              rcases bb with ⟨stmts, term, isCleanup⟩
              dsimp only
              rw [h_si_eq]
              cases stmts with
              | nil =>
                dsimp only [dispatchBlock, get?, length, BEq.beq, instBEqOfDecidableEq,
                  Nat.decEq, instDecidableEqNat, decide]
                apply congrArg (fun k => evalSymNodeTree k post _)
                funext st'
                exact ih .none st' (fun _ _ _ _ h => nomatch h)
              | cons stmt rest =>
                dsimp only [dispatchBlock, get?]
                apply congrArg (fun k => evalSymNodeTree k post _)
                funext st'
                refine ih (.some (s.frame.blockIdx, 1, rest, term)) st' ?_
                intro bIdx sIdx stmts' term' h_some
                injection h_some with h_tup
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup with ⟨rfl, h_tup2⟩
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup2 with ⟨rfl, h_tup3⟩
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup3 with ⟨rfl, rfl⟩
                exact ⟨⟨stmt :: rest, term, isCleanup⟩, [stmt], h_bb, rfl, rfl, rfl⟩
      | some tup =>
        rcases tup with ⟨blockIdx, stmtIdx, stmts, term⟩
        rcases h_cur blockIdx stmtIdx stmts term rfl with ⟨bb, pfx, h_bb, rfl, h_stmts, rfl⟩
        cases stmts with
        | nil =>
          dsimp only [wpCfgStep, wpExecFallback]
          cases h_ac : s.memory.activeCallee with
          | some _ => rfl
          | none =>
            dsimp only
            cases h_bi : Nat.beq s.frame.blockIdx blockIdx with
            | false => rfl
            | true =>
              dsimp only
              cases h_si : Nat.beq s.frame.stmtIdx (length pfx) with
              | false => rfl
              | true =>
                dsimp only
                have h_bi_eq : s.frame.blockIdx = blockIdx := Nat.eq_of_beq_eq_true h_bi
                have h_si_eq : s.frame.stmtIdx = length pfx := Nat.eq_of_beq_eq_true h_si
                have h_eq : bb.statements = pfx := h_stmts.trans (List.append_nil pfx)
                subst h_eq
                dsimp only [wpExecGen, stepMirSymTreeFast]
                rw [h_ac]
                dsimp only
                rw [h_phase]
                dsimp only
                rw [h_bi_eq, h_bb]
                dsimp only
                rw [h_si_eq, get?_length_none]
                dsimp only
                rw [nat_beq_self_eq_true]
                apply congrArg (fun k => evalSymNodeTree k post _)
                funext st'
                exact ih .none st' (fun _ _ _ _ h => nomatch h)
        | cons stmt rest =>
          dsimp only [wpCfgStep, wpExecFallback]
          cases h_ac : s.memory.activeCallee with
          | some _ => rfl
          | none =>
            dsimp only
            cases h_bi : Nat.beq s.frame.blockIdx blockIdx with
            | false => rfl
            | true =>
              dsimp only
              cases h_si : Nat.beq s.frame.stmtIdx (length pfx) with
              | false => rfl
              | true =>
                dsimp only
                have h_bi_eq : s.frame.blockIdx = blockIdx := Nat.eq_of_beq_eq_true h_bi
                have h_si_eq : s.frame.stmtIdx = length pfx := Nat.eq_of_beq_eq_true h_si
                dsimp only [wpExecGen, stepMirSymTreeFast]
                rw [h_ac]
                dsimp only
                rw [h_phase]
                dsimp only
                rw [h_bi_eq, h_bb]
                dsimp only
                rw [h_si_eq, h_stmts, get?_append_cons]
                dsimp only
                apply congrArg (fun k => evalSymNodeTree k post _)
                funext st'
                refine ih (.some (blockIdx, Nat.add (length pfx) 1, rest, bb.terminator)) st' ?_
                intro bIdx sIdx stmts' term' h_some
                injection h_some with h_tup
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup with ⟨rfl, h_tup2⟩
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup2 with ⟨rfl, h_tup3⟩
                rcases Prod.mk.injEq _ _ _ _ ▸ h_tup3 with ⟨rfl, rfl⟩
                refine ⟨bb, pfx ++ [stmt], h_bb, ?_,
                  h_stmts.trans (List.append_assoc pfx [stmt] rest).symm, rfl⟩
                exact (length_append_singleton pfx stmt).symm

/-- Constructive (`⊆ {propext, Quot.sound}`) entry-block initialization for `wpBlockLinear`. -/
theorem wpStartBlock0_eq_constructive
    (zeroVal : Prop) (body : CapturedMir) (bb : BasicBlockData)
    (post : MirOutcome → Prop) (fuel : Nat) (args : List Value)
    (h_phase : body.phase = .runtimeOptimized)
    (h_bb : get? body.basicBlocks 0 = some bb) :
    wpExecGen zeroVal body post fuel (.running (initMachineState body args)) =
      wpBlockLinear zeroVal body bb.terminator post
        0 0 fuel bb.statements (initLocalsAux 0 body.localDecls args)
        (initMachineState body args).memory := by
  refine wpCfgStep_eq_constructive zeroVal body post h_phase fuel
    (.some (0, 0, bb.statements, bb.terminator))
    (.running (initMachineState body args)) ?_
  intro bIdx sIdx stmts term h_some
  injection h_some with h_tup
  rcases Prod.mk.injEq _ _ _ _ ▸ h_tup with ⟨rfl, h_tup2⟩
  rcases Prod.mk.injEq _ _ _ _ ▸ h_tup2 with ⟨rfl, h_tup3⟩
  rcases Prod.mk.injEq _ _ _ _ ▸ h_tup3 with ⟨rfl, rfl⟩
  exact ⟨bb, [], h_bb, rfl, rfl, rfl⟩

/-- Constructive (`⊆ {propext, Quot.sound}`) `wpBlockLinear` bridge for `MirBoolPredicateHolds`. -/
theorem hold_mirBool_of_blockLinear_constructive
    (body : CapturedMir) (args : List Value)
    (h_phase : body.phase = .runtimeOptimized)
    (h_bb0 : get? body.basicBlocks 0 = some (entryBB body))
    (h : Hold
      (wpBlockLinear False body (entryBB body).terminator
        boolTruePost 0 0 (defaultSpecSteps body) (entryBB body).statements
        (initLocalsAux 0 body.localDecls args)
        (initMachineState body args).memory)) :
    Hold (MirBoolPredicateHolds body args) := by
  refine ⟨mirBoolPredicateHolds_of_wpMirSym_true_constructive (defaultSpecSteps body) body args ?_⟩
  unfold wpMirSym
  rw [wpMirExecSym_eq_gen,
      wpStartBlock0_eq_constructive False body (entryBB body) _ (defaultSpecSteps body) args h_phase h_bb0]
  exact h.val

/-- Constructive (`⊆ {propext, Quot.sound}`) necessity bridge, dual to
`treeSafe_and_ret_of_mirWpConverges`: all-prefix fault freedom of
`ITree.cofix (stepMirState body) st` together with `post` on every reachable return implies
the dual fuel-bounded `wpMirExecOrExhaustedSym` at every fuel, by structural recursion on
the fuel along `Reaches` (no `DWLP` coinduction). -/
theorem wpMirExecOrExhaustedSym_of_treeSafe_ret
    (body : CapturedMir) (post : MirOutcome → Prop) :
    ∀ (fuel : Nat) (st : MirExecState),
      TreeSafe (ITree.cofix (stepMirState body) st) →
      (∀ tr out, ReachesRet (ITree.cofix (stepMirState body) st) tr out → post out) →
      wpMirExecOrExhaustedSym fuel body st post
  | 0, _, _, _ => True.intro
  | fuel' + 1, st, h_safe, h_ret => by
    unfold wpMirExecOrExhaustedSym
    rw [evalSymNodeTree_eq, stepMirExecSymTree_eval, evalNodeWP_eq]
    have h_obs := ITree.observe_cofix (stepMirState body) st
    cases h_step : stepMirState body st with
    | ret out =>
      rw [h_step] at h_obs
      exact h_ret [] out ⟨_, .refl _, h_obs⟩
    | tau st' =>
      rw [h_step] at h_obs
      exact wpMirExecOrExhaustedSym_of_treeSafe_ret body post fuel' st'
        (fun tr u h_r => h_safe tr u (.tau h_obs h_r))
        (fun tr out ⟨u, h_r, h_u⟩ => h_ret tr out ⟨u, .tau h_obs h_r, h_u⟩)
    | vis i k =>
      rw [h_step] at h_obs
      rcases i with fk | obs | req
      · -- A fault request is reachable from the root: contradicts `TreeSafe`.
        exact h_safe [] _ (.refl _) ⟨_, _, _, .refl _, h_obs, trivial⟩
      · -- Observations step through their unique `PUnit` answer.
        exact wpMirExecOrExhaustedSym_of_treeSafe_ret body post fuel' (k PUnit.unit)
          (fun _ u h_r => h_safe _ u (.vis h_obs id PUnit.unit h_r))
          (fun _ out ⟨u, h_r, h_u⟩ => h_ret _ out ⟨u, .vis h_obs id PUnit.unit h_r, h_u⟩)
      · -- Unlinked calls are answered demonically: every response is reachable.
        rcases req with ⟨_⟩
        intro o
        exact wpMirExecOrExhaustedSym_of_treeSafe_ret body post fuel' (k o)
          (fun _ u h_r => h_safe _ u (.vis h_obs id o h_r))
          (fun _ out ⟨u, h_r, h_u⟩ => h_ret _ out ⟨u, .vis h_obs id o h_r, h_u⟩)

/-- Constructive (`⊆ {propext, Quot.sound}`) inversion of a `MirBoolPredicateHolds`
hypothesis (such as a `requires` companion) into the single-pass symbolic
`holdBoolMirSym` formula at any fuel. -/
theorem holdBoolMirSym_of_mirBoolPredicateHolds_constructive
    (fuel : Nat) (specBody : CapturedMir) (args : List Value)
    (h : MirBoolPredicateHolds specBody args) :
    holdBoolMirSym fuel specBody args := by
  obtain ⟨h_safe, h_ret⟩ := h args rfl
  refine wpMirExecOrExhaustedSym_of_treeSafe_ret specBody _ fuel _ h_safe ?_
  intro tr out h_r
  cases out with
  | normal p => exact h_ret (tr, .normal p) h_r rfl p.1 p.2 rfl
  | panic => trivial
  | abort => trivial

/-- Constructive (`⊆ {propext, Quot.sound}`) `wpBlockLinear` inversion of
`MirBoolPredicateHolds`, dual to `hold_mirBool_of_blockLinear_constructive`. -/
theorem holdBoolReq_of_mirBool_constructive
    (body : CapturedMir) (args : List Value)
    (h_phase : body.phase = .runtimeOptimized)
    (h_bb0 : get? body.basicBlocks 0 = some (entryBB body))
    (h : MirBoolPredicateHolds body args) :
    Hold
      (wpBlockLinear True body (entryBB body).terminator
        (mirSafePost (fun retVal _ => retVal = .scalar { bits := 1, sizeBytes := 1 }))
        0 0 (defaultSpecSteps body) (entryBB body).statements
        (initLocalsAux 0 body.localDecls args)
        (initMachineState body args).memory) := by
  refine ⟨?_⟩
  rw [← wpStartBlock0_eq_constructive True body (entryBB body) _ (defaultSpecSteps body) args
      h_phase h_bb0, ← wpMirExecOrExhaustedSym_eq_gen]
  exact holdBoolMirSym_of_mirBoolPredicateHolds_constructive (defaultSpecSteps body) body args h

/-- Constructive (`⊆ {propext, Quot.sound}`) `runCfgSteps` soundness for `wpMirExecStepsSym`
(replacing `beq_self_eq_true` on `Nat` with `nat_beq_self_eq_true`). -/
theorem wpMirExecStepsSym_of_runCfgSteps_constructive
    (body : CapturedMir) (mid : MachineState → Prop) (post : MirOutcome → Prop)
    (h_phase : body.phase = .runtimeOptimized) :
    ∀ (fuel : Nat) (cfg : CfgExecState) (st : MirExecState),
      CfgValid body cfg st →
      cfgStepsWP mid post (runCfgSteps body cfg fuel) →
      wpMirExecStepsSym fuel body st (stepsExecMid mid post) post := by
  intro fuel
  induction fuel with
  | zero =>
    intro cfg st h_valid h_wp
    dsimp only [runCfgSteps] at h_wp
    cases cfg with
    | running ok _ s =>
      rcases h_valid with ⟨rfl, _⟩
      exact h_wp.2
    | faulted => exact False.elim h_wp
    | halted ok out =>
      change st = .halted out at h_valid
      subst h_valid
      exact h_wp.2
  | succ fuel' ih =>
    intro cfg st h_valid h_wp
    rw [runCfgSteps_step] at h_wp
    have h_ok1 : cfgOk (stepCfgState body cfg) = true :=
      cfgOk_of_runCfgSteps_true body fuel' (stepCfgState body cfg) (cfgOk_of_cfgStepsWP h_wp)
    have h_ok0 : cfgOk cfg = true := by
      cases h_c : cfgOk cfg with
      | true => rfl
      | false =>
        rw [cfgOk_stepCfgState_false body cfg h_c] at h_ok1
        nomatch h_ok1
    cases cfg with
    | faulted => nomatch h_ok0
    | halted ok out =>
      change st = .halted out at h_valid
      subst h_valid
      change ok = true at h_ok0
      subst h_ok0
      dsimp only [stepCfgState] at h_wp
      rw [runCfgSteps_halted] at h_wp
      exact wpMirExecStepsSym_halted body mid post (fuel' + 1) out h_wp.2
    | running ok cur s =>
      change ok = true at h_ok0
      subst h_ok0
      rcases h_valid with ⟨rfl, h_cur⟩
      dsimp only [stepCfgState] at h_ok1 h_wp
      cases h_ac : s.memory.activeCallee with
      | some _ =>
        rw [h_ac] at h_ok1
        nomatch h_ok1
      | none =>
        rw [h_ac] at h_ok1 h_wp
        dsimp only at h_ok1 h_wp
        rw [wpMirExecStepsSym_succ_eq]
        dsimp only [stepMirState, stepMirFn]
        rw [h_ac]
        dsimp only [Option.getD]
        rw [h_phase]
        dsimp only
        cases cur with
        | none =>
          cases h_si : Nat.beq s.frame.stmtIdx 0 with
          | false =>
            rw [h_si] at h_ok1
            nomatch h_ok1
          | true =>
            rw [h_si] at h_ok1 h_wp
            dsimp only [lookupBlock] at h_ok1 h_wp
            have h_si_eq : s.frame.stmtIdx = 0 := Nat.eq_of_beq_eq_true h_si
            cases h_bb : get? body.basicBlocks s.frame.blockIdx with
            | none =>
              rw [h_bb] at h_ok1
              nomatch h_ok1
            | some bb =>
              rw [h_bb] at h_ok1 h_wp
              rcases bb with ⟨stmts, term, isCleanup⟩
              rw [h_si_eq]
              cases stmts with
              | nil =>
                dsimp only [dispatchBlockCfg, get?, GetElem?.getElem?,
                  List.instGetElem?NatLtLength, List.get?Internal, length, BEq.beq,
                  instBEqOfDecidableEq, Nat.decEq, instDecidableEqNat, decide] at h_ok1 h_wp ⊢
                exact wpMirExecStepsSym_evalTerminatorCfg body mid post fuel' s term h_ok1 ih h_wp
              | cons stmt rest =>
                dsimp only [dispatchBlockCfg, get?, GetElem?.getElem?,
                  List.instGetElem?NatLtLength, List.get?Internal] at h_ok1 h_wp ⊢
                rw [← evalStmtFast_eq body s stmt]
                exact wpMirExecStepsSym_stepNodeToCfg body mid post fuel'
                  (.some (s.frame.blockIdx, 1, rest, term))
                  (evalStmtFast body s stmt)
                  ⟨⟨stmt :: rest, term, isCleanup⟩, [stmt], h_bb, rfl, rfl, rfl⟩
                  h_ok1 ih h_wp
        | some tup =>
          rcases tup with ⟨blockIdx, stmtIdx, stmts, term⟩
          rcases h_cur with ⟨bb, pfx, h_bb, rfl, h_stmts, rfl⟩
          cases h_bi : Nat.beq s.frame.blockIdx blockIdx with
          | false =>
            cases stmts <;> (dsimp only at h_ok1; rw [h_bi] at h_ok1; nomatch h_ok1)
          | true =>
            have h_bi_eq : s.frame.blockIdx = blockIdx := Nat.eq_of_beq_eq_true h_bi
            cases h_si : Nat.beq s.frame.stmtIdx (length pfx) with
            | false =>
              cases stmts <;> (dsimp only at h_ok1; rw [h_bi, h_si] at h_ok1; nomatch h_ok1)
            | true =>
              have h_si_eq : s.frame.stmtIdx = length pfx := Nat.eq_of_beq_eq_true h_si
              rw [h_bi_eq, h_bb, h_si_eq]
              dsimp only
              cases stmts with
              | nil =>
                dsimp only at h_ok1 h_wp
                rw [h_bi, h_si] at h_ok1 h_wp
                have h_eq : bb.statements = pfx := h_stmts.trans (List.append_nil pfx)
                rw [← h_eq, get?_length_none]
                dsimp only
                rw [nat_beq_self_eq_true, ite_eq_left rfl]
                exact wpMirExecStepsSym_evalTerminatorCfg body mid post fuel' s bb.terminator h_ok1 ih h_wp
              | cons stmt rest =>
                dsimp only at h_ok1 h_wp
                rw [h_bi, h_si] at h_ok1 h_wp
                rw [h_stmts, get?_append_cons]
                dsimp only
                rw [← evalStmtFast_eq body s stmt]
                exact wpMirExecStepsSym_stepNodeToCfg body mid post fuel'
                  (.some (blockIdx, Nat.add (length pfx) 1, rest, bb.terminator))
                  (evalStmtFast body s stmt)
                  ⟨bb, pfx ++ [stmt], h_bb, (length_append_singleton pfx stmt).symm,
                    h_stmts.trans (List.append_assoc pfx [stmt] rest).symm, rfl⟩
                  h_ok1 ih h_wp

/-- Constructive (`⊆ {propext, Quot.sound}`) bridge from the call-forbidding segment WP with
an empty mid-state predicate to the call-forbidding bounded WP one step later. -/
theorem wpCoalBounded_succ_of_wpMirExecStepsSym_false
    (body : CapturedMir) (post : MirOutcome → Prop) :
    ∀ (fuel : Nat) (st : MirExecState),
      wpMirExecStepsSym fuel body st (stepsExecMid (fun _ => False) post) post →
      wpCoalBounded (fuel + 1) mirNoCallWP (stepMirState body)
        (fun out _ => post out) st PUnit.unit
  | 0, st, h => by
    cases st with
    | running _ => exact False.elim h
    | halted out => exact h
    | faulted _ => exact False.elim h
  | fuel' + 1, st, h => by
    rw [wpMirExecStepsSym_succ_eq] at h
    rw [wpCoalBounded_succ_eq]
    unfold stepNodeStepsWP at h
    unfold stepNodeWP
    cases h_step : stepMirState body st with
    | ret out => rw [h_step] at h; exact h
    | tau st' =>
      rw [h_step] at h
      exact wpCoalBounded_succ_of_wpMirExecStepsSym_false body post fuel' st' h
    | vis i k =>
      rw [h_step] at h
      exact mirNoCallWP.mono
        (fun o _ h_o => wpCoalBounded_succ_of_wpMirExecStepsSym_false body post fuel' (k o) h_o) h

/-- Constructive (`⊆ {propext, Quot.sound}`) `runCfgSteps` soundness for `wpCoalBounded`,
derived from `wpMirExecStepsSym_of_runCfgSteps_constructive` with an empty mid-state
predicate (a halting run is a halting segment). -/
theorem wpCoalBounded_of_runCfgSteps_constructive
    (body : CapturedMir) (post : MirOutcome → Prop)
    (h_phase : body.phase = .runtimeOptimized) :
    ∀ (fuel : Nat) (cfg : CfgExecState) (st : MirExecState),
      CfgValid body cfg st →
      cfgStateWP post (runCfgSteps body cfg fuel) →
      wpCoalBounded (fuel + 1) mirNoCallWP (stepMirState body)
        (fun out _ => post out) st PUnit.unit := by
  intro fuel cfg st h_valid h_wp
  refine wpCoalBounded_succ_of_wpMirExecStepsSym_false body post fuel st
    (wpMirExecStepsSym_of_runCfgSteps_constructive body _ post h_phase fuel cfg st h_valid ?_)
  revert h_wp
  cases runCfgSteps body cfg fuel with
  | halted ok out => exact id
  | running _ _ _ => exact False.elim
  | faulted => exact False.elim

/-- Constructive (`⊆ {propext, Quot.sound}`) segment convergence via `runCfgToBlock`. -/
theorem mirStepsConverges_of_runCfgToBlock_constructive
    (body : CapturedMir) (mid : MachineState → Prop) (post : MirOutcome → Prop)
    (h_phase : body.phase = .runtimeOptimized) (target : Nat) (s : MachineState)
    (h_wp : cfgStepsWP mid post (runCfgToBlock body target (.running true .none s))) :
    Anneal.MirFuelFree.MirStepsConverges body s mid post := by
  obtain ⟨k, hk⟩ := runCfgToBlock_eq_runCfgSteps body target (.running true .none s)
  rw [hk] at h_wp
  exact ⟨k, wpMirExecStepsSym_of_runCfgSteps_constructive body mid post h_phase k
    (.running true .none s) (.running s) ⟨rfl, trivial⟩ h_wp⟩

/-- Constructive (`⊆ {propext, Quot.sound}`) call-forbidding convergence via `runCfgToBlock`. -/
theorem mirNoCallWpConverges_of_runCfgToBlock_constructive
    (body : CapturedMir) (post : MirOutcome → Prop)
    (h_phase : body.phase = .runtimeOptimized) (target : Nat) (s : MachineState)
    (h_wp : cfgStateWP post (runCfgToBlock body target (.running true .none s))) :
    Anneal.MirFuelFree.MirNoCallWpConverges body s post := by
  obtain ⟨k, hk⟩ := runCfgToBlock_eq_runCfgSteps body target (.running true .none s)
  rw [hk] at h_wp
  refine ⟨k + 1, ?_⟩
  rw [wpMirNoCallSym_eq_wpMirNoCallBounded]
  exact wpCoalBounded_of_runCfgSteps_constructive body post h_phase k
    (.running true .none s) (.running s) ⟨rfl, trivial⟩ h_wp

private theorem mirNoCallWpConverges_forRangeUpAux {α : Type}
    (body : CapturedMir) (lo hi : Nat)
    (step : (i : Nat) → lo ≤ i → i < hi → α → α)
    (LoopInv : Nat → α → MachineState → Prop)
    (post : MirOutcome → Prop)
    (h_body : ∀ i (hlo : lo ≤ i) (hlt : i < hi) a s, LoopInv i a s →
      Anneal.MirFuelFree.MirStepsConverges body s
        (LoopInv (i + 1) (step i hlo hlt a)) (fun _ => False)) :
    ∀ (i rem : Nat) (hlo : lo ≤ i) (hsum : i + rem = hi) (acc : α) (s : MachineState),
      LoopInv i acc s →
      (∀ s_exit, LoopInv hi (forRangeUpAux lo hi step i rem hlo hsum acc) s_exit →
        Anneal.MirFuelFree.MirNoCallWpConverges body s_exit post) →
      Anneal.MirFuelFree.MirNoCallWpConverges body s post
  | i, 0, _, hsum, _, s, hinv, hexit => by
    have h_eq : i = hi := (Nat.add_zero i).symm.trans hsum
    subst h_eq
    exact hexit s hinv
  | i, rem + 1, hlo, hsum, acc, s, hinv, hexit =>
    have hlt : i < hi :=
      Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.succ_pos rem)) (Nat.le_of_eq hsum)
    have hsum' : (i + 1) + rem = hi := (Nat.add_right_comm i 1 rem).trans hsum
    Anneal.MirFuelFree.MirNoCallWpConverges.bind
      (Anneal.MirFuelFree.MirStepsConverges.mono (fun _ h => h) (fun _ => False.elim)
        (h_body i hlo hlt acc s hinv))
      fun s' hinv' =>
        mirNoCallWpConverges_forRangeUpAux body lo hi step LoopInv post h_body
          (i + 1) rem (Nat.le_succ_of_le hlo) hsum' (step i hlo hlt acc) s' hinv' hexit

/-- Constructive (`⊆ {propext, Quot.sound}`) call-forbidding range-loop rule
delivering `LoopInv hi (PureMirExec.forRangeUp lo hi init step)` directly at loop exit
(so callers discharge the exit postcondition via `PureMirExec.forRangeUp_induction`
without duplicating the fold in `LoopInv`). -/
theorem mirNoCallWpConverges_forRangeUp_inv {α : Type}
    (body : CapturedMir) (lo hi : Nat) (init : α)
    (step : (i : Nat) → lo ≤ i → i < hi → α → α)
    (LoopInv : Nat → α → MachineState → Prop)
    (s₀ : MachineState) (post : MirOutcome → Prop)
    (h_le : lo ≤ hi)
    (h_init : LoopInv lo init s₀)
    (h_body : ∀ i (hlo : lo ≤ i) (hlt : i < hi) a s, LoopInv i a s →
      Anneal.MirFuelFree.MirStepsConverges body s
        (LoopInv (i + 1) (step i hlo hlt a)) (fun _ => False))
    (h_exit : ∀ s_exit, LoopInv hi (Anneal.PureMirExec.forRangeUp lo hi init step) s_exit →
      Anneal.MirFuelFree.MirNoCallWpConverges body s_exit post) :
    Anneal.MirFuelFree.MirNoCallWpConverges body s₀ post := by
  unfold Anneal.PureMirExec.forRangeUp at h_exit
  rw [dite_eq_left h_le] at h_exit
  exact mirNoCallWpConverges_forRangeUpAux body lo hi step LoopInv post h_body
    lo (hi - lo) (Nat.le_refl lo) (Nat.add_sub_of_le h_le) init s₀ h_init h_exit

/-- Constructive (`⊆ {propext, Quot.sound}`) stateful verification discharge from `MirWpConverges`,
routing directly through `treeSafe_and_ret_of_mirWpConverges` without `DWLP`. -/
theorem verifyStatefulMirNoPanic_of_wpConverges_constructive
    (c : StatefulClaim)
    (h_wp : ∀ (args : List Value) (mem : Memory), c.pre args mem →
      Anneal.MirFuelFree.MirWpConverges c.body
        (Trusted.VerificationResult.initMachineStateWithMemoryAndCallees c.body args mem c.callees)
        (mirNormalPost (c.post args mem))) :
    StatefulVerificationResult c := by
  refine ⟨fun args mem h_pre => ?_⟩
  have ⟨h_safe, h_ret⟩ :=
    Anneal.PureMirExec.treeSafe_and_ret_of_mirWpConverges (h_wp args mem h_pre)
  refine ⟨h_safe, fun outPair h_r _ retVal mem' h_out => ?_⟩
  have h_post := h_ret outPair.1 outPair.2 h_r
  rw [h_out] at h_post
  exact h_post

/-- Constructive (`⊆ {propext, Quot.sound}`) `evalMirSpecBool` bridge for `MirBoolPredicateHolds`. -/
theorem mirBoolPredicateHolds_of_evalMirSpecBool_true_constructive
    (specBody : CapturedMir) (args : List Value)
    (h_phase : specBody.phase = .runtimeOptimized)
    (h_eval : evalMirSpecBool specBody args = true) :
    MirBoolPredicateHolds specBody args := by
  apply mirBoolPredicateHolds_of_wpMirSym_true_constructive (defaultSpecSteps specBody + 1) specBody args
  unfold wpMirSym
  rw [wpMirExecSym_eq_wpCoalBounded]
  apply wpCoalBounded_default_of_noCall
  refine wpCoalBounded_of_runCfgSteps_constructive specBody boolTruePost h_phase (defaultSpecSteps specBody)
    (.running true .none (initMachineState specBody args))
    (.running (initMachineState specBody args))
    ⟨rfl, trivial⟩ ?_
  unfold evalMirSpecBool at h_eval
  revert h_eval
  cases runCfgSteps specBody
    (.running true .none (initMachineState specBody args))
    (defaultSpecSteps specBody) with
  | running _ _ _ => intro h; contradiction
  | faulted => intro h; contradiction
  | halted ok out =>
    cases ok with
    | false => intro h; contradiction
    | true =>
      cases out with
      | panic => intro h; contradiction
      | abort => intro h; contradiction
      | normal rv =>
        rcases rv with ⟨v, mem'⟩
        cases v with
        | scalar sc =>
          rcases sc with ⟨bits, sz⟩
          cases bits with
          | zero => intro h; contradiction
          | succ b' =>
            cases b' with
            | zero =>
              cases sz with
              | zero => intro h; contradiction
              | succ sz' =>
                cases sz' with
                | zero => intro _; exact ⟨rfl, boolTruePost_normal_one mem'⟩
                | succ _ => intro h; contradiction
            | succ _ => intro h; contradiction
        | _ => intro h; contradiction

/-- Extract a 2-byte scalar below `2^16` from a `valueMatchesRigidTyAndLayout` hypothesis
on a `u16` local declaration, for every 2-byte `TypeLayout`. -/
theorem u16_of_valueMatchesRigid {fuel' : Nat} {body : CapturedMir} {layout : TypeLayout}
    {layoutIdx : LayoutIdx} {v : Value} {mem : Memory} (h_size : layout.size.bytes = 2)
    (h : valueMatchesRigidTyAndLayout (fuel' + 1) body (.uint .u16)
      (some layout) layoutIdx v mem) :
    ∃ b, v = .scalar { bits := b, sizeBytes := 2 } ∧ b < 65536 := by
  rcases v with _ | ⟨b, sz⟩ | _ | _ <;> simp only [valueMatchesRigidTyAndLayout] at h
  all_goals first
    | exact h.2.2.elim
    | (obtain ⟨-, -, h_sz, -, h_lt, -⟩ := h
       have h2 : sz = 2 := h_sz.trans h_size
       subst h2
       exact ⟨b, rfl, h_lt⟩)

/-- Establish `scalarMatchesBackendRepr` for a 2-byte scalar below `2^16` on any `TypeLayout`
whose `backendRepr` is a `u16` initialized scalar layout (`[0, 65535]`). -/
theorem u16_scalarMatchesBackendRepr {repr : BackendRepr} {r : Nat}
    (h_repr : repr = .scalar (ScalarLayout.initialized (.int 16 false) { start := 0, end_ := 65535 }))
    (h_lt : r < 65536) :
    scalarMatchesBackendRepr repr r := by
  rw [h_repr]
  show (Nat.ble 0 r && Nat.ble r 65535) = true
  rw [Nat.ble_eq_true_of_le (Nat.zero_le r), Nat.ble_eq_true_of_le (Nat.le_of_lt_succ h_lt)]
  rfl

/-- Extract a 2-byte scalar below `2^16` from `valueMatchesTyAndLayout` without unfolding
`valueMatchesRigidTyAndLayout` at the call site (any 2-byte layout for the `u16` local). -/
theorem u16_of_valueMatchesTy {fuel' : Nat} {body : CapturedMir} {ty : Ty}
    {layoutIdx : LayoutIdx} {layout : TypeLayout} {v : Value} {mem : Memory}
    (h_kind : ty.kind = .uint .u16)
    (h_get : sigGet? body.layouts.entries layoutIdx = some layout)
    (h_size : layout.size.bytes = 2)
    (h : valueMatchesTyAndLayout (fuel' + 1) body ty layoutIdx v mem) :
    ∃ b, v = .scalar { bits := b, sizeBytes := 2 } ∧ b < 65536 := by
  unfold valueMatchesTyAndLayout at h
  rw [h_kind, h_get] at h
  exact u16_of_valueMatchesRigid h_size h

/-- Unpack a 2-argument `(u16, u16)` `argsMatchSignature` precondition into two 2-byte
scalars below `2^16` without unfolding `valueMatchesRigidTyAndLayout` at the call site. -/
theorem u16_pair_of_argsMatchSignature {body : CapturedMir}
    {d0 d1 d2 : LocalDecl} {restDecls : List LocalDecl}
    {l1 l2 : TypeLayout} {args : List Value} {mem : Memory}
    (h_argc : body.argCount = 2)
    (h_decls : body.localDecls = d0 :: d1 :: d2 :: restDecls)
    (h_k1 : d1.ty.kind = .uint .u16)
    (h_g1 : sigGet? body.layouts.entries d1.ty.layoutIdx = some l1)
    (h_s1 : l1.size.bytes = 2)
    (h_k2 : d2.ty.kind = .uint .u16)
    (h_g2 : sigGet? body.layouts.entries d2.ty.layoutIdx = some l2)
    (h_s2 : l2.size.bytes = 2)
    (h_sig : argsMatchSignature body args mem) :
    ∃ b1 b2,
      args = [.scalar { bits := b1, sizeBytes := 2 }, .scalar { bits := b2, sizeBytes := 2 }] ∧
      b1 < 65536 ∧ b2 < 65536 := by
  obtain ⟨h_len, h_aux⟩ := h_sig
  rw [h_argc] at h_len
  obtain ⟨v1, v2, rfl⟩ : ∃ v1 v2, args = [v1, v2] := by
    rcases args with _ | ⟨v1, _ | ⟨v2, _ | _⟩⟩
    all_goals first | exact ⟨_, _, rfl⟩ | nomatch h_len
  rw [h_decls] at h_aux
  dsimp only [argsMatchSignatureAux, defaultSignatureFuel] at h_aux
  obtain ⟨h1, h2, -⟩ := h_aux
  obtain ⟨b1, rfl, hb1⟩ := u16_of_valueMatchesTy h_k1 h_g1 h_s1 h1
  obtain ⟨b2, rfl, hb2⟩ := u16_of_valueMatchesTy h_k2 h_g2 h_s2 h2
  exact ⟨b1, b2, rfl, hb1, hb2⟩

/-- Establish `retMatchesSignature` for a 2-byte scalar below `2^16` when return local `_0`
has type `u16` and any 2-byte `u16` scalar `TypeLayout`. -/
theorem u16_retMatchesSignature {body : CapturedMir} {retDecl : LocalDecl}
    {restDecls : List LocalDecl} {layout : TypeLayout} {r : Nat} (mem : Memory)
    (h_decls : body.localDecls = retDecl :: restDecls)
    (h_kind : retDecl.ty.kind = .uint .u16)
    (h_get : sigGet? body.layouts.entries retDecl.ty.layoutIdx = some layout)
    (h_uninhabited : layout.isUninhabited = false)
    (h_param : sigIsParamPlaceholder layout = false)
    (h_size : layout.size.bytes = 2)
    (h_repr : layout.backendRepr =
      .scalar (ScalarLayout.initialized (.int 16 false) { start := 0, end_ := 65535 }))
    (h_lt : r < 65536) :
    retMatchesSignature body (.scalar { bits := r, sizeBytes := 2 }) mem := by
  unfold retMatchesSignature valueMatchesTyAndLayout
  rw [h_decls]
  dsimp only []
  rw [h_kind, h_get]
  dsimp only [defaultSignatureFuel, valueMatchesRigidTyAndLayout]
  exact ⟨h_uninhabited, h_param, h_size.symm, Nat.two_pos, h_lt,
    u16_scalarMatchesBackendRepr h_repr h_lt⟩

/-- `Nat.ble a b = false` from `¬ a ≤ b`. -/
theorem nat_ble_eq_false_of_not_le {a b : Nat} (h : ¬ a ≤ b) : Nat.ble a b = false :=
  Bool.eq_false_iff.mpr (h ∘ Nat.le_of_ble_eq_true)

/-- Little-endian `u16` decode of two initialized provenance-free bytes `[b2, b3]`. -/
theorem decodeScalarLayoutBytesNoForge_u16_le (b2 b3 : Nat) (hb2 : b2 < 256) (hb3 : b3 < 256) :
    decodeScalarLayoutBytesNoForge
      (ScalarLayout.initialized (.int 16 false) { start := 0, end_ := 65535 })
      [.init (UInt8.ofNat b2) none, .init (UInt8.ofNat b3) none] =
    some (.scalar { bits := b2 + 256 * b3, sizeBytes := 2 }) := by
  have hb2' : (UInt8.ofNat b2).toBitVec.toNat = b2 :=
    (BitVec.toNat_ofNat b2 8).trans (Nat.mod_eq_of_lt hb2)
  have hb3' : (UInt8.ofNat b3).toBitVec.toNat = b3 :=
    (BitVec.toNat_ofNat b3 8).trans (Nat.mod_eq_of_lt hb3)
  let rawBits :=
    Nat.add (UInt8.ofNat b2).toBitVec.toNat
      (Nat.mul 256 (Nat.add (UInt8.ofNat b3).toBitVec.toNat 0))
  have h_val : rawBits = b2 + 256 * b3 := by
    dsimp [rawBits]
    rw [hb2', hb3']
  have h_ble : Nat.ble rawBits 65535 = true :=
    Nat.ble_eq_true_of_le (by omega)
  change
    (match Nat.ble rawBits 65535 with
     | false => Option.none
     | true => Option.some (Value.scalar { bits := rawBits, sizeBytes := 2 })) = _
  rw [h_ble, h_val]

end SignatureCombinators

/-! ## 6. Wide-Pointer Slice Byte & Borrow Lenses (`WidePtrVal`, `SliceTypedAt`)

Slice views of `wide_ptr_or_unsized_dst` functions over the trusted byte primitives and the
trusted `Trusted.Rustc.V2026_06_01.MirSemantics` wide-pointer representation.

* `WidePtrVal := ProvenancePtr × Nat` (data pointer, element length). Every combinator
  (`toValue`, `elemOffset`, `elemPtr`, `takeElems`, `dropElems`) projects `.1` / `.2`
  directly (never `let (p, l) := wide`), and `widePtr_proj_fst` / `widePtr_proj_snd`
  are the `simp` normal forms, so partially symbolic pairs never stall `simp` / `whnf`.
  `WidePtrVal.toValue ptrBytes wide` is exactly the trusted fat pointer
  `.aggregate 0 [.ptr wide.1 ptrBytes, .scalar ⟨wide.2, ptrBytes⟩]`.
* `SliceTypedAt c wide xs bytes`: `xs.length = wide.2`, the `wide.2 * n`-byte window at
  `wide.1.offsetBytes` fits, and element `i` is `TypedAt c (wide.1.offsetBytes + i * n)`.
  ZST codecs (`n = 0`) and empty slices (`wide.2 = 0`) need no division and no
  special cases. Algebra: `unique`, `getElem_typedAt`, `splitAt` (with the slice-scaled
  `DisjointSlice.adjacent` witness), `append` / `of_splitAt` (inverse), `write_elem`,
  `frame_writeBytes` / `frame_write`, and the `split_at_mut` write-then-reassemble law
  `write_left_reassemble`.
* Live memory: `globalAllocByteMem` is the trusted `globalAllocSliceToAbstractBytes`
  view of a captured allocation, and `SliceTypedAt.len_eq` /
  `WidePtrVal.evalRvalue_ptrMetadata` discharge `Rvalue.len (*slice)` and
  `UnOp.ptrMetadata` in the trusted `evalRvalue` to `.scalar ⟨wide.2, ptrBytes⟩`;
  `TypedAt.unsize_array_to_slice` discharges the trusted `PointerCoercion("Unsize")` of a
  `ByteLensCodec.array`-typed `[T; N]` to a `SliceTypedAt` slice with `wide.2 = N`.
* Borrow-checked lenses: `ActiveTypedSliceBorrow` / `ActiveTypedSliceMutBorrow` pair a
  `SliceTypedAt` view with a byte-ranged trusted `BorrowEntry` covering exactly
  `[wide.1.offsetBytes, wide.1.offsetBytes + wide.2 * n)` with read / write permission
  (`TreeBorrowPerm`), with `write_elem_frame` and `splitAt` (`split_at_mut`).
-/

section SliceWidePtrLenses

/-- A wide (fat) slice pointer: data pointer `.1` and element length `.2`. -/
abbrev WidePtrVal : Type := ProvenancePtr × Nat

/-- Build a wide pointer from its data pointer and element length. -/
@[reducible]
def WidePtrVal.mk (p : ProvenancePtr) (len : Nat) : WidePtrVal := (p, len)

/-- Data-pointer accessor on `WidePtrVal` (normalizes to `.1`). -/
@[reducible]
def WidePtrVal.ptr (wide : WidePtrVal) : ProvenancePtr := wide.1

/-- Element-length accessor on `WidePtrVal` (normalizes to `.2`). -/
@[reducible]
def WidePtrVal.len (wide : WidePtrVal) : Nat := wide.2

/-- Normal form of the data-pointer projection. -/
@[simp]
theorem widePtr_proj_fst (p : ProvenancePtr) (len : Nat) : (WidePtrVal.mk p len).1 = p := rfl

/-- Normal form of the element-length projection. -/
@[simp]
theorem widePtr_proj_snd (p : ProvenancePtr) (len : Nat) : (WidePtrVal.mk p len).2 = len := rfl

@[simp]
theorem widePtr_ptr_eq_fst (wide : WidePtrVal) : WidePtrVal.ptr wide = wide.1 := rfl

@[simp]
theorem widePtr_len_eq_snd (wide : WidePtrVal) : WidePtrVal.len wide = wide.2 := rfl

/-- The trusted runtime fat pointer `.aggregate 0 [.ptr wide.1 ptrBytes, .scalar ⟨wide.2, ptrBytes⟩]`. -/
@[reducible]
def WidePtrVal.toValue (ptrBytes : Nat) (wide : WidePtrVal) : Value :=
  .aggregate 0 [.ptr wide.1 ptrBytes, .scalar ⟨wide.2, ptrBytes⟩]

/-- Byte offset of element `i` of a slice of `n`-byte elements. -/
@[reducible]
def WidePtrVal.elemOffset (wide : WidePtrVal) (n i : Nat) : Nat :=
  wide.1.offsetBytes + i * n

/-- Thin pointer to element `i` (same allocation / provenance as `wide.1`). -/
@[reducible]
def WidePtrVal.elemPtr (wide : WidePtrVal) (n i : Nat) : ProvenancePtr :=
  { allocId := wide.1.allocId, offsetBytes := WidePtrVal.elemOffset wide n i }

/-- The prefix subslice `wide[.. k]`. -/
@[reducible]
def WidePtrVal.takeElems (wide : WidePtrVal) (k : Nat) : WidePtrVal :=
  (wide.1, k)

/-- The suffix subslice `wide[k ..]` (`wide.2 - k` elements starting at element `k`). -/
@[reducible]
def WidePtrVal.dropElems (wide : WidePtrVal) (n k : Nat) : WidePtrVal :=
  (WidePtrVal.elemPtr wide n k, wide.2 - k)

@[simp] theorem WidePtrVal.toValue_mk (ptrBytes : Nat) (p : ProvenancePtr) (len : Nat) :
    WidePtrVal.toValue ptrBytes (WidePtrVal.mk p len) =
      .aggregate 0 [.ptr p ptrBytes, .scalar ⟨len, ptrBytes⟩] := rfl

@[simp] theorem WidePtrVal.takeElems_fst (wide : WidePtrVal) (k : Nat) :
    (WidePtrVal.takeElems wide k).1 = wide.1 := rfl

@[simp] theorem WidePtrVal.takeElems_snd (wide : WidePtrVal) (k : Nat) :
    (WidePtrVal.takeElems wide k).2 = k := rfl

@[simp] theorem WidePtrVal.dropElems_fst (wide : WidePtrVal) (n k : Nat) :
    (WidePtrVal.dropElems wide n k).1 = WidePtrVal.elemPtr wide n k := rfl

@[simp] theorem WidePtrVal.dropElems_snd (wide : WidePtrVal) (n k : Nat) :
    (WidePtrVal.dropElems wide n k).2 = wide.2 - k := rfl

/-- The trusted fat-pointer encoding is injective (for a fixed pointer width). -/
theorem WidePtrVal.toValue_injective {ptrBytes : Nat} {w₁ w₂ : WidePtrVal}
    (h : WidePtrVal.toValue ptrBytes w₁ = WidePtrVal.toValue ptrBytes w₂) : w₁ = w₂ := by
  obtain ⟨p₁, l₁⟩ := w₁
  obtain ⟨p₂, l₂⟩ := w₂
  simp only [WidePtrVal.toValue, Value.aggregate.injEq, List.cons.injEq, Value.ptr.injEq,
    Value.scalar.injEq, ScalarInt.mk.injEq, and_true, true_and] at h
  obtain ⟨rfl, rfl⟩ := h
  rfl

/-- The byte offset of element `0` is the data pointer's offset. -/
theorem WidePtrVal.elemOffset_zero (wide : WidePtrVal) (n : Nat) :
    WidePtrVal.elemOffset wide n 0 = wide.1.offsetBytes := by
  simp [WidePtrVal.elemOffset]

/-- Element offsets of a suffix subslice shift by `k * n`. -/
theorem WidePtrVal.elemOffset_dropElems (wide : WidePtrVal) (n k i : Nat) :
    WidePtrVal.elemOffset (WidePtrVal.dropElems wide n k) n i =
      WidePtrVal.elemOffset wide n (k + i) := by
  simp only [WidePtrVal.elemOffset, Nat.add_mul, Nat.add_assoc]

@[simp]
theorem WidePtrVal.elemPtr_allocId (wide : WidePtrVal) (n i : Nat) :
    (WidePtrVal.elemPtr wide n i).allocId = wide.1.allocId := rfl

@[simp]
theorem WidePtrVal.elemPtr_tag (wide : WidePtrVal) (n i : Nat) :
    (WidePtrVal.elemPtr wide n i).tag = wide.1.tag := rfl

@[simp]
theorem WidePtrVal.elemPtr_offsetBytes (wide : WidePtrVal) (n i : Nat) :
    (WidePtrVal.elemPtr wide n i).offsetBytes = WidePtrVal.elemOffset wide n i := rfl

@[simp]
theorem WidePtrVal.elemPtr_zero (wide : WidePtrVal) (n : Nat) :
    WidePtrVal.elemPtr wide n 0 = wide.1 := by
  rcases wide with ⟨⟨allocId, offsetBytes⟩, len⟩
  simp [WidePtrVal.elemPtr, WidePtrVal.elemOffset]

theorem WidePtrVal.elemPtr_dropElems (wide : WidePtrVal) (n k i : Nat) :
    WidePtrVal.elemPtr (WidePtrVal.dropElems wide n k) n i =
      WidePtrVal.elemPtr wide n (k + i) := by
  simp only [WidePtrVal.elemPtr, WidePtrVal.elemOffset_dropElems]

/-! ### `SliceTypedAt` -/

/--
**Relational slice view.** `SliceTypedAt c wide xs bytes`: `xs` has exactly `wide.2`
elements, the `wide.2 * n`-byte window starting at `wide.1.offsetBytes` lies inside
`bytes`, and element `i` is `TypedAt c (wide.1.offsetBytes + i * n) xs[i]`.
-/
def SliceTypedAt {α : Type} {n : Nat} (c : ByteLensCodec α n) (wide : WidePtrVal)
    (xs : List α) (bytes : ByteMem) : Prop :=
  xs.length = wide.2 ∧ wide.1.offsetBytes + wide.2 * n ≤ bytes.length ∧
    ∀ (i : Nat) (hi : i < xs.length), TypedAt c (wide.1.offsetBytes + i * n) xs[i] bytes

namespace SliceTypedAt

variable {α : Type} {n : Nat} {c : ByteLensCodec α n}

theorem length_eq {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) : xs.length = wide.2 := h.1

theorem window_le {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) : wide.1.offsetBytes + wide.2 * n ≤ bytes.length := h.2.1

/-- **`SliceTypedAt.unique`**: the slice view determines its element list. -/
theorem unique {wide : WidePtrVal} {xs₁ xs₂ : List α} {bytes : ByteMem}
    (h₁ : SliceTypedAt c wide xs₁ bytes) (h₂ : SliceTypedAt c wide xs₂ bytes) : xs₁ = xs₂ := by
  apply List.ext_getElem (h₁.1.trans h₂.1.symm)
  intro i hi₁ hi₂
  exact TypedAt.unique (h₁.2.2 i hi₁) (h₂.2.2 i hi₂)

/-- **`SliceTypedAt.getElem_typedAt`**: element `i < wide.2` is typed at its byte offset. -/
theorem getElem_typedAt {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {i : Nat} (hi : i < wide.2) :
    ∃ x, xs[i]? = some x ∧ TypedAt c (WidePtrVal.elemOffset wide n i) x bytes := by
  have hi' : i < xs.length := by rw [h.1]; exact hi
  exact ⟨xs[i], List.getElem?_eq_getElem hi', h.2.2 i hi'⟩

/-- Indexed form of `getElem_typedAt`. -/
theorem getElem_typedAt' {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {i : Nat} (hi : i < xs.length) :
    TypedAt c (WidePtrVal.elemOffset wide n i) xs[i] bytes :=
  h.2.2 i hi

/-- Out-of-bounds indices have no element. -/
theorem getElem?_eq_none_of_le {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {i : Nat} (hi : wide.2 ≤ i) : xs[i]? = none :=
  List.getElem?_eq_none (by rw [h.1]; exact hi)

/--
**`SliceTypedAt.splitAt`**: at any `k ≤ wide.2`, the slice splits into its prefix
`takeElems wide k` (`xs.take k`) and suffix `dropElems wide n k` (`xs.drop k`), whose byte
windows are adjacent and disjoint (`DisjointSlice.adjacent`).
-/
theorem splitAt {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {k : Nat} (hk : k ≤ wide.2) :
    SliceTypedAt c (WidePtrVal.takeElems wide k) (xs.take k) bytes ∧
      SliceTypedAt c (WidePtrVal.dropElems wide n k) (xs.drop k) bytes ∧
      DisjointSlice wide.1.offsetBytes (k * n) (wide.1.offsetBytes + k * n) ((wide.2 - k) * n) := by
  obtain ⟨hlen, hb, hel⟩ := h
  have hkn : k * n ≤ wide.2 * n := Nat.mul_le_mul_right n hk
  refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, DisjointSlice.adjacent _ _ _⟩
  · simp only [List.length_take, hlen]
    omega
  · show wide.1.offsetBytes + k * n ≤ bytes.length
    omega
  · intro i hi
    have hi' : i < xs.length := by
      simp only [List.length_take] at hi
      omega
    rw [List.getElem_take]
    exact hel i hi'
  · simp only [List.length_drop, hlen]
  · show wide.1.offsetBytes + k * n + (wide.2 - k) * n ≤ bytes.length
    rw [Nat.sub_mul]
    omega
  · intro i hi
    have hi' : k + i < xs.length := by
      simp only [List.length_drop] at hi
      omega
    rw [List.getElem_drop]
    have h₁ := hel (k + i) hi'
    show TypedAt c (wide.1.offsetBytes + k * n + i * n) xs[k + i] bytes
    rw [Nat.add_assoc, ← Nat.add_mul]
    exact h₁

/--
**`SliceTypedAt.append`**: a prefix of `k` elements at `p` and a suffix of `m` elements at
`p + k * n` (same allocation) reassemble into one slice of `k + m` elements.
-/
theorem append {p : ProvenancePtr} {k m : Nat} {xsL xsR : List α} {bytes : ByteMem}
    (hL : SliceTypedAt c (WidePtrVal.mk p k) xsL bytes)
    (hR : SliceTypedAt c (WidePtrVal.mk (WidePtrVal.elemPtr (WidePtrVal.mk p k) n k) m) xsR bytes) :
    SliceTypedAt c (WidePtrVal.mk p (k + m)) (xsL ++ xsR) bytes := by
  obtain ⟨hlenL, hbL, helL⟩ := hL
  obtain ⟨hlenR, hbR, helR⟩ := hR
  dsimp only [WidePtrVal.mk] at hlenL hlenR hbL hbR helL helR
  refine ⟨?_, ?_, ?_⟩
  · simp only [List.length_append, hlenL, hlenR]
  · show p.offsetBytes + (k + m) * n ≤ bytes.length
    rw [Nat.add_mul]
    simp only [WidePtrVal.elemOffset] at hbR
    omega
  · intro i hi
    show TypedAt c (p.offsetBytes + i * n) (xsL ++ xsR)[i] bytes
    by_cases hik : i < xsL.length
    · rw [List.getElem_append_left hik]
      exact helL i hik
    · have hi' : i - xsL.length < xsR.length := by
        simp only [List.length_append] at hi
        omega
      rw [List.getElem_append_right (by omega)]
      have h₁ := helR (i - xsL.length) hi'
      simp only [WidePtrVal.elemOffset] at h₁
      have heq : p.offsetBytes + k * n + (i - xsL.length) * n = p.offsetBytes + i * n := by
        rw [Nat.add_assoc, ← Nat.add_mul, hlenL, Nat.add_sub_cancel' (by omega)]
      rw [heq] at h₁
      exact h₁

/--
**`SliceTypedAt.of_splitAt`** (inverse of `splitAt`): typed prefix and suffix views at
`k ≤ wide.2` reassemble into the whole slice.
-/
theorem of_splitAt {wide : WidePtrVal} {k : Nat} {xsL xsR : List α} {bytes : ByteMem}
    (hk : k ≤ wide.2) (hL : SliceTypedAt c (WidePtrVal.takeElems wide k) xsL bytes)
    (hR : SliceTypedAt c (WidePtrVal.dropElems wide n k) xsR bytes) :
    SliceTypedAt c wide (xsL ++ xsR) bytes := by
  have h := append (p := wide.1) (k := k) (m := wide.2 - k) hL hR
  have hk' : k + (wide.2 - k) = wide.2 := by omega
  rw [hk'] at h
  exact h

/-- `splitAt` followed by `of_splitAt` recovers exactly the original view. -/
theorem splitAt_of_splitAt {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {k : Nat} (hk : k ≤ wide.2) :
    SliceTypedAt c wide (xs.take k ++ xs.drop k) bytes ∧ xs.take k ++ xs.drop k = xs := by
  obtain ⟨hL, hR, _⟩ := splitAt h hk
  exact ⟨of_splitAt hk hL hR, List.take_append_drop k xs⟩

/--
**`SliceTypedAt.write_elem`**: a successful typed write of `v` at element `i < wide.2`
updates the view to `xs.set i v`.
-/
theorem write_elem {wide : WidePtrVal} {xs : List α} {bytes bytes' : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {i : Nat} (hi : i < wide.2) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes') :
    SliceTypedAt c wide (xs.set i v) bytes' := by
  obtain ⟨hlen, hb, hel⟩ := h
  have hlen' := writeTyped_length hw
  have hin : wide.1.offsetBytes + i * n + n ≤ bytes.length := by
    have h₁ : (i + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hi
    rw [Nat.add_mul, Nat.one_mul] at h₁
    omega
  refine ⟨by rw [List.length_set]; exact hlen, by omega, ?_⟩
  intro j hj
  have hj' : j < xs.length := by rw [List.length_set] at hj; exact hj
  rw [List.getElem_set]
  by_cases hij : i = j
  · subst hij
    rw [ite_eq_left rfl]
    obtain ⟨m', hm', ht, _⟩ := TypedAt.read_write_same c v hin
    rw [hm'] at hw
    cases hw
    exact ht
  · rw [ite_eq_right hij]
    have hd : DisjointSlice (wide.1.offsetBytes + i * n) n (wide.1.offsetBytes + j * n) n := by
      unfold DisjointSlice
      rcases Nat.lt_or_gt_of_ne hij with hlt | hgt
      · have h₁ : (i + 1) * n ≤ j * n := Nat.mul_le_mul_right n hlt
        rw [Nat.add_mul, Nat.one_mul] at h₁
        omega
      · have h₁ : (j + 1) * n ≤ i * n := Nat.mul_le_mul_right n hgt
        rw [Nat.add_mul, Nat.one_mul] at h₁
        omega
    exact TypedAt.frame_write hd hw (hel j hj')

/-- **`SliceTypedAt.frame_writeBytes`**: a raw byte write disjoint from the slice window
preserves the whole slice view. -/
theorem frame_writeBytes {wide : WidePtrVal} {ys : List α} {bytes bytes' : ByteMem}
    {off : Nat} {w : ByteMem} (h : SliceTypedAt c wide ys bytes)
    (hd : DisjointSlice off w.length wide.1.offsetBytes (wide.2 * n))
    (hw : writeAbstractBytesAt bytes off w = some bytes') :
    SliceTypedAt c wide ys bytes' := by
  obtain ⟨hlen, hb, hel⟩ := h
  have hlen' : bytes'.length = bytes.length := by
    rcases writeAbstractBytesAt_some_inv hw with ⟨_, rfl⟩ | ⟨hle, rfl⟩
    · rfl
    · exact length_splice hle
  refine ⟨hlen, by omega, ?_⟩
  intro j hj
  have hjw : j < wide.2 := by omega
  have hjn : (j + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hjw
  rw [Nat.add_mul, Nat.one_mul] at hjn
  refine TypedAt.frame_writeBytes ?_ hw (hel j hj)
  unfold DisjointSlice at hd ⊢
  rcases hd with h0 | h0 | h0 | h0
  · exact Or.inl h0
  · exact Or.inr (Or.inl (by omega))
  · exact Or.inr (Or.inr (Or.inl (by omega)))
  · exact Or.inr (Or.inr (Or.inr (by omega)))

/-- **`SliceTypedAt.frame_write`**: a typed write disjoint from the slice window preserves
the whole slice view. -/
theorem frame_write {β : Type} {n₁ : Nat} {c₁ : ByteLensCodec β n₁} {base₁ : Nat} {v₁ : β}
    {wide : WidePtrVal} {ys : List α} {bytes bytes' : ByteMem}
    (h : SliceTypedAt c wide ys bytes)
    (hd : DisjointSlice base₁ n₁ wide.1.offsetBytes (wide.2 * n))
    (hw : writeTyped c₁ base₁ v₁ bytes = some bytes') :
    SliceTypedAt c wide ys bytes' :=
  frame_writeBytes h (by rw [c₁.encode_len]; exact hd) hw

/--
**`split_at_mut` write law**: writing element `i < k` of the left half updates the left
view to `(xs.take k).set i v`, leaves the right view `xs.drop k` intact, and the halves
reassemble into the direct update `xs.set i v`.
-/
theorem write_left_reassemble {wide : WidePtrVal} {xs : List α} {bytes bytes' : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {k i : Nat} (hk : k ≤ wide.2) (hi : i < k) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes') :
    SliceTypedAt c (WidePtrVal.takeElems wide k) ((xs.take k).set i v) bytes' ∧
      SliceTypedAt c (WidePtrVal.dropElems wide n k) (xs.drop k) bytes' ∧
      SliceTypedAt c wide (xs.set i v) bytes' := by
  obtain ⟨hL, hR, _⟩ := splitAt h hk
  have hL' : SliceTypedAt c (WidePtrVal.takeElems wide k) ((xs.take k).set i v) bytes' :=
    write_elem hL hi v hw
  have hR' : SliceTypedAt c (WidePtrVal.dropElems wide n k) (xs.drop k) bytes' := by
    refine frame_write hR ?_ hw
    unfold DisjointSlice
    have h₁ : (i + 1) * n ≤ k * n := Nat.mul_le_mul_right n hi
    rw [Nat.add_mul, Nat.one_mul] at h₁
    right; right; left
    simp only [WidePtrVal.elemOffset]
    omega
  refine ⟨hL', hR', ?_⟩
  have hfull := of_splitAt hk hL' hR'
  have hset : (xs.take k).set i v ++ xs.drop k = xs.set i v := by
    have hlt : i < (xs.take k).length := by
      rw [List.length_take]
      have := h.1
      omega
    rw [← List.set_append_left i v hlt, List.take_append_drop]
  rw [hset] at hfull
  exact hfull

/-- **`split_at_mut` write law (right half)**: writing element `j` of the right half
(absolute index `k + j`) leaves the left view intact. -/
theorem write_right_reassemble {wide : WidePtrVal} {xs : List α} {bytes bytes' : ByteMem}
    (h : SliceTypedAt c wide xs bytes) {k j : Nat} (hk : k ≤ wide.2) (hj : k + j < wide.2)
    (v : α) (hw : writeTyped c (WidePtrVal.elemOffset wide n (k + j)) v bytes = some bytes') :
    SliceTypedAt c (WidePtrVal.takeElems wide k) (xs.take k) bytes' ∧
      SliceTypedAt c (WidePtrVal.dropElems wide n k) ((xs.drop k).set j v) bytes' ∧
      SliceTypedAt c wide (xs.set (k + j) v) bytes' := by
  obtain ⟨hL, hR, _⟩ := splitAt h hk
  have hR' : SliceTypedAt c (WidePtrVal.dropElems wide n k) ((xs.drop k).set j v) bytes' := by
    refine write_elem hR (by show j < wide.2 - k; omega) v ?_
    rw [WidePtrVal.elemOffset_dropElems]
    exact hw
  have hL' : SliceTypedAt c (WidePtrVal.takeElems wide k) (xs.take k) bytes' := by
    refine frame_write hL ?_ hw
    unfold DisjointSlice
    right; right; right
    simp only [WidePtrVal.elemOffset]
    have h₁ : k * n ≤ (k + j) * n := Nat.mul_le_mul_right n (Nat.le_add_right k j)
    omega
  refine ⟨hL', hR', ?_⟩
  have hfull := of_splitAt hk hL' hR'
  have hlen : (xs.take k).length = k := by
    rw [List.length_take]; have := h.1; omega
  have hset : xs.take k ++ (xs.drop k).set j v = xs.set (k + j) v := by
    have hle : (xs.take k).length ≤ k + j := by omega
    have h₁ := List.set_append_right (s := xs.take k) (t := xs.drop k) (k + j) v hle
    rw [List.take_append_drop, hlen, Nat.add_sub_cancel_left] at h₁
    exact h₁.symm
  rw [hset] at hfull
  exact hfull

end SliceTypedAt

/-! ### Zero-sized and empty slices -/

/-- **Empty slices** are typed at every in-bounds data pointer with any codec. -/
theorem sliceTypedAt_empty {α : Type} {n : Nat} (c : ByteLensCodec α n) (p : ProvenancePtr)
    (bytes : ByteMem) (h : p.offsetBytes ≤ bytes.length) :
    SliceTypedAt c (WidePtrVal.mk p 0) [] bytes :=
  ⟨rfl, by rw [widePtr_proj_snd, Nat.zero_mul, Nat.add_zero]; exact h,
    fun i hi => absurd hi (Nat.not_lt_zero i)⟩

/-- **ZST slices** (`n = 0`): any length of `()` elements is typed at an in-bounds pointer;
no byte is consumed and no division by the element size occurs. -/
theorem sliceTypedAt_unit_replicate (p : ProvenancePtr) (len : Nat) (bytes : ByteMem)
    (h : p.offsetBytes ≤ bytes.length) :
    SliceTypedAt ByteLensCodec.unit (WidePtrVal.mk p len) (List.replicate len ()) bytes := by
  refine ⟨?_, ?_, ?_⟩
  · simp
  · show p.offsetBytes + len * 0 ≤ bytes.length
    rw [Nat.mul_zero, Nat.add_zero]
    exact h
  · intro i hi
    show TypedAt ByteLensCodec.unit (p.offsetBytes + i * 0) (List.replicate len ())[i] bytes
    rw [typedAt_zero_width_iff, Nat.mul_zero, Nat.add_zero]
    refine ⟨h, ?_⟩
    rw [List.getElem_replicate]
    rfl


/-! ### Live global allocations: the trusted byte view -/

/-- The trusted per-byte conversion of `globalAllocBytesAux` at absolute offset `i`
(`.uninit` for an uninitialized byte, `.init b prov` with relocation provenance). -/
def globalAbsByteAt (bytes : List (Option UInt8)) (relocs : List (Nat × ProvenancePtr))
    (i : Nat) : Option AbstractByte :=
  match get? bytes i with
  | none => none
  | some optByte =>
    some (match optByte with
      | none => AbstractByte.uninit
      | some b =>
        AbstractByte.init b
          (match lookupRelocAllocId relocs i with
           | some targetPtr => some (targetPtr.allocId, targetPtr.tag)
           | none => none))

theorem globalAllocBytesAux_spec (bytes : List (Option UInt8))
    (relocs : List (Nat × ProvenancePtr)) :
    ∀ (rem off : Nat), off + rem ≤ bytes.length →
      ∃ out, globalAllocBytesAux bytes relocs off rem = some out ∧ out.length = rem ∧
        ∀ (j : Nat) (hj : j < out.length), some out[j] = globalAbsByteAt bytes relocs (off + j)
  | 0, _, _ => ⟨[], rfl, rfl, fun j hj => absurd hj (Nat.not_lt_zero j)⟩
  | rem + 1, off, h => by
    obtain ⟨out, hout, hlen, hel⟩ := globalAllocBytesAux_spec bytes relocs rem (off + 1) (by omega)
    have hlt : off < bytes.length := by omega
    have hget : get? bytes off = some bytes[off] := by
      unfold get?
      exact List.getElem?_eq_getElem hlt
    refine ⟨(match bytes[off] with
        | none => AbstractByte.uninit
        | some b =>
          AbstractByte.init b
            (match lookupRelocAllocId relocs off with
             | some targetPtr => some (targetPtr.allocId, targetPtr.tag)
             | none => none)) :: out, ?_, ?_, ?_⟩
    · unfold globalAllocBytesAux
      rw [hget]
      dsimp only
      rw [show Nat.add off 1 = off + 1 from rfl, hout]
      rfl
    · simp only [List.length_cons, hlen]
    · intro j hj
      cases j with
      | zero =>
        unfold globalAbsByteAt
        rw [Nat.add_zero, hget]
        rfl
      | succ j =>
        have hj' : j < out.length := by simp only [List.length_cons] at hj; omega
        rw [List.getElem_cons_succ, hel j hj', Nat.add_assoc, Nat.add_comm 1 j]

/-- **Trusted byte view of a captured global allocation**: the whole allocation read
through the trusted `globalAllocSliceToAbstractBytes` (relocation provenance included). -/
def globalAllocByteMem (alloc : CapturedAllocation) : ByteMem :=
  (globalAllocSliceToAbstractBytes alloc 0 (length alloc.bytes)).getD []

private theorem globalAllocByteMem_spec (alloc : CapturedAllocation) :
    (globalAllocByteMem alloc).length = alloc.bytes.length ∧
      ∀ (j : Nat) (hj : j < (globalAllocByteMem alloc).length),
        some (globalAllocByteMem alloc)[j] = globalAbsByteAt alloc.bytes alloc.relocations j := by
  obtain ⟨out, hout, hlen, hel⟩ :=
    globalAllocBytesAux_spec alloc.bytes alloc.relocations alloc.bytes.length 0 (by omega)
  have h : globalAllocSliceToAbstractBytes alloc 0 (length alloc.bytes) = some out := by
    unfold globalAllocSliceToAbstractBytes
    rw [show Nat.ble 0 (length alloc.bytes) = true from Nat.ble_eq_true_of_le (Nat.zero_le _)]
    exact hout
  have hm : globalAllocByteMem alloc = out := by
    unfold globalAllocByteMem
    rw [h]
    rfl
  rw [hm]
  refine ⟨hlen, fun j hj => ?_⟩
  rw [hel j hj, Nat.zero_add]

theorem globalAllocByteMem_length (alloc : CapturedAllocation) :
    (globalAllocByteMem alloc).length = alloc.bytes.length :=
  (globalAllocByteMem_spec alloc).1

/--
**Deref-slice byte-read bridge**: every in-bounds trusted global byte read
`globalAllocSliceToAbstractBytes alloc off len` returns exactly the window
`[off, off + len)` of `globalAllocByteMem alloc`.
-/
theorem globalAllocSliceToAbstractBytes_eq_window (alloc : CapturedAllocation) (off len : Nat)
    (h : off + len ≤ alloc.bytes.length) :
    globalAllocSliceToAbstractBytes alloc off len =
      some (((globalAllocByteMem alloc).drop off).take len) := by
  obtain ⟨out, hout, hlen, hel⟩ :=
    globalAllocBytesAux_spec alloc.bytes alloc.relocations len off h
  obtain ⟨hfl, hfel⟩ := globalAllocByteMem_spec alloc
  unfold globalAllocSliceToAbstractBytes
  rw [show Nat.ble off (length alloc.bytes) = true from Nat.ble_eq_true_of_le (by
    show off ≤ alloc.bytes.length; omega)]
  dsimp only
  rw [hout]
  congr 1
  apply List.ext_getElem
  · simp only [List.length_take, List.length_drop, hfl, hlen]
    omega
  · intro j hj₁ hj₂
    have h₁ := hel j hj₁
    have hj₃ : off + j < (globalAllocByteMem alloc).length := by
      simp only [List.length_take, List.length_drop] at hj₂
      omega
    have h₂ := hfel (off + j) hj₃
    rw [List.getElem_take, List.getElem_drop]
    rw [← h₂] at h₁
    exact Option.some.inj h₁

private theorem globalAllocBytesAux_bound (bytes : List (Option UInt8))
    (relocs : List (Nat × ProvenancePtr)) :
    ∀ (rem off : Nat) (out : List AbstractByte),
      globalAllocBytesAux bytes relocs off rem = some out → off ≤ bytes.length →
        off + rem ≤ bytes.length
  | 0, off, _, _, h => by omega
  | rem + 1, off, out, h, _ => by
    unfold globalAllocBytesAux at h
    cases hg : get? bytes off with
    | none => rw [hg] at h; cases h
    | some ob =>
      rw [hg] at h
      dsimp only at h
      cases hr : globalAllocBytesAux bytes relocs (Nat.add off 1) rem with
      | none => rw [hr] at h; cases h
      | some rest =>
        have hlt : off < bytes.length := by
          unfold get? at hg
          by_cases hc : off < bytes.length
          · exact hc
          · rw [List.getElem?_eq_none (by omega)] at hg
            cases hg
        have := globalAllocBytesAux_bound bytes relocs rem (off + 1) rest hr (by omega)
        omega

/-- **Typed deref read bridge**: `TypedAt` over the trusted global byte view is exactly a
successful trusted global byte read followed by the codec's decoder. -/
theorem typedAt_globalAllocByteMem_iff {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (alloc : CapturedAllocation) (off : Nat) (x : α) :
    TypedAt c off x (globalAllocByteMem alloc) ↔
      ∃ w, globalAllocSliceToAbstractBytes alloc off n = some w ∧ c.decode w = some x := by
  rw [typedAt_iff, globalAllocByteMem_length]
  constructor
  · rintro ⟨hb, hd⟩
    exact ⟨_, globalAllocSliceToAbstractBytes_eq_window alloc off n hb, hd⟩
  · rintro ⟨w, hw, hd⟩
    have hle : off ≤ alloc.bytes.length := by
      unfold globalAllocSliceToAbstractBytes at hw
      cases hle : Nat.ble off (length alloc.bytes) with
      | false => rw [hle] at hw; cases hw
      | true => exact Nat.le_of_ble_eq_true hle
    have hb : off + n ≤ alloc.bytes.length := by
      unfold globalAllocSliceToAbstractBytes at hw
      rw [show Nat.ble off (length alloc.bytes) = true from Nat.ble_eq_true_of_le hle] at hw
      exact globalAllocBytesAux_bound _ _ n off w hw hle
    rw [globalAllocSliceToAbstractBytes_eq_window alloc off n hb] at hw
    cases hw
    exact ⟨hb, hd⟩

/-! ### Trusted `Rvalue.len (*slice)` and `UnOp.ptrMetadata` -/

/--
**`WidePtrVal.evalRvalue_ptrMetadata`**: `PtrMetadata(op)` of an operand evaluating to the
trusted fat pointer of `wide` is `.scalar ⟨wide.2, ptrBytes⟩`.

`hOp` is the operand evaluation `evalRvalue` itself performs, against the memory's active inline
call stack `mem.callStack`.
-/
theorem WidePtrVal.evalRvalue_ptrMetadata (locals locals' : List LocalSlot) (op : Operand)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable) (wide : WidePtrVal)
    (hOp : evalOperand locals op mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals') :
    evalRvalue locals (.unaryOp .ptrMetadata op) mem localDecls layouts =
      .ok (.scalar ⟨wide.2, layoutPointerBytes layouts⟩) locals' mem := by
  show evalUnaryPtrMetadata locals op mem localDecls layouts = _
  unfold evalUnaryPtrMetadata
  simp only [hOp, WidePtrVal.toValue, Nat.beq_refl, Bool.and_self]

/--
**`WidePtrVal.evalRvalue_len`**: `Len(*p)` where `p` reads the trusted fat pointer of
`wide` into a captured global allocation (no stack borrow under the tag) evaluates to
`.scalar ⟨wide.2, ptrBytes⟩` whenever the `wide.2`-element window of `n`-byte elements fits
the allocation.

`hRead` is the fat-pointer place read `evalPlaceLen` itself performs, against the memory's
active inline call stack `mem.callStack`.
-/
theorem WidePtrVal.evalRvalue_len (locals locals' : List LocalSlot) (place : Place)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (initProj : List ProjectionElem) (elem : RigidTy) (lIdx : LayoutIdx)
    (alloc : CapturedAllocation) (n : Nat) (wide : WidePtrVal)
    (hTy : placeTy localDecls layouts place = some { kind := .slice elem, layoutIdx := lIdx })
    (hSplit : splitLastDeref? place.projection = some initProj)
    (hRead : evalPlaceRead locals { local_ := place.local_, projection := initProj } mem.borrows
      mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hSz : tyByteSize localDecls layouts
      { kind := elem, layoutIdx := unresolvedLayoutIdx layouts } = some n)
    (hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length) :
    evalRvalue locals (.len place) mem localDecls layouts =
      .ok (.scalar ⟨wide.2, layoutPointerBytes layouts⟩) locals' mem := by
  have hb : Nat.ble (Nat.add wide.1.offsetBytes (Nat.mul wide.2 n)) (length alloc.bytes) = true :=
    Nat.ble_eq_true_of_le hFit
  show evalPlaceLen locals place mem localDecls layouts = _
  unfold evalPlaceLen
  simp only [hTy, hSplit, hRead, WidePtrVal.toValue, hNoBorrow, hAlloc, hSz, Nat.beq_refl,
    Bool.true_and, Bool.and_true, Bool.and_self]
  split
  · rfl
  · rename_i heq
    rw [hb] at heq
    contradiction

/--
**`SliceTypedAt.len_eq`**: for a slice view over the live global allocation `alloc` of
`wide.1`, both `Len(*p)` and `PtrMetadata(p)` evaluate in the trusted semantics to
`.scalar ⟨xs.length, ptrBytes⟩` (`= .scalar ⟨wide.2, ptrBytes⟩`), where `p`'s place read
and operand both yield the fat pointer of `wide` and the slice element type has byte size
`n` (the codec width). Both reads are the ones the trusted evaluator performs, against the
memory's active inline call stack `mem.callStack`.
-/
theorem SliceTypedAt.len_eq {α : Type} {n : Nat} {c : ByteLensCodec α n} {wide : WidePtrVal}
    {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (locals locals' : List LocalSlot) (place : Place) (ptrOp : Operand) (mem : Memory)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (initProj : List ProjectionElem) (elem : RigidTy) (lIdx : LayoutIdx)
    (hTy : placeTy localDecls layouts place = some { kind := .slice elem, layoutIdx := lIdx })
    (hSplit : splitLastDeref? place.projection = some initProj)
    (hRead : evalPlaceRead locals { local_ := place.local_, projection := initProj } mem.borrows
      mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hOp : evalOperand locals ptrOp mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hSz : tyByteSize localDecls layouts
      { kind := elem, layoutIdx := unresolvedLayoutIdx layouts } = some n) :
    evalRvalue locals (.len place) mem localDecls layouts =
        .ok (.scalar ⟨xs.length, layoutPointerBytes layouts⟩) locals' mem ∧
      evalRvalue locals (.unaryOp .ptrMetadata ptrOp) mem localDecls layouts =
        .ok (.scalar ⟨xs.length, layoutPointerBytes layouts⟩) locals' mem := by
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  rw [h.1]
  exact ⟨WidePtrVal.evalRvalue_len locals locals' place mem localDecls layouts initProj elem lIdx
      alloc n wide hTy hSplit hRead hNoBorrow hAlloc hSz hFit,
    WidePtrVal.evalRvalue_ptrMetadata locals locals' ptrOp mem localDecls layouts wide hOp⟩


/-! ### Fixed-size array codec and `PointerCoercion("Unsize")` -/

namespace ByteLensCodec

/-- Decode exactly `N` consecutive `n`-byte elements (rejecting leftover bytes). -/
def decodeElems {α : Type} {n : Nat} (c : ByteLensCodec α n) :
    Nat → List AbstractByte → Option (List α)
  | 0, bs =>
    match bs with
    | [] => some []
    | _ :: _ => none
  | N + 1, bs =>
    match c.decode (bs.take n), decodeElems c N (bs.drop n) with
    | some x, some xs => some (x :: xs)
    | _, _ => none

/-- Concatenated element encodings. -/
def encodeElems {α : Type} {n : Nat} (c : ByteLensCodec α n) : List α → List AbstractByte
  | [] => []
  | x :: xs => c.encode x ++ encodeElems c xs

theorem decodeElems_length {α : Type} {n : Nat} (c : ByteLensCodec α n) :
    ∀ (N : Nat) (bs : List AbstractByte) (xs : List α), decodeElems c N bs = some xs →
      xs.length = N
  | 0, [], xs, h => by cases h; rfl
  | 0, _ :: _, _, h => by cases h
  | N + 1, bs, xs, h => by
    unfold decodeElems at h
    cases hx : c.decode (bs.take n) with
    | none => rw [hx] at h; cases h
    | some x =>
      cases hxs : decodeElems c N (bs.drop n) with
      | none => rw [hx, hxs] at h; cases h
      | some xs' =>
        rw [hx, hxs] at h
        cases h
        simp only [List.length_cons, decodeElems_length c N _ xs' hxs]

theorem encodeElems_length {α : Type} {n : Nat} (c : ByteLensCodec α n) :
    ∀ xs : List α, (encodeElems c xs).length = xs.length * n
  | [] => by simp [encodeElems]
  | x :: xs => by
    simp only [encodeElems, List.length_append, c.encode_len, encodeElems_length c xs,
      List.length_cons, Nat.succ_mul]
    omega

theorem decodeElems_encodeElems {α : Type} {n : Nat} (c : ByteLensCodec α n) :
    ∀ xs : List α, decodeElems c xs.length (encodeElems c xs) = some xs
  | [] => rfl
  | x :: xs => by
    show (match c.decode ((c.encode x ++ encodeElems c xs).take n),
        decodeElems c xs.length ((c.encode x ++ encodeElems c xs).drop n) with
      | some x, some xs => some (x :: xs)
      | _, _ => none) = _
    rw [List.take_left' (c.encode_len x), List.drop_left' (c.encode_len x), c.decode_encode,
      decodeElems_encodeElems c xs]

/-- **Fixed-size array codec `[T; N]`**: `N` consecutive `n`-byte elements. -/
def array {α : Type} {n : Nat} (c : ByteLensCodec α n) (N : Nat) :
    ByteLensCodec {xs : List α // xs.length = N} (N * n) where
  encode xs := encodeElems c xs.val
  decode bs := (decodeElems c N bs).bind fun xs =>
    if h : xs.length = N then some ⟨xs, h⟩ else none
  encode_len xs := by rw [encodeElems_length, xs.property]
  decode_encode xs := by
    show (decodeElems c N (encodeElems c xs.val)).bind _ = _
    have h := decodeElems_encodeElems c xs.val
    rw [xs.property] at h
    rw [h]
    show (if h : xs.val.length = N then some ⟨xs.val, h⟩ else none) = some xs
    rw [dite_eq_left xs.property]

end ByteLensCodec

/-- Element-wise reading of a decoded array window. -/
theorem sliceTypedAt_of_decodeElems {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (aid : AllocId) :
    ∀ (N base : Nat) (xs : List α) (bytes : ByteMem), base + N * n ≤ bytes.length →
      ByteLensCodec.decodeElems c N ((bytes.drop base).take (N * n)) = some xs →
      SliceTypedAt c (WidePtrVal.mk ⟨aid, base⟩ N) xs bytes
  | 0, base, xs, bytes, hb, h => by
    rw [Nat.zero_mul, List.take_zero] at h
    cases h
    exact ⟨rfl, by show base + 0 * n ≤ bytes.length; omega,
      fun i hi => absurd hi (Nat.not_lt_zero i)⟩
  | N + 1, base, xs, bytes, hb, h => by
    have hsplit : (N + 1) * n = n + N * n := by rw [Nat.succ_mul, Nat.add_comm]
    have h1 : ((bytes.drop base).take ((N + 1) * n)).take n = (bytes.drop base).take n := by
      rw [List.take_take, Nat.min_eq_left (by rw [hsplit]; exact Nat.le_add_right n (N * n))]
    have h2 : ((bytes.drop base).take ((N + 1) * n)).drop n =
        (bytes.drop (base + n)).take (N * n) := by
      rw [hsplit, drop_take_add, List.drop_drop]
    unfold ByteLensCodec.decodeElems at h
    rw [h1, h2] at h
    cases hx : c.decode ((bytes.drop base).take n) with
    | none => rw [hx] at h; cases h
    | some x =>
      cases hxs : ByteLensCodec.decodeElems c N ((bytes.drop (base + n)).take (N * n)) with
      | none => rw [hx, hxs] at h; cases h
      | some xs' =>
        rw [hx, hxs] at h
        cases h
        have hb' : base + n + N * n ≤ bytes.length := by rw [hsplit] at hb; omega
        have ih := sliceTypedAt_of_decodeElems c aid N (base + n) xs' bytes hb' hxs
        obtain ⟨hlen, _, hel⟩ := ih
        refine ⟨?_, ?_, ?_⟩
        · simp only [List.length_cons, hlen]
        · show base + (N + 1) * n ≤ bytes.length
          exact hb
        · intro i hi
          cases i with
          | zero =>
            show TypedAt c (base + 0 * n) x bytes
            rw [Nat.zero_mul, Nat.add_zero, typedAt_iff]
            exact ⟨by rw [hsplit] at hb; omega, hx⟩
          | succ j =>
            have hj : j < xs'.length := by simp only [List.length_cons] at hi; omega
            have := hel j hj
            show TypedAt c (base + (j + 1) * n) xs'[j] bytes
            rw [show base + (j + 1) * n = base + n + j * n by rw [Nat.succ_mul]; omega]
            exact this

/-- A `ByteLensCodec.array`-typed window is a `SliceTypedAt` slice of the same elements. -/
theorem SliceTypedAt.of_typedAt_array {α : Type} {n N : Nat} {c : ByteLensCodec α n}
    {p : ProvenancePtr} {xs : {xs : List α // xs.length = N}} {bytes : ByteMem}
    (h : TypedAt (c.array N) p.offsetBytes xs bytes) :
    SliceTypedAt c (WidePtrVal.mk p N) xs.val bytes := by
  rw [typedAt_iff] at h
  obtain ⟨hb, hd⟩ := h
  have hd' : ByteLensCodec.decodeElems c N ((bytes.drop p.offsetBytes).take (N * n)) = some xs.val := by
    revert hd
    show ((ByteLensCodec.decodeElems c N ((bytes.drop p.offsetBytes).take (N * n))).bind fun ys =>
      if h : ys.length = N then some ⟨ys, h⟩ else none) = some xs → _
    cases hdec : ByteLensCodec.decodeElems c N ((bytes.drop p.offsetBytes).take (N * n)) with
    | none => intro h; cases h
    | some ys =>
      intro h
      have hlen := ByteLensCodec.decodeElems_length c N _ ys hdec
      rw [Option.bind_some, dite_eq_left hlen] at h
      cases h
      rfl
  exact sliceTypedAt_of_decodeElems c p.allocId N p.offsetBytes xs.val bytes hb hd'

/-- Slice pointer target kinds `&[T]` / `&mut [T]` / `*const [T]` / `*mut [T]`. -/
@[reducible]
def slicePtrKind (isRef : Bool) (m : Mutability) (elem : RigidTy) : RigidTy :=
  match isRef with
  | true => .ref m (.slice elem)
  | false => .rawPtr m (.slice elem)

/--
**`TypedAt.unsize_array_to_slice`**: if the captured global allocation `alloc` holds a
`[T; N]` array `xs` at `p` (`TypedAt (c.array N) p.offsetBytes xs`), then the trusted
`PointerCoercion("Unsize")` of the thin array pointer `p` to a slice pointer evaluates to
the fat pointer `WidePtrVal.toValue ptrBytes (p, N)`, and that fat pointer carries the
slice view `SliceTypedAt c (p, N) xs` with `wide.2 = N`.
-/
theorem TypedAt.unsize_array_to_slice {α : Type} {n N : Nat} {c : ByteLensCodec α n}
    {xs : {xs : List α // xs.length = N}} {alloc : CapturedAllocation}
    (locals locals' : List LocalSlot) (op : Operand) (mem : Memory)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (isRef : Bool) (m : Mutability) (dstElem : RigidTy) (dstLIdx : LayoutIdx) (srcTy : Ty)
    (p : ProvenancePtr)
    (hOp : evalOperand locals op mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok (.ptr p (layoutPointerBytes layouts)) locals')
    (hNoBorrow : lookupBorrow mem.borrows p.tag = none)
    (hTy : operandTy localDecls layouts op = some srcTy)
    (hSpec : unsizeArrayToSliceSpec? srcTy.kind (slicePtrKind isRef m dstElem) = some N)
    (hAlloc : lookupGlobalAlloc mem.globals p.allocId = some alloc)
    (hMut : m = .mut → alloc.mutability = .mut)
    (hSz : tyByteSize localDecls layouts
      { kind := dstElem, layoutIdx := unresolvedLayoutIdx layouts } = some n)
    (hAlign : (byteOffsetToElemIdx? p.offsetBytes n).isSome = true)
    (hArr : TypedAt (c.array N) p.offsetBytes xs (globalAllocByteMem alloc)) :
    evalRvalue locals (.cast (.pointerCoercion "Unsize") op
        { kind := slicePtrKind isRef m dstElem, layoutIdx := dstLIdx }) mem localDecls layouts =
      .ok (WidePtrVal.toValue (layoutPointerBytes layouts) (WidePtrVal.mk p N)) locals' mem ∧
    SliceTypedAt c (WidePtrVal.mk p N) xs.val (globalAllocByteMem alloc) := by
  have hSl := SliceTypedAt.of_typedAt_array hArr
  refine ⟨?_, hSl⟩
  have hFit : p.offsetBytes + N * n ≤ alloc.bytes.length := by
    have := hSl.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hb : Nat.ble (Nat.add p.offsetBytes (Nat.mul N n)) (length alloc.bytes) = true :=
    Nat.ble_eq_true_of_le hFit
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.mp hAlign
  have hNoBorrow' : lookupBorrow mem.borrows p.allocId = none := hNoBorrow
  show evalReifyFnPointer locals op _ mem localDecls layouts "Unsize" = _
  unfold evalReifyFnPointer
  rw [show isReifyFnPointerCoercion "Unsize" = false from rfl]
  dsimp only
  rw [show stringEq "Unsize" "Unsize" = true from rfl]
  dsimp only
  unfold evalUnsizeCoercion
  cases isRef <;> cases m <;>
    simp only [slicePtrKind, hOp, Nat.beq_refl, hNoBorrow', hTy, hSpec, hAlloc, hSz, hk, hb,
      Bool.and_true, Bool.and_self, ProvenancePtr.tag, WidePtrVal.toValue] at hSpec ⊢ <;>
    first
    | rfl
    | rw [hMut rfl]

/-! ### Borrow-checked slice lenses (`&[T]` / `&mut [T]`) -/

/-- Tree Borrows read permission of a tag: a child read through it is not UB (every state
except `.disabled`), per the trusted `treeBorrowNodeAccess`. -/
def TreeBorrowPerm.PermitsRead (p : TreeBorrowPerm) : Prop :=
  treeBorrowTransitionIsUB (treeBorrowNodeAccess .read .localAccess p false) = false

/-- Tree Borrows unique-write permission of a `&mut [T]` tag: a child write through it
succeeds and leaves the tag `.unique`, protected or not (`unique`, `reservedFrz false`,
`reservedIM`; never `cell`, `frozen`, `disabled`, or a conflicted reservation). -/
def TreeBorrowPerm.PermitsUniqueWrite (p : TreeBorrowPerm) : Prop :=
  ∀ prot : Bool, treeBorrowNodeAccess .write .localAccess p prot = .transition .unique

theorem TreeBorrowPerm.permitsRead_of_permitsUniqueWrite {p : TreeBorrowPerm}
    (h : TreeBorrowPerm.PermitsUniqueWrite p) : TreeBorrowPerm.PermitsRead p := by
  have h₀ := h false
  cases p <;> first | rfl | (simp [treeBorrowNodeAccess, treeBorrowPermTransition,
    treeBorrowChildWrite] at h₀)

/-- A child write keeps the unique-write permission (`.unique` is a fixed point). -/
theorem TreeBorrowPerm.permitsUniqueWrite_unique : TreeBorrowPerm.PermitsUniqueWrite .unique := by
  intro prot
  rfl

/-- The byte range `[entry.rangeOffset, entry.rangeOffset + entry.rangeLen)` of a byte-ranged
trusted `BorrowEntry` contains the window `[base, base + len)`.

This is deliberately conservative for projection-governed entries (`rangeLen = 0`, whose
extent is fixed by `targetProjection` rather than by a byte range): such an entry covers only
the empty window at `rangeOffset`, so coverage is never claimed beyond the recorded bytes. -/
def BorrowRangeCovers (entry : BorrowEntry) (base len : Nat) : Prop :=
  entry.rangeOffset ≤ base ∧ base + len ≤ entry.rangeOffset + entry.rangeLen

/--
**`&[T]` lens.** `xs` is the `SliceTypedAt` view of `wide` over the allocation image
`bytes`, and borrow tag `tag` names a trusted `BorrowEntry` in `borrows` whose byte range
covers the slice window `[wide.1.offsetBytes, wide.1.offsetBytes + wide.2 * n)` with Tree
Borrows read permission.

Scope: this is a *logical* permission lens over byte-ranged entries, stated with the trusted
lookup (`lookupBorrow`), permission transitions (`treeBorrowNodeAccess`,
`invalidateTreeBorrowsAtProj`) and overlap test (`borrowEntryOverlapsWrite`). It is not a
claim about the evaluator's own borrow bookkeeping: trusted global-backed slice pointers carry
no borrow entry at all (`len_eq` / `evalPlaceRead_index` require
`lookupBorrow mem.borrows wide.1.tag = none`), and trusted reborrows of stack slices create
projection-governed entries (`rangeLen = 0`) or inherit the parent's byte range. `tag` is
therefore a separate parameter, not `wide.1.tag`; `LiveSliceImage` ties `bytes` to `Memory`.
-/
def ActiveTypedSliceBorrow {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (borrows : List BorrowEntry) (tag : Nat) (wide : WidePtrVal) (xs : List α)
    (bytes : ByteMem) : Prop :=
  SliceTypedAt c wide xs bytes ∧
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      BorrowRangeCovers entry wide.1.offsetBytes (wide.2 * n) ∧
      TreeBorrowPerm.PermitsRead entry.perm

/--
**`&mut [T]` lens.** As `ActiveTypedSliceBorrow`, with Tree Borrows unique-write
permission (`TreeBorrowPerm.PermitsUniqueWrite`).
-/
def ActiveTypedSliceMutBorrow {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (borrows : List BorrowEntry) (tag : Nat) (wide : WidePtrVal) (xs : List α)
    (bytes : ByteMem) : Prop :=
  SliceTypedAt c wide xs bytes ∧
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      BorrowRangeCovers entry wide.1.offsetBytes (wide.2 * n) ∧
      TreeBorrowPerm.PermitsUniqueWrite entry.perm

/-- The live byte image of `wide`'s captured global allocation in `mem`. -/
def LiveSliceImage (mem : Memory) (wide : WidePtrVal) (bytes : ByteMem) : Prop :=
  ∃ alloc, lookupGlobalAlloc mem.globals wide.1.allocId = some alloc ∧
    bytes = globalAllocByteMem alloc

/-- A unique-write slice lens is in particular a shared (read) slice lens. -/
theorem ActiveTypedSliceMutBorrow.toShared {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {borrows : List BorrowEntry} {tag : Nat} {wide : WidePtrVal} {xs : List α}
    {bytes : ByteMem} (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes) :
    ActiveTypedSliceBorrow c borrows tag wide xs bytes := by
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  exact ⟨hs, entry, he, hc, TreeBorrowPerm.permitsRead_of_permitsUniqueWrite hp⟩

/--
**`ActiveTypedSliceMutBorrow.write_elem_frame`**: writing `v` at element `i < wide.2`
through the unique-write tag updates the lens to `xs.set i v` (same tag, same
permission), and preserves every `SliceTypedAt` frame whose window is disjoint from the
borrowed slice window (in particular the other half of a `split_at_mut`).
-/
theorem ActiveTypedSliceMutBorrow.write_elem_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry} {tag : Nat}
    {wide wide' : WidePtrVal} {xs : List α} {ys : List β} {bytes bytes' : ByteMem}
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes) {i : Nat} (hi : i < wide.2)
    (v : α) (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hframe : SliceTypedAt c' wide' ys bytes)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m)) :
    ActiveTypedSliceMutBorrow c borrows tag wide (xs.set i v) bytes' ∧
      SliceTypedAt c' wide' ys bytes' := by
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  refine ⟨⟨SliceTypedAt.write_elem hs hi v hw, entry, he, hc, hp⟩, ?_⟩
  refine SliceTypedAt.frame_write hframe ?_ hw
  have hin : (i + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hi
  rw [Nat.add_mul, Nat.one_mul] at hin
  unfold DisjointSlice at hdisj ⊢
  simp only [WidePtrVal.elemOffset]
  rcases hdisj with h0 | h0 | h0 | h0
  · exact Or.inl (by omega)
  · exact Or.inr (Or.inl h0)
  · exact Or.inr (Or.inr (Or.inl (by omega)))
  · exact Or.inr (Or.inr (Or.inr (by omega)))

/--
**`ActiveTypedSliceMutBorrow.splitAt`** (`split_at_mut`): at any `k ≤ wide.2` a mutable
slice lens splits into two mutable lenses on the prefix and suffix subslices, whose byte
windows are adjacent and disjoint, each covered by the parent borrow range.
-/
theorem ActiveTypedSliceMutBorrow.splitAt {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {borrows : List BorrowEntry} {tag : Nat} {wide : WidePtrVal} {xs : List α}
    {bytes : ByteMem} (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes) {k : Nat}
    (hk : k ≤ wide.2) :
    ActiveTypedSliceMutBorrow c borrows tag (WidePtrVal.takeElems wide k) (xs.take k) bytes ∧
      ActiveTypedSliceMutBorrow c borrows tag (WidePtrVal.dropElems wide n k) (xs.drop k) bytes ∧
      DisjointSlice wide.1.offsetBytes (k * n) (wide.1.offsetBytes + k * n) ((wide.2 - k) * n) := by
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  obtain ⟨hL, hR, hD⟩ := SliceTypedAt.splitAt hs hk
  have hkn : k * n ≤ wide.2 * n := Nat.mul_le_mul_right n hk
  have hsum : k * n + (wide.2 - k) * n = wide.2 * n := by
    rw [← Nat.add_mul, Nat.add_sub_of_le hk]
  refine ⟨⟨hL, entry, he, ?_, hp⟩, ⟨hR, entry, he, ?_, hp⟩, hD⟩
  · exact ⟨hc.1, Nat.le_trans (Nat.add_le_add_left hkn _) hc.2⟩
  · refine ⟨Nat.le_trans hc.1 (Nat.le_add_right _ _), ?_⟩
    show wide.1.offsetBytes + k * n + (wide.2 - k) * n ≤ entry.rangeOffset + entry.rangeLen
    rw [Nat.add_assoc, hsum]
    exact hc.2

/--
**Reassembly after `split_at_mut`**: two mutable lenses on adjacent halves (same tag)
recombine into the parent lens on `xsL ++ xsR`, which is how `split_at_mut` borrows end.
-/
theorem ActiveTypedSliceMutBorrow.of_splitAt {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {borrows : List BorrowEntry} {tag : Nat} {wide : WidePtrVal} {xsL xsR : List α}
    {bytes : ByteMem} {k : Nat} (hk : k ≤ wide.2)
    (hL : ActiveTypedSliceMutBorrow c borrows tag (WidePtrVal.takeElems wide k) xsL bytes)
    (hR : ActiveTypedSliceMutBorrow c borrows tag (WidePtrVal.dropElems wide n k) xsR bytes)
    (hcov : ∃ entry, lookupBorrow borrows tag = some entry ∧
      BorrowRangeCovers entry wide.1.offsetBytes (wide.2 * n)) :
    ActiveTypedSliceMutBorrow c borrows tag wide (xsL ++ xsR) bytes := by
  obtain ⟨hsL, entry, he, _, hp⟩ := hL
  obtain ⟨hsR, _, _, _, _⟩ := hR
  obtain ⟨entry', he', hc'⟩ := hcov
  rw [he] at he'
  cases he'
  exact ⟨SliceTypedAt.of_splitAt hk hsL hsR, entry, he, hc', hp⟩

/-! ### Ground MIR `evalPlaceRead (*s)[i]` and `evalSliceFatPtrDerefBorrow` Bridges -/

/--
**`decodeArrayChunksWith_of_sliceTypedAt`**: when `decodeElem` agrees with `c.decode` via
`toVal` on `n`-byte chunks, `decodeArrayChunksWith` over the `wide.2 * n`-byte window of a
`SliceTypedAt` view returns `some (xs.map toVal)`.
-/
theorem decodeArrayChunksWith_of_sliceTypedAt {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (decodeElem : List AbstractByte → Option Value) (toVal : α → Value)
    (h_dec : ∀ chunk x, chunk.length = n → c.decode chunk = some x →
      decodeElem chunk = some (toVal x)) :
    ∀ (xs : List α) (wide : WidePtrVal) (bytes : ByteMem),
      SliceTypedAt c wide xs bytes →
      decodeArrayChunksWith decodeElem n wide.2
        ((bytes.drop wide.1.offsetBytes).take (wide.2 * n)) = some (xs.map toVal)
  | [], wide, bytes, h => by
    have hw2 : wide.2 = 0 := h.1.symm
    rw [hw2, Nat.zero_mul, List.take_zero]
    rfl
  | x :: xs, wide, bytes, h => by
    have hw2 : wide.2 = xs.length + 1 := h.1.symm
    have h1le : 1 ≤ wide.2 := by omega
    obtain ⟨_, hR, _⟩ := SliceTypedAt.splitAt h h1le
    have h0 : TypedAt c wide.1.offsetBytes x bytes := by
      have h0' := h.2.2 0 (Nat.zero_lt_succ _)
      simpa [Nat.zero_mul, Nat.add_zero] using h0'
    rw [typedAt_iff] at h0
    obtain ⟨hb0, hdec0⟩ := h0
    have hb : wide.1.offsetBytes + (xs.length + 1) * n ≤ bytes.length := by
      have := h.2.1
      rw [hw2] at this
      exact this
    have hmul : (xs.length + 1) * n = n + xs.length * n := by
      rw [Nat.succ_mul, Nat.add_comm]
    have hlen_win : ((bytes.drop wide.1.offsetBytes).take ((xs.length + 1) * n)).length =
        n + xs.length * n := by
      simp only [List.length_take, List.length_drop]
      omega
    have hble : Nat.ble n (length ((bytes.drop wide.1.offsetBytes).take ((xs.length + 1) * n))) =
        true := by
      change Nat.ble n ((bytes.drop wide.1.offsetBytes).take ((xs.length + 1) * n)).length = true
      rw [hlen_win]
      exact Nat.ble_eq_true_of_le (Nat.le_add_right n (xs.length * n))
    have htake : takeAbstractBytes n ((bytes.drop wide.1.offsetBytes).take ((xs.length + 1) * n)) =
        (bytes.drop wide.1.offsetBytes).take n := by
      rw [takeAbstractBytes_eq_take, List.take_take,
        Nat.min_eq_left (by rw [hmul]; exact Nat.le_add_right n (xs.length * n))]
    have hdrop : dropAbstractBytes n ((bytes.drop wide.1.offsetBytes).take ((xs.length + 1) * n)) =
        (bytes.drop (wide.1.offsetBytes + n)).take (xs.length * n) := by
      rw [dropAbstractBytes_eq_drop, hmul, drop_take_add, List.drop_drop]
    have hchunk_len : ((bytes.drop wide.1.offsetBytes).take n).length = n := by
      simp only [List.length_take, List.length_drop]
      omega
    have hdec_x : decodeElem ((bytes.drop wide.1.offsetBytes).take n) = some (toVal x) :=
      h_dec _ x hchunk_len hdec0
    have ih := decodeArrayChunksWith_of_sliceTypedAt c decodeElem toVal h_dec xs
      (WidePtrVal.dropElems wide n 1) bytes hR
    have hdr_len : (WidePtrVal.dropElems wide n 1).2 = xs.length := by
      simp only [hw2, Nat.add_sub_cancel]
    have hdr_off : (WidePtrVal.dropElems wide n 1).1.offsetBytes = wide.1.offsetBytes + n := by
      simp only [WidePtrVal.elemOffset, Nat.one_mul]
    rw [hdr_len, hdr_off] at ih
    rw [hw2]
    unfold decodeArrayChunksWith
    rw [hble]
    dsimp only
    rw [htake, hdrop, hdec_x, ih]
    rfl

private theorem nat_beq_eq_false_of_ne {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hb : Nat.beq a b with
  | false => rfl
  | true => exact absurd (Nat.eq_of_beq_eq_true hb) h

/--
**`decodeValueFromBytes_uintLE_chunk`**: any `sz`-byte chunk decoded by `ByteLensCodec.uintLE sz`
(`0 < sz`) decodes via `decodeValueFromBytes` at `.uint w` (when `intCastTargetBytes (.uint w) = some sz`)
to `.scalar ⟨x.val, sz⟩`.
-/
theorem decodeValueFromBytes_uintLE_chunk (w : UintTy) (sz fuel : Nat) (layouts : LayoutTable)
    (hTarget : intCastTargetBytes (.uint w) = some sz) (hPos : 0 < sz)
    (chunk : List AbstractByte) (x : {v : Nat // v < 256 ^ sz})
    (hLen : chunk.length = sz) (hDec : (ByteLensCodec.uintLE sz).decode chunk = some x) :
    decodeValueFromBytes (fuel + 1) layouts { kind := .uint w, layoutIdx := 0 } chunk =
      some (.scalar ⟨x.val, sz⟩) := by
  unfold ByteLensCodec.uintLE at hDec
  dsimp only at hDec
  cases hle : decodeLittleEndianBytes chunk with
  | none => rw [hle] at hDec; cases hDec
  | some vp =>
    obtain ⟨v, prov⟩ := vp
    rw [hle] at hDec
    dsimp only at hDec
    by_cases hv : v < 256 ^ sz
    · rw [dite_eq_left hv] at hDec
      cases hDec
      unfold decodeValueFromBytes
      dsimp only
      rw [hTarget]
      dsimp only
      have hLen' : length chunk = sz := hLen
      have hnz : Nat.beq sz 0 = false := nat_beq_eq_false_of_ne (by omega)
      rw [hLen', Nat.beq_refl]
      dsimp only
      unfold decodeScalarBytes
      dsimp only
      rw [hLen', hnz]
      dsimp only
      rw [hle]
    · rw [dite_eq_right hv] at hDec
      cases hDec

private theorem get?_map_of_lt {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat) (hi : i < xs.length),
      get? (xs.map f) i = some (f xs[i])
  | [], _, hi => absurd hi (Nat.not_lt_zero _)
  | _ :: _, 0, _ => rfl
  | _ :: xs, i + 1, hi =>
    get?_map_of_lt f xs i (Nat.lt_of_succ_lt_succ hi)

private theorem get?_map_eq_none_of_le {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat), xs.length ≤ i → get? (xs.map f) i = none
  | [], _, _ => rfl
  | _ :: xs, i + 1, h => get?_map_eq_none_of_le f xs i (Nat.le_of_succ_le_succ h)

/-- Decode the `wide.2 * n`-byte global window of a non-empty `SliceTypedAt` view into
`Value.aggregate 0 (xs.map toVal)` via `decodeValueFromBytes`. -/
theorem SliceTypedAt.decodeValueFromBytes_array {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {wide : WidePtrVal} {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (toVal : α → Value) (layouts : LayoutTable) (elemKind : RigidTy) (lIdx : LayoutIdx)
    (hPos : 0 < wide.2)
    (hKindSz : rigidTyKindByteSize elemKind = some n)
    (hDec : ∀ chunk x, chunk.length = n → c.decode chunk = some x →
      decodeValueFromBytes 15 layouts { kind := elemKind, layoutIdx := 0 } chunk = some (toVal x)) :
    decodeValueFromBytes defaultCodecFuel layouts
      { kind := .array elemKind wide.2, layoutIdx := lIdx }
      (((globalAllocByteMem alloc).drop wide.1.offsetBytes).take (wide.2 * n)) =
        some (.aggregate 0 (xs.map toVal)) := by
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hChunks := decodeArrayChunksWith_of_sliceTypedAt c
    (fun chunk => decodeValueFromBytes 15 layouts { kind := elemKind, layoutIdx := 0 } chunk)
    toVal hDec xs wide (globalAllocByteMem alloc) h
  have hNz : Nat.beq wide.2 0 = false := nat_beq_eq_false_of_ne (by omega)
  have hLenBytes : Nat.beq (length (((globalAllocByteMem alloc).drop wide.1.offsetBytes).take (wide.2 * n)))
      (Nat.mul n wide.2) = true := by
    have hfl := globalAllocByteMem_length alloc
    have hlen' : length (((globalAllocByteMem alloc).drop wide.1.offsetBytes).take (wide.2 * n)) =
        Nat.mul n wide.2 := by
      change (((globalAllocByteMem alloc).drop wide.1.offsetBytes).take (wide.2 * n)).length = n * wide.2
      simp only [List.length_take, List.length_drop, hfl]
      rw [Nat.mul_comm n wide.2]
      omega
    rw [hlen', Nat.beq_refl]
  unfold decodeValueFromBytes
  dsimp only [defaultCodecFuel]
  rw [hNz]
  dsimp only
  rw [hKindSz]
  dsimp only
  rw [hLenBytes]
  dsimp only
  rw [hChunks]

/--
**`SliceTypedAt.evalPlaceRead_index`**: general ground-MIR `evalPlaceRead` theorem for
checked element indexing `(*s)[idxLoc]` (`p = { local_ := slLoc, projection := [.deref, .index idxLoc] }`)
over a `SliceTypedAt` view of a live global allocation `alloc`. Whenever `idxLoc` holds an
in-bounds scalar index `i < wide.2`, `evalPlaceRead` returns `.ok (toVal xs[i]) locals`.

The read is stated against the memory's active inline call stack `mem.callStack` (as the
trusted evaluator performs it); the global-backed path (no borrow under the tag) does not
consult it, so the theorem holds at every call depth.
-/
theorem SliceTypedAt.evalPlaceRead_index {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {wide : WidePtrVal} {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (toVal : α → Value)
    (locals : List LocalSlot) (slLoc idxLoc : Local) (i idxSz : Nat)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (elemKind : RigidTy) (pIdx : LayoutIdx) (accessedTyOpt : Option Ty)
    (hi : i < wide.2)
    (hSlot : get? locals slLoc =
      some (.init (WidePtrVal.toValue (layoutPointerBytes layouts) wide)))
    (hIdx : get? locals idxLoc = some (.init (.scalar ⟨i, idxSz⟩)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      some { kind := .slice elemKind, layoutIdx := pIdx })
    (hAccTy : placeTyResolved localDecls layouts
      { local_ := slLoc, projection := [.deref, .index idxLoc] } = accessedTyOpt)
    (hDerefAlign : checkDerefAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) wide.1.offsetBytes = true)
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hGlobAlign : checkGlobalAllocAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) alloc wide.1.offsetBytes = true)
    (hSz : tyByteSize localDecls layouts
      { kind := elemKind, layoutIdx := unresolvedLayoutIdx layouts } = some n)
    (hKindSz : rigidTyKindByteSize elemKind = some n)
    (hDec : ∀ chunk x, chunk.length = n → c.decode chunk = some x →
      decodeValueFromBytes 15 layouts { kind := elemKind, layoutIdx := 0 } chunk = some (toVal x))
    (hValOk : validateValueForTy? layouts accessedTyOpt
      (toVal (xs[i]'(by rw [h.length_eq]; exact hi))) = true)
    (hNoUninit : valueContainsUninit
      (toVal (xs[i]'(by rw [h.length_eq]; exact hi))) = false := by rfl) :
    evalPlaceRead locals { local_ := slLoc, projection := [.deref, .index idxLoc] }
      mem.borrows mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (toVal (xs[i]'(by rw [h.length_eq]; exact hi))) locals := by
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hWin := globalAllocSliceToAbstractBytes_eq_window alloc wide.1.offsetBytes (wide.2 * n) hFit
  have hArr := h.decodeValueFromBytes_array toVal layouts elemKind (unresolvedLayoutIdx layouts)
    (by omega) hKindSz hDec
  have hi' : i < xs.length := by rw [h.length_eq]; exact hi
  have hGetMap := get?_map_of_lt toVal xs i hi'
  unfold evalPlaceRead
  dsimp only
  rw [hAccTy, hPtTy, hSlot]
  change evalSliceFatPtrDerefRead locals wide.1 (layoutPointerBytes layouts)
      ⟨wide.2, layoutPointerBytes layouts⟩ [.index idxLoc] mem.borrows mem.globals layouts
      mem.callerLocals (some { kind := .slice elemKind, layoutIdx := pIdx }) localDecls
      accessedTyOpt mem.callStack = _
  unfold evalSliceFatPtrDerefRead
  dsimp (config := { zeta := true }) only
  rw [Nat.beq_refl, hDerefAlign, Bool.and_self, Bool.and_self]
  dsimp (config := { zeta := true }) only
  rw [hNoBorrow, hAlloc]
  dsimp (config := { zeta := true }) only
  rw [hGlobAlign, hSz]
  dsimp (config := { zeta := true }) only
  rw [show Nat.mul wide.2 n = wide.2 * n from rfl, hWin]
  dsimp only
  rw [hArr]
  simp only [readProjectedValue, hIdx, hGetMap, hNoUninit, hValOk]

/--
**`SliceTypedAt.evalPlaceRead_index_oob_ub`**: out-of-bounds indexing `(*s)[idxLoc]`
(`wide.2 ≤ i` on a non-empty slice `0 < wide.2`) faults with `.ub` in `evalPlaceRead`, at the
memory's active inline call stack `mem.callStack` (not consulted on the global-backed path).
-/
theorem SliceTypedAt.evalPlaceRead_index_oob_ub {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {wide : WidePtrVal} {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (toVal : α → Value)
    (locals : List LocalSlot) (slLoc idxLoc : Local) (i idxSz : Nat)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (elemKind : RigidTy) (pIdx : LayoutIdx) (accessedTyOpt : Option Ty)
    (hPos : 0 < wide.2) (hi : wide.2 ≤ i)
    (hSlot : get? locals slLoc =
      some (.init (WidePtrVal.toValue (layoutPointerBytes layouts) wide)))
    (hIdx : get? locals idxLoc = some (.init (.scalar ⟨i, idxSz⟩)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      some { kind := .slice elemKind, layoutIdx := pIdx })
    (hAccTy : placeTyResolved localDecls layouts
      { local_ := slLoc, projection := [.deref, .index idxLoc] } = accessedTyOpt)
    (hDerefAlign : checkDerefAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) wide.1.offsetBytes = true)
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hGlobAlign : checkGlobalAllocAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) alloc wide.1.offsetBytes = true)
    (hSz : tyByteSize localDecls layouts
      { kind := elemKind, layoutIdx := unresolvedLayoutIdx layouts } = some n)
    (hKindSz : rigidTyKindByteSize elemKind = some n)
    (hDec : ∀ chunk x, chunk.length = n → c.decode chunk = some x →
      decodeValueFromBytes 15 layouts { kind := elemKind, layoutIdx := 0 } chunk = some (toVal x)) :
    evalPlaceRead locals { local_ := slLoc, projection := [.deref, .index idxLoc] }
      mem.borrows mem.globals layouts mem.callerLocals localDecls mem.callStack = .ub := by
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hWin := globalAllocSliceToAbstractBytes_eq_window alloc wide.1.offsetBytes (wide.2 * n) hFit
  have hArr := h.decodeValueFromBytes_array toVal layouts elemKind (unresolvedLayoutIdx layouts)
    hPos hKindSz hDec
  have hGetNone : get? (xs.map toVal) i = none :=
    get?_map_eq_none_of_le toVal xs i (by rw [h.length_eq]; exact hi)
  unfold evalPlaceRead
  dsimp only
  rw [hAccTy, hPtTy, hSlot]
  change evalSliceFatPtrDerefRead locals wide.1 (layoutPointerBytes layouts)
      ⟨wide.2, layoutPointerBytes layouts⟩ [.index idxLoc] mem.borrows mem.globals layouts
      mem.callerLocals (some { kind := .slice elemKind, layoutIdx := pIdx }) localDecls
      accessedTyOpt mem.callStack = _
  unfold evalSliceFatPtrDerefRead
  dsimp (config := { zeta := true }) only
  rw [Nat.beq_refl, hDerefAlign, Bool.and_self, Bool.and_self]
  dsimp (config := { zeta := true }) only
  rw [hNoBorrow, hAlloc]
  dsimp (config := { zeta := true }) only
  rw [hGlobAlign, hSz]
  dsimp (config := { zeta := true }) only
  rw [show Nat.mul wide.2 n = wide.2 * n from rfl, hWin]
  dsimp only
  rw [hArr]
  simp only [readProjectedValue, hIdx, hGetNone]

/--
**`SliceTypedAt.evalSliceFatPtrDerefBorrow_subslice`**: borrowing a subslice
`[fromIdx .. toIdx]` (`fromIdx ≤ toIdx ≤ wide.2`) through `evalSliceFatPtrDerefBorrow` on a
global-backed `SliceTypedAt` view returns the wide pointer of the subslice
`WidePtrVal.mk (WidePtrVal.elemPtr wide n fromIdx) (toIdx - fromIdx)` together with its
`SliceTypedAt` view `(xs.drop fromIdx).take (toIdx - fromIdx)`.
-/
theorem SliceTypedAt.evalSliceFatPtrDerefBorrow_subslice {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {wide : WidePtrVal} {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (locals : List LocalSlot) (mem : Memory) (perm : TreeBorrowPerm) (isMut : Bool)
    (elemKind : RigidTy) (pIdx : LayoutIdx) (layouts : LayoutTable)
    (checkPerm : Bool) (localDecls : List LocalDecl) (accessedTyOpt : Option Ty)
    (checkResultRefAlign : Bool) (fromIdx toIdx : Nat)
    (hFromTo : fromIdx ≤ toIdx) (hTo : toIdx ≤ wide.2)
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hMut : isMut = true → alloc.mutability = .mut)
    (hSz : tyByteSize .nil layouts
      { kind := elemKind,
        layoutIdx := match LayoutTable.lookup layouts pIdx with
          | some { fieldLayouts := flIdx :: _, .. } => flIdx
          | _ => unresolvedLayoutIdx layouts } = some n) :
    evalSliceFatPtrDerefBorrow locals mem wide.1 (layoutPointerBytes layouts)
        ⟨wide.2, layoutPointerBytes layouts⟩ [.subslice fromIdx toIdx false] perm isMut
        (some { kind := .slice elemKind, layoutIdx := pIdx }) layouts checkPerm localDecls
        accessedTyOpt checkResultRefAlign =
      .ok (WidePtrVal.toValue (layoutPointerBytes layouts)
            (WidePtrVal.mk (WidePtrVal.elemPtr wide n fromIdx) (toIdx - fromIdx)))
          locals mem ∧
    SliceTypedAt c (WidePtrVal.mk (WidePtrVal.elemPtr wide n fromIdx) (toIdx - fromIdx))
      ((xs.drop fromIdx).take (toIdx - fromIdx)) (globalAllocByteMem alloc) := by
  have hFromLe : fromIdx ≤ wide.2 := Nat.le_trans hFromTo hTo
  obtain ⟨_, hDrop, _⟩ := SliceTypedAt.splitAt h hFromLe
  have hSubLe : toIdx - fromIdx ≤ (WidePtrVal.dropElems wide n fromIdx).2 := by
    change toIdx - fromIdx ≤ wide.2 - fromIdx
    omega
  obtain ⟨hSub, _, _⟩ := SliceTypedAt.splitAt hDrop hSubLe
  refine ⟨?_, hSub⟩
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hBleFit : Nat.ble (Nat.add wide.1.offsetBytes (Nat.mul wide.2 n)) (length alloc.bytes) = true :=
    Nat.ble_eq_true_of_le hFit
  have hBleFromTo : Nat.ble fromIdx toIdx = true := Nat.ble_eq_true_of_le hFromTo
  have hBleTo : Nat.ble toIdx wide.2 = true := Nat.ble_eq_true_of_le hTo
  unfold evalSliceFatPtrDerefBorrow
  dsimp only [stripTransparentProjections, resolveBorrowProjectionElems,
    normalizeSubsliceProjections, normalizeSubsliceProjectionsAux]
  rw [Nat.beq_refl, Bool.and_self, hBleFromTo, hNoBorrow, hAlloc]
  dsimp (config := { zeta := true }) only
  cases isMut with
  | false =>
    rcases hLk : LayoutTable.lookup layouts pIdx with _ | ⟨_, _, _, _, _, _, _ | ⟨flIdx, _⟩⟩ <;>
      (rw [hLk] at hSz; dsimp only at hSz ⊢;
       rw [hSz]; dsimp only; rw [hBleFit, Bool.true_and, hBleTo, hBleFromTo]; rfl)
  | true =>
    have hm := hMut rfl
    rcases hLk : LayoutTable.lookup layouts pIdx with _ | ⟨_, _, _, _, _, _, _ | ⟨flIdx, _⟩⟩ <;>
      (rw [hLk] at hSz; dsimp only at hSz ⊢;
       rw [hSz, hm]; dsimp only; rw [hBleFit, Bool.true_and, hBleTo, hBleFromTo]; rfl)

/--
**`SliceTypedAt.evalSliceFatPtrDerefBorrow_elem`**: borrowing element `idx < wide.2`
(`[.constantIndex idx minLen false]` with `minLen ≤ wide.2`) through `evalSliceFatPtrDerefBorrow`
on a global-backed `SliceTypedAt` view returns `.ptr (WidePtrVal.elemPtr wide n idx) ptrBytes`
together with `TypedAt c (WidePtrVal.elemOffset wide n idx) xs[idx]`.
-/
theorem SliceTypedAt.evalSliceFatPtrDerefBorrow_elem {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {wide : WidePtrVal} {xs : List α} {alloc : CapturedAllocation}
    (h : SliceTypedAt c wide xs (globalAllocByteMem alloc))
    (locals : List LocalSlot) (mem : Memory) (perm : TreeBorrowPerm) (isMut : Bool)
    (elemKind : RigidTy) (pIdx : LayoutIdx) (layouts : LayoutTable)
    (checkPerm : Bool) (localDecls : List LocalDecl) (accessedTyOpt : Option Ty)
    (checkResultRefAlign : Bool) (idx minLen : Nat)
    (hMin : minLen ≤ wide.2) (hIdx : idx < wide.2)
    (hNoBorrow : lookupBorrow mem.borrows wide.1.tag = none)
    (hAlloc : lookupGlobalAlloc mem.globals wide.1.allocId = some alloc)
    (hMut : isMut = true → alloc.mutability = .mut)
    (hSz : tyByteSize .nil layouts
      { kind := elemKind,
        layoutIdx := match LayoutTable.lookup layouts pIdx with
          | some { fieldLayouts := flIdx :: _, .. } => flIdx
          | _ => unresolvedLayoutIdx layouts } = some n) :
    evalSliceFatPtrDerefBorrow locals mem wide.1 (layoutPointerBytes layouts)
        ⟨wide.2, layoutPointerBytes layouts⟩ [.constantIndex idx minLen false] perm isMut
        (some { kind := .slice elemKind, layoutIdx := pIdx }) layouts checkPerm localDecls
        accessedTyOpt checkResultRefAlign =
      .ok (.ptr (WidePtrVal.elemPtr wide n idx) (layoutPointerBytes layouts)) locals mem ∧
    TypedAt c (WidePtrVal.elemOffset wide n idx) (xs[idx]'(by rw [h.length_eq]; exact hIdx))
      (globalAllocByteMem alloc) := by
  refine ⟨?_, h.getElem_typedAt' (by rw [h.length_eq]; exact hIdx)⟩
  have hFit : wide.1.offsetBytes + wide.2 * n ≤ alloc.bytes.length := by
    have := h.2.1
    rw [globalAllocByteMem_length] at this
    exact this
  have hBleFit : Nat.ble (Nat.add wide.1.offsetBytes (Nat.mul wide.2 n)) (length alloc.bytes) = true :=
    Nat.ble_eq_true_of_le hFit
  have hBleMin : Nat.ble minLen wide.2 = true := Nat.ble_eq_true_of_le hMin
  have hBleIdx : Nat.ble (Nat.succ idx) wide.2 = true := Nat.ble_eq_true_of_le hIdx
  unfold evalSliceFatPtrDerefBorrow
  dsimp only [stripTransparentProjections, resolveBorrowProjectionElems,
    normalizeSubsliceProjections, normalizeSubsliceProjectionsAux]
  rw [Nat.beq_refl, Bool.and_self, hNoBorrow, hAlloc]
  dsimp (config := { zeta := true }) only
  cases isMut with
  | false =>
    rcases hLk : LayoutTable.lookup layouts pIdx with _ | ⟨_, _, _, _, _, _, _ | ⟨flIdx, _⟩⟩ <;>
      (rw [hLk] at hSz; dsimp only at hSz ⊢;
       rw [hSz]; dsimp only; rw [hBleFit, Bool.true_and, hBleMin, Bool.and_true, hBleIdx]; rfl)
  | true =>
    have hm := hMut rfl
    rcases hLk : LayoutTable.lookup layouts pIdx with _ | ⟨_, _, _, _, _, _, _ | ⟨flIdx, _⟩⟩ <;>
      (rw [hLk] at hSz; dsimp only at hSz ⊢;
       rw [hSz, hm]; dsimp only; rw [hBleFit, Bool.true_and, hBleMin, Bool.and_true, hBleIdx]; rfl)

/-! ### Tree Borrows Table Transitions & Sibling Borrow Frame Preservation -/

/-- Any `BorrowEntry` returned by `lookupBorrow borrows tag` has `entry.tag = tag`. -/
theorem lookupBorrow_tag :
    ∀ {borrows : List BorrowEntry} {tag : Nat} {entry : BorrowEntry},
      lookupBorrow borrows tag = some entry → entry.tag = tag
  | [], _, _, h => nomatch h
  | e :: rest, tag, entry, h => by
    unfold lookupBorrow at h
    cases hb : Nat.beq e.tag tag with
    | true =>
      rw [hb] at h
      cases h
      exact Nat.eq_of_beq_eq_true hb
    | false =>
      rw [hb] at h
      exact lookupBorrow_tag h

@[simp]
theorem updateBorrowPermAtProj_tag (entry : BorrowEntry) (targetLocal : Local)
    (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    (updateBorrowPermAtProj entry targetLocal writerTag writeProj writeRangeOff writeRangeLen
        targetFrameDepth).tag =
      entry.tag := by
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => rfl
  | true =>
    cases treeBorrowWriterRelatedness entry writerTag with
    | localAccess => exact (applyTreeBorrowTransition_fields entry _).1
    | foreignAccess =>
      cases borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen with
      | false => rfl
      | true => exact (applyTreeBorrowTransition_fields entry _).1

@[simp]
theorem updateBorrowPermAtProj_rangeOffset (entry : BorrowEntry) (targetLocal : Local)
    (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    (updateBorrowPermAtProj entry targetLocal writerTag writeProj writeRangeOff
        writeRangeLen targetFrameDepth).rangeOffset = entry.rangeOffset := by
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => rfl
  | true =>
    cases treeBorrowWriterRelatedness entry writerTag with
    | localAccess => exact (applyTreeBorrowTransition_fields entry _).2.2.2.1
    | foreignAccess =>
      cases borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen with
      | false => rfl
      | true => exact (applyTreeBorrowTransition_fields entry _).2.2.2.1

@[simp]
theorem updateBorrowPermAtProj_rangeLen (entry : BorrowEntry) (targetLocal : Local)
    (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    (updateBorrowPermAtProj entry targetLocal writerTag writeProj writeRangeOff
        writeRangeLen targetFrameDepth).rangeLen = entry.rangeLen := by
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => rfl
  | true =>
    cases treeBorrowWriterRelatedness entry writerTag with
    | localAccess => exact (applyTreeBorrowTransition_fields entry _).2.2.2.2.1
    | foreignAccess =>
      cases borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen with
      | false => rfl
      | true => exact (applyTreeBorrowTransition_fields entry _).2.2.2.2.1

/-- `lookupBorrow` commutes with `invalidateConflictingBorrowsAtProj` (at every target frame
depth). -/
theorem lookupBorrow_invalidateConflictingBorrowsAtProj (borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen tag : Nat) {targetFrameDepth : Nat} :
    lookupBorrow
        (invalidateConflictingBorrowsAtProj borrows targetLocal writerTag writeProj
          writeRangeOff writeRangeLen targetFrameDepth) tag =
      (lookupBorrow borrows tag).map (fun e =>
        updateBorrowPermAtProj e targetLocal writerTag writeProj writeRangeOff writeRangeLen
          targetFrameDepth) := by
  induction borrows with
  | nil => rfl
  | cons e rest ih =>
    unfold invalidateConflictingBorrowsAtProj lookupBorrow
    rw [updateBorrowPermAtProj_tag]
    cases Nat.beq e.tag tag with
    | true => rfl
    | false => exact ih

/-- `lookupBorrow` commutes with `invalidateTreeBorrowsAtProj` (at every target frame depth). -/
theorem lookupBorrow_invalidateTreeBorrowsAtProj (allBorrows borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen tag : Nat) {targetFrameDepth : Nat} :
    lookupBorrow
        (invalidateTreeBorrowsAtProj allBorrows borrows targetLocal writerTag writeProj
          writeRangeOff writeRangeLen targetFrameDepth) tag =
      (lookupBorrow borrows tag).map (fun e =>
        updateBorrowPermTreeAtProj allBorrows e targetLocal writerTag writeProj
          writeRangeOff writeRangeLen targetFrameDepth) := by
  induction borrows with
  | nil => rfl
  | cons e rest ih =>
    unfold invalidateTreeBorrowsAtProj lookupBorrow updateBorrowPermTreeAtProj
    rw [updateBorrowPermAtProj_tag]
    cases Nat.beq e.tag tag with
    | true => rfl
    | false => exact ih

/-- `isBorrowDescendantOrSelfAux` is reflexive at every fuel depth. -/
theorem isBorrowDescendantOrSelfAux_refl (fuel : Nat) (borrows : List BorrowEntry) (tag : Nat) :
    isBorrowDescendantOrSelfAux fuel borrows tag tag = true := by
  cases fuel <;> simp [isBorrowDescendantOrSelfAux, Nat.beq_refl]

@[simp]
theorem isBorrowDescendantOrSelf_refl (borrows : List BorrowEntry) (tag : Nat) :
    isBorrowDescendantOrSelf borrows tag tag = true :=
  isBorrowDescendantOrSelfAux_refl (length borrows) borrows tag

/-- Disjoint byte windows (`DisjointSlice`) never overlap according to `byteRangesOverlapBool`. -/
theorem byteRangesOverlapBool_eq_false_of_disjointSlice {off₁ len₁ off₂ len₂ : Nat}
    (hd : DisjointSlice off₁ len₁ off₂ len₂) :
    byteRangesOverlapBool off₁ len₁ off₂ len₂ = false := by
  unfold DisjointSlice at hd
  unfold byteRangesOverlapBool
  rcases hd with rfl | rfl | hle | hle
  · rfl
  · simp [Nat.beq_refl]
  · have hble : Nat.ble (Nat.succ off₂) (Nat.add off₁ len₁) = false := by
      change Nat.ble (off₂ + 1) (off₁ + len₁) = false
      exact nat_ble_eq_false_of_not_le (by omega)
    rw [hble, Bool.and_false, Bool.and_false, Bool.and_false]
  · have hble : Nat.ble (Nat.succ off₁) (Nat.add off₂ len₂) = false := by
      change Nat.ble (off₁ + 1) (off₂ + len₂) = false
      exact nat_ble_eq_false_of_not_le (by omega)
    rw [hble, Bool.false_and, Bool.and_false, Bool.and_false]

/--
When `0 < writeRangeLen` and `0 < entry.rangeLen`, a write whose byte window is disjoint from
`[entry.rangeOffset, entry.rangeOffset + entry.rangeLen)` does not overlap `entry`.
-/
theorem borrowEntryOverlapsWrite_eq_false_of_disjointSlice (entry : BorrowEntry)
    (writeProj : List ProjectionElem) {writeRangeOff writeRangeLen : Nat}
    (hwPos : 0 < writeRangeLen) (hePos : 0 < entry.rangeLen)
    (hd : DisjointSlice writeRangeOff writeRangeLen entry.rangeOffset entry.rangeLen) :
    borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen = false := by
  have hwNz : Nat.beq writeRangeLen 0 = false := nat_beq_eq_false_of_ne (by omega)
  have heNz : Nat.beq entry.rangeLen 0 = false := nat_beq_eq_false_of_ne (by omega)
  unfold borrowEntryOverlapsWrite
  simp only [hwNz, heNz, Bool.not_false, Bool.and_self]
  exact byteRangesOverlapBool_eq_false_of_disjointSlice hd.symm

/--
A local write through `entry.tag` preserves `BorrowRangeCovers` and `PermitsUniqueWrite`
across `updateBorrowPermAtProj`, at every target frame depth (an entry of another frame is
left unchanged).
-/
theorem updateBorrowPermAtProj_self_permitsUniqueWrite (entry : BorrowEntry)
    (targetLocal : Local) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen base len : Nat)
    (hcov : BorrowRangeCovers entry base len)
    (hp : TreeBorrowPerm.PermitsUniqueWrite entry.perm) {targetFrameDepth : Nat} :
    let entry' := updateBorrowPermAtProj entry targetLocal (some entry.tag) writeProj
      writeRangeOff writeRangeLen targetFrameDepth
    BorrowRangeCovers entry' base len ∧ TreeBorrowPerm.PermitsUniqueWrite entry'.perm := by
  intro entry'
  have hcov' : BorrowRangeCovers entry' base len := by
    unfold BorrowRangeCovers at hcov ⊢
    rw [updateBorrowPermAtProj_rangeOffset, updateBorrowPermAtProj_rangeLen]
    exact hcov
  refine ⟨hcov', ?_⟩
  dsimp only [entry']
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => exact hp
  | true =>
    unfold treeBorrowWriterRelatedness
    dsimp only
    rw [Nat.beq_refl]
    dsimp only
    rw [hp false]
    exact TreeBorrowPerm.permitsUniqueWrite_unique

/--
A write whose byte range is disjoint from `entry` (`borrowEntryOverlapsWrite = false`)
preserves `BorrowRangeCovers` and `PermitsUniqueWrite` across `updateBorrowPermAtProj`
for every `writerTag` and every target frame depth.
-/
theorem updateBorrowPermAtProj_disjoint_permitsUniqueWrite (entry : BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen base len : Nat)
    (hcov : BorrowRangeCovers entry base len)
    (hp : TreeBorrowPerm.PermitsUniqueWrite entry.perm)
    (hno : borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen = false)
    {targetFrameDepth : Nat} :
    let entry' := updateBorrowPermAtProj entry targetLocal writerTag writeProj
      writeRangeOff writeRangeLen targetFrameDepth
    BorrowRangeCovers entry' base len ∧ TreeBorrowPerm.PermitsUniqueWrite entry'.perm := by
  intro entry'
  have hcov' : BorrowRangeCovers entry' base len := by
    unfold BorrowRangeCovers at hcov ⊢
    rw [updateBorrowPermAtProj_rangeOffset, updateBorrowPermAtProj_rangeLen]
    exact hcov
  refine ⟨hcov', ?_⟩
  dsimp only [entry']
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => exact hp
  | true =>
    cases treeBorrowWriterRelatedness entry writerTag with
    | localAccess =>
      dsimp only
      rw [hp false]
      exact TreeBorrowPerm.permitsUniqueWrite_unique
    | foreignAccess =>
      dsimp only
      rw [hno]
      exact hp

/--
**`ActiveTypedSliceMutBorrow.write_elem_treeBorrows_frame`**: writing `v` at element
`i < wide.2` (`0 < n`) through `tag` transitions the borrow table via the ground
`invalidateTreeBorrowsAtProj` (activating `.reservedFrz false` / `.reservedIM` to `.unique`
and keeping `.unique` on `tag`), updates the writer's `ActiveTypedSliceMutBorrow` to
`xs.set i v` in the transitioned borrow table, AND preserves any sibling
`ActiveTypedSliceMutBorrow` on `tag'` whose `BorrowEntry` byte range is `[wide'.1.offsetBytes,
wide'.1.offsetBytes + wide'.2 * m)` (`0 < wide'.2 * m`) on a disjoint slice window!

The written place may live in the frame at any depth `targetFrameDepth` (default `0`, the root
frame): an entry of another frame is untouched by the transition, so both lenses survive at every
depth.
-/
theorem ActiveTypedSliceMutBorrow.write_elem_treeBorrows_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (targetLocal : Local) (writeProj : List ProjectionElem)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {i : Nat} (hi : i < wide.2) (hn : 0 < n) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys bytes)
    (hSibTight : ∀ e, lookupBorrow borrows tag' = some e →
      e.rangeOffset = wide'.1.offsetBytes ∧ e.rangeLen = wide'.2 * m ∧ 0 < e.rangeLen)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (targetFrameDepth : Nat := 0) :
    let borrows' := invalidateTreeBorrowsAtProj borrows borrows targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth
    ActiveTypedSliceMutBorrow c borrows' tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c' borrows' tag' wide' ys bytes' := by
  intro borrows'
  obtain ⟨hSl1, hSl2⟩ := ActiveTypedSliceMutBorrow.write_elem_frame h hi v hw hSib.1 hdisj
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  obtain ⟨_, entry', he', hc', hp'⟩ := hSib
  obtain ⟨hOff', hLen', hPos'⟩ := hSibTight entry' he'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hin : (i + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hi
  rw [Nat.add_mul, Nat.one_mul] at hin
  have hd_elem : DisjointSlice (WidePtrVal.elemOffset wide n i) n
      entry'.rangeOffset entry'.rangeLen := by
    rw [hOff', hLen']
    unfold DisjointSlice at hdisj ⊢
    simp only [WidePtrVal.elemOffset]
    rcases hdisj with h0 | h0 | h0 | h0
    · exact Or.inl (by omega)
    · exact Or.inr (Or.inl h0)
    · exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hno' := borrowEntryOverlapsWrite_eq_false_of_disjointSlice entry' writeProj hn hPos' hd_elem
  refine ⟨⟨hSl1.1, updateBorrowPermTreeAtProj borrows entry targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth, ?_, ?_⟩,
    ⟨hSl2, updateBorrowPermTreeAtProj borrows entry' targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth, ?_, ?_⟩⟩
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he]
    rfl
  · unfold updateBorrowPermTreeAtProj resolveTreeBorrowWriterTag
    dsimp only
    rw [htag, isBorrowDescendantOrSelf_refl]
    dsimp only
    rw [← htag]
    exact updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
      (WidePtrVal.elemOffset wide n i) n wide.1.offsetBytes (wide.2 * n) hc hp
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he']
    rfl
  · unfold updateBorrowPermTreeAtProj
    exact updateBorrowPermAtProj_disjoint_permitsUniqueWrite entry' targetLocal
      (resolveTreeBorrowWriterTag borrows entry' (some tag)) writeProj
      (WidePtrVal.elemOffset wide n i) n wide'.1.offsetBytes (wide'.2 * m) hc' hp' hno'

/--
**`ActiveTypedSliceMutBorrow.write_elem_conflictingBorrows_frame`**: the single-entry /
flat-table counterpart of `write_elem_treeBorrows_frame` over `invalidateConflictingBorrowsAtProj`,
likewise at every target frame depth `targetFrameDepth` (default `0`).
-/
theorem ActiveTypedSliceMutBorrow.write_elem_conflictingBorrows_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (targetLocal : Local) (writeProj : List ProjectionElem)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {i : Nat} (hi : i < wide.2) (hn : 0 < n) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys bytes)
    (hSibTight : ∀ e, lookupBorrow borrows tag' = some e →
      e.rangeOffset = wide'.1.offsetBytes ∧ e.rangeLen = wide'.2 * m ∧ 0 < e.rangeLen)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (targetFrameDepth : Nat := 0) :
    let borrows' := invalidateConflictingBorrowsAtProj borrows targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth
    ActiveTypedSliceMutBorrow c borrows' tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c' borrows' tag' wide' ys bytes' := by
  intro borrows'
  obtain ⟨hSl1, hSl2⟩ := ActiveTypedSliceMutBorrow.write_elem_frame h hi v hw hSib.1 hdisj
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  obtain ⟨_, entry', he', hc', hp'⟩ := hSib
  obtain ⟨hOff', hLen', hPos'⟩ := hSibTight entry' he'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hin : (i + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hi
  rw [Nat.add_mul, Nat.one_mul] at hin
  have hd_elem : DisjointSlice (WidePtrVal.elemOffset wide n i) n
      entry'.rangeOffset entry'.rangeLen := by
    rw [hOff', hLen']
    unfold DisjointSlice at hdisj ⊢
    simp only [WidePtrVal.elemOffset]
    rcases hdisj with h0 | h0 | h0 | h0
    · exact Or.inl (by omega)
    · exact Or.inr (Or.inl h0)
    · exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hno' := borrowEntryOverlapsWrite_eq_false_of_disjointSlice entry' writeProj hn hPos' hd_elem
  refine ⟨⟨hSl1.1, updateBorrowPermAtProj entry targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth, ?_, ?_⟩,
    ⟨hSl2, updateBorrowPermAtProj entry' targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth, ?_, ?_⟩⟩
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateConflictingBorrowsAtProj, he]
    rfl
  · rw [← htag]
    exact updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
      (WidePtrVal.elemOffset wide n i) n wide.1.offsetBytes (wide.2 * n) hc hp
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateConflictingBorrowsAtProj, he']
    rfl
  · exact updateBorrowPermAtProj_disjoint_permitsUniqueWrite entry' targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n wide'.1.offsetBytes (wide'.2 * m) hc' hp' hno'

/--
**`ActiveTypedSliceMutBorrow.write_elem_treeBorrows_shared_frame`**: a write through a
mutable slice borrow `tag` preserves any disjoint shared `ActiveTypedSliceBorrow` on a
non-ancestor tag `tag'` (`isBorrowDescendantOrSelf borrows tag tag' = false`) across
`invalidateTreeBorrowsAtProj`, at every target frame depth `targetFrameDepth` (default `0`).
-/
theorem ActiveTypedSliceMutBorrow.write_elem_treeBorrows_shared_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (targetLocal : Local) (writeProj : List ProjectionElem)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {i : Nat} (hi : i < wide.2) (hn : 0 < n) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hShared : ActiveTypedSliceBorrow c' borrows tag' wide' ys bytes)
    (hSharedTight : ∀ e, lookupBorrow borrows tag' = some e →
      e.rangeOffset = wide'.1.offsetBytes ∧ e.rangeLen = wide'.2 * m ∧ 0 < e.rangeLen)
    (hNotAnc : isBorrowDescendantOrSelf borrows tag tag' = false)
    (hNe : tag' ≠ tag)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (targetFrameDepth : Nat := 0) :
    let borrows' := invalidateTreeBorrowsAtProj borrows borrows targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth
    ActiveTypedSliceMutBorrow c borrows' tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceBorrow c' borrows' tag' wide' ys bytes' := by
  intro borrows'
  obtain ⟨hSl1, hSl2⟩ := ActiveTypedSliceMutBorrow.write_elem_frame h hi v hw hShared.1 hdisj
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  obtain ⟨_, entry', he', hc', hp'⟩ := hShared
  obtain ⟨hOff', hLen', hPos'⟩ := hSharedTight entry' he'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have htag' : entry'.tag = tag' := lookupBorrow_tag he'
  have hin : (i + 1) * n ≤ wide.2 * n := Nat.mul_le_mul_right n hi
  rw [Nat.add_mul, Nat.one_mul] at hin
  have hd_elem : DisjointSlice (WidePtrVal.elemOffset wide n i) n
      entry'.rangeOffset entry'.rangeLen := by
    rw [hOff', hLen']
    unfold DisjointSlice at hdisj ⊢
    simp only [WidePtrVal.elemOffset]
    rcases hdisj with h0 | h0 | h0 | h0
    · exact Or.inl (by omega)
    · exact Or.inr (Or.inl h0)
    · exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hno' := borrowEntryOverlapsWrite_eq_false_of_disjointSlice entry' writeProj hn hPos' hd_elem
  have hEqEntry' : updateBorrowPermTreeAtProj borrows entry' targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth = entry' := by
    unfold updateBorrowPermTreeAtProj resolveTreeBorrowWriterTag
    dsimp only
    rw [htag', hNotAnc]
    dsimp only
    unfold updateBorrowPermAtProj
    cases Bool.and (Nat.beq entry'.targetFrameDepth targetFrameDepth)
        (Nat.beq entry'.targetLocal targetLocal) with
    | false => rfl
    | true =>
      unfold treeBorrowWriterRelatedness
      dsimp only
      have hbeq : Nat.beq entry'.tag tag = false := by
        rw [htag']
        exact nat_beq_eq_false_of_ne hNe
      rw [hbeq]
      dsimp only
      rw [hno']
  refine ⟨⟨hSl1.1, updateBorrowPermTreeAtProj borrows entry targetLocal (some tag)
      writeProj (WidePtrVal.elemOffset wide n i) n targetFrameDepth, ?_, ?_⟩,
    ⟨hSl2, entry', ?_, hc', hp'⟩⟩
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he]
    rfl
  · unfold updateBorrowPermTreeAtProj resolveTreeBorrowWriterTag
    dsimp only
    rw [htag, isBorrowDescendantOrSelf_refl]
    dsimp only
    rw [← htag]
    exact updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
      (WidePtrVal.elemOffset wide n i) n wide.1.offsetBytes (wide.2 * n) hc hp
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he', Option.map_some, hEqEntry']

/-- The trusted initial permission of a fresh mutable reborrow of a `Freeze` pointee
(`mutableBorrowPerm` / Miri's unprotected `NewPermission::new`), `.reservedFrz false`,
grants unique-write permission: its first child write activates it to `.unique`. -/
theorem TreeBorrowPerm.permitsUniqueWrite_reservedFrz_false :
    TreeBorrowPerm.PermitsUniqueWrite (.reservedFrz false) := by
  intro prot
  cases prot <;> rfl

/--
Ghost child `BorrowEntry` for the subslice byte window `[off, off + len)` under `parent`: a
Tree Borrows child of `parent` (`parentTag := some parent.tag`) on the same borrowed local, in
the trusted initial state of a fresh mutable reborrow of a `Freeze` pointee
(`.reservedFrz false`, the trusted `mutableBorrowPerm` choice), *not* a copy of the parent's
current permission. As every trusted reborrow does, the child inherits the parent's frame
identity: `targetFrameDepth` (the depth of the frame owning `targetLocal`) and `allocDead`.

This is a logical extension of the borrow table for the byte-range lens only: the trusted
evaluator's own reborrows of a stack slice create projection-governed entries (`rangeLen = 0`)
or inherit the parent's byte range, so no trusted evaluation step produces this entry. It is
consumed exclusively by the trusted Tree Borrows transitions (`invalidateTreeBorrowsAtProj`,
`borrowEntryOverlapsWrite`, `isBorrowDescendantOrSelf`).
-/
@[reducible]
def reborrowSubsliceEntry (parent : BorrowEntry) (childTag off len : Nat) : BorrowEntry :=
  { tag := childTag
    targetLocal := parent.targetLocal
    targetProjection := parent.targetProjection
    perm := .reservedFrz false
    rangeOffset := off
    rangeLen := len
    parentTag := some parent.tag
    targetFrameDepth := parent.targetFrameDepth
    allocDead := parent.allocDead }

/-- One step of the trusted ancestry walk: a child whose entry names `anc` as its parent is a
descendant of `anc` at every positive fuel. -/
theorem isBorrowDescendantOrSelfAux_of_parent {borrows : List BorrowEntry} {child anc : Nat}
    {e : BorrowEntry} (fuel : Nat) (hne : child ≠ anc) (hlk : lookupBorrow borrows child = some e)
    (hp : e.parentTag = some anc) :
    isBorrowDescendantOrSelfAux (fuel + 1) borrows child anc = true := by
  unfold isBorrowDescendantOrSelfAux
  rw [nat_beq_eq_false_of_ne hne]
  dsimp only
  rw [hlk]
  dsimp only
  rw [hp]
  exact isBorrowDescendantOrSelfAux_refl fuel borrows anc

/--
**`ActiveTypedSliceMutBorrow.splitAt_reborrow`** (`split_at_mut` with child tags): splitting a
mutable slice borrow on `tag` at `k ≤ wide.2` by pushing two ghost child entries
(`reborrowSubsliceEntry`) with *fresh* tags `tagL ≠ tagR` (neither present in `borrows`) and
tight byte ranges `[off, off + k * n)` and `[off + k * n, off + k * n + (wide.2 - k) * n)`
yields mutable lenses on both halves, adjacent and disjoint, while

* the parent lens on `tag` survives unchanged (freshness rules out shadowing `tag` or any
  other live tag: every other lookup is preserved), and
* both children are trusted Tree Borrows descendants of `tag`, so writes through either half
  are local accesses for the parent (`descendant_write_preserves`) and, being disjoint,
  foreign but non-overlapping for the sibling (`write_elem_treeBorrows_frame`).
-/
theorem ActiveTypedSliceMutBorrow.splitAt_reborrow {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {borrows : List BorrowEntry} {tag tagL tagR : Nat} {wide : WidePtrVal} {xs : List α}
    {bytes : ByteMem} (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {k : Nat} (hk : k ≤ wide.2) (hNe : tagR ≠ tagL)
    (hFreshL : lookupBorrow borrows tagL = none) (hFreshR : lookupBorrow borrows tagR = none) :
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      let eL := reborrowSubsliceEntry entry tagL wide.1.offsetBytes (k * n)
      let eR := reborrowSubsliceEntry entry tagR (wide.1.offsetBytes + k * n) ((wide.2 - k) * n)
      let borrows' := eR :: eL :: borrows
      ActiveTypedSliceMutBorrow c borrows' tagL (WidePtrVal.takeElems wide k) (xs.take k) bytes ∧
        ActiveTypedSliceMutBorrow c borrows' tagR (WidePtrVal.dropElems wide n k) (xs.drop k) bytes ∧
        DisjointSlice wide.1.offsetBytes (k * n) (wide.1.offsetBytes + k * n) ((wide.2 - k) * n) ∧
        ActiveTypedSliceMutBorrow c borrows' tag wide xs bytes ∧
        (∀ t, t ≠ tagL → t ≠ tagR → lookupBorrow borrows' t = lookupBorrow borrows t) ∧
        isBorrowDescendantOrSelf borrows' tagL tag = true ∧
        isBorrowDescendantOrSelf borrows' tagR tag = true := by
  obtain ⟨hs, entry, he, hc, hp⟩ := h
  obtain ⟨hL, hR, hD⟩ := SliceTypedAt.splitAt hs hk
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hneL : tagL ≠ tag := by
    intro hEq
    rw [hEq, he] at hFreshL
    cases hFreshL
  have hneR : tagR ≠ tag := by
    intro hEq
    rw [hEq, he] at hFreshR
    cases hFreshR
  refine ⟨entry, he, ?_⟩
  intro eL eR borrows'
  have hOther : ∀ t, t ≠ tagL → t ≠ tagR → lookupBorrow borrows' t = lookupBorrow borrows t :=
    fun t htL htR =>
      (lookupBorrow_cons_of_ne (Ne.symm htR)).trans (lookupBorrow_cons_of_ne (Ne.symm htL))
  have hLookR : lookupBorrow borrows' tagR = some eR := by
    unfold lookupBorrow
    dsimp only [borrows', eR, reborrowSubsliceEntry]
    rw [Nat.beq_refl]
  have hLookL : lookupBorrow borrows' tagL = some eL := by
    unfold lookupBorrow
    dsimp only [borrows', eR, eL, reborrowSubsliceEntry]
    have hbeq : Nat.beq tagR tagL = false := nat_beq_eq_false_of_ne hNe
    rw [hbeq]
    dsimp only [lookupBorrow, eL, reborrowSubsliceEntry]
    rw [Nat.beq_refl]
  have hParentL : eL.parentTag = some tag := by
    show some entry.tag = some tag
    rw [htag]
  have hParentR : eR.parentTag = some tag := by
    show some entry.tag = some tag
    rw [htag]
  refine ⟨⟨hL, eL, hLookL, ⟨Nat.le_refl _, Nat.le_refl _⟩,
      TreeBorrowPerm.permitsUniqueWrite_reservedFrz_false⟩,
    ⟨hR, eR, hLookR, ⟨Nat.le_refl _, Nat.le_refl _⟩,
      TreeBorrowPerm.permitsUniqueWrite_reservedFrz_false⟩, hD,
    ⟨hs, entry, (hOther tag (Ne.symm hneL) (Ne.symm hneR)).trans he, hc, hp⟩, hOther, ?_, ?_⟩
  · show isBorrowDescendantOrSelfAux (borrows.length + 1 + 1) borrows' tagL tag = true
    exact isBorrowDescendantOrSelfAux_of_parent _ hneL hLookL hParentL
  · show isBorrowDescendantOrSelfAux (borrows.length + 1 + 1) borrows' tagR tag = true
    exact isBorrowDescendantOrSelfAux_of_parent _ hneR hLookR hParentR

/--
**`ActiveTypedSliceMutBorrow.descendant_write_preserves`**: a write through a Tree Borrows
descendant `wTag` of `tag` (`isBorrowDescendantOrSelf borrows wTag tag = true`, e.g. through
either `split_at_mut` half minted by `splitAt_reborrow`) is a *local* access for `tag`'s entry,
so after the trusted `invalidateTreeBorrowsAtProj` transition `tag` keeps its byte range and
unique-write permission (`.reservedFrz false` activates to `.unique`, `.unique` stays). Any
new view `xs'` of the same window (e.g. the reassembled whole slice after writes through the
halves) is again an `ActiveTypedSliceMutBorrow` on `tag` in the transitioned table. This holds
for a write into the frame at any depth `targetFrameDepth` (default `0`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.descendant_write_preserves {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag wTag : Nat} {wide : WidePtrVal}
    {xs xs' : List α} {bytes bytes' : ByteMem} (targetLocal : Local)
    (writeProj : List ProjectionElem) (writeOff writeLen : Nat)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hDesc : isBorrowDescendantOrSelf borrows wTag tag = true)
    (hs' : SliceTypedAt c wide xs' bytes') (targetFrameDepth : Nat := 0) :
    ActiveTypedSliceMutBorrow c
      (invalidateTreeBorrowsAtProj borrows borrows targetLocal (some wTag) writeProj writeOff
        writeLen targetFrameDepth) tag wide xs' bytes' := by
  obtain ⟨_, entry, he, hc, hp⟩ := h
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hres : resolveTreeBorrowWriterTag borrows entry (some wTag) = some entry.tag := by
    unfold resolveTreeBorrowWriterTag
    dsimp only
    rw [htag, hDesc]
  obtain ⟨hc', hp'⟩ := updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
    writeOff writeLen wide.1.offsetBytes (wide.2 * n) hc hp (targetFrameDepth := targetFrameDepth)
  refine ⟨hs', updateBorrowPermTreeAtProj borrows entry targetLocal (some wTag) writeProj writeOff
    writeLen targetFrameDepth, ?_, ?_, ?_⟩
  · rw [lookupBorrow_invalidateTreeBorrowsAtProj, he]
    rfl
  · unfold updateBorrowPermTreeAtProj
    rw [hres]
    exact hc'
  · unfold updateBorrowPermTreeAtProj
    rw [hres]
    exact hp'

/--
**`foreign_overlapping_write_disables_borrow`**: if a non-ancestor tag `wTag`
(`isBorrowDescendantOrSelf borrows wTag tag = false` and `tag ≠ wTag`) writes to an overlapping
byte window of the borrowed local (`targetLocal` of the frame at depth
`entry.targetFrameDepth`), `invalidateTreeBorrowsAtProj` transitions any
`.unique` / `.reservedFrz _` / `.frozen` entry for `tag` to `.disabled`, refuting both
`ActiveTypedSliceBorrow` and `ActiveTypedSliceMutBorrow`.

The write is stated at the borrowed entry's own frame depth `entry.targetFrameDepth` because the
semantics genuinely needs it: borrow targets are frame-qualified `(targetFrameDepth, targetLocal)`
pairs, and a write to the same-numbered local of a *different* frame leaves the entry untouched
(`DIV-MR-CALLER-BORROW-ACROSS-SCALAR-CALL`), so it disables nothing.
-/
theorem foreign_overlapping_write_disables_borrow {α : Type} {n : Nat} (c : ByteLensCodec α n)
    {borrows : List BorrowEntry} {tag wTag : Nat} {entry : BorrowEntry}
    (targetLocal : Local) (writeProj : List ProjectionElem) (writeOff writeLen : Nat)
    (wide : WidePtrVal) (xs : List α) (bytes : ByteMem)
    (he : lookupBorrow borrows tag = some entry)
    (hLoc : entry.targetLocal = targetLocal)
    (hNotAnc : isBorrowDescendantOrSelf borrows wTag tag = false)
    (hNe : tag ≠ wTag)
    (hOv : borrowEntryOverlapsWrite entry writeProj writeOff writeLen = true)
    (hNoCell : entry.perm ≠ .cell ∧ entry.perm ≠ .reservedIM) :
    let borrows' := invalidateTreeBorrowsAtProj borrows borrows targetLocal (some wTag)
      writeProj writeOff writeLen entry.targetFrameDepth
    ¬ ActiveTypedSliceBorrow c borrows' tag wide xs bytes ∧
      ¬ ActiveTypedSliceMutBorrow c borrows' tag wide xs bytes := by
  intro borrows'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hDis : (updateBorrowPermTreeAtProj borrows entry targetLocal (some wTag)
      writeProj writeOff writeLen entry.targetFrameDepth).perm = .disabled := by
    unfold updateBorrowPermTreeAtProj resolveTreeBorrowWriterTag
    dsimp only
    rw [htag, hNotAnc]
    dsimp only
    unfold updateBorrowPermAtProj
    rw [hLoc, Nat.beq_refl, Nat.beq_refl, Bool.true_and]
    dsimp only
    unfold treeBorrowWriterRelatedness
    dsimp only
    have hbeq : Nat.beq entry.tag wTag = false := by
      rw [htag]
      exact nat_beq_eq_false_of_ne hNe
    rw [hbeq]
    dsimp only
    rw [hOv]
    dsimp only
    cases hp : entry.perm with
    | cell => exact absurd hp hNoCell.1
    | reservedIM => exact absurd hp hNoCell.2
    | reservedFrz _ => rfl
    | unique => rfl
    | frozen => rfl
    | disabled => rfl
  have hNoShared : ¬ ActiveTypedSliceBorrow c borrows' tag wide xs bytes := by
    rintro ⟨_, e', he', _, hp'⟩
    dsimp only [borrows'] at he'
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he, Option.map_some] at he'
    cases he'
    unfold TreeBorrowPerm.PermitsRead at hp'
    rw [hDis] at hp'
    cases hp'
  exact ⟨hNoShared, fun hMut => hNoShared hMut.toShared⟩

/-! ### Tree Borrows Ancestry, Tight Byte Ranges & Read Transitions (`freezeTreeBorrowsOnReadAtProj`) -/

@[simp]
theorem updateBorrowPermAtProj_parentTag (entry : BorrowEntry) (targetLocal : Local)
    (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    (updateBorrowPermAtProj entry targetLocal writerTag writeProj writeRangeOff
        writeRangeLen targetFrameDepth).parentTag = entry.parentTag := by
  unfold updateBorrowPermAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => rfl
  | true =>
    cases treeBorrowWriterRelatedness entry writerTag with
    | localAccess => exact (applyTreeBorrowTransition_fields entry _).2.2.2.2.2.2
    | foreignAccess =>
      cases borrowEntryOverlapsWrite entry writeProj writeRangeOff writeRangeLen with
      | false => rfl
      | true => exact (applyTreeBorrowTransition_fields entry _).2.2.2.2.2.2

@[simp]
theorem invalidateConflictingBorrowsAtProj_length (borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    length (invalidateConflictingBorrowsAtProj borrows targetLocal writerTag writeProj
        writeRangeOff writeRangeLen targetFrameDepth) = length borrows := by
  induction borrows with
  | nil => rfl
  | cons e rest ih =>
    unfold invalidateConflictingBorrowsAtProj length
    exact congrArg Nat.succ ih

@[simp]
theorem invalidateTreeBorrowsAtProj_length (allBorrows borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    length (invalidateTreeBorrowsAtProj allBorrows borrows targetLocal writerTag writeProj
        writeRangeOff writeRangeLen targetFrameDepth) = length borrows := by
  induction borrows with
  | nil => rfl
  | cons e rest ih =>
    unfold invalidateTreeBorrowsAtProj length
    exact congrArg Nat.succ ih

/-- `isBorrowDescendantOrSelfAux` is invariant under `invalidateConflictingBorrowsAtProj` (at every
target frame depth). -/
theorem isBorrowDescendantOrSelfAux_invalidateConflictingBorrowsAtProj {targetFrameDepth : Nat} :
    ∀ (fuel : Nat) (borrows : List BorrowEntry) (targetLocal : Local)
      (writerTag : Option Nat) (writeProj : List ProjectionElem)
      (writeRangeOff writeRangeLen cTag aTag : Nat),
      isBorrowDescendantOrSelfAux fuel
          (invalidateConflictingBorrowsAtProj borrows targetLocal writerTag writeProj
            writeRangeOff writeRangeLen targetFrameDepth) cTag aTag =
        isBorrowDescendantOrSelfAux fuel borrows cTag aTag
  | 0, _, _, _, _, _, _, _, _ => rfl
  | fuel + 1, borrows, targetLocal, writerTag, writeProj, writeRangeOff, writeRangeLen, cTag, aTag => by
    unfold isBorrowDescendantOrSelfAux
    cases Nat.beq cTag aTag with
    | true => rfl
    | false =>
      dsimp only
      rw [lookupBorrow_invalidateConflictingBorrowsAtProj]
      cases lookupBorrow borrows cTag with
      | none => rfl
      | some entry =>
        dsimp only [Option.map]
        rw [updateBorrowPermAtProj_parentTag]
        cases entry.parentTag with
        | none => rfl
        | some pTag =>
          exact isBorrowDescendantOrSelfAux_invalidateConflictingBorrowsAtProj
            fuel borrows targetLocal writerTag writeProj writeRangeOff writeRangeLen pTag aTag

@[simp]
theorem isBorrowDescendantOrSelf_invalidateConflictingBorrowsAtProj (borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen cTag aTag : Nat) {targetFrameDepth : Nat} :
    isBorrowDescendantOrSelf
        (invalidateConflictingBorrowsAtProj borrows targetLocal writerTag writeProj
          writeRangeOff writeRangeLen targetFrameDepth) cTag aTag =
      isBorrowDescendantOrSelf borrows cTag aTag := by
  unfold isBorrowDescendantOrSelf
  rw [invalidateConflictingBorrowsAtProj_length]
  exact isBorrowDescendantOrSelfAux_invalidateConflictingBorrowsAtProj
    (length borrows) borrows targetLocal writerTag writeProj writeRangeOff writeRangeLen cTag aTag

/-- `isBorrowDescendantOrSelfAux` is invariant under `invalidateTreeBorrowsAtProj` (at every target
frame depth). -/
theorem isBorrowDescendantOrSelfAux_invalidateTreeBorrowsAtProj {targetFrameDepth : Nat} :
    ∀ (fuel : Nat) (allBorrows borrows : List BorrowEntry) (targetLocal : Local)
      (writerTag : Option Nat) (writeProj : List ProjectionElem)
      (writeRangeOff writeRangeLen cTag aTag : Nat),
      isBorrowDescendantOrSelfAux fuel
          (invalidateTreeBorrowsAtProj allBorrows borrows targetLocal writerTag writeProj
            writeRangeOff writeRangeLen targetFrameDepth) cTag aTag =
        isBorrowDescendantOrSelfAux fuel borrows cTag aTag
  | 0, _, _, _, _, _, _, _, _, _ => rfl
  | fuel + 1, allBorrows, borrows, targetLocal, writerTag, writeProj, writeRangeOff, writeRangeLen, cTag, aTag => by
    unfold isBorrowDescendantOrSelfAux
    cases Nat.beq cTag aTag with
    | true => rfl
    | false =>
      dsimp only
      rw [lookupBorrow_invalidateTreeBorrowsAtProj]
      cases lookupBorrow borrows cTag with
      | none => rfl
      | some entry =>
        dsimp only [Option.map, updateBorrowPermTreeAtProj]
        rw [updateBorrowPermAtProj_parentTag]
        cases entry.parentTag with
        | none => rfl
        | some pTag =>
          exact isBorrowDescendantOrSelfAux_invalidateTreeBorrowsAtProj
            fuel allBorrows borrows targetLocal writerTag writeProj writeRangeOff writeRangeLen
            pTag aTag

@[simp]
theorem isBorrowDescendantOrSelf_invalidateTreeBorrowsAtProj (allBorrows borrows : List BorrowEntry)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen cTag aTag : Nat) {targetFrameDepth : Nat} :
    isBorrowDescendantOrSelf
        (invalidateTreeBorrowsAtProj allBorrows borrows targetLocal writerTag writeProj
          writeRangeOff writeRangeLen targetFrameDepth) cTag aTag =
      isBorrowDescendantOrSelf borrows cTag aTag := by
  unfold isBorrowDescendantOrSelf
  rw [invalidateTreeBorrowsAtProj_length]
  exact isBorrowDescendantOrSelfAux_invalidateTreeBorrowsAtProj
    (length borrows) allBorrows borrows targetLocal writerTag writeProj writeRangeOff
    writeRangeLen cTag aTag

/-- Tight byte-range invariant on `tag` for slice `(wide, n)`: any entry for `tag` in `borrows`
has `rangeOffset = wide.1.offsetBytes`, `rangeLen = wide.2 * n`, and `0 < rangeLen`. -/
def TightBorrowRange (borrows : List BorrowEntry) (tag : Nat) (wide : WidePtrVal) (n : Nat) :
    Prop :=
  ∀ e, lookupBorrow borrows tag = some e →
    e.rangeOffset = wide.1.offsetBytes ∧ e.rangeLen = wide.2 * n ∧ 0 < e.rangeLen

theorem TightBorrowRange.of_invalidateConflictingBorrowsAtProj {borrows : List BorrowEntry}
    {tag : Nat} {wide : WidePtrVal} {n : Nat}
    (h : TightBorrowRange borrows tag wide n)
    (targetLocal : Local) (writerTag : Option Nat) (writeProj : List ProjectionElem)
    (writeRangeOff writeRangeLen : Nat) {targetFrameDepth : Nat} :
    TightBorrowRange
      (invalidateConflictingBorrowsAtProj borrows targetLocal writerTag writeProj
        writeRangeOff writeRangeLen targetFrameDepth) tag wide n := by
  intro e' he'
  rw [lookupBorrow_invalidateConflictingBorrowsAtProj] at he'
  cases hlk : lookupBorrow borrows tag with
  | none => rw [hlk] at he'; cases he'
  | some e =>
    rw [hlk, Option.map_some] at he'
    cases he'
    obtain ⟨hOff, hLen, hPos⟩ := h e hlk
    rw [updateBorrowPermAtProj_rangeOffset, updateBorrowPermAtProj_rangeLen]
    exact ⟨hOff, hLen, hPos⟩

theorem TightBorrowRange.of_invalidateTreeBorrowsAtProj {borrows : List BorrowEntry}
    {tag : Nat} {wide : WidePtrVal} {n : Nat}
    (h : TightBorrowRange borrows tag wide n)
    (allBorrows : List BorrowEntry) (targetLocal : Local) (writerTag : Option Nat)
    (writeProj : List ProjectionElem) (writeRangeOff writeRangeLen : Nat)
    {targetFrameDepth : Nat} :
    TightBorrowRange
      (invalidateTreeBorrowsAtProj allBorrows borrows targetLocal writerTag writeProj
        writeRangeOff writeRangeLen targetFrameDepth) tag wide n := by
  intro e' he'
  rw [lookupBorrow_invalidateTreeBorrowsAtProj] at he'
  cases hlk : lookupBorrow borrows tag with
  | none => rw [hlk] at he'; cases he'
  | some e =>
    rw [hlk, Option.map_some] at he'
    cases he'
    obtain ⟨hOff, hLen, hPos⟩ := h e hlk
    unfold updateBorrowPermTreeAtProj
    rw [updateBorrowPermAtProj_rangeOffset, updateBorrowPermAtProj_rangeLen]
    exact ⟨hOff, hLen, hPos⟩

/--
**`ActiveTypedSliceMutBorrow.write_subrange_treeBorrows_frame`**: writing `v` at element `i < wide.2`
through `tag` while invalidating any positive byte subrange `[writeOff, writeOff + writeLen)` inside
`[wide.1.offsetBytes, wide.1.offsetBytes + wide.2 * n)` (covering both single-element range
`(elemOffset wide n i, n)` and the full subslice entry range `(wide.1.offsetBytes, wide.2 * n)`
used by `invalidateDerefWriteBorrows`) updates `tag`'s lens to `xs.set i v` and preserves any
disjoint sibling `ActiveTypedSliceMutBorrow` on `tag'`, for a write into the frame at any depth
`targetFrameDepth` (default `0`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.write_subrange_treeBorrows_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (targetLocal : Local) (writeProj : List ProjectionElem)
    (writeOff writeLen : Nat)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {i : Nat} (hi : i < wide.2) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hSubPos : 0 < writeLen)
    (hSubLo : wide.1.offsetBytes ≤ writeOff)
    (hSubHi : writeOff + writeLen ≤ wide.1.offsetBytes + wide.2 * n)
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys bytes)
    (hSibTight : TightBorrowRange borrows tag' wide' m)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (targetFrameDepth : Nat := 0) :
    let borrows' := invalidateTreeBorrowsAtProj borrows borrows targetLocal (some tag)
      writeProj writeOff writeLen targetFrameDepth
    ActiveTypedSliceMutBorrow c borrows' tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c' borrows' tag' wide' ys bytes' := by
  intro borrows'
  obtain ⟨hSl1, hSl2⟩ := ActiveTypedSliceMutBorrow.write_elem_frame h hi v hw hSib.1 hdisj
  obtain ⟨_, entry, he, hc, hp⟩ := h
  obtain ⟨_, entry', he', hc', hp'⟩ := hSib
  obtain ⟨hOff', hLen', hPos'⟩ := hSibTight entry' he'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hd_sub : DisjointSlice writeOff writeLen entry'.rangeOffset entry'.rangeLen := by
    rw [hOff', hLen']
    unfold DisjointSlice at hdisj ⊢
    rcases hdisj with h0 | h0 | h0 | h0
    · omega
    · exact Or.inr (Or.inl h0)
    · exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hno' := borrowEntryOverlapsWrite_eq_false_of_disjointSlice entry' writeProj hSubPos hPos' hd_sub
  refine ⟨⟨hSl1.1, updateBorrowPermTreeAtProj borrows entry targetLocal (some tag)
      writeProj writeOff writeLen targetFrameDepth, ?_, ?_⟩,
    ⟨hSl2, updateBorrowPermTreeAtProj borrows entry' targetLocal (some tag)
      writeProj writeOff writeLen targetFrameDepth, ?_, ?_⟩⟩
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he]
    rfl
  · unfold updateBorrowPermTreeAtProj resolveTreeBorrowWriterTag
    dsimp only
    rw [htag, isBorrowDescendantOrSelf_refl]
    dsimp only
    rw [← htag]
    exact updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
      writeOff writeLen wide.1.offsetBytes (wide.2 * n) hc hp
  · dsimp only [borrows']
    rw [lookupBorrow_invalidateTreeBorrowsAtProj, he']
    rfl
  · unfold updateBorrowPermTreeAtProj
    exact updateBorrowPermAtProj_disjoint_permitsUniqueWrite entry' targetLocal
      (resolveTreeBorrowWriterTag borrows entry' (some tag)) writeProj
      writeOff writeLen wide'.1.offsetBytes (wide'.2 * m) hc' hp' hno'

/--
**`ActiveTypedSliceMutBorrow.splitAt_reborrow_write_both_reassemble`**: general symbolic
end-to-end `split_at_mut` theorem through two consecutive `invalidateTreeBorrowsAtProj`
transitions. Splitting `tag` at `k ≤ wide.2` (`0 < k`, `k < wide.2`, `0 < n`) into fresh child
tags `tagL` and `tagR`, writing `vL` at `i < k` through `tagL`, and writing `vR` at
`j < wide.2 - k` through `tagR` preserves both child lenses AND reassembles the root lens on
`tag` with `((xs.take k).set i vL) ++ ((xs.drop k).set j vR)`. Both writes target `targetLocal`
of the frame at depth `targetFrameDepth` (default `0`, the root frame); the theorem holds at every
depth.
-/
theorem ActiveTypedSliceMutBorrow.splitAt_reborrow_write_both_reassemble {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag tagL tagR : Nat}
    {wide : WidePtrVal} {xs : List α} {bytes bytes₁ bytes₂ : ByteMem}
    (targetLocal : Local) (writeProjL writeProjR : List ProjectionElem)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {k i j : Nat} (hk : k ≤ wide.2) (hi : i < k) (hj : j < wide.2 - k) (hn : 0 < n)
    (hNe : tagR ≠ tagL)
    (hFreshL : lookupBorrow borrows tagL = none)
    (hFreshR : lookupBorrow borrows tagR = none)
    (vL vR : α)
    (hw₁ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.takeElems wide k) n i) vL bytes =
      some bytes₁)
    (hw₂ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.dropElems wide n k) n j) vR bytes₁ =
      some bytes₂)
    (targetFrameDepth : Nat := 0) :
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      let eL := reborrowSubsliceEntry entry tagL wide.1.offsetBytes (k * n)
      let eR := reborrowSubsliceEntry entry tagR (wide.1.offsetBytes + k * n) ((wide.2 - k) * n)
      let borrows₀ := eR :: eL :: borrows
      let borrows₁ := invalidateTreeBorrowsAtProj borrows₀ borrows₀ targetLocal (some tagL)
        writeProjL (WidePtrVal.elemOffset (WidePtrVal.takeElems wide k) n i) n targetFrameDepth
      let borrows₂ := invalidateTreeBorrowsAtProj borrows₁ borrows₁ targetLocal (some tagR)
        writeProjR (WidePtrVal.elemOffset (WidePtrVal.dropElems wide n k) n j) n targetFrameDepth
      ActiveTypedSliceMutBorrow c borrows₂ tagL (WidePtrVal.takeElems wide k)
          ((xs.take k).set i vL) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tagR (WidePtrVal.dropElems wide n k)
          ((xs.drop k).set j vR) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tag wide
          (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ := by
  obtain ⟨entry, he, hRest⟩ :=
    ActiveTypedSliceMutBorrow.splitAt_reborrow h hk hNe hFreshL hFreshR
  refine ⟨entry, he, ?_⟩
  intro eL eR borrows₀ borrows₁ borrows₂
  obtain ⟨hL₀, hR₀, hDisj, hRoot₀, _, hDescL₀, hDescR₀⟩ := hRest
  have hTightL₀ : TightBorrowRange borrows₀ tagL (WidePtrVal.takeElems wide k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [nat_beq_eq_false_of_ne hNe] at hlk
    dsimp only [lookupBorrow, eL, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos (by omega) hn⟩
  have hTightR₀ : TightBorrowRange borrows₀ tagR (WidePtrVal.dropElems wide n k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos (by omega) hn⟩
  obtain ⟨hL₁, hR₁⟩ :=
    ActiveTypedSliceMutBorrow.write_elem_treeBorrows_frame targetLocal writeProjL hL₀
      (show i < (WidePtrVal.takeElems wide k).2 from hi) hn vL hw₁ hR₀ hTightR₀ hDisj
      (targetFrameDepth := targetFrameDepth)
  have hTightL₁ : TightBorrowRange borrows₁ tagL (WidePtrVal.takeElems wide k) n :=
    hTightL₀.of_invalidateTreeBorrowsAtProj borrows₀ targetLocal (some tagL) writeProjL _ _
  have hWhole₁ : SliceTypedAt c wide (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    SliceTypedAt.of_splitAt hk hL₁.1 hR₁.1
  have hRoot₁ : ActiveTypedSliceMutBorrow c borrows₁ tag wide
      (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    ActiveTypedSliceMutBorrow.descendant_write_preserves targetLocal writeProjL _ _
      hRoot₀ hDescL₀ hWhole₁ (targetFrameDepth := targetFrameDepth)
  obtain ⟨hR₂, hL₂⟩ :=
    ActiveTypedSliceMutBorrow.write_elem_treeBorrows_frame targetLocal writeProjR hR₁
      (show j < (WidePtrVal.dropElems wide n k).2 from hj) hn vR hw₂ hL₁ hTightL₁ hDisj.symm
      (targetFrameDepth := targetFrameDepth)
  have hDescR₁ : isBorrowDescendantOrSelf borrows₁ tagR tag = true := by
    dsimp only [borrows₁]
    rw [isBorrowDescendantOrSelf_invalidateTreeBorrowsAtProj]
    exact hDescR₀
  have hWhole₂ : SliceTypedAt c wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    SliceTypedAt.of_splitAt hk hL₂.1 hR₂.1
  have hRoot₂ : ActiveTypedSliceMutBorrow c borrows₂ tag wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    ActiveTypedSliceMutBorrow.descendant_write_preserves targetLocal writeProjR _ _
      hRoot₁ hDescR₁ hWhole₂ (targetFrameDepth := targetFrameDepth)
  exact ⟨hL₂, hR₂, hRoot₂⟩

@[simp]
theorem updateBorrowPermOnReadAtProj_tag (allBorrows : List BorrowEntry) (entry : BorrowEntry)
    (targetLocal : Local) (readerTag : Option Nat) (readProj : List ProjectionElem)
    (readRangeOff readRangeLen : Nat) (activeProtectors : List Nat) {targetFrameDepth : Nat} :
    (updateBorrowPermOnReadAtProj allBorrows entry targetLocal readerTag readProj
        readRangeOff readRangeLen activeProtectors targetFrameDepth).tag = entry.tag := by
  unfold updateBorrowPermOnReadAtProj
  cases Bool.and (Nat.beq entry.targetFrameDepth targetFrameDepth)
      (Nat.beq entry.targetLocal targetLocal) with
  | false => rfl
  | true =>
    dsimp only
    cases borrowEntryOverlapsWrite entry readProj readRangeOff readRangeLen with
    | false => rfl
    | true =>
      dsimp (config := { zeta := true }) only
      cases readerTag with
      | none => exact (applyTreeBorrowTransition_fields entry _).1
      | some rTag =>
        dsimp only
        cases isBorrowDescendantOrSelf allBorrows rTag entry.tag with
        | true => rfl
        | false => exact (applyTreeBorrowTransition_fields entry _).1

/-- `lookupBorrow` commutes with `freezeTreeBorrowsOnReadAtProj` (at every target frame depth). -/
theorem lookupBorrow_freezeTreeBorrowsOnReadAtProj (allBorrows borrows : List BorrowEntry)
    (targetLocal : Local) (readerTag : Option Nat) (readProj : List ProjectionElem)
    (readRangeOff readRangeLen : Nat) (activeProtectors : List Nat) (tag : Nat)
    {targetFrameDepth : Nat} :
    lookupBorrow
        (freezeTreeBorrowsOnReadAtProj allBorrows borrows targetLocal readerTag readProj
          readRangeOff readRangeLen activeProtectors targetFrameDepth) tag =
      (lookupBorrow borrows tag).map (fun e =>
        updateBorrowPermOnReadAtProj allBorrows e targetLocal readerTag readProj
          readRangeOff readRangeLen activeProtectors targetFrameDepth) := by
  induction borrows with
  | nil => rfl
  | cons e rest ih =>
    unfold freezeTreeBorrowsOnReadAtProj lookupBorrow
    rw [updateBorrowPermOnReadAtProj_tag]
    cases Nat.beq e.tag tag with
    | true => rfl
    | false => exact ih

/--
**`foreign_overlapping_read_freezes_unique_borrow`**: an unprotected foreign overlapping read
(`isBorrowDescendantOrSelf borrows rTag tag = false`) on a `.unique` slice borrow `tag`
transitions `tag` to `.frozen` under `freezeTreeBorrowsOnReadAtProj`, preserving
`ActiveTypedSliceBorrow` (shared read) while refuting `ActiveTypedSliceMutBorrow` (unique write).

The read is stated at the borrowed entry's own frame depth `entry.targetFrameDepth` because the
semantics genuinely needs it: borrow targets are frame-qualified `(targetFrameDepth, targetLocal)`
pairs, and a read of the same-numbered local of a *different* frame leaves the entry untouched.
-/
theorem foreign_overlapping_read_freezes_unique_borrow {α : Type} {n : Nat}
    (c : ByteLensCodec α n) {borrows : List BorrowEntry} {tag rTag : Nat}
    {entry : BorrowEntry} {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (targetLocal : Local) (readProj : List ProjectionElem) (readOff readLen : Nat)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (he : lookupBorrow borrows tag = some entry)
    (hPerm : entry.perm = .unique)
    (hLoc : entry.targetLocal = targetLocal)
    (hNotAnc : isBorrowDescendantOrSelf borrows rTag tag = false)
    (hOv : borrowEntryOverlapsWrite entry readProj readOff readLen = true) :
    let borrows' := freezeTreeBorrowsOnReadAtProj borrows borrows targetLocal (some rTag)
      readProj readOff readLen [] entry.targetFrameDepth
    ActiveTypedSliceBorrow c borrows' tag wide xs bytes ∧
      ¬ ActiveTypedSliceMutBorrow c borrows' tag wide xs bytes := by
  intro borrows'
  have htag : entry.tag = tag := lookupBorrow_tag he
  have hUpd : updateBorrowPermOnReadAtProj borrows entry targetLocal (some rTag)
      readProj readOff readLen [] entry.targetFrameDepth = { entry with perm := .frozen } := by
    unfold updateBorrowPermOnReadAtProj
    rw [hLoc, Nat.beq_refl, Nat.beq_refl, Bool.true_and]
    dsimp only
    rw [hOv]
    dsimp (config := { zeta := true }) only
    rw [htag, hNotAnc, isBorrowProtected_nil]
    dsimp only
    rw [hPerm, ← htag, ← hLoc]
    rfl
  have hc : BorrowRangeCovers entry wide.1.offsetBytes (wide.2 * n) := by
    obtain ⟨_, e₀, he₀, hc₀, _⟩ := h
    rw [he] at he₀
    cases he₀
    exact hc₀
  refine ⟨⟨h.1, { entry with perm := .frozen }, ?_, hc, rfl⟩, ?_⟩
  · dsimp only [borrows']
    rw [lookupBorrow_freezeTreeBorrowsOnReadAtProj, he, Option.map_some, hUpd]
  · rintro ⟨_, e', he', _, hp'⟩
    dsimp only [borrows'] at he'
    rw [lookupBorrow_freezeTreeBorrowsOnReadAtProj, he, Option.map_some, hUpd] at he'
    cases he'
    have hfrz := hp' false
    nomatch hfrz

/-! ### Ground-MIR Borrow-Backed Slice `evalPlaceRead` and `writePlaceValue` Bridges -/

/--
**`evalPlaceRead_slice_disabled_ub`**: dereferencing a slice fat pointer `(*s)...` whose
`BorrowEntry` in `mem.borrows` has `.disabled` permission (for instance after
`foreign_overlapping_write_disables_borrow`) faults with `.ub` in `evalPlaceRead`, at the memory's
active inline call stack `mem.callStack` (the permission check precedes every frame lookup).
-/
theorem evalPlaceRead_slice_disabled_ub (locals : List LocalSlot) (slLoc : Local)
    (restProj : List ProjectionElem) (wide : WidePtrVal) (ptrSz : Nat) (entry : BorrowEntry)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (elemKind : RigidTy) (pIdx : LayoutIdx)
    (hSlot : get? locals slLoc = some (.init (WidePtrVal.toValue ptrSz wide)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      some { kind := .slice elemKind, layoutIdx := pIdx })
    (hBorrow : lookupBorrow mem.borrows wide.1.tag = some entry)
    (hDis : entry.perm = .disabled) :
    evalPlaceRead locals { local_ := slLoc, projection := .deref :: restProj }
      mem.borrows mem.globals layouts mem.callerLocals localDecls mem.callStack = .ub := by
  unfold evalPlaceRead
  dsimp only
  rw [hPtTy, hSlot]
  simp only [WidePtrVal.toValue]
  unfold evalSliceFatPtrDerefRead
  dsimp (config := { zeta := true }) only
  rw [hBorrow]
  dsimp only
  rw [hDis]
  split <;> rfl

/--
**`writePlaceValue_slice_frozen_or_disabled_ub`**: writing through a slice fat pointer `(*s)...`
whose `BorrowEntry` in `borrows` is `.frozen` (e.g. after `foreign_overlapping_read_freezes_unique_borrow`)
or `.disabled` (e.g. after `foreign_overlapping_write_disables_borrow`) faults with `.ub` in
`writePlaceValue`, under every active inline call stack `callStack` (default `[]`, the root
frame): the permission check precedes every frame lookup.
-/
theorem writePlaceValue_slice_frozen_or_disabled_ub (locals : List LocalSlot) (slLoc : Local)
    (restProj : List ProjectionElem) (wide : WidePtrVal) (ptrSz : Nat) (entry : BorrowEntry)
    (borrows : List BorrowEntry) (val : Value) (localDecls : List LocalDecl)
    (layouts : LayoutTable)
    (hSlot : get? locals slLoc = some (.init (WidePtrVal.toValue ptrSz wide)))
    (hBorrow : lookupBorrow borrows wide.1.tag = some entry)
    (hPerm : entry.perm = .frozen ∨ entry.perm = .disabled)
    (callStack : List SavedCallerFrame := .nil) :
    writePlaceValue locals borrows { local_ := slLoc, projection := .deref :: restProj }
      val localDecls layouts callStack = .ub := by
  unfold writePlaceValue
  dsimp (config := { zeta := true }) only
  rw [hSlot]
  simp only [WidePtrVal.toValue]
  rw [hBorrow]
  dsimp only
  rcases hPerm with hp | hp <;> {
    rw [hp]
    split <;> rfl
  }

/-! ### Ground-MIR deref writes: `invalidateDerefWriteBorrows` -/

/--
**`invalidateDerefWriteBorrows_eq_tree`**: on a borrow table with at least two entries, the
trusted borrow update of a deref write through the (thin or 64-bit fat) pointer held in
`dst.local_` is exactly the Tree Borrows write transition of the pointer's tag `ptrVal.tag`
over the *writer entry's own* byte range `[entry.rangeOffset, entry.rangeOffset +
entry.rangeLen)` on `entry.targetLocal` of the frame at the writer entry's own depth
`entry.targetFrameDepth` (the range and frame `invalidateDerefWriteBorrows` really uses, not the
written element's range), under every active inline call stack `callStack`.
-/
theorem invalidateDerefWriteBorrows_eq_tree (locals : List LocalSlot) (borrows : List BorrowEntry)
    (dst : Place) (restProj : List ProjectionElem) (callerLocals : List LocalSlot)
    {callStack : List SavedCallerFrame}
    (fat : Value) (ptrVal : ProvenancePtr) (entry : BorrowEntry)
    (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal)
    (he : lookupBorrow borrows ptrVal.tag = some entry) :
    invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack =
      invalidateTreeBorrowsAtProj borrows borrows entry.targetLocal (some ptrVal.tag)
        (resolveDerefWriteFullProj locals locals fat entry restProj callerLocals callStack)
        entry.rangeOffset entry.rangeLen entry.targetFrameDepth := by
  match borrows, hLen, he with
  | b₁ :: b₂ :: rest, _, he =>
    unfold invalidateDerefWriteBorrows
    dsimp only
    rw [hSlot]
    dsimp only
    rw [hExt]
    dsimp only
    rw [he]

/-- If the written pointer's tag has no entry, the trusted deref-write borrow update leaves a
table with at least two entries unchanged (under every active inline call stack). -/
theorem invalidateDerefWriteBorrows_eq_self_of_lookup_none (locals : List LocalSlot)
    (borrows : List BorrowEntry) (dst : Place) (restProj : List ProjectionElem)
    (callerLocals : List LocalSlot) {callStack : List SavedCallerFrame} (fat : Value)
    (ptrVal : ProvenancePtr)
    (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal)
    (hNone : lookupBorrow borrows ptrVal.tag = none) :
    invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack = borrows := by
  match borrows, hLen, hNone with
  | b₁ :: b₂ :: rest, _, hNone =>
    unfold invalidateDerefWriteBorrows
    dsimp only
    rw [hSlot]
    dsimp only
    rw [hExt]
    dsimp only
    rw [hNone]

/--
**`ActiveTypedSliceMutBorrow.derefWrite_frame`**: a trusted deref write through the pointer
of the writer tag `tag` (held in `dst.local_`, `ptrVal.tag = tag`) whose entry has the *tight*
range of its window updates the borrow table exactly as `invalidateDerefWriteBorrows` does,
and in that table the writer lens is updated to `xs.set i v` while every disjoint sibling lens
with a tight range (e.g. the other `split_at_mut` half) survives. This holds under every active
inline call stack `callStack` (default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.derefWrite_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (locals : List LocalSlot) (dst : Place)
    (restProj : List ProjectionElem) (callerLocals : List LocalSlot) (fat : Value)
    (ptrVal : ProvenancePtr) (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal) (hTag : ptrVal.tag = tag)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hTight : TightBorrowRange borrows tag wide n)
    {i : Nat} (hi : i < wide.2) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys bytes)
    (hSibTight : TightBorrowRange borrows tag' wide' m)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (callStack : List SavedCallerFrame := .nil) :
    ActiveTypedSliceMutBorrow c
        (invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack)
        tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c' (invalidateDerefWriteBorrows locals borrows dst restProj
        callerLocals callStack) tag' wide' ys bytes' := by
  obtain ⟨entry, he, _, _⟩ := h.2
  obtain ⟨hOff, hLenE, hPos⟩ := hTight entry he
  have he' : lookupBorrow borrows ptrVal.tag = some entry := by rw [hTag]; exact he
  rw [invalidateDerefWriteBorrows_eq_tree locals borrows dst restProj callerLocals fat ptrVal entry
    hLen hSlot hExt he', hTag]
  exact ActiveTypedSliceMutBorrow.write_subrange_treeBorrows_frame entry.targetLocal _
    entry.rangeOffset entry.rangeLen h hi v hw hPos (Nat.le_of_eq hOff.symm)
    (Nat.le_of_eq (by rw [hOff, hLenE])) hSib hSibTight hdisj
    (targetFrameDepth := entry.targetFrameDepth)

/--
**`ActiveTypedSliceMutBorrow.derefWrite_ancestor`**: a trusted deref write through any
descendant `wTag` of `tag` (`isBorrowDescendantOrSelf borrows wTag tag = true`) keeps `tag`'s
lens alive in the `invalidateDerefWriteBorrows` table, with any new view `xs'` of its window
(e.g. the reassembled parent slice after writing through a `split_at_mut` half). This holds
whether or not `wTag` has an entry (without one, the trusted update is the identity), under every
active inline call stack `callStack` (default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.derefWrite_ancestor {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag wTag : Nat} {wide : WidePtrVal}
    {xs xs' : List α} {bytes bytes' : ByteMem} (locals : List LocalSlot) (dst : Place)
    (restProj : List ProjectionElem) (callerLocals : List LocalSlot) (fat : Value)
    (ptrVal : ProvenancePtr) (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal) (hTag : ptrVal.tag = wTag)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hDesc : isBorrowDescendantOrSelf borrows wTag tag = true)
    (hs' : SliceTypedAt c wide xs' bytes') (callStack : List SavedCallerFrame := .nil) :
    ActiveTypedSliceMutBorrow c
      (invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack)
      tag wide xs' bytes' := by
  cases hlk : lookupBorrow borrows ptrVal.tag with
  | none =>
    rw [invalidateDerefWriteBorrows_eq_self_of_lookup_none locals borrows dst restProj callerLocals
      fat ptrVal hLen hSlot hExt hlk]
    obtain ⟨_, entry, he, hc, hp⟩ := h
    exact ⟨hs', entry, he, hc, hp⟩
  | some wEntry =>
    rw [invalidateDerefWriteBorrows_eq_tree locals borrows dst restProj callerLocals fat ptrVal
      wEntry hLen hSlot hExt hlk, hTag]
    exact ActiveTypedSliceMutBorrow.descendant_write_preserves wEntry.targetLocal _ _ _ h hDesc hs'
      (targetFrameDepth := wEntry.targetFrameDepth)

/-- The trusted deref-write borrow update preserves the table length (two or more entries). -/
theorem invalidateDerefWriteBorrows_length (locals : List LocalSlot) (borrows : List BorrowEntry)
    (dst : Place) (restProj : List ProjectionElem) (callerLocals : List LocalSlot)
    {callStack : List SavedCallerFrame} (hLen : 2 ≤ borrows.length) :
    (invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack).length =
      borrows.length := by
  match borrows, hLen with
  | b₁ :: b₂ :: rest, _ =>
    unfold invalidateDerefWriteBorrows
    dsimp only
    split
    · split
      · split
        · exact invalidateTreeBorrowsAtProj_length _ _ _ _ _ _ _
        · rfl
      · rfl
    · rfl

/-- The trusted deref-write borrow update preserves Tree Borrows ancestry (two or more
entries): only permissions change, never `parentTag`. -/
theorem isBorrowDescendantOrSelf_invalidateDerefWriteBorrows (locals : List LocalSlot)
    (borrows : List BorrowEntry) (dst : Place) (restProj : List ProjectionElem)
    (callerLocals : List LocalSlot) {callStack : List SavedCallerFrame}
    (hLen : 2 ≤ borrows.length) (cTag aTag : Nat) :
    isBorrowDescendantOrSelf
        (invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack)
        cTag aTag =
      isBorrowDescendantOrSelf borrows cTag aTag := by
  match borrows, hLen with
  | b₁ :: b₂ :: rest, _ =>
    unfold invalidateDerefWriteBorrows
    dsimp only
    split
    · split
      · split
        · exact isBorrowDescendantOrSelf_invalidateTreeBorrowsAtProj _ _ _ _ _ _ _ _ _
        · rfl
      · rfl
    · rfl

/-- The trusted deref-write borrow update preserves tight byte ranges (two or more entries). -/
theorem TightBorrowRange.of_invalidateDerefWriteBorrows {borrows : List BorrowEntry} {tag : Nat}
    {wide : WidePtrVal} {n : Nat} (h : TightBorrowRange borrows tag wide n)
    (locals : List LocalSlot) (dst : Place) (restProj : List ProjectionElem)
    (callerLocals : List LocalSlot) {callStack : List SavedCallerFrame}
    (hLen : 2 ≤ borrows.length) :
    TightBorrowRange
      (invalidateDerefWriteBorrows locals borrows dst restProj callerLocals callStack) tag
      wide n := by
  match borrows, hLen, h with
  | b₁ :: b₂ :: rest, _, h =>
    unfold invalidateDerefWriteBorrows
    dsimp only
    split
    · split
      · split
        · exact h.of_invalidateTreeBorrowsAtProj _ _ _ _ _ _
        · exact h
      · exact h
    · exact h

/--
**`ActiveTypedSliceMutBorrow.splitAt_reborrow_derefWrite_both_reassemble`**: general symbolic
two-write `split_at_mut` reassembly theorem over `invalidateDerefWriteBorrows`. Splitting root
`tag` at `k` (`0 < k`, `k < wide.2`, `0 < n`) into fresh child tags `tagL ≠ tagR`, executing a
trusted deref write through `tagL` (`dstL`) and then through `tagR` (`dstR`), preserves both
child lenses and reassembles `((xs.take k).set i vL) ++ ((xs.drop k).set j vR)` on root `tag`.
Each write runs under its own active inline call stack (`callStack₁` / `callStack₂`, default
`[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.splitAt_reborrow_derefWrite_both_reassemble {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag tagL tagR : Nat}
    {wide : WidePtrVal} {xs : List α} {bytes bytes₁ bytes₂ : ByteMem}
    (locals₁ locals₂ : List LocalSlot) (dstL dstR : Place)
    (restProjL restProjR : List ProjectionElem) (callerLocals₁ callerLocals₂ : List LocalSlot)
    (fatL fatR : Value) (ptrL ptrR : ProvenancePtr)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {k i j : Nat} {vL vR : α}
    (hk0 : 0 < k) (hk : k < wide.2) (hn : 0 < n)
    (hi : i < k) (hj : j < wide.2 - k)
    (hNe : tagR ≠ tagL)
    (hFreshL : lookupBorrow borrows tagL = none)
    (hFreshR : lookupBorrow borrows tagR = none)
    (hSlotL : get? locals₁ dstL.local_ = some (.init fatL))
    (hExtL : extractDerefPtrVal? fatL = some ptrL) (hTagL : ptrL.tag = tagL)
    (hSlotR : get? locals₂ dstR.local_ = some (.init fatR))
    (hExtR : extractDerefPtrVal? fatR = some ptrR) (hTagR : ptrR.tag = tagR)
    (hw₁ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.takeElems wide k) n i) vL bytes =
      some bytes₁)
    (hw₂ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.dropElems wide n k) n j) vR bytes₁ =
      some bytes₂)
    (callStack₁ : List SavedCallerFrame := .nil) (callStack₂ : List SavedCallerFrame := .nil) :
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      let eL := reborrowSubsliceEntry entry tagL wide.1.offsetBytes (k * n)
      let eR := reborrowSubsliceEntry entry tagR (wide.1.offsetBytes + k * n) ((wide.2 - k) * n)
      let borrows₀ := eR :: eL :: borrows
      let borrows₁ :=
        invalidateDerefWriteBorrows locals₁ borrows₀ dstL restProjL callerLocals₁ callStack₁
      let borrows₂ :=
        invalidateDerefWriteBorrows locals₂ borrows₁ dstR restProjR callerLocals₂ callStack₂
      ActiveTypedSliceMutBorrow c borrows₂ tagL (WidePtrVal.takeElems wide k)
          ((xs.take k).set i vL) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tagR (WidePtrVal.dropElems wide n k)
          ((xs.drop k).set j vR) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tag wide
          (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ := by
  obtain ⟨entry, he, hRest⟩ :=
    ActiveTypedSliceMutBorrow.splitAt_reborrow h (Nat.le_of_lt hk) hNe hFreshL hFreshR
  refine ⟨entry, he, ?_⟩
  intro eL eR borrows₀ borrows₁ borrows₂
  obtain ⟨hL₀, hR₀, hDisj, hRoot₀, _, hDescL₀, hDescR₀⟩ := hRest
  have hLen₀ : 2 ≤ borrows₀.length := by simp [borrows₀]
  have hTightL₀ : TightBorrowRange borrows₀ tagL (WidePtrVal.takeElems wide k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [nat_beq_eq_false_of_ne hNe] at hlk
    dsimp only [lookupBorrow, eL, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos hk0 hn⟩
  have hTightR₀ : TightBorrowRange borrows₀ tagR (WidePtrVal.dropElems wide n k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos (by omega) hn⟩
  obtain ⟨hL₁, hR₁⟩ :=
    ActiveTypedSliceMutBorrow.derefWrite_frame locals₁ dstL restProjL callerLocals₁ fatL ptrL
      hLen₀ hSlotL hExtL hTagL hL₀ hTightL₀ (show i < (WidePtrVal.takeElems wide k).2 from hi)
      vL hw₁ hR₀ hTightR₀ hDisj (callStack := callStack₁)
  have hWhole₁ : SliceTypedAt c wide (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    SliceTypedAt.of_splitAt (Nat.le_of_lt hk) hL₁.1 hR₁.1
  have hRoot₁ : ActiveTypedSliceMutBorrow c borrows₁ tag wide
      (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    ActiveTypedSliceMutBorrow.derefWrite_ancestor locals₁ dstL restProjL callerLocals₁ fatL ptrL
      hLen₀ hSlotL hExtL hTagL hRoot₀ hDescL₀ hWhole₁ (callStack := callStack₁)
  have hLen₁ : 2 ≤ borrows₁.length := by
    dsimp only [borrows₁]
    rw [invalidateDerefWriteBorrows_length _ _ _ _ _ hLen₀]
    exact hLen₀
  have hTightL₁ : TightBorrowRange borrows₁ tagL (WidePtrVal.takeElems wide k) n :=
    hTightL₀.of_invalidateDerefWriteBorrows locals₁ dstL restProjL callerLocals₁ hLen₀
  have hTightR₁ : TightBorrowRange borrows₁ tagR (WidePtrVal.dropElems wide n k) n :=
    hTightR₀.of_invalidateDerefWriteBorrows locals₁ dstL restProjL callerLocals₁ hLen₀
  have hDescR₁ : isBorrowDescendantOrSelf borrows₁ tagR tag = true := by
    dsimp only [borrows₁]
    rw [isBorrowDescendantOrSelf_invalidateDerefWriteBorrows _ _ _ _ _ hLen₀]
    exact hDescR₀
  obtain ⟨hR₂, hL₂⟩ :=
    ActiveTypedSliceMutBorrow.derefWrite_frame locals₂ dstR restProjR callerLocals₂ fatR ptrR
      hLen₁ hSlotR hExtR hTagR hR₁ hTightR₁ (show j < (WidePtrVal.dropElems wide n k).2 from hj)
      vR hw₂ hL₁ hTightL₁ hDisj.symm (callStack := callStack₂)
  have hWhole₂ : SliceTypedAt c wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    SliceTypedAt.of_splitAt (Nat.le_of_lt hk) hL₂.1 hR₂.1
  have hRoot₂ : ActiveTypedSliceMutBorrow c borrows₂ tag wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    ActiveTypedSliceMutBorrow.derefWrite_ancestor locals₂ dstR restProjR callerLocals₂ fatR ptrR
      hLen₁ hSlotR hExtR hTagR hRoot₁ hDescR₁ hWhole₂ (callStack := callStack₂)
  exact ⟨hL₂, hR₂, hRoot₂⟩

/-! ### Ground-MIR `evalStmt` deref writes: `invalidateDerefWriteBorrowsWithLayouts` -/

/--
**`invalidateDerefWriteBorrowsWithLayouts_eq_tree`**: in `evalStmt`'s primary deref-assignment
branch (`evalPlaceWrite = .ok locals₂`), the borrow update is
`invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals₁ borrows dst restProj` (not
`invalidateDerefWriteBorrows`, which is only used in the `callerLocals` fallback). On a table
with at least two entries, it equals `invalidateTreeBorrowsAtProj` over the writer entry's own
byte range `[entry.rangeOffset, entry.rangeOffset + entry.rangeLen)` at the union-truncated
projection `resolveDerefBorrowWriteFullProj`, in the frame at the writer entry's own depth
`entry.targetFrameDepth`, under every active inline call stack `callStack`.
-/
theorem invalidateDerefWriteBorrowsWithLayouts_eq_tree (localDecls : List LocalDecl)
    (layouts : LayoutTable) (locals : List LocalSlot) (borrows : List BorrowEntry)
    (dst : Place) (restProj : List ProjectionElem) {callStack : List SavedCallerFrame}
    (fat : Value) (ptrVal : ProvenancePtr) (entry : BorrowEntry)
    (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal)
    (he : lookupBorrow borrows ptrVal.tag = some entry) :
    invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
        callStack =
      invalidateTreeBorrowsAtProj borrows borrows entry.targetLocal (some ptrVal.tag)
        (resolveDerefBorrowWriteFullProj localDecls layouts entry.targetLocal
          (resolveDerefWriteFullProj locals locals fat entry restProj .nil callStack))
        entry.rangeOffset entry.rangeLen entry.targetFrameDepth := by
  match borrows, hLen, he with
  | b₁ :: b₂ :: rest, _, he =>
    unfold invalidateDerefWriteBorrowsWithLayouts
    dsimp only
    rw [hSlot]
    dsimp only
    rw [hExt]
    dsimp only
    rw [he]

theorem invalidateDerefWriteBorrowsWithLayouts_eq_self_of_lookup_none
    (localDecls : List LocalDecl) (layouts : LayoutTable) (locals : List LocalSlot)
    (borrows : List BorrowEntry) (dst : Place) (restProj : List ProjectionElem)
    {callStack : List SavedCallerFrame} (fat : Value) (ptrVal : ProvenancePtr)
    (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal)
    (hNone : lookupBorrow borrows ptrVal.tag = none) :
    invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
        callStack =
      borrows := by
  match borrows, hLen, hNone with
  | b₁ :: b₂ :: rest, _, hNone =>
    unfold invalidateDerefWriteBorrowsWithLayouts
    dsimp only
    rw [hSlot]
    dsimp only
    rw [hExt]
    dsimp only
    rw [hNone]

theorem invalidateDerefWriteBorrowsWithLayouts_length (localDecls : List LocalDecl)
    (layouts : LayoutTable) (locals : List LocalSlot) (borrows : List BorrowEntry)
    (dst : Place) (restProj : List ProjectionElem) {callStack : List SavedCallerFrame}
    (hLen : 2 ≤ borrows.length) :
    (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
        callStack).length =
      borrows.length := by
  match borrows, hLen with
  | b₁ :: b₂ :: rest, _ =>
    unfold invalidateDerefWriteBorrowsWithLayouts
    dsimp only
    split
    · split
      · split
        · exact invalidateTreeBorrowsAtProj_length _ _ _ _ _ _ _
        · rfl
      · rfl
    · rfl

theorem isBorrowDescendantOrSelf_invalidateDerefWriteBorrowsWithLayouts
    (localDecls : List LocalDecl) (layouts : LayoutTable) (locals : List LocalSlot)
    (borrows : List BorrowEntry) (dst : Place) (restProj : List ProjectionElem)
    {callStack : List SavedCallerFrame} (hLen : 2 ≤ borrows.length) (cTag aTag : Nat) :
    isBorrowDescendantOrSelf
        (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
          callStack)
        cTag aTag =
      isBorrowDescendantOrSelf borrows cTag aTag := by
  match borrows, hLen with
  | b₁ :: b₂ :: rest, _ =>
    unfold invalidateDerefWriteBorrowsWithLayouts
    dsimp only
    split
    · split
      · split
        · exact isBorrowDescendantOrSelf_invalidateTreeBorrowsAtProj _ _ _ _ _ _ _ _ _
        · rfl
      · rfl
    · rfl

theorem TightBorrowRange.of_invalidateDerefWriteBorrowsWithLayouts
    {borrows : List BorrowEntry} {tag : Nat} {wide : WidePtrVal} {n : Nat}
    (h : TightBorrowRange borrows tag wide n)
    (localDecls : List LocalDecl) (layouts : LayoutTable) (locals : List LocalSlot)
    (dst : Place) (restProj : List ProjectionElem) {callStack : List SavedCallerFrame}
    (hLen : 2 ≤ borrows.length) :
    TightBorrowRange
      (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
        callStack)
      tag wide n := by
  match borrows, hLen, h with
  | b₁ :: b₂ :: rest, _, h =>
    unfold invalidateDerefWriteBorrowsWithLayouts
    dsimp only
    split
    · split
      · split
        · exact h.of_invalidateTreeBorrowsAtProj _ _ _ _ _ _
        · exact h
      · exact h
    · exact h

/--
**`ActiveTypedSliceMutBorrow.derefWriteWithLayouts_frame`**: writer lens update (`xs.set i v`) and
disjoint tight sibling frame across `invalidateDerefWriteBorrowsWithLayouts` (the borrow update
executed by `evalStmt` on dereferenced assignments), under every active inline call stack
`callStack` (default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.derefWriteWithLayouts_frame {α β : Type} {n m : Nat}
    {c : ByteLensCodec α n} {c' : ByteLensCodec β m} {borrows : List BorrowEntry}
    {tag tag' : Nat} {wide wide' : WidePtrVal} {xs : List α} {ys : List β}
    {bytes bytes' : ByteMem} (localDecls : List LocalDecl) (layouts : LayoutTable)
    (locals : List LocalSlot) (dst : Place) (restProj : List ProjectionElem)
    (fat : Value) (ptrVal : ProvenancePtr) (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal) (hTag : ptrVal.tag = tag)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hTight : TightBorrowRange borrows tag wide n)
    {i : Nat} (hi : i < wide.2) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys bytes)
    (hSibTight : TightBorrowRange borrows tag' wide' m)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (callStack : List SavedCallerFrame := .nil) :
    ActiveTypedSliceMutBorrow c
        (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
          callStack)
        tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c'
        (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
          callStack)
        tag' wide' ys bytes' := by
  obtain ⟨entry, he, _, _⟩ := h.2
  obtain ⟨hOff, hLenE, hPos⟩ := hTight entry he
  have he' : lookupBorrow borrows ptrVal.tag = some entry := by rw [hTag]; exact he
  rw [invalidateDerefWriteBorrowsWithLayouts_eq_tree localDecls layouts locals borrows dst
    restProj fat ptrVal entry hLen hSlot hExt he', hTag]
  exact ActiveTypedSliceMutBorrow.write_subrange_treeBorrows_frame entry.targetLocal _
    entry.rangeOffset entry.rangeLen h hi v hw hPos (Nat.le_of_eq hOff.symm)
    (Nat.le_of_eq (by rw [hOff, hLenE])) hSib hSibTight hdisj
    (targetFrameDepth := entry.targetFrameDepth)

/--
**`ActiveTypedSliceMutBorrow.derefWriteWithLayouts_ancestor`**: ancestor preservation across
`invalidateDerefWriteBorrowsWithLayouts` when a descendant `wTag` of `tag` is written, under every
active inline call stack `callStack` (default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.derefWriteWithLayouts_ancestor {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag wTag : Nat} {wide : WidePtrVal}
    {xs xs' : List α} {bytes bytes' : ByteMem} (localDecls : List LocalDecl)
    (layouts : LayoutTable) (locals : List LocalSlot) (dst : Place)
    (restProj : List ProjectionElem) (fat : Value) (ptrVal : ProvenancePtr)
    (hLen : 2 ≤ borrows.length)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal) (hTag : ptrVal.tag = wTag)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hDesc : isBorrowDescendantOrSelf borrows wTag tag = true)
    (hs' : SliceTypedAt c wide xs' bytes') (callStack : List SavedCallerFrame := .nil) :
    ActiveTypedSliceMutBorrow c
      (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst restProj
        callStack)
      tag wide xs' bytes' := by
  cases hlk : lookupBorrow borrows ptrVal.tag with
  | none =>
    rw [invalidateDerefWriteBorrowsWithLayouts_eq_self_of_lookup_none localDecls layouts locals
      borrows dst restProj fat ptrVal hLen hSlot hExt hlk]
    obtain ⟨_, entry, he, hc, hp⟩ := h
    exact ⟨hs', entry, he, hc, hp⟩
  | some wEntry =>
    rw [invalidateDerefWriteBorrowsWithLayouts_eq_tree localDecls layouts locals borrows dst
      restProj fat ptrVal wEntry hLen hSlot hExt hlk, hTag]
    exact ActiveTypedSliceMutBorrow.descendant_write_preserves wEntry.targetLocal _ _ _ h hDesc hs'
      (targetFrameDepth := wEntry.targetFrameDepth)

/--
**`ActiveTypedSliceMutBorrow.splitAt_reborrow_derefWriteWithLayouts_both_reassemble`**: general
symbolic two-write `split_at_mut` reassembly theorem over `invalidateDerefWriteBorrowsWithLayouts`
(the exact borrow update performed by `evalStmt` on deref assignments). Each write runs under its
own active inline call stack (`callStack₁` / `callStack₂`, default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.splitAt_reborrow_derefWriteWithLayouts_both_reassemble
    {α : Type} {n : Nat} {c : ByteLensCodec α n} {borrows : List BorrowEntry}
    {tag tagL tagR : Nat} {wide : WidePtrVal} {xs : List α} {bytes bytes₁ bytes₂ : ByteMem}
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (locals₁ locals₂ : List LocalSlot) (dstL dstR : Place)
    (restProjL restProjR : List ProjectionElem)
    (fatL fatR : Value) (ptrL ptrR : ProvenancePtr)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    {k i j : Nat} {vL vR : α}
    (hk0 : 0 < k) (hk : k < wide.2) (hn : 0 < n)
    (hi : i < k) (hj : j < wide.2 - k)
    (hNe : tagR ≠ tagL)
    (hFreshL : lookupBorrow borrows tagL = none)
    (hFreshR : lookupBorrow borrows tagR = none)
    (hSlotL : get? locals₁ dstL.local_ = some (.init fatL))
    (hExtL : extractDerefPtrVal? fatL = some ptrL) (hTagL : ptrL.tag = tagL)
    (hSlotR : get? locals₂ dstR.local_ = some (.init fatR))
    (hExtR : extractDerefPtrVal? fatR = some ptrR) (hTagR : ptrR.tag = tagR)
    (hw₁ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.takeElems wide k) n i) vL bytes =
      some bytes₁)
    (hw₂ : writeTyped c (WidePtrVal.elemOffset (WidePtrVal.dropElems wide n k) n j) vR bytes₁ =
      some bytes₂)
    (callStack₁ : List SavedCallerFrame := .nil) (callStack₂ : List SavedCallerFrame := .nil) :
    ∃ entry, lookupBorrow borrows tag = some entry ∧
      let eL := reborrowSubsliceEntry entry tagL wide.1.offsetBytes (k * n)
      let eR := reborrowSubsliceEntry entry tagR (wide.1.offsetBytes + k * n) ((wide.2 - k) * n)
      let borrows₀ := eR :: eL :: borrows
      let borrows₁ :=
        invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals₁ borrows₀ dstL restProjL
          callStack₁
      let borrows₂ :=
        invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals₂ borrows₁ dstR restProjR
          callStack₂
      ActiveTypedSliceMutBorrow c borrows₂ tagL (WidePtrVal.takeElems wide k)
          ((xs.take k).set i vL) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tagR (WidePtrVal.dropElems wide n k)
          ((xs.drop k).set j vR) bytes₂ ∧
        ActiveTypedSliceMutBorrow c borrows₂ tag wide
          (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ := by
  obtain ⟨entry, he, hRest⟩ :=
    ActiveTypedSliceMutBorrow.splitAt_reborrow h (Nat.le_of_lt hk) hNe hFreshL hFreshR
  refine ⟨entry, he, ?_⟩
  intro eL eR borrows₀ borrows₁ borrows₂
  obtain ⟨hL₀, hR₀, hDisj, hRoot₀, _, hDescL₀, hDescR₀⟩ := hRest
  have hLen₀ : 2 ≤ borrows₀.length := by simp [borrows₀]
  have hTightL₀ : TightBorrowRange borrows₀ tagL (WidePtrVal.takeElems wide k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [nat_beq_eq_false_of_ne hNe] at hlk
    dsimp only [lookupBorrow, eL, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos hk0 hn⟩
  have hTightR₀ : TightBorrowRange borrows₀ tagR (WidePtrVal.dropElems wide n k) n := by
    intro e hlk
    unfold lookupBorrow at hlk
    dsimp only [borrows₀, eR, reborrowSubsliceEntry] at hlk
    rw [Nat.beq_refl] at hlk
    cases hlk
    refine ⟨rfl, rfl, Nat.mul_pos (by omega) hn⟩
  obtain ⟨hL₁, hR₁⟩ :=
    ActiveTypedSliceMutBorrow.derefWriteWithLayouts_frame localDecls layouts locals₁ dstL
      restProjL fatL ptrL hLen₀ hSlotL hExtL hTagL hL₀ hTightL₀
      (show i < (WidePtrVal.takeElems wide k).2 from hi) vL hw₁ hR₀ hTightR₀ hDisj
      (callStack := callStack₁)
  have hWhole₁ : SliceTypedAt c wide (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    SliceTypedAt.of_splitAt (Nat.le_of_lt hk) hL₁.1 hR₁.1
  have hRoot₁ : ActiveTypedSliceMutBorrow c borrows₁ tag wide
      (((xs.take k).set i vL) ++ xs.drop k) bytes₁ :=
    ActiveTypedSliceMutBorrow.derefWriteWithLayouts_ancestor localDecls layouts locals₁ dstL
      restProjL fatL ptrL hLen₀ hSlotL hExtL hTagL hRoot₀ hDescL₀ hWhole₁ (callStack := callStack₁)
  have hLen₁ : 2 ≤ borrows₁.length := by
    dsimp only [borrows₁]
    rw [invalidateDerefWriteBorrowsWithLayouts_length _ _ _ _ _ _ hLen₀]
    exact hLen₀
  have hTightL₁ : TightBorrowRange borrows₁ tagL (WidePtrVal.takeElems wide k) n :=
    hTightL₀.of_invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals₁ dstL restProjL
      hLen₀
  have hTightR₁ : TightBorrowRange borrows₁ tagR (WidePtrVal.dropElems wide n k) n :=
    hTightR₀.of_invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals₁ dstL restProjL
      hLen₀
  have hDescR₁ : isBorrowDescendantOrSelf borrows₁ tagR tag = true := by
    dsimp only [borrows₁]
    rw [isBorrowDescendantOrSelf_invalidateDerefWriteBorrowsWithLayouts _ _ _ _ _ _ hLen₀]
    exact hDescR₀
  obtain ⟨hR₂, hL₂⟩ :=
    ActiveTypedSliceMutBorrow.derefWriteWithLayouts_frame localDecls layouts locals₂ dstR
      restProjR fatR ptrR hLen₁ hSlotR hExtR hTagR hR₁ hTightR₁
      (show j < (WidePtrVal.dropElems wide n k).2 from hj) vR hw₂ hL₁ hTightL₁ hDisj.symm
      (callStack := callStack₂)
  have hWhole₂ : SliceTypedAt c wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    SliceTypedAt.of_splitAt (Nat.le_of_lt hk) hL₂.1 hR₂.1
  have hRoot₂ : ActiveTypedSliceMutBorrow c borrows₂ tag wide
      (((xs.take k).set i vL) ++ ((xs.drop k).set j vR)) bytes₂ :=
    ActiveTypedSliceMutBorrow.derefWriteWithLayouts_ancestor localDecls layouts locals₂ dstR
      restProjR fatR ptrR hLen₁ hSlotR hExtR hTagR hRoot₁ hDescR₁ hWhole₂ (callStack := callStack₂)
  exact ⟨hL₂, hR₂, hRoot₂⟩

/-! ### Symbolic `encodeUntypedValueToBytes` ↔ `ByteLensCodec.encodeElems` & Borrow-Backed Slice Bridges -/

theorem appendAbstractBytes_eq_append :
    ∀ (xs ys : List AbstractByte), appendAbstractBytes xs ys = xs ++ ys
  | [], _ => rfl
  | x :: xs, ys => congrArg (x :: ·) (appendAbstractBytes_eq_append xs ys)

/--
**`encodeUntypedValueToBytes_aggregate_map`**: when every element `x` encodes under
`encodeUntypedValueToBytes fuel (toVal x)` to `some (c.encode x)`, the untyped byte encoding of
`.aggregate vIdx (xs.map toVal)` at fuel `fuel + 1` is `some (ByteLensCodec.encodeElems c xs)`.
-/
theorem encodeUntypedValueToBytes_aggregate_map {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (toVal : α → Value) (fuel vIdx : Nat)
    (h_enc : ∀ x, encodeUntypedValueToBytes fuel (toVal x) = some (c.encode x)) :
    ∀ (xs : List α),
      encodeUntypedValueToBytes (fuel + 1) (.aggregate vIdx (xs.map toVal)) =
        some (ByteLensCodec.encodeElems c xs)
  | [] => rfl
  | x :: xs => by
    show (match encodeUntypedValueToBytes fuel (toVal x),
        encodeUntypedValueToBytes (fuel + 1) (.aggregate vIdx (xs.map toVal)) with
      | some b1, some b2 => some (appendAbstractBytes b1 b2)
      | _, _ => none) = some (c.encode x ++ ByteLensCodec.encodeElems c xs)
    rw [h_enc x, encodeUntypedValueToBytes_aggregate_map c toVal fuel vIdx h_enc xs]
    dsimp only
    rw [appendAbstractBytes_eq_append]

/-- **`encodeUntypedValueToBytes_uintLE`**: at positive fuel, `.scalar ⟨v.val, sz⟩` (`0 < sz`)
encodes under `encodeUntypedValueToBytes` to `some ((ByteLensCodec.uintLE sz).encode v)`. -/
theorem encodeUntypedValueToBytes_uintLE {sz : Nat} (hsz : 0 < sz) (fuel : Nat)
    (v : {v : Nat // v < 256 ^ sz}) :
    encodeUntypedValueToBytes (fuel + 1) (.scalar ⟨v.val, sz⟩) =
      some ((ByteLensCodec.uintLE sz).encode v) :=
  ByteLensCodec.encodeScalarBytes_uintLE_encode hsz v

private theorem take_length_eq {α : Type} : ∀ (xs : List α), xs.take xs.length = xs
  | [] => rfl
  | x :: xs => congrArg (x :: ·) (take_length_eq xs)

/-- **`sliceTypedAt_encodeElems`**: the concatenated element encodings `ByteLensCodec.encodeElems c xs`
carry the `SliceTypedAt` view of `xs` at offset `0`. -/
theorem sliceTypedAt_encodeElems {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (aid : AllocId) (xs : List α) :
    SliceTypedAt c (WidePtrVal.mk ⟨aid, 0⟩ xs.length) xs (ByteLensCodec.encodeElems c xs) := by
  have hlen := ByteLensCodec.encodeElems_length c xs
  refine sliceTypedAt_of_decodeElems c aid xs.length 0 xs (ByteLensCodec.encodeElems c xs)
    (by omega) ?_
  rw [List.drop_zero, ← hlen, take_length_eq]
  exact ByteLensCodec.decodeElems_encodeElems c xs

theorem splice_append_left {α : Type} :
    ∀ (u bs w : List α) (off : Nat),
      splice (u ++ bs) (u.length + off) w = u ++ splice bs off w
  | [], bs, w, off => by
    dsimp only [splice, List.nil_append, List.length_nil]
    rw [Nat.zero_add]
  | a :: u, bs, w, off => by
    simp only [splice, List.cons_append, List.length_cons, Nat.succ_add, List.take_succ_cons,
      List.drop_succ_cons]
    exact congrArg (a :: ·) (splice_append_left u bs w off)

theorem splice_encodeElems_set {α : Type} {n : Nat} (c : ByteLensCodec α n) :
    ∀ (xs : List α) (idx : Nat) (v : α), idx < xs.length →
      splice (ByteLensCodec.encodeElems c xs) (idx * n) (c.encode v) =
        ByteLensCodec.encodeElems c (xs.set idx v)
  | [], _, _, h => absurd h (Nat.not_lt_zero _)
  | x :: xs, 0, v, _ => by
    simp only [Nat.zero_mul, splice, List.take_zero, List.nil_append, Nat.zero_add,
      c.encode_len, ByteLensCodec.encodeElems, List.drop_left' (c.encode_len x),
      List.set_cons_zero]
  | x :: xs, idx + 1, v, h => by
    have hlt : idx < xs.length := Nat.lt_of_succ_lt_succ h
    have hmul : (idx + 1) * n = (c.encode x).length + idx * n := by
      rw [c.encode_len, Nat.succ_mul, Nat.add_comm]
    rw [ByteLensCodec.encodeElems, hmul, splice_append_left,
      splice_encodeElems_set c xs idx v hlt, List.set_cons_succ, ByteLensCodec.encodeElems]

/--
**`writeTyped_encodeElems_set`**: writing `v` at byte offset `idx * n` (`idx < xs.length`) into
`ByteLensCodec.encodeElems c xs` produces `some (ByteLensCodec.encodeElems c (xs.set idx v))`.
-/
theorem writeTyped_encodeElems_set {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (xs : List α) {idx : Nat} (h : idx < xs.length) (v : α) :
    writeTyped c (idx * n) v (ByteLensCodec.encodeElems c xs) =
      some (ByteLensCodec.encodeElems c (xs.set idx v)) := by
  have hle : idx * n + n ≤ (ByteLensCodec.encodeElems c xs).length := by
    rw [ByteLensCodec.encodeElems_length]
    have h1 : (idx + 1) * n ≤ xs.length * n := Nat.mul_le_mul_right n h
    rw [Nat.add_mul, Nat.one_mul] at h1
    exact h1
  rw [writeTyped_eq_splice c v hle, splice_encodeElems_set c xs idx v h]

theorem valueListContainsUninit_map_eq_false {α : Type} (f : α → Value)
    (hf : ∀ x, valueContainsUninit (f x) = false) :
    ∀ (xs : List α), valueListContainsUninit (xs.map f) = false
  | [] => rfl
  | x :: xs => by
    simp only [List.map_cons, valueListContainsUninit, hf x,
      valueListContainsUninit_map_eq_false f hf xs]

theorem readSliceBackingAggregate?_aggregate_zero_nil (indexLocals : List LocalSlot)
    (elems : List Value) (minCount : Nat) (expectedElemSzOpt : Option Nat)
    (hNoUninit : valueListContainsUninit elems = false) :
    readSliceBackingAggregate? indexLocals (.aggregate 0 elems) [] minCount expectedElemSzOpt =
      some ([], 0, elems) := by
  dsimp only [readSliceBackingAggregate?, stripTransparentProjections, normalizeSubsliceProjections,
    splitLastConstantIndex?, readProjectedValue, valueContainsUninit]
  rw [hNoUninit]
  rfl

/--
`activeFrameSlot?` resolves a frame-qualified borrow target `(d, loc)` to the active frame's slot
`get? locals loc` whenever the target frame is the active frame: with an empty call stack the root
frame is active, and otherwise the active frame sits at depth `length callStack`.
-/
theorem activeFrameSlot?_eq_get?_of_active (locals : List LocalSlot)
    {callStack : List SavedCallerFrame} {d : Nat} (loc : Nat)
    (hActive : callStack = [] ∨ d = length callStack) :
    activeFrameSlot? locals callStack d loc = get? locals loc := by
  unfold activeFrameSlot?
  cases callStack with
  | nil => rfl
  | cons f fs =>
    rcases hActive with h | h
    · cases h
    · have hb : Nat.beq d (length (f :: fs)) = true := by
        rw [h]
        exact Nat.beq_refl _
      simp only [hb]

/--
**`WidePtrVal.evalRvalue_len_borrow`**: ground-MIR `Rvalue.len (*place)` theorem for a
**borrow-backed** slice fat pointer (`lookupBorrow mem.borrows wide.1.tag = some entry` with
`TreeBorrowPerm.PermitsRead entry.perm` and backing aggregate `.aggregate 0 elems` in
`entry.targetLocal`), complementing the global-backed `WidePtrVal.evalRvalue_len`.

`hRead` is the fat-pointer place read `evalPlaceLen` performs, against the memory's active inline
call stack `mem.callStack`. Borrow targets are frame-qualified `(targetFrameDepth, targetLocal)`
pairs resolved through `activeFrameSlot?`, so `hTarget` (the backing aggregate in the active
frame's slot `entry.targetLocal`) describes the borrowed local only when the borrow targets the
active frame. That is the frame-depth hypothesis `hActive` the semantics genuinely needs: the root
frame is active (`mem.callStack = []`, discharged automatically) or
`entry.targetFrameDepth = length mem.callStack`.
-/
theorem WidePtrVal.evalRvalue_len_borrow (locals locals' : List LocalSlot) (place : Place)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (initProj : List ProjectionElem) (elem : RigidTy) (lIdx : LayoutIdx)
    (entry : BorrowEntry) (elems : List Value) (elemOff : Nat) (wide : WidePtrVal)
    (hTy : placeTy localDecls layouts place = some { kind := .slice elem, layoutIdx := lIdx })
    (hSplit : splitLastDeref? place.projection = some initProj)
    (hRead : evalPlaceRead locals { local_ := place.local_, projection := initProj } mem.borrows
      mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hBorrow : lookupBorrow mem.borrows wide.1.tag = some entry)
    (hPerm : TreeBorrowPerm.PermitsRead entry.perm)
    (hProj : entry.targetProjection = [])
    (hTarget : get? locals' entry.targetLocal = some (.init (.aggregate 0 elems)))
    (hElemOff : byteOffsetToElemIdx? wide.1.offsetBytes (inferElemListByteStride elems) =
      some elemOff)
    (hFit : elemOff + wide.2 ≤ elems.length)
    (hActive : mem.callStack = [] ∨ entry.targetFrameDepth = length mem.callStack := by
      exact Or.inl rfl)
    (hNoUninit : valueListContainsUninit elems = false := by rfl) :
    evalRvalue locals (.len place) mem localDecls layouts =
      .ok (.scalar ⟨wide.2, layoutPointerBytes layouts⟩) locals' mem := by
  have hb : Nat.ble (Nat.add elemOff wide.2) (length elems) = true :=
    Nat.ble_eq_true_of_le hFit
  have hTargetAF : activeFrameSlot? locals' mem.callStack entry.targetFrameDepth
      entry.targetLocal = some (.init (.aggregate 0 elems)) := by
    rw [activeFrameSlot?_eq_get?_of_active locals' entry.targetLocal hActive]
    exact hTarget
  show evalPlaceLen locals place mem localDecls layouts = _
  unfold evalPlaceLen
  dsimp (config := { zeta := true }) only
  rw [hTy]
  dsimp only
  rw [hSplit]
  dsimp only
  rw [hRead]
  simp only [WidePtrVal.toValue, Nat.beq_refl, Bool.and_self, hBorrow]
  cases hp : entry.perm with
  | disabled => rw [hp] at hPerm; cases hPerm
  | unique | frozen | reservedFrz _ | reservedIM | cell =>
    dsimp only
    rw [hTargetAF]
    dsimp only
    rw [hProj, readSliceBackingAggregate?_aggregate_zero_nil _ _ _ _ hNoUninit]
    dsimp only
    rw [hElemOff]
    dsimp only
    rw [show Nat.add elemOff 0 = elemOff from Nat.add_zero elemOff, hb]
    rfl

/--
**`ActiveTypedSliceBorrow.len_eq_borrow`**: for a borrow-backed slice lens on `wide.1.tag`
(`ActiveTypedSliceBorrow c mem.borrows wide.1.tag wide xs bytes`), both `Rvalue.len (*place)` and
`Rvalue.unaryOp .ptrMetadata ptrOp` evaluate to `.scalar ⟨xs.length, layoutPointerBytes layouts⟩`.
As in `WidePtrVal.evalRvalue_len_borrow`, the reads are against `mem.callStack` and `hActive`
(automatic at the root frame) states that the borrow targets the active frame.
-/
theorem ActiveTypedSliceBorrow.len_eq_borrow {α : Type} {n : Nat} {c : ByteLensCodec α n}
    {wide : WidePtrVal} {xs : List α} {bytes : ByteMem} {mem : Memory}
    (h : ActiveTypedSliceBorrow c mem.borrows wide.1.tag wide xs bytes)
    (locals locals' : List LocalSlot) (place : Place) (ptrOp : Operand)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (initProj : List ProjectionElem) (elem : RigidTy) (lIdx : LayoutIdx)
    (entry : BorrowEntry) (elems : List Value) (elemOff : Nat)
    (hTy : placeTy localDecls layouts place = some { kind := .slice elem, layoutIdx := lIdx })
    (hSplit : splitLastDeref? place.projection = some initProj)
    (hRead : evalPlaceRead locals { local_ := place.local_, projection := initProj } mem.borrows
      mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hOp : evalOperand locals ptrOp mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals')
    (hBorrow : lookupBorrow mem.borrows wide.1.tag = some entry)
    (hProj : entry.targetProjection = [])
    (hTarget : get? locals' entry.targetLocal = some (.init (.aggregate 0 elems)))
    (hElemOff : byteOffsetToElemIdx? wide.1.offsetBytes (inferElemListByteStride elems) =
      some elemOff)
    (hFit : elemOff + wide.2 ≤ elems.length)
    (hActive : mem.callStack = [] ∨ entry.targetFrameDepth = length mem.callStack := by
      exact Or.inl rfl)
    (hNoUninit : valueListContainsUninit elems = false := by rfl) :
    evalRvalue locals (.len place) mem localDecls layouts =
        .ok (.scalar ⟨xs.length, layoutPointerBytes layouts⟩) locals' mem ∧
      evalRvalue locals (.unaryOp .ptrMetadata ptrOp) mem localDecls layouts =
        .ok (.scalar ⟨xs.length, layoutPointerBytes layouts⟩) locals' mem := by
  obtain ⟨hs, entry₀, he₀, _, hp₀⟩ := h
  rw [hBorrow] at he₀
  cases he₀
  rw [hs.1]
  exact ⟨WidePtrVal.evalRvalue_len_borrow locals locals' place mem localDecls layouts initProj elem
      lIdx entry elems elemOff wide hTy hSplit hRead hBorrow hp₀ hProj hTarget hElemOff hFit
      hActive hNoUninit,
    WidePtrVal.evalRvalue_ptrMetadata locals locals' ptrOp mem localDecls layouts wide hOp⟩

theorem dropValues_eq_drop : ∀ (k : Nat) (xs : List Value), dropValues k xs = xs.drop k
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, _ :: xs => dropValues_eq_drop k xs

theorem takeValues_eq_take : ∀ (k : Nat) (xs : List Value), takeValues k xs = xs.take k
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, x :: xs => congrArg (x :: ·) (takeValues_eq_take k xs)

private theorem drop_map_eq {α β : Type} (f : α → β) :
    ∀ (k : Nat) (xs : List α), (xs.map f).drop k = (xs.drop k).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, _ :: xs => drop_map_eq f k xs

private theorem take_map_eq {α β : Type} (f : α → β) :
    ∀ (k : Nat) (xs : List α), (xs.map f).take k = (xs.take k).map f
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | k + 1, x :: xs => congrArg (f x :: ·) (take_map_eq f k xs)

/--
**`ActiveTypedSliceBorrow.evalPlaceRead_index_borrow`**: ground-MIR `evalPlaceRead` theorem for
checked element indexing `(*s)[idxLoc]` (`i < wide.2`) on a **borrow-backed** slice lens
`ActiveTypedSliceBorrow c mem.borrows wide.1.tag wide xs bytes` whose `BorrowEntry` targets
`entry.targetLocal` holding `.aggregate 0 (backingXs.map toVal)` with
`(backingXs.drop elemOff).take wide.2 = xs`. The read is against the memory's active inline call
stack `mem.callStack`; as in `WidePtrVal.evalRvalue_len_borrow`, `hActive` (automatic at the root
frame) states that the borrow targets the active frame, which the semantics genuinely needs for
`hTarget` to describe the borrowed local.
-/
theorem ActiveTypedSliceBorrow.evalPlaceRead_index_borrow {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {wide : WidePtrVal} {xs backingXs : List α} {bytes : ByteMem}
    {mem : Memory} (h : ActiveTypedSliceBorrow c mem.borrows wide.1.tag wide xs bytes)
    (toVal : α → Value) (locals : List LocalSlot) (slLoc idxLoc : Local) (i idxSz elemOff : Nat)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (elemKind : RigidTy) (pIdx : LayoutIdx) (accessedTyOpt : Option Ty) (entry : BorrowEntry)
    (hi : i < wide.2)
    (hSlot : get? locals slLoc =
      some (.init (WidePtrVal.toValue (layoutPointerBytes layouts) wide)))
    (hIdx : get? locals idxLoc = some (.init (.scalar ⟨i, idxSz⟩)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      some { kind := .slice elemKind, layoutIdx := pIdx })
    (hAccTy : placeTyResolved localDecls layouts
      { local_ := slLoc, projection := [.deref, .index idxLoc] } = accessedTyOpt)
    (hDerefAlign : checkDerefAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) wide.1.offsetBytes = true)
    (hBorrow : lookupBorrow mem.borrows wide.1.tag = some entry)
    (hProj : entry.targetProjection = [])
    (hTarget : get? locals entry.targetLocal = some (.init (.aggregate 0 (backingXs.map toVal))))
    (hTargetAlign : checkTargetPlaceAlign localDecls layouts
      (some { kind := .slice elemKind, layoutIdx := pIdx }) entry wide.1
      (some (.aggregate 0 (backingXs.map toVal))) = true)
    (hKindSz : rigidTyKindByteSize elemKind = some n)
    (hElemOff : byteOffsetToElemIdx? wide.1.offsetBytes n = some elemOff)
    (hFit : elemOff + wide.2 ≤ backingXs.length)
    (hSub : (backingXs.drop elemOff).take wide.2 = xs)
    (hValOk : validateValueForTy? layouts accessedTyOpt
      (toVal (xs[i]'(by rw [h.1.length_eq]; exact hi))) = true)
    (hActive : mem.callStack = [] ∨ entry.targetFrameDepth = length mem.callStack := by
      exact Or.inl rfl)
    (hNoUninit : ∀ x, valueContainsUninit (toVal x) = false := by intro _; rfl) :
    evalPlaceRead locals { local_ := slLoc, projection := [.deref, .index idxLoc] }
      mem.borrows mem.globals layouts mem.callerLocals localDecls mem.callStack =
        .ok (toVal (xs[i]'(by rw [h.1.length_eq]; exact hi))) locals := by
  have hTargetAF : activeFrameSlot? locals mem.callStack entry.targetFrameDepth
      entry.targetLocal = some (.init (.aggregate 0 (backingXs.map toVal))) := by
    rw [activeFrameSlot?_eq_get?_of_active locals entry.targetLocal hActive]
    exact hTarget
  have hp₀ : TreeBorrowPerm.PermitsRead entry.perm := by
    obtain ⟨_, entry₀, he₀, _, hp₀⟩ := h
    rw [hBorrow] at he₀
    cases he₀
    exact hp₀
  have hi' : i < xs.length := by rw [h.1.length_eq]; exact hi
  have hGetMap := get?_map_of_lt toVal xs i hi'
  have hBackInit : valueListContainsUninit (backingXs.map toVal) = false :=
    valueListContainsUninit_map_eq_false toVal hNoUninit backingXs
  have hElemInit : valueContainsUninit (toVal (xs[i]'hi')) = false := hNoUninit _
  have hBleRem : Nat.ble wide.2 (length (dropValues (Nat.add elemOff 0) (backingXs.map toVal))) =
      true := by
    change Nat.ble wide.2 (dropValues (elemOff + 0) (backingXs.map toVal)).length = true
    rw [Nat.add_zero, dropValues_eq_drop, List.length_drop, List.length_map]
    exact Nat.ble_eq_true_of_le (by omega)
  have hSliceElems :
      takeValues wide.2 (dropValues (Nat.add elemOff 0) (backingXs.map toVal)) = xs.map toVal := by
    change takeValues wide.2 (dropValues (elemOff + 0) (backingXs.map toVal)) = xs.map toVal
    rw [Nat.add_zero, dropValues_eq_drop, takeValues_eq_take, drop_map_eq, take_map_eq, hSub]
  unfold evalPlaceRead
  dsimp only
  rw [hAccTy, hPtTy, hSlot]
  change evalSliceFatPtrDerefRead locals wide.1 (layoutPointerBytes layouts)
      ⟨wide.2, layoutPointerBytes layouts⟩ [.index idxLoc] mem.borrows mem.globals layouts
      mem.callerLocals (some { kind := .slice elemKind, layoutIdx := pIdx }) localDecls
      accessedTyOpt mem.callStack = _
  unfold evalSliceFatPtrDerefRead
  dsimp (config := { zeta := true }) only
  rw [Nat.beq_refl, hDerefAlign, Bool.and_self, Bool.and_self]
  dsimp (config := { zeta := true }) only
  rw (config := { occs := .pos [1] }) [hBorrow]
  dsimp (config := { zeta := true }) only
  cases hp : entry.perm with
  | disabled => rw [hp] at hp₀; cases hp₀
  | unique | frozen | reservedFrz _ | reservedIM | cell =>
    dsimp (config := { zeta := true }) only
    rw [hTargetAF]
    dsimp (config := { zeta := true }) only
    rw [hTargetAlign]
    dsimp (config := { zeta := true }) only
    rw [hProj, readSliceBackingAggregate?_aggregate_zero_nil _ _ _ _ hBackInit]
    dsimp (config := { zeta := true }) only
    rw [hKindSz]
    dsimp (config := { zeta := true }) only
    rw [hElemOff]
    dsimp (config := { zeta := true }) only
    rw [hBleRem]
    dsimp (config := { zeta := true }) only
    rw [hSliceElems]
    simp only [readProjectedValue, hIdx, hGetMap, hElemInit, hValOk]

theorem appendValueList_eq_append :
    ∀ (xs ys : List Value), appendValueList xs ys = xs ++ ys
  | [], _ => rfl
  | x :: xs, ys => congrArg (x :: ·) (appendValueList_eq_append xs ys)

theorem set?_eq_some_set {α : Type} (xs : List α) {i : Nat} (v : α) (h : i < xs.length) :
    set? xs i v = some (xs.set i v) := by
  unfold set?
  exact ite_eq_left h

theorem take_append_set_drop_take_append_drop {α : Type} :
    ∀ (elemOff : Nat) (elems : List α) (wideLen i : Nat) (val : α),
      elemOff + wideLen ≤ elems.length → i < wideLen →
      elems.take elemOff ++ (((elems.drop elemOff).take wideLen).set i val ++
        elems.drop (elemOff + wideLen)) = elems.set (elemOff + i) val
  | 0, elems, wideLen, i, val, hFit, hi => by
    have hlt : i < (elems.take wideLen).length := by
      rw [List.length_take]
      omega
    rw [List.take_zero, List.nil_append, List.drop_zero, Nat.zero_add, Nat.zero_add,
      ← List.set_append_left i val hlt, List.take_append_drop]
  | elemOff + 1, [], wideLen, _, _, hFit, _ =>
    absurd hFit (by dsimp only [List.length_nil]; omega)
  | elemOff + 1, e :: rest, wideLen, i, val, hFit, hi => by
    have hFit' : elemOff + wideLen ≤ rest.length := by
      simp only [List.length_cons] at hFit
      omega
    have heq : elemOff + 1 + wideLen = (elemOff + wideLen) + 1 := by omega
    have heq2 : elemOff + 1 + i = (elemOff + i) + 1 := by omega
    rw [List.take_succ_cons, List.drop_succ_cons, heq, List.drop_succ_cons, List.cons_append,
      heq2, List.set_cons_succ]
    exact congrArg (e :: ·)
      (take_append_set_drop_take_append_drop elemOff rest wideLen i val hFit' hi)

theorem replaceSubslice_set_window (elems : List Value) (elemOff wideLen i : Nat)
    (val : Value) (hFit : elemOff + wideLen ≤ elems.length) (hi : i < wideLen) :
    replaceSubslice elems elemOff (Nat.add elemOff wideLen) false
      ((takeValues wideLen (dropValues elemOff elems)).set i val) =
      some (elems.set (elemOff + i) val) := by
  have hBleEnd : Nat.ble (Nat.add elemOff wideLen) (length elems) = true :=
    Nat.ble_eq_true_of_le hFit
  have hBleStart : Nat.ble elemOff (Nat.add elemOff wideLen) = true :=
    Nat.ble_eq_true_of_le (Nat.le_add_right elemOff wideLen)
  have hSub : Nat.sub (Nat.add elemOff wideLen) elemOff = wideLen :=
    Nat.add_sub_cancel_left elemOff wideLen
  have hLenNew : length ((takeValues wideLen (dropValues elemOff elems)).set i val) = wideLen := by
    change ((takeValues wideLen (dropValues elemOff elems)).set i val).length = wideLen
    rw [List.length_set, takeValues_eq_take, dropValues_eq_drop, List.length_take, List.length_drop]
    omega
  unfold replaceSubslice
  dsimp only
  rw [hBleEnd]
  dsimp only
  rw [hBleStart]
  dsimp only
  rw [hSub, hLenNew, Nat.beq_refl]
  dsimp only
  rw [appendValueList_eq_append, appendValueList_eq_append, takeValues_eq_take,
    takeValues_eq_take, dropValues_eq_drop, dropValues_eq_drop]
  exact congrArg some
    (take_append_set_drop_take_append_drop elemOff elems wideLen i val hFit hi)

private theorem lt_length_of_get?_some {α : Type} :
    ∀ {xs : List α} {idx : Nat} {v : α}, get? xs idx = some v → idx < xs.length
  | [], _, _, h => nomatch h
  | _ :: _, 0, _, _ => Nat.zero_lt_succ _
  | _ :: xs, _idx + 1, _, h => Nat.succ_lt_succ (lt_length_of_get?_some (xs := xs) h)

private theorem map_set_eq {α β : Type} (f : α → β) :
    ∀ (xs : List α) (i : Nat) (v : α), (xs.set i v).map f = (xs.map f).set i (f v)
  | [], _, _ => rfl
  | _ :: _, 0, _ => rfl
  | x :: xs, i + 1, v => congrArg (f x :: ·) (map_set_eq f xs i v)

@[simp]
theorem writeProjectedValue_aggregate_zero_constantIndex_zero (locals : List LocalSlot)
    (fields : List Value) (i : Nat) (newVal : Value) :
    writeProjectedValue locals (.aggregate 0 fields) [.constantIndex i 0 false] newVal =
      (match get? fields i with
       | some _ =>
         match set? fields i newVal with
         | some fields' => .ok (.aggregate 0 fields')
         | none => .ub
       | none => .ub) := rfl

theorem writeProjectedValue_aggregate_zero_constantIndex_of_lt (locals : List LocalSlot)
    (fields : List Value) {i : Nat} (newVal : Value) (hi : i < fields.length) :
    writeProjectedValue locals (.aggregate 0 fields) [.constantIndex i 0 false] newVal =
      .ok (.aggregate 0 (fields.set i newVal)) := by
  have hGet : get? fields i = some fields[i] := List.getElem?_eq_getElem hi
  rw [writeProjectedValue_aggregate_zero_constantIndex_zero, hGet, set?_eq_some_set fields newVal hi]

theorem writeSliceFatPtrTargetValue_constantIndex_of_lt (locals : List LocalSlot)
    (elems : List Value) (ptrVal : ProvenancePtr) (wideLen elemOff i : Nat) (val : Value)
    (hElemOff : byteOffsetToElemIdx? ptrVal.offsetBytes (inferElemListByteStride elems) =
      some elemOff)
    (hFit : elemOff + wideLen ≤ elems.length) (hi : i < wideLen)
    (hNoUninit : valueListContainsUninit elems = false := by rfl) :
    writeSliceFatPtrTargetValue locals (.aggregate 0 elems) [] ptrVal 8 ⟨wideLen, 8⟩
        [.constantIndex i 0 false] val =
      .ok (.aggregate 0 (elems.set (elemOff + i) val)) := by
  have hiSlice : i < (takeValues wideLen (dropValues elemOff elems)).length := by
    rw [takeValues_eq_take, dropValues_eq_drop, List.length_take, List.length_drop]
    omega
  unfold writeSliceFatPtrTargetValue
  rw [Nat.beq_refl, Bool.and_self]
  dsimp (config := { zeta := true }) only
  rw [readSliceBackingAggregate?_aggregate_zero_nil _ _ _ _ hNoUninit]
  dsimp (config := { zeta := true }) only
  rw [hElemOff]
  dsimp (config := { zeta := true }) only
  rw [show Nat.add elemOff 0 = elemOff from Nat.add_zero elemOff,
    show Nat.ble (Nat.add elemOff wideLen) (length elems) = true from Nat.ble_eq_true_of_le hFit]
  dsimp (config := { zeta := true }) only
  rw [writeProjectedValue_aggregate_zero_constantIndex_of_lt locals _ val hiSlice]
  change (match replaceSubslice elems elemOff (Nat.add elemOff wideLen) false
      ((takeValues wideLen (dropValues elemOff elems)).set i val) with
    | some elems' => writeProjectedValue locals (.aggregate 0 elems) [] (.aggregate 0 elems')
    | none => .ub) = _
  rw [replaceSubslice_set_window elems elemOff wideLen i val hFit hi]
  rfl

/--
**`ActiveTypedSliceMutBorrow.writePlaceValue_constantIndex_borrow`**: symbolic ground-MIR theorem
for `writePlaceValue` on a borrow-backed slice fat pointer `(*slLoc)[.constantIndex i 0 false] = toVal v`.
Given `ActiveTypedSliceMutBorrow c borrows wide.1.tag wide xs bytes` whose `BorrowEntry` in
`borrows` targets `entry.targetLocal` (`entry.targetProjection = []`) holding
`.aggregate 0 (backingXs.map toVal)` at element offset `elemOff`, `writePlaceValue` succeeds and
updates `locals[entry.targetLocal]` to `.init (.aggregate 0 ((backingXs.set (elemOff + i) v).map toVal))`.

The write runs under the active inline call stack `callStack` (default `[]`, the root frame).
Borrow targets are frame-qualified `(targetFrameDepth, targetLocal)` pairs resolved through
`activeFrameSlot?`, so `hTarget` describes the borrowed local only when the borrow targets the
active frame: that is the frame-depth hypothesis `hActive` the semantics genuinely needs
(`callStack = []`, discharged automatically, or `entry.targetFrameDepth = length callStack`).
-/
theorem ActiveTypedSliceMutBorrow.writePlaceValue_constantIndex_borrow {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {wide : WidePtrVal}
    {xs backingXs : List α} {bytes : ByteMem}
    (h : ActiveTypedSliceMutBorrow c borrows wide.1.tag wide xs bytes)
    (toVal : α → Value) (locals : List LocalSlot) (slLoc : Local) (i elemOff : Nat) (v : α)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (pointeeTyOpt accessedTyOpt : Option Ty) (entry : BorrowEntry)
    (hi : i < wide.2)
    (hSlot : get? locals slLoc = some (.init (WidePtrVal.toValue 8 wide)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      pointeeTyOpt)
    (hAccTy : placeTyResolved localDecls layouts
      { local_ := slLoc, projection := [.deref, .constantIndex i 0 false] } = accessedTyOpt)
    (hDerefAlign : checkDerefAlign localDecls layouts pointeeTyOpt wide.1.offsetBytes = true)
    (hValOk : validateValueForTy? layouts accessedTyOpt (toVal v) = true)
    (hBorrow : lookupBorrow borrows wide.1.tag = some entry)
    (hProj : entry.targetProjection = [])
    (hTarget : get? locals entry.targetLocal = some (.init (.aggregate 0 (backingXs.map toVal))))
    (hTargetAlign : checkTargetPlaceAlign localDecls layouts pointeeTyOpt entry wide.1
      (some (.aggregate 0 (backingXs.map toVal))) = true)
    (hElemOff : byteOffsetToElemIdx? wide.1.offsetBytes
      (inferElemListByteStride (backingXs.map toVal)) = some elemOff)
    (hFit : elemOff + wide.2 ≤ backingXs.length)
    (callStack : List SavedCallerFrame := .nil)
    (hActive : callStack = [] ∨ entry.targetFrameDepth = length callStack := by
      exact Or.inl rfl)
    (hNoUninit : ∀ x, valueContainsUninit (toVal x) = false := by intro _; rfl) :
    writePlaceValue locals borrows
        { local_ := slLoc, projection := [.deref, .constantIndex i 0 false] }
        (toVal v) localDecls layouts callStack =
      .ok (locals.set entry.targetLocal
        (.init (.aggregate 0 ((backingXs.set (elemOff + i) v).map toVal)))) := by
  have hTargetAF : activeFrameSlot? locals callStack entry.targetFrameDepth
      entry.targetLocal = some (.init (.aggregate 0 (backingXs.map toVal))) := by
    rw [activeFrameSlot?_eq_get?_of_active locals entry.targetLocal hActive]
    exact hTarget
  have hp₀ : TreeBorrowPerm.PermitsUniqueWrite entry.perm := by
    obtain ⟨_, entry₀, he₀, _, hp₀⟩ := h
    rw [hBorrow] at he₀
    cases he₀
    exact hp₀
  have hFitMap : elemOff + wide.2 ≤ (backingXs.map toVal).length := by
    rw [List.length_map]; exact hFit
  have hTargetLt : entry.targetLocal < locals.length := lt_length_of_get?_some hTarget
  have hSetLocals :
      set? locals entry.targetLocal
        (.init (.aggregate 0 ((backingXs.map toVal).set (elemOff + i) (toVal v)))) =
        some (locals.set entry.targetLocal
          (.init (.aggregate 0 ((backingXs.set (elemOff + i) v).map toVal)))) := by
    rw [set?_eq_some_set locals _ hTargetLt, ← map_set_eq]
  have hBackInit : valueListContainsUninit (backingXs.map toVal) = false :=
    valueListContainsUninit_map_eq_false toVal hNoUninit backingXs
  have hWriteTarget := writeSliceFatPtrTargetValue_constantIndex_of_lt locals
    (backingXs.map toVal) wide.1 wide.2 elemOff i (toVal v) hElemOff hFitMap hi hBackInit
  unfold writePlaceValue
  dsimp (config := { zeta := true }) only
  rw [hSlot]
  simp only [WidePtrVal.toValue]
  rw [hPtTy, hAccTy]
  cases pointeeTyOpt <;> {
    dsimp only
    rw [hDerefAlign, hValOk, Bool.and_self]
    dsimp only
    rw [hBorrow]
    dsimp only
    cases hp : entry.perm with
    | frozen => have h0 := hp₀ false; rw [hp] at h0; cases h0
    | disabled => have h0 := hp₀ false; rw [hp] at h0; cases h0
    | cell => have h0 := hp₀ false; rw [hp] at h0; cases h0
    | unique | reservedFrz _ | reservedIM =>
      dsimp only
      rw [hTargetAF]
      dsimp only
      rw [hTargetAlign]
      dsimp only
      rw [hProj, hWriteTarget]
      dsimp only
      rw [hSetLocals]
  }

/--
**`ActiveTypedSliceMutBorrow.writePlaceValue_constantIndex_encodeElems_connected`**: symbolic
end-to-end bridge connecting ground-MIR `writePlaceValue` (`(*slLoc)[.constantIndex i 0 false] = toVal v`),
`encodeUntypedValueToBytes` on the backing array aggregate in `locals[entry.targetLocal]`,
`writeTyped` on the encoded byte buffer `ByteLensCodec.encodeElems c backingXs`, and
`invalidateDerefWriteBorrowsWithLayouts` across writer (`wide.1.tag`), disjoint tight sibling
(`tag'`), and ancestor (`rootTag`) `ActiveTypedSliceMutBorrow` lenses. The write and its borrow
update run under the active inline call stack `callStack` (default `[]`, the root frame), with
`hActive` as in `writePlaceValue_constantIndex_borrow`.
-/
theorem ActiveTypedSliceMutBorrow.writePlaceValue_constantIndex_encodeElems_connected
    {α β : Type} {n m : Nat} {c : ByteLensCodec α n} {c' : ByteLensCodec β m}
    {borrows : List BorrowEntry} {wide wide' rootWide : WidePtrVal} {tag' rootTag : Nat}
    {xs backingXs : List α} {ys : List β}
    (toVal : α → Value) (fuel : Nat)
    (h_enc : ∀ x, encodeUntypedValueToBytes fuel (toVal x) = some (c.encode x))
    (locals : List LocalSlot) (slLoc : Local) (i elemOff : Nat) (v : α)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (pointeeTyOpt accessedTyOpt : Option Ty) (entry : BorrowEntry)
    (h : ActiveTypedSliceMutBorrow c borrows wide.1.tag wide xs
      (ByteLensCodec.encodeElems c backingXs))
    (hTight : TightBorrowRange borrows wide.1.tag wide n)
    (hSib : ActiveTypedSliceMutBorrow c' borrows tag' wide' ys
      (ByteLensCodec.encodeElems c backingXs))
    (hSibTight : TightBorrowRange borrows tag' wide' m)
    (hdisj : DisjointSlice wide.1.offsetBytes (wide.2 * n) wide'.1.offsetBytes (wide'.2 * m))
    (hRoot : ActiveTypedSliceMutBorrow c borrows rootTag rootWide backingXs
      (ByteLensCodec.encodeElems c backingXs))
    (hDesc : isBorrowDescendantOrSelf borrows wide.1.tag rootTag = true)
    (hRootBase : rootWide.1.offsetBytes = 0)
    (hLen : 2 ≤ borrows.length)
    (hi : i < wide.2)
    (hSlot : get? locals slLoc = some (.init (WidePtrVal.toValue 8 wide)))
    (hPtTy : placeTyResolved localDecls layouts { local_ := slLoc, projection := [.deref] } =
      pointeeTyOpt)
    (hAccTy : placeTyResolved localDecls layouts
      { local_ := slLoc, projection := [.deref, .constantIndex i 0 false] } = accessedTyOpt)
    (hDerefAlign : checkDerefAlign localDecls layouts pointeeTyOpt wide.1.offsetBytes = true)
    (hValOk : validateValueForTy? layouts accessedTyOpt (toVal v) = true)
    (hBorrow : lookupBorrow borrows wide.1.tag = some entry)
    (hProj : entry.targetProjection = [])
    (hTarget : get? locals entry.targetLocal = some (.init (.aggregate 0 (backingXs.map toVal))))
    (hTargetAlign : checkTargetPlaceAlign localDecls layouts pointeeTyOpt entry wide.1
      (some (.aggregate 0 (backingXs.map toVal))) = true)
    (hElemOff : byteOffsetToElemIdx? wide.1.offsetBytes
      (inferElemListByteStride (backingXs.map toVal)) = some elemOff)
    (hOffBytes : wide.1.offsetBytes = elemOff * n)
    (hFit : elemOff + wide.2 ≤ backingXs.length)
    (callStack : List SavedCallerFrame := .nil)
    (hActive : callStack = [] ∨ entry.targetFrameDepth = length callStack := by
      exact Or.inl rfl)
    (hNoUninit : ∀ x, valueContainsUninit (toVal x) = false := by intro _; rfl) :
    let dst : Place := { local_ := slLoc, projection := [.deref, .constantIndex i 0 false] }
    let backingVal' : Value := .aggregate 0 ((backingXs.set (elemOff + i) v).map toVal)
    let bytes' : ByteMem := ByteLensCodec.encodeElems c (backingXs.set (elemOff + i) v)
    let borrows' :=
      invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals borrows dst
        [.constantIndex i 0 false] callStack
    encodeUntypedValueToBytes (fuel + 1) (.aggregate 0 (backingXs.map toVal)) =
        some (ByteLensCodec.encodeElems c backingXs) ∧
      writePlaceValue locals borrows dst (toVal v) localDecls layouts callStack =
        .ok (locals.set entry.targetLocal (.init backingVal')) ∧
      encodeUntypedValueToBytes (fuel + 1) backingVal' = some bytes' ∧
      writeTyped c (WidePtrVal.elemOffset wide n i) v (ByteLensCodec.encodeElems c backingXs) =
        some bytes' ∧
      ActiveTypedSliceMutBorrow c borrows' wide.1.tag wide (xs.set i v) bytes' ∧
      ActiveTypedSliceMutBorrow c' borrows' tag' wide' ys bytes' ∧
      ActiveTypedSliceMutBorrow c borrows' rootTag rootWide (backingXs.set (elemOff + i) v) bytes' := by
  intro dst backingVal' bytes' borrows'
  have hIdxLt : elemOff + i < backingXs.length := by omega
  have hElemOffEq : WidePtrVal.elemOffset wide n i = (elemOff + i) * n := by
    simp only [WidePtrVal.elemOffset, hOffBytes, Nat.add_mul]
  have hw : writeTyped c (WidePtrVal.elemOffset wide n i) v
      (ByteLensCodec.encodeElems c backingXs) = some bytes' := by
    rw [hElemOffEq]
    exact writeTyped_encodeElems_set c backingXs hIdxLt v
  have hwRoot : writeTyped c (WidePtrVal.elemOffset rootWide n (elemOff + i)) v
      (ByteLensCodec.encodeElems c backingXs) = some bytes' := by
    have hRootOff : WidePtrVal.elemOffset rootWide n (elemOff + i) = (elemOff + i) * n := by
      simp only [WidePtrVal.elemOffset, hRootBase, Nat.zero_add]
    rw [hRootOff]
    exact writeTyped_encodeElems_set c backingXs hIdxLt v
  have hRootSl' : SliceTypedAt c rootWide (backingXs.set (elemOff + i) v) bytes' :=
    SliceTypedAt.write_elem hRoot.1 (by rw [← hRoot.1.length_eq]; exact hIdxLt) v hwRoot
  obtain ⟨hW, hS⟩ := ActiveTypedSliceMutBorrow.derefWriteWithLayouts_frame localDecls layouts
    locals dst [.constantIndex i 0 false] (WidePtrVal.toValue 8 wide) wide.1 hLen hSlot rfl rfl
    h hTight hi v hw hSib hSibTight hdisj (callStack := callStack)
  have hAnc := ActiveTypedSliceMutBorrow.derefWriteWithLayouts_ancestor localDecls layouts
    locals dst [.constantIndex i 0 false] (WidePtrVal.toValue 8 wide) wide.1 hLen hSlot rfl rfl
    hRoot hDesc hRootSl' (callStack := callStack)
  exact ⟨encodeUntypedValueToBytes_aggregate_map c toVal fuel 0 h_enc backingXs,
    ActiveTypedSliceMutBorrow.writePlaceValue_constantIndex_borrow h toVal locals slLoc i elemOff v
      localDecls layouts pointeeTyOpt accessedTyOpt entry hi hSlot hPtTy hAccTy hDerefAlign hValOk
      hBorrow hProj hTarget hTargetAlign hElemOff hFit callStack hActive hNoUninit,
    encodeUntypedValueToBytes_aggregate_map c toVal fuel 0 h_enc (backingXs.set (elemOff + i) v),
    hw, hW, hS, hAnc⟩

/-! ### Single-borrow deref writes (one live `&mut [T]`) -/

/-- A trusted flat (conflicting-borrows) write update performed *through the writer's own tag*
keeps the writer's lens live: same byte range, unique-write permission (`.reservedFrz false`
activates to `.unique`), with any new view `xs'` of its window, for a write into the frame at any
depth `targetFrameDepth` (default `0`, the root frame). -/
theorem ActiveTypedSliceMutBorrow.conflictingAtProj_self {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {borrows : List BorrowEntry} {tag : Nat} {wide : WidePtrVal}
    {xs xs' : List α} {bytes bytes' : ByteMem} (targetLocal : Local)
    (writeProj : List ProjectionElem) (writeOff writeLen : Nat)
    (h : ActiveTypedSliceMutBorrow c borrows tag wide xs bytes)
    (hs' : SliceTypedAt c wide xs' bytes') (targetFrameDepth : Nat := 0) :
    ActiveTypedSliceMutBorrow c
      (invalidateConflictingBorrowsAtProj borrows targetLocal (some tag) writeProj writeOff
        writeLen targetFrameDepth) tag wide xs' bytes' := by
  obtain ⟨_, entry, he, hc, hp⟩ := h
  have htag : entry.tag = tag := lookupBorrow_tag he
  obtain ⟨hc', hp'⟩ := updateBorrowPermAtProj_self_permitsUniqueWrite entry targetLocal writeProj
    writeOff writeLen wide.1.offsetBytes (wide.2 * n) hc hp (targetFrameDepth := targetFrameDepth)
  refine ⟨hs', updateBorrowPermAtProj entry targetLocal (some tag) writeProj writeOff writeLen
    targetFrameDepth, ?_, ?_, ?_⟩
  · rw [lookupBorrow_invalidateConflictingBorrowsAtProj, he]
    rfl
  · rw [← htag]
    exact hc'
  · rw [← htag]
    exact hp'

/--
**`ActiveTypedSliceMutBorrow.derefWriteWithLayouts_single`**: the single-borrow case (one live
`&mut [T]`), which every `2 ≤ borrows.length` deref-write bridge excludes. On a one-entry table,
the trusted deref-write borrow update `invalidateDerefWriteBorrowsWithLayouts` through the
(thin or 64-bit fat) pointer of the writer tag, whose entry has the tight range of its window,
is the flat `invalidateConflictingBorrowsAtProj` over that range (in the frame at the writer
entry's own depth), and the writer lens stays live with the updated view `xs.set i v`, under every
active inline call stack `callStack` (default `[]`, the root frame).
-/
theorem ActiveTypedSliceMutBorrow.derefWriteWithLayouts_single {α : Type} {n : Nat}
    {c : ByteLensCodec α n} {e₀ : BorrowEntry} {tag : Nat} {wide : WidePtrVal} {xs : List α}
    {bytes bytes' : ByteMem} (localDecls : List LocalDecl) (layouts : LayoutTable)
    (locals : List LocalSlot) (dst : Place) (restProj : List ProjectionElem) (fat : Value)
    (ptrVal : ProvenancePtr)
    (hSlot : get? locals dst.local_ = some (.init fat))
    (hExt : extractDerefPtrVal? fat = some ptrVal) (hTag : ptrVal.tag = tag)
    (h : ActiveTypedSliceMutBorrow c [e₀] tag wide xs bytes)
    (hTight : TightBorrowRange [e₀] tag wide n)
    {i : Nat} (hi : i < wide.2) (v : α)
    (hw : writeTyped c (WidePtrVal.elemOffset wide n i) v bytes = some bytes')
    (callStack : List SavedCallerFrame := .nil) :
    ActiveTypedSliceMutBorrow c
      (invalidateDerefWriteBorrowsWithLayouts localDecls layouts locals [e₀] dst restProj callStack)
      tag wide (xs.set i v) bytes' := by
  obtain ⟨entry, he, _, _⟩ := h.2
  obtain ⟨_, _, hPos⟩ := hTight entry he
  have hs' : SliceTypedAt c wide (xs.set i v) bytes' := SliceTypedAt.write_elem h.1 hi v hw
  have hNz : Nat.beq entry.rangeLen 0 = false := nat_beq_eq_false_of_ne (by omega)
  have he' : lookupBorrow [e₀] ptrVal.tag = some entry := by rw [hTag]; exact he
  unfold invalidateDerefWriteBorrowsWithLayouts
  dsimp only
  rw [hSlot]
  dsimp only
  rw [hExt]
  dsimp only
  rw [he']
  dsimp only
  rw [hTag]
  split
  · rw [hNz]
    exact ActiveTypedSliceMutBorrow.conflictingAtProj_self _ _ _ _ h hs'
      (targetFrameDepth := entry.targetFrameDepth)
  · exact ActiveTypedSliceMutBorrow.conflictingAtProj_self _ _ _ _ h hs'
      (targetFrameDepth := entry.targetFrameDepth)

/-! ### Unsized DST Pointer Metadata Lenses (`PtrMetadataOf`, `UnsizedSliceDstAt`) & Dynamic Layout Bridges -/

/-- Data-pointer `Value` component of a wide pointer (`.ptr wide.1 ptrBytes`). -/
@[reducible]
def WidePtrVal.dataVal (ptrBytes : Nat) (wide : WidePtrVal) : Value :=
  .ptr wide.1 ptrBytes

/-- Metadata `Value` component of a wide slice/`str` pointer (`.scalar ⟨wide.2, ptrBytes⟩`). -/
@[reducible]
def WidePtrVal.metaVal (ptrBytes : Nat) (wide : WidePtrVal) : Value :=
  .scalar ⟨wide.2, ptrBytes⟩

@[simp]
theorem WidePtrVal.dataVal_mk (ptrBytes : Nat) (p : ProvenancePtr) (len : Nat) :
    WidePtrVal.dataVal ptrBytes (WidePtrVal.mk p len) = .ptr p ptrBytes := rfl

@[simp]
theorem WidePtrVal.metaVal_mk (ptrBytes : Nat) (p : ProvenancePtr) (len : Nat) :
    WidePtrVal.metaVal ptrBytes (WidePtrVal.mk p len) = .scalar ⟨len, ptrBytes⟩ := rfl

@[simp]
theorem WidePtrVal.dataVal_takeElems (ptrBytes : Nat) (wide : WidePtrVal) (k : Nat) :
    WidePtrVal.dataVal ptrBytes (WidePtrVal.takeElems wide k) =
      WidePtrVal.dataVal ptrBytes wide := rfl

@[simp]
theorem WidePtrVal.metaVal_takeElems (ptrBytes : Nat) (wide : WidePtrVal) (k : Nat) :
    WidePtrVal.metaVal ptrBytes (WidePtrVal.takeElems wide k) = .scalar ⟨k, ptrBytes⟩ := rfl

@[simp]
theorem WidePtrVal.dataVal_dropElems (ptrBytes : Nat) (wide : WidePtrVal) (n k : Nat) :
    WidePtrVal.dataVal ptrBytes (WidePtrVal.dropElems wide n k) =
      .ptr (WidePtrVal.elemPtr wide n k) ptrBytes := rfl

@[simp]
theorem WidePtrVal.metaVal_dropElems (ptrBytes : Nat) (wide : WidePtrVal) (n k : Nat) :
    WidePtrVal.metaVal ptrBytes (WidePtrVal.dropElems wide n k) =
      .scalar ⟨wide.2 - k, ptrBytes⟩ := rfl

theorem WidePtrVal.toValue_eq_dataVal_metaVal (ptrBytes : Nat) (wide : WidePtrVal) :
    WidePtrVal.toValue ptrBytes wide =
      .aggregate 0 [WidePtrVal.dataVal ptrBytes wide, WidePtrVal.metaVal ptrBytes wide] := rfl

/--
**`PtrMetadataOf`**: characterizes the runtime metadata `Value` extracted by `UnOp.ptrMetadata`
at pointer byte width `ptrBytes`:
- wide `[T]` / `str` pointers (`WidePtrVal.toValue ptrBytes wide`) have metadata
  `WidePtrVal.metaVal ptrBytes wide = .scalar ⟨wide.2, ptrBytes⟩`;
- thin pointers (`.ptr p ptrBytes`) have metadata `.unit`.
-/
inductive PtrMetadataOf (ptrBytes : Nat) : Value → Value → Prop where
  | wide (wide : WidePtrVal) :
      PtrMetadataOf ptrBytes (WidePtrVal.toValue ptrBytes wide) (.scalar ⟨wide.2, ptrBytes⟩)
  | thin (p : ProvenancePtr) :
      PtrMetadataOf ptrBytes (.ptr p ptrBytes) .unit

theorem PtrMetadataOf.wide_mk (ptrBytes : Nat) (p : ProvenancePtr) (len : Nat) :
    PtrMetadataOf ptrBytes (WidePtrVal.toValue ptrBytes (WidePtrVal.mk p len))
      (.scalar ⟨len, ptrBytes⟩) :=
  .wide (WidePtrVal.mk p len)

/-- `PtrMetadataOf` uniquely determines the extracted metadata `Value`. -/
theorem PtrMetadataOf.unique {ptrBytes : Nat} {ptrVal m₁ m₂ : Value}
    (h₁ : PtrMetadataOf ptrBytes ptrVal m₁) (h₂ : PtrMetadataOf ptrBytes ptrVal m₂) :
    m₁ = m₂ := by
  cases h₁ with
  | wide w₁ =>
    generalize hVal : WidePtrVal.toValue ptrBytes w₁ = v at h₂
    cases h₂ with
    | wide w₂ =>
      have hw : w₁ = w₂ := WidePtrVal.toValue_injective hVal
      rw [hw]
    | thin p₂ => cases hVal
  | thin p₁ =>
    generalize hVal : Value.ptr p₁ ptrBytes = v at h₂
    cases h₂ with
    | wide w₂ => cases hVal
    | thin p₂ => rfl

/-- **`PtrMetadataOf.evalRvalue_ptrMetadata`**: unified ground-MIR theorem for `UnOp.ptrMetadata`
across both wide slice/`str` pointers and thin pointers. -/
theorem PtrMetadataOf.evalRvalue_ptrMetadata {locals locals' : List LocalSlot} {op : Operand}
    {mem : Memory} {localDecls : List LocalDecl} {layouts : LayoutTable}
    {ptrVal metaVal : Value}
    (hMeta : PtrMetadataOf (layoutPointerBytes layouts) ptrVal metaVal)
    (hOp : evalOperand locals op mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok ptrVal locals') :
    evalRvalue locals (.unaryOp .ptrMetadata op) mem localDecls layouts =
      .ok metaVal locals' mem := by
  cases hMeta with
  | wide wide =>
    exact WidePtrVal.evalRvalue_ptrMetadata locals locals' op mem localDecls layouts wide hOp
  | thin p =>
    exact evalRvalue_unaryOp_ptrMetadata_thin locals locals' op mem localDecls layouts p hOp

/-- **`evalRvalue_unaryOp_ptrMetadata_slice`** (the brief's named form, stated on `WidePtrVal`):
`Rvalue.unaryOp .ptrMetadata op` on the trusted wide `[T]` / `str` pointer
`WidePtrVal.toValue ptrBytes wide` (`ptrBytes = layoutPointerBytes layouts`) yields the metadata
`.scalar ⟨wide.2, ptrBytes⟩` with `locals'` and `mem` unchanged, without dereferencing `wide.1`. -/
theorem evalRvalue_unaryOp_ptrMetadata_slice (locals locals' : List LocalSlot) (op : Operand)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable) (wide : WidePtrVal)
    (hOp : evalOperand locals op mem.borrows mem.globals layouts mem.callerLocals localDecls
      mem.callStack = .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals') :
    evalRvalue locals (.unaryOp .ptrMetadata op) mem localDecls layouts =
      .ok (.scalar ⟨wide.2, layoutPointerBytes layouts⟩) locals' mem :=
  evalRvalue_unaryOp_ptrMetadata_wide locals locals' op mem localDecls layouts wide.1 wide.2 hOp

/-- **`evalRvalue_aggregate_rawPtr_slice_roundtrip`** (stated on `WidePtrVal`):
projecting `.field 0` (data pointer) and `.field 1` (length) from a decomposed
2-field `(data, meta)` aggregate at `loc` holding `WidePtrVal.toValue ptrBytes wide`
and reassembling with `AggregateKind.rawPtr` on `.slice elemTy`
(`ptr::slice_from_raw_parts(_mut)`) is the exact identity on the wide pointer,
leaving `locals` and `mem` unchanged. Note that rustc lowers
`<*const [T]>::to_raw_parts` to `CastKind.ptrToPtr` + `UnOp.ptrMetadata` rather
than MIR `.field` projections on a raw-pointer place. -/
theorem evalRvalue_aggregate_rawPtr_slice_roundtrip (locals : List LocalSlot) (loc : Local)
    (elemTy : RigidTy) (lIdx : LayoutIdx) (dataTy metaTy : Ty) (mutability : Mutability)
    (mem : Memory) (localDecls : List LocalDecl) (layouts : LayoutTable) (wide : WidePtrVal)
    (hSlot : get? locals loc =
      some (.init (WidePtrVal.toValue (layoutPointerBytes layouts) wide)))
    (hNoUnion0 : placeTouchesUnion localDecls layouts
      { local_ := loc, projection := [.field 0 dataTy] } = false)
    (hNoUnion1 : placeTouchesUnion localDecls layouts
      { local_ := loc, projection := [.field 1 metaTy] } = false) :
    evalRvalue locals
        (.aggregate (.rawPtr { kind := .slice elemTy, layoutIdx := lIdx } mutability)
          [.copy { local_ := loc, projection := [.field 0 dataTy] },
           .copy { local_ := loc, projection := [.field 1 metaTy] }])
        mem localDecls layouts =
      .ok (WidePtrVal.toValue (layoutPointerBytes layouts) wide) locals mem :=
  evalRvalue_aggregate_rawPtr_to_raw_parts_roundtrip locals loc
    { kind := .slice elemTy, layoutIdx := lIdx } dataTy metaTy mutability mem localDecls layouts
    wide.1 wide.2 rfl hSlot hNoUnion0 hNoUnion1

/-- Predicate characterizing an unsized slice-like DST `RigidTy` paired with a
caller-supplied element byte stride parameter `n`: `.str` pins `n = 1`, while
`.slice elemTy` leaves `n` unconstrained here so callers pair it with a
`ByteLensCodec α n` (and with `intrinsicRigidTyByteSize elemTy = some n` at
layout-intrinsic call sites). -/
@[reducible]
def IsUnsizedSliceDstTy (dstTy : RigidTy) (n : Nat) : Prop :=
  (∃ elemTy, dstTy = .slice elemTy) ∨ (dstTy = .str ∧ n = 1)

theorem IsUnsizedSliceDstTy.slice (elemTy : RigidTy) (n : Nat) :
    IsUnsizedSliceDstTy (.slice elemTy) n :=
  Or.inl ⟨elemTy, rfl⟩

theorem IsUnsizedSliceDstTy.str :
    IsUnsizedSliceDstTy .str 1 :=
  Or.inr ⟨rfl, rfl⟩

theorem IsUnsizedSliceDstTy.wideAggregatePointeeIsDyn_eq_some_false {dstTy : RigidTy} {n : Nat}
    (h : IsUnsizedSliceDstTy dstTy n) (lIdx : LayoutIdx) :
    wideAggregatePointeeIsDyn? { kind := dstTy, layoutIdx := lIdx } = some false := by
  rcases h with ⟨elemTy, rfl⟩ | ⟨rfl, _⟩ <;> rfl

theorem IsUnsizedSliceDstTy.isUnsizedRawPtrPointee_eq_true {dstTy : RigidTy} {n : Nat}
    (h : IsUnsizedSliceDstTy dstTy n) (lIdx : LayoutIdx) :
    isUnsizedRawPtrPointee { kind := dstTy, layoutIdx := lIdx } = true := by
  rcases h with ⟨elemTy, rfl⟩ | ⟨rfl, _⟩ <;> rfl

/--
**`UnsizedSliceDstBacking`**: `Memory`-side backing condition for an unsized
slice DST at `wide` with caller-supplied element byte stride `n`:
- `global`: pins `bytes` directly to the live byte image of `wide.1`'s captured
  global allocation in `mem.globals` (`LiveSliceImage mem wide bytes`);
- `borrow`: mirrors `ActiveTypedSliceBorrow` / `ActiveTypedSliceMutBorrow` by
  grounding active borrow tag (`wide.1.tag`), Tree Borrows read permission
  (`PermitsRead`: `.shared` / `.unique` / `.reserved`), and byte extent
  (`BorrowRangeCovers` over `[wide.1.offsetBytes, wide.1.offsetBytes + wide.2 * n)`)
  in `mem.borrows` (while `bytes` carries the caller's `SliceTypedAt` logical
  witness rather than reading the target frame slot directly);
- `zeroSized`: the window is empty (`wide.2 * n = 0`: `len = 0`, or a ZST
  stride `n = 0`), which Rust permits for dangling well-aligned data pointers
  and which needs no live allocation.
-/
inductive UnsizedSliceDstBacking (n : Nat) (mem : Memory) (wide : WidePtrVal) (bytes : ByteMem) :
    Prop where
  | global (hImg : LiveSliceImage mem wide bytes)
  | borrow (entry : BorrowEntry) (hLookup : lookupBorrow mem.borrows wide.1.tag = some entry)
      (hCov : BorrowRangeCovers entry wide.1.offsetBytes (wide.2 * n))
      (hPerm : TreeBorrowPerm.PermitsRead entry.perm)
  | zeroSized (hZero : wide.2 * n = 0)

namespace UnsizedSliceDstBacking

variable {n : Nat}

/-- The memory half of a shared `ActiveTypedSliceBorrow` lens at `tag = wide.1.tag`. -/
theorem of_activeTypedSliceBorrow {α : Type} {c : ByteLensCodec α n} {mem : Memory} {tag : Nat}
    {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : ActiveTypedSliceBorrow c mem.borrows tag wide xs bytes)
    (hTag : tag = wide.1.tag := by rfl) :
    UnsizedSliceDstBacking n mem wide bytes := by
  obtain ⟨_, entry, he, hc, hp⟩ := h
  rw [hTag] at he
  exact .borrow entry he hc hp

/-- The memory half of a mutable `ActiveTypedSliceMutBorrow` lens at `tag = wide.1.tag`. -/
theorem of_activeTypedSliceMutBorrow {α : Type} {c : ByteLensCodec α n} {mem : Memory}
    {tag : Nat} {wide : WidePtrVal} {xs : List α} {bytes : ByteMem}
    (h : ActiveTypedSliceMutBorrow c mem.borrows tag wide xs bytes)
    (hTag : tag = wide.1.tag := by rfl) :
    UnsizedSliceDstBacking n mem wide bytes :=
  of_activeTypedSliceBorrow h.toShared hTag

/-- **Frame rule**: the backing transfers to any `mem'` with the same `globals` that preserves
any live `lookupBorrow` entry at `wide.1.tag`. -/
theorem of_frame {mem mem' : Memory} {wide : WidePtrVal} {bytes : ByteMem}
    (h : UnsizedSliceDstBacking n mem wide bytes) (hGlobals : mem'.globals = mem.globals)
    (hLookup : ∀ e, lookupBorrow mem.borrows wide.1.tag = some e →
      lookupBorrow mem'.borrows wide.1.tag = some e) :
    UnsizedSliceDstBacking n mem' wide bytes := by
  cases h with
  | global hImg =>
    obtain ⟨alloc, hA, hB⟩ := hImg
    exact .global ⟨alloc, by rw [hGlobals]; exact hA, hB⟩
  | borrow entry he hc hp => exact .borrow entry (hLookup entry he) hc hp
  | zeroSized hZero => exact .zeroSized hZero

/-- Prefix subslices (`k ≤ wide.2`) inherit the backing. -/
theorem takeElems {mem : Memory} {wide : WidePtrVal} {bytes : ByteMem}
    (h : UnsizedSliceDstBacking n mem wide bytes) {k : Nat} (hk : k ≤ wide.2) :
    UnsizedSliceDstBacking n mem (WidePtrVal.takeElems wide k) bytes := by
  have hkn : k * n ≤ wide.2 * n := Nat.mul_le_mul_right n hk
  cases h with
  | global hImg => exact .global hImg
  | borrow entry he hc hp =>
    exact .borrow entry he ⟨hc.1, Nat.le_trans (Nat.add_le_add_left hkn _) hc.2⟩ hp
  | zeroSized hZero =>
    rw [hZero] at hkn
    exact .zeroSized (Nat.le_zero.mp hkn)

/-- Suffix subslices (`k ≤ wide.2`) inherit the backing. -/
theorem dropElems {mem : Memory} {wide : WidePtrVal} {bytes : ByteMem}
    (h : UnsizedSliceDstBacking n mem wide bytes) {k : Nat} (hk : k ≤ wide.2) :
    UnsizedSliceDstBacking n mem (WidePtrVal.dropElems wide n k) bytes := by
  cases h with
  | global hImg => exact .global hImg
  | borrow entry he hc hp =>
    have hsum : k * n + (wide.2 - k) * n = wide.2 * n := by
      rw [← Nat.add_mul, Nat.add_sub_of_le hk]
    refine .borrow entry he ⟨Nat.le_trans hc.1 (Nat.le_add_right _ _), ?_⟩ hp
    show wide.1.offsetBytes + k * n + (wide.2 - k) * n ≤ entry.rangeOffset + entry.rangeLen
    rw [Nat.add_assoc, hsum]
    exact hc.2
  | zeroSized hZero =>
    have hle : (wide.2 - k) * n ≤ wide.2 * n := Nat.mul_le_mul_right n (Nat.sub_le wide.2 k)
    rw [hZero] at hle
    exact .zeroSized (Nat.le_zero.mp hle)

/-- **Non-trivial split reassembly**: for any interior split `0 < k`, `k < wide.2`, and `0 < n`,
the backings of `takeElems wide k` and `dropElems wide n k` reassemble directly into
`UnsizedSliceDstBacking n mem wide bytes` without requiring an extra whole-window hypothesis. -/
theorem of_splitAt_pos {mem : Memory} {wide : WidePtrVal} {bytes : ByteMem} {k : Nat}
    (hk0 : 0 < k) (hkw : k < wide.2) (hn : 0 < n)
    (hL : UnsizedSliceDstBacking n mem (WidePtrVal.takeElems wide k) bytes)
    (hR : UnsizedSliceDstBacking n mem (WidePtrVal.dropElems wide n k) bytes) :
    UnsizedSliceDstBacking n mem wide bytes := by
  have hkPos : 0 < k * n := Nat.mul_pos hk0 hn
  have hSubPos : 0 < (wide.2 - k) * n := Nat.mul_pos (Nat.sub_pos_of_lt hkw) hn
  cases hL with
  | global hImgL => exact .global hImgL
  | zeroSized hZ =>
    rw [hZ] at hkPos
    exact False.elim (Nat.lt_irrefl 0 hkPos)
  | borrow entryL heL hcL hpL =>
    cases hR with
    | global hImgR => exact .global hImgR
    | zeroSized hZ =>
      rw [hZ] at hSubPos
      exact False.elim (Nat.lt_irrefl 0 hSubPos)
    | borrow entryR heR hcR _ =>
      have heR' : lookupBorrow mem.borrows wide.1.tag = some entryR := heR
      rw [heL] at heR'
      injection heR' with hEq
      subst hEq
      have hsum : k * n + (wide.2 - k) * n = wide.2 * n := by
        rw [← Nat.add_mul, Nat.add_sub_of_le (Nat.le_of_lt hkw)]
      have hUpper : wide.1.offsetBytes + wide.2 * n ≤ entryL.rangeOffset + entryL.rangeLen := by
        rw [← hsum, ← Nat.add_assoc]
        exact hcR.2
      exact .borrow entryL heL ⟨hcL.1, hUpper⟩ hpL

end UnsizedSliceDstBacking

/--
**`UnsizedSliceDstAt`**: relational lens over `Memory` (`mem`), runtime
wide-pointer `Value` (`fatVal`), unsized DST `RigidTy` (`dstTy`: `.slice elemTy`
or `.str`), `ByteLensCodec α n`, and logical element list `elems : List α`.
Connects the wide-pointer representation, `PtrMetadataOf`, the typed byte view
`SliceTypedAt c wide elems bytes`, and `UnsizedSliceDstBacking n mem wide bytes`
(`.global` pins live `bytes` in `mem.globals` via `LiveSliceImage`; `.borrow`
mirrors `ActiveTypedSliceBorrow` / `ActiveTypedSliceMutBorrow` by grounding
active borrow tag `wide.1.tag`, read permission, and `BorrowRangeCovers` byte
extent in `mem.borrows` while `bytes` carries the caller's `SliceTypedAt`
logical witness; `.zeroSized` covers empty `wide.2 * n = 0` windows).
-/
structure UnsizedSliceDstAt {α : Type} {n : Nat} (c : ByteLensCodec α n)
    (ptrBytes : Nat) (dstTy : RigidTy) (mem : Memory) (wide : WidePtrVal)
    (fatVal : Value) (elems : List α) (bytes : ByteMem) : Prop where
  dst_ty : IsUnsizedSliceDstTy dstTy n
  fat_eq : fatVal = WidePtrVal.toValue ptrBytes wide
  meta_of : PtrMetadataOf ptrBytes fatVal (.scalar ⟨wide.2, ptrBytes⟩)
  slice_typed : SliceTypedAt c wide elems bytes
  backing : UnsizedSliceDstBacking n mem wide bytes

/-- Canonical `str` specialization of `UnsizedSliceDstAt` over `ByteLensCodec.u8`. -/
@[reducible]
def UnsizedStrDstAt (ptrBytes : Nat) (mem : Memory) (wide : WidePtrVal)
    (fatVal : Value) (utf8Bytes : List UInt8) (bytes : ByteMem) : Prop :=
  UnsizedSliceDstAt ByteLensCodec.u8 ptrBytes .str mem wide fatVal utf8Bytes bytes

namespace UnsizedSliceDstAt

variable {α : Type} {n : Nat} {c : ByteLensCodec α n}

/-- Construct `UnsizedSliceDstAt` for `.slice elemTy` from `SliceTypedAt` over the live image of
`wide.1`'s captured global allocation in `mem`. -/
theorem of_sliceTypedAt (ptrBytes : Nat) (elemTy : RigidTy) (mem : Memory)
    {wide : WidePtrVal} {elems : List α} {bytes : ByteMem}
    (h : SliceTypedAt c wide elems bytes) (hImg : LiveSliceImage mem wide bytes) :
    UnsizedSliceDstAt c ptrBytes (.slice elemTy) mem wide
      (WidePtrVal.toValue ptrBytes wide) elems bytes :=
  ⟨IsUnsizedSliceDstTy.slice elemTy n, rfl, .wide wide, h, .global hImg⟩

/-- Construct `UnsizedStrDstAt` for `.str` from `SliceTypedAt ByteLensCodec.u8` over the live
image of `wide.1`'s captured global allocation in `mem`. -/
theorem of_str_sliceTypedAt (ptrBytes : Nat) (mem : Memory)
    {wide : WidePtrVal} {utf8Bytes : List UInt8} {bytes : ByteMem}
    (h : SliceTypedAt ByteLensCodec.u8 wide utf8Bytes bytes)
    (hImg : LiveSliceImage mem wide bytes) :
    UnsizedStrDstAt ptrBytes mem wide (WidePtrVal.toValue ptrBytes wide) utf8Bytes bytes :=
  ⟨IsUnsizedSliceDstTy.str, rfl, .wide wide, h, .global hImg⟩

/-- Construct `UnsizedSliceDstAt` from a shared `ActiveTypedSliceBorrow` lens at `tag = wide.1.tag`
in `mem.borrows`. -/
theorem of_borrow (ptrBytes : Nat) {dstTy : RigidTy} {mem : Memory} {tag : Nat}
    {wide : WidePtrVal} {elems : List α} {bytes : ByteMem}
    (hTy : IsUnsizedSliceDstTy dstTy n)
    (hBorrow : ActiveTypedSliceBorrow c mem.borrows tag wide elems bytes)
    (hTag : tag = wide.1.tag := by rfl) :
    UnsizedSliceDstAt c ptrBytes dstTy mem wide
      (WidePtrVal.toValue ptrBytes wide) elems bytes :=
  ⟨hTy, rfl, .wide wide, hBorrow.1, .of_activeTypedSliceBorrow hBorrow hTag⟩

/-- Construct `UnsizedSliceDstAt` from a mutable `ActiveTypedSliceMutBorrow` lens at
`tag = wide.1.tag` in `mem.borrows`. -/
theorem of_mutBorrow (ptrBytes : Nat) {dstTy : RigidTy} {mem : Memory} {tag : Nat}
    {wide : WidePtrVal} {elems : List α} {bytes : ByteMem}
    (hTy : IsUnsizedSliceDstTy dstTy n)
    (hMut : ActiveTypedSliceMutBorrow c mem.borrows tag wide elems bytes)
    (hTag : tag = wide.1.tag := by rfl) :
    UnsizedSliceDstAt c ptrBytes dstTy mem wide
      (WidePtrVal.toValue ptrBytes wide) elems bytes :=
  ⟨hTy, rfl, .wide wide, hMut.1, .of_activeTypedSliceMutBorrow hMut hTag⟩

theorem length_eq {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes) :
    elems.length = wide.2 :=
  h.slice_typed.length_eq

/-- The runtime fat pointer of an `UnsizedSliceDstAt` view decomposes into its data pointer
`WidePtrVal.dataVal ptrBytes wide = .ptr wide.1 ptrBytes` and the logical element count
`.scalar ⟨elems.length, ptrBytes⟩`. -/
theorem ptr_eq {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes) :
    fatVal = .aggregate 0 [WidePtrVal.dataVal ptrBytes wide, .scalar ⟨elems.length, ptrBytes⟩] := by
  rw [h.fat_eq, h.length_eq]

theorem meta_eq {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes) :
    WidePtrVal.metaVal ptrBytes wide = .scalar ⟨elems.length, ptrBytes⟩ := by
  unfold WidePtrVal.metaVal
  rw [h.length_eq]

theorem meta_of_length {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes) :
    PtrMetadataOf ptrBytes fatVal (.scalar ⟨elems.length, ptrBytes⟩) := by
  rw [h.length_eq]
  exact h.meta_of

theorem unique {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems₁ elems₂ : List α} {bytes : ByteMem}
    (h₁ : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems₁ bytes)
    (h₂ : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems₂ bytes) :
    elems₁ = elems₂ :=
  SliceTypedAt.unique h₁.slice_typed h₂.slice_typed

/-- **Backing cases**: an `UnsizedSliceDstAt` view either pins `bytes` to a
captured global allocation in `mem.globals` (`LiveSliceImage`), or pairs its
`SliceTypedAt` witness with a live shared borrow entry (`ActiveTypedSliceBorrow`:
active tag `wide.1.tag`, read permission, and `BorrowRangeCovers` extent in
`mem.borrows`), or has an empty (`wide.2 * n = 0`) byte window. -/
theorem image_or_activeBorrow_or_zeroSized {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes) :
    LiveSliceImage mem wide bytes ∨
      ActiveTypedSliceBorrow c mem.borrows wide.1.tag wide elems bytes ∨
      wide.2 * n = 0 := by
  obtain ⟨_, _, _, hs, hb⟩ := h
  cases hb with
  | global hImg => exact Or.inl hImg
  | borrow entry he hc hp => exact Or.inr (Or.inl ⟨hs, entry, he, hc, hp⟩)
  | zeroSized hZero => exact Or.inr (Or.inr hZero)

/-- **Frame rule**: `UnsizedSliceDstAt` transfers to any `mem'` with the same `globals` that
preserves any live `lookupBorrow` entry at `wide.1.tag`. -/
theorem of_frame {ptrBytes : Nat} {dstTy : RigidTy} {mem mem' : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    (hGlobals : mem'.globals = mem.globals)
    (hLookup : ∀ e, lookupBorrow mem.borrows wide.1.tag = some e →
      lookupBorrow mem'.borrows wide.1.tag = some e) :
    UnsizedSliceDstAt c ptrBytes dstTy mem' wide fatVal elems bytes :=
  ⟨h.dst_ty, h.fat_eq, h.meta_of, h.slice_typed, h.backing.of_frame hGlobals hLookup⟩

/-- `UnsizedSliceDstAt` is preserved by a statement-level write of an unprojected local `dstLoc`
(`invalidateConflictingBorrows`) when no live borrow at `wide.1.tag` targets `dstLoc`. -/
theorem of_invalidateConflictingBorrows {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem} {dstLoc : Local}
    (writerTag : Option Nat) (targetFrameDepth : Nat)
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    (hNe : ∀ e, lookupBorrow mem.borrows wide.1.tag = some e → e.targetLocal ≠ dstLoc) :
    UnsizedSliceDstAt c ptrBytes dstTy
      { mem with
        borrows := invalidateConflictingBorrows mem.borrows dstLoc writerTag targetFrameDepth }
      wide fatVal elems bytes :=
  h.of_frame rfl (fun e he =>
    lookupBorrow_invalidateConflictingBorrows_of_ne writerTag targetFrameDepth he (hNe e he))

/-- `UnsizedSliceDstAt` is preserved by an intrinsic return write to
`{ local_ := dstLoc, projection := [] }` (`invalidateDirectDestWriteBorrows`) when no live borrow
at `wide.1.tag` targets `dstLoc`. -/
theorem of_invalidateDirectDestWriteBorrows {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem} {dstLoc : Local}
    (locals : List LocalSlot)
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    (hNe : ∀ e, lookupBorrow mem.borrows wide.1.tag = some e → e.targetLocal ≠ dstLoc) :
    UnsizedSliceDstAt c ptrBytes dstTy
      (invalidateDirectDestWriteBorrows mem locals { local_ := dstLoc, projection := [] })
      wide fatVal elems bytes :=
  h.of_frame (invalidateDirectDestWriteBorrows_globals mem locals _) (fun e he =>
    lookupBorrow_invalidateDirectDestWriteBorrows_of_ne mem locals he (hNe e he))

/-- Prefix subslice `WidePtrVal.takeElems wide k` (`k ≤ wide.2`) preserves `UnsizedSliceDstAt`. -/
theorem takeElems {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    {k : Nat} (hk : k ≤ wide.2) :
    UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.takeElems wide k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.takeElems wide k)) (elems.take k) bytes :=
  ⟨h.dst_ty, rfl, .wide (WidePtrVal.takeElems wide k), (SliceTypedAt.splitAt h.slice_typed hk).1,
    h.backing.takeElems hk⟩

/-- Suffix subslice `WidePtrVal.dropElems wide n k` (`k ≤ wide.2`) preserves `UnsizedSliceDstAt`. -/
theorem dropElems {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    {k : Nat} (hk : k ≤ wide.2) :
    UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.dropElems wide n k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.dropElems wide n k)) (elems.drop k) bytes :=
  ⟨h.dst_ty, rfl, .wide (WidePtrVal.dropElems wide n k),
    (SliceTypedAt.splitAt h.slice_typed hk).2.1, h.backing.dropElems hk⟩

/-- Splitting `UnsizedSliceDstAt` at `k ≤ wide.2` produces `takeElems` and `dropElems` views with
disjoint byte windows. -/
theorem splitAt {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {fatVal : Value} {elems : List α} {bytes : ByteMem}
    (h : UnsizedSliceDstAt c ptrBytes dstTy mem wide fatVal elems bytes)
    {k : Nat} (hk : k ≤ wide.2) :
    UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.takeElems wide k)
        (WidePtrVal.toValue ptrBytes (WidePtrVal.takeElems wide k)) (elems.take k) bytes ∧
      UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.dropElems wide n k)
        (WidePtrVal.toValue ptrBytes (WidePtrVal.dropElems wide n k)) (elems.drop k) bytes ∧
      DisjointSlice wide.1.offsetBytes (k * n) (wide.1.offsetBytes + k * n) ((wide.2 - k) * n) :=
  ⟨h.takeElems hk, h.dropElems hk, (SliceTypedAt.splitAt h.slice_typed hk).2.2⟩

/-- Reassembling prefix and suffix `UnsizedSliceDstAt` views at `k ≤ wide.2` over a backing
`hBack` of the whole window (including boundary splits `k = 0` or `k = wide.2`). -/
theorem of_splitAt {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {k : Nat} {elemsL elemsR : List α} {bytes : ByteMem}
    (hk : k ≤ wide.2)
    (hL : UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.takeElems wide k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.takeElems wide k)) elemsL bytes)
    (hR : UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.dropElems wide n k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.dropElems wide n k)) elemsR bytes)
    (hBack : UnsizedSliceDstBacking n mem wide bytes) :
    UnsizedSliceDstAt c ptrBytes dstTy mem wide
      (WidePtrVal.toValue ptrBytes wide) (elemsL ++ elemsR) bytes :=
  ⟨hL.dst_ty, rfl, .wide wide, SliceTypedAt.of_splitAt hk hL.slice_typed hR.slice_typed, hBack⟩

/-- Reassembling prefix and suffix `UnsizedSliceDstAt` views at any interior split `0 < k`,
`k < wide.2`, and `0 < n` without requiring an external whole-window backing hypothesis. -/
theorem of_splitAt_pos {ptrBytes : Nat} {dstTy : RigidTy} {mem : Memory}
    {wide : WidePtrVal} {k : Nat} {elemsL elemsR : List α} {bytes : ByteMem}
    (hk0 : 0 < k) (hkw : k < wide.2) (hn : 0 < n)
    (hL : UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.takeElems wide k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.takeElems wide k)) elemsL bytes)
    (hR : UnsizedSliceDstAt c ptrBytes dstTy mem (WidePtrVal.dropElems wide n k)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.dropElems wide n k)) elemsR bytes) :
    UnsizedSliceDstAt c ptrBytes dstTy mem wide
      (WidePtrVal.toValue ptrBytes wide) (elemsL ++ elemsR) bytes :=
  of_splitAt (Nat.le_of_lt hkw) hL hR
    (UnsizedSliceDstBacking.of_splitAt_pos hk0 hkw hn hL.backing hR.backing)

/-- Empty slice instance (`len = 0`) of `UnsizedSliceDstAt`: an empty window needs no live
backing (dangling well-aligned data pointers are permitted). -/
theorem empty_slice (c : ByteLensCodec α n) (ptrBytes : Nat) (elemTy : RigidTy)
    (mem : Memory) (p : ProvenancePtr) (bytes : ByteMem) (hOff : p.offsetBytes ≤ bytes.length) :
    UnsizedSliceDstAt c ptrBytes (.slice elemTy) mem (WidePtrVal.mk p 0)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.mk p 0)) [] bytes :=
  ⟨IsUnsizedSliceDstTy.slice elemTy n, rfl, .wide _, sliceTypedAt_empty c p bytes hOff,
    .zeroSized (Nat.zero_mul n)⟩

/-- Empty `str` instance (`len = 0`) of `UnsizedStrDstAt`. -/
theorem empty_str (ptrBytes : Nat) (mem : Memory) (p : ProvenancePtr) (bytes : ByteMem)
    (hOff : p.offsetBytes ≤ bytes.length) :
    UnsizedStrDstAt ptrBytes mem (WidePtrVal.mk p 0)
      (WidePtrVal.toValue ptrBytes (WidePtrVal.mk p 0)) [] bytes :=
  ⟨IsUnsizedSliceDstTy.str, rfl, .wide _, sliceTypedAt_empty ByteLensCodec.u8 p bytes hOff,
    .zeroSized (Nat.zero_mul 1)⟩

/-- Zero-sized element (`n = 0`) instance of `UnsizedSliceDstAt` for arbitrary `len : Nat`
(`len * 0 = 0` bytes, so no live backing is needed). -/
theorem zst_unit_replicate (ptrBytes : Nat) (elemTy : RigidTy) (mem : Memory)
    (p : ProvenancePtr) (len : Nat) (bytes : ByteMem) (hOff : p.offsetBytes ≤ bytes.length) :
    UnsizedSliceDstAt ByteLensCodec.unit ptrBytes (.slice elemTy) mem (WidePtrVal.mk p len)
