    | field outerIdx outerTy =>
      rw [hSub] at hRest
      rcases hRest with ⟨hField, _, ⟨entry, hLookB, hT, hP, hPerm, hRO, hRL⟩,
        _, hExcl⟩
      rcases eq_aggregate_of_readFieldAt_some hField with ⟨elems, hCaller, hEl⟩
