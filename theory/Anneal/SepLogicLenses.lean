          rw [hLookB]
          dsimp only
          rw [hT]
          exact ⟨hasTreeReadUB_eq_false_of_tree m.borrows m.borrows m.activeProtectors _ _ _ hExcl,
            freezeTreeBorrowsOnReadAtProj_eq_self_of_tree m.borrows m.borrows _ _ _ hExcl m.activeProtectors⟩
