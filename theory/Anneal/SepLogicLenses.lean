    rename_i ptrLoc rp
    have hVal := hInv.entries_valid rp v (lookupLensVal?_mem hLookVal)
    unfold BorrowSubplace.entryValid at hVal
    rcases hVal with ⟨hOff, hAbove, hRest⟩
    cases hSub : subplaceOf rp with
    | root =>
      rw [hSub] at hRest
