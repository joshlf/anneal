    intro b hb
    simp only [swapU32DemoMem, List.mem_cons, List.not_mem_nil,
      or_false] at hb
    rcases hb with rfl | rfl <;> decide
  refine ⟨rfl, ⟨rfl, rfl, hAbove, by decide,
