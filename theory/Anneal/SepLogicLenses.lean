        sepConj
          (ActiveTypedFieldMutBorrow demoField1Ptr 1
            (ValueCodec.scalarNat 4) b_old)
          (sepConj (BorrowToken swapPairParentPtr .active)
            (ActiveTypedFieldMutBorrow demoField2Ptr 2
              (ValueCodec.scalarNat 4) c_old))
