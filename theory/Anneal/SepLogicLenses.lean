      refine ⟨⟨m, fieldMutBorrowFootprint demoField1Ptr 1⟩,
        ⟨m, fpR⟩,
        ⟨rfl, rfl,
          by unfold DisjointFootprints fieldMutBorrowFootprint demoField1Ptr
             dsimp only [fpR]; decide,
