    (hCur : s.memory.activeCallee.getD body = cur)
    (hPhase : cur.phase = .runtimePostCleanup ∨ cur.phase = .runtimeOptimized)
    (hBb : get? cur.basicBlocks s.frame.blockIdx = some blk)
