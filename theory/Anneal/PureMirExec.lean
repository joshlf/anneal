      have h_mem :=
        stepMirFn_toMachineState_eq_withMem (mem₀ := mem₀)
          (PureState.ofMachineState s) h_pure h_root
      dsimp only [PureState.toMachineState_ofMachineState] at h_emp h_mem
      rw [h_emp] at h_wp
