def mirStepNodeObsCont : MirStepNode → PUnit → Option MirExecState
  | .vis (.inr (.inl _)) k, u => some (k u)
  | _, _ => none

/--
Executable fuel-bounded pure MIR state evaluator supporting multi-frame inline
calls (`TerminatorKind.call` and `TerminatorKind.tailCall`), `switchInt`
observations, and root-frame `return_` validation.
-/
def evalPureMirStateWithCallees
    (fuel : Nat)
    (body : CapturedMir)
    (s : MachineState) : Option (Value × Memory) :=
  match fuel with
  | 0 => none
  | fuel' + 1 =>
    match stepMirFn body s with
    | .ret (.normal (retVal, memOut)) =>
      if memOut.callStack.isEmpty && memOut.activeProtectors.isEmpty then
        some (retVal, memOut)
      else
        none
    | .tau (.running s') => evalPureMirStateWithCallees fuel' body s'
    | .vis (.inr (.inl _)) k =>
      match k PUnit.unit with
      | .running s' => evalPureMirStateWithCallees fuel' body s'
      | _ => none
    | _ => none

/--
Public computable evaluator for pure MIR functions with inline linked `callees`
and `traitImpls` (`FF-2.2` Section 3): runs `stepMirFn` across `pushCalleeFrame`,
`enterTailCalleeFrame`, `switchInt`, and callee `return_` transitions without
constructing `Prop` proof terms at each step.
-/
def evalPureMirWithCallees
    (fuel : Nat)
    (body : CapturedMir)
    (callees : List CapturedMir)
    (args : List Value)
    (traitImpls : List TraitImplEntry := body.traitImpls) : Option Value :=
  (evalPureMirStateWithCallees fuel body
    ((initPureState body args).toMachineState
      (pureCalleeMemory callees traitImpls))).map Prod.fst

/--
Executable boolean contract checker (`checkPureMirBoolPredWithCallees`) for
`MirBoolPredicateHoldsWithCallees` on concrete argument vectors.
-/
def checkPureMirBoolPredWithCallees
    (fuel : Nat)
    (specBody : CapturedMir)
    (callees : List CapturedMir)
    (args : List Value) : Bool :=
  match evalPureMirWithCallees fuel specBody callees args specBody.traitImpls with
  | some (.scalar sc) => sc.sizeBytes == 1 && sc.bits == 1
  | _ => false

private theorem writeIntrinsicReturn_ne_ret_normal
    (s : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (retVal : Value)
    (v : Value) (mOut : Memory) :
    writeIntrinsicReturn s locals' destination targetBb retVal ≠ .ret (.normal (v, mOut)) := by
  unfold writeIntrinsicReturn
  repeat' (first | rintro ⟨⟩ | split)

private theorem writeIntrinsicScalarResult_ne_ret_normal
    (s : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (res : Option ScalarInt)
    (v : Value) (mOut : Memory) :
    writeIntrinsicScalarResult s locals' destination targetBb res ≠ .ret (.normal (v, mOut)) := by
  cases res with
  | none => rintro ⟨⟩
  | some sc => exact writeIntrinsicReturn_ne_ret_normal s locals' destination targetBb (.scalar sc) v mOut

private theorem evalNonSelectIntrinsicCall_ne_ret_normal
    (kind : RustIntrinsicKind) (s : MachineState)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    (v : Value) (mOut : Memory) :
    evalNonSelectIntrinsicCall kind s target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb ≠ .ret (.normal (v, mOut)) := by
  rcases evalNonSelectIntrinsicCall_cases kind target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb with ⟨retVal, h_wr⟩ | ⟨fk, h_fl⟩ | h_un
  · rw [h_wr s]; exact writeIntrinsicReturn_ne_ret_normal s locals' destination targetBb retVal v mOut
  · rw [h_fl s]; rintro ⟨⟩
  · rw [h_un s]; rintro ⟨⟩

private theorem finishMemIntrinsicCall_ne_ret_normal
    (s : MachineState) (node : MirStepNode)
    (destination : Place) (targetBb : BasicBlockIdx) (h_node : IsStmtNode node)
    (v : Value) (mOut : Memory) :
    finishMemIntrinsicCall s node destination targetBb ≠ .ret (.normal (v, mOut)) := by
  rcases h_node with ⟨s', rfl⟩ | ⟨fk, rfl⟩ | rfl
  · rw [finishMemIntrinsicCall_step]
    exact writeIntrinsicReturn_ne_ret_normal _ _ _ _ _ v mOut
  · rintro ⟨⟩
  · rintro ⟨⟩

private theorem evalCopyNonOverlappingCall_ne_ret_normal
    (s : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    (v : Value) (mOut : Memory) :
    evalCopyNonOverlappingCall s bodyLocalDecls bodyLayouts argOps argVals locals'
      destination targetBb ≠ .ret (.normal (v, mOut)) := by
  unfold evalCopyNonOverlappingCall
  rcases argOps with _ | ⟨srcOp, _ | ⟨dstOp, _ | ⟨_cntOp, _ | _⟩⟩⟩ <;>
    rcases argVals with
      _ | ⟨srcVal, _ | ⟨dstVal, _ | ⟨_ | countSc | _ | _ | _, _ | _⟩⟩⟩ <;>
    try rintro ⟨⟩
  · dsimp only
    cases Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts) with
    | false => rintro ⟨⟩
    | true =>
      exact finishMemIntrinsicCall_ne_ret_normal _ _ _ _
        (evalCopyNonOverlappingWithCount_isStmtNode _ _ _ _ _ _ _ _ _) v mOut

private theorem evalWriteBytesCall_ne_ret_normal
    (s : MachineState) (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand) (argVals : List Value)
    (locals' : List LocalSlot) (destination : Place) (targetBb : BasicBlockIdx)
    (v : Value) (mOut : Memory) :
    evalWriteBytesCall s target bodyLocalDecls bodyLayouts argOps argVals locals'
      destination targetBb ≠ .ret (.normal (v, mOut)) := by
  unfold evalWriteBytesCall
  cases writeBytesAction s.memory.borrows (length s.memory.callStack) target bodyLocalDecls
      bodyLayouts argOps argVals with
  | fault _ => rintro ⟨⟩
  | noWrite => exact writeIntrinsicReturn_ne_ret_normal _ _ _ _ _ v mOut
  | store _ _ _ _ =>
    exact finishMemIntrinsicCall_ne_ret_normal _ _ _ _
      (commitWriteBytesDstPlaceWrite_isStmtNode _ _ _ _ _ _ _) v mOut

private theorem isStmtNode_ne_ret_normal {n : MirStepNode} (h : IsStmtNode n)
    (v : Value) (mOut : Memory) : n ≠ .ret (.normal (v, mOut)) := by
  rcases h with ⟨_, rfl⟩ | ⟨_, rfl⟩ | rfl <;> rintro ⟨⟩

private theorem evalDirectRustIntrinsic?_ne_ret_normal
    (s : MachineState) (currentBody : Option CapturedMir)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (unwind : UnwindAction)
    (stepNode : MirStepNode)
    (h_di :
      evalDirectRustIntrinsic? s currentBody target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb unwind = some stepNode)
    (v : Value) (mOut : Memory) :
    stepNode ≠ .ret (.normal (v, mOut)) := by
  cases h_cl : classifyRustIntrinsic? target.defPath with
  | none =>
    unfold evalDirectRustIntrinsic? at h_di
    rw [h_cl] at h_di
    cases h_di
  | some rk =>
    by_cases h_cs : rk = .constEvalSelect
    · subst h_cs
      rcases argVals with _ | ⟨tupleArgVal, _ | ⟨ctFnVal, _ | ⟨rtFnVal, _ | _⟩⟩⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; rintro ⟨⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; rintro ⟨⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; rintro ⟨⟩
      · rw [evalDirectRustIntrinsic?_constEvalSelect_three _ _ _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        unfold evalConstEvalSelectThree
        dsimp only
        cases unpackConstEvalSelectArgs? tupleArgVal (selectTupleTyOpt target.typeArgs) with
        | none => rintro ⟨⟩
        | some unpackedArgs =>
          dsimp only
          cases resolveConstEvalSelectTarget? s target bodyLocalDecls bodyLayouts
              (selectRtFnOpOpt argOps) rtFnVal (length unpackedArgs) with
          | none => rintro ⟨⟩
          | some rtTarget =>
            dsimp only
            cases lookupCallee s.memory.callees bodyLayouts rtTarget.defPath
                rtTarget.typeArgs s.memory.traitImpls with
            | some calleeBody =>
              dsimp only
              cases constEvalSelectCalleeCompatible rtTarget calleeBody (length unpackedArgs) with
              | false => rintro ⟨⟩
              | true => dsimp only; cases currentBody <;> rintro ⟨⟩
            | none =>
              dsimp only
              cases rtTarget.isIndirect with
              | true =>
                cases isGenericClosureArityMismatch s.memory.callees rtTarget.defPath rtTarget.typeArgs <;>
                  rintro ⟨⟩
              | false =>
                dsimp only
                cases isDirectExactDivTarget rtTarget with
                | true =>
                  dsimp only
                  rcases unpackedArgs with _ | ⟨_ | lhs | _ | _ | _, _ | ⟨_ | rhs | _ | _ | _, _ | _⟩⟩ <;>
                    try rintro ⟨⟩
                  dsimp only
                  cases resolveIntrinsicIsSigned
                      (withConstEvalSelectIntrinsicTypeArgs rtTarget
                        (selectTupleTyOpt target.typeArgs) false)
                      bodyLocalDecls bodyLayouts
                      (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs)) with
                  | none => rintro ⟨⟩
                  | some isSigned =>
                    exact writeIntrinsicScalarResult_ne_ret_normal s locals'
                      destination targetBb (evalExactDiv lhs rhs isSigned) v mOut
                | false =>
                  dsimp only
                  cases classifyRustIntrinsic? rtTarget.defPath with
                  | some rtKind =>
                    have h_step : ∀ (k : RustIntrinsicKind),
                        (match evalCoreMemPtrIntrinsicCall? k s
                            (withConstEvalSelectIntrinsicTypeArgs rtTarget
                              (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                            bodyLocalDecls bodyLayouts
                            (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                            unpackedArgs locals' destination (.some targetBb) with
                         | some sn => sn
                         | none => evalNonSelectIntrinsicCall k s
                            (withConstEvalSelectIntrinsicTypeArgs rtTarget
                              (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                            bodyLocalDecls bodyLayouts
                            (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                            unpackedArgs locals' destination targetBb) ≠ .ret (.normal (v, mOut)) := by
                      intro k
                      cases h_cm : evalCoreMemPtrIntrinsicCall? k s _ bodyLocalDecls bodyLayouts
                          _ unpackedArgs locals' destination (.some targetBb) with
                      | some sn =>
                        exact isStmtNode_ne_ret_normal
                          (evalCoreMemPtrIntrinsicCall?_isStmtNode k s _ bodyLocalDecls bodyLayouts
                            _ unpackedArgs locals' destination (.some targetBb) h_cm) v mOut
                      | none =>
                        exact evalNonSelectIntrinsicCall_ne_ret_normal k s _ bodyLocalDecls bodyLayouts
                          _ unpackedArgs locals' destination targetBb v mOut
                    cases h_cs2 : (match rtKind with | .constEvalSelect => true | _ => false) with
                    | true =>
                      have : rtKind = .constEvalSelect := by cases rtKind <;> first | rfl | cases h_cs2
                      subst this; rintro ⟨⟩
                    | false =>
                      have h_eq :
                          (match some rtKind with
                           | some .constEvalSelect => MirStepNode.fail .ub
                           | some k =>
                             match evalCoreMemPtrIntrinsicCall? k s
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 bodyLocalDecls bodyLayouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination (.some targetBb) with
                             | some sn => sn
                             | none => evalNonSelectIntrinsicCall k s
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 bodyLocalDecls bodyLayouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination targetBb
                           | none =>
                             match isUnreachableCallTarget rtTarget.defPath with
                             | true => MirStepNode.fail .ub
                             | false =>
                               match isAbortingPanicDefPath rtTarget.defPath with
                               | true => MirStepNode.retOutcome .abort
                               | false =>
                                 match isUnwindingPanicDefPath rtTarget.defPath with
                                 | true =>
                                   match applyUnwindAction s locals' s.memory unwind with
                                   | .running nextState => MirStepNode.step nextState
                                   | .halted out => MirStepNode.retOutcome out
                                   | .faulted fk => MirStepNode.fail fk
                                 | false =>
                                   MirStepNode.extCall
                                     { defPath := rtTarget.defPath, typeArgs := rtTarget.typeArgs,
                                       args := unpackedArgs, memory := s.memory }
                                     (resumeExternalCall s locals' destination targetBb unwind)) =
                          (match evalCoreMemPtrIntrinsicCall? rtKind s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall rtKind s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) := by
                        cases rtKind <;> first | (cases h_cs2; done) | rfl
                      rw [h_eq]
                      exact h_step rtKind
                  | none =>
                    dsimp only
                    cases isUnreachableCallTarget rtTarget.defPath with
                    | true => rintro ⟨⟩
                    | false =>
                      dsimp only
                      cases isAbortingPanicDefPath rtTarget.defPath with
                      | true => rintro ⟨⟩
                      | false =>
                        dsimp only
                        cases isUnwindingPanicDefPath rtTarget.defPath with
                        | true =>
                          dsimp only
                          cases h_a : applyUnwindAction s locals' s.memory unwind
                          · rintro ⟨⟩
                          · intro h; injection h with ho; subst ho
                            exact applyUnwindAction_ne_normal _ _ _ _ _ h_a
                          · rintro ⟨⟩
                        | false => rintro ⟨⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; rintro ⟨⟩
    · by_cases h_cn : rk = .copyNonOverlapping
      · subst h_cn
        rw [evalDirectRustIntrinsic?_copyNonOverlapping _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        exact evalCopyNonOverlappingCall_ne_ret_normal s bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb v mOut
      by_cases h_wb : rk = .writeBytes
      · subst h_wb
        rw [evalDirectRustIntrinsic?_writeBytes _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        exact evalWriteBytesCall_ne_ret_normal s target bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb v mOut
      cases h_cmk : isCoreMemPtrIntrinsicKind rk with
      | true =>
        rcases evalDirectRustIntrinsic?_coreMemPtr s currentBody target bodyLocalDecls
            bodyLayouts argOps argVals locals' destination targetBb unwind h_cl h_cmk with
          ⟨sn0, h_cm0, h_eq0⟩
        rw [h_eq0] at h_di
        injection h_di with h_sn; subst h_sn
        exact isStmtNode_ne_ret_normal
          (evalCoreMemPtrIntrinsicCall?_isStmtNode rk s target bodyLocalDecls bodyLayouts
            argOps argVals locals' destination (.some targetBb) h_cm0) v mOut
      | false =>
        rw [evalDirectRustIntrinsic?_nonSelect _ _ _ _ _ _ _ _ _ _ _ h_cl h_cs h_cn h_wb h_cmk] at h_di
        injection h_di with h_sn
        subst h_sn
        exact evalNonSelectIntrinsicCall_ne_ret_normal rk s target
          bodyLocalDecls bodyLayouts argOps argVals locals' destination targetBb v mOut

private theorem stepMirFn_ret_normal_activeCallee_ceil
    {body : CapturedMir} {s : MachineState} {v : Value} {mOut : Memory}
    (h : stepMirFn body s = .ret (.normal (v, mOut))) :
    mOut.activeCallee = s.memory.activeCallee ∧
    mOut.rootUnwindCeiling = s.memory.rootUnwindCeiling := by
  revert h
  rw [stepMirFn_eq_ite]
  dsimp only
  split
  · rintro ⟨⟩
  · cases get? (s.memory.activeCallee.getD body).basicBlocks s.frame.blockIdx with
    | none => rintro ⟨⟩
    | some bb =>
      dsimp only
      cases get? bb.statements s.frame.stmtIdx with
      | some stmt =>
        dsimp only
        rcases evalStmt_isStmtNode s stmt (s.memory.activeCallee.getD body).localDecls (s.memory.activeCallee.getD body).layouts with
          ⟨_, hev⟩ | ⟨_, hev⟩ | hev <;> (rw [hev]; rintro ⟨⟩)
      | none =>
        dsimp only
        split
        · rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
          cases tk with
          | goto _ | unreachable | unwindTerminate | inlineAsm => rintro ⟨⟩
          | drop pl tgt unw =>
            rcases evalTerminator_drop_isStmtNode s pl tgt unw tsp (some (s.memory.activeCallee.getD body)) with
              ⟨_, hev⟩ | ⟨_, hev⟩ | hev <;> (rw [hev]; rintro ⟨⟩)
          | switchInt discr _ =>
            dsimp only [evalTerminator]
            repeat' (first | rintro ⟨⟩ | split)
          | unwindResume =>
            dsimp only [evalTerminator]
            cases h_u : unwindFromCallStack s.memory.callStack s.memory
            · rintro ⟨⟩
            · intro h; injection h with ho; subst ho
              exact False.elim (unwindFromCallStack_ne_normal _ _ _ h_u)
            · rintro ⟨⟩
          | assert cond exp _ unw =>
            dsimp only [evalTerminator]
            repeat' (first
              | rintro ⟨⟩
              | (cases h_a : applyUnwindAction _ _ _ _;
                 · rintro ⟨⟩
                 · intro h; injection h with ho; subst ho
                   exact False.elim (applyUnwindAction_ne_normal _ _ _ _ _ h_a)
                 · rintro ⟨⟩)
              | split)
          | tailCall func argOps =>
            dsimp only [evalTerminator, evalTailCallTerminator]
            repeat' (first | rintro ⟨⟩ | split)
          | call func argOps dst tgtOpt unw =>
            rw [evalTerminator_call_eq_unified]
            dsimp only [evalCallTerminatorUnified]
            cases resolveCallTarget s func (length argOps)
                (bodyLocalDeclsOf (some (s.memory.activeCallee.getD body)))
                (s.memory.activeCallee.getD body).layouts with
            | ub | unsupported => rintro ⟨⟩
            | ok target localsAfterFunc =>
              dsimp only
              cases evalOperandsWithBodyCast localsAfterFunc argOps s.memory.borrows s.memory.globals
                  (s.memory.activeCallee.getD body).layouts
                  s.memory.callerLocals
                  (bodyLocalDeclsOf (some (s.memory.activeCallee.getD body)))
                  s.memory.callStack with
              | ub | unsupported => rintro ⟨⟩
              | ok argVals locals' =>
                dsimp only
                cases lookupCallee s.memory.callees
                    (s.memory.activeCallee.getD body).layouts
                    target.defPath target.typeArgs s.memory.traitImpls with
                | some calleeBody =>
                  dsimp only
                  cases tgtOpt <;> (dsimp only; cases checkCalleeTargetCompatible target calleeBody (length argVals) <;> rintro ⟨⟩)
                | none =>
                  dsimp only
                  cases tgtOpt with
                  | some targetBb =>
                    dsimp only
                    cases isDirectExactDivTarget target with
                    | true =>
                      dsimp only
                      rcases argVals with _ | ⟨_ | lhs | _ | _ | _, _ | ⟨_ | rhs | _ | _ | _, _ | _⟩⟩ <;>
                        try rintro ⟨⟩
                      dsimp only
                      cases resolveIntrinsicIsSigned target
                          (bodyLocalDeclsOf (some (s.memory.activeCallee.getD body)))
                          (s.memory.activeCallee.getD body).layouts argOps with
                      | none => rintro ⟨⟩
                      | some isSigned =>
                        dsimp only
                        cases evalExactDiv lhs rhs isSigned with
                        | none => rintro ⟨⟩
                        | some retScalar =>
                          intro h
                          exact False.elim (writeIntrinsicReturn_ne_ret_normal _ _ _ _ _ _ _ h)
                    | false =>
                      dsimp only
                      cases target.isIndirect with
                      | true => cases isGenericClosureArityMismatch s.memory.callees target.defPath target.typeArgs <;> rintro ⟨⟩
                      | false =>
                        dsimp only
                        cases h_di : evalDirectRustIntrinsic? s (some (s.memory.activeCallee.getD body))
                            target (bodyLocalDeclsOf (some (s.memory.activeCallee.getD body)))
                            (s.memory.activeCallee.getD body).layouts
                            argOps argVals locals' dst targetBb unw with
                        | none => rintro ⟨⟩
                        | some stepNode =>
                          intro h
                          exact False.elim (evalDirectRustIntrinsic?_ne_ret_normal _ _ _ _ _ _ _ _ _ _ _ _ h_di _ _ h)
                  | none =>
                    dsimp only
                    cases target.isIndirect with
                    | true => cases isGenericClosureArityMismatch s.memory.callees target.defPath target.typeArgs <;> rintro ⟨⟩
                    | false =>
                      dsimp only
                      cases isUnreachableCallTarget target.defPath with
                      | true => rintro ⟨⟩
                      | false =>
                        dsimp only
                        cases isAbortingPanicDefPath target.defPath with
                        | true => rintro ⟨⟩
                        | false =>
                          dsimp only
                          cases isUnwindingPanicDefPath target.defPath with
                          | false =>
                            dsimp only
                            rcases evalDivergingRustIntrinsic?_eq_none_or_fault s target
                                (bodyLocalDeclsOf (some (s.memory.activeCallee.getD body)))
                                (s.memory.activeCallee.getD body).layouts argOps argVals locals' dst with
                              h_di | ⟨fk, h_di⟩ | h_di <;> (rw [h_di]; rintro ⟨⟩)
                          | true =>
                            dsimp only
                            cases h_a : applyUnwindAction s locals' s.memory unw
                            · rintro ⟨⟩
                            · intro h; injection h with ho; subst ho
                              exact False.elim (applyUnwindAction_ne_normal _ _ _ _ _ h_a)
                            · rintro ⟨⟩
          | return_ =>
            dsimp only [evalTerminator]
            cases get? s.frame.locals 0 with
            | none => rintro ⟨⟩
            | some sl =>
              cases sl with
              | uninit | dead => rintro ⟨⟩
              | init rv =>
                dsimp only
                cases hasFrameDeallocProtectorConflict _ _ _ _ with
                | true => rintro ⟨⟩
                | false =>
                  dsimp only
                  cases s.memory.callStack with
                  | nil =>
                    dsimp only
                    cases valueContainsUninit rv with
                    | true => rintro ⟨⟩
                    | false =>
                      intro h
                      injection h with h1
                      injection h1 with h2
                      injection h2 with _ hm
                      subst hm
                      exact ⟨rfl, rfl⟩
                  | cons c rest =>
                    dsimp only
                    repeat' (first | rintro ⟨⟩ | split)
        · rintro ⟨⟩

theorem wpMirExecNoCallSym_of_evalPureMirStateWithCallees
    {fuel : Nat} {body : CapturedMir} {callees : List CapturedMir}
    {traitImpls : List TraitImplEntry} {s : MachineState}
    {retVal : Value} {memOut : Memory}
    (h_inv : PureCalleeMachineInv callees traitImpls body s)
    (h_rep :
      MachineState.replaceRoot (pureCalleeMemory callees traitImpls) s = s)
    (h_eval : evalPureMirStateWithCallees fuel body s = some (retVal, memOut)) :
    wpMirExecNoCallSym fuel body (.running s)
      (mirNormalPost
        (fun rv m' =>
          ActiveRootMemory body (pureCalleeMemory callees traitImpls) m' ∧
          rv = retVal)) := by
  let m0 := pureCalleeMemory callees traitImpls
  induction fuel generalizing s with
  | zero => nomatch h_eval
  | succ fuel' ih =>
    have ⟨h_step_inv, h_step_eq⟩ :=
      stepMirFn_pureCallee_step_and_replaceRoot (mem₀ := m0) h_inv rfl rfl rfl
    rw [h_rep] at h_step_eq
    unfold wpMirExecNoCallSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    dsimp only [evalPureMirStateWithCallees] at h_eval
    cases h_sf : stepMirFn body s with
    | ret out =>
      rw [h_sf] at h_eval h_step_eq
      cases out with
      | panic => nomatch h_eval
      | abort => nomatch h_eval
      | normal rv =>
        rcases rv with ⟨v, mOut⟩
        dsimp only at h_eval
        cases h_ok : (mOut.callStack.isEmpty && mOut.activeProtectors.isEmpty) with
        | false => rw [h_ok] at h_eval; nomatch h_eval
        | true =>
          rw [h_ok] at h_eval
          injection h_eval with h_pair
          injection h_pair with hv hm_eq
          subst hv hm_eq
          simp only [Bool.and_eq_true, List.isEmpty_iff] at h_ok
          rcases h_ok with ⟨h_cs, h_ap⟩
          dsimp only [MirStepNode.replaceRoot, MirOutcome.replaceRoot] at h_step_eq
          injection h_step_eq with h_out_eq
          injection h_out_eq with h_prod_eq
          injection h_prod_eq with _ hm_rep
          dsimp only [evalNodeNoCallWP, mirNormalPost]
          refine ⟨?_, rfl⟩
          have ⟨h_ac_eq, h_ruc_eq⟩ := stepMirFn_ret_normal_activeCallee_ceil h_sf
          rw [hm_rep]
          dsimp only [Memory.replaceRoot]
          rw [h_cs, h_ap]
          cases h_ac_m : mOut.activeCallee with
          | none =>
            have h_s_none : s.memory.activeCallee = none := h_ac_eq.symm.trans h_ac_m
            have h_ruc_true : mOut.rootUnwindCeiling = true := h_ruc_eq.trans (h_inv.2.2.2.2.2.2.2.2 h_s_none)
            rw [h_ruc_true]
            exact Or.inl rfl
          | some ab => exact Or.inr ⟨ab, mOut.rootUnwindCeiling, rfl⟩
    | tau st' =>
      rw [h_sf] at h_eval h_step_inv h_step_eq
      cases st' with
      | halted _ => nomatch h_eval
      | faulted _ => nomatch h_eval
      | running s' =>
        dsimp only [MirStepNode.replaceRoot, MirExecState.replaceRoot] at h_step_eq
        injection h_step_eq with h_st_eq
        injection h_st_eq with h_s_rep
        dsimp only [evalNodeNoCallWP, pureNodeStepInv] at h_step_inv ⊢
        exact ih h_step_inv h_s_rep.symm h_eval
    | vis i k =>
      rw [h_sf] at h_eval h_step_inv h_step_eq
      rcases i with fk | (ev | c)
      · nomatch h_eval
      · cases ev
        dsimp only [evalNodeNoCallWP, pureNodeStepInv] at h_eval h_step_inv ⊢
        have h_cont_eq := congrArg (fun n => mirStepNodeObsCont n PUnit.unit) h_step_eq
        dsimp only [MirStepNode.replaceRoot, mirStepNodeObsCont] at h_cont_eq
        cases hk : k PUnit.unit with
        | halted _ => rw [hk] at h_eval; nomatch h_eval
        | faulted _ => rw [hk] at h_eval; nomatch h_eval
        | running s' =>
          rw [hk] at h_eval h_step_inv h_cont_eq
          dsimp only [MirExecState.replaceRoot] at h_eval h_step_inv h_cont_eq
          injection h_cont_eq with h_st_eq
          injection h_st_eq with h_s_rep
          exact ih h_step_inv h_s_rep.symm h_eval
      · exact False.elim h_step_inv

/--
Soundness of the computable `evalPureMirWithCallees` evaluator: if
`checkPureMirWithCallees` holds and `evalPureMirWithCallees` evaluates to
`some retVal`, then `PureMirConvergesWithCallees` holds with ZERO step-by-step
proof obligations.
-/
theorem pureMirConvergesWithCallees_of_evalPureMirWithCallees
    {fuel maxCallDepth : Nat}
    {body : CapturedMir}
    {callees : List CapturedMir}
    {args : List Value}
    {traitImpls : List TraitImplEntry}
    {retVal : Value}
    (h_pure : checkPureMirWithCallees callees body maxCallDepth traitImpls = true)
    (h_eval : evalPureMirWithCallees fuel body callees args traitImpls = some retVal) :
    PureMirConvergesWithCallees body callees (initPureState body args)
      (· = retVal) traitImpls := by
  unfold evalPureMirWithCallees at h_eval
  cases h_st : evalPureMirStateWithCallees fuel body
      ((initPureState body args).toMachineState
        (pureCalleeMemory callees traitImpls)) with
  | none => rw [h_st] at h_eval; nomatch h_eval
  | some rv =>
    rw [h_st] at h_eval
    rcases rv with ⟨v, memOut⟩
    dsimp only [Option.map] at h_eval
    injection h_eval with hv
    subst hv
    exact ⟨fuel, wpMirExecNoCallSym_of_evalPureMirStateWithCallees
      (PureCalleeMachineInv.init (initPureState body args) ⟨maxCallDepth, h_pure⟩)
      rfl h_st⟩

/--
Lift computable `evalPureMirWithCallees` directly to `MirWpConverges` on any
root-active caller `Memory`.
-/
theorem mirWpConverges_of_evalPureMirWithCallees
    {fuel maxCallDepth : Nat}
    {body : CapturedMir}
    {callees : List CapturedMir}
    {args : List Value}
    {mem₀ : Memory}
    {retVal : Value}
    (h_pure : checkPureMirWithCallees callees body maxCallDepth mem₀.traitImpls = true)
    (h_eval :
      evalPureMirWithCallees fuel body callees args mem₀.traitImpls = some retVal)
    (h_callees : mem₀.callees = callees := by rfl)
    (h_root : RootActiveMemory mem₀ := by
      first
      | assumption
      | exact ⟨rfl, rfl, rfl, rfl, rfl⟩
      | (refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> simp_all [RootActiveMemory])) :
    MirWpConverges body (initMachineStateWithMemory body args mem₀)
      (mirNormalPost
        (fun rv mem' => ActiveRootMemory body mem₀ mem' ∧ rv = retVal)) :=
  mirWpConverges_of_pureExecWithCallees h_pure
    (pureMirConvergesWithCallees_of_evalPureMirWithCallees h_pure h_eval)
    h_callees h_root

/--
Discharge `MirBoolPredicateHoldsWithCallees` by `decide`/`rfl` from computable
`checkPureMirWithCallees` and `checkPureMirBoolPredWithCallees`.
-/
theorem mirBoolPredicateHoldsWithCallees_of_checkPureMirBoolPredWithCallees
    {fuel maxCallDepth : Nat}
    (specBody : CapturedMir)
    (callees : List CapturedMir)
    (args : List Value)
    (h_pure :
      checkPureMirWithCallees callees specBody maxCallDepth
        specBody.traitImpls = true)
    (h_check :
      checkPureMirBoolPredWithCallees fuel specBody callees args = true) :
    MirFuelFree.MirBoolPredicateHoldsWithCallees specBody callees args := by
  unfold checkPureMirBoolPredWithCallees at h_check
  cases h_ev : evalPureMirWithCallees fuel specBody callees args specBody.traitImpls with
  | none => rw [h_ev] at h_check; nomatch h_check
  | some v =>
    rw [h_ev] at h_check
    cases v with
    | scalar sc =>
      simp only [Bool.and_eq_true, beq_iff_eq] at h_check
      rcases sc with ⟨bits, sz⟩
      dsimp only at h_check
      rcases h_check with ⟨rfl, rfl⟩
      exact mirBoolPredicateHoldsWithCallees_of_pureExecWithCallees
        specBody callees args h_pure
        (pureMirConvergesWithCallees_of_evalPureMirWithCallees h_pure h_ev)
    | _ => nomatch h_check

/-!
### 9B. Pure `CallConv.rustIntrinsic` Semantics &
`pureRustIntrinsicContract`
-/

open Anneal.Rustc.V2026_06_01.Lower

/--
Catalog of pure `CallConv.rustIntrinsic` operations (`FF-2.2` Section 2 & 3):
covers bit-counting and byte/bit permutation (`ctlz`, `ctlz_nonzero`, `cttz`,
`cttz_nonzero`, `ctpop`, `bswap`, `bitreverse`), wrapping and saturating
arithmetic (`wrapping_add/sub/mul`, `saturating_add/sub`), UB-guarded unchecked
and exact arithmetic (`unchecked_add/sub/mul/div/rem/shl/shr`, `exact_div`),
three-way comparison (`three_way_compare`), `ub_checks`, and runtime-dispatched
`const_eval_select`.
-/
inductive PureRustIntrinsicKind : Type
  | ctlz
  | ctlzNonzero
  | cttz
  | cttzNonzero
  | ctpop
  | bswap
  | bitreverse
  | wrappingAdd
  | wrappingSub
  | wrappingMul
  | saturatingAdd
  | saturatingSub
  | uncheckedAdd
  | uncheckedSub
  | uncheckedMul
  | uncheckedDiv
  | uncheckedRem
  | uncheckedShl
  | uncheckedShr
  | exactDiv
  | threeWayCompare
  | ubChecks
  | constEvalSelect
  deriving Repr

@[reducible]
def PureRustIntrinsicKind.toIdx : PureRustIntrinsicKind → Nat
  | .ctlz => 0
  | .ctlzNonzero => 1
  | .cttz => 2
  | .cttzNonzero => 3
  | .ctpop => 4
  | .bswap => 5
  | .bitreverse => 6
  | .wrappingAdd => 7
  | .wrappingSub => 8
  | .wrappingMul => 9
  | .saturatingAdd => 10
  | .saturatingSub => 11
  | .uncheckedAdd => 12
  | .uncheckedSub => 13
  | .uncheckedMul => 14
  | .uncheckedDiv => 15
  | .uncheckedRem => 16
  | .uncheckedShl => 17
  | .uncheckedShr => 18
  | .exactDiv => 19
  | .threeWayCompare => 20
  | .ubChecks => 21
  | .constEvalSelect => 22

@[reducible]
def PureRustIntrinsicKind.ofIdx : Nat → PureRustIntrinsicKind
  | 0 => .ctlz
  | 1 => .ctlzNonzero
  | 2 => .cttz
  | 3 => .cttzNonzero
  | 4 => .ctpop
  | 5 => .bswap
  | 6 => .bitreverse
  | 7 => .wrappingAdd
  | 8 => .wrappingSub
  | 9 => .wrappingMul
  | 10 => .saturatingAdd
  | 11 => .saturatingSub
  | 12 => .uncheckedAdd
  | 13 => .uncheckedSub
  | 14 => .uncheckedMul
  | 15 => .uncheckedDiv
  | 16 => .uncheckedRem
  | 17 => .uncheckedShl
  | 18 => .uncheckedShr
  | 19 => .exactDiv
  | 20 => .threeWayCompare
  | 21 => .ubChecks
  | 22 => .constEvalSelect
  | _ => .ctlz

theorem PureRustIntrinsicKind.ofIdx_toIdx :
    ∀ k : PureRustIntrinsicKind, ofIdx k.toIdx = k
  | .ctlz => rfl
  | .ctlzNonzero => rfl
  | .cttz => rfl
  | .cttzNonzero => rfl
  | .ctpop => rfl
  | .bswap => rfl
  | .bitreverse => rfl
  | .wrappingAdd => rfl
  | .wrappingSub => rfl
  | .wrappingMul => rfl
  | .saturatingAdd => rfl
  | .saturatingSub => rfl
  | .uncheckedAdd => rfl
  | .uncheckedSub => rfl
  | .uncheckedMul => rfl
  | .uncheckedDiv => rfl
  | .uncheckedRem => rfl
  | .uncheckedShl => rfl
  | .uncheckedShr => rfl
  | .exactDiv => rfl
  | .threeWayCompare => rfl
  | .ubChecks => rfl
  | .constEvalSelect => rfl

@[reducible]
instance : DecidableEq PureRustIntrinsicKind := fun a b =>
  match decEq a.toIdx b.toIdx with
  | isTrue h =>
    isTrue (by rw [← PureRustIntrinsicKind.ofIdx_toIdx a, ← PureRustIntrinsicKind.ofIdx_toIdx b, h])
  | isFalse h =>
    isFalse (fun hab => h (congrArg PureRustIntrinsicKind.toIdx hab))

def stripCharPrefix : List Char → List Char → Option (List Char)
  | [], s => some s
  | p :: ps, c :: cs => if p == c then stripCharPrefix ps cs else none
  | _ :: _, [] => none

/--
Strip `"core::intrinsics::"` or `"std::intrinsics::"` prefix from a `DefPath`
by structural character-list matching (100% kernel-reducible via `rfl`),
returning the bare intrinsic name when matched.
-/
def stripRustIntrinsicsPrefix? (defPath : DefPath) : Option String :=
  let cs := defPath.toList
  match stripCharPrefix "core::intrinsics::".toList cs with
  | some rest => some (String.ofList rest)
  | none =>
    match stripCharPrefix "std::intrinsics::".toList cs with
    | some rest => some (String.ofList rest)
    | none => none

/-- Classify a `DefPath` into a `PureRustIntrinsicKind` when recognized. -/
def classifyPureRustIntrinsic? (defPath : DefPath) : Option PureRustIntrinsicKind :=
  match stripRustIntrinsicsPrefix? defPath with
  | none => none
  | some name =>
    if stringEq name "ctlz" then some .ctlz
    else if stringEq name "ctlz_nonzero" then some .ctlzNonzero
    else if stringEq name "cttz" then some .cttz
    else if stringEq name "cttz_nonzero" then some .cttzNonzero
    else if stringEq name "ctpop" then some .ctpop
    else if stringEq name "bswap" then some .bswap
    else if stringEq name "bitreverse" then some .bitreverse
    else if stringEq name "wrapping_add" then some .wrappingAdd
    else if stringEq name "wrapping_sub" then some .wrappingSub
    else if stringEq name "wrapping_mul" then some .wrappingMul
    else if stringEq name "saturating_add" then some .saturatingAdd
    else if stringEq name "saturating_sub" then some .saturatingSub
    else if stringEq name "unchecked_add" then some .uncheckedAdd
    else if stringEq name "unchecked_sub" then some .uncheckedSub
    else if stringEq name "unchecked_mul" then some .uncheckedMul
    else if stringEq name "unchecked_div" then some .uncheckedDiv
    else if stringEq name "unchecked_rem" then some .uncheckedRem
    else if stringEq name "unchecked_shl" then some .uncheckedShl
    else if stringEq name "unchecked_shr" then some .uncheckedShr
    else if stringEq name "exact_div" then some .exactDiv
    else if stringEq name "three_way_compare" then some .threeWayCompare
    else if stringEq name "ub_checks" then some .ubChecks
    else if stringEq name "const_eval_select" then some .constEvalSelect
    else none

/--
Resolve a monomorphized `RigidTy` argument of an integer intrinsic to its
`(sizeBytes, isSigned)` pair, failing closed (`none`) on unresolved generic
parameters (`.param ..`), non-integer types, or `pointerBytes = 0`.
When `allowChar = true` (`three_way_compare`), `RigidTy.char` resolves to
`(4, false)`.
-/
def intrinsicScalarTyInfo?
    (pointerBytes : Nat := 8)
    (allowChar : Bool := false) :
    RigidTy → Option (Nat × Bool)
  | .uint .u8 => some (1, false)
  | .uint .u16 => some (2, false)
  | .uint .u32 => some (4, false)
  | .uint .u64 => some (8, false)
  | .uint .u128 => some (16, false)
  | .uint .usize => if 0 < pointerBytes then some (pointerBytes, false) else none
  | .int .i8 => some (1, true)
  | .int .i16 => some (2, true)
  | .int .i32 => some (4, true)
  | .int .i64 => some (8, true)
  | .int .i128 => some (16, true)
  | .int .isize => if 0 < pointerBytes then some (pointerBytes, true) else none
  | .char => if allowChar then some (4, false) else none
  | _ => none

/--
Check that `sc` has exact width `sz > 0` and canonical bit range `sc.bits <
256^sz`.
-/
def isCanonicalScalarOfSize (sc : ScalarInt) (sz : Nat) : Bool :=
  0 < sz && sc.sizeBytes == sz && sc.bits < scalarModulus sz

/--
Evaluate `saturating_add<T>(a, b)` on canonical equal-width `ScalarInt`
operands (unsigned clamping to `2^(8*sz) - 1`; two's-complement signed clamping
to `INT_MIN = 2^(8*sz - 1)` or `INT_MAX = 2^(8*sz - 1) - 1`).
-/
def evalSaturatingAdd (a b : ScalarInt) (isSigned : Bool) : Option ScalarInt :=
  if a.sizeBytes == 0 || a.sizeBytes != b.sizeBytes then
    none
  else
    let sz := a.sizeBytes
    let modulus := scalarModulus sz
    let ca := wrapScalarBits a.bits modulus
    let cb := wrapScalarBits b.bits modulus
    match isSigned with
    | false =>
      let sum := ca + cb
      let clamped := if sum < modulus then sum else modulus - 1
      some ⟨clamped, sz⟩
    | true =>
      match signedOverflowAdd ca cb sz with
      | false => some ⟨wrapScalarBits (ca + cb) modulus, sz⟩
      | true =>
        let half := signedHalfModulus sz
        if isSignedNegative ca sz then
          some ⟨half, sz⟩
        else
          some ⟨half - 1, sz⟩

/--
Count the number of set (`1`) bits in the low `remBits` bits of `bits` by
structural recursion (`core::intrinsics::ctpop`).
-/
def pureCtpopLoop : Nat → Nat → Nat
  | .zero, _ => 0
  | .succ remBits, bits =>
    Nat.add (Nat.mod bits 2) (pureCtpopLoop remBits (Nat.div bits 2))

/--
Count consecutive trailing zero (`0`) bits starting from the least significant
bit across `remBits` bits of `bits` (`core::intrinsics::cttz`).
-/
def pureCttzLoop : Nat → Nat → Nat
  | .zero, _ => 0
  | .succ remBits, bits =>
    match Nat.beq (Nat.mod bits 2) 0 with
    | true => Nat.add 1 (pureCttzLoop remBits (Nat.div bits 2))
    | false => 0

/--
Reverse the low `remBits` bits of `bits` into accumulator `acc`
(`core::intrinsics::bitreverse`).
-/
def pureBitreverseLoop : Nat → Nat → Nat → Nat
  | .zero, _, acc => acc
  | .succ remBits, bits, acc =>
    pureBitreverseLoop
      remBits
      (Nat.div bits 2)
      (Nat.add (Nat.mul acc 2) (Nat.mod bits 2))

/--
Count consecutive leading zero (`0`) bits of a `numBits`-bit unsigned word
`bits` (`core::intrinsics::ctlz`).
-/
def pureCtlzBits (numBits bits : Nat) : Nat :=
  pureCttzLoop numBits (pureBitreverseLoop numBits bits 0)

/--
Reverse the low `remBytes` bytes of `bits` into accumulator `acc`
(`core::intrinsics::bswap`).
-/
def pureBswapLoop : Nat → Nat → Nat → Nat
  | .zero, _, acc => acc
  | .succ remBytes, bits, acc =>
    pureBswapLoop
      remBytes
      (Nat.div bits 256)
      (Nat.add (Nat.mul acc 256) (Nat.mod bits 256))

/--
Evaluate a pure scalar `BinOp` directly via `Trusted`'s `evalScalarBinOp`,
returning `some sc` on `.ok (.scalar sc) _ _` and `none` on UB or unsupported
operands.
-/
def evalPureScalarBinOp?
    (op : BinOp)
    (a b : ScalarInt)
    (isSigned : Bool) : Option ScalarInt :=
  match evalScalarBinOp op a b [] emptyMemory isSigned with
  | .ok (.scalar sc) _ _ => some sc
  | _ => none

/--
Evaluate `saturating_sub<T>(a, b)` on equal-width `ScalarInt` operands,
normalizing non-canonical bit representations modulo `256^sz` (unsigned
clamping to `0`; two's-complement signed clamping to `INT_MIN` or `INT_MAX`).
-/
def evalSaturatingSub (a b : ScalarInt) (isSigned : Bool) : Option ScalarInt :=
  if a.sizeBytes == 0 || a.sizeBytes != b.sizeBytes then
    none
  else
    let sz := a.sizeBytes
    let modulus := scalarModulus sz
    let ca := wrapScalarBits a.bits modulus
    let cb := wrapScalarBits b.bits modulus
    match isSigned with
    | false => some ⟨ca - cb, sz⟩
    | true =>
      match signedOverflowSub ca cb sz with
      | false => evalPureScalarBinOp? .sub ⟨ca, sz⟩ ⟨cb, sz⟩ true
      | true =>
        let half := signedHalfModulus sz
        if isSignedNegative ca sz then
          some ⟨half, sz⟩
        else
          some ⟨half - 1, sz⟩

/--
Evaluate any of the 22 direct value-returning `PureRustIntrinsicKind`
intrinsics on `typeArgs` and `args`, returning `none` on undefined behavior
(`ctlz_nonzero(0)`, `cttz_nonzero(0)`, `unchecked_*` overflow / negative or
out-of-bounds shift / division by zero / `INT_MIN ÷ -1`, `exact_div` non-zero
remainder / zero / `INT_MIN ÷ -1`) or unresolved generic type arguments.
-/
def evalPureScalarIntrinsic
    (kind : PureRustIntrinsicKind)
    (typeArgs : List RigidTy)
    (args : List Value)
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true) : Option Value :=
  match kind with
  | .ubChecks =>
    match typeArgs, args with
    | [], [] => some (.scalar (boolToScalar ubChecksEnabled))
    | _, _ => none
  | .constEvalSelect => none
  | .ctlz =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz then
          some (.scalar ⟨pureCtlzBits (sz * 8) x.bits, 4⟩)
        else none
      | none => none
    | _, _ => none
  | .ctlzNonzero =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz && x.bits != 0 then
          some (.scalar ⟨pureCtlzBits (sz * 8) x.bits, 4⟩)
        else none
      | none => none
    | _, _ => none
  | .cttz =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz then
          some (.scalar ⟨pureCttzLoop (sz * 8) x.bits, 4⟩)
        else none
      | none => none
    | _, _ => none
  | .cttzNonzero =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz && x.bits != 0 then
          some (.scalar ⟨pureCttzLoop (sz * 8) x.bits, 4⟩)
        else none
      | none => none
    | _, _ => none
  | .ctpop =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz then
          some (.scalar ⟨pureCtpopLoop (sz * 8) x.bits, 4⟩)
        else none
      | none => none
    | _, _ => none
  | .bswap =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz then
          some (.scalar ⟨pureBswapLoop sz x.bits 0, sz⟩)
        else none
      | none => none
    | _, _ => none
  | .bitreverse =>
    match typeArgs, args with
    | [ty], [.scalar x] =>
      match intrinsicScalarTyInfo? pointerBytes false ty with
      | some (sz, _) =>
        if isCanonicalScalarOfSize x sz then
          some (.scalar ⟨pureBitreverseLoop (sz * 8) x.bits 0, sz⟩)
        else none
      | none => none
    | _, _ => none
  | .uncheckedShl | .uncheckedShr =>
    let tyPairOpt :=
      match typeArgs with
      | [lhsTy, rhsTy] =>
        match intrinsicScalarTyInfo? pointerBytes false lhsTy,
              intrinsicScalarTyInfo? pointerBytes false rhsTy with
        | some lInfo, some rInfo => some (lInfo, rInfo)
        | _, _ => none
      | [lhsTy] =>
        match intrinsicScalarTyInfo? pointerBytes false lhsTy with
        | some lInfo => some (lInfo, lInfo)
        | none => none
      | _ => none
    match tyPairOpt, args with
    | some ((lhsSz, lhsSigned), (rhsSz, rhsSigned)), [.scalar a, .scalar b] =>
      if isCanonicalScalarOfSize a lhsSz &&
         isCanonicalScalarOfSize b rhsSz &&
         (!rhsSigned || !isSignedNegative b.bits rhsSz) &&
         b.bits < lhsSz * 8 then
        let binOp : BinOp :=
          match kind with
          | .uncheckedShl => .shlUnchecked
          | _ => .shrUnchecked
        (evalPureScalarBinOp? binOp a b lhsSigned).map Value.scalar
      else none
    | _, _ => none
  | _ =>
    let allowChar := kind == .threeWayCompare
    let singleTyOpt : Option RigidTy :=
      match typeArgs with
      | [ty] => some ty
      | [ty₁, ty₂] => if rigidTyEq ty₁ ty₂ then some ty₁ else none
      | _ => none
    match singleTyOpt, args with
    | some ty, [.scalar a, .scalar b] =>
      match intrinsicScalarTyInfo? pointerBytes allowChar ty with
      | some (sz, isSigned) =>
        if isCanonicalScalarOfSize a sz && isCanonicalScalarOfSize b sz then
          match kind with
          | .wrappingAdd =>
            (evalPureScalarBinOp? .add a b isSigned).map Value.scalar
          | .wrappingSub =>
            (evalPureScalarBinOp? .sub a b isSigned).map Value.scalar
          | .wrappingMul =>
            (evalPureScalarBinOp? .mul a b isSigned).map Value.scalar
          | .saturatingAdd =>
            (evalSaturatingAdd a b isSigned).map Value.scalar
          | .saturatingSub =>
            (evalSaturatingSub a b isSigned).map Value.scalar
          | .uncheckedAdd =>
            (evalPureScalarBinOp? .addUnchecked a b isSigned).map Value.scalar
          | .uncheckedSub =>
            (evalPureScalarBinOp? .subUnchecked a b isSigned).map Value.scalar
          | .uncheckedMul =>
            (evalPureScalarBinOp? .mulUnchecked a b isSigned).map Value.scalar
          | .uncheckedDiv =>
            (evalPureScalarBinOp? .div a b isSigned).map Value.scalar
          | .uncheckedRem =>
            (evalPureScalarBinOp? .rem a b isSigned).map Value.scalar
          | .exactDiv =>
            (evalExactDiv a b isSigned).map Value.scalar
          | .threeWayCompare =>
            (evalPureScalarBinOp? .cmp a b isSigned).map Value.scalar
          | _ => none
        else none
      | none => none
    | _, _ => none

/--
Check whether `v` is a valid zero-sized function-item or capture-free closure
value (`.unit` or `.aggregate 0 []`).
-/
def isZeroSizedFnItemValue : Value → Bool
  | .unit => true
  | .aggregate 0 [] => true
  | _ => false

/--
Extract `(defPath, typeArgs)` from a zero-sized `.fnDef` or capture-free
`.closure` runtime target type. Because `RigidTy.closure defPath upvars` stores
captured upvar types in `upvars` (rather than generic `typeArgs`), only
capture-free closures (`upvars = []`) are zero-sized callable targets, and their
lookup `typeArgs` list is `[]`.
-/
def extractZeroSizedCallableTy? : RigidTy → Option (DefPath × List RigidTy)
  | .fnDef defPath typeArgs => some (defPath, typeArgs)
  | .closure defPath upvars =>
    if upvars.isEmpty then some (defPath, []) else none
  | _ => none

mutual
/--
Check whether `ty` is an inhabited zero-sized unit-like element type whose
runtime representation in `Value` can be `Value.unit`.
-/
def isZeroSizedUnitElemTy : Nat → RigidTy → Bool
  | 0, _ => false
  | fuel + 1, .tuple ts => isZeroSizedUnitElemTyList fuel ts
  | _ + 1, .fnDef _ _ => true
  | fuel + 1, .closure _ upvars => isZeroSizedUnitElemTyList fuel upvars
  | fuel + 1, .array elemTy n => n == 0 || isZeroSizedUnitElemTy fuel elemTy
  | _ + 1, _ => false

def isZeroSizedUnitElemTyList : Nat → List RigidTy → Bool
  | _, [] => true
  | 0, _ :: _ => false
  | fuel + 1, t :: ts =>
    isZeroSizedUnitElemTy fuel t && isZeroSizedUnitElemTyList fuel ts
end

/--
Unpack a runtime `core::intrinsics::const_eval_select<ARG, F, G, RET>` call's
`typeArgs = [.tuple elemTys, constFnTy, rtFnTy, _retTy]` and
`args = [tupleVal, constFnVal, rtFnVal]` into `(elemTys, rtDefPath, rtTypeArgs,
unpackedArgs)`, requiring both `constFnTy` and `rtFnTy` to be zero-sized
`.fnDef` or capture-free `.closure` callable types (`upvars = []`), as well as
supporting non-empty inhabited ZST argument tuples represented as `Value.unit`.
-/
def unpackConstEvalSelectWithElemTys?
    (typeArgs : List RigidTy)
    (args : List Value) :
    Option (List RigidTy × DefPath × List RigidTy × List Value) :=
  match typeArgs, args with
  | [.tuple elemTys, constFnTy, rtFnTy, _], [tupleVal, constFnVal, rtFnVal] =>
    match extractZeroSizedCallableTy? constFnTy,
          extractZeroSizedCallableTy? rtFnTy with
    | some _, some (rtDefPath, rtTypeArgs) =>
      if isZeroSizedFnItemValue constFnVal && isZeroSizedFnItemValue rtFnVal then
        match elemTys, tupleVal with
        | [], .unit => some ([], rtDefPath, rtTypeArgs, [])
        | _, .unit =>
          if isZeroSizedUnitElemTyList 8 elemTys then
            some (elemTys, rtDefPath, rtTypeArgs,
              List.replicate elemTys.length Value.unit)
          else none
        | _, .aggregate 0 fieldVals =>
          if fieldVals.length == elemTys.length then
            some (elemTys, rtDefPath, rtTypeArgs, fieldVals)
          else none
        | _, _ => none
      else none
    | _, _ => none
  | _, _ => none

/--
Unpack a runtime `core::intrinsics::const_eval_select<ARG, F, G, RET>` call into
`(rtDefPath, rtTypeArgs, unpackedArgs)`.
-/
def unpackConstEvalSelect?
    (typeArgs : List RigidTy)
    (args : List Value) :
    Option (DefPath × List RigidTy × List Value) :=
  match unpackConstEvalSelectWithElemTys? typeArgs args with
  | some (_, rtDefPath, rtTypeArgs, unpackedArgs) =>
    some (rtDefPath, rtTypeArgs, unpackedArgs)
  | none => none

/--
Bounded-depth helper evaluating `PureRustIntrinsicKind` operations, supporting
nested `const_eval_select` chains up to `fuel` levels (falling back to `rtEval`
first and then recursive `evalPureRustIntrinsicFuel` when the selected runtime
function is itself a pure `CallConv.rustIntrinsic` operation).
-/
def evalPureRustIntrinsicFuel
    (fuel : Nat)
    (rtEval : DefPath → List RigidTy → List Value → Option Value := fun _ _ _ => none)
    (kind : PureRustIntrinsicKind)
    (typeArgs : List RigidTy)
    (args : List Value)
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true) : Option Value :=
  match kind with
  | .constEvalSelect =>
    match fuel with
    | 0 => none
    | fuel' + 1 =>
      match unpackConstEvalSelectWithElemTys? typeArgs args with
      | some (elemTys, rtDefPath, rtTypeArgs, unpackedArgs) =>
        match rtEval rtDefPath rtTypeArgs unpackedArgs with
        | some v => some v
        | none =>
          match classifyPureRustIntrinsic? rtDefPath with
          | some subKind =>
            let effTypeArgs := if rtTypeArgs.isEmpty then elemTys else rtTypeArgs
            evalPureRustIntrinsicFuel fuel' rtEval subKind effTypeArgs
              unpackedArgs pointerBytes ubChecksEnabled
          | none => none
      | none => none
  | _ => evalPureScalarIntrinsic kind typeArgs args pointerBytes ubChecksEnabled

/--
Evaluate any of the 23 `PureRustIntrinsicKind` operations, delegating
`const_eval_select` to `rtEval rtDefPath rtTypeArgs unpackedArgs` first and
automatically falling back to nested pure `CallConv.rustIntrinsic` evaluation
(up to depth `8`) when `rtDefPath` is itself a pure Rust intrinsic.
-/
def evalPureRustIntrinsicWithRuntime
    (rtEval : DefPath → List RigidTy → List Value → Option Value := fun _ _ _ => none)
    (kind : PureRustIntrinsicKind)
    (typeArgs : List RigidTy)
    (args : List Value)
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true) : Option Value :=
  match kind with
  | .constEvalSelect =>
    match unpackConstEvalSelectWithElemTys? typeArgs args with
    | some (elemTys, rtDefPath, rtTypeArgs, unpackedArgs) =>
      match rtEval rtDefPath rtTypeArgs unpackedArgs with
      | some v => some v
      | none =>
        match classifyPureRustIntrinsic? rtDefPath with
        | some subKind =>
          let effTypeArgs := if rtTypeArgs.isEmpty then elemTys else rtTypeArgs
          match subKind with
          | .constEvalSelect =>
            evalPureRustIntrinsicFuel 7 rtEval .constEvalSelect effTypeArgs
              unpackedArgs pointerBytes ubChecksEnabled
          | _ =>
            evalPureScalarIntrinsic subKind effTypeArgs unpackedArgs
              pointerBytes ubChecksEnabled
        | none => none
    | none => none
  | _ => evalPureScalarIntrinsic kind typeArgs args pointerBytes ubChecksEnabled

/--
Check whether parameter `_1` (`index 1` of `calleeBody.localDecls`) is a
capture-free closure self-environment slot of type `RigidTy.closure
calleeBody.defPath []` (`argCount ≥ 1`), as emitted by `rustc` for capture-free
closures implementing `FnOnce<ARG>`.
-/
def isCaptureFreeClosureSelfLocal (calleeBody : CapturedMir) : Bool :=
  0 < calleeBody.argCount &&
  match get? calleeBody.localDecls 1 with
  | some decl =>
    match decl.ty.kind with
    | .closure cp upvars => stringEq cp calleeBody.defPath && upvars.isEmpty
    | _ => false
  | none => false

/--
Validate exact parameter arity and construct the effective `MirSemantics` frame
argument list for a `const_eval_select` runtime target `calleeBody` given
unpacked tuple elements `unpackedArgs`:
- When `isCaptureFreeClosureSelfLocal calleeBody = true`, prepends the zero-sized
  closure environment `Value.unit` for `_1` and requires
  `calleeBody.argCount == unpackedArgs.length + 1`.
- Otherwise (a `fn` item `calleeBody`), requires exact parameter arity
  `calleeBody.argCount == unpackedArgs.length` so `initLocalsAux` cannot
  silently initialize temporary locals (`local > argCount`) or leave parameter
  locals `.dead`.
-/
def effectiveConstEvalCalleeArgs?
    (calleeBody : CapturedMir)
    (unpackedArgs : List Value) : Option (List Value) :=
  if isCaptureFreeClosureSelfLocal calleeBody then
    if calleeBody.argCount == unpackedArgs.length + 1 then
      some (.unit :: unpackedArgs)
    else
      none
  else if calleeBody.argCount == unpackedArgs.length then
    some unpackedArgs
  else
    none

/--
Linked-callee runtime evaluator for `core::intrinsics::const_eval_select`
(`FF-2.2` Section 3): resolves `(rtDefPath, rtTypeArgs)` in `callees` (including
polymorphic `(defPath, typeArgs)` instantiation, capture-free closures with
`_1 : .closure defPath []`, and `TraitImplEntry` dispatch), enforces exact
parameter arity via `effectiveConstEvalCalleeArgs?`, verifies
`checkPureMirWithCallees`, and evaluates `calleeBody` via
`evalPureMirWithCallees fuel`.
-/
def calleeRuntimeEval
    (fuel : Nat)
    (callees : List CapturedMir)
    (callerLayouts : LayoutTable)
    (traitImpls : List TraitImplEntry := [])
    (maxCallDepth : Nat := defaultMaxCallDepth) :
    DefPath → List RigidTy → List Value → Option Value :=
  fun rtDefPath rtTypeArgs unpackedArgs =>
    match lookupCallee callees callerLayouts rtDefPath rtTypeArgs traitImpls with
    | some calleeBody =>
      match effectiveConstEvalCalleeArgs? calleeBody unpackedArgs with
      | some callArgs =>
        if checkPureMirWithCallees callees calleeBody maxCallDepth traitImpls then
          evalPureMirWithCallees fuel calleeBody callees callArgs traitImpls
        else
          none
      | none => none
    | none => none

/--
Operational soundness of `calleeRuntimeEval`: whenever `calleeRuntimeEval`
returns `some retVal`, `lookupCallee` resolves `(rtDefPath, rtTypeArgs)` to a
pure `calleeBody` with validated frame arguments `callArgs` (via
`effectiveConstEvalCalleeArgs?`) whose operational `MirWpConverges` semantics
converges to `retVal` on any root-active caller memory `mem₀`.
-/
theorem calleeRuntimeEval_sound
    {fuel maxCallDepth : Nat}
    {callees : List CapturedMir}
    {callerLayouts : LayoutTable}
    {mem₀ : Memory}
    {rtDefPath : DefPath}
    {rtTypeArgs : List RigidTy}
    {unpackedArgs : List Value}
    {retVal : Value}
    (h_eval :
      calleeRuntimeEval fuel callees callerLayouts mem₀.traitImpls maxCallDepth
        rtDefPath rtTypeArgs unpackedArgs = some retVal)
    (h_callees : mem₀.callees = callees := by rfl)
    (h_root : RootActiveMemory mem₀ := by
      first
      | assumption
      | exact ⟨rfl, rfl, rfl, rfl, rfl⟩
      | (refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> simp_all [RootActiveMemory])) :
    ∃ (calleeBody : CapturedMir) (callArgs : List Value),
      lookupCallee callees callerLayouts rtDefPath rtTypeArgs mem₀.traitImpls =
        some calleeBody ∧
      effectiveConstEvalCalleeArgs? calleeBody unpackedArgs = some callArgs ∧
      MirWpConverges calleeBody
        (initMachineStateWithMemory calleeBody callArgs mem₀)
        (mirNormalPost
          (fun rv mem' => ActiveRootMemory calleeBody mem₀ mem' ∧ rv = retVal)) := by
  unfold calleeRuntimeEval at h_eval
  cases h_lk : lookupCallee callees callerLayouts rtDefPath rtTypeArgs mem₀.traitImpls with
  | none =>
    rw [h_lk] at h_eval
    nomatch h_eval
  | some calleeBody =>
    rw [h_lk] at h_eval
    dsimp only at h_eval
    cases h_eff : effectiveConstEvalCalleeArgs? calleeBody unpackedArgs with
    | none =>
      rw [h_eff] at h_eval
      nomatch h_eval
    | some callArgs =>
      rw [h_eff] at h_eval
      dsimp only at h_eval
      cases h_pure :
          checkPureMirWithCallees callees calleeBody maxCallDepth mem₀.traitImpls with
      | false =>
        rw [h_pure] at h_eval
        nomatch h_eval
      | true =>
        rw [h_pure] at h_eval
        simp only [↓reduceIte] at h_eval
        exact ⟨calleeBody, callArgs, rfl, h_eff,
          mirWpConverges_of_evalPureMirWithCallees h_pure h_eval h_callees h_root⟩

/--
Kernel-checked operational agreement between `evalPureRustIntrinsicWithRuntime`
on `.exactDiv` and `Trusted`'s `evalExactDiv` (`Scalars.lean`) for any integer
type `ty` resolving via `intrinsicScalarTyInfo? pointerBytes false ty =
some (sz, isSigned)` and canonical `ScalarInt` operands `a, b` of width `sz`.
-/
theorem evalPureRustIntrinsic_exactDiv_eq_evalExactDiv
    (rtEval : DefPath → List RigidTy → List Value → Option Value)
    (pointerBytes : Nat) (ubChecksEnabled : Bool)
    (ty : RigidTy) (sz : Nat) (isSigned : Bool)
    (a b : ScalarInt)
    (h_ty : intrinsicScalarTyInfo? pointerBytes false ty = some (sz, isSigned))
    (h_ca : isCanonicalScalarOfSize a sz = true)
    (h_cb : isCanonicalScalarOfSize b sz = true) :
    evalPureRustIntrinsicWithRuntime rtEval .exactDiv [ty] [.scalar a, .scalar b]
      pointerBytes ubChecksEnabled =
      (evalExactDiv a b isSigned).map Value.scalar := by
  unfold evalPureRustIntrinsicWithRuntime evalPureScalarIntrinsic
  have h_ac : (PureRustIntrinsicKind.exactDiv == PureRustIntrinsicKind.threeWayCompare) = false := rfl
  dsimp only; rw [h_ac, h_ty]
  simp only [h_ca, h_cb, Bool.and_self, ↓reduceIte]

/--
Map binary arithmetic/comparison `PureRustIntrinsicKind` variants directly
modeled via `Trusted`'s `evalScalarBinOp` (`Scalars.lean`) to their underlying
`BinOp`.
-/
def pureIntrinsicToScalarBinOp? : PureRustIntrinsicKind → Option BinOp
  | .wrappingAdd => some .add
  | .wrappingSub => some .sub
  | .wrappingMul => some .mul
  | .uncheckedAdd => some .addUnchecked
  | .uncheckedSub => some .subUnchecked
  | .uncheckedMul => some .mulUnchecked
  | .uncheckedDiv => some .div
  | .uncheckedRem => some .rem
  | .threeWayCompare => some .cmp
  | _ => none

/--
Kernel-checked operational agreement between `evalPureRustIntrinsicWithRuntime`
and `Trusted`'s `evalScalarBinOp` across all 9 wrapping, unchecked-arithmetic,
and three-way comparison intrinsics in `pureIntrinsicToScalarBinOp?`.
-/
theorem evalPureRustIntrinsic_binOp_eq_evalScalarBinOp
    (rtEval : DefPath → List RigidTy → List Value → Option Value)
    (kind : PureRustIntrinsicKind) (op : BinOp)
    (pointerBytes : Nat) (ubChecksEnabled : Bool)
    (ty : RigidTy) (sz : Nat) (isSigned : Bool)
    (a b : ScalarInt)
    (h_kind : pureIntrinsicToScalarBinOp? kind = some op)
    (h_ty :
      intrinsicScalarTyInfo? pointerBytes (kind == .threeWayCompare) ty =
        some (sz, isSigned))
    (h_ca : isCanonicalScalarOfSize a sz = true)
    (h_cb : isCanonicalScalarOfSize b sz = true) :
    evalPureRustIntrinsicWithRuntime rtEval kind [ty] [.scalar a, .scalar b]
      pointerBytes ubChecksEnabled =
      match evalScalarBinOp op a b [] emptyMemory isSigned with
      | .ok (.scalar sc) _ _ => some (.scalar sc)
      | _ => none := by
  cases kind <;>
    (dsimp only [pureIntrinsicToScalarBinOp?] at h_kind) <;>
    (try contradiction) <;>
    (injection h_kind with h_eq;
     have h_eq_symm := h_eq.symm;
     subst h_eq_symm;
     unfold evalPureRustIntrinsicWithRuntime evalPureScalarIntrinsic evalPureScalarBinOp?;
     dsimp only at h_ty ⊢;
     rw [h_ty];
     simp only [h_ca, h_cb, Bool.and_self, ↓reduceIte];
     cases evalScalarBinOp _ a b [] emptyMemory isSigned with
     | ub => rfl
     | unsupported => rfl
     | ok v _ _ => cases v <;> rfl)

/--
Modular `MirCallContract` modeling pure `#[rustc_nounwind]`
`CallConv.rustIntrinsic` calls (`FF-2.2` Section 2 & 3):
- Requires `req.defPath` to classify as a `PureRustIntrinsicKind` whose pure
  evaluator returns `some expectedVal` (rejecting all UB inputs).
- Guarantees normal return `.returned expectedVal req.memory` with zero memory
  mutation (`memAfter = req.memory`) and forbids unwinding or abort.
-/
def pureRustIntrinsicContract
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true)
    (rtEval : DefPath → List RigidTy → List Value → Option Value := fun _ _ _ => none) :
    MirCallContract where
  pre req :=
    ∃ (kind : PureRustIntrinsicKind) (retVal : Value),
      classifyPureRustIntrinsic? req.defPath = some kind ∧
      evalPureRustIntrinsicWithRuntime rtEval kind req.typeArgs req.args
        pointerBytes ubChecksEnabled = some retVal
  post req ans :=
    match ans with
    | .returned retVal memAfter =>
      memAfter = req.memory ∧
      ∃ kind : PureRustIntrinsicKind,
        classifyPureRustIntrinsic? req.defPath = some kind ∧
        evalPureRustIntrinsicWithRuntime rtEval kind req.typeArgs req.args
          pointerBytes ubChecksEnabled = some retVal
    | _ => False

theorem pureRustIntrinsicContract_frameAndTraitsPreserved
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true)
    (rtEval : DefPath → List RigidTy → List Value → Option Value := fun _ _ _ => none) :
    ∀ (req : MirCallReq) (ans : MirCallAns),
      (pureRustIntrinsicContract pointerBytes ubChecksEnabled rtEval).post req ans →
      ans.frameAndTraitsPreserved req.memory := by
  intro req ans h_post
  cases ans with
  | returned retVal memAfter =>
    rcases h_post with ⟨rfl, _⟩
    exact ⟨⟨rfl, rfl, rfl, rfl, [], rfl⟩, rfl⟩
  | panicked _ => exact False.elim h_post
  | aborted => trivial

theorem pureRustIntrinsicContract_framePreserved
    (pointerBytes : Nat := 8)
    (ubChecksEnabled : Bool := true)
    (rtEval : DefPath → List RigidTy → List Value → Option Value := fun _ _ _ => none) :
    ∀ (req : MirCallReq) (ans : MirCallAns),
      (pureRustIntrinsicContract pointerBytes ubChecksEnabled rtEval).post req ans →
      ans.framePreserved req.memory := by
  intro req ans h_post
  cases ans with
  | returned retVal memAfter =>
    rcases h_post with ⟨rfl, _⟩
    exact ⟨rfl, rfl, rfl, rfl, [], rfl⟩
  | panicked _ => exact False.elim h_post
  | aborted => trivial

/--
Combine two `MirCallContract`s (`c₁` and `c₂`, e.g., `pureRustIntrinsicContract`
and `polyExternalSpecCallContract` / `externalSpecCallContract`) into a single
intersection-of-guarantees modular rely contract so callers can freely mix
sub-contract call rules via `MirCallContract.Subsumes` without domain-disjointness
side conditions.
-/
def combineMirCallContracts (c₁ c₂ : MirCallContract) : MirCallContract where
  pre req := c₁.pre req ∨ c₂.pre req
  post req ans :=
    (c₁.pre req ∨ c₂.pre req) ∧
    (c₁.pre req → c₁.post req ans) ∧
    (c₂.pre req → c₂.post req ans)

theorem combineMirCallContracts_holdsOn
    {c₁ c₂ : MirCallContract} {h : ExternalCallHandler}
    (h₁ : c₁.holdsOn h) (h₂ : c₂.holdsOn h) :
    (combineMirCallContracts c₁ c₂).holdsOn h := by
  intro req h_pre
  refine ⟨?_, fun tr ans h_ret =>
    ⟨h_pre,
     fun hp₁ => (h₁ req hp₁).2 tr ans h_ret,
     fun hp₂ => (h₂ req hp₂).2 tr ans h_ret⟩⟩
  rcases h_pre with hp₁ | hp₂
  · exact (h₁ req hp₁).1
  · exact (h₂ req hp₂).1

theorem combineMirCallContracts_frameAndTraitsPreserved
    {c₁ c₂ : MirCallContract}
    (hf₁ : ∀ req ans, c₁.post req ans → ans.frameAndTraitsPreserved req.memory)
    (hf₂ : ∀ req ans, c₂.post req ans → ans.frameAndTraitsPreserved req.memory) :
    ∀ req ans,
      (combineMirCallContracts c₁ c₂).post req ans →
      ans.frameAndTraitsPreserved req.memory := by
  intro req ans ⟨h_pre, hi₁, hi₂⟩
  rcases h_pre with hp₁ | hp₂
  · exact hf₁ req ans (hi₁ hp₁)
  · exact hf₂ req ans (hi₂ hp₂)

/--
Contract refinement / subsumption relation `MirCallContract.Subsumes cSub cSuper`:
every call request permitted by `cSub` is permitted by `cSuper`, and every
answer allowed by `cSuper` satisfies `cSub.post`.
-/
def MirCallContract.Subsumes (cSub cSuper : MirCallContract) : Prop :=
  ∀ req : MirCallReq,
    cSub.pre req →
    cSuper.pre req ∧ ∀ ans : MirCallAns, cSuper.post req ans → cSub.post req ans

theorem MirCallContract.Subsumes.refl (c : MirCallContract) :
    MirCallContract.Subsumes c c :=
  fun _ hp => ⟨hp, fun _ hq => hq⟩

theorem MirCallContract.Subsumes.trans
    {c₁ c₂ c₃ : MirCallContract}
    (h₁₂ : MirCallContract.Subsumes c₁ c₂)
    (h₂₃ : MirCallContract.Subsumes c₂ c₃) :
    MirCallContract.Subsumes c₁ c₃ := by
  intro req hp₁
  rcases h₁₂ req hp₁ with ⟨hp₂, hq₁₂⟩
  rcases h₂₃ req hp₂ with ⟨hp₃, hq₂₃⟩
  exact ⟨hp₃, fun ans hq₃ => hq₁₂ ans (hq₂₃ ans hq₃)⟩

theorem MirCallContract.Subsumes.combine_left
    (c₁ c₂ : MirCallContract) :
    MirCallContract.Subsumes c₁ (combineMirCallContracts c₁ c₂) :=
  fun _ hp₁ => ⟨Or.inl hp₁, fun _ hq => hq.2.1 hp₁⟩

theorem MirCallContract.Subsumes.combine_right
    (c₁ c₂ : MirCallContract) :
    MirCallContract.Subsumes c₂ (combineMirCallContracts c₁ c₂) :=
  fun _ hp₂ => ⟨Or.inr hp₂, fun _ hq => hq.2.2 hp₂⟩

/-!
## 11. Decidable 5-Element MIR Fragment Lattice (`MirFragment`)

Kernel-checked 5-element bounded lattice classifying `CapturedMir` bodies by
their syntactic and borrow-free operational requirements:

1. **`MirFragment.pureLoopFree`** (`0`):
   Syntactically pure MIR with no index-order CFG back-edges
   (`hasCfgBackedge body = false`). Under the borrow-free layer
   (`checkBorrowFreeBodyFragment .pureLoopFree body`), equals
   `checkPureMir body && !hasCfgBackedge body`. When paired with runtime-phase
   and non-cleanup checks (`Anneal.MirLiftCore.checkMirLiftDagReady`), certifies
   strictly forward CFG transitions (`cfgEdge_lt_of_mirLiftDagReady`) and
   loop-rank-free backwards topological `LiftBlock` induction
   (`liftBlock_of_mirLiftDagReady_induct`).
2. **`MirFragment.pureBoundedLoop`** (`1`):
   Syntactically pure MIR permitting arbitrary pure `goto` / `switchInt` /
   `assert` / `drop` control-flow loops. Under the borrow-free layer
   (`checkBorrowFreeBodyFragment .pureBoundedLoop body`), equals
   `Anneal.PureMirExec.checkPureMir body`, enabling loop convergence proofs via
   `Anneal.MirLoops` (`mirWpConverges_whileRank` / `mirWpConverges_forRangeUp`)
   and the alias-erased loop bridges in `Anneal.MirLiftCore`
   (`checkMirLoopLiftReady` / `mirWpConverges_of_mirLoopLiftReady`).
3. **`MirFragment.treeBorrowsLocal`** (`2`):
   Extends `.pureBoundedLoop` with local references (`Rvalue.ref`), raw pointers
   (`Rvalue.rawPtr`), pointer dereferences (`ProjectionElem.deref`), unsafe
   binder projections (`ProjectionElem.unwrapUnsafeBinder`), deref copies
   (`Rvalue.copyForDeref`), in-bounds pointer offsets (`BinOp.offset`), local
   pointer casts (`CastKind.pointerCoercion`, `CastKind.ptrToPtr`), Tree Borrows
   retags (`StatementKind.retag`), and (under the borrow-free layer) relational
   `BinOp` comparisons on pointer-typed or untyped operands
   (`!hasNoPtrRelationalAssign body`).
4. **`MirFragment.intrinsicCopy`** (`3`):
   Extends `.treeBorrowsLocal` with non-overlapping bulk memory copies
   (`StatementKind.intrinsic (.copyNonOverlapping src dst count)`) and global
   constant allocations (`ConstValue.indirect`, `ConstValue.slice (.ptr ..)`),
   while excluding interprocedural calls and inline assembly.
5. **`MirFragment.fullMir`** (`4`):
   The complete `CapturedMir` grammar, admitting interprocedural calls
   (`TerminatorKind.call`, `TerminatorKind.tailCall`), inline assembly
   (`TerminatorKind.inlineAsm`), `CastKind.fnPtrToPtr`, provenance-exposing
   casts (`CastKind.pointerExposeProvenance`,
   `CastKind.pointerWithExposedProvenance`), `Rvalue.threadLocalRef`,
   `Rvalue.shallowInitBox`, and `StatementKind.backwardIncompatibleDropHint`.
-/

/-! ### 11A. The 5-Element Bounded Lattice (`MirFragment`) -/

/--
5-element total bounded lattice of Rust runtime MIR sub-grammars ordered by
syntactic and semantic expressiveness.
-/
inductive MirFragment : Type where
  /-- Loop-free alias-free pure MIR (`#mir_lift` / `PureMirExec` + DAG CFG). -/
  | pureLoopFree : MirFragment
  /-- Alias-free pure MIR with arbitrary control-flow loops (`PureMirExec` + `MirLoops`). -/
  | pureBoundedLoop : MirFragment
  /-- Intraprocedural Tree Borrows local reference/pointer/retag MIR (`SepLogicLenses`). -/
  | treeBorrowsLocal : MirFragment
  /-- Intraprocedural MIR with `copy_nonoverlapping` and global memory constants. -/
  | intrinsicCopy : MirFragment
  /-- Full runtime MIR including calls, provenance-exposing casts, and inline assembly. -/
  | fullMir : MirFragment
  deriving DecidableEq, Repr

/--
Fail-closed default: an unclassified body is only claimed to belong to `.fullMir`
(canonical fail-closed default for downstream Rust fragment classification).
-/
instance : Inhabited MirFragment := ⟨.fullMir⟩

namespace MirFragment

/-- Default `MirFragment` is `.fullMir` (fail-closed). -/
@[simp]
theorem default_eq_fullMir : (default : MirFragment) = .fullMir :=
  rfl

/-- Canonical `snake_case` identifier for serialized fragment metadata (e.g., `.anneal/spec-lock.json` target tag). -/
@[simp]
def asStr : MirFragment → String
  | .pureLoopFree => "pure_loop_free"
  | .pureBoundedLoop => "pure_bounded_loop"
  | .treeBorrowsLocal => "tree_borrows_local"
  | .intrinsicCopy => "intrinsic_copy"
  | .fullMir => "full_mir"

/-- Canonical qualified Lean constructor string for generated obligation modules. -/
@[simp]
def leanCtor : MirFragment → String
  | .pureLoopFree => "MirFragment.pureLoopFree"
  | .pureBoundedLoop => "MirFragment.pureBoundedLoop"
  | .treeBorrowsLocal => "MirFragment.treeBorrowsLocal"
  | .intrinsicCopy => "MirFragment.intrinsicCopy"
  | .fullMir => "MirFragment.fullMir"

/-- Parse a `MirFragment` from its exact `snake_case` or Lean constructor string. -/
def fromStr? : String → Option MirFragment
  | "pure_loop_free" | "MirFragment.pureLoopFree" | "pureLoopFree" => some .pureLoopFree
  | "pure_bounded_loop" | "MirFragment.pureBoundedLoop" | "pureBoundedLoop" =>
    some .pureBoundedLoop
  | "tree_borrows_local" | "MirFragment.treeBorrowsLocal" | "treeBorrowsLocal" =>
    some .treeBorrowsLocal
  | "intrinsic_copy" | "MirFragment.intrinsicCopy" | "intrinsicCopy" => some .intrinsicCopy
  | "full_mir" | "MirFragment.fullMir" | "fullMir" => some .fullMir
  | _ => none

instance : ToString MirFragment where
  toString := asStr

@[simp]
theorem fromStr?_asStr (f : MirFragment) : fromStr? f.asStr = some f := by
  cases f <;> rfl

@[simp]
theorem fromStr?_leanCtor (f : MirFragment) : fromStr? f.leanCtor = some f := by
  cases f <;> rfl

theorem asStr_injective {a b : MirFragment} (h : a.asStr = b.asStr) : a = b := by
  have h' : fromStr? a.asStr = fromStr? b.asStr := congrArg fromStr? h
  rw [fromStr?_asStr, fromStr?_asStr] at h'
  injection h'

theorem leanCtor_injective {a b : MirFragment} (h : a.leanCtor = b.leanCtor) : a = b := by
  have h' : fromStr? a.leanCtor = fromStr? b.leanCtor := congrArg fromStr? h
  rw [fromStr?_leanCtor, fromStr?_leanCtor] at h'
  injection h'

/-- `fromStr?` does not strip leading whitespace. -/
theorem fromStr?_leading_space_none : fromStr? " pure_loop_free" = none :=
  rfl

/-- Numeric rank in `0..=4` inducing the linear lattice order on `MirFragment`. -/
@[simp]
def toRank : MirFragment → Nat
  | .pureLoopFree => 0
  | .pureBoundedLoop => 1
  | .treeBorrowsLocal => 2
  | .intrinsicCopy => 3
  | .fullMir => 4

/-- Reconstruct a `MirFragment` from its numeric rank `0..=4`. -/
@[simp]
def ofRank? : Nat → Option MirFragment
  | 0 => some .pureLoopFree
  | 1 => some .pureBoundedLoop
  | 2 => some .treeBorrowsLocal
  | 3 => some .intrinsicCopy
  | 4 => some .fullMir
  | _ => none

@[simp]
theorem ofRank?_toRank (f : MirFragment) : ofRank? f.toRank = some f := by
  cases f <;> rfl

theorem toRank_lt_five (f : MirFragment) : f.toRank < 5 := by
  cases f <;> decide

theorem toRank_ofRank? {n : Nat} {f : MirFragment} (h : ofRank? n = some f) :
    f.toRank = n := by
  match n with
  | 0 => injection h with hf; subst hf; rfl
  | 1 => injection h with hf; subst hf; rfl
  | 2 => injection h with hf; subst hf; rfl
  | 3 => injection h with hf; subst hf; rfl
  | 4 => injection h with hf; subst hf; rfl
  | n' + 5 => cases h

/-- Exhaustive list of all 5 `MirFragment` levels in strictly ascending order. -/
def all : List MirFragment :=
  [.pureLoopFree, .pureBoundedLoop, .treeBorrowsLocal, .intrinsicCopy, .fullMir]

theorem mem_all (f : MirFragment) : f ∈ all := by
  cases f <;> decide

@[simp]
theorem length_all : all.length = 5 :=
  rfl

instance : LE MirFragment where
  le a b := a.toRank ≤ b.toRank

instance : LT MirFragment where
  lt a b := a.toRank < b.toRank

instance : DecidableRel (α := MirFragment) (· ≤ ·) :=
  fun a b => Nat.decLe a.toRank b.toRank

instance : DecidableRel (α := MirFragment) (· < ·) :=
  fun a b => Nat.decLt a.toRank b.toRank

/-- Bottom element of the `MirFragment` lattice (`.pureLoopFree`). -/
def bot : MirFragment := .pureLoopFree

/-- Top element of the `MirFragment` lattice (`.fullMir`). -/
def top : MirFragment := .fullMir

/-- Least upper bound (`a ⊔ b`) in the `MirFragment` lattice. -/
def join (a b : MirFragment) : MirFragment :=
  if a ≤ b then b else a

/-- Greatest lower bound (`a ⊓ b`) in the `MirFragment` lattice. -/
def meet (a b : MirFragment) : MirFragment :=
  if a ≤ b then a else b

theorem le_iff_toRank_le (a b : MirFragment) : a ≤ b ↔ a.toRank ≤ b.toRank :=
  Iff.rfl

theorem lt_iff_toRank_lt (a b : MirFragment) : a < b ↔ a.toRank < b.toRank :=
  Iff.rfl

theorem toRank_injective {a b : MirFragment} (h : a.toRank = b.toRank) : a = b := by
  cases a <;> cases b <;> first | rfl | contradiction

theorem le_refl (a : MirFragment) : a ≤ a := by
  cases a <;> decide

theorem le_trans {a b c : MirFragment} (hab : a ≤ b) (hbc : b ≤ c) : a ≤ c :=
  Nat.le_trans hab hbc

theorem le_antisymm {a b : MirFragment} (hab : a ≤ b) (hba : b ≤ a) : a = b :=
  toRank_injective (Nat.le_antisymm hab hba)

instance : Std.IsPreorder MirFragment where
  le_refl := le_refl
  le_trans _ _ _ := le_trans

instance : Std.IsPartialOrder MirFragment where
  le_antisymm _ _ := le_antisymm

theorem le_total (a b : MirFragment) : a ≤ b ∨ b ≤ a := by
  cases a <;> cases b <;> decide

theorem lt_iff_le_not_le (a b : MirFragment) : a < b ↔ a ≤ b ∧ ¬ b ≤ a := by
  cases a <;> cases b <;> decide

theorem not_le_iff_lt (a b : MirFragment) : ¬ a ≤ b ↔ b < a := by
  cases a <;> cases b <;> decide

theorem lt_irrefl (a : MirFragment) : ¬ a < a :=
  Nat.lt_irrefl a.toRank

theorem lt_trans {a b c : MirFragment} (hab : a < b) (hbc : b < c) : a < c :=
  Nat.lt_trans hab hbc

theorem lt_of_lt_of_le {a b c : MirFragment} (hab : a < b) (hbc : b ≤ c) : a < c :=
  Nat.lt_of_lt_of_le hab hbc

theorem lt_of_le_of_lt {a b c : MirFragment} (hab : a ≤ b) (hbc : b < c) : a < c :=
  Nat.lt_of_le_of_lt hab hbc

@[simp]
theorem bot_le (a : MirFragment) : bot ≤ a := by
  cases a <;> decide

@[simp]
theorem pureLoopFree_le (a : MirFragment) : .pureLoopFree ≤ a := by
  cases a <;> decide

@[simp]
theorem le_top (a : MirFragment) : a ≤ top := by
  cases a <;> decide

theorem le_join_left (a b : MirFragment) : a ≤ a.join b := by
  cases a <;> cases b <;> decide

theorem le_join_right (a b : MirFragment) : b ≤ a.join b := by
  cases a <;> cases b <;> decide

theorem join_le {a b c : MirFragment} (hac : a ≤ c) (hbc : b ≤ c) : a.join b ≤ c := by
  cases a <;> cases b <;> cases c <;> revert hac hbc <;> decide

theorem join_le_iff (a b c : MirFragment) : a.join b ≤ c ↔ a ≤ c ∧ b ≤ c := by
  cases a <;> cases b <;> cases c <;> decide

theorem join_comm (a b : MirFragment) : a.join b = b.join a := by
  cases a <;> cases b <;> rfl

theorem join_assoc (a b c : MirFragment) : (a.join b).join c = a.join (b.join c) := by
  cases a <;> cases b <;> cases c <;> rfl

@[simp]
theorem join_idem (a : MirFragment) : a.join a = a := by
  cases a <;> rfl

@[simp]
theorem bot_join (a : MirFragment) : bot.join a = a := by
  cases a <;> rfl

@[simp]
theorem join_bot (a : MirFragment) : a.join bot = a := by
  cases a <;> rfl

@[simp]
theorem pureLoopFree_join (a : MirFragment) : MirFragment.pureLoopFree.join a = a := by
  cases a <;> rfl

@[simp]
theorem join_pureLoopFree (a : MirFragment) : a.join .pureLoopFree = a := by
  cases a <;> rfl

@[simp]
theorem top_join (a : MirFragment) : top.join a = top := by
  cases a <;> rfl

@[simp]
theorem join_top (a : MirFragment) : a.join top = top := by
  cases a <;> rfl

@[simp]
theorem fullMir_join (a : MirFragment) : MirFragment.fullMir.join a = .fullMir := by
  cases a <;> rfl

@[simp]
theorem join_fullMir (a : MirFragment) : a.join .fullMir = .fullMir := by
  cases a <;> rfl

theorem meet_le_left (a b : MirFragment) : a.meet b ≤ a := by
  cases a <;> cases b <;> decide

theorem meet_le_right (a b : MirFragment) : a.meet b ≤ b := by
  cases a <;> cases b <;> decide

theorem le_meet {a b c : MirFragment} (hca : c ≤ a) (hcb : c ≤ b) : c ≤ a.meet b := by
  cases a <;> cases b <;> cases c <;> revert hca hcb <;> decide

theorem le_meet_iff (a b c : MirFragment) : c ≤ a.meet b ↔ c ≤ a ∧ c ≤ b := by
  cases a <;> cases b <;> cases c <;> decide

theorem meet_comm (a b : MirFragment) : a.meet b = b.meet a := by
  cases a <;> cases b <;> rfl

theorem meet_assoc (a b c : MirFragment) : (a.meet b).meet c = a.meet (b.meet c) := by
  cases a <;> cases b <;> cases c <;> rfl

@[simp]
theorem meet_idem (a : MirFragment) : a.meet a = a := by
  cases a <;> rfl

@[simp]
theorem bot_meet (a : MirFragment) : bot.meet a = bot := by
  cases a <;> rfl

@[simp]
theorem meet_bot (a : MirFragment) : a.meet bot = bot := by
  cases a <;> rfl

@[simp]
theorem pureLoopFree_meet (a : MirFragment) : MirFragment.pureLoopFree.meet a = .pureLoopFree := by
  cases a <;> rfl

@[simp]
theorem meet_pureLoopFree (a : MirFragment) : a.meet .pureLoopFree = .pureLoopFree := by
  cases a <;> rfl

@[simp]
theorem top_meet (a : MirFragment) : top.meet a = a := by
  cases a <;> rfl

@[simp]
theorem meet_top (a : MirFragment) : a.meet top = a := by
  cases a <;> rfl

@[simp]
theorem fullMir_meet (a : MirFragment) : MirFragment.fullMir.meet a = a := by
  cases a <;> rfl

@[simp]
theorem meet_fullMir (a : MirFragment) : a.meet .fullMir = a := by
  cases a <;> rfl

theorem join_meet_self (a b : MirFragment) : a.join (a.meet b) = a := by
  cases a <;> cases b <;> rfl

theorem meet_join_self (a b : MirFragment) : a.meet (a.join b) = a := by
  cases a <;> cases b <;> rfl

theorem join_meet_distrib_left (a b c : MirFragment) :
    a.join (b.meet c) = (a.join b).meet (a.join c) := by
  cases a <;> cases b <;> cases c <;> rfl

theorem meet_join_distrib_left (a b c : MirFragment) :
    a.meet (b.join c) = (a.meet b).join (a.meet c) := by
  cases a <;> cases b <;> cases c <;> rfl

/-- Kernel-checked `simp`-set confluence regression over `bot`, `top`, `join`, and `meet`. -/
theorem simp_confluence (a : MirFragment) :
    bot.join a = a ∧
    a.join bot = a ∧
    top.join a = top ∧
    a.join top = top ∧
    bot.meet a = bot ∧
    a.meet bot = bot ∧
    top.meet a = a ∧
    a.meet top = a ∧
    a.join a = a ∧
    a.meet a = a := by
  simp

end MirFragment

/-! ### 11B. CFG Successor Extraction, Back-Edge Analysis & DAG Acyclicity -/

/-- Extract control-flow target basic-block index from an `UnwindAction`. -/
def unwindTargets : UnwindAction → List BasicBlockIdx
  | .cleanup cleanupBlock => [cleanupBlock]
  | .unreachable => []
  | .terminate => []
  | .continue_ => []

/--
Extract all outgoing control-flow target basic-block indices from a
`TerminatorKind`, matching `extract_terminator_targets` in
`crates/cargo-anneal/src/scaffold.rs` 1-to-1.
-/
def terminatorTargets : TerminatorKind → List BasicBlockIdx
  | .goto target => [target]
  | .switchInt _ targets => targets.branches.map Prod.snd ++ [targets.otherwise]
  | .unwindResume => []
  | .unwindTerminate => []
  | .return_ => []
  | .unreachable => []
  | .drop _ target unwind => target :: unwindTargets unwind
  | .call _ _ _ target unwind =>
    (match target with | some t => [t] | none => []) ++ unwindTargets unwind
  | .tailCall _ _ => []
  | .assert _ _ target unwind => target :: unwindTargets unwind
  | .inlineAsm _ targets unwind => targets ++ unwindTargets unwind

/-- Outgoing CFG successor basic-block indices of a `BasicBlockData`. -/
def blockTargets (bb : BasicBlockData) : List BasicBlockIdx :=
  terminatorTargets bb.terminator.kind

/--
True iff basic block `bb` at 0-based index `bbIdx` has at least one outgoing
edge to a target `succ ≤ bbIdx` (a self-loop or backward jump in index order).
-/
def hasBlockBackedge (bbIdx : BasicBlockIdx) (bb : BasicBlockData) : Bool :=
  (blockTargets bb).any (fun succ => decide (succ ≤ bbIdx))

/-- Helper scanning a suffix of `body.basicBlocks` starting at 0-based index `bbIdx`. -/
def hasCfgBackedgeAux : BasicBlockIdx → List BasicBlockData → Bool
  | _, [] => false
  | bbIdx, bb :: rest =>
    hasBlockBackedge bbIdx bb || hasCfgBackedgeAux (bbIdx + 1) rest

/--
Computable $O(|B|)$ index-order CFG back-edge detector on `body : CapturedMir`,
matching `detect_blocks_and_back_edges` in `crates/cargo-anneal/src/scaffold.rs`.
-/
def hasCfgBackedge (body : CapturedMir) : Bool :=
  hasCfgBackedgeAux 0 body.basicBlocks

/-- Directed control-flow edge `u → v` in `body.basicBlocks`. -/
def CfgEdge (body : CapturedMir) (u v : BasicBlockIdx) : Prop :=
  ∃ bb, Trusted.Sequence.get? body.basicBlocks u = some bb ∧ v ∈ blockTargets bb

/-- Non-empty directed control-flow path `u →⁺ v` in `body.basicBlocks`. -/
inductive CfgPath (body : CapturedMir) : BasicBlockIdx → BasicBlockIdx → Prop where
  | single {u v : BasicBlockIdx} : CfgEdge body u v → CfgPath body u v
  | step {u v w : BasicBlockIdx} :
      CfgEdge body u v → CfgPath body v w → CfgPath body u w

theorem hasBlockBackedge_false_of_hasCfgBackedgeAux_false
    {start : Nat} {bbs : List BasicBlockData} {offset : Nat} {bb : BasicBlockData}
    (h_no : hasCfgBackedgeAux start bbs = false)
    (h_get : Trusted.Sequence.get? bbs offset = some bb) :
    hasBlockBackedge (start + offset) bb = false := by
  induction bbs generalizing start offset with
  | nil => cases h_get
  | cons hd tl ih =>
    simp only [hasCfgBackedgeAux, Bool.or_eq_false_iff] at h_no
    cases offset with
    | zero =>
      cases h_get
      simp only [Nat.add_zero]
      exact h_no.1
    | succ offset' =>
      have h_step := ih h_no.2 h_get
      have h_arith : start + 1 + offset' = start + (offset' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 offset', ← Nat.add_assoc]
      rw [← h_arith]
      exact h_step

/--
Every CFG edge `u → v` in a body with `hasCfgBackedge body = false` strictly
increases the basic-block index (`u < v`).
-/
theorem cfgEdge_lt_of_hasCfgBackedge_false
    {body : CapturedMir} {u v : BasicBlockIdx}
    (h_no : hasCfgBackedge body = false)
    (h_edge : CfgEdge body u v) :
    u < v := by
  rcases h_edge with ⟨bb, h_get, h_mem⟩
  have h_blk : hasBlockBackedge u bb = false := by
    have h0 := hasBlockBackedge_false_of_hasCfgBackedgeAux_false h_no h_get
    simpa [Nat.zero_add] using h0
  simp only [hasBlockBackedge, List.any_eq_false] at h_blk
  have h_not_le := h_blk v h_mem
  simp only [decide_eq_true_eq] at h_not_le
  exact Nat.lt_of_not_le h_not_le

/--
Every non-empty directed CFG path `u →⁺ v` in a body with
`hasCfgBackedge body = false` strictly increases the basic-block index (`u < v`).
-/
theorem cfgPath_lt_of_hasCfgBackedge_false
    {body : CapturedMir} {u v : BasicBlockIdx}
    (h_no : hasCfgBackedge body = false)
    (h_path : CfgPath body u v) :
    u < v := by
  induction h_path with
  | single h_edge => exact cfgEdge_lt_of_hasCfgBackedge_false h_no h_edge
  | step h_edge _ ih =>
    exact Nat.lt_trans (cfgEdge_lt_of_hasCfgBackedge_false h_no h_edge) ih

/--
**Soundness of `hasCfgBackedge = false` for General DAG Acyclicity**:
If `hasCfgBackedge body = false`, then `body`'s control-flow graph is strictly
acyclic (`∀ u, ¬ CfgPath body u u`).
-/
theorem no_cfg_cycle_of_hasCfgBackedge_false
    {body : CapturedMir}
    (h_no : hasCfgBackedge body = false)
    (u : BasicBlockIdx) :
    ¬ CfgPath body u u := by
  intro h_cycle
  have h_lt := cfgPath_lt_of_hasCfgBackedge_false h_no h_cycle
  exact Nat.lt_irrefl u h_lt

theorem exists_backedge_of_hasCfgBackedgeAux
    {start : Nat} {bbs : List BasicBlockData}
    (h : hasCfgBackedgeAux start bbs = true) :
    ∃ off bb v, Trusted.Sequence.get? bbs off = some bb ∧
      v ∈ blockTargets bb ∧ v ≤ start + off := by
  induction bbs generalizing start with
  | nil => simp [hasCfgBackedgeAux] at h
  | cons hd tl ih =>
    simp only [hasCfgBackedgeAux, Bool.or_eq_true] at h
    rcases h with h_hd | h_tl
    · simp only [hasBlockBackedge, List.any_eq_true, decide_eq_true_eq] at h_hd
      obtain ⟨v, h_mem, h_le⟩ := h_hd
      exact ⟨0, hd, v, rfl, h_mem, h_le⟩
    · obtain ⟨off, bb, v, h_get, h_mem, h_le⟩ := ih h_tl
      refine ⟨off + 1, bb, v, h_get, h_mem, ?_⟩
      have h_eq : start + 1 + off = start + (off + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 off, ← Nat.add_assoc]
      rw [← h_eq]
      exact h_le

/--
**Exact specification of `hasCfgBackedge`**:
`hasCfgBackedge body = true` iff some CFG edge `u → v` of `body` satisfies
`v ≤ u` (a self-loop or jump to a non-increasing block index).
-/
theorem hasCfgBackedge_eq_true_iff (body : CapturedMir) :
    hasCfgBackedge body = true ↔ ∃ u v, CfgEdge body u v ∧ v ≤ u := by
  constructor
  · intro h
    obtain ⟨off, bb, v, h_get, h_mem, h_le⟩ := exists_backedge_of_hasCfgBackedgeAux h
    rw [Nat.zero_add] at h_le
    exact ⟨off, v, ⟨bb, h_get, h_mem⟩, h_le⟩
  · rintro ⟨u, v, h_edge, h_le⟩
    cases h_b : hasCfgBackedge body
    · exact absurd h_le (Nat.not_le_of_lt (cfgEdge_lt_of_hasCfgBackedge_false h_b h_edge))
    · rfl

/--
**Exact forward-numbering characterization of `hasCfgBackedge = false`**:
`hasCfgBackedge body = false` iff every CFG edge `u → v` of `body` strictly
increases basic-block index (`u < v`).
-/
theorem hasCfgBackedge_eq_false_iff (body : CapturedMir) :
    hasCfgBackedge body = false ↔ ∀ u v, CfgEdge body u v → u < v := by
  constructor
  · intro h u v h_edge
    exact cfgEdge_lt_of_hasCfgBackedge_false h h_edge
  · intro h_lt
    cases h_b : hasCfgBackedge body
    · rfl
    · obtain ⟨u, v, h_edge, h_le⟩ := (hasCfgBackedge_eq_true_iff body).mp h_b
      exact absurd h_le (Nat.not_le_of_lt (h_lt u v h_edge))

/-- The source block of every CFG edge is an in-range block index. -/
theorem lt_length_of_cfgEdge {body : CapturedMir} {u v : BasicBlockIdx}
    (h : CfgEdge body u v) : u < body.basicBlocks.length := by
  rcases h with ⟨bb, h_get, _⟩
  exact (List.getElem?_eq_some_iff.mp h_get).1

/-- The source block of every non-empty CFG path is an in-range block index. -/
theorem lt_length_of_cfgPath {body : CapturedMir} {u v : BasicBlockIdx}
    (h : CfgPath body u v) : u < body.basicBlocks.length := by
  cases h with
  | single h_edge => exact lt_length_of_cfgEdge h_edge
  | step h_edge _ => exact lt_length_of_cfgEdge h_edge

/--
True iff block `bb` at index `u` has an in-range edge `u → v` (`v < n`) that
violates `rank` (`rank v ≤ rank u`).
-/
def hasBlockRankViolation (rank : Nat → Nat) (n u : Nat) (bb : BasicBlockData) : Bool :=
  (blockTargets bb).any (fun v => decide (v < n) && decide (rank v ≤ rank u))

/-- Helper scanning a suffix of `body.basicBlocks` starting at 0-based index `u`. -/
def hasRankViolationAux (rank : Nat → Nat) (n : Nat) : Nat → List BasicBlockData → Bool
  | _, [] => false
  | u, bb :: rest => hasBlockRankViolation rank n u bb || hasRankViolationAux rank n (u + 1) rest

/-- True iff some in-range CFG edge `u → v` of `body` has `rank v ≤ rank u`. -/
def hasRankViolation (rank : Nat → Nat) (body : CapturedMir) : Bool :=
  hasRankViolationAux rank body.basicBlocks.length 0 body.basicBlocks

theorem hasBlockRankViolation_false_of_hasRankViolationAux_false
    {rank : Nat → Nat} {n start : Nat} {bbs : List BasicBlockData} {off : Nat}
    {bb : BasicBlockData}
    (h_no : hasRankViolationAux rank n start bbs = false)
    (h_get : Trusted.Sequence.get? bbs off = some bb) :
    hasBlockRankViolation rank n (start + off) bb = false := by
  induction bbs generalizing start off with
  | nil => cases h_get
  | cons hd tl ih =>
    simp only [hasRankViolationAux, Bool.or_eq_false_iff] at h_no
    cases off with
    | zero =>
      cases h_get
      simpa using h_no.1
    | succ off' =>
      have h_step := ih h_no.2 h_get
      have h_arith : start + 1 + off' = start + (off' + 1) := by
        rw [Nat.add_assoc, Nat.add_comm 1 off', ← Nat.add_assoc]
      rw [← h_arith]
      exact h_step

/-- A violation-free `rank` strictly increases along every in-range CFG edge. -/
theorem cfgEdge_rank_lt_of_hasRankViolation_false
    {rank : Nat → Nat} {body : CapturedMir} {u v : BasicBlockIdx}
    (h_no : hasRankViolation rank body = false)
    (h_edge : CfgEdge body u v) (h_v : v < body.basicBlocks.length) :
    rank u < rank v := by
  rcases h_edge with ⟨bb, h_get, h_mem⟩
  have h_blk := hasBlockRankViolation_false_of_hasRankViolationAux_false (start := 0) h_no h_get
  simp only [Nat.zero_add, hasBlockRankViolation, List.any_eq_false, Bool.and_eq_true,
    decide_eq_true_eq, not_and] at h_blk
  exact Nat.lt_of_not_le (h_blk v h_mem h_v)

/-- A violation-free `rank` strictly increases along every CFG path into an in-range block. -/
theorem cfgPath_rank_lt_of_hasRankViolation_false
    {rank : Nat → Nat} {body : CapturedMir} {u w : BasicBlockIdx}
    (h_no : hasRankViolation rank body = false)
    (h_path : CfgPath body u w) (h_w : w < body.basicBlocks.length) :
    rank u < rank w := by
  induction h_path with
  | single h_edge => exact cfgEdge_rank_lt_of_hasRankViolation_false h_no h_edge h_w
  | step h_edge h_rest ih =>
    exact Nat.lt_trans
      (cfgEdge_rank_lt_of_hasRankViolation_false h_no h_edge (lt_length_of_cfgPath h_rest))
      (ih h_w)

/--
**Rank-certificate soundness**: for ANY `rank : Nat → Nat`, if no in-range CFG
edge violates `rank`, then `body`'s CFG has no directed cycle.
-/
theorem no_cfg_cycle_of_hasRankViolation_false
    {rank : Nat → Nat} {body : CapturedMir}
    (h_no : hasRankViolation rank body = false) (u : BasicBlockIdx) :
    ¬ CfgPath body u u := by
  intro h_cycle
  exact Nat.lt_irrefl _
    (cfgPath_rank_lt_of_hasRankViolation_false h_no h_cycle (lt_length_of_cfgPath h_cycle))

theorem hasRankViolationAux_id_eq_hasCfgBackedgeAux {n : Nat} :
    ∀ (u : Nat) (bbs : List BasicBlockData), u + bbs.length ≤ n →
      hasRankViolationAux (fun i => i) n u bbs = hasCfgBackedgeAux u bbs
  | _, [], _ => rfl
  | u, bb :: rest, h_len => by
    have h_len_eq : u + (rest.length + 1) = u + 1 + rest.length := by
      rw [Nat.add_assoc, Nat.add_comm rest.length 1, ← Nat.add_assoc]
    have h_len' : u + 1 + rest.length ≤ n := by
      simp only [List.length_cons] at h_len
      rwa [h_len_eq] at h_len
    have h_u : u < n :=
      Nat.lt_of_lt_of_le
        (Nat.lt_of_lt_of_le (Nat.lt_succ_self u) (Nat.le_add_right (u + 1) rest.length))
        h_len'
    simp only [hasRankViolationAux, hasCfgBackedgeAux,
      hasRankViolationAux_id_eq_hasCfgBackedgeAux (u + 1) rest h_len']
    congr 1
    simp only [hasBlockRankViolation, hasBlockBackedge]
    congr 1
    funext v
    cases h : decide (v ≤ u)
    · simp
    · have h_lt : v < n := Nat.lt_of_le_of_lt (of_decide_eq_true h) h_u
      simp [h_lt]

/--
`hasCfgBackedge` is the identity-rank instance (`rank = id`) of `hasRankViolation`.
-/
theorem hasRankViolation_id_eq_hasCfgBackedge (body : CapturedMir) :
    hasRankViolation (fun i => i) body = hasCfgBackedge body :=
  hasRankViolationAux_id_eq_hasCfgBackedgeAux 0 body.basicBlocks (by simp)

/--
Every MIR body without an index-order back-edge (`hasCfgBackedge body = false`)
admits an explicit violation-free rank certificate (`rank = id`).
-/
theorem exists_rank_certificate_of_hasCfgBackedge_false
    {body : CapturedMir} (h : hasCfgBackedge body = false) :
    ∃ rank : Nat → Nat, hasRankViolation rank body = false :=
  ⟨fun i => i, (hasRankViolation_id_eq_hasCfgBackedge body).trans h⟩

/-- In-range CFG edges `(u, v)` (`v < n`) of a suffix of `body.basicBlocks` starting at `u`. -/
def cfgEdgeListAux (n : Nat) : Nat → List BasicBlockData → List (Nat × Nat)
  | _, [] => []
  | u, bb :: rest =>
    ((blockTargets bb).filter (fun v => decide (v < n))).map (fun v => (u, v)) ++
      cfgEdgeListAux n (u + 1) rest

/-- All in-range CFG edges of `body`. -/
def cfgEdgeList (body : CapturedMir) : List (Nat × Nat) :=
  cfgEdgeListAux body.basicBlocks.length 0 body.basicBlocks

/-- One Bellman-Ford longest-path relaxation round over `edges`. -/
def relaxRanks (edges : List (Nat × Nat)) (ranks : List Nat) : List Nat :=
  edges.foldl (fun rs e => rs.set e.2 (max (rs.getD e.2 0) (rs.getD e.1 0 + 1))) ranks

/--
Longest-path ranks after `n = body.basicBlocks.length` relaxation rounds. On an
acyclic CFG these are the exact longest-path depths (strictly increasing along
every in-range edge); on a cyclic CFG some edge of every cycle violates them.
-/
def dagRanks (body : CapturedMir) : List Nat :=
  Nat.repeat (relaxRanks (cfgEdgeList body)) body.basicBlocks.length
    (List.replicate body.basicBlocks.length 0)

/-- Rank function induced by `dagRanks` (`0` outside the block range). -/
def dagRank (body : CapturedMir) (i : Nat) : Nat :=
  (dagRanks body).getD i 0

/--
Computable general CFG acyclicity check: `true` iff the longest-path ranks of
`body` certify that every in-range edge strictly increases rank.
-/
def isCfgDag (body : CapturedMir) : Bool :=
  !hasRankViolation (dagRank body) body

/-- **Soundness of `isCfgDag`**: `isCfgDag body = true` rules out every directed CFG cycle. -/
theorem no_cfg_cycle_of_isCfgDag {body : CapturedMir}
    (h : isCfgDag body = true) (u : BasicBlockIdx) :
    ¬ CfgPath body u u := by
  have h_no : hasRankViolation (dagRank body) body = false := by
    simpa [isCfgDag] using h
  exact no_cfg_cycle_of_hasRankViolation_false h_no u

/-- Every `isCfgDag body = true` body yields an explicit violation-free rank certificate (`dagRank body`). -/
theorem exists_rank_certificate_of_isCfgDag {body : CapturedMir}
    (h : isCfgDag body = true) :
    ∃ rank : Nat → Nat, hasRankViolation rank body = false := by
  refine ⟨dagRank body, ?_⟩
  simpa [isCfgDag] using h

/-- Existential rank-certificate soundness: any violation-free rank certificate rules out all CFG cycles. -/
theorem no_cfg_cycle_of_exists_rank_certificate {body : CapturedMir}
    (h : ∃ rank : Nat → Nat, hasRankViolation rank body = false) (u : BasicBlockIdx) :
    ¬ CfgPath body u u := by
  rcases h with ⟨rank, h_no⟩
  exact no_cfg_cycle_of_hasRankViolation_false h_no u

/-! ### 11C. Per-Construct Syntactic Fragment Checkers (`basicBlocks` Only) -/

/--
Check whether `cv : ConstValue` belongs to fragment `f`:
- `.zeroSized`, `.scalar _`, `.slice (.int _) _`, and `.unevaluated _` belong to
  all fragments (`.pureLoopFree` and above), matching `isPureConstValue`.
- `.slice (.ptr _ _) _` and `.indirect _ _` reference global memory allocations
  and require at least `.intrinsicCopy`.
-/
def checkConstFragment (f : MirFragment) : ConstValue → Bool
  | .zeroSized => true
  | .scalar _ => true
  | .slice (.int _) _ => true
  | .slice (.ptr _ _) _ => decide (MirFragment.intrinsicCopy ≤ f)
  | .indirect _ _ => decide (MirFragment.intrinsicCopy ≤ f)
  | .unevaluated _ => true

/--
Check whether `pe : ProjectionElem` belongs to fragment `f`:
- Value projections (`.field`, `.index`, `.constantIndex`, `.subslice`,
  `.downcast`) belong to all fragments (`.pureLoopFree` and above), matching
  `isPureProjElem`.
- Pointer dereference (`.deref`) and the type-changing projections
  (`.unwrapUnsafeBinder`, `.opaqueCast`) require at least `.treeBorrowsLocal`.
-/
def checkProjElemFragment (f : MirFragment) : ProjectionElem → Bool
  | .deref => decide (MirFragment.treeBorrowsLocal ≤ f)
  | .field _ _ => true
  | .index _ => true
  | .constantIndex .. => true
  | .subslice .. => true
  | .downcast _ _ => true
  | .opaqueCast _ => decide (MirFragment.treeBorrowsLocal ≤ f)
  | .unwrapUnsafeBinder _ => decide (MirFragment.treeBorrowsLocal ≤ f)

/-- Check whether every projection element in `p : Place` belongs to fragment `f`. -/
def checkPlaceFragment (f : MirFragment) (p : Place) : Bool :=
  p.projection.all (checkProjElemFragment f)

/-- Check whether `op : Operand` belongs to fragment `f`. -/
def checkOperandFragment (f : MirFragment) : Operand → Bool
  | .copy p => checkPlaceFragment f p
  | .move p => checkPlaceFragment f p
  | .constant c => checkConstFragment f c.val

/--
Check whether `op : BinOp` belongs to fragment `f`:
- `BinOp.offset` (in-bounds pointer arithmetic reading `mem.borrows`) requires
  at least `.treeBorrowsLocal`.
- All 25 scalar arithmetic, bitwise, shift, and comparison operators belong to
  all fragments (`.pureLoopFree` and above), matching `isPureBinOp`.
-/
def checkBinOpFragment (f : MirFragment) : BinOp → Bool
  | .offset => decide (MirFragment.treeBorrowsLocal ≤ f)
  | .add | .addUnchecked | .addWithOverflow
  | .sub | .subUnchecked | .subWithOverflow
  | .mul | .mulUnchecked | .mulWithOverflow
  | .div | .rem
  | .bitXor | .bitAnd | .bitOr
  | .shl | .shlUnchecked | .shr | .shrUnchecked
  | .eq | .lt | .le | .ne | .ge | .gt | .cmp => true

/--
Check whether `ck : CastKind` belongs to fragment `f`:
- `.pointerCoercion _` and `.ptrToPtr` require at least `.treeBorrowsLocal`.
- `.fnPtrToPtr`, `.pointerExposeProvenance`, and `.pointerWithExposedProvenance`
  require `.fullMir` (matching `Anneal.PureMirExec.isPureRvalue`, which rejects
  all five pointer/provenance cast kinds).
- Scalar/value casts (`.intToInt`, `.floatToInt`, `.floatToFloat`, `.intToFloat`,
  `.transmute`, `.subtype`) belong to `.pureLoopFree` and above.
-/
def checkCastFragment (f : MirFragment) : CastKind → Bool
  | .pointerCoercion _ => decide (MirFragment.treeBorrowsLocal ≤ f)
  | .ptrToPtr => decide (MirFragment.treeBorrowsLocal ≤ f)
  | .fnPtrToPtr => decide (MirFragment.fullMir ≤ f)
  | .pointerExposeProvenance => decide (MirFragment.fullMir ≤ f)
  | .pointerWithExposedProvenance => decide (MirFragment.fullMir ≤ f)
  | .intToInt
  | .floatToInt
  | .floatToFloat
  | .intToFloat
  | .transmute
  | .subtype => true

/--
Check whether `rv : Rvalue` belongs to fragment `f`:
- Value operations on valid operands/places belong to `.pureLoopFree` and above.
- Local borrow/address creation (`.ref`, `.rawPtr`) and `.copyForDeref` require
  at least `.treeBorrowsLocal`.
- `.threadLocalRef` and `.shallowInitBox` require `.fullMir`.
-/
def checkRvalueFragment (f : MirFragment) : Rvalue → Bool
  | .use op => checkOperandFragment f op
  | .repeat op _ => checkOperandFragment f op
  | .ref _ p => decide (MirFragment.treeBorrowsLocal ≤ f) && checkPlaceFragment f p
  | .rawPtr _ p => decide (MirFragment.treeBorrowsLocal ≤ f) && checkPlaceFragment f p
  | .threadLocalRef _ => decide (MirFragment.fullMir ≤ f)
  | .len p => checkPlaceFragment f p
  | .cast ck op _ => checkCastFragment f ck && checkOperandFragment f op
  | .binaryOp op lhs rhs =>
    checkBinOpFragment f op && (checkOperandFragment f lhs && checkOperandFragment f rhs)
  | .nullaryOp _ _ => true
  | .unaryOp _ op => checkOperandFragment f op
  | .discriminant p => checkPlaceFragment f p
  | .aggregate _ ops => ops.all (checkOperandFragment f)
  | .shallowInitBox op _ => decide (MirFragment.fullMir ≤ f) && checkOperandFragment f op
  | .copyForDeref p => decide (MirFragment.treeBorrowsLocal ≤ f) && checkPlaceFragment f p
  | .wrapUnsafeBinder op _ => checkOperandFragment f op

/--
Check whether `sk : StatementKind` belongs to fragment `f`:
- Standard value statements and `.intrinsic (.assume op)` belong to
  `.pureLoopFree` and above when their places/operands belong to `f`.
- `.retag` requires at least `.treeBorrowsLocal`.
- `.intrinsic (.copyNonOverlapping src dst count)` requires at least
  `.intrinsicCopy`.
- `.backwardIncompatibleDropHint` requires `.fullMir`.
-/
def checkStmtFragment (f : MirFragment) : StatementKind → Bool
  | .assign p r => checkPlaceFragment f p && checkRvalueFragment f r
  | .setDiscriminant p _ => checkPlaceFragment f p
  | .storageLive _ => true
  | .storageDead _ => true
  | .nop => true
  | .coverage => true
  | .constEvalCounter => true
  | .placeMention p => checkPlaceFragment f p
  | .deinit p => checkPlaceFragment f p
  | .intrinsic (.assume op) => checkOperandFragment f op
  | .intrinsic (.copyNonOverlapping src dst count) =>
    decide (MirFragment.intrinsicCopy ≤ f) &&
      checkOperandFragment f src &&
      checkOperandFragment f dst &&
      checkOperandFragment f count
  | .retag _ p => decide (MirFragment.treeBorrowsLocal ≤ f) && checkPlaceFragment f p
  | .backwardIncompatibleDropHint p =>
    decide (MirFragment.fullMir ≤ f) && checkPlaceFragment f p

/--
Check whether `tk : TerminatorKind` belongs to fragment `f`:
- Intraprocedural control-flow terminators (`.goto`, `.switchInt`, `.return_`,
  `.assert`, `.drop`, `.unreachable`, `.unwindResume`, `.unwindTerminate`)
  belong to `.pureLoopFree` and above when their operands/places belong to `f`.
- `.call`, `.tailCall`, and `.inlineAsm` require `.fullMir`.
-/
def checkTerminatorFragment (f : MirFragment) : TerminatorKind → Bool
  | .goto _ => true
  | .switchInt discr _ => checkOperandFragment f discr
  | .return_ => true
  | .assert cond _ _ _ => checkOperandFragment f cond
  | .drop p _ _ => checkPlaceFragment f p
  | .unreachable => true
  | .unwindResume => true
  | .unwindTerminate => true
  | .call func args dest _ _ =>
    decide (MirFragment.fullMir ≤ f) &&
      checkOperandFragment f func &&
      args.all (checkOperandFragment f) &&
      checkPlaceFragment f dest
  | .tailCall func args =>
    decide (MirFragment.fullMir ≤ f) &&
      checkOperandFragment f func &&
      args.all (checkOperandFragment f)
  | .inlineAsm _ _ _ => decide (MirFragment.fullMir ≤ f)

/-- Check whether all statements and the terminator of `bb : BasicBlockData` belong to `f`. -/
def checkBlockFragment (f : MirFragment) (bb : BasicBlockData) : Bool :=
  bb.statements.all (fun stmt => checkStmtFragment f stmt.kind) &&
  checkTerminatorFragment f bb.terminator.kind

/--
Computable $O(|B|)$ syntactic fragment membership checker over `body.basicBlocks`
(the `basicBlocks`-only syntactic specification targeted by Episode 2's Rust
fragment scanner, invariant under arbitrary `CapturedMir.instantiate`):
- For `.pureLoopFree`, requires every basic block to satisfy
  `checkBlockFragment .pureLoopFree` AND `hasCfgBackedge body = false`.
- For all `f ≥ .pureBoundedLoop`, requires every basic block to satisfy
  `checkBlockFragment f`.
-/
def checkBodyFragment (f : MirFragment) (body : CapturedMir) : Bool :=
  match f with
  | .pureLoopFree =>
    body.basicBlocks.all (checkBlockFragment .pureLoopFree) && !hasCfgBackedge body
  | .pureBoundedLoop =>
    body.basicBlocks.all (checkBlockFragment .pureBoundedLoop)
  | .treeBorrowsLocal =>
    body.basicBlocks.all (checkBlockFragment .treeBorrowsLocal)
  | .intrinsicCopy =>
    body.basicBlocks.all (checkBlockFragment .intrinsicCopy)
  | .fullMir =>
    body.basicBlocks.all (checkBlockFragment .fullMir)

/--
Computable $O(|B|)$ syntactic minimum fragment classifier returning the least
`MirFragment` in the 5-element lattice whose `checkBodyFragment` accepts `body`.
-/
def inferMinFragment (body : CapturedMir) : MirFragment :=
  if checkBodyFragment .pureLoopFree body then .pureLoopFree
  else if checkBodyFragment .pureBoundedLoop body then .pureBoundedLoop
  else if checkBodyFragment .treeBorrowsLocal body then .treeBorrowsLocal
  else if checkBodyFragment .intrinsicCopy body then .intrinsicCopy
  else .fullMir

/-! ### 11D. Monotonicity, Totality & Galois Lower-Adjoint Minimality -/

theorem checkConstFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (cv : ConstValue) (h : checkConstFragment f₁ cv = true) :
    checkConstFragment f₂ cv = true := by
  cases cv with
  | zeroSized | scalar _ | unevaluated _ => rfl
  | slice sc _ =>
    cases sc with
    | int _ => rfl
    | ptr _ _ =>
      simp only [checkConstFragment, decide_eq_true_eq] at h ⊢
      exact MirFragment.le_trans h hle
  | indirect _ _ =>
    simp only [checkConstFragment, decide_eq_true_eq] at h ⊢
    exact MirFragment.le_trans h hle

theorem checkProjElemFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (pe : ProjectionElem) (h : checkProjElemFragment f₁ pe = true) :
    checkProjElemFragment f₂ pe = true := by
  cases pe <;> simp only [checkProjElemFragment, decide_eq_true_eq] at h ⊢
  all_goals first | trivial | exact MirFragment.le_trans h hle

theorem checkPlaceFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (p : Place) (h : checkPlaceFragment f₁ p = true) :
    checkPlaceFragment f₂ p = true :=
  list_all_mono (checkProjElemFragment_mono hle) h

theorem checkOperandFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (op : Operand) (h : checkOperandFragment f₁ op = true) :
    checkOperandFragment f₂ op = true := by
  cases op with
  | copy p | move p => exact checkPlaceFragment_mono hle p h
  | constant c => exact checkConstFragment_mono hle c.val h

theorem checkBinOpFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (op : BinOp) (h : checkBinOpFragment f₁ op = true) :
    checkBinOpFragment f₂ op = true := by
  cases op <;> simp only [checkBinOpFragment, decide_eq_true_eq] at h ⊢
  all_goals first | trivial | exact MirFragment.le_trans h hle

theorem checkCastFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (ck : CastKind) (h : checkCastFragment f₁ ck = true) :
    checkCastFragment f₂ ck = true := by
  cases ck <;> simp only [checkCastFragment, decide_eq_true_eq] at h ⊢
  all_goals first | trivial | exact MirFragment.le_trans h hle

theorem checkRvalueFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (rv : Rvalue) (h : checkRvalueFragment f₁ rv = true) :
    checkRvalueFragment f₂ rv = true := by
  cases rv with
  | use op | «repeat» op _ | unaryOp _ op | wrapUnsafeBinder op _ =>
    exact checkOperandFragment_mono hle op h
  | len p | discriminant p =>
    exact checkPlaceFragment_mono hle p h
  | nullaryOp _ _ => rfl
  | ref _ p | rawPtr _ p | copyForDeref p =>
    simp only [checkRvalueFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨MirFragment.le_trans h.1 hle, checkPlaceFragment_mono hle p h.2⟩
  | threadLocalRef _ =>
    simp only [checkRvalueFragment, decide_eq_true_eq] at h ⊢
    exact MirFragment.le_trans h hle
  | cast ck op _ =>
    simp only [checkRvalueFragment, Bool.and_eq_true] at h ⊢
    exact ⟨checkCastFragment_mono hle ck h.1, checkOperandFragment_mono hle op h.2⟩
  | binaryOp op lhs rhs =>
    simp only [checkRvalueFragment, Bool.and_eq_true] at h ⊢
    exact ⟨checkBinOpFragment_mono hle op h.1,
      checkOperandFragment_mono hle lhs h.2.1,
      checkOperandFragment_mono hle rhs h.2.2⟩
  | aggregate _ ops =>
    exact list_all_mono (checkOperandFragment_mono hle) h
  | shallowInitBox op _ =>
    simp only [checkRvalueFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨MirFragment.le_trans h.1 hle, checkOperandFragment_mono hle op h.2⟩

theorem checkStmtFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (sk : StatementKind) (h : checkStmtFragment f₁ sk = true) :
    checkStmtFragment f₂ sk = true := by
  cases sk with
  | assign p r =>
    simp only [checkStmtFragment, Bool.and_eq_true] at h ⊢
    exact ⟨checkPlaceFragment_mono hle p h.1, checkRvalueFragment_mono hle r h.2⟩
  | setDiscriminant p _ | placeMention p | deinit p =>
    exact checkPlaceFragment_mono hle p h
  | storageLive _ | storageDead _ | nop | coverage | constEvalCounter => rfl
  | intrinsic intr =>
    cases intr with
    | assume op => exact checkOperandFragment_mono hle op h
    | copyNonOverlapping src dst count =>
      simp only [checkStmtFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
      exact ⟨⟨⟨MirFragment.le_trans h.1.1.1 hle,
        checkOperandFragment_mono hle src h.1.1.2⟩,
        checkOperandFragment_mono hle dst h.1.2⟩,
        checkOperandFragment_mono hle count h.2⟩
  | retag _ p =>
    simp only [checkStmtFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨MirFragment.le_trans h.1 hle, checkPlaceFragment_mono hle p h.2⟩
  | backwardIncompatibleDropHint p =>
    simp only [checkStmtFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨MirFragment.le_trans h.1 hle, checkPlaceFragment_mono hle p h.2⟩

theorem checkTerminatorFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (tk : TerminatorKind) (h : checkTerminatorFragment f₁ tk = true) :
    checkTerminatorFragment f₂ tk = true := by
  cases tk with
  | goto _ | return_ | unreachable | unwindResume | unwindTerminate => rfl
  | switchInt discr _ => exact checkOperandFragment_mono hle discr h
  | assert cond _ _ _ => exact checkOperandFragment_mono hle cond h
  | drop p _ _ => exact checkPlaceFragment_mono hle p h
  | call func args dest _ _ =>
    simp only [checkTerminatorFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨⟨⟨MirFragment.le_trans h.1.1.1 hle,
      checkOperandFragment_mono hle func h.1.1.2⟩,
      list_all_mono (checkOperandFragment_mono hle) h.1.2⟩,
      checkPlaceFragment_mono hle dest h.2⟩
  | tailCall func args =>
    simp only [checkTerminatorFragment, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
    exact ⟨⟨MirFragment.le_trans h.1.1 hle,
      checkOperandFragment_mono hle func h.1.2⟩,
      list_all_mono (checkOperandFragment_mono hle) h.2⟩
  | inlineAsm _ _ _ =>
    simp only [checkTerminatorFragment, decide_eq_true_eq] at h ⊢
    exact MirFragment.le_trans h hle

theorem checkBlockFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (bb : BasicBlockData) (h : checkBlockFragment f₁ bb = true) :
    checkBlockFragment f₂ bb = true := by
  simp only [checkBlockFragment, Bool.and_eq_true] at h ⊢
  exact ⟨list_all_mono (fun s hs => checkStmtFragment_mono hle s.kind hs) h.1,
    checkTerminatorFragment_mono hle bb.terminator.kind h.2⟩

theorem checkBodyFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (body : CapturedMir) (h : checkBodyFragment f₁ body = true) :
    checkBodyFragment f₂ body = true := by
  cases f₁ <;> cases f₂
  all_goals try exact False.elim (by revert hle; decide)
  all_goals try exact h
  all_goals
    simp only [checkBodyFragment, Bool.and_eq_true] at h ⊢
    first
      | exact list_all_mono (checkBlockFragment_mono hle) h.1
      | exact list_all_mono (checkBlockFragment_mono hle) h

@[simp]
theorem le_fullMir (a : MirFragment) : a ≤ .fullMir :=
  MirFragment.le_top a

@[simp]
theorem checkConstFragment_fullMir (cv : ConstValue) :
    checkConstFragment .fullMir cv = true := by
  cases cv with
  | slice sc _ => cases sc <;> rfl
  | _ => rfl

@[simp]
theorem checkProjElemFragment_fullMir (pe : ProjectionElem) :
    checkProjElemFragment .fullMir pe = true := by
  cases pe <;> rfl

@[simp]
theorem checkPlaceFragment_fullMir (p : Place) :
    checkPlaceFragment .fullMir p = true := by
  simp [checkPlaceFragment]

@[simp]
theorem checkOperandFragment_fullMir (op : Operand) :
    checkOperandFragment .fullMir op = true := by
  cases op <;> simp [checkOperandFragment]

@[simp]
theorem checkBinOpFragment_fullMir (op : BinOp) :
    checkBinOpFragment .fullMir op = true := by
  cases op <;> rfl

@[simp]
theorem checkCastFragment_fullMir (ck : CastKind) :
    checkCastFragment .fullMir ck = true := by
  cases ck <;> rfl

@[simp]
theorem checkRvalueFragment_fullMir (rv : Rvalue) :
    checkRvalueFragment .fullMir rv = true := by
  cases rv <;> simp [checkRvalueFragment]

@[simp]
theorem checkStmtFragment_fullMir (sk : StatementKind) :
    checkStmtFragment .fullMir sk = true := by
  cases sk with
  | intrinsic intr => cases intr <;> simp [checkStmtFragment]
  | _ => simp [checkStmtFragment]

@[simp]
theorem checkTerminatorFragment_fullMir (tk : TerminatorKind) :
    checkTerminatorFragment .fullMir tk = true := by
  cases tk <;> simp [checkTerminatorFragment]

@[simp]
theorem checkBlockFragment_fullMir (bb : BasicBlockData) :
    checkBlockFragment .fullMir bb = true := by
  simp [checkBlockFragment]

/-- Every `CapturedMir` body belongs to `.fullMir`. -/
@[simp]
theorem checkBodyFragment_fullMir (body : CapturedMir) :
    checkBodyFragment .fullMir body = true := by
  simp [checkBodyFragment]

/-- `inferMinFragment body` always satisfies `checkBodyFragment`. -/
theorem checkBodyFragment_inferMinFragment (body : CapturedMir) :
    checkBodyFragment (inferMinFragment body) body = true := by
  unfold inferMinFragment
  split <;> first | assumption | (split <;> first | assumption | (split <;> first | assumption | (split <;> first | assumption | exact checkBodyFragment_fullMir body)))

/-- `inferMinFragment body` is the least fragment accepting `body`. -/
theorem inferMinFragment_minimal (body : CapturedMir) (f : MirFragment)
    (hf : checkBodyFragment f body = true) :
    inferMinFragment body ≤ f := by
  unfold inferMinFragment
  cases f with
  | pureLoopFree =>
    simp only [hf, ↓reduceIte]
    decide
  | pureBoundedLoop =>
    simp only [hf, ↓reduceIte]
    split <;> decide
  | treeBorrowsLocal =>
    simp only [hf, ↓reduceIte]
    split <;> first | decide | (split <;> decide)
  | intrinsicCopy =>
    simp only [hf, ↓reduceIte]
    split <;> first | decide | (split <;> first | decide | (split <;> decide))
  | fullMir =>
    exact MirFragment.le_top _

/--
**Galois / Lower-Adjoint Characterization of `inferMinFragment`**:
`checkBodyFragment f body = true ↔ inferMinFragment body ≤ f`.
-/
theorem checkBodyFragment_iff_inferMinFragment_le (f : MirFragment) (body : CapturedMir) :
    checkBodyFragment f body = true ↔ inferMinFragment body ≤ f := by
  constructor
  · exact inferMinFragment_minimal body f
  · intro hle
    exact checkBodyFragment_mono hle body (checkBodyFragment_inferMinFragment body)

/-- Equivalence of `inferMinFragment` with the head of `MirFragment.all.filter`. -/
theorem inferMinFragment_eq_filter_headD (body : CapturedMir) :
    inferMinFragment body =
      (MirFragment.all.filter (fun f => checkBodyFragment f body)).headD .fullMir := by
  unfold inferMinFragment MirFragment.all
  cases h0 : checkBodyFragment .pureLoopFree body <;>
    cases h1 : checkBodyFragment .pureBoundedLoop body <;>
    cases h2 : checkBodyFragment .treeBorrowsLocal body <;>
    cases h3 : checkBodyFragment .intrinsicCopy body <;>
    cases h4 : checkBodyFragment .fullMir body <;>
    simp [List.filter, h0, h1, h2, h3, h4]

/-! ### 11E. Structural & Downward-Closed Exclusion Theorems -/

/-- A `.pureLoopFree` body has no CFG back-edges (`hasCfgBackedge body = false`). -/
theorem pureLoopFree_has_no_backedges (body : CapturedMir)
    (h : checkBodyFragment .pureLoopFree body = true) :
    hasCfgBackedge body = false := by
  simp only [checkBodyFragment, Bool.and_eq_true, Bool.not_eq_true'] at h
  exact h.2

/-- A `.pureLoopFree` body has no directed CFG cycles of any length. -/
theorem pureLoopFree_no_cfg_cycle (body : CapturedMir)
    (h : checkBodyFragment .pureLoopFree body = true) (u : BasicBlockIdx) :
    ¬ CfgPath body u u :=
  no_cfg_cycle_of_hasCfgBackedge_false (pureLoopFree_has_no_backedges body h) u

theorem list_all_false_of_mem {α : Type} {p : α → Bool} {xs : List α} {x : α}
    (h_mem : x ∈ xs) (hx : p x = false) :
    xs.all p = false := by
  induction xs with
  | nil => cases h_mem
  | cons hd tl ih =>
    simp only [List.mem_cons] at h_mem
    rcases h_mem with rfl | h_tl
    · simp [hx]
    · simp [ih h_tl]

/-- `ProjectionElem.deref` is excluded from `.pureBoundedLoop` (and `.pureLoopFree`). -/
theorem no_deref_in_pureBoundedLoop :
    checkProjElemFragment .pureBoundedLoop .deref = false ∧
    ∀ (p : Place), .deref ∈ p.projection →
      checkPlaceFragment .pureBoundedLoop p = false := by
  refine ⟨rfl, fun p h_mem => ?_⟩
  exact list_all_false_of_mem h_mem rfl

/-- `StatementKind.retag` is excluded from `.pureBoundedLoop` (and `.pureLoopFree`). -/
theorem no_retag_in_pureBoundedLoop (rk : RetagKind) (p : Place) :
    checkStmtFragment .pureBoundedLoop (.retag rk p) = false :=
  rfl

/-- Any body containing a `StatementKind.retag` statement is rejected by `.pureBoundedLoop`. -/
theorem no_retag_body_in_pureBoundedLoop
    (body : CapturedMir) (bb : BasicBlockData) (stmt : Statement)
    (rk : RetagKind) (p : Place)
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements)
    (h_kind : stmt.kind = .retag rk p) :
    checkBodyFragment .pureBoundedLoop body = false := by
  have h_sf : checkStmtFragment .pureBoundedLoop stmt.kind = false := by
    rw [h_kind]; rfl
  have h_stmts : bb.statements.all (fun s => checkStmtFragment .pureBoundedLoop s.kind) = false :=
    list_all_false_of_mem h_stmt h_sf
  have h_blk : checkBlockFragment .pureBoundedLoop bb = false := by
    simp [checkBlockFragment, h_stmts]
  exact list_all_false_of_mem h_bb h_blk

/-- `NonDivergingIntrinsic.copyNonOverlapping` is excluded from `.treeBorrowsLocal`. -/
theorem no_copyNonOverlapping_in_treeBorrowsLocal (src dst count : Operand) :
    checkStmtFragment .treeBorrowsLocal
      (.intrinsic (.copyNonOverlapping src dst count)) = false :=
  rfl

/-- Any body containing `copyNonOverlapping` is rejected by `.treeBorrowsLocal`. -/
theorem no_copyNonOverlapping_body_in_treeBorrowsLocal
    (body : CapturedMir) (bb : BasicBlockData) (stmt : Statement)
    (src dst count : Operand)
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements)
    (h_kind : stmt.kind = .intrinsic (.copyNonOverlapping src dst count)) :
    checkBodyFragment .treeBorrowsLocal body = false := by
  have h_sf : checkStmtFragment .treeBorrowsLocal stmt.kind = false := by
    rw [h_kind]; rfl
  have h_stmts : bb.statements.all (fun s => checkStmtFragment .treeBorrowsLocal s.kind) = false :=
    list_all_false_of_mem h_stmt h_sf
  have h_blk : checkBlockFragment .treeBorrowsLocal bb = false := by
    simp [checkBlockFragment, h_stmts]
  exact list_all_false_of_mem h_bb h_blk

/-- `TerminatorKind.call` and `TerminatorKind.tailCall` are excluded from `.intrinsicCopy`. -/
theorem no_call_in_intrinsicCopy
    (func : Operand) (args : List Operand) (dest : Place)
    (target : Option BasicBlockIdx) (unwind : UnwindAction) :
    checkTerminatorFragment .intrinsicCopy (.call func args dest target unwind) = false ∧
    checkTerminatorFragment .intrinsicCopy (.tailCall func args) = false :=
  ⟨rfl, rfl⟩

/-- Any body containing a `TerminatorKind.call` terminator is rejected by `.intrinsicCopy`. -/
theorem no_call_body_in_intrinsicCopy
    (body : CapturedMir) (bb : BasicBlockData)
    (func : Operand) (args : List Operand) (dest : Place)
    (target : Option BasicBlockIdx) (unwind : UnwindAction)
    (h_bb : bb ∈ body.basicBlocks)
    (h_term : bb.terminator.kind = .call func args dest target unwind) :
    checkBodyFragment .intrinsicCopy body = false := by
  have h_tf : checkTerminatorFragment .intrinsicCopy bb.terminator.kind = false := by
    rw [h_term]; rfl
  have h_blk : checkBlockFragment .intrinsicCopy bb = false := by
    simp [checkBlockFragment, h_tf]
  exact list_all_false_of_mem h_bb h_blk

/-- `TerminatorKind.inlineAsm` is excluded from `.intrinsicCopy`. -/
theorem no_inlineAsm_in_intrinsicCopy
    (template : String) (targets : List BasicBlockIdx) (unwind : UnwindAction) :
    checkTerminatorFragment .intrinsicCopy (.inlineAsm template targets unwind) = false :=
  rfl

/-- Any body containing `TerminatorKind.inlineAsm` is rejected by `.intrinsicCopy`. -/
theorem no_inlineAsm_body_in_intrinsicCopy
    (body : CapturedMir) (bb : BasicBlockData)
    (template : String) (targets : List BasicBlockIdx) (unwind : UnwindAction)
    (h_bb : bb ∈ body.basicBlocks)
    (h_term : bb.terminator.kind = .inlineAsm template targets unwind) :
    checkBodyFragment .intrinsicCopy body = false := by
  have h_tf : checkTerminatorFragment .intrinsicCopy bb.terminator.kind = false := by
    rw [h_term]; rfl
  have h_blk : checkBlockFragment .intrinsicCopy bb = false := by
    simp [checkBlockFragment, h_tf]
  exact list_all_false_of_mem h_bb h_blk

/-- `ProjectionElem.deref` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_deref_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal) :
    checkProjElemFragment f .deref = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `StatementKind.retag` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_retag_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (rk : RetagKind) (p : Place) :
    checkStmtFragment f (.retag rk p) = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `copyNonOverlapping` is rejected at every level `f < .intrinsicCopy`. -/
theorem no_copyNonOverlapping_below_intrinsicCopy (f : MirFragment) (hf : f < .intrinsicCopy)
    (src dst count : Operand) :
    checkStmtFragment f (.intrinsic (.copyNonOverlapping src dst count)) = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `TerminatorKind.call` and `.tailCall` are rejected at every level `f < .fullMir`. -/
theorem no_call_below_fullMir (f : MirFragment) (hf : f < .fullMir)
    (func : Operand) (args : List Operand) (dest : Place)
    (target : Option BasicBlockIdx) (unwind : UnwindAction) :
    checkTerminatorFragment f (.call func args dest target unwind) = false ∧
    checkTerminatorFragment f (.tailCall func args) = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/-- `TerminatorKind.inlineAsm` is rejected at every level `f < .fullMir`. -/
theorem no_inlineAsm_below_fullMir (f : MirFragment) (hf : f < .fullMir)
    (template : String) (targets : List BasicBlockIdx) (unwind : UnwindAction) :
    checkTerminatorFragment f (.inlineAsm template targets unwind) = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `Rvalue.ref` and `Rvalue.rawPtr` are rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_ref_or_rawPtr_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (bk : BorrowKind) (m : Mutability) (p : Place) :
    checkRvalueFragment f (.ref bk p) = false ∧
    checkRvalueFragment f (.rawPtr m p) = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/-- `Rvalue.copyForDeref` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_copyForDeref_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (p : Place) :
    checkRvalueFragment f (.copyForDeref p) = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `BinOp.offset` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_offset_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal) :
    checkBinOpFragment f .offset = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `CastKind.pointerCoercion` and `.ptrToPtr` are rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_ptrCast_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (tag : String) :
    checkCastFragment f (.pointerCoercion tag) = false ∧
    checkCastFragment f .ptrToPtr = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/-- `ProjectionElem.unwrapUnsafeBinder` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_unwrapUnsafeBinder_below_treeBorrowsLocal (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (ty : Ty) :
    checkProjElemFragment f (.unwrapUnsafeBinder ty) = false := by
  cases f <;> first | rfl | exact absurd hf (by decide)

/-- `ConstValue.indirect` and `.slice (.ptr ..)` are rejected at every level `f < .intrinsicCopy`. -/
theorem no_globalAllocConst_below_intrinsicCopy (f : MirFragment) (hf : f < .intrinsicCopy)
    (allocId offset : Nat) (ptr : ProvenancePtr) (sz meta_ : Nat) :
    checkConstFragment f (.indirect allocId offset) = false ∧
    checkConstFragment f (.slice (.ptr ptr sz) meta_) = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/--
`CastKind.pointerExposeProvenance` and `CastKind.pointerWithExposedProvenance`
are rejected at every level `f < .fullMir`.
-/
theorem no_pointerExposeProvenance_below_fullMir (f : MirFragment) (hf : f < .fullMir) :
    checkCastFragment f .pointerExposeProvenance = false ∧
    checkCastFragment f .pointerWithExposedProvenance = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/--
`Rvalue.cast` with `.pointerExposeProvenance` or `.pointerWithExposedProvenance`
is rejected at every level `f < .fullMir`.
-/
theorem no_pointerExposeProvenance_rvalue_below_fullMir (f : MirFragment) (hf : f < .fullMir)
    (op : Operand) (ty : Ty) :
    checkRvalueFragment f (.cast .pointerExposeProvenance op ty) = false ∧
    checkRvalueFragment f (.cast .pointerWithExposedProvenance op ty) = false := by
  cases f <;> first | exact ⟨rfl, rfl⟩ | exact absurd hf (by decide)

/--
`Rvalue.threadLocalRef`, `Rvalue.shallowInitBox`, `CastKind.fnPtrToPtr`,
`CastKind.pointerExposeProvenance`, `CastKind.pointerWithExposedProvenance`, and
`StatementKind.backwardIncompatibleDropHint` are rejected at every level `f < .fullMir`.
-/
theorem no_fullMirOnlyConstructs_below_fullMir (f : MirFragment) (hf : f < .fullMir)
    (path : DefPath) (op : Operand) (ty : Ty) (p : Place) :
    checkRvalueFragment f (.threadLocalRef path) = false ∧
    checkRvalueFragment f (.shallowInitBox op ty) = false ∧
    checkCastFragment f .fnPtrToPtr = false ∧
    checkCastFragment f .pointerExposeProvenance = false ∧
    checkCastFragment f .pointerWithExposedProvenance = false ∧
    checkStmtFragment f (.backwardIncompatibleDropHint p) = false := by
  cases f <;> first | exact ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | exact absurd hf (by decide)

/-- Any body containing `StatementKind.retag` is rejected at every level `f < .treeBorrowsLocal`. -/
theorem no_retag_body_below_treeBorrowsLocal
    (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (body : CapturedMir) (bb : BasicBlockData) (stmt : Statement)
    (rk : RetagKind) (p : Place)
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements)
    (h_kind : stmt.kind = .retag rk p) :
    checkBodyFragment f body = false := by
  cases h_chk : checkBodyFragment f body
  · rfl
  · have h_le : checkBodyFragment .pureBoundedLoop body = true := by
      refine checkBodyFragment_mono ?_ body h_chk
      cases f <;> first | decide | exact absurd hf (by decide)
    exact absurd h_le (by rw [no_retag_body_in_pureBoundedLoop body bb stmt rk p h_bb h_stmt h_kind]; decide)

/-- Any body containing `copyNonOverlapping` is rejected at every level `f < .intrinsicCopy`. -/
theorem no_copyNonOverlapping_body_below_intrinsicCopy
    (f : MirFragment) (hf : f < .intrinsicCopy)
    (body : CapturedMir) (bb : BasicBlockData) (stmt : Statement)
    (src dst count : Operand)
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements)
    (h_kind : stmt.kind = .intrinsic (.copyNonOverlapping src dst count)) :
    checkBodyFragment f body = false := by
  cases h_chk : checkBodyFragment f body
  · rfl
  · have h_le : checkBodyFragment .treeBorrowsLocal body = true := by
      refine checkBodyFragment_mono ?_ body h_chk
      cases f <;> first | decide | exact absurd hf (by decide)
    exact absurd h_le (by rw [no_copyNonOverlapping_body_in_treeBorrowsLocal body bb stmt src dst count h_bb h_stmt h_kind]; decide)

/-- Any body containing `TerminatorKind.call` is rejected at every level `f < .fullMir`. -/
theorem no_call_body_below_fullMir
    (f : MirFragment) (hf : f < .fullMir)
    (body : CapturedMir) (bb : BasicBlockData)
    (func : Operand) (args : List Operand) (dest : Place)
    (target : Option BasicBlockIdx) (unwind : UnwindAction)
    (h_bb : bb ∈ body.basicBlocks)
    (h_term : bb.terminator.kind = .call func args dest target unwind) :
    checkBodyFragment f body = false := by
  cases h_chk : checkBodyFragment f body
  · rfl
  · have h_le : checkBodyFragment .intrinsicCopy body = true := by
      refine checkBodyFragment_mono ?_ body h_chk
      cases f <;> first | decide | exact absurd hf (by decide)
    exact absurd h_le (by rw [no_call_body_in_intrinsicCopy body bb func args dest target unwind h_bb h_term]; decide)

/-- Any body containing `TerminatorKind.tailCall` is rejected at every level `f < .fullMir`. -/
theorem no_tailCall_body_below_fullMir
    (f : MirFragment) (hf : f < .fullMir)
    (body : CapturedMir) (bb : BasicBlockData)
    (func : Operand) (args : List Operand)
    (h_bb : bb ∈ body.basicBlocks)
    (h_term : bb.terminator.kind = .tailCall func args) :
    checkBodyFragment f body = false := by
  cases h_chk : checkBodyFragment f body
  · rfl
  · have h_le : checkBodyFragment .intrinsicCopy body = true := by
      refine checkBodyFragment_mono ?_ body h_chk
      cases f <;> first | decide | exact absurd hf (by decide)
    have h_tf : checkTerminatorFragment .intrinsicCopy bb.terminator.kind = false := by
      rw [h_term]; rfl
    have h_blk : checkBlockFragment .intrinsicCopy bb = false := by
      simp [checkBlockFragment, h_tf]
    have h_body : checkBodyFragment .intrinsicCopy body = false :=
      list_all_false_of_mem h_bb h_blk
    exact absurd h_le (by rw [h_body]; decide)

/-- Any body containing `TerminatorKind.inlineAsm` is rejected at every level `f < .fullMir`. -/
theorem no_inlineAsm_body_below_fullMir
    (f : MirFragment) (hf : f < .fullMir)
    (body : CapturedMir) (bb : BasicBlockData)
    (template : String) (targets : List BasicBlockIdx) (unwind : UnwindAction)
    (h_bb : bb ∈ body.basicBlocks)
    (h_term : bb.terminator.kind = .inlineAsm template targets unwind) :
    checkBodyFragment f body = false := by
  cases h_chk : checkBodyFragment f body
  · rfl
  · have h_le : checkBodyFragment .intrinsicCopy body = true := by
      refine checkBodyFragment_mono ?_ body h_chk
      cases f <;> first | decide | exact absurd hf (by decide)
    exact absurd h_le (by rw [no_inlineAsm_body_in_intrinsicCopy body bb template targets unwind h_bb h_term]; decide)

/-! ### 11F. Single-Pass Bottom-Up Lattice Inference & Rank-1 CFG Property -/

/-- Minimum fragment required by a single `ConstValue`. -/
def minConstFragment : ConstValue → MirFragment
  | .zeroSized => .pureLoopFree
  | .scalar _ => .pureLoopFree
  | .slice (.int _) _ => .pureLoopFree
  | .slice (.ptr _ _) _ => .intrinsicCopy
  | .indirect _ _ => .intrinsicCopy
  | .unevaluated _ => .pureLoopFree

/-- Minimum fragment required by a single `ProjectionElem`. -/
def minProjElemFragment : ProjectionElem → MirFragment
  | .deref => .treeBorrowsLocal
  | .field _ _ => .pureLoopFree
  | .index _ => .pureLoopFree
  | .constantIndex .. => .pureLoopFree
  | .subslice .. => .pureLoopFree
  | .downcast _ _ => .pureLoopFree
  | .opaqueCast _ => .treeBorrowsLocal
  | .unwrapUnsafeBinder _ => .treeBorrowsLocal

/-- Join `g x` across all elements of `xs`, starting from `.pureLoopFree`. -/
def joinList {α : Type} (g : α → MirFragment) : List α → MirFragment
  | [] => .pureLoopFree
  | x :: xs => (g x).join (joinList g xs)

/-- Minimum fragment required by a `Place`. -/
def minPlaceFragment (p : Place) : MirFragment :=
  joinList minProjElemFragment p.projection

/-- Minimum fragment required by an `Operand`. -/
def minOperandFragment : Operand → MirFragment
  | .copy p => minPlaceFragment p
  | .move p => minPlaceFragment p
  | .constant c => minConstFragment c.val

/-- Minimum fragment required by a `BinOp`. -/
def minBinOpFragment : BinOp → MirFragment
  | .offset => .treeBorrowsLocal
  | .add | .addUnchecked | .addWithOverflow
  | .sub | .subUnchecked | .subWithOverflow
  | .mul | .mulUnchecked | .mulWithOverflow
  | .div | .rem
  | .bitXor | .bitAnd | .bitOr
  | .shl | .shlUnchecked | .shr | .shrUnchecked
  | .eq | .lt | .le | .ne | .ge | .gt | .cmp => .pureLoopFree

/--
Minimum fragment required by a `CastKind` (with `.pointerExposeProvenance` and
`.pointerWithExposedProvenance` mapped to `.fullMir` in parity with
`isPureRvalue` and `checkCastFragment`).
-/
def minCastFragment : CastKind → MirFragment
  | .pointerCoercion _ => .treeBorrowsLocal
  | .ptrToPtr => .treeBorrowsLocal
  | .fnPtrToPtr => .fullMir
  | .pointerExposeProvenance => .fullMir
  | .pointerWithExposedProvenance => .fullMir
  | .intToInt
  | .floatToInt
  | .floatToFloat
  | .intToFloat
  | .transmute
  | .subtype => .pureLoopFree

/-- Minimum fragment required by an `Rvalue`. -/
def minRvalueFragment : Rvalue → MirFragment
  | .use op => minOperandFragment op
  | .repeat op _ => minOperandFragment op
  | .ref _ p => MirFragment.treeBorrowsLocal.join (minPlaceFragment p)
  | .rawPtr _ p => MirFragment.treeBorrowsLocal.join (minPlaceFragment p)
  | .threadLocalRef _ => .fullMir
  | .len p => minPlaceFragment p
  | .cast ck op _ => (minCastFragment ck).join (minOperandFragment op)
  | .binaryOp op lhs rhs =>
    (minBinOpFragment op).join ((minOperandFragment lhs).join (minOperandFragment rhs))
  | .nullaryOp _ _ => .pureLoopFree
  | .unaryOp _ op => minOperandFragment op
  | .discriminant p => minPlaceFragment p
  | .aggregate _ ops => joinList minOperandFragment ops
  | .shallowInitBox op _ => MirFragment.fullMir.join (minOperandFragment op)
  | .copyForDeref p => MirFragment.treeBorrowsLocal.join (minPlaceFragment p)
  | .wrapUnsafeBinder op _ => minOperandFragment op

/-- Minimum fragment required by a `StatementKind`. -/
def minStmtFragment : StatementKind → MirFragment
  | .assign p r => (minPlaceFragment p).join (minRvalueFragment r)
  | .setDiscriminant p _ => minPlaceFragment p
  | .storageLive _ => .pureLoopFree
  | .storageDead _ => .pureLoopFree
  | .nop => .pureLoopFree
  | .coverage => .pureLoopFree
  | .constEvalCounter => .pureLoopFree
  | .placeMention p => minPlaceFragment p
  | .deinit p => minPlaceFragment p
  | .intrinsic (.assume op) => minOperandFragment op
  | .intrinsic (.copyNonOverlapping src dst count) =>
    (MirFragment.intrinsicCopy.join (minOperandFragment src)).join
      ((minOperandFragment dst).join (minOperandFragment count))
  | .retag _ p => MirFragment.treeBorrowsLocal.join (minPlaceFragment p)
  | .backwardIncompatibleDropHint p => MirFragment.fullMir.join (minPlaceFragment p)

/-- Minimum fragment required by a `TerminatorKind`. -/
def minTerminatorFragment : TerminatorKind → MirFragment
  | .goto _ => .pureLoopFree
  | .switchInt discr _ => minOperandFragment discr
  | .return_ => .pureLoopFree
  | .assert cond _ _ _ => minOperandFragment cond
  | .drop p _ _ => minPlaceFragment p
  | .unreachable => .pureLoopFree
  | .unwindResume => .pureLoopFree
  | .unwindTerminate => .pureLoopFree
  | .call func args dest _ _ =>
    ((MirFragment.fullMir.join (minOperandFragment func)).join
      (joinList minOperandFragment args)).join
      (minPlaceFragment dest)
  | .tailCall func args =>
    (MirFragment.fullMir.join (minOperandFragment func)).join
      (joinList minOperandFragment args)
  | .inlineAsm _ _ _ => .fullMir

/-- Minimum fragment required by a `BasicBlockData`. -/
def minBlockFragment (bb : BasicBlockData) : MirFragment :=
  (joinList (fun s => minStmtFragment s.kind) bb.statements).join
    (minTerminatorFragment bb.terminator.kind)

/--
Single-pass bottom-up syntactic fragment inference over `body : CapturedMir`
(canonical reference fold for Episode 2's single-pass Rust body scanner).
-/
def inferMinFragmentSinglePass (body : CapturedMir) : MirFragment :=
  let blocksFrag := joinList minBlockFragment body.basicBlocks
  if hasCfgBackedge body then
    blocksFrag.join .pureBoundedLoop
  else
    blocksFrag

theorem decide_join_le (a b f : MirFragment) :
    (decide (a ≤ f) && decide (b ≤ f)) = decide (a.join b ≤ f) := by
  cases a <;> cases b <;> cases f <;> rfl

theorem list_all_decide_le_eq_joinList {α : Type} (g : α → MirFragment) (f : MirFragment) :
    ∀ (xs : List α),
      xs.all (fun x => decide (g x ≤ f)) = decide (joinList g xs ≤ f)
  | [] => by cases f <;> rfl
  | x :: xs => by
    dsimp only [List.all_cons, joinList]
    rw [list_all_decide_le_eq_joinList g f xs, decide_join_le]
    rfl

theorem checkConstFragment_eq_decide (f : MirFragment) (cv : ConstValue) :
    checkConstFragment f cv = decide (minConstFragment cv ≤ f) := by
  cases cv with
  | slice sc _ => cases sc <;> cases f <;> rfl
  | _ => cases f <;> rfl

theorem checkProjElemFragment_eq_decide (f : MirFragment) (pe : ProjectionElem) :
    checkProjElemFragment f pe = decide (minProjElemFragment pe ≤ f) := by
  cases pe <;> cases f <;> rfl

theorem checkPlaceFragment_eq_decide (f : MirFragment) (p : Place) :
    checkPlaceFragment f p = decide (minPlaceFragment p ≤ f) := by
  dsimp only [checkPlaceFragment, minPlaceFragment]
  rw [congrArg p.projection.all (funext (checkProjElemFragment_eq_decide f)),
    list_all_decide_le_eq_joinList]
  rfl

theorem checkOperandFragment_eq_decide (f : MirFragment) (op : Operand) :
    checkOperandFragment f op = decide (minOperandFragment op ≤ f) := by
  cases op with
  | copy p | move p => exact checkPlaceFragment_eq_decide f p
  | constant c => exact checkConstFragment_eq_decide f c.val

theorem checkBinOpFragment_eq_decide (f : MirFragment) (op : BinOp) :
    checkBinOpFragment f op = decide (minBinOpFragment op ≤ f) := by
  cases op <;> cases f <;> rfl

theorem checkCastFragment_eq_decide (f : MirFragment) (ck : CastKind) :
    checkCastFragment f ck = decide (minCastFragment ck ≤ f) := by
  cases ck <;> cases f <;> rfl

theorem checkRvalueFragment_eq_decide (f : MirFragment) (rv : Rvalue) :
    checkRvalueFragment f rv = decide (minRvalueFragment rv ≤ f) := by
  cases rv with
  | use op | «repeat» op _ | unaryOp _ op | wrapUnsafeBinder op _ =>
    exact checkOperandFragment_eq_decide f op
  | len p | discriminant p =>
    exact checkPlaceFragment_eq_decide f p
  | nullaryOp _ _ => cases f <;> rfl
  | threadLocalRef _ => cases f <;> rfl
  | ref _ p | rawPtr _ p | copyForDeref p =>
    dsimp only [checkRvalueFragment, minRvalueFragment]
    rw [checkPlaceFragment_eq_decide, decide_join_le]
    rfl
  | cast ck op _ =>
    dsimp only [checkRvalueFragment, minRvalueFragment]
    rw [checkCastFragment_eq_decide, checkOperandFragment_eq_decide, decide_join_le]
    rfl
  | binaryOp op lhs rhs =>
    dsimp only [checkRvalueFragment, minRvalueFragment]
    rw [checkBinOpFragment_eq_decide, checkOperandFragment_eq_decide,
      checkOperandFragment_eq_decide, decide_join_le, decide_join_le]
    rfl
  | aggregate _ ops =>
    dsimp only [checkRvalueFragment, minRvalueFragment]
    rw [congrArg ops.all (funext (checkOperandFragment_eq_decide f)),
      list_all_decide_le_eq_joinList]
    rfl
  | shallowInitBox op _ =>
    dsimp only [checkRvalueFragment, minRvalueFragment]
    rw [checkOperandFragment_eq_decide, decide_join_le]
    rfl

theorem checkStmtFragment_eq_decide (f : MirFragment) (sk : StatementKind) :
    checkStmtFragment f sk = decide (minStmtFragment sk ≤ f) := by
  cases sk with
  | assign p r =>
    dsimp only [checkStmtFragment, minStmtFragment]
    rw [checkPlaceFragment_eq_decide, checkRvalueFragment_eq_decide, decide_join_le]
    rfl
  | setDiscriminant p _ | placeMention p | deinit p =>
    exact checkPlaceFragment_eq_decide f p
  | storageLive _ | storageDead _ | nop | coverage | constEvalCounter =>
    cases f <;> rfl
  | intrinsic intr =>
    cases intr with
    | assume op => exact checkOperandFragment_eq_decide f op
    | copyNonOverlapping src dst count =>
      dsimp only [checkStmtFragment, minStmtFragment]
      rw [checkOperandFragment_eq_decide, checkOperandFragment_eq_decide,
        checkOperandFragment_eq_decide, Bool.and_assoc, decide_join_le,
        decide_join_le, decide_join_le]
      rfl
  | retag _ p | backwardIncompatibleDropHint p =>
    dsimp only [checkStmtFragment, minStmtFragment]
    rw [checkPlaceFragment_eq_decide, decide_join_le]
    rfl

theorem checkTerminatorFragment_eq_decide (f : MirFragment) (tk : TerminatorKind) :
    checkTerminatorFragment f tk = decide (minTerminatorFragment tk ≤ f) := by
  cases tk with
  | goto _ | return_ | unreachable | unwindResume | unwindTerminate | inlineAsm _ _ _ =>
    cases f <;> rfl
  | switchInt discr _ => exact checkOperandFragment_eq_decide f discr
  | assert cond _ _ _ => exact checkOperandFragment_eq_decide f cond
  | drop p _ _ => exact checkPlaceFragment_eq_decide f p
  | call func args dest _ _ =>
    dsimp only [checkTerminatorFragment, minTerminatorFragment]
    rw [checkOperandFragment_eq_decide,
      congrArg args.all (funext (checkOperandFragment_eq_decide f)),
      list_all_decide_le_eq_joinList, checkPlaceFragment_eq_decide,
      decide_join_le, decide_join_le, decide_join_le]
    rfl
  | tailCall func args =>
    dsimp only [checkTerminatorFragment, minTerminatorFragment]
    rw [checkOperandFragment_eq_decide,
      congrArg args.all (funext (checkOperandFragment_eq_decide f)),
      list_all_decide_le_eq_joinList, decide_join_le, decide_join_le]
    rfl

theorem checkBlockFragment_eq_decide (f : MirFragment) (bb : BasicBlockData) :
    checkBlockFragment f bb = decide (minBlockFragment bb ≤ f) := by
  dsimp only [checkBlockFragment, minBlockFragment]
  rw [congrArg bb.statements.all (funext fun s => checkStmtFragment_eq_decide f s.kind),
    list_all_decide_le_eq_joinList (fun (s : Statement) => minStmtFragment s.kind) f bb.statements,
    checkTerminatorFragment_eq_decide, decide_join_le]
  rfl

theorem checkBodyFragment_eq_decide_singlePass (f : MirFragment) (body : CapturedMir) :
    checkBodyFragment f body = decide (inferMinFragmentSinglePass body ≤ f) := by
  have h_all :
      body.basicBlocks.all (checkBlockFragment f) =
        decide (joinList minBlockFragment body.basicBlocks ≤ f) := by
    rw [congrArg body.basicBlocks.all (funext (checkBlockFragment_eq_decide f)),
      list_all_decide_le_eq_joinList]
  unfold checkBodyFragment inferMinFragmentSinglePass
  cases f <;>
    rw [h_all] <;>
    cases hasCfgBackedge body <;>
    cases joinList minBlockFragment body.basicBlocks <;>
    rfl

/--
**Isomorphism of Top-Down and Single-Pass Bottom-Up Fragment Inference**:
`inferMinFragmentSinglePass body = inferMinFragment body`.
-/
theorem inferMinFragmentSinglePass_eq_inferMinFragment (body : CapturedMir) :
    inferMinFragmentSinglePass body = inferMinFragment body := by
  apply MirFragment.le_antisymm
  · have h_in : checkBodyFragment (inferMinFragment body) body = true :=
      checkBodyFragment_inferMinFragment body
    rw [checkBodyFragment_eq_decide_singlePass, decide_eq_true_eq] at h_in
    exact h_in
  · apply inferMinFragment_minimal
    rw [checkBodyFragment_eq_decide_singlePass, decide_eq_true_eq]
    exact MirFragment.le_refl _

theorem le_joinList_of_mem {α : Type} (g : α → MirFragment) {x : α} {xs : List α}
    (h_mem : x ∈ xs) : g x ≤ joinList g xs := by
  induction xs with
  | nil => cases h_mem
  | cons hd tl ih =>
    simp only [List.mem_cons] at h_mem
    rcases h_mem with rfl | h_tl
    · exact MirFragment.le_join_left _ _
    · exact MirFragment.le_trans (ih h_tl) (MirFragment.le_join_right _ _)

theorem joinList_minBlockFragment_le_inferMinFragment (body : CapturedMir) :
    joinList minBlockFragment body.basicBlocks ≤ inferMinFragment body := by
  rw [← inferMinFragmentSinglePass_eq_inferMinFragment]
  unfold inferMinFragmentSinglePass
  cases hasCfgBackedge body
  · exact MirFragment.le_refl _
  · exact MirFragment.le_join_left _ _

/--
**Universal Block Lower-Bound Theorem**:
Every basic block `bb ∈ body.basicBlocks` bounds `inferMinFragment body` from below.
-/
theorem minBlockFragment_le_inferMinFragment_of_mem
    {body : CapturedMir} {bb : BasicBlockData} (h_bb : bb ∈ body.basicBlocks) :
    minBlockFragment bb ≤ inferMinFragment body :=
  MirFragment.le_trans
    (le_joinList_of_mem minBlockFragment h_bb)
    (joinList_minBlockFragment_le_inferMinFragment body)

/--
**Universal Statement Lower-Bound Theorem**:
Every statement `stmt ∈ bb.statements` in any block `bb ∈ body.basicBlocks`
bounds `inferMinFragment body` from below.
-/
theorem minStmtFragment_le_inferMinFragment_of_mem
    {body : CapturedMir} {bb : BasicBlockData} {stmt : Statement}
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements) :
    minStmtFragment stmt.kind ≤ inferMinFragment body := by
  have h_s : minStmtFragment stmt.kind ≤ minBlockFragment bb :=
    MirFragment.le_trans
      (le_joinList_of_mem (fun (s : Statement) => minStmtFragment s.kind) h_stmt)
      (MirFragment.le_join_left _ _)
  exact MirFragment.le_trans h_s (minBlockFragment_le_inferMinFragment_of_mem h_bb)

/--
**Universal Terminator Lower-Bound Theorem**:
Every block terminator `bb.terminator` in `bb ∈ body.basicBlocks` bounds
`inferMinFragment body` from below.
-/
theorem minTerminatorFragment_le_inferMinFragment_of_mem
    {body : CapturedMir} {bb : BasicBlockData} (h_bb : bb ∈ body.basicBlocks) :
    minTerminatorFragment bb.terminator.kind ≤ inferMinFragment body :=
  MirFragment.le_trans
    (MirFragment.le_join_right _ _)
    (minBlockFragment_le_inferMinFragment_of_mem h_bb)

/-- If `f < inferMinFragment body`, then `checkBodyFragment f body = false`. -/
theorem checkBodyFragment_false_of_lt_inferMinFragment
    {body : CapturedMir} {f : MirFragment}
    (hf : f < inferMinFragment body) :
    checkBodyFragment f body = false := by
  cases h : checkBodyFragment f body
  · rfl
  · exact absurd (inferMinFragment_minimal body f h) (Nat.not_le_of_lt hf)

/--
**Universal Statement Downward-Closed Exclusion Theorem**:
If `stmt ∈ bb.statements` (`bb ∈ body.basicBlocks`) and `f < minStmtFragment stmt.kind`,
then `checkBodyFragment f body = false`.
-/
theorem checkBodyFragment_false_of_lt_minStmtFragment
    {body : CapturedMir} {bb : BasicBlockData} {stmt : Statement} {f : MirFragment}
    (h_bb : bb ∈ body.basicBlocks) (h_stmt : stmt ∈ bb.statements)
    (hf : f < minStmtFragment stmt.kind) :
    checkBodyFragment f body = false := by
  apply checkBodyFragment_false_of_lt_inferMinFragment
  exact Nat.lt_of_lt_of_le hf (minStmtFragment_le_inferMinFragment_of_mem h_bb h_stmt)

/--
**Universal Terminator Downward-Closed Exclusion Theorem**:
If `bb ∈ body.basicBlocks` and `f < minTerminatorFragment bb.terminator.kind`,
then `checkBodyFragment f body = false`.
-/
theorem checkBodyFragment_false_of_lt_minTerminatorFragment
    {body : CapturedMir} {bb : BasicBlockData} {f : MirFragment}
    (h_bb : bb ∈ body.basicBlocks)
    (hf : f < minTerminatorFragment bb.terminator.kind) :
    checkBodyFragment f body = false := by
  apply checkBodyFragment_false_of_lt_inferMinFragment
  exact Nat.lt_of_lt_of_le hf (minTerminatorFragment_le_inferMinFragment_of_mem h_bb)

theorem join_ne_pureBoundedLoop {a b : MirFragment}
    (ha : a ≠ .pureBoundedLoop) (hb : b ≠ .pureBoundedLoop) :
    a.join b ≠ .pureBoundedLoop := by
  cases a <;> cases b <;> first | decide | exact absurd rfl ha | exact absurd rfl hb

theorem joinList_ne_pureBoundedLoop {α : Type} {g : α → MirFragment}
    (hg : ∀ x, g x ≠ .pureBoundedLoop) :
    ∀ xs : List α, joinList g xs ≠ .pureBoundedLoop
  | [] => nofun
  | x :: xs => join_ne_pureBoundedLoop (hg x) (joinList_ne_pureBoundedLoop hg xs)

theorem minConstFragment_ne_pureBoundedLoop (cv : ConstValue) :
    minConstFragment cv ≠ .pureBoundedLoop := by
  cases cv with
  | slice sc _ => cases sc <;> nofun
  | _ => nofun

theorem minProjElemFragment_ne_pureBoundedLoop (pe : ProjectionElem) :
    minProjElemFragment pe ≠ .pureBoundedLoop := by
  cases pe <;> nofun

theorem minPlaceFragment_ne_pureBoundedLoop (p : Place) :
    minPlaceFragment p ≠ .pureBoundedLoop :=
  joinList_ne_pureBoundedLoop minProjElemFragment_ne_pureBoundedLoop p.projection

theorem minOperandFragment_ne_pureBoundedLoop (op : Operand) :
    minOperandFragment op ≠ .pureBoundedLoop := by
  cases op with
  | copy p | move p => exact minPlaceFragment_ne_pureBoundedLoop p
  | constant c => exact minConstFragment_ne_pureBoundedLoop c.val

theorem minBinOpFragment_ne_pureBoundedLoop (op : BinOp) :
    minBinOpFragment op ≠ .pureBoundedLoop := by
  cases op <;> nofun

theorem minCastFragment_ne_pureBoundedLoop (ck : CastKind) :
    minCastFragment ck ≠ .pureBoundedLoop := by
  cases ck <;> nofun

theorem minRvalueFragment_ne_pureBoundedLoop (rv : Rvalue) :
    minRvalueFragment rv ≠ .pureBoundedLoop := by
  cases rv with
  | use op | «repeat» op _ | unaryOp _ op | wrapUnsafeBinder op _ =>
    exact minOperandFragment_ne_pureBoundedLoop op
  | len p | discriminant p => exact minPlaceFragment_ne_pureBoundedLoop p
  | nullaryOp _ _ | threadLocalRef _ => nofun
  | ref _ p | rawPtr _ p | copyForDeref p =>
    exact join_ne_pureBoundedLoop (by decide) (minPlaceFragment_ne_pureBoundedLoop p)
  | cast ck op _ =>
    exact join_ne_pureBoundedLoop (minCastFragment_ne_pureBoundedLoop ck)
      (minOperandFragment_ne_pureBoundedLoop op)
  | binaryOp op lhs rhs =>
    exact join_ne_pureBoundedLoop (minBinOpFragment_ne_pureBoundedLoop op)
      (join_ne_pureBoundedLoop (minOperandFragment_ne_pureBoundedLoop lhs)
        (minOperandFragment_ne_pureBoundedLoop rhs))
  | aggregate _ ops => exact joinList_ne_pureBoundedLoop minOperandFragment_ne_pureBoundedLoop ops
  | shallowInitBox op _ =>
    exact join_ne_pureBoundedLoop (by decide) (minOperandFragment_ne_pureBoundedLoop op)

theorem minStmtFragment_ne_pureBoundedLoop (sk : StatementKind) :
    minStmtFragment sk ≠ .pureBoundedLoop := by
  cases sk with
  | assign p r =>
    exact join_ne_pureBoundedLoop (minPlaceFragment_ne_pureBoundedLoop p)
      (minRvalueFragment_ne_pureBoundedLoop r)
  | setDiscriminant p _ | placeMention p | deinit p => exact minPlaceFragment_ne_pureBoundedLoop p
  | storageLive _ | storageDead _ | nop | coverage | constEvalCounter => nofun
  | intrinsic intr =>
    cases intr with
    | assume op => exact minOperandFragment_ne_pureBoundedLoop op
    | copyNonOverlapping src dst count =>
      exact join_ne_pureBoundedLoop
        (join_ne_pureBoundedLoop (by decide) (minOperandFragment_ne_pureBoundedLoop src))
        (join_ne_pureBoundedLoop (minOperandFragment_ne_pureBoundedLoop dst)
          (minOperandFragment_ne_pureBoundedLoop count))
  | retag _ p | backwardIncompatibleDropHint p =>
    exact join_ne_pureBoundedLoop (by decide) (minPlaceFragment_ne_pureBoundedLoop p)

theorem minTerminatorFragment_ne_pureBoundedLoop (tk : TerminatorKind) :
    minTerminatorFragment tk ≠ .pureBoundedLoop := by
  cases tk with
  | goto _ | return_ | unreachable | unwindResume | unwindTerminate | inlineAsm _ _ _ => nofun
  | switchInt discr _ => exact minOperandFragment_ne_pureBoundedLoop discr
  | assert cond _ _ _ => exact minOperandFragment_ne_pureBoundedLoop cond
  | drop p _ _ => exact minPlaceFragment_ne_pureBoundedLoop p
  | call func args dest _ _ =>
    exact join_ne_pureBoundedLoop
      (join_ne_pureBoundedLoop
        (join_ne_pureBoundedLoop (by decide) (minOperandFragment_ne_pureBoundedLoop func))
        (joinList_ne_pureBoundedLoop minOperandFragment_ne_pureBoundedLoop args))
      (minPlaceFragment_ne_pureBoundedLoop dest)
  | tailCall func args =>
    exact join_ne_pureBoundedLoop
      (join_ne_pureBoundedLoop (by decide) (minOperandFragment_ne_pureBoundedLoop func))
      (joinList_ne_pureBoundedLoop minOperandFragment_ne_pureBoundedLoop args)

/--
**No basic block requires exactly `.pureBoundedLoop`**: rank 1 of the syntactic
lattice is a pure CFG property (`hasCfgBackedge`), never a per-construct one.
-/
theorem minBlockFragment_ne_pureBoundedLoop (bb : BasicBlockData) :
    minBlockFragment bb ≠ .pureBoundedLoop :=
  join_ne_pureBoundedLoop
    (joinList_ne_pureBoundedLoop (fun s => minStmtFragment_ne_pureBoundedLoop s.kind) bb.statements)
    (minTerminatorFragment_ne_pureBoundedLoop bb.terminator.kind)

theorem checkBlockFragment_pureLoopFree_eq_pureBoundedLoop (bb : BasicBlockData) :
    checkBlockFragment .pureLoopFree bb = checkBlockFragment .pureBoundedLoop bb := by
  rw [checkBlockFragment_eq_decide, checkBlockFragment_eq_decide]
  have h := minBlockFragment_ne_pureBoundedLoop bb
  generalize minBlockFragment bb = m at h ⊢
  cases m <;> first | rfl | exact absurd rfl h

theorem checkBodyFragment_pureLoopFree_eq_pureBoundedLoop_and_no_backedge (body : CapturedMir) :
    checkBodyFragment .pureLoopFree body =
      (checkBodyFragment .pureBoundedLoop body && !hasCfgBackedge body) := by
  simp only [checkBodyFragment]
  rw [congrArg body.basicBlocks.all (funext checkBlockFragment_pureLoopFree_eq_pureBoundedLoop)]

/-!
### 11G. Syntactic Purity & Borrow-Free `checkPureMir` Bridges
(`hasNoPtrRelationalAssign`, `checkBorrowFreeBodyFragment`, `inferBorrowFreeMinFragment`)
-/

@[simp]
theorem checkConstFragment_pureBoundedLoop_eq_isPureConstValue (cv : ConstValue) :
    checkConstFragment .pureBoundedLoop cv = isPureConstValue cv := by
  cases cv with
  | slice sc _ => cases sc <;> rfl
  | _ => rfl

@[simp]
theorem checkProjElemFragment_pureBoundedLoop_eq_isPureProjElem (pe : ProjectionElem) :
    checkProjElemFragment .pureBoundedLoop pe = isPureProjElem pe := by
  cases pe <;> rfl

@[simp]
theorem checkPlaceFragment_pureBoundedLoop_eq_isPurePlace (p : Place) :
    checkPlaceFragment .pureBoundedLoop p = isPurePlace p :=
  congrArg p.projection.all (funext checkProjElemFragment_pureBoundedLoop_eq_isPureProjElem)

@[simp]
theorem checkOperandFragment_pureBoundedLoop_eq_isPureOperand (op : Operand) :
    checkOperandFragment .pureBoundedLoop op = isPureOperand op := by
  cases op with
  | copy p | move p => exact checkPlaceFragment_pureBoundedLoop_eq_isPurePlace p
  | constant c => exact checkConstFragment_pureBoundedLoop_eq_isPureConstValue c.val

@[simp]
theorem checkBinOpFragment_pureBoundedLoop_eq_isPureBinOp (op : BinOp) :
    checkBinOpFragment .pureBoundedLoop op = isPureBinOp op := by
  cases op <;> rfl

@[simp]
theorem checkRvalueFragment_pureBoundedLoop_eq_isPureRvalue (rv : Rvalue) :
    checkRvalueFragment .pureBoundedLoop rv = isPureRvalue rv := by
  cases rv with
  | use op | «repeat» op _ | unaryOp _ op | wrapUnsafeBinder op _ =>
    exact checkOperandFragment_pureBoundedLoop_eq_isPureOperand op
  | ref _ _ | rawPtr _ _ | threadLocalRef _ | shallowInitBox _ _ | copyForDeref _ =>
    rfl
  | len p | discriminant p =>
    exact checkPlaceFragment_pureBoundedLoop_eq_isPurePlace p
  | cast ck op _ =>
    cases ck <;>
      first
        | rfl
        | (dsimp only [checkRvalueFragment, isPureRvalue, checkCastFragment]
           rw [Bool.true_and]
           exact checkOperandFragment_pureBoundedLoop_eq_isPureOperand op)
  | binaryOp op lhs rhs =>
    dsimp only [checkRvalueFragment, isPureRvalue]
    rw [checkBinOpFragment_pureBoundedLoop_eq_isPureBinOp,
      checkOperandFragment_pureBoundedLoop_eq_isPureOperand,
      checkOperandFragment_pureBoundedLoop_eq_isPureOperand]
  | nullaryOp _ _ => rfl
  | aggregate _ ops =>
    exact congrArg ops.all (funext checkOperandFragment_pureBoundedLoop_eq_isPureOperand)

@[simp]
theorem checkStmtFragment_pureBoundedLoop_eq_isPureStatement (sk : StatementKind) :
    checkStmtFragment .pureBoundedLoop sk = isPureStatement sk := by
  cases sk with
  | assign p r =>
    dsimp only [checkStmtFragment, isPureStatement]
    rw [checkPlaceFragment_pureBoundedLoop_eq_isPurePlace,
      checkRvalueFragment_pureBoundedLoop_eq_isPureRvalue]
  | setDiscriminant p _ | placeMention p | deinit p =>
    exact checkPlaceFragment_pureBoundedLoop_eq_isPurePlace p
  | storageLive _ | storageDead _ | nop | coverage | constEvalCounter => rfl
  | intrinsic intr =>
    cases intr with
    | assume op => exact checkOperandFragment_pureBoundedLoop_eq_isPureOperand op
    | copyNonOverlapping _ _ _ => rfl
  | retag _ _ | backwardIncompatibleDropHint _ => rfl

@[simp]
theorem checkTerminatorFragment_pureBoundedLoop_eq_isPureTerminator (tk : TerminatorKind) :
    checkTerminatorFragment .pureBoundedLoop tk = isPureTerminator tk := by
  cases tk with
  | switchInt discr _ => exact checkOperandFragment_pureBoundedLoop_eq_isPureOperand discr
  | assert cond _ _ _ => exact checkOperandFragment_pureBoundedLoop_eq_isPureOperand cond
  | drop p _ _ => exact checkPlaceFragment_pureBoundedLoop_eq_isPurePlace p
  | _ => rfl

/--
**Exact Block-Level Syntactic Purity Identity**:
`checkBlockFragment .pureBoundedLoop bb` equals syntactic `isPureStatement` across
`bb.statements` conjoined with `isPureTerminator bb.terminator.kind`.
-/
@[simp]
theorem checkBlockFragment_pureBoundedLoop_eq_pureStatement (bb : BasicBlockData) :
    checkBlockFragment .pureBoundedLoop bb =
      (bb.statements.all (fun s => isPureStatement s.kind) &&
       isPureTerminator bb.terminator.kind) := by
  dsimp only [checkBlockFragment]
  rw [congrArg bb.statements.all
    (funext fun stmt => checkStmtFragment_pureBoundedLoop_eq_isPureStatement stmt.kind),
    checkTerminatorFragment_pureBoundedLoop_eq_isPureTerminator]

/--
Direct implication from `checkBlockFragment .pureBoundedLoop bb = true` to
syntactic `isPureStatement` and `isPureTerminator`.
-/
theorem checkBodyFragment_pureBoundedLoop_implies_pureRvalue {bb : BasicBlockData}
    (h : checkBlockFragment .pureBoundedLoop bb = true) :
    (bb.statements.all (fun s => isPureStatement s.kind) &&
     isPureTerminator bb.terminator.kind) = true := by
  rwa [← checkBlockFragment_pureBoundedLoop_eq_pureStatement]

/--
Exact biconditional between `checkBlockFragment .pureBoundedLoop bb = true` and
syntactic `isPureStatement` + `isPureTerminator`.
-/
theorem checkBlockFragment_pureBoundedLoop_iff_pureStatement (bb : BasicBlockData) :
    checkBlockFragment .pureBoundedLoop bb = true ↔
      bb.statements.all (fun s => isPureStatement s.kind) = true ∧
      isPureTerminator bb.terminator.kind = true := by
  rw [checkBlockFragment_pureBoundedLoop_eq_pureStatement, Bool.and_eq_true]

/--
**Exact Body-Level Syntactic Purity Identity (`basicBlocks` Only)**:
`checkBodyFragment .pureBoundedLoop body` equals syntactic `isPureStatement` and
`isPureTerminator` across every block in `body.basicBlocks`.
-/
theorem checkBodyFragment_pureBoundedLoop_eq_pureStatement (body : CapturedMir) :
    checkBodyFragment .pureBoundedLoop body =
      body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) :=
  congrArg body.basicBlocks.all (funext checkBlockFragment_pureBoundedLoop_eq_pureStatement)

theorem checkBodyFragment_pureBoundedLoop_iff_pureStatement (body : CapturedMir) :
    checkBodyFragment .pureBoundedLoop body = true ↔
      body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) = true := by
  rw [checkBodyFragment_pureBoundedLoop_eq_pureStatement]

theorem checkBodyFragment_pureLoopFree_eq_pureStatement (body : CapturedMir) :
    checkBodyFragment .pureLoopFree body =
      (body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) && !hasCfgBackedge body) := by
  rw [checkBodyFragment_pureLoopFree_eq_pureBoundedLoop_and_no_backedge,
    checkBodyFragment_pureBoundedLoop_eq_pureStatement]

theorem inferMinFragment_le_pureBoundedLoop_iff_pureStatement (body : CapturedMir) :
    inferMinFragment body ≤ .pureBoundedLoop ↔
      body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) = true := by
  rw [← checkBodyFragment_pureBoundedLoop_eq_pureStatement]
  exact (checkBodyFragment_iff_inferMinFragment_le .pureBoundedLoop body).symm

theorem inferMinFragment_eq_pureLoopFree_iff_pureStatement (body : CapturedMir) :
    inferMinFragment body = .pureLoopFree ↔
      body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) = true ∧
      hasCfgBackedge body = false := by
  have h_iff := checkBodyFragment_iff_inferMinFragment_le .pureLoopFree body
  simp only [checkBodyFragment_pureLoopFree_eq_pureStatement,
    Bool.and_eq_true, Bool.not_eq_true'] at h_iff
  constructor
  · intro h
    apply h_iff.mpr
    rw [h]
    exact MirFragment.le_refl _
  · intro h
    exact MirFragment.le_antisymm (h_iff.mp h) (MirFragment.bot_le _)

theorem inferMinFragment_eq_pureBoundedLoop_iff_pureStatement (body : CapturedMir) :
    inferMinFragment body = .pureBoundedLoop ↔
      body.basicBlocks.all (fun bb =>
        bb.statements.all (fun s => isPureStatement s.kind) &&
        isPureTerminator bb.terminator.kind) = true ∧
      hasCfgBackedge body = true := by
  constructor
  · intro h
    have h_le : inferMinFragment body ≤ .pureBoundedLoop := by
      rw [h]; exact MirFragment.le_refl _
    have h_pure := (inferMinFragment_le_pureBoundedLoop_iff_pureStatement body).mp h_le
    cases h_be : hasCfgBackedge body
    · have h_plf : inferMinFragment body = .pureLoopFree :=
        (inferMinFragment_eq_pureLoopFree_iff_pureStatement body).mpr ⟨h_pure, h_be⟩
      rw [h] at h_plf
      cases h_plf
    · exact ⟨h_pure, rfl⟩
  · rintro ⟨h_pure, h_be⟩
    have h_le : inferMinFragment body ≤ .pureBoundedLoop :=
      (inferMinFragment_le_pureBoundedLoop_iff_pureStatement body).mpr h_pure
    have h_not_plf : inferMinFragment body ≠ .pureLoopFree := by
      intro h_eq
      have h_be_false :=
        ((inferMinFragment_eq_pureLoopFree_iff_pureStatement body).mp h_eq).2
      rw [h_be] at h_be_false
      cases h_be_false
    generalize inferMinFragment body = m at h_le h_not_plf
    cases m <;> first | rfl | exact absurd rfl h_not_plf | exact absurd h_le (by decide)

/--
Per-statement guard rejecting assignments `.assign _ (.binaryOp op lhs _)` whose
operator `op` is relational (`isRelationalBinOp op = true`) and whose LHS operand
`lhs` is pointer-typed or untyped in `(localDecls, layouts)`
(`isPtrOrUntypedOperand localDecls layouts lhs = true`).
-/
def isNoPtrRelationalStmt
    (localDecls : List LocalDecl) (layouts : LayoutTable) : StatementKind → Bool
  | .assign _ (.binaryOp op lhs _) =>
    !(isRelationalBinOp op && isPtrOrUntypedOperand localDecls layouts lhs)
  | _ => true

/--
Exact decomposition of `isBorrowFreePureStatement` into `basicBlocks`-only
`isPureStatement` and `(localDecls, layouts)`-aware `isNoPtrRelationalStmt`.
-/
theorem isBorrowFreePureStatement_eq_pure_and_noPtrRel
    (localDecls : List LocalDecl) (layouts : LayoutTable) (sk : StatementKind) :
    isBorrowFreePureStatement localDecls layouts sk =
      (isPureStatement sk && isNoPtrRelationalStmt localDecls layouts sk) := by
  cases sk with
  | assign p r =>
    cases r <;>
      simp [isBorrowFreePureStatement, isBorrowFreePureRvalue,
        isPureStatement, isNoPtrRelationalStmt, Bool.and_assoc]
  | _ =>
    simp [isBorrowFreePureStatement, isNoPtrRelationalStmt]

/--
Decidable check certifying that no statement in `body.basicBlocks` performs a
relational `BinOp` assignment over a pointer-typed or untyped operand in
`(body.localDecls, body.layouts)` (matching `isBorrowFreePureStatement`).

Note: `checkBodyFragment` / `inferMinFragment` intentionally scan only
`body.basicBlocks` so they stay invariant under arbitrary `CapturedMir.instantiate`
substitutions (even `T := *const u8`), whereas `hasNoPtrRelationalAssign`
inspects the monomorphized `(body.localDecls, body.layouts)`.
-/
def hasNoPtrRelationalAssign (body : CapturedMir) : Bool :=
  body.basicBlocks.all (fun bb =>
    bb.statements.all (fun stmt =>
      isNoPtrRelationalStmt body.localDecls body.layouts stmt.kind))

/--
Borrow-free strengthened fragment membership checker on `body : CapturedMir`:
- At `.pureLoopFree` (`0`) and `.pureBoundedLoop` (`1`), conjoins
  `hasNoPtrRelationalAssign body` so pointer/untyped relational `BinOp`
  assignments (which read `mem.borrows` via `ptrAddressScalar?`) require at
  least `.treeBorrowsLocal` (`2`), matching `Anneal.PureMirExec.checkPureMir`.
- At `.treeBorrowsLocal` (`2`), `.intrinsicCopy` (`3`), and `.fullMir` (`4`),
  coincides with `checkBodyFragment f body`.
-/
def checkBorrowFreeBodyFragment (f : MirFragment) (body : CapturedMir) : Bool :=
  match f with
  | .pureLoopFree =>
    checkBodyFragment .pureLoopFree body && hasNoPtrRelationalAssign body
  | .pureBoundedLoop =>
    checkBodyFragment .pureBoundedLoop body && hasNoPtrRelationalAssign body
  | .treeBorrowsLocal =>
    checkBodyFragment .treeBorrowsLocal body
  | .intrinsicCopy =>
    checkBodyFragment .intrinsicCopy body
  | .fullMir =>
    checkBodyFragment .fullMir body

/--
Computable $O(|B|)$ minimum fragment classifier in the borrow-free strengthened
layer, returning the least `MirFragment` whose `checkBorrowFreeBodyFragment`
accepts `body`.
-/
def inferBorrowFreeMinFragment (body : CapturedMir) : MirFragment :=
  if checkBorrowFreeBodyFragment .pureLoopFree body then .pureLoopFree
  else if checkBorrowFreeBodyFragment .pureBoundedLoop body then .pureBoundedLoop
  else if checkBorrowFreeBodyFragment .treeBorrowsLocal body then .treeBorrowsLocal
  else if checkBorrowFreeBodyFragment .intrinsicCopy body then .intrinsicCopy
  else .fullMir

/--
Single-pass bottom-up borrow-free fragment classifier: joins `.treeBorrowsLocal`
whenever `hasNoPtrRelationalAssign body = false`.
-/
def inferBorrowFreeMinFragmentSinglePass (body : CapturedMir) : MirFragment :=
  let base := inferMinFragmentSinglePass body
  if hasNoPtrRelationalAssign body then
    base
  else
    base.join .treeBorrowsLocal

theorem list_all_and {α : Type} (p q : α → Bool) :
    ∀ (xs : List α),
      xs.all (fun x => p x && q x) = (xs.all p && xs.all q)
  | [] => rfl
  | x :: xs => by
    simp only [List.all_cons, list_all_and p q xs]
    cases p x <;> cases q x <;> cases xs.all p <;> cases xs.all q <;> rfl

/--
**Exact `checkPureMir` Bridge Theorem**:
`checkBorrowFreeBodyFragment .pureBoundedLoop body` is extensionally identical
to `Anneal.PureMirExec.checkPureMir body` for every `body : CapturedMir`.
-/
@[simp]
theorem checkBorrowFreeBodyFragment_pureBoundedLoop_eq_checkPureMir (body : CapturedMir) :
    checkBorrowFreeBodyFragment .pureBoundedLoop body = checkPureMir body := by
  dsimp only [checkBorrowFreeBodyFragment, hasNoPtrRelationalAssign, checkPureMir]
  rw [checkBodyFragment_pureBoundedLoop_eq_pureStatement, ← list_all_and]
  refine congrArg body.basicBlocks.all (funext fun bb => ?_)
  have h_stmt_split :
      bb.statements.all (fun stmt =>
        isBorrowFreePureStatement body.localDecls body.layouts stmt.kind) =
      (bb.statements.all (fun s => isPureStatement s.kind) &&
       bb.statements.all (fun stmt =>
         isNoPtrRelationalStmt body.localDecls body.layouts stmt.kind)) := by
    rw [congrArg bb.statements.all
      (funext fun stmt =>
        isBorrowFreePureStatement_eq_pure_and_noPtrRel body.localDecls body.layouts stmt.kind),
      list_all_and]
  rw [h_stmt_split]
  cases bb.statements.all (fun s => isPureStatement s.kind) <;>
    cases isPureTerminator bb.terminator.kind <;>
    cases bb.statements.all (fun stmt =>
      isNoPtrRelationalStmt body.localDecls body.layouts stmt.kind) <;>
    rfl

/--
**Exact Borrow-Free `.pureLoopFree` Characterization**:
`checkBorrowFreeBodyFragment .pureLoopFree body` is extensionally identical to
`checkPureMir body && !hasCfgBackedge body`.
-/
theorem checkBorrowFreeBodyFragment_pureLoopFree_eq (body : CapturedMir) :
    checkBorrowFreeBodyFragment .pureLoopFree body =
      (checkPureMir body && !hasCfgBackedge body) := by
  rw [← checkBorrowFreeBodyFragment_pureBoundedLoop_eq_checkPureMir]
  dsimp only [checkBorrowFreeBodyFragment]
  rw [checkBodyFragment_pureLoopFree_eq_pureBoundedLoop_and_no_backedge]
  cases checkBodyFragment .pureBoundedLoop body <;>
    cases hasCfgBackedge body <;>
    cases hasNoPtrRelationalAssign body <;>
    rfl

theorem checkBodyFragment_of_checkBorrowFreeBodyFragment
    {f : MirFragment} {body : CapturedMir}
    (h : checkBorrowFreeBodyFragment f body = true) :
    checkBodyFragment f body = true := by
  cases f <;> simp only [checkBorrowFreeBodyFragment, Bool.and_eq_true] at h <;>
    first | exact h.1 | exact h

theorem checkBorrowFreeBodyFragment_mono {f₁ f₂ : MirFragment} (hle : f₁ ≤ f₂)
    (body : CapturedMir) (h : checkBorrowFreeBodyFragment f₁ body = true) :
    checkBorrowFreeBodyFragment f₂ body = true := by
  cases f₁ <;> cases f₂
  all_goals try exact False.elim (by revert hle; decide)
  all_goals try exact h
  · simp only [checkBorrowFreeBodyFragment, Bool.and_eq_true] at h ⊢
    exact ⟨checkBodyFragment_mono hle body h.1, h.2⟩
  all_goals
    exact checkBodyFragment_mono hle body (checkBodyFragment_of_checkBorrowFreeBodyFragment h)

@[simp]
theorem checkBorrowFreeBodyFragment_fullMir (body : CapturedMir) :
    checkBorrowFreeBodyFragment .fullMir body = true :=
  checkBodyFragment_fullMir body

theorem checkBorrowFreeBodyFragment_inferBorrowFreeMinFragment (body : CapturedMir) :
    checkBorrowFreeBodyFragment (inferBorrowFreeMinFragment body) body = true := by
  unfold inferBorrowFreeMinFragment
  split <;> first | assumption | (split <;> first | assumption | (split <;> first | assumption | (split <;> first | assumption | exact checkBorrowFreeBodyFragment_fullMir body)))

theorem inferBorrowFreeMinFragment_minimal (body : CapturedMir) (f : MirFragment)
    (hf : checkBorrowFreeBodyFragment f body = true) :
    inferBorrowFreeMinFragment body ≤ f := by
  unfold inferBorrowFreeMinFragment
  cases f with
  | pureLoopFree =>
    simp only [hf, ↓reduceIte]
    decide
  | pureBoundedLoop =>
    simp only [hf, ↓reduceIte]
    split <;> decide
  | treeBorrowsLocal =>
    simp only [hf, ↓reduceIte]
    split <;> first | decide | (split <;> decide)
  | intrinsicCopy =>
    simp only [hf, ↓reduceIte]
    split <;> first | decide | (split <;> first | decide | (split <;> decide))
  | fullMir =>
    exact MirFragment.le_top _

/--
**Galois / Lower-Adjoint Characterization of `inferBorrowFreeMinFragment`**:
`checkBorrowFreeBodyFragment f body = true ↔ inferBorrowFreeMinFragment body ≤ f`.
-/
theorem checkBorrowFreeBodyFragment_iff_inferBorrowFreeMinFragment_le
    (f : MirFragment) (body : CapturedMir) :
    checkBorrowFreeBodyFragment f body = true ↔ inferBorrowFreeMinFragment body ≤ f := by
  constructor
  · exact inferBorrowFreeMinFragment_minimal body f
  · intro hle
    exact checkBorrowFreeBodyFragment_mono hle body
      (checkBorrowFreeBodyFragment_inferBorrowFreeMinFragment body)

theorem inferBorrowFreeMinFragment_eq_filter_headD (body : CapturedMir) :
    inferBorrowFreeMinFragment body =
      (MirFragment.all.filter (fun f => checkBorrowFreeBodyFragment f body)).headD .fullMir := by
  unfold inferBorrowFreeMinFragment MirFragment.all
  cases h0 : checkBorrowFreeBodyFragment .pureLoopFree body <;>
    cases h1 : checkBorrowFreeBodyFragment .pureBoundedLoop body <;>
    cases h2 : checkBorrowFreeBodyFragment .treeBorrowsLocal body <;>
    cases h3 : checkBorrowFreeBodyFragment .intrinsicCopy body <;>
    cases h4 : checkBorrowFreeBodyFragment .fullMir body <;>
    simp [List.filter, h0, h1, h2, h3, h4]

theorem checkBorrowFreeBodyFragment_false_of_lt_inferBorrowFreeMinFragment
    {body : CapturedMir} {f : MirFragment}
    (hf : f < inferBorrowFreeMinFragment body) :
    checkBorrowFreeBodyFragment f body = false := by
  cases h : checkBorrowFreeBodyFragment f body
  · rfl
  · exact absurd (inferBorrowFreeMinFragment_minimal body f h) (Nat.not_le_of_lt hf)

theorem checkBorrowFreeBodyFragment_eq_decide_singlePass
    (f : MirFragment) (body : CapturedMir) :
    checkBorrowFreeBodyFragment f body =
      decide (inferBorrowFreeMinFragmentSinglePass body ≤ f) := by
  unfold inferBorrowFreeMinFragmentSinglePass
  cases h_no : hasNoPtrRelationalAssign body <;>
    cases f <;>
    dsimp only [checkBorrowFreeBodyFragment] <;>
    rw [checkBodyFragment_eq_decide_singlePass] <;>
    (try rw [h_no]) <;>
    cases inferMinFragmentSinglePass body <;>
    rfl

/--
**Isomorphism of Top-Down and Single-Pass Borrow-Free Fragment Inference**:
`inferBorrowFreeMinFragmentSinglePass body = inferBorrowFreeMinFragment body`.
-/
theorem inferBorrowFreeMinFragmentSinglePass_eq_inferBorrowFreeMinFragment
    (body : CapturedMir) :
    inferBorrowFreeMinFragmentSinglePass body = inferBorrowFreeMinFragment body := by
  apply MirFragment.le_antisymm
  · have h_in : checkBorrowFreeBodyFragment (inferBorrowFreeMinFragment body) body = true :=
      checkBorrowFreeBodyFragment_inferBorrowFreeMinFragment body
    rw [checkBorrowFreeBodyFragment_eq_decide_singlePass, decide_eq_true_eq] at h_in
    exact h_in
  · apply inferBorrowFreeMinFragment_minimal
    rw [checkBorrowFreeBodyFragment_eq_decide_singlePass, decide_eq_true_eq]
    exact MirFragment.le_refl _

/--
Closed-form relationship between `inferBorrowFreeMinFragment` and syntactic
`inferMinFragment`: pointer/untyped relational `BinOp` assignments escalate pure
bodies to `.treeBorrowsLocal` and leave `≥ .treeBorrowsLocal` bodies unchanged.
-/
theorem inferBorrowFreeMinFragment_eq_ite_hasNoPtrRelationalAssign (body : CapturedMir) :
    inferBorrowFreeMinFragment body =
      if hasNoPtrRelationalAssign body then
        inferMinFragment body
      else
        (inferMinFragment body).join .treeBorrowsLocal := by
  rw [← inferBorrowFreeMinFragmentSinglePass_eq_inferBorrowFreeMinFragment,
    ← inferMinFragmentSinglePass_eq_inferMinFragment]
  rfl

theorem inferBorrowFreeMinFragment_eq_inferMinFragment_of_hasNoPtrRelationalAssign
    {body : CapturedMir} (h : hasNoPtrRelationalAssign body = true) :
    inferBorrowFreeMinFragment body = inferMinFragment body := by
  rw [inferBorrowFreeMinFragment_eq_ite_hasNoPtrRelationalAssign, h]
  rfl

theorem inferMinFragment_le_inferBorrowFreeMinFragment (body : CapturedMir) :
    inferMinFragment body ≤ inferBorrowFreeMinFragment body := by
  rw [inferBorrowFreeMinFragment_eq_ite_hasNoPtrRelationalAssign]
  cases hasNoPtrRelationalAssign body
  · exact MirFragment.le_join_left _ _
  · exact MirFragment.le_refl _

/--
Any body containing a pointer-typed or untyped relational `BinOp` assignment
(`hasNoPtrRelationalAssign body = false`) is rejected at every borrow-free
fragment level `f < .treeBorrowsLocal`.
-/
theorem no_ptrRelationalAssign_below_treeBorrowsLocal
    (f : MirFragment) (hf : f < .treeBorrowsLocal)
    (body : CapturedMir) (h_ptr : hasNoPtrRelationalAssign body = false) :
    checkBorrowFreeBodyFragment f body = false := by
  cases f with
  | pureLoopFree | pureBoundedLoop =>
    simp [checkBorrowFreeBodyFragment, h_ptr]
  | treeBorrowsLocal | intrinsicCopy | fullMir =>
    exact absurd hf (by decide)

/--
Any body with `hasNoPtrRelationalAssign body = false` has
`.treeBorrowsLocal ≤ inferBorrowFreeMinFragment body`.
-/
theorem treeBorrowsLocal_le_inferBorrowFreeMinFragment_of_ptrRel
    {body : CapturedMir} (h_ptr : hasNoPtrRelationalAssign body = false) :
    .treeBorrowsLocal ≤ inferBorrowFreeMinFragment body := by
  rw [inferBorrowFreeMinFragment_eq_ite_hasNoPtrRelationalAssign, h_ptr]
  exact MirFragment.le_join_right _ _

/--
Biconditional bridge between `inferBorrowFreeMinFragment body ≤ .pureBoundedLoop`
and `Anneal.PureMirExec.checkPureMir body = true`.
-/
theorem inferBorrowFreeMinFragment_le_pureBoundedLoop_iff_checkPureMir
    (body : CapturedMir) :
    inferBorrowFreeMinFragment body ≤ .pureBoundedLoop ↔
      checkPureMir body = true := by
  rw [← checkBorrowFreeBodyFragment_pureBoundedLoop_eq_checkPureMir]
  exact (checkBorrowFreeBodyFragment_iff_inferBorrowFreeMinFragment_le
    .pureBoundedLoop body).symm

/--
`inferBorrowFreeMinFragment body = .pureLoopFree` iff `checkPureMir body = true`
and `hasCfgBackedge body = false`.
-/
theorem inferBorrowFreeMinFragment_eq_pureLoopFree_iff (body : CapturedMir) :
    inferBorrowFreeMinFragment body = .pureLoopFree ↔
      checkPureMir body = true ∧ hasCfgBackedge body = false := by
  have h_iff :=
    checkBorrowFreeBodyFragment_iff_inferBorrowFreeMinFragment_le .pureLoopFree body
  simp only [checkBorrowFreeBodyFragment_pureLoopFree_eq,
    Bool.and_eq_true, Bool.not_eq_true'] at h_iff
  constructor
  · intro h
    apply h_iff.mpr
    rw [h]
    exact MirFragment.le_refl _
  · intro h
    exact MirFragment.le_antisymm (h_iff.mp h) (MirFragment.bot_le _)

/--
`inferBorrowFreeMinFragment body = .pureBoundedLoop` iff `checkPureMir body = true`
and `hasCfgBackedge body = true`.
-/
theorem inferBorrowFreeMinFragment_eq_pureBoundedLoop_iff (body : CapturedMir) :
    inferBorrowFreeMinFragment body = .pureBoundedLoop ↔
      checkPureMir body = true ∧ hasCfgBackedge body = true := by
  constructor
  · intro h
    have h_le : inferBorrowFreeMinFragment body ≤ .pureBoundedLoop := by
      rw [h]; exact MirFragment.le_refl _
    have h_pure : checkPureMir body = true :=
      (inferBorrowFreeMinFragment_le_pureBoundedLoop_iff_checkPureMir body).mp h_le
    cases h_be : hasCfgBackedge body
    · have h_plf : inferBorrowFreeMinFragment body = .pureLoopFree :=
        (inferBorrowFreeMinFragment_eq_pureLoopFree_iff body).mpr ⟨h_pure, h_be⟩
      rw [h] at h_plf
      cases h_plf
    · exact ⟨h_pure, rfl⟩
  · rintro ⟨h_pure, h_be⟩
    have h_le : inferBorrowFreeMinFragment body ≤ .pureBoundedLoop :=
      (inferBorrowFreeMinFragment_le_pureBoundedLoop_iff_checkPureMir body).mpr h_pure
    have h_not_plf : inferBorrowFreeMinFragment body ≠ .pureLoopFree := by
      intro h_eq
      have h_be_false :=
        ((inferBorrowFreeMinFragment_eq_pureLoopFree_iff body).mp h_eq).2
      rw [h_be] at h_be_false
      cases h_be_false
    generalize inferBorrowFreeMinFragment body = m at h_le h_not_plf
    cases m <;> first | rfl | exact absurd rfl h_not_plf | exact absurd h_le (by decide)

/--
Extract `checkPureMir body = true` from
`inferBorrowFreeMinFragment body ≤ .pureBoundedLoop`.
-/
theorem checkPureMir_of_inferBorrowFreeMinFragment_le_pureBoundedLoop
    (body : CapturedMir)
    (h : inferBorrowFreeMinFragment body ≤ .pureBoundedLoop) :
    checkPureMir body = true :=
  (inferBorrowFreeMinFragment_le_pureBoundedLoop_iff_checkPureMir body).mp h

/--
Extract `checkPureMir body = true` from `checkBorrowFreeBodyFragment f body = true`
for any `f ≤ .pureBoundedLoop`.
-/
theorem checkPureMir_of_borrowFreeFragment_le_pureBoundedLoop
    {body : CapturedMir} {f : MirFragment}
    (h_frag : checkBorrowFreeBodyFragment f body = true)
    (h_le : f ≤ .pureBoundedLoop := by decide) :
    checkPureMir body = true := by
  rw [← checkBorrowFreeBodyFragment_pureBoundedLoop_eq_checkPureMir]
  exact checkBorrowFreeBodyFragment_mono h_le body h_frag

/--
Extract `checkPureMir body = true` from syntactic `inferMinFragment body ≤ .pureBoundedLoop`
together with `hasNoPtrRelationalAssign body = true` (auto-discharged by `decide`
on concrete `CapturedMir` bodies).
-/
theorem checkPureMir_of_inferMinFragment_le_pureBoundedLoop
    (body : CapturedMir)
    (h : inferMinFragment body ≤ .pureBoundedLoop)
    (h_no_ptr_rel : hasNoPtrRelationalAssign body = true := by decide) :
    checkPureMir body = true := by
  rw [← checkBorrowFreeBodyFragment_pureBoundedLoop_eq_checkPureMir]
  dsimp only [checkBorrowFreeBodyFragment]
  rw [(checkBodyFragment_iff_inferMinFragment_le .pureBoundedLoop body).mpr h,
    h_no_ptr_rel]
  rfl

/--
Extract `checkPureMir body = true` from syntactic `checkBodyFragment f body = true`
(`f ≤ .pureBoundedLoop`) and `hasNoPtrRelationalAssign body = true`.
-/
theorem checkPureMir_of_bodyFragment_le_pureBoundedLoop
    {body : CapturedMir} {f : MirFragment}
    (h_frag : checkBodyFragment f body = true)
    (h_le : f ≤ .pureBoundedLoop := by decide)
    (h_no_ptr_rel : hasNoPtrRelationalAssign body = true := by decide) :
    checkPureMir body = true :=
  checkPureMir_of_inferMinFragment_le_pureBoundedLoop body
    (MirFragment.le_trans (inferMinFragment_minimal body f h_frag) h_le)
    h_no_ptr_rel

/-! #### Adequacy Bridges (`VerificationResult`, `StatefulVerificationResult`, `TotalVerificationResult`) -/

/--
Stateless panic-forbidding verification bridge from
`inferMinFragment c.body ≤ .pureBoundedLoop` and `hasNoPtrRelationalAssign c.body`.
-/
theorem verifyMirNoPanic_of_inferMinFragment_le_pureBoundedLoop
    (c : Claim)
    (h_frag : inferMinFragment c.body ≤ .pureBoundedLoop)
    (h_exec : ∀ args, c.pre args →
      PureMirConverges c.body (initPureState c.body args) (c.post args))
    (h_no_ptr_rel : hasNoPtrRelationalAssign c.body = true := by decide) :
    VerificationResult c :=
  verifyMirNoPanic_of_pureExec c
    (checkPureMir_of_inferMinFragment_le_pureBoundedLoop c.body h_frag h_no_ptr_rel)
    h_exec

