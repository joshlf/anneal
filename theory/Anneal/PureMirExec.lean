  rw [h_cl]

theorem evalDirectRustIntrinsic?_pushBaseStack_of_noCallWP
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (ms : MachineState) (curBody : CapturedMir)
    (target : ResolvedCallTarget) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (unwind : UnwindAction)
    (stepNode : MirStepNode)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_di :
      evalDirectRustIntrinsic? ms (some curBody) target
        curBody.localDecls curBody.layouts argOps argVals locals'
        destination targetBb unwind = some stepNode)
    (h_st : evalNodeNoCallWP Q (mirNormalPost P) stepNode)
    (h_bor : baseStack = [] ∨ ms.memory.borrows = []) :
    ∃ nextSt : MachineState,
      stepNode = MirStepNode.step nextSt ∧
      evalDirectRustIntrinsic? (MachineState.pushBaseStack calleeBody baseStack ms)
        (some curBody) target curBody.localDecls curBody.layouts argOps
        argVals locals' destination targetBb unwind =
        some (MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack nextSt)) := by
  cases h_cl : classifyRustIntrinsic? target.defPath with
  | none =>
    unfold evalDirectRustIntrinsic? at h_di
    rw [h_cl] at h_di
    cases h_di
  | some rk =>
    by_cases h_cs : rk = .constEvalSelect
    · subst h_cs
      rcases argVals with _ | ⟨tupleArgVal, _ | ⟨ctFnVal, _ | ⟨rtFnVal, _ | _⟩⟩⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · rw [evalDirectRustIntrinsic?_constEvalSelect_three _ _ _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di ⊢
        injection h_di with h_sn
        subst h_sn
        revert h_st
        unfold evalConstEvalSelectThree
        dsimp only
        cases unpackConstEvalSelectArgs? tupleArgVal (selectTupleTyOpt target.typeArgs) with
        | none => intro h_st; exact False.elim h_st
        | some unpackedArgs =>
          dsimp only
          have h_res_eq :
              resolveConstEvalSelectTarget?
                (MachineState.pushBaseStack calleeBody baseStack ms) target
                curBody.localDecls curBody.layouts
                (selectRtFnOpOpt argOps) rtFnVal (length unpackedArgs) =
              resolveConstEvalSelectTarget? ms target curBody.localDecls
                curBody.layouts (selectRtFnOpOpt argOps) rtFnVal
                (length unpackedArgs) := rfl
          rw [h_res_eq]
          cases
            resolveConstEvalSelectTarget? ms target curBody.localDecls
              curBody.layouts (selectRtFnOpOpt argOps) rtFnVal
              (length unpackedArgs) with
          | none => intro h_st; exact False.elim h_st
          | some rtTarget =>
            dsimp only
            have h_lk_eq :
                lookupCallee
                  (MachineState.pushBaseStack calleeBody baseStack ms).memory.callees
                  curBody.layouts rtTarget.defPath rtTarget.typeArgs
                  (MachineState.pushBaseStack calleeBody baseStack ms).memory.traitImpls =
                lookupCallee ms.memory.callees curBody.layouts rtTarget.defPath
                  rtTarget.typeArgs ms.memory.traitImpls := rfl
            rw [h_lk_eq]
            cases
              lookupCallee ms.memory.callees curBody.layouts
                rtTarget.defPath rtTarget.typeArgs ms.memory.traitImpls with
            | some subCallee =>
              dsimp only
              cases constEvalSelectCalleeCompatible rtTarget subCallee (length unpackedArgs) with
              | false => intro h_st; exact False.elim h_st
              | true =>
                intro _
                refine ⟨pushCalleeFrame ms curBody locals' destination targetBb
                  subCallee (constEvalSelectEntryArgs subCallee unpackedArgs) unwind, rfl, ?_⟩
                rcases baseStack with _ | ⟨_, _⟩ <;> rfl
            | none =>
              dsimp only
              cases rtTarget.isIndirect with
              | true =>
                cases isGenericClosureArityMismatch ms.memory.callees rtTarget.defPath rtTarget.typeArgs <;>
                  (intro h_st; exact False.elim h_st)
              | false =>
                dsimp only
                cases isDirectExactDivTarget rtTarget with
                | true =>
                  dsimp only
                  rcases unpackedArgs with _ | ⟨_ | lhs | _ | _ | _, _ | ⟨_ | rhs | _ | _ | _, _ | _⟩⟩ <;>
                    try (intro h_st; exact False.elim h_st)
                  dsimp only
                  cases
                    resolveIntrinsicIsSigned
                      (withConstEvalSelectIntrinsicTypeArgs rtTarget
                        (selectTupleTyOpt target.typeArgs) false)
                      curBody.localDecls curBody.layouts
                      (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs)) with
                  | none => intro h_st; exact False.elim h_st
                  | some isSigned =>
                    dsimp only [writeIntrinsicScalarResult]
                    cases evalExactDiv lhs rhs isSigned with
                    | none => intro h_st; exact False.elim h_st
                    | some retSc =>
                      intro h_st
                      rcases writeIntrinsicReturn_pushBaseStack_of_noCallWP
                          calleeBody baseStack ms locals' destination targetBb
                          (.scalar retSc) h_st h_bor with ⟨nextSt, h1, h2⟩
                      exact ⟨nextSt, h1, congrArg some h2⟩
                | false =>
                  dsimp only
                  cases classifyRustIntrinsic? rtTarget.defPath with
                  | some rtKind =>
                    have h_step : ∀ (k : RustIntrinsicKind),
                        evalNodeNoCallWP Q (mirNormalPost P)
                          (match evalCoreMemPtrIntrinsicCall? k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) →
                        ∃ nextSt,
                          (match evalCoreMemPtrIntrinsicCall? k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) = MirStepNode.step nextSt ∧
                          some (match evalCoreMemPtrIntrinsicCall? k (MachineState.pushBaseStack calleeBody baseStack ms)
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k (MachineState.pushBaseStack calleeBody baseStack ms)
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) =
                            some (MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack nextSt)) := by
                      intro k h_st
                      cases h_cm : evalCoreMemPtrIntrinsicCall? k ms _ curBody.localDecls curBody.layouts
                          _ unpackedArgs locals' destination (.some targetBb) with
                      | some sn =>
                        rw [h_cm] at h_st
                        rcases evalCoreMemPtrIntrinsicCall?_pushBaseStack_of_noCallWP
                            calleeBody baseStack k ms _ curBody.localDecls curBody.layouts
                            _ unpackedArgs locals' destination targetBb h_cm h_st h_bor with ⟨nextSt, h1, h2⟩
                        rw [h2]
                        exact ⟨nextSt, h1, rfl⟩
                      | none =>
                        rw [h_cm] at h_st
                        have h_cm2 : evalCoreMemPtrIntrinsicCall? k (MachineState.pushBaseStack calleeBody baseStack ms)
                            (withConstEvalSelectIntrinsicTypeArgs rtTarget
                              (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                            curBody.localDecls curBody.layouts
                            (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                            unpackedArgs locals' destination (.some targetBb) = none := by
                          cases k <;> first | rfl | cases h_cm
                        rw [h_cm2]
                        rcases evalNonSelectIntrinsicCall_pushBaseStack_of_noCallWP
                            calleeBody baseStack k ms _ curBody.localDecls curBody.layouts
                            _ unpackedArgs locals' destination targetBb (Q := Q) (P := P) h_st h_bor with ⟨nextSt, h1, h2⟩
                        exact ⟨nextSt, h1, congrArg some h2⟩
                    cases h_cs2 : (match rtKind with | .constEvalSelect => true | _ => false) with
                    | true =>
                      have : rtKind = .constEvalSelect := by cases rtKind <;> first | rfl | cases h_cs2
                      subst this; intro h_st; exact False.elim h_st
                    | false =>
                      have h_eq : ∀ (st : MachineState),
                          (match some rtKind with
                           | some .constEvalSelect => MirStepNode.fail .ub
                           | some k =>
                             match evalCoreMemPtrIntrinsicCall? k st
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 curBody.localDecls curBody.layouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination (.some targetBb) with
                             | some sn => sn
                             | none => evalNonSelectIntrinsicCall k st
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 curBody.localDecls curBody.layouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination targetBb
                           | none =>
                             match isUnreachableCallTarget rtTarget.defPath with
                             | true => MirStepNode.fail .ub
                             | false =>
                               match isAbortingPanicDefPath rtTarget.defPath with
                               | true => MirStepNode.retOutcome .abort
                               | false =>
                                 match isUnwindingPanicDefPath rtTarget.defPath with
                                 | true =>
                                   match applyUnwindAction st locals' st.memory unwind with
                                   | .running nextState => MirStepNode.step nextState
                                   | .halted out => MirStepNode.retOutcome out
                                   | .faulted fk => MirStepNode.fail fk
                                 | false =>
                                   MirStepNode.extCall
                                     { defPath := rtTarget.defPath, typeArgs := rtTarget.typeArgs,
                                       args := unpackedArgs, memory := st.memory }
                                     (resumeExternalCall st locals' destination targetBb unwind)) =
                          (match evalCoreMemPtrIntrinsicCall? rtKind st
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall rtKind st
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) := fun st => by
                        cases rtKind <;> first | (cases h_cs2; done) | rfl
                      rw [h_eq ms, h_eq (MachineState.pushBaseStack calleeBody baseStack ms)]
                      exact h_step rtKind
                  | none =>
                    dsimp only
                    cases isUnreachableCallTarget rtTarget.defPath with
                    | true => intro h_st; exact False.elim h_st
                    | false =>
                      dsimp only
                      cases isAbortingPanicDefPath rtTarget.defPath with
                      | true => intro h_st; exact False.elim h_st
                      | false =>
                        dsimp only
                        cases isUnwindingPanicDefPath rtTarget.defPath with
                        | false => intro h_st; exact False.elim h_st
                        | true =>
                          dsimp only
                          intro h_st
                          have h_np :
                              applyUnwindAction ms locals' ms.memory unwind ≠
                                .halted .panic := by
                            intro hp; rw [hp] at h_st; exact h_st
                          have h_nu :
                              applyUnwindAction ms locals' ms.memory unwind ≠
                                .faulted .ub := by
                            intro hu; rw [hu] at h_st; exact h_st
                          have h_ap_eq := applyUnwindAction_pushBaseStack_of_ne_panic
                            calleeBody baseStack ms locals' unwind h_np h_nu h_bor
                          change
                            applyUnwindAction
                              (MachineState.pushBaseStack calleeBody baseStack ms)
                              locals'
                              (MachineState.pushBaseStack calleeBody baseStack ms).memory
                              unwind = _ at h_ap_eq
                          rw [h_ap_eq]
                          cases h_ap : applyUnwindAction ms locals' ms.memory unwind with
                          | running nextSt => exact ⟨nextSt, rfl, rfl⟩
                          | halted out =>
                            rw [h_ap] at h_st
                            cases out with
                            | panic => exact False.elim h_st
                            | abort => exact False.elim h_st
                            | normal rv =>
                              exact False.elim
                                (applyUnwindAction_ne_normal ms locals' ms.memory unwind rv h_ap)
                          | faulted _ => rw [h_ap] at h_st; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
    · by_cases h_cn : rk = .copyNonOverlapping
      · subst h_cn
        rw [evalDirectRustIntrinsic?_copyNonOverlapping _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di ⊢
        injection h_di with h_sn
        subst h_sn
        rcases evalCopyNonOverlappingCall_pushBaseStack_of_noCallWP calleeBody baseStack ms
            curBody.localDecls curBody.layouts argOps argVals locals' destination targetBb
            h_st h_bor with ⟨nextSt, h1, h2⟩
        exact ⟨nextSt, h1, congrArg some h2⟩
      by_cases h_wb : rk = .writeBytes
      · subst h_wb
        rw [evalDirectRustIntrinsic?_writeBytes _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di ⊢
        injection h_di with h_sn
        subst h_sn
        rcases evalWriteBytesCall_pushBaseStack_of_noCallWP calleeBody baseStack ms target
            curBody.localDecls curBody.layouts argOps argVals locals' destination targetBb
            h_st h_bor with ⟨nextSt, h1, h2⟩
        exact ⟨nextSt, h1, congrArg some h2⟩
      cases h_cmk : isCoreMemPtrIntrinsicKind rk with
      | true =>
        rcases evalDirectRustIntrinsic?_coreMemPtr ms (some curBody) target curBody.localDecls
            curBody.layouts argOps argVals locals' destination targetBb unwind h_cl h_cmk with
          ⟨sn0, h_cm0, h_eq0⟩
        rw [h_eq0] at h_di
        injection h_di with h_sn; subst h_sn
        rcases evalCoreMemPtrIntrinsicCall?_pushBaseStack_of_noCallWP calleeBody baseStack rk ms
            target curBody.localDecls curBody.layouts argOps argVals locals' destination targetBb
            h_cm0 h_st h_bor with ⟨nextSt, h1, h2⟩
        rcases evalDirectRustIntrinsic?_coreMemPtr (MachineState.pushBaseStack calleeBody baseStack ms)
            (some curBody) target curBody.localDecls curBody.layouts argOps argVals locals'
            destination targetBb unwind h_cl h_cmk with ⟨sn1, h_cm1, h_eq1⟩
        rw [h2] at h_cm1
        injection h_cm1 with h_sn1; subst h_sn1
        exact ⟨nextSt, h1, h_eq1⟩
      | false =>
        rw [evalDirectRustIntrinsic?_nonSelect _ _ _ _ _ _ _ _ _ _ _ h_cl h_cs h_cn h_wb h_cmk] at h_di ⊢
        injection h_di with h_sn
        subst h_sn
        rcases evalNonSelectIntrinsicCall_pushBaseStack_of_noCallWP calleeBody
            baseStack rk ms target curBody.localDecls curBody.layouts argOps
            argVals locals' destination targetBb h_st h_bor with ⟨nextSt, h1, h2⟩
        exact ⟨nextSt, h1, congrArg some h2⟩


private theorem evalSliceFatPtrDerefRead_nil_borrows_callStack
    (locals : List LocalSlot) (ptrVal : ProvenancePtr) (ptrSz : Nat)
    (lenSc : ScalarInt) (restProj : List ProjectionElem)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (pointeeTyOpt : Option Ty)
    (localDecls : List LocalDecl) (accessedTyOpt : Option Ty)
    (cs : List SavedCallerFrame) :
    evalSliceFatPtrDerefRead locals ptrVal ptrSz lenSc restProj [] globals
        layouts callerLocals pointeeTyOpt localDecls accessedTyOpt cs =
      evalSliceFatPtrDerefRead locals ptrVal ptrSz lenSc restProj [] globals
        layouts callerLocals pointeeTyOpt localDecls accessedTyOpt [] := by
  unfold evalSliceFatPtrDerefRead
  dsimp only [lookupBorrow]

theorem evalPlaceRead_nil_borrows_callStack
    (locals : List LocalSlot) (p : Place)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (localDecls : List LocalDecl)
    (cs : List SavedCallerFrame) :
    evalPlaceRead locals p [] globals layouts callerLocals localDecls cs =
      evalPlaceRead locals p [] globals layouts callerLocals localDecls [] := by
  rcases p with ⟨loc, proj⟩
  cases proj with
  | nil => rfl
  | cons hd tl =>
    cases hd with
    | deref =>
      unfold evalPlaceRead; dsimp only
      cases get? locals loc with
      | none => rfl
      | some sl =>
        cases sl with
        | uninit | dead => rfl
        | init v =>
          cases v with
          | unit | scalar _ | ptr _ _ | uninit => rfl
          | aggregate var fields =>
            cases var with
            | succ _ => rfl
            | zero =>
              cases fields with
              | nil => rfl
              | cons f1 tl1 =>
                cases f1 with
                | unit | scalar _ | aggregate _ _ | uninit => rfl
                | ptr ptrVal ptrSz =>
                  cases tl1 with
                  | nil => rfl
                  | cons f2 tl2 =>
                    cases f2 with
                    | unit | ptr _ _ | aggregate _ _ | uninit => rfl
                    | scalar lenSc =>
                      cases tl2 with
                      | cons _ _ => rfl
                      | nil =>
                        simp only [Nat.zero_eq]
                        exact evalSliceFatPtrDerefRead_nil_borrows_callStack ..
    | _ => rfl

theorem evalOperand_nil_borrows_callStack
    (locals : List LocalSlot) (op : Operand)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (localDecls : List LocalDecl)
    (cs : List SavedCallerFrame) :
    evalOperand locals op [] globals layouts callerLocals localDecls cs =
      evalOperand locals op [] globals layouts callerLocals localDecls [] := by
  cases op with
  | constant _ => rfl
  | copy p | move p =>
    rcases p with ⟨loc, proj⟩
    cases proj with
    | nil => rfl
    | cons hd tl =>
      cases hd with
      | deref =>
        unfold evalOperand; dsimp only
        cases get? locals loc with
        | none => rfl
        | some sl =>
          cases sl with
          | uninit | dead => rfl
          | init v =>
            cases v with
            | unit | scalar _ | ptr _ _ | uninit => rfl
            | aggregate var fields =>
              cases var with
              | succ _ => rfl
              | zero =>
                cases fields with
                | nil => rfl
                | cons f1 tl1 =>
                  cases f1 with
                  | unit | scalar _ | aggregate _ _ | uninit => rfl
                  | ptr ptrVal ptrSz =>
                    cases tl1 with
                    | nil => rfl
                    | cons f2 tl2 =>
                      cases f2 with
                      | unit | ptr _ _ | aggregate _ _ | uninit => rfl
                      | scalar lenSc =>
                        cases tl2 with
                        | cons _ _ => rfl
                        | nil =>
                          simp only [Nat.zero_eq]
                          cases localDecls <;>
                            exact evalSliceFatPtrDerefRead_nil_borrows_callStack ..
      | _ => rfl

theorem evalOperands_nil_borrows_callStack
    (locals : List LocalSlot) (ops : List Operand)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (localDecls : List LocalDecl)
    (cs : List SavedCallerFrame) :
    evalOperands locals ops [] globals layouts callerLocals localDecls cs =
      evalOperands locals ops [] globals layouts callerLocals localDecls [] := by
  induction ops generalizing locals with
  | nil => rfl
  | cons op rest ih =>
    unfold evalOperands
    rw [evalOperand_nil_borrows_callStack]
    cases evalOperand locals op [] globals layouts callerLocals localDecls [] with
    | ub => rfl
    | unsupported => rfl
    | ok v locals₁ =>
      dsimp only
      rw [ih locals₁]

theorem evalOperandWithBodyCast_nil_borrows_callStack
    (locals : List LocalSlot) (op : Operand)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (bodyLocalDecls : List LocalDecl)
    (cs : List SavedCallerFrame) :
    evalOperandWithBodyCast locals op [] globals layouts callerLocals bodyLocalDecls cs =
      evalOperandWithBodyCast locals op [] globals layouts callerLocals bodyLocalDecls [] := by
  unfold evalOperandWithBodyCast
  cases operandIsLeadingOpaqueCastMove op <;>
    exact evalOperand_nil_borrows_callStack ..

theorem evalOperandsWithBodyCast_nil_borrows_callStack
    (locals : List LocalSlot) (ops : List Operand)
    (globals : List CapturedAllocation) (layouts : LayoutTable)
    (callerLocals : List LocalSlot) (bodyLocalDecls : List LocalDecl)
    (cs : List SavedCallerFrame) :
