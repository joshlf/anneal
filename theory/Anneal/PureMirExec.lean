private theorem evalUnsizeCoercion_ne_nil {locals op ty mem ld ly} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalUnsizeCoercion locals op ty mem ld ly) := by
  unfold evalUnsizeCoercion; dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact rok_ok_cons | split)

private theorem evalSliceFatPtrDerefBorrow_ne_nil
    {l mem pp ps ls rp pm im pt ly cp ld fp ca} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalSliceFatPtrDerefBorrow l mem pp ps ls rp pm im pt ly cp ld fp ca) := by
  unfold evalSliceFatPtrDerefBorrow; dsimp only
  cases Bool.and (Nat.beq ps (layoutPointerBytes ly)) (Nat.beq ls.sizeBytes (layoutPointerBytes ly)) with
  | false => exact rok_ub
  | true =>
    dsimp only
    cases resolveBorrowProjectionElems l (stripTransparentProjections rp) with
    | none => exact rok_ub
    | some _ =>
      dsimp only
      cases lookupBorrow mem.borrows pp.tag <;>
        repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact rok_ok_cons | split)

private theorem evalGlobalThinPtrDerefBorrow_ne_nil
    {l mem al pp ps rp im pt ly ld rm fp} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalGlobalThinPtrDerefBorrow l mem al pp ps rp im pt ly ld rm fp) := by
  unfold evalGlobalThinPtrDerefBorrow; dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact rok_ok_cons | split)

private theorem evalScalarSliceFatPtrDerefRaw_ne_nil
    {l mem pp ps ls rp mutab pt} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalScalarSliceFatPtrDerefRaw l mem pp ps ls rp mutab pt) := by
  unfold evalScalarSliceFatPtrDerefRaw; try dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)

private theorem evalReifyFnPointer_ne_nil {locals op ty mem ld ly ck} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalReifyFnPointer locals op ty mem ld ly ck) := by
  unfold evalReifyFnPointer
  cases isReifyFnPointerCoercion ck with
  | false =>
    dsimp only
    repeat' (first
      | exact rok_ub
      | exact rok_unsup
      | exact rok_ok h
      | exact rok_ok_cons
      | exact evalUnsizeCoercion_ne_nil h
      | exact deriveStackElemThinPtr_ne_nil h
      | split)
  | true =>
    cases stringEq ck "UnsafeFnPointer" with
    | true => exact evalUnsafeFnPointer_ne_nil h
    | false =>
      dsimp only
      cases evalOperand locals op mem.borrows mem.globals ly mem.callerLocals [] mem.callStack with
      | ub => exact rok_ub
      | unsupported => exact rok_unsup
      | ok v l' =>
        dsimp only
        repeat' (first
          | exact rok_ub
          | exact rok_unsup
          | exact rok_ok h
          | exact rok_ok (internFnPtr_ne_nil _ _ _ h)
          | split)

private theorem evalFnPtrToPtr_ne_nil {locals op ty mem ld ly} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalFnPtrToPtr locals op ty mem ld ly) := by
  unfold evalFnPtrToPtr; dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)

private theorem evalByteCast_ne_nil {locals op ty mem ld ly} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalByteCast locals op ty mem ld ly) := by
  cases h0 : evalOperand locals op mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
  | ub => rw [evalByteCast_ub_of_load h0]; exact rok_ub
  | unsupported => rw [evalByteCast_unsupported_of_load h0]; exact rok_unsup
  | ok v l' =>
    rw [evalByteCast_ok_of_load h0]
    rcases evalByteCastBody_shape op ty ld ly v l' with h_ub | h_un | ⟨v', h_ok⟩
    · rw [h_ub mem]; exact rok_ub
    · rw [h_un mem]; exact rok_unsup
    · rw [h_ok mem]; exact rok_ok h

private theorem evalScalarBinOp_ne_nil {op lhs rhs l mem sgn} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalScalarBinOp op lhs rhs l mem sgn) := by
  rw [evalScalarBinOp_eq_withMem]
  cases evalScalarBinOp op lhs rhs l emptyMemory sgn with
  | ub => exact rok_ub
  | unsupported => exact rok_unsup
  | ok _ _ _ => exact rok_ok h

private theorem evalRvalueRefDeref_ne_nil {locals bk place rp pm mem ld ly} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalRvalueRefDeref locals bk place rp pm mem ld ly) := by
  dsimp only [evalRvalueRefDeref]
  repeat' (first
    | exact rok_ub
    | exact rok_unsup
    | exact rok_ok h
    | exact rok_ok_cons
    | exact evalSliceFatPtrDerefBorrow_ne_nil h
    | exact evalGlobalThinPtrDerefBorrow_ne_nil h
    | exact rok_ok (freezeTreeBorrowsOnReadAtProj_ne_nil nofun)
    | split)

private theorem evalRvalueRawPtr_ne_nil {locals mutab place mem ld ly} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalRvalueRawPtr locals mutab place mem ld ly) := by
  rcases place with ⟨pLoc, _ | ⟨phd, restProj⟩⟩
  · dsimp only [evalRvalueRawPtr]
    cases get? locals pLoc with
    | none => exact rok_ub
    | some sl =>
      cases sl with
      | dead => exact rok_ub
      | uninit | init _ => exact rok_ok_cons
  · cases phd with
    | deref =>
      dsimp only [evalRvalueRawPtr]
      repeat' (first
        | exact rok_ub
        | exact rok_unsup
        | exact rok_ok h
        | exact rok_ok_cons
        | exact evalSliceFatPtrDerefBorrow_ne_nil h
        | exact evalGlobalThinPtrDerefBorrow_ne_nil h
        | exact evalScalarSliceFatPtrDerefRaw_ne_nil h
        | split)
    | _ =>
      dsimp only [evalRvalueRawPtr]
      cases get? locals pLoc with
      | none => exact rok_ub
      | some sl =>
        cases sl with
        | dead => exact rok_ub
        | uninit | init _ =>
          dsimp only
          cases resolveBorrowProjectionElems locals _ with
          | none => exact rok_ub
          | some rp =>
            dsimp only
            cases projHasSubslice rp with
            | false => exact rok_ok_cons
            | true =>
              dsimp only
              cases validateNonDerefSubslices locals ld ly pLoc _ rp with
              | true => exact rok_ok_cons
              | false => exact rok_ub

private theorem evalPtrOffsetBinOp_ne_nil {l mem ld ly lhsOp pv sz rs} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalPtrOffsetBinOp l mem ld ly lhsOp pv sz rs) := by
  unfold evalPtrOffsetBinOp; try dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)

private theorem evalScalarPtrOffsetBinOp_ne_nil {l mem ld ly lhsOp ls rs} (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalScalarPtrOffsetBinOp l mem ld ly lhsOp ls rs) := by
  unfold evalScalarPtrOffsetBinOp; try dsimp only
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)

private theorem evalRvalue_use_ne_nil
    {locals : List LocalSlot} {op : Operand} {mem : Memory}
    {ld : List LocalDecl} {ly : LayoutTable}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalRvalue locals (.use op) mem ld ly) := by
  cases op
  all_goals
    dsimp only [evalRvalue]
    repeat' (first
      | exact rok_ub | exact rok_unsup | exact rok_ok h | exact rok_ok_cons
      | exact rok_ok (freezeDerefReadBorrowsAt_ne_nil h)
      | exact rok_ok (freezeDerefReadBorrowsAt_ne_nil nofun)
      | exact rok_ok (freezeTreeBorrowsOnReadAtProj_ne_nil nofun)
      | split)

private theorem evalFloatCastRvalue_ne_nil
    {locals : List LocalSlot} {ck : CastKind} {op : Operand}
    {ty : Ty} {mem : Memory} {ld : List LocalDecl} {ly : LayoutTable}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalFloatCastRvalue locals ck op ty mem ld ly) := by
  unfold evalFloatCastRvalue
  cases evalOperand locals op mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
  | ub => exact rok_ub
  | unsupported => exact rok_unsup
  | ok v l' =>
    dsimp only
    cases evalFloatCast ck (operandTy ld ly op) ty ly v with
    | none => exact rok_unsup
    | some v' => exact rok_ok h

private theorem evalFloatUnaryNeg_ne_nil
    {sc : ScalarInt} {optTy : Option Ty} {locals : List LocalSlot} {mem : Memory}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalFloatUnaryNeg sc optTy locals mem) := by
  unfold evalFloatUnaryNeg
  repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)

private theorem evalFloatScalarBinOp_ne_nil
    {op : BinOp} {lhs rhs : ScalarInt} {lhsTy? rhsTy? : Option Ty}
    {locals : List LocalSlot} {mem : Memory}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalFloatScalarBinOp op lhs rhs lhsTy? rhsTy? locals mem) := by
  unfold evalFloatScalarBinOp
  cases lhsTy? with
  | none => exact rok_unsup
  | some lTy =>
    cases rhsTy? with
    | none => exact rok_unsup
    | some rTy =>
      dsimp only
      cases ieeeFormatOfTy? lTy with
      | none => exact rok_unsup
      | some fL =>
        cases ieeeFormatOfTy? rTy with
        | none => exact rok_unsup
        | some fR =>
          cases fL <;> cases fR <;> dsimp only
          · cases (lhs.sizeBytes.beq IeeeFormat.binary32.byteWidth && rhs.sizeBytes.beq IeeeFormat.binary32.byteWidth) with
            | false => exact rok_unsup
            | true =>
              cases evalFloatBinOp op .binary32 lhs.bits rhs.bits with
              | none => exact rok_unsup
              | some _ => exact rok_ok h
          · exact rok_unsup
          · exact rok_unsup
          · cases (lhs.sizeBytes.beq IeeeFormat.binary64.byteWidth && rhs.sizeBytes.beq IeeeFormat.binary64.byteWidth) with
            | false => exact rok_unsup
            | true =>
              cases evalFloatBinOp op .binary64 lhs.bits rhs.bits with
              | none => exact rok_unsup
              | some _ => exact rok_ok h

private theorem evalRvalue_binaryOp_ne_nil
    {locals : List LocalSlot} {op : BinOp} {lhsOp rhsOp : Operand}
    {mem : Memory} {ld : List LocalDecl} {ly : LayoutTable}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalRvalue locals (.binaryOp op lhsOp rhsOp) mem ld ly) := by
  dsimp only [evalRvalue]
  cases evalOperand locals lhsOp mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
  | ub => exact rok_ub
  | unsupported => exact rok_unsup
  | ok lv l1 =>
    dsimp only
    cases evalOperand l1 rhsOp mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
    | ub => exact rok_ub
    | unsupported => exact rok_unsup
    | ok rv2 l2 =>
      dsimp only
      cases lv with
      | scalar ls =>
        cases rv2 with
        | scalar rs =>
          cases op with
          | offset => exact evalScalarPtrOffsetBinOp_ne_nil h
          | _ =>
            cases Bool.or (isFloatOptTy (operandTy ld ly lhsOp)) (isFloatOptTy (operandTy ld ly rhsOp)) with
            | true => exact evalFloatScalarBinOp_ne_nil h
            | false => exact evalScalarBinOp_ne_nil h
        | ptr pv sz =>
          dsimp only
          repeat' (first | exact rok_ub | exact rok_unsup | exact evalScalarBinOp_ne_nil h | split)
        | _ => exact rok_unsup
      | ptr pv sz =>
        cases rv2 with
        | scalar rs =>
          cases op with
          | offset => exact evalPtrOffsetBinOp_ne_nil h
          | _ =>
            dsimp only
            repeat' (first | exact rok_ub | exact rok_unsup | exact evalScalarBinOp_ne_nil h | split)
        | ptr rp rsz =>
          dsimp only [evalWidePtrRelBinOp]
          repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact evalScalarBinOp_ne_nil h | split)
        | _ => exact rok_unsup
      | aggregate lv lf =>
        cases rv2 with
        | aggregate rv rf =>
          dsimp only [evalWidePtrAggregateRelBinOp, evalWidePtrRelBinOp]
          repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact evalScalarBinOp_ne_nil h | split)
        | _ => exact rok_unsup
      | _ => exact rok_unsup

theorem evalRvalue_ok_borrows_ne_nil
    {locals : List LocalSlot} {rv : Rvalue} {mem : Memory}
    {ld : List LocalDecl} {ly : LayoutTable}
    (h : mem.borrows ≠ []) :
    rvalOkBorrowsNeNil (evalRvalue locals rv mem ld ly) := by
  cases rv with
  | use op => exact evalRvalue_use_ne_nil h
  | «repeat» op _ =>
    cases op
    all_goals
      dsimp only [evalRvalue]; repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | ref bk place =>
    dsimp only [evalRvalue]
    repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok_cons | exact evalRvalueRefDeref_ne_nil h | split)
  | threadLocalRef _ => exact rok_unsup
  | rawPtr mutab place => exact evalRvalueRawPtr_ne_nil h
  | len place =>
    dsimp only [evalRvalue, evalPlaceLen]
    cases splitLastDeref? place.projection <;>
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | cast ck op ty =>
    cases ck with
    | pointerCoercion cs => exact evalReifyFnPointer_ne_nil h
    | fnPtrToPtr => exact evalFnPtrToPtr_ne_nil h
    | ptrToPtr =>
      dsimp only [evalRvalue, evalCastPtrToPtr]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact deriveStackElemThinPtr_ne_nil h | split)
    | pointerExposeProvenance =>
      dsimp only [evalRvalue, evalPointerExposeProvenance]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
    | pointerWithExposedProvenance =>
      dsimp only [evalRvalue, evalPointerWithExposedProvenance]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
    | transmute | subtype => exact evalByteCast_ne_nil h
    | floatToInt | intToFloat | floatToFloat => exact evalFloatCastRvalue_ne_nil h
    | _ =>
      dsimp only [evalRvalue]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | binaryOp op lhsOp rhsOp => exact evalRvalue_binaryOp_ne_nil h
  | nullaryOp op ty =>
    show rvalOkBorrowsNeNil (evalNullaryOp locals op ty mem ld ly)
    rcases evalNullaryOp_shape locals op ty ld ly with h_un | ⟨sc, h_ok⟩
    · rw [h_un mem]; exact rok_unsup
    · rw [h_ok mem]; exact rok_ok h
  | unaryOp uop op =>
    cases uop with
    | not =>
      dsimp only [evalRvalue]
      cases evalOperand locals op mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
      | ub => exact rok_ub
      | unsupported => exact rok_unsup
      | ok v l' =>
        cases v with
        | scalar sc =>
          dsimp only
          rw [evalUnaryNot_eq_withMem]
          cases evalUnaryNot sc (operandTy ld ly op) l' emptyMemory with
          | ub => exact rok_ub
          | unsupported => exact rok_unsup
          | ok _ _ _ => exact rok_ok h
        | _ => exact rok_unsup
    | neg =>
      dsimp only [evalRvalue]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | exact evalFloatUnaryNeg_ne_nil h | split)
    | ptrMetadata =>
      dsimp only [evalRvalue, evalUnaryPtrMetadata]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | discriminant place =>
    dsimp only [evalRvalue, evalPlaceDiscriminant]
    repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | aggregate kind ops =>
    cases kind with
    | rawPtr pt _ =>
      dsimp only [evalRvalue, evalAggregateRawPtr]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
    | adt dp vi af =>
      dsimp only [evalRvalue, evalAggregateAdt]
      cases evalOperands locals ops mem.borrows mem.globals ly mem.callerLocals ld mem.callStack with
      | ub => exact rok_ub
      | unsupported => exact rok_unsup
      | ok _ _ =>
        dsimp only
        repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
    | _ =>
      dsimp only [evalRvalue]
      repeat' (first | exact rok_ub | exact rok_unsup | exact rok_ok h | split)
  | shallowInitBox op ty =>
    have hU : rvalOkBorrowsNeNil (evalUseRvalue locals op mem ld ly) :=
      evalRvalue_use_ne_nil (locals := locals) (op := op) (ld := ld) (ly := ly) h
    show rvalOkBorrowsNeNil (evalShallowInitBox locals op ty mem ld ly)
    cases h0 : evalUseRvalue locals op mem ld ly with
    | ub => rw [evalShallowInitBox_ub_of_use h0]; exact rok_ub
    | unsupported => rw [evalShallowInitBox_unsupported_of_use h0]; exact rok_unsup
    | ok v l m =>
      have hm : m.borrows ≠ [] := hU v l m h0
      rw [evalShallowInitBox_ok_of_use h0]
      rcases evalShallowInitBoxBody_shape op ld ly v l with h_un | ⟨p, sz, h_ok⟩
      · rw [h_un m]; exact rok_unsup
      · rw [h_ok m]; exact rok_ok hm
  | copyForDeref place =>
    dsimp only [evalRvalue]
    cases evalOperand locals (.copy place) mem.borrows mem.globals ly mem.callerLocals ld mem.callStack <;>
      repeat' (first
        | exact rok_ub
        | exact rok_unsup
        | exact rok_ok h
        | exact rok_ok_cons
        | exact rok_ok (freezeDerefReadBorrowsAt_ne_nil h)
        | exact rok_ok (freezeDerefReadBorrowsAt_ne_nil nofun)
        | exact rok_ok (freezeTreeBorrowsOnReadAtProj_ne_nil nofun)
        | split)
  | wrapUnsafeBinder op ty =>
    have hU : rvalOkBorrowsNeNil (evalUseRvalue locals op mem ld ly) :=
      evalRvalue_use_ne_nil (locals := locals) (op := op) (ld := ld) (ly := ly) h
    show rvalOkBorrowsNeNil (evalWrapUnsafeBinder locals op ty mem ld ly)
    cases h0 : evalUseRvalue locals op mem ld ly with
    | ub => rw [evalWrapUnsafeBinder_ub_of_use h0]; exact rok_ub
    | unsupported => rw [evalWrapUnsafeBinder_unsupported_of_use h0]; exact rok_unsup
    | ok v l m =>
      have hm : m.borrows ≠ [] := hU v l m h0
      rw [evalWrapUnsafeBinder_ok_of_use h0]
      rcases evalWrapUnsafeBinderBody_shape op ty ld ly v l with h_ub | h_un | ⟨outVal, h_ok⟩
      · rw [h_ub m]; exact rok_ub
      · rw [h_un m]; exact rok_unsup
      · rw [h_ok m]; exact rok_ok hm

def stmtStepBorrowsNeNil (n : MirStepNode) : Prop :=
  ∀ ns : MachineState, n = MirStepNode.step ns → ns.memory.borrows ≠ []

private theorem sn_step {s : MachineState} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (MirStepNode.step s) := by
  intro ns heq; injection heq with hr; injection hr with hs; subst hs; exact h
private theorem sn_fail {fk : FailureKind} : stmtStepBorrowsNeNil (MirStepNode.fail fk) :=
  fun _ h => nomatch h
private theorem sn_unsup : stmtStepBorrowsNeNil MirStepNode.unsupported :=
  fun _ h => nomatch h
private theorem sn_step_cons {f nA gl e bs nT cal tr cs ac ap nP cl fp ex ru} :
    stmtStepBorrowsNeNil
      (MirStepNode.step { frame := f, memory := Memory.mk nA gl (e :: bs) nT cal tr cs ac ap nP cl fp ex ru }) :=
  sn_step nofun

private theorem copyWriteDstVal_ne_nil {s l3 dp dl dt nv ld ly} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (copyWriteDstVal s l3 dp dl dt nv ld ly) := by
  unfold copyWriteDstVal; dsimp only
  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step (invalidateConflictingBorrows_ne_nil h) | split)


private theorem evalCopySingleDirect_ne_nil
    {s src dst ld ly sp dp se de l3} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalCopySingleDirect s src dst ld ly sp dp se de l3) := by
  unfold evalCopySingleDirect; try dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact sn_step h
    | exact sn_step (invalidateConflictingBorrows_ne_nil h)
    | split)

private theorem evalCopyUnionBytes_ne_nil
    {s src dst ld ly sp dp se de su du n l3} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalCopyUnionBytes s src dst ld ly sp dp se de su du n l3) := by
  unfold evalCopyUnionBytes; try dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact sn_step h
    | exact sn_step (invalidateConflictingBorrows_ne_nil h)
    | exact copyWriteDstVal_ne_nil h
    | split)

private theorem opt_guard_eq_some {α : Type} {b : Bool} {x : Option α} {v : α}
    (h : (match b with | true => none | false => x) = some v) : x = some v := by
  cases b
  · exact h
  · cases h

private theorem borrowsAfterCopySingleDirect_ne_nil
    {bs bs' : List BorrowEntry} {ap : List Nat}
    {sp dp : ProvenancePtr} {se de : BorrowEntry}
    (h : bs ≠ [])
    (hok : borrowsAfterCopySingleDirect bs ap sp dp se de = some bs') :
    bs' ≠ [] := by
  unfold borrowsAfterCopySingleDirect at hok
  have h1 := opt_guard_eq_some hok
  have h2 := opt_guard_eq_some h1
  have h3 := opt_guard_eq_some h2
  rw [← Option.some.inj h3]
  rcases bs with _ | ⟨b1, _ | ⟨b2, br⟩⟩
  · exact False.elim (h rfl)
  · cases de.targetProjection with
    | nil =>
      cases de.rangeLen.beq 0 <;> nofun
    | cons _ _ => nofun
  · nofun

private theorem commitCopyDstPlaceWriteWithBorrows_ne_nil
    {s dp l3 nv ld ly} {bs' : List BorrowEntry} (h : bs' ≠ []) :
    stmtStepBorrowsNeNil (commitCopyDstPlaceWriteWithBorrows s dp l3 nv bs' ld ly) := by
  unfold commitCopyDstPlaceWriteWithBorrows; dsimp only
  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | split)

private theorem evalCopySubplaceMulti_ne_nil
    {s src dst ld ly sp dp se de cb l3} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalCopySubplaceMulti s src dst ld ly sp dp se de cb l3) := by
  unfold evalCopySubplaceMulti
  split
  · exact sn_fail
  · exact sn_unsup
  · exact sn_step h
  · next dstPlace newVal srcWin dstWin _ =>
    cases h_ba : borrowsAfterCopySlice s.memory.borrows s.memory.activeProtectors sp dp se de
        srcWin dstWin with
    | none => exact sn_fail
    | some bs' =>
      exact commitCopyDstPlaceWriteWithBorrows_ne_nil
        (borrowsAfterCopySingleDirect_ne_nil h (by unfold borrowsAfterCopySlice at h_ba; exact h_ba))

private theorem evalCopyNonOverlappingWithCount_ne_nil
    {s src dst ld ly sv dv cnt l3} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalCopyNonOverlappingWithCount s src dst ld ly sv dv cnt l3) := by
  have h_ff {sp dp se de cb l3} :
      stmtStepBorrowsNeNil (evalForeignFrameCopySingleDirect s src dst ld ly sp dp se de cb l3) := by
    unfold evalForeignFrameCopySingleDirect; try dsimp only
    cases Nat.beq cb 1 && (Nat.beq sp.offsetBytes 0 && Nat.beq dp.offsetBytes 0) with
    | false => exact sn_unsup
    | true =>
      dsimp only
      split
      · exact sn_fail
      · cases readFrameLocalSlot l3 s.memory.callStack s.memory.callerLocals se.targetFrameDepth se.targetLocal with
        | none => exact sn_fail
        | some sl =>
          cases sl with
          | uninit | dead => exact sn_fail
          | init srv =>
            dsimp only
            cases readProjectedValue l3 srv se.targetProjection with
            | ub => exact sn_fail
            | unsupported => exact sn_unsup
            | ok _ =>
              dsimp only
              split
              · exact sn_fail
              · cases h_ba : borrowsAfterCopySingleDirect s.memory.borrows s.memory.activeProtectors sp dp se de with
                | none => exact sn_fail
                | some bs' =>
                  have hbs' := borrowsAfterCopySingleDirect_ne_nil h h_ba
                  dsimp only
                  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step hbs' | split)
  have h_perm {sp dp se de cb l3} :
      stmtStepBorrowsNeNil (evalCopyNonOverlappingPermOk s src dst ld ly sp dp se de cb l3) := by
    unfold evalCopyNonOverlappingPermOk; try dsimp only
    repeat' (first
      | exact sn_fail
      | exact sn_unsup
      | exact evalCopyUnionBytes_ne_nil h
      | exact evalCopySingleDirect_ne_nil h
      | exact evalCopySubplaceMulti_ne_nil h
      | exact copyWriteDstVal_ne_nil h
      | split)
  unfold evalCopyNonOverlappingWithCount; try dsimp only
  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | exact h_ff | exact h_perm | split)

private theorem evalCopyNonOverlapping_ne_nil
    {s src dst count ld ly} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalCopyNonOverlapping s src dst count ld ly) := by
  unfold evalCopyNonOverlapping; try dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact evalCopyNonOverlappingWithCount_ne_nil h
    | split)

private def fwOkBorrowsNeNil (r : FrameWriteResult) : Prop :=
  ∀ l m, r = .ok l m → m.borrows ≠ []

private theorem fw_ub : fwOkBorrowsNeNil .ub := fun _ _ h => nomatch h
private theorem fw_unsup : fwOkBorrowsNeNil .unsupported := fun _ _ h => nomatch h
private theorem fw_ok {l : List LocalSlot} {m : Memory} (h : m.borrows ≠ []) :
    fwOkBorrowsNeNil (.ok l m) := by
  intro _ _ heq; injection heq with _ hm; subst hm; exact h

private theorem foreignFrameDerefWrite_ne_nil
    {l1 : List LocalSlot} {m1 : Memory} {dst : Place} {rp : List ProjectionElem} {val : Value}
    {ld : List LocalDecl} {ly : LayoutTable}
    (h : m1.borrows ≠ []) :
    fwOkBorrowsNeNil (foreignFrameDerefWrite l1 m1 dst rp val ld ly) := by
  unfold foreignFrameDerefWrite; try dsimp only
  repeat' (first
    | exact fw_ub
    | exact fw_unsup
    | exact fw_ok (invalidateDerefWriteBorrows_ne_nil h)
    | exact fw_ok (invalidateDerefWriteBorrowsWithLayouts_ne_nil h)
    | split)

private theorem evalForeignFrameDerefWrite_ne_nil
    {s l1 m1 dst rp val ld ly} (h : m1.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalForeignFrameDerefWrite s l1 m1 dst rp val ld ly) := by
  unfold evalForeignFrameDerefWrite
  cases h_ff : foreignFrameDerefWrite l1 m1 dst rp val ld ly with
  | ub => exact sn_fail
  | unsupported => exact sn_unsup
  | ok l2 m2 => exact sn_step (foreignFrameDerefWrite_ne_nil h l2 m2 h_ff)

private theorem evalSetDiscriminantDerefWrite_ne_nil
    {s l1 p rest nv ld ly} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalSetDiscriminantDerefWrite s l1 p rest nv ld ly) := by
  unfold evalSetDiscriminantDerefWrite; try dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact sn_step (invalidateDerefWriteBorrowsWithLayouts_ne_nil h)
    | exact evalForeignFrameDerefWrite_ne_nil h
    | split)

private theorem evalFnEntryRetag_ne_nil
    {s ld ly p pv sz e l'} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalFnEntryRetag s ld ly p pv sz e l') := by
  unfold evalFnEntryRetag; dsimp only
  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | exact sn_step_cons | exact sn_step (attachBorrowProtector_ne_nil h) | split)

private theorem evalNonFnEntryRetag_ne_nil
    {rk s ld ly p pv sz e l'} (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalNonFnEntryRetag rk s ld ly p pv sz e l') := by
  unfold evalNonFnEntryRetag; dsimp only
  repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | exact sn_step_cons | split)

private theorem evalStmt_deinit_borrows_ne_nil
    {s : MachineState} {p : Place} {sp : String}
    {ld : List LocalDecl} {ly : LayoutTable}
    (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalStmt s { kind := .deinit p, span := sp } ld ly) := by
  unfold evalStmt; dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact sn_step (invalidateConflictingBorrows_ne_nil h)
    | exact sn_step (invalidateConflictingBorrowsAtProj_ne_nil h)
    | split)

private theorem evalTerminator_drop_borrows_ne_nil
    {s : MachineState} {place : Place} {target : BasicBlockIdx}
    {unwind : UnwindAction} {sp : String} {curOpt : Option CapturedMir}
    (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalTerminator s { kind := .drop place target unwind, span := sp } curOpt) := by
  unfold evalTerminator; dsimp only
  repeat' (first
    | exact sn_fail
    | exact sn_unsup
    | exact sn_step (invalidateConflictingBorrows_ne_nil h)
    | exact sn_step (invalidateConflictingBorrowsAtProj_ne_nil h)
    | split)

private theorem evalAssignDst_borrows_ne_nil
    {s : MachineState} {dst : Place} {val : Value}
    {l1 : List LocalSlot} {m1 : Memory}
    {ld : List LocalDecl} {ly : LayoutTable}
    (hm1 : m1.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalAssignDst s dst val l1 m1 ld ly) := by
  rcases dst with ⟨dLoc, dProj⟩
  cases dProj with
  | nil =>
    unfold evalAssignDst; try dsimp only
    repeat' (first | exact sn_fail | exact sn_step (invalidateConflictingBorrows_ne_nil hm1) | split)
  | cons hd tl =>
    by_cases h_d : hd = .deref
    · subst h_d
      unfold evalAssignDst; try dsimp only
      repeat' (first
        | exact sn_fail | exact sn_unsup
        | exact sn_step (invalidateDerefWriteBorrowsWithLayouts_ne_nil hm1)
        | exact sn_step (invalidateDerefWriteBorrows_ne_nil hm1)
        | exact evalForeignFrameDerefWrite_ne_nil hm1
        | split)
    · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (hd :: tl) with h_s | h_nr
      · rw [evalAssignDst_castRoot _ _ _ _ _ _ _ _ _ h_s]
        unfold evalAssignDst; try dsimp only
        repeat' (first | exact sn_fail | exact sn_step (invalidateConflictingBorrows_ne_nil hm1) | split)
      · rw [evalAssignDst_nonDeref _ _ _ _ _ _ _ _ _ h_d h_nr]
        unfold evalAssignNonDeref; try dsimp only
        repeat' (first
          | exact sn_fail | exact sn_unsup
          | exact sn_step (invalidateConflictingBorrowsAtProj_ne_nil hm1)
          | split)

theorem evalStmt_borrows_ne_nil
    {s : MachineState} {stmt : Statement} {ld : List LocalDecl} {ly : LayoutTable}
    (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (evalStmt s stmt ld ly) := by
  rcases stmt with ⟨kind, sp⟩
  cases kind with
  | nop | coverage | constEvalCounter | backwardIncompatibleDropHint _ =>
    exact sn_step h
  | placeMention p =>
    unfold evalStmt; dsimp only
    repeat' (first | exact sn_fail | exact sn_step h | split)
  | deinit p =>
    exact evalStmt_deinit_borrows_ne_nil h
  | storageLive loc | storageDead loc =>
    unfold evalStmt; dsimp only
    repeat' (first | exact sn_fail | exact sn_step (disableLocalBorrows_ne_nil h) | split)
  | retag rk p =>
    unfold evalStmt; dsimp only
    repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | exact sn_step (attachBorrowProtector_ne_nil h) | exact evalFnEntryRetag_ne_nil h | exact evalNonFnEntryRetag_ne_nil h | split)
  | intrinsic intr =>
    cases intr with
    | assume op =>
      unfold evalStmt; dsimp only
      repeat' (first | exact sn_fail | exact sn_unsup | exact sn_step h | split)
    | copyNonOverlapping src dst count =>
      exact evalCopyNonOverlapping_ne_nil h
  | setDiscriminant p vi =>
    rcases p with ⟨pLoc, _ | ⟨phd, ptl⟩⟩
    · unfold evalStmt evalSetDiscriminantLocal; dsimp only
      repeat' (first
        | exact sn_fail
        | exact sn_unsup
        | exact sn_step (invalidateConflictingBorrows_ne_nil h)
        | split)
    · by_cases h_d : phd = .deref
      · subst h_d
        unfold evalStmt; dsimp only
        cases evalOperand s.frame.locals (.copy ⟨pLoc, .deref :: ptl⟩) s.memory.borrows
            s.memory.globals ly s.memory.callerLocals ld s.memory.callStack with
        | unsupported => exact sn_unsup
        | ok v l1 =>
          cases v with
          | aggregate _ fields =>
            dsimp only
            cases padSetDiscriminantInitFields? ld ly ⟨pLoc, .deref :: ptl⟩ vi fields with
            | none => exact sn_fail
            | some _ => exact evalSetDiscriminantDerefWrite_ne_nil h
          | _ => exact sn_fail
        | ub =>
          cases ptl with
          | cons _ _ => exact sn_fail
          | nil =>
            dsimp only
            repeat' (first
              | exact sn_fail
              | exact sn_unsup
              | exact evalSetDiscriminantDerefWrite_ne_nil h
              | split)
      · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (phd :: ptl) with h_s | h_nr
        · rw [evalStmt_setDiscriminant_castRoot _ _ _ _ _ _ _ _ h_s]
          unfold evalStmt evalSetDiscriminantLocal; dsimp only
          repeat' (first
            | exact sn_fail
            | exact sn_unsup
            | exact sn_step (invalidateConflictingBorrows_ne_nil h)
            | split)
        · rw [evalStmt_setDiscriminant_nonDeref _ _ _ _ _ _ _ _ h_d h_nr]; dsimp only
          repeat' (first
            | exact sn_fail
            | exact sn_unsup
            | exact sn_step (invalidateConflictingBorrowsAtProj_ne_nil h)
            | split)
  | assign dst rv =>
    rw [evalStmt_assign_eq]
    cases h_rv : evalRvalue s.frame.locals rv s.memory ld ly with
    | ub => exact sn_fail
    | unsupported => exact sn_unsup
    | ok val l1 m1 =>
      exact evalAssignDst_borrows_ne_nil (evalRvalue_ok_borrows_ne_nil h val l1 m1 h_rv)

theorem unwindFromCallStack_borrows_ne_nil
    {stk : List SavedCallerFrame} {m : Memory} {ns : MachineState}
    (h : m.borrows ≠ [])
    (hu : unwindFromCallStack stk m = .running ns) :
    ns.memory.borrows ≠ [] := by
  induction stk generalizing m with
  | nil =>
    dsimp only [unwindFromCallStack] at hu
    cases hc : m.rootUnwindCeiling <;> (rw [hc] at hu; nomatch hu)
  | cons caller rest ih =>
    dsimp only [unwindFromCallStack] at hu
    cases h_rw : caller.returnUnwind with
    | unreachable => rw [h_rw] at hu; nomatch hu
    | terminate => rw [h_rw] at hu; nomatch hu
    | cleanup _ =>
      rw [h_rw] at hu; injection hu with hs; subst hs
      exact disableFramesAbove_ne_nil h
    | continue_ =>
      rw [h_rw] at hu; dsimp only at hu
      exact @ih { m with callStack := rest, activeCallee := some caller.callerBody,
                         activeProtectors := restoreCallerProtectors caller } h hu

theorem applyUnwindAction_borrows_ne_nil
    {s : MachineState} {locs : List LocalSlot} {m : Memory}
    {unw : UnwindAction} {ns : MachineState}
    (h : m.borrows ≠ [])
    (ha : applyUnwindAction s locs m unw = .running ns) :
    ns.memory.borrows ≠ [] := by
  cases unw with
  | unreachable => nomatch ha
  | terminate => nomatch ha
  | cleanup _ => injection ha with hs; subst hs; exact h
  | continue_ => exact unwindFromCallStack_borrows_ne_nil h ha

private theorem writeReturnDestination_fw_ne_nil
    {cl : List LocalSlot} {m : Memory} {dst : Place}
    {rv : Value} {ld : List LocalDecl} {ly : LayoutTable}
    (h : m.borrows ≠ []) :
    fwOkBorrowsNeNil (writeReturnDestination cl m dst rv ld ly) := by
  unfold writeReturnDestination; dsimp only
  repeat' (first
    | exact fw_ub
    | exact fw_unsup
    | exact fw_ok (invalidateConflictingBorrows_ne_nil h)
    | exact fw_ok (invalidateDerefWriteBorrowsWithLayouts_ne_nil h)
    | exact fw_ok (invalidateConflictingBorrowsAtProj_ne_nil h)
    | exact foreignFrameDerefWrite_ne_nil h
    | split)

theorem writeReturnDestination_borrows_ne_nil
    {cl l' : List LocalSlot} {m m' : Memory} {dst : Place}
    {rv : Value} {ld : List LocalDecl} {ly : LayoutTable}
    (h : m.borrows ≠ [])
    (hw : writeReturnDestination cl m dst rv ld ly = .ok l' m') :
    m'.borrows ≠ [] :=
  writeReturnDestination_fw_ne_nil h l' m' hw

@[simp]
theorem hasFrameDeallocProtectorConflict_nil
    (ap : List Nat) (d n : Nat) :
    hasFrameDeallocProtectorConflict [] ap d n = false := by
  cases ap <;> rfl

theorem writeReturnDestination_borrows_nil_pushBaseStack
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (cl : List LocalSlot) (m : Memory) (dst : Place) (rv : Value)
    (ld : List LocalDecl) (ly : LayoutTable)
    (h_bor : m.borrows = []) :
    writeReturnDestination cl (Memory.pushBaseStack calleeBody baseStack m) dst rv ld ly =
      FrameWriteResult.pushBaseStack calleeBody baseStack
        (writeReturnDestination cl m dst rv ld ly) := by
  rcases m with ⟨nA, gl, bor, nT, cal, tr, cs, ac, ap, nP, cloc, fp, ex, ru⟩
  dsimp only at h_bor; subst h_bor
  let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cloc fp ex ru
  have h_mp_bor : (Memory.pushBaseStack calleeBody baseStack m0).borrows = [] := by
    cases baseStack <;> rfl
  have h_hpc : ∀ p loc pr d, hasProtectedWriteConflict [] p loc none pr 0 0 d = false := by
    intro p _ _ _; cases p <;> rfl
  have h_icb : ∀ loc d, invalidateConflictingBorrows [] loc none d = [] := fun _ _ => rfl
  have h_icbp : ∀ loc pr d, invalidateConflictingBorrowsAtProj [] loc none pr 0 0 d = [] := fun _ _ _ => rfl
  rcases dst with ⟨dLoc, dProj⟩
  cases dProj with
  | nil =>
    unfold writeReturnDestination
    dsimp only [m0]
    rw [h_mp_bor]
    simp only [h_hpc, h_icb]
    cases get? cl dLoc with
    | none => rfl
    | some sl =>
      cases sl with
      | dead => rfl
      | uninit | init _ =>
        dsimp only
        cases set? cl dLoc (.init rv) with
        | none => rfl
        | some _ => cases baseStack <;> rfl
  | cons hd tl =>
    by_cases h_nd : hd = .deref
    · subst h_nd
      unfold writeReturnDestination
      dsimp only [m0]
      rw [h_mp_bor]
      simp only [evalPlaceWrite_deref_nil_borrows]
      rw [foreignFrameDerefWrite_nil_borrows cl (Memory.pushBaseStack calleeBody baseStack m0) ⟨dLoc, .deref :: tl⟩ tl rv h_mp_bor ld ly,
          foreignFrameDerefWrite_nil_borrows cl m0 ⟨dLoc, .deref :: tl⟩ tl rv rfl ld ly]
      rfl
    · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (hd :: tl) with h_s | h_nr
      · cases hd with
        | opaqueCast castTy =>
          unfold writeReturnDestination; dsimp only [m0] at h_s ⊢; rw [h_s, h_mp_bor]
          simp only [h_hpc, h_icb]
          split
          · rfl
          · cases get? cl dLoc with
            | none => rfl
            | some sl =>
              cases sl with
              | dead => rfl
              | uninit | init _ =>
                dsimp only
                cases set? cl dLoc (.init rv) with
                | none => rfl
                | some _ => cases baseStack <;> rfl
        | _ => cases h_s
      · rw [writeReturnDestination_nonDeref cl (Memory.pushBaseStack calleeBody baseStack m0) dLoc hd tl rv ld ly h_nd h_nr,
            writeReturnDestination_nonDeref cl m0 dLoc hd tl rv ld ly h_nd h_nr]
        dsimp only [m0]
        rw [h_mp_bor]
        simp only [h_hpc, h_icbp]
        split
        · rfl
        · rename_i rootVal _
          cases writeProjectedForLocal cl (eraseLeadingOpaqueCastDecls ld ly dLoc (hd :: tl)) ly dLoc rootVal (hd :: tl) rv with
          | ub => rfl
          | unsupported => rfl
          | ok rootVal' =>
            dsimp only
            cases set? cl dLoc (.init rootVal') with
            | none => rfl
            | some _ => cases baseStack <;> rfl

private def rvalNilPushEq (c : CapturedMir) (b : List SavedCallerFrame)
    (lhs rhs : RvalueEvalResult) : Prop :=
  (∃ v l m', rhs = .ok v l m' ∧ m'.borrows = []) →
    lhs = RvalueEvalResult.pushBaseStack c b rhs

private theorem rnp_ub {c : CapturedMir} {b : List SavedCallerFrame} {lhs : RvalueEvalResult} :
    rvalNilPushEq c b lhs .ub := fun ⟨_, _, _, h, _⟩ => nomatch h
private theorem rnp_unsup {c : CapturedMir} {b : List SavedCallerFrame} {lhs : RvalueEvalResult} :
    rvalNilPushEq c b lhs .unsupported := fun ⟨_, _, _, h, _⟩ => nomatch h
private theorem rnp_ok {c : CapturedMir} {b : List SavedCallerFrame}
    {v : Value} {l : List LocalSlot} {m₁ m₂ : Memory}
    (h : m₁ = Memory.pushBaseStack c b m₂) :
    rvalNilPushEq c b (.ok v l m₁) (.ok v l m₂) :=
  fun _ => h ▸ rfl
private theorem rnp_of_eq {c : CapturedMir} {b : List SavedCallerFrame}
    {lhs rhs : RvalueEvalResult}
    (h : lhs = RvalueEvalResult.pushBaseStack c b rhs) :
    rvalNilPushEq c b lhs rhs :=
  fun _ => h
private theorem rnp_mint {c : CapturedMir} {b : List SavedCallerFrame}
    {lhs : RvalueEvalResult} {v : Value} {l : List LocalSlot}
    {nA gl e bs nT cal tr cs ac ap nP cl fp ex ru} :
    rvalNilPushEq c b lhs
      (.ok v l (Memory.mk nA gl (e :: bs) nT cal tr cs ac ap nP cl fp ex ru)) :=
  fun ⟨_, _, _, h, hb⟩ => by injection h with _ _ hm; subst hm; exact absurd hb nofun

private theorem recoverExposedPtrValue?_nil_borrows
    (locals : List LocalSlot) (globals : List CapturedAllocation)
    (callerLocals : List LocalSlot) (exposedAllocIds : List AllocId)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (ptrBytes addrBits : Nat) (cs : List SavedCallerFrame) :
    recoverExposedPtrValue? locals [] globals callerLocals exposedAllocIds
        localDecls layouts ptrBytes addrBits cs =
      recoverExposedPtrValue? locals [] globals callerLocals exposedAllocIds
        localDecls layouts ptrBytes addrBits [] := rfl

private theorem checkSafeRefDerefOk_nil_borrows
    (locals : List LocalSlot) (parentPtr : ProvenancePtr)
    (globals : List CapturedAllocation) (callerLocals : List LocalSlot)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (pointeeTyOpt : Option Ty) (cs : List SavedCallerFrame) :
    checkSafeRefDerefOk locals parentPtr [] globals callerLocals localDecls layouts pointeeTyOpt cs =
      checkSafeRefDerefOk locals parentPtr [] globals callerLocals localDecls layouts pointeeTyOpt [] := by
  unfold checkSafeRefDerefOk
  cases checkDerefAlign localDecls layouts pointeeTyOpt parentPtr.offsetBytes <;> rfl

private theorem derefTargetsSuspendedFrame_nil_borrows
    (locals : List LocalSlot) (cs : List SavedCallerFrame) (p : Place) :
    derefTargetsSuspendedFrame locals [] cs p = false := by
  unfold derefTargetsSuspendedFrame
  cases cs with
  | nil => rfl
  | cons _ _ =>
    dsimp only [lookupBorrow]
    cases get? locals p.local_ with
    | none => rfl
    | some sl =>
      cases sl with
      | uninit | dead => rfl
      | init pv => dsimp only; cases extractDerefPtrVal? pv <;> rfl

private theorem evalUnsizeCoercion_cons_nil_rnp
    (c : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (op : Operand) (targetTy : Ty)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (ld : List LocalDecl) (ly : LayoutTable) :
    let mem := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq c (bHd :: bTl)
      (evalUnsizeCoercion locals op targetTy (Memory.pushBaseStack c (bHd :: bTl) mem) ld ly)
      (evalUnsizeCoercion locals op targetTy mem ld ly) := by
  dsimp only [Memory.pushBaseStack]
  unfold evalUnsizeCoercion
  dsimp only [lookupBorrow]
  try simp only [evalOperand_nil_borrows_callStack]
  repeat' (first | contradiction | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint | split)

private theorem evalReifyFnPointer_cons_nil_rnp
    (c : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (op : Operand) (targetTy : Ty)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (ld : List LocalDecl) (ly : LayoutTable) (ckStr : String) :
    let mem := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq c (bHd :: bTl)
      (evalReifyFnPointer locals op targetTy (Memory.pushBaseStack c (bHd :: bTl) mem) ld ly ckStr)
      (evalReifyFnPointer locals op targetTy mem ld ly ckStr) := by
  intro mem
  unfold evalReifyFnPointer
  cases isReifyFnPointerCoercion ckStr with
  | false =>
    dsimp only [mem, Memory.pushBaseStack, lookupBorrow]
    try simp only [evalOperand_nil_borrows_callStack]
    repeat' (first
      | contradiction
      | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint
      | exact evalUnsizeCoercion_cons_nil_rnp c bHd bTl locals op targetTy nA gl nT cal tr cs ac ap nP cl fp ex ru ld ly
      | split)
  | true =>
    cases stringEq ckStr "UnsafeFnPointer" with
    | true =>
      unfold evalUnsafeFnPointer
      dsimp only [mem, Memory.pushBaseStack]
      try simp only [evalOperand_nil_borrows_callStack]
      repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | false =>
      have h_op :
          evalOperand locals op (Memory.pushBaseStack c (bHd :: bTl) mem).borrows
            (Memory.pushBaseStack c (bHd :: bTl) mem).globals ly
            (Memory.pushBaseStack c (bHd :: bTl) mem).callerLocals []
            (Memory.pushBaseStack c (bHd :: bTl) mem).callStack =
          evalOperand locals op [] gl ly cl [] [] := by
        dsimp only [mem, Memory.pushBaseStack]
        exact evalOperand_nil_borrows_callStack ..
      have h_op2 :
          evalOperand locals op mem.borrows mem.globals ly mem.callerLocals [] mem.callStack =
          evalOperand locals op [] gl ly cl [] [] := by
        dsimp only [mem]
        exact evalOperand_nil_borrows_callStack ..
      dsimp only
      rw [h_op, h_op2]
      cases evalOperand locals op [] gl ly cl [] [] with
      | ub => exact rnp_ub
      | unsupported => exact rnp_unsup
      | ok v locals' =>
        have h_int : ∀ d ta fs, _ := internFnPtr_pushBaseStack c (bHd :: bTl) mem
        dsimp only [mem, Memory.pushBaseStack] at h_int ⊢
        try simp only [h_int]
        repeat' (first
          | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl
          | split)

private theorem evalSliceFatPtrDerefBorrow_cons_nil_rnp
    {calleeBody : CapturedMir} {bHd : SavedCallerFrame} {bTl : List SavedCallerFrame}
    {locals : List LocalSlot}
    {nA gl nT cal tr cs ac ap nP cl fp ex ru}
    {parentPtr : ProvenancePtr} {ptrSz : Nat} {lenSc : ScalarInt}
    {restProj : List ProjectionElem} {perm : TreeBorrowPerm} {isMut : Bool}
    {pointeeTyOpt : Option Ty} {layouts : LayoutTable} {checkPerm : Bool}
    {localDecls : List LocalDecl} {accessedTyOpt : Option Ty}
    {checkResultRefAlign : Bool} :
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalSliceFatPtrDerefBorrow locals
        ⟨nA, gl, [], nT, cal, tr, cs ++ narrowCallStackForTailCallee (bHd :: bTl) ru, some (ac.getD calleeBody), ap, nP, cl, fp, ex, true⟩
        parentPtr ptrSz lenSc restProj perm isMut pointeeTyOpt layouts checkPerm localDecls accessedTyOpt checkResultRefAlign)
      (evalSliceFatPtrDerefBorrow locals
        ⟨nA, gl, [], nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ru⟩
        parentPtr ptrSz lenSc restProj perm isMut pointeeTyOpt layouts checkPerm localDecls accessedTyOpt checkResultRefAlign) := by
  unfold evalSliceFatPtrDerefBorrow
  dsimp only [lookupBorrow]
  cases Bool.and (Nat.beq ptrSz (layoutPointerBytes layouts)) (Nat.beq lenSc.sizeBytes (layoutPointerBytes layouts)) with
  | false => exact rnp_ub
  | true =>
    dsimp only
    cases resolveBorrowProjectionElems locals (stripTransparentProjections restProj) with
    | none => exact rnp_ub
    | some rawResolvedRest =>
      dsimp only
      cases lookupGlobalAlloc gl parentPtr.allocId with
      | none =>
        dsimp only
        split <;> first | exact rnp_ok rfl | exact rnp_ub
      | some alloc =>
        dsimp only
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint | split)

private theorem evalRvalue_ref_cons_nil_rnp
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (bk : BorrowKind) (place : Place)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalRvalue locals (.ref bk place) (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
      (evalRvalue locals (.ref bk place) m0 localDecls layouts) := by
  intro m0
  have h_glob := fun a p ps rp im pt cp fpt =>
    evalGlobalThinPtrDerefBorrow_pushBaseStack calleeBody (bHd :: bTl) locals m0 a p ps rp im pt layouts localDecls cp fpt
  dsimp only [m0, Memory.pushBaseStack] at h_glob
  dsimp only [m0, evalRvalue, evalRvalueRefDeref, Memory.pushBaseStack, lookupBorrow]
  try simp only [evalOperand_nil_borrows_callStack]
  try simp only [evalPlaceRead_nil_borrows_callStack]
  repeat' (first
    | contradiction
    | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint
    | exact rnp_of_eq (h_glob ..)
    | exact evalSliceFatPtrDerefBorrow_cons_nil_rnp
    | split)

private theorem evalRvalue_rawPtr_cons_nil_rnp
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (mutab : Mutability) (place : Place)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalRvalue locals (.rawPtr mutab place) (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
      (evalRvalue locals (.rawPtr mutab place) m0 localDecls layouts) := by
  intro m0
  have h_glob := fun a p ps rp im pt cp fpt =>
    evalGlobalThinPtrDerefBorrow_pushBaseStack calleeBody (bHd :: bTl) locals m0 a p ps rp im pt layouts localDecls cp fpt
  have h_sc := fun as ls rp pt =>
    evalScalarSliceFatPtrDerefRaw_pushBaseStack calleeBody (bHd :: bTl) locals m0 as ls rp pt localDecls layouts
  dsimp only [m0, Memory.pushBaseStack] at h_glob h_sc
  rcases place with ⟨pLoc, _ | ⟨phd, restProj⟩⟩
  · dsimp only [m0, evalRvalue, evalRvalueRawPtr, Memory.pushBaseStack]
    cases get? locals pLoc with
    | none => exact rnp_ub
    | some sl =>
      cases sl with
      | dead => exact rnp_ub
      | uninit | init _ => exact rnp_mint
  · cases phd with
    | deref =>
      dsimp only [m0, evalRvalue, evalRvalueRawPtr, Memory.pushBaseStack, lookupBorrow]
      try simp only [evalOperand_nil_borrows_callStack]
      try simp only [evalPlaceRead_nil_borrows_callStack]
      try simp only [checkSafeRefDerefOk_nil_borrows]
      repeat' (first
        | contradiction
        | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint
        | exact rnp_of_eq (h_glob ..)
        | exact rnp_of_eq (h_sc ..)
        | exact evalSliceFatPtrDerefBorrow_cons_nil_rnp
        | split)
    | _ =>
      dsimp only [m0, evalRvalue, evalRvalueRawPtr, Memory.pushBaseStack]
      cases get? locals pLoc with
      | none => exact rnp_ub
      | some sl =>
        cases sl with
        | dead => exact rnp_ub
        | uninit | init _ =>
          dsimp only
          cases resolveBorrowProjectionElems locals _ with
          | none => exact rnp_ub
          | some rp =>
            dsimp only
            cases projHasSubslice rp with
            | false => exact rnp_mint
            | true =>
              dsimp only
              cases validateNonDerefSubslices locals localDecls layouts pLoc _ rp with
              | true => exact rnp_mint
              | false => exact rnp_ub

private theorem evalRvalue_binaryOp_cons_nil_rnp
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (op : BinOp) (lhsOp rhsOp : Operand)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalRvalue locals (.binaryOp op lhsOp rhsOp) (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
      (evalRvalue locals (.binaryOp op lhsOp rhsOp) m0 localDecls layouts) := by
  intro m0
  have h_sb := fun o ls rs l2 isS =>
    evalScalarBinOp_pushBaseStack calleeBody (bHd :: bTl) o ls rs l2 m0 isS
  have h_fsb := fun o ls rs lt rt l2 =>
    evalFloatScalarBinOp_pushBaseStack calleeBody (bHd :: bTl) o ls rs lt rt l2 m0
  have h_spo := fun l2 ls rs =>
    evalScalarPtrOffsetBinOp_pushBaseStack calleeBody (bHd :: bTl) l2 m0 localDecls layouts lhsOp ls rs
  dsimp only [m0, Memory.pushBaseStack] at h_sb h_fsb h_spo
  dsimp only [m0, evalRvalue, Memory.pushBaseStack]
  try simp only [evalOperand_nil_borrows_callStack]
  cases evalOperand locals lhsOp [] gl layouts cl localDecls [] with
  | ub => exact rnp_ub
  | unsupported => exact rnp_unsup
  | ok lhsVal locals₁ =>
    dsimp only
    cases evalOperand locals₁ rhsOp [] gl layouts cl localDecls [] with
    | ub => exact rnp_ub
    | unsupported => exact rnp_unsup
    | ok rhsVal locals₂ =>
      dsimp only
      cases lhsVal with
      | scalar lhsSc =>
        cases rhsVal with
        | scalar rhsSc =>
          cases op with
          | offset =>
            dsimp only
            try simp only [evalOperand_nil_borrows_callStack]
            exact rnp_of_eq (h_spo ..)
          | _ =>
            dsimp only
            cases Bool.or (isFloatOptTy (operandTy localDecls layouts lhsOp))
                (isFloatOptTy (operandTy localDecls layouts rhsOp)) with
            | true => exact rnp_of_eq (h_fsb ..)
            | false => exact rnp_of_eq (h_sb ..)
        | ptr ptrVal sz =>
          try simp only [ptrAddressScalar?_nil_borrows]
          repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_of_eq (h_sb ..) | split)
        | _ => exact rnp_unsup
      | ptr ptrVal sz =>
        cases rhsVal with
        | scalar rhsSc =>
          cases op with
          | offset =>
            dsimp only [evalPtrOffsetBinOp, ptrAllocByteBound?, lookupBorrow]
            try simp only [ptrAddressScalar?_nil_borrows]
            try simp only [evalOperand_nil_borrows_callStack]
            repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
          | _ =>
            dsimp only
            try simp only [ptrAddressScalar?_nil_borrows]
            repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_of_eq (h_sb ..) | split)
        | ptr rhsPtr rhsSz =>
          dsimp only [evalWidePtrRelBinOp]
          try simp only [ptrAddressScalar?_nil_borrows]
          try simp only [resolveWideWordScalar?_nil_borrows]
          repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_of_eq (h_sb ..) | split)
        | _ => exact rnp_unsup
      | aggregate lhsVar lhsFields =>
        cases rhsVal with
        | aggregate rhsVar rhsFields =>
          dsimp only [evalWidePtrAggregateRelBinOp, evalWidePtrRelBinOp]
          try simp only [ptrAddressScalar?_nil_borrows]
          try simp only [resolveWideWordScalar?_nil_borrows]
          repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_of_eq (h_sb ..) | split)
        | _ => exact rnp_unsup
      | _ => exact rnp_unsup

private theorem evalRvalue_use_cons_nil_rnp
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (op : Operand)
    (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalRvalue locals (.use op) (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
      (evalRvalue locals (.use op) m0 localDecls layouts) := by
  intro m0
  cases op
  all_goals
    dsimp only [m0, evalRvalue, Memory.pushBaseStack, lookupBorrow,
      freezeDerefReadBorrowsAt, freezeTreeBorrowsOnReadAtProj]
    try simp only [evalOperand_nil_borrows_callStack]
    repeat' (first | contradiction | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint | split)

private theorem evalFloatCastRvalue_cons_nil_rnp
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (locals : List LocalSlot) (ck : CastKind) (op : Operand) (targetTy : Ty)
    (nA : AllocId) (gl : List CapturedAllocation) (nT : Nat)
    (cal : List CapturedMir) (tr : List TraitImplEntry)
    (cs : List SavedCallerFrame) (ac : Option CapturedMir)
    (ap : List Nat) (nP : Nat) (cl : List LocalSlot)
    (fp : List FnPtrEntry) (ex : List AllocId) (ru : Bool)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    rvalNilPushEq calleeBody (bHd :: bTl)
      (evalFloatCastRvalue locals ck op targetTy (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
      (evalFloatCastRvalue locals ck op targetTy m0 localDecls layouts) := by
  dsimp only [evalFloatCastRvalue, Memory.pushBaseStack]
  simp only [evalOperand_nil_borrows_callStack]
  cases evalOperand locals op [] gl layouts cl localDecls [] with
  | ub => exact rnp_ub
  | unsupported => exact rnp_unsup
  | ok v locals' =>
    dsimp only
    cases evalFloatCast ck (operandTy localDecls layouts op) targetTy layouts v with
    | none => exact rnp_unsup
    | some v' => exact rnp_ok rfl

theorem evalRvalue_borrows_nil_pushBaseStack
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (locals : List LocalSlot) (rv : Rvalue) (mem : Memory)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (h_bor : mem.borrows = [])
    (h_ok_nil : ∃ v l m', evalRvalue locals rv mem localDecls layouts = .ok v l m' ∧ m'.borrows = []) :
    evalRvalue locals rv (Memory.pushBaseStack calleeBody baseStack mem) localDecls layouts =
      RvalueEvalResult.pushBaseStack calleeBody baseStack
        (evalRvalue locals rv mem localDecls layouts) := by
  cases baseStack with
  | nil => exact evalRvalue_pushBaseStack calleeBody locals rv mem localDecls layouts
  | cons bHd bTl =>
    rcases mem with ⟨nA, gl, bor, nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ru⟩
    dsimp only at h_bor; subst h_bor
    let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
    suffices rvalNilPushEq calleeBody (bHd :: bTl)
        (evalRvalue locals rv (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
        (evalRvalue locals rv m0 localDecls layouts) from this h_ok_nil
    cases rv with
    | use op =>
      exact evalRvalue_use_cons_nil_rnp calleeBody bHd bTl locals op nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts
    | «repeat» op count =>
      cases op
      all_goals
        dsimp only [m0, evalRvalue, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | ref bk place =>
      exact evalRvalue_ref_cons_nil_rnp calleeBody bHd bTl locals bk place nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts
    | threadLocalRef _ => exact rnp_unsup
    | rawPtr mutab place =>
      exact evalRvalue_rawPtr_cons_nil_rnp calleeBody bHd bTl locals mutab place nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts

    | len place =>
      dsimp only [m0, evalRvalue, evalPlaceLen, Memory.pushBaseStack, lookupBorrow]
      try simp only [evalPlaceRead_nil_borrows_callStack]
      cases splitLastDeref? place.projection <;>
        repeat' (first | contradiction | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | cast ck op targetTy =>
      cases ck with
      | pointerCoercion ckStr =>
        exact evalReifyFnPointer_cons_nil_rnp calleeBody bHd bTl locals op targetTy
          nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts ckStr
      | fnPtrToPtr =>
        dsimp only [m0, evalRvalue, evalFnPtrToPtr, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
      | ptrToPtr =>
        dsimp only [m0, evalRvalue, evalCastPtrToPtr, Memory.pushBaseStack, lookupBorrow]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first
          | contradiction
          | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint
          | split)
      | pointerExposeProvenance =>
        dsimp only [m0, evalRvalue, evalPointerExposeProvenance, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        try simp only [ptrAddressScalar?_nil_borrows]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
      | pointerWithExposedProvenance =>
        dsimp only [m0, evalRvalue, evalPointerWithExposedProvenance, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        try simp only [recoverExposedPtrValue?_nil_borrows]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
      | transmute | subtype =>
        show rvalNilPushEq calleeBody (bHd :: bTl)
          (evalByteCast locals op targetTy (Memory.pushBaseStack calleeBody (bHd :: bTl) m0)
            localDecls layouts)
          (evalByteCast locals op targetTy m0 localDecls layouts)
        have h_op1 :
            evalOperand locals op (Memory.pushBaseStack calleeBody (bHd :: bTl) m0).borrows
              (Memory.pushBaseStack calleeBody (bHd :: bTl) m0).globals layouts
              (Memory.pushBaseStack calleeBody (bHd :: bTl) m0).callerLocals localDecls
              (Memory.pushBaseStack calleeBody (bHd :: bTl) m0).callStack =
            evalOperand locals op [] gl layouts cl localDecls [] := by
          dsimp only [m0, Memory.pushBaseStack]
          exact evalOperand_nil_borrows_callStack ..
        have h_op2 :
            evalOperand locals op m0.borrows m0.globals layouts m0.callerLocals localDecls
              m0.callStack =
            evalOperand locals op [] gl layouts cl localDecls [] := by
          dsimp only [m0]
          exact evalOperand_nil_borrows_callStack ..
        cases h0 : evalOperand locals op [] gl layouts cl localDecls [] with
        | ub =>
          rw [evalByteCast_ub_of_load (h_op1.trans h0),
              evalByteCast_ub_of_load (h_op2.trans h0)]
          exact rnp_ub
        | unsupported =>
          rw [evalByteCast_unsupported_of_load (h_op1.trans h0),
              evalByteCast_unsupported_of_load (h_op2.trans h0)]
          exact rnp_unsup
        | ok v locals' =>
          rw [evalByteCast_ok_of_load (h_op1.trans h0),
              evalByteCast_ok_of_load (h_op2.trans h0)]
          rcases evalByteCastBody_shape op targetTy localDecls layouts v locals' with
            h_ub | h_un | ⟨v', h_ok⟩
          · rw [h_ub _, h_ub m0]; exact rnp_ub
          · rw [h_un _, h_un m0]; exact rnp_unsup
          · rw [h_ok _, h_ok m0]; exact fun _ => rfl
      | floatToInt | intToFloat | floatToFloat =>
        exact evalFloatCastRvalue_cons_nil_rnp calleeBody bHd bTl locals _ op targetTy
          nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts
      | _ =>
        dsimp only [m0, evalRvalue, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | binaryOp op lhsOp rhsOp =>
      exact evalRvalue_binaryOp_cons_nil_rnp calleeBody bHd bTl locals op lhsOp rhsOp nA gl nT cal tr cs ac ap nP cl fp ex ru localDecls layouts

    | nullaryOp op ty =>
      show rvalNilPushEq calleeBody (bHd :: bTl)
        (evalNullaryOp locals op ty (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls
          layouts)
        (evalNullaryOp locals op ty m0 localDecls layouts)
      rcases evalNullaryOp_shape locals op ty localDecls layouts with h_un | ⟨sc, h_ok⟩
      · rw [h_un _, h_un m0]; exact rnp_unsup
      · rw [h_ok _, h_ok m0]; exact fun _ => rfl
    | unaryOp uop op =>
      cases uop with
      | not =>
        dsimp only [m0, evalRvalue, Memory.pushBaseStack]
        simp only [evalOperand_nil_borrows_callStack]
        cases h_op : evalOperand locals op [] gl layouts cl localDecls [] with
        | ub => exact rnp_ub
        | unsupported => exact rnp_unsup
        | ok v locals' =>
          cases v with
          | scalar sc =>
            simp only
            exact rnp_of_eq (evalUnaryNot_pushBaseStack calleeBody (bHd :: bTl) sc
              (operandTy localDecls layouts op) locals' m0)
          | _ => simp only; exact rnp_unsup
      | neg =>
        dsimp only [m0, evalRvalue, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first
          | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl
          | exact rnp_of_eq (evalFloatUnaryNeg_pushBaseStack calleeBody (bHd :: bTl) _ _ _ m0)
          | split)
      | ptrMetadata =>
        dsimp only [m0, evalRvalue, evalUnaryPtrMetadata, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | discriminant place =>
      dsimp only [m0, evalRvalue, evalPlaceDiscriminant, Memory.pushBaseStack]
      try simp only [evalOperand_nil_borrows_callStack]
      try simp only [evalPlaceRead_nil_borrows_callStack]
      try simp only [checkSafeRefDerefOk_nil_borrows]
      repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | aggregate kind ops =>
      cases kind with
      | rawPtr pt _ =>
        dsimp only [m0, evalRvalue, evalAggregateRawPtr, Memory.pushBaseStack]
        try simp only [evalOperands_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
      | adt dp vi af =>
        dsimp only [m0, evalRvalue, evalAggregateAdt, Memory.pushBaseStack]
        try simp only [evalOperands_nil_borrows_callStack]
        cases evalOperands locals ops [] gl layouts cl localDecls [] with
        | ub => exact rnp_ub
        | unsupported => exact rnp_unsup
        | ok _ _ =>
          dsimp only
          repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
      | _ =>
        dsimp only [m0, evalRvalue, Memory.pushBaseStack]
        try simp only [evalOperands_nil_borrows_callStack]
        repeat' (first | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | split)
    | shallowInitBox op ty =>
      have hU : rvalNilPushEq calleeBody (bHd :: bTl)
          (evalUseRvalue locals op (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls
            layouts)
          (evalUseRvalue locals op m0 localDecls layouts) :=
        evalRvalue_use_cons_nil_rnp calleeBody bHd bTl locals op nA gl nT cal tr cs ac ap nP cl fp ex ru
          localDecls layouts
      show rvalNilPushEq calleeBody (bHd :: bTl)
        (evalShallowInitBox locals op ty (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
        (evalShallowInitBox locals op ty m0 localDecls layouts)
      cases h0 : evalUseRvalue locals op m0 localDecls layouts with
      | ub =>
        rw [evalShallowInitBox_ub_of_use h0]; exact rnp_ub
      | unsupported =>
        rw [evalShallowInitBox_unsupported_of_use h0]; exact rnp_unsup
      | ok v l m =>
        rw [evalShallowInitBox_ok_of_use h0]
        rcases evalShallowInitBoxBody_shape op localDecls layouts v l with h_un | ⟨p, sz, h_ok⟩
        · rw [h_un m]; exact rnp_unsup
        · rw [h_ok m]
          rintro ⟨v', l', m', hEq, hNil⟩
          injection hEq with _ _ hm
          subst hm
          have hUp : evalUseRvalue locals op (Memory.pushBaseStack calleeBody (bHd :: bTl) m0)
              localDecls layouts = .ok v l (Memory.pushBaseStack calleeBody (bHd :: bTl) m) :=
            (hU ⟨v, l, m, h0, hNil⟩).trans (by rw [h0]; rfl)
          rw [evalShallowInitBox_ok_of_use hUp, h_ok _]
          rfl
    | copyForDeref place =>
      dsimp only [m0, evalRvalue, Memory.pushBaseStack, lookupBorrow,
        freezeDerefReadBorrowsAt, freezeTreeBorrowsOnReadAtProj]
      try simp only [evalOperand_nil_borrows_callStack]
      repeat' (first | contradiction | exact rnp_ub | exact rnp_unsup | exact rnp_ok rfl | exact rnp_mint | split)
    | wrapUnsafeBinder op ty =>
      have hU : rvalNilPushEq calleeBody (bHd :: bTl)
          (evalUseRvalue locals op (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls
            layouts)
          (evalUseRvalue locals op m0 localDecls layouts) :=
        evalRvalue_use_cons_nil_rnp calleeBody bHd bTl locals op nA gl nT cal tr cs ac ap nP cl fp ex ru
          localDecls layouts
      show rvalNilPushEq calleeBody (bHd :: bTl)
        (evalWrapUnsafeBinder locals op ty (Memory.pushBaseStack calleeBody (bHd :: bTl) m0) localDecls layouts)
        (evalWrapUnsafeBinder locals op ty m0 localDecls layouts)
      cases h0 : evalUseRvalue locals op m0 localDecls layouts with
      | ub =>
        rw [evalWrapUnsafeBinder_ub_of_use h0]; exact rnp_ub
      | unsupported =>
        rw [evalWrapUnsafeBinder_unsupported_of_use h0]; exact rnp_unsup
      | ok v l m =>
        rw [evalWrapUnsafeBinder_ok_of_use h0]
        rcases evalWrapUnsafeBinderBody_shape op ty localDecls layouts v l with
          h_ub | h_un | ⟨outVal, h_ok⟩
        · rw [h_ub m]; exact rnp_ub
        · rw [h_un m]; exact rnp_unsup
        · rw [h_ok m]
          rintro ⟨v', l', m', hEq, hNil⟩
          injection hEq with _ _ hm
          subst hm
          have hUp : evalUseRvalue locals op (Memory.pushBaseStack calleeBody (bHd :: bTl) m0)
              localDecls layouts = .ok v l (Memory.pushBaseStack calleeBody (bHd :: bTl) m) :=
            (hU ⟨v, l, m, h0, hNil⟩).trans (by rw [h0]; rfl)
          rw [evalWrapUnsafeBinder_ok_of_use hUp, h_ok _]
          rfl

private theorem evalStmt_retag_cons_nil_pushBaseStack
    (calleeBody : CapturedMir) (bHd : SavedCallerFrame) (bTl : List SavedCallerFrame)
    (sFr : StackFrame) (nA gl nT cal tr cs ac ap nP cl fp ex ru)
    (rk : RetagKind) (p : Place) (span : String)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    let s := MachineState.mk sFr ⟨nA, gl, [], nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ru⟩
    evalStmt (MachineState.pushBaseStack calleeBody (bHd :: bTl) s) ⟨.retag rk p, span⟩ localDecls layouts =
      MirStepNode.pushBaseStack calleeBody (bHd :: bTl)
        (evalStmt s ⟨.retag rk p, span⟩ localDecls layouts) := by
  intro s
  unfold evalStmt
  dsimp only [s, MachineState.pushBaseStack, Memory.pushBaseStack, lookupBorrow]
  try simp only [evalOperand_nil_borrows_callStack]
  cases evalOperand sFr.locals (.copy p) [] gl layouts cl localDecls [] with
  | ub => rfl
  | unsupported => rfl
  | ok val locals' =>
    dsimp only
    repeat' (first | contradiction | exact step_push_fail | exact step_push_unsupported | exact step_push_step rfl | split)

theorem evalStmt_borrows_nil_pushBaseStack
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (s ns : MachineState) (stmt : Statement)
    (localDecls : List LocalDecl) (layouts : LayoutTable)
    (h_bor : s.memory.borrows = [])
    (h_step : evalStmt s stmt localDecls layouts = MirStepNode.step ns)
    (h_ns_bor : ns.memory.borrows = []) :
    evalStmt (MachineState.pushBaseStack calleeBody baseStack s) stmt localDecls layouts =
      MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack ns) := by
  suffices evalStmt (MachineState.pushBaseStack calleeBody baseStack s) stmt localDecls layouts =
      MirStepNode.pushBaseStack calleeBody baseStack (evalStmt s stmt localDecls layouts) by
    rw [this, h_step]; rfl
  cases baseStack with
  | nil => exact evalStmt_pushBaseStack calleeBody s stmt localDecls layouts
  | cons bHd bTl =>
    rcases s with ⟨sFr, ⟨nA, gl, bor, nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ru⟩⟩
    dsimp only at h_bor; subst h_bor
    have h_hpc : ∀ p loc pr d, hasProtectedWriteConflict [] p loc none pr 0 0 d = false := by
      intro p _ _ _; cases p <;> rfl
    have h_icb : ∀ loc d, invalidateConflictingBorrows [] loc none d = [] := fun _ _ => rfl
    have h_icbp : ∀ loc pr d, invalidateConflictingBorrowsAtProj [] loc none pr 0 0 d = [] := fun _ _ _ => rfl
    have h_hpl : ∀ p loc d, hasProtectedLocalBorrow [] p loc d = false := by
      intro p _ _; cases p <;> rfl
    have h_dlb : ∀ loc d, disableLocalBorrows [] loc d = [] := fun _ _ => rfl
    rcases stmt with ⟨kind, span⟩
    cases kind with
    | nop | coverage | constEvalCounter | backwardIncompatibleDropHint _ => rfl
    | placeMention p =>
      unfold evalStmt
      dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
      cases get? sFr.locals p.local_ with
      | none => rfl
      | some sl =>
        cases sl with
        | dead => rfl
        | uninit | init _ =>
          dsimp only
          cases placeMentionOperandsInit sFr.locals _ p.projection <;> rfl
    | deinit p =>
      unfold evalStmt
      dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
      simp only [h_hpc, h_icb, h_icbp]
      repeat' (first | exact step_push_fail | exact step_push_unsupported | exact step_push_step rfl | split)
    | retag rk p =>
      exact evalStmt_retag_cons_nil_pushBaseStack calleeBody bHd bTl sFr nA gl nT cal tr cs ac ap nP cl fp ex ru rk p span localDecls layouts
    | storageLive loc =>
      unfold evalStmt
      dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
      try simp only [h_dlb, h_hpl]
      cases get? sFr.locals loc <;> (dsimp only; try (cases set? sFr.locals loc .uninit <;> (cases ap <;> rfl)); try rfl)
    | storageDead loc =>
      unfold evalStmt
      dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
      try simp only [h_dlb, h_hpl]
      cases get? sFr.locals loc <;> (dsimp only; try (cases set? sFr.locals loc .dead <;> (cases ap <;> rfl)); try rfl)
    | intrinsic intr =>
      cases intr with
      | assume op =>
        unfold evalStmt
        dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
        try simp only [evalOperand_nil_borrows_callStack]
        cases evalOperand sFr.locals op [] gl layouts cl localDecls [] with
        | ub | unsupported => rfl
        | ok v l' =>
          cases v with
          | scalar sc => dsimp only; cases Bool.and (Nat.beq sc.sizeBytes 1) (Nat.beq sc.bits 1) <;> rfl
          | _ => rfl
      | copyNonOverlapping src dst count =>
        unfold evalStmt evalCopyNonOverlapping evalCopyNonOverlappingWithCount
        dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack, lookupBorrow]
        simp only [evalOperand_nil_borrows_callStack]
        cases evalOperand sFr.locals src [] gl layouts cl localDecls [] with
        | ub | unsupported => rfl
        | ok srcVal l1 =>
          dsimp only
          cases evalOperand l1 dst [] gl layouts cl localDecls [] with
          | ub | unsupported => rfl
          | ok dstVal l2 =>
            dsimp only
            cases evalOperand l2 count [] gl layouts cl localDecls [] with
            | ub | unsupported => rfl
            | ok cntVal l3 =>
              cases cntVal with
              | scalar sc =>
                dsimp only
                cases Nat.beq sc.bits 0 with
                | true => rfl
                | false => cases srcVal <;> (cases dstVal <;> rfl)
              | _ => rfl
    | setDiscriminant p variantIdx =>
      rcases p with ⟨pLoc, _ | ⟨phd, ptl⟩⟩
      · unfold evalStmt evalSetDiscriminantLocal
        dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
        simp only [h_hpc, h_icb]
        cases get? sFr.locals pLoc with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | uninit =>
            dsimp only
            cases setDiscriminantUninitDeclOk localDecls pLoc with
            | false => rfl
            | true =>
              dsimp only
              cases setDiscriminantUninitPayload? localDecls layouts pLoc variantIdx with
              | none => rfl
              | some uf => dsimp only; cases set? sFr.locals pLoc (.init (.aggregate variantIdx uf)) <;> (cases ap <;> rfl)
          | init v =>
            cases v with
            | aggregate _ fields =>
              dsimp only
              cases padSetDiscriminantInitFields? localDecls layouts ⟨pLoc, .nil⟩ variantIdx fields with
              | none => rfl
              | some fields' =>
                dsimp only
                cases set? sFr.locals pLoc (.init (.aggregate variantIdx fields')) <;> (cases ap <;> rfl)
            | _ => rfl
      · by_cases h_d : phd = .deref
        · subst h_d
          have h_ff1 (l₁ : List LocalSlot) (rp : List ProjectionElem) (nv : Value) :=
            foreignFrameDerefWrite_nil_borrows l₁
              (Memory.pushBaseStack calleeBody (bHd :: bTl)
                (Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru))
              ⟨pLoc, .deref :: rp⟩ rp nv rfl localDecls layouts
          have h_ff2 (l₁ : List LocalSlot) (rp : List ProjectionElem) (nv : Value) :=
            foreignFrameDerefWrite_nil_borrows l₁
              (Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru)
              ⟨pLoc, .deref :: rp⟩ rp nv rfl localDecls layouts
          unfold evalStmt evalSetDiscriminantDerefWrite evalForeignFrameDerefWrite
          dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack] at h_ff1 ⊢
          simp only [evalOperand_nil_borrows_callStack, evalPlaceWrite_deref_nil_borrows, h_ff1, h_ff2]
          cases evalOperand sFr.locals (.copy ⟨pLoc, .deref :: ptl⟩) [] gl layouts cl localDecls [] with
          | unsupported => rfl
          | ok v l1 =>
            cases v with
            | aggregate _ fields =>
              dsimp only
              cases padSetDiscriminantInitFields? localDecls layouts ⟨pLoc, .deref :: ptl⟩ variantIdx fields <;> rfl
            | _ => rfl
          | ub =>
            cases ptl with
            | cons _ _ => rfl
            | nil =>
              dsimp only [lookupBorrow]
              cases get? sFr.locals pLoc with
              | none => rfl
              | some sl =>
                cases sl with
                | uninit | dead => rfl
                | init v => cases v <;> rfl
        · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (phd :: ptl) with h_s | h_nr
          · rw [evalStmt_setDiscriminant_castRoot _ _ _ _ _ _ _ _ h_s,
                evalStmt_setDiscriminant_castRoot _ _ _ _ _ _ _ _ h_s]
            unfold evalStmt evalSetDiscriminantLocal
            dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
            simp only [h_hpc, h_icb]
            repeat' (first | exact step_push_fail | exact step_push_unsupported | exact step_push_step rfl | split)
          · rw [evalStmt_setDiscriminant_nonDeref _ _ _ _ _ _ _ _ h_d h_nr,
                evalStmt_setDiscriminant_nonDeref _ _ _ _ _ _ _ _ h_d h_nr]
            dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
            simp only [evalOperand_nil_borrows_callStack, writePlaceValue_nil_borrows_callStack, h_hpc, h_icbp]
            cases evalOperand sFr.locals (.copy ⟨pLoc, phd :: ptl⟩) [] gl layouts cl localDecls [] with
            | ub | unsupported => rfl
            | ok v l1 =>
              cases v with
              | aggregate _ fields =>
                dsimp only
                cases padSetDiscriminantInitFields? localDecls layouts ⟨pLoc, phd :: ptl⟩ variantIdx fields with
                | none => rfl
                | some fields' =>
                  dsimp only
                  cases writePlaceValue l1 [] ⟨pLoc, phd :: ptl⟩ (.aggregate variantIdx fields') localDecls layouts [] <;> rfl
              | _ => rfl
    | assign dst rv =>
      let m0 := Memory.mk nA gl [] nT cal tr cs ac ap nP cl fp ex ru
      rw [evalStmt_assign_eq] at h_step
      dsimp only at h_step
      cases h_rv : evalRvalue sFr.locals rv m0 localDecls layouts with
      | ub => change evalRvalue sFr.locals rv m0 localDecls layouts = .ub at h_rv; rw [h_rv] at h_step; nomatch h_step
      | unsupported => change evalRvalue sFr.locals rv m0 localDecls layouts = .unsupported at h_rv; rw [h_rv] at h_step; nomatch h_step
      | ok val locals₁ mem₁ =>
        have h_rv' : evalRvalue sFr.locals rv m0 localDecls layouts = .ok val locals₁ mem₁ := h_rv
        rw [h_rv'] at h_step
        dsimp only at h_step
        have hm1 : mem₁.borrows = [] := by
          cases h_mb : mem₁.borrows with
          | nil => rfl
          | cons _ _ =>
            have h_ne : mem₁.borrows ≠ [] := by rw [h_mb]; nofun
            exact False.elim (evalAssignDst_borrows_ne_nil h_ne ns h_step h_ns_bor)
        rw [evalStmt_assign_eq, evalStmt_assign_eq]
        dsimp only [MachineState.pushBaseStack]
        rw [evalRvalue_borrows_nil_pushBaseStack calleeBody (bHd :: bTl) sFr.locals rv m0 localDecls layouts rfl ⟨val, locals₁, mem₁, h_rv, hm1⟩]
        rw [h_rv]
        rcases mem₁ with ⟨nA1, gl1, bor1, nT1, cal1, tr1, cs1, ac1, ap1, nP1, cl1, fp1, ex1, ru1⟩
        dsimp only at hm1; subst hm1
        dsimp only [RvalueEvalResult.pushBaseStack]
        rcases dst with ⟨dstLoc, dstProj⟩
        cases dstProj with
        | nil =>
          unfold evalAssignDst
          dsimp only [Memory.pushBaseStack]
          simp only [h_hpc, h_icb]
          cases get? locals₁ dstLoc with
          | none => rfl
          | some sl =>
            cases sl with
            | dead => rfl
            | uninit | init _ =>
              dsimp only
              cases set? locals₁ dstLoc (.init val) <;> (cases ap1 <;> rfl)
        | cons hd tl =>
          by_cases h_d : hd = .deref
          · subst h_d
            have h_ff1 := foreignFrameDerefWrite_nil_borrows locals₁
              (Memory.pushBaseStack calleeBody (bHd :: bTl)
                (Memory.mk nA1 gl1 [] nT1 cal1 tr1 cs1 ac1 ap1 nP1 cl1 fp1 ex1 ru1))
              ⟨dstLoc, .deref :: tl⟩ tl val rfl localDecls layouts
            have h_ff2 := foreignFrameDerefWrite_nil_borrows locals₁
              (Memory.mk nA1 gl1 [] nT1 cal1 tr1 cs1 ac1 ap1 nP1 cl1 fp1 ex1 ru1)
              ⟨dstLoc, .deref :: tl⟩ tl val rfl localDecls layouts
            unfold evalAssignDst evalForeignFrameDerefWrite
            dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack] at h_ff1 ⊢
            rw [h_ff1, h_ff2]
            simp only [evalPlaceWrite_deref_nil_borrows, evalCallerPlaceWrite_deref_nil_borrows]
            cases cs1 <;> (cases ru1 <;> cases cl1 <;> rfl)
          · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (hd :: tl) with h_s | h_nr
            · rw [evalAssignDst_castRoot _ _ _ _ _ _ _ _ _ h_s,
                  evalAssignDst_castRoot _ _ _ _ _ _ _ _ _ h_s]
              unfold evalAssignDst
              dsimp only [Memory.pushBaseStack]
              simp only [h_hpc, h_icb]
              cases get? locals₁ dstLoc with
              | none => rfl
              | some sl =>
                cases sl with
                | dead => rfl
                | uninit | init _ =>
                  dsimp only
                  cases set? locals₁ dstLoc (.init val) <;> (cases ap1 <;> rfl)
            · rw [evalAssignDst_nonDeref _ _ _ _ _ _ _ _ _ h_d h_nr,
                  evalAssignDst_nonDeref _ _ _ _ _ _ _ _ _ h_d h_nr]
              unfold evalAssignNonDeref
              let decls' := eraseLeadingOpaqueCastDecls localDecls layouts dstLoc (hd :: tl)
              dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
              simp only [h_hpc, h_icbp]
              cases get? locals₁ dstLoc with
              | none => rfl
              | some sl =>
                cases sl with
                | dead => rfl
                | uninit =>
                  dsimp only
                  cases uninitFieldWriteShell? localDecls layouts dstLoc hd tl with
                  | none => rfl
                  | some rv0 =>
                    dsimp only
                    cases writeProjectedForLocal locals₁ decls' layouts dstLoc rv0 (hd :: tl) val with
                    | ub | unsupported => rfl
                    | ok rv' => dsimp only; cases set? locals₁ dstLoc (.init rv') <;> (cases ap1 <;> rfl)
                | init rv0 =>
                  dsimp only
                  cases ensureNestedFieldShells rv0 (hd :: tl) decls' layouts
                      (placeTy decls' layouts { local_ := dstLoc, projection := .nil }) with
                  | none => rfl
                  | some sh0 =>
                    dsimp only
                    cases writeProjectedForLocal locals₁ decls' layouts dstLoc sh0 (hd :: tl) val with
                    | ub | unsupported => rfl
                    | ok rv' => dsimp only; cases set? locals₁ dstLoc (.init rv') <;> (cases ap1 <;> rfl)

private theorem invalidateDirectDestWriteBorrows_ne_nil
    {m : Memory} {locals : List LocalSlot} {dst : Place}
    (h : m.borrows ≠ []) :
    (invalidateDirectDestWriteBorrows m locals dst).borrows ≠ [] := by
  unfold invalidateDirectDestWriteBorrows
  cases h_b : m.borrows with
  | nil => exact False.elim (h h_b)
  | cons bHd bTl =>
    rcases dst with ⟨loc, _ | ⟨hd, tl⟩⟩
    · exact invalidateConflictingBorrows_ne_nil (by nofun)
    · cases hd <;>
        first | exact h | exact invalidateConflictingBorrowsAtProj_ne_nil (by nofun)

private theorem writeIntrinsicReturn_borrows_ne_nil_of_noCallWP
    (ms : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (retVal : Value)
    {Q : MirExecState → Prop} {R : MirOutcome → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_st :
      evalNodeNoCallWP Q R
        (writeIntrinsicReturn ms locals' destination targetBb retVal)) :
    ∃ nextSt : MachineState,
      writeIntrinsicReturn ms locals' destination targetBb retVal = MirStepNode.step nextSt ∧
      nextSt.memory.borrows ≠ [] := by
  by_cases h_is_deref : ∃ restProj, destination.projection = .deref :: restProj
  · rcases h_is_deref with ⟨restProj, h_dp⟩
    rcases destination with ⟨loc, dProj⟩
    dsimp only at h_dp; subst h_dp
    unfold writeIntrinsicReturn at h_st ⊢
    dsimp only at h_st ⊢
    cases h_ep : evalPlaceWrite locals' ms.memory.borrows ⟨loc, .deref :: restProj⟩ retVal
        ms.memory.activeProtectors [] emptyLayoutTable ms.memory.callStack with
    | unsupported => rw [h_ep] at h_st; exact False.elim h_st
    | ok updL =>
      rw [h_ep] at h_st; dsimp only at h_st ⊢
      cases h_tb : derefWriteTreeUB locals' ms.memory.borrows ⟨loc, .deref :: restProj⟩ with
      | true => rw [h_tb] at h_st; exact False.elim h_st
      | false =>
        exact ⟨{ frame := { ms.frame with blockIdx := targetBb, stmtIdx := 0, locals := updL }
                 memory := { ms.memory with
                             borrows :=
                               invalidateDerefWriteBorrows locals' ms.memory.borrows
                                 ⟨loc, .deref :: restProj⟩ restProj
                                 ms.memory.callerLocals ms.memory.callStack } },
          rfl, invalidateDerefWriteBorrows_ne_nil h_ne⟩
    | ub =>
      rw [h_ep] at h_st; dsimp only at h_st ⊢
      cases h_ff : foreignFrameDerefWrite locals' ms.memory ⟨loc, .deref :: restProj⟩ restProj retVal with
      | ub => rw [h_ff] at h_st; exact False.elim h_st
      | unsupported => rw [h_ff] at h_st; exact False.elim h_st
      | ok updL mem' =>
        exact ⟨{ frame := { ms.frame with blockIdx := targetBb, stmtIdx := 0, locals := updL }
                 memory := mem' }, rfl, foreignFrameDerefWrite_ne_nil h_ne updL mem' h_ff⟩
  · have h_nd : ∀ restProj, destination.projection ≠ .deref :: restProj :=
      fun rp h_eq => h_is_deref ⟨rp, h_eq⟩
    rw [writeIntrinsicReturn_nonDeref_eq _ _ _ _ _ h_nd] at h_st ⊢
    cases h_w : writePlaceValue locals' ms.memory.borrows destination retVal
        (callStack := ms.memory.callStack) with
    | ok updL =>
      exact ⟨{ frame := { ms.frame with blockIdx := targetBb, stmtIdx := 0, locals := updL }
               memory := invalidateDirectDestWriteBorrows ms.memory locals' destination },
        rfl, invalidateDirectDestWriteBorrows_ne_nil h_ne⟩
    | unsupported => rw [h_w] at h_st; exact False.elim h_st
    | ub => rw [h_w] at h_st; exact False.elim h_st

private theorem evalNonSelectIntrinsicCall_borrows_ne_nil_of_noCallWP
    (kind : RustIntrinsicKind) (ms : MachineState)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalNonSelectIntrinsicCall kind ms target bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb)) :
    ∃ nextSt : MachineState,
      evalNonSelectIntrinsicCall kind ms target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb = MirStepNode.step nextSt ∧
      nextSt.memory.borrows ≠ [] := by
  rcases evalNonSelectIntrinsicCall_cases kind target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb with ⟨retVal, h_wr⟩ | ⟨fk, h_fl⟩ | h_un
  · rw [h_wr ms] at h_st ⊢
    exact writeIntrinsicReturn_borrows_ne_nil_of_noCallWP ms locals' destination targetBb retVal h_ne h_st
  · rw [h_fl ms] at h_st; exact False.elim h_st
  · rw [h_un ms] at h_st; exact False.elim h_st

private theorem evalCopyNonOverlappingCall_borrows_ne_nil_of_noCallWP
    (ms : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalCopyNonOverlappingCall ms bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb)) :
    ∃ nextSt : MachineState,
      evalCopyNonOverlappingCall ms bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb = MirStepNode.step nextSt ∧
      nextSt.memory.borrows ≠ [] := by
  unfold evalCopyNonOverlappingCall at h_st ⊢
  rcases argOps with _ | ⟨srcOp, _ | ⟨dstOp, _ | ⟨cntOp, _ | ⟨_, _⟩⟩⟩⟩ <;>
    rcases argVals with
      _ | ⟨srcVal, _ | ⟨dstVal, _ | ⟨_ | countSc | ⟨_, _⟩ | ⟨_, _⟩, _ | ⟨_, _⟩⟩⟩⟩ <;>
    try exact False.elim h_st
  · -- exactly three operands and values, the last a `count` scalar
    dsimp only at h_st ⊢
    cases h_w : Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts) with
    | false => rw [h_w] at h_st; exact False.elim h_st
    | true =>
      rw [h_w] at h_st
      dsimp only at h_st ⊢
      have h_sn := evalCopyNonOverlappingWithCount_ne_nil (src := srcOp) (dst := dstOp)
        (ld := bodyLocalDecls) (ly := bodyLayouts) (sv := srcVal) (dv := dstVal)
        (cnt := countSc.bits) (l3 := locals') h_ne
      rcases evalCopyNonOverlappingWithCount_isStmtNode ms srcOp dstOp bodyLocalDecls bodyLayouts
          srcVal dstVal countSc.bits locals' with ⟨s', hs'⟩ | ⟨fk, hf⟩ | hu
      · rw [hs'] at h_st ⊢
        exact writeIntrinsicReturn_borrows_ne_nil_of_noCallWP { ms with memory := s'.memory }
          s'.frame.locals destination targetBb .unit (h_sn s' hs') h_st
      · rw [hf] at h_st; exact False.elim h_st
      · rw [hu] at h_st; exact False.elim h_st

private theorem borrowsAfterWriteBytes_ne_nil
    {bs bs' : List BorrowEntry} {ap : List Nat} {dt : Nat} {de : BorrowEntry}
    (h : bs ≠ [])
    (hok : borrowsAfterWriteBytes bs ap dt de = some bs') :
    bs' ≠ [] := by
  unfold borrowsAfterWriteBytes at hok
  have h1 := opt_guard_eq_some hok
  have h2 := opt_guard_eq_some h1
  have h3 := opt_guard_eq_some h2
  rw [← Option.some.inj h3]
  rcases bs with _ | ⟨b1, _ | ⟨b2, br⟩⟩
  · exact False.elim (h rfl)
  · cases de.targetProjection with
    | nil =>
      cases de.rangeLen.beq 0 <;> nofun
    | cons _ _ => nofun
  · nofun

private theorem commitWriteBytesDstPlaceWrite_ne_nil
    {s : MachineState} {dp : Place} {dt : Nat} {l3 : List LocalSlot} {nv : Value}
    {ld : List LocalDecl} {ly : LayoutTable}
    (h : s.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil (commitWriteBytesDstPlaceWrite s dp dt l3 nv ld ly) := by
  unfold commitWriteBytesDstPlaceWrite
  cases lookupBorrow s.memory.borrows dt with
  | none => exact sn_unsup
  | some dstEntry =>
    dsimp only
    cases hbw : borrowsAfterWriteBytes s.memory.borrows s.memory.activeProtectors dt dstEntry with
    | none => exact sn_fail
    | some borrows' =>
      dsimp only
      have hne' := borrowsAfterWriteBytes_ne_nil h hbw
      cases writePlaceValueUntyped l3 s.memory.borrows dp nv ld ly with
      | ok locals4 => exact sn_step hne'
      | unsupported => exact sn_unsup
      | ub => exact sn_fail

private theorem evalWriteBytesCall_borrows_ne_nil_of_noCallWP
    (ms : MachineState) (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand) (argVals : List Value)
    (locals' : List LocalSlot) (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalWriteBytesCall ms target bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb)) :
    ∃ nextSt : MachineState,
      evalWriteBytesCall ms target bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb = MirStepNode.step nextSt ∧
      nextSt.memory.borrows ≠ [] := by
  unfold evalWriteBytesCall at h_st ⊢
  cases h_a : writeBytesAction ms.memory.borrows (length ms.memory.callStack) target
      bodyLocalDecls bodyLayouts argOps argVals with
  | fault fk => rw [h_a] at h_st; exact False.elim h_st
  | noWrite =>
    rw [h_a] at h_st
    exact writeIntrinsicReturn_borrows_ne_nil_of_noCallWP ms locals' destination targetBb .unit
      h_ne h_st
  | store dstPlace _ dstTag newVal =>
    rw [h_a] at h_st
    dsimp only at h_st ⊢
    have h_sn : stmtStepBorrowsNeNil
        (commitWriteBytesDstPlaceWrite ms dstPlace dstTag locals' newVal bodyLocalDecls
          bodyLayouts) :=
      commitWriteBytesDstPlaceWrite_ne_nil h_ne
    rcases commitWriteBytesDstPlaceWrite_isStmtNode ms dstPlace dstTag locals' newVal
        bodyLocalDecls bodyLayouts with ⟨s', hs'⟩ | ⟨fk, hf⟩ | hu
    · rw [hs'] at h_st ⊢
      exact writeIntrinsicReturn_borrows_ne_nil_of_noCallWP { ms with memory := s'.memory }
        s'.frame.locals destination targetBb .unit (h_sn s' hs') h_st
    · rw [hf] at h_st; exact False.elim h_st
    · rw [hu] at h_st; exact False.elim h_st

private theorem borrowsAfterReadAccess_ne_nil
    {bs bs' : List BorrowEntry} {ap : List Nat} {td : List LocalDecl} {tl : LayoutTable}
    {tag : Nat} {entry : BorrowEntry} {off len : Nat}
    (h : bs ≠ [])
    (hok : borrowsAfterReadAccess bs ap td tl tag entry off len = some bs') :
    bs' ≠ [] := by
  unfold borrowsAfterReadAccess at hok
  split at hok
  · cases hok
  · dsimp only at hok
    split at hok
    · cases hok
    · injection hok with heq
      rw [← heq]
      exact freezeTreeBorrowsOnReadAtProj_ne_nil h

private theorem borrowsAfterWriteAccess_ne_nil
    {bs bs' : List BorrowEntry} {ap : List Nat} {td : List LocalDecl} {tl : LayoutTable}
    {tag : Nat} {entry : BorrowEntry} {off len : Nat}
    (h : bs ≠ [])
    (hok : borrowsAfterWriteAccess bs ap td tl tag entry off len = some bs') :
    bs' ≠ [] := by
  unfold borrowsAfterWriteAccess at hok
  repeat' (first
    | (cases hok; done)
    | (injection hok with heq; rw [← heq]
       rcases bs with _ | ⟨_, _ | ⟨_, _⟩⟩
       · exact False.elim (h rfl)
       · exact invalidateConflictingBorrowsAtProj_ne_nil h
       · exact invalidateTreeBorrowsAtProj_ne_nil h)
    | ((try dsimp only at hok); split at hok))

private theorem endpointBorrowsAfterRead_ne_nil
    {mem : Memory} {ep : ResolvedMemEndpoint} {len : Nat} {bs' : List BorrowEntry}
    (h : mem.borrows ≠ [])
    (hok : endpointBorrowsAfterRead mem ep len = some bs') :
    bs' ≠ [] := by
  unfold endpointBorrowsAfterRead at hok
  cases h_b : ep.borrow? with
  | none => rw [h_b] at hok; injection hok with heq; rw [← heq]; exact h
  | some p => rw [h_b] at hok; exact borrowsAfterReadAccess_ne_nil h hok

private theorem endpointBorrowsAfterWrite_ne_nil
    {mem : Memory} {ep : ResolvedMemEndpoint} {len : Nat} {bs' : List BorrowEntry}
    (h : mem.borrows ≠ [])
    (hok : endpointBorrowsAfterWrite mem ep len = some bs') :
    bs' ≠ [] := by
  unfold endpointBorrowsAfterWrite at hok
  cases h_b : ep.borrow? with
  | none => rw [h_b] at hok; injection hok with heq; rw [← heq]; exact h
  | some p => rw [h_b] at hok; exact borrowsAfterWriteAccess_ne_nil h hok

private theorem commitRootAbstractBytes_borrows_eq
    {mem : Memory} {locals : List LocalSlot} {ep : ResolvedMemEndpoint}
    {bs : List AbstractByte} {l' : List LocalSlot} {m' : Memory}
    (hok : commitRootAbstractBytes mem locals ep bs = .ok (l', m')) :
    m'.borrows = mem.borrows := by
  unfold commitRootAbstractBytes at hok
  repeat' (first
    | (injection hok with hp; injection hp with _ hm; subst hm; rfl)
    | (cases hok; done)
    | ((try dsimp only at hok); split at hok))

private theorem evalCopyMemory_borrows_ne_nil
    {ms : MachineState} {locals : List LocalSlot}
    {bodyLocalDecls : List LocalDecl} {bodyLayouts : LayoutTable}
    {srcPtr dstPtr : ProvenancePtr} {byteCount : Nat}
    {l' : List LocalSlot} {m' : Memory}
    (h_ne : ms.memory.borrows ≠ [])
    (hok : evalCopyMemory ms locals bodyLocalDecls bodyLayouts srcPtr dstPtr byteCount = .ok (l', m')) :
    m'.borrows ≠ [] := by
  unfold evalCopyMemory at hok
  cases h1 : resolveLiveMemEndpoint ms locals bodyLocalDecls bodyLayouts srcPtr with
  | ub | unsupported => rw [h1] at hok; nomatch hok
  | ok srcEp =>
    rw [h1] at hok; dsimp only at hok
    cases h1b : Nat.ble (Nat.add srcEp.effOff byteCount) srcEp.allocSize with
    | false => rw [h1b] at hok; nomatch hok
    | true =>
      rw [h1b] at hok; dsimp only at hok
      cases h2d : resolveLiveMemEndpoint ms locals bodyLocalDecls bodyLayouts dstPtr with
      | ub | unsupported => rw [h2d] at hok; nomatch hok
      | ok dstEp0 =>
        rw [h2d] at hok; dsimp only at hok
        cases h2b : Nat.ble (Nat.add dstEp0.effOff byteCount) dstEp0.allocSize with
        | false => rw [h2b] at hok; nomatch hok
        | true =>
          rw [h2b] at hok; dsimp only at hok
          split at hok
          · nomatch hok
          · cases h2 : endpointAccessCheck srcEp byteCount with
            | ub | unsupported => rw [h2] at hok; nomatch hok
            | ok _ =>
              rw [h2] at hok; dsimp only at hok
              split at hok
              · nomatch hok
              · rename_i b1 hb1
                have hne1 : b1 ≠ [] := by
                  cases hsb : srcEp.borrow? with
                  | none => rw [hsb] at hb1; injection hb1 with he; rw [← he]; exact h_ne
                  | some p => rw [hsb] at hb1; exact borrowsAfterReadAccess_ne_nil h_ne hb1
                try dsimp only at hok
                cases h5 : resolveLiveMemEndpoint { ms with memory := { ms.memory with borrows := b1 } }
                    locals bodyLocalDecls bodyLayouts dstPtr with
                | ub | unsupported => rw [h5] at hok; nomatch hok
                | ok dstEp =>
                  rw [h5] at hok; dsimp only at hok
                  cases h6 : endpointAccessCheck dstEp byteCount with
                  | ub | unsupported => rw [h6] at hok; nomatch hok
                  | ok _ =>
                    rw [h6] at hok; dsimp only at hok
                    split at hok
                    · nomatch hok
                    · rename_i b2 hb2
                      have hne2 : b2 ≠ [] := by
                        cases hdb : dstEp.borrow? with
                        | none => rw [hdb] at hb2; injection hb2 with he; rw [← he]; exact hne1
                        | some p => rw [hdb] at hb2; exact borrowsAfterWriteAccess_ne_nil hne1 hb2
                      try dsimp only at hok
                      cases h3 : readRootAbstractBytes ms.memory srcEp with
                      | none => rw [h3] at hok; nomatch hok
                      | some sbs =>
                        rw [h3] at hok; dsimp only at hok
                        cases h4 : sliceAbstractBytes sbs srcEp.effOff byteCount with
                        | none => rw [h4] at hok; nomatch hok
                        | some snap =>
                          rw [h4] at hok; dsimp only at hok
                          cases h8 : readRootAbstractBytes { ms.memory with borrows := b2 } dstEp with
                          | none => rw [h8] at hok; nomatch hok
                          | some dbs =>
                            rw [h8] at hok; dsimp only at hok
                            cases h9 : writeAbstractBytesAt dbs dstEp.effOff snap with
                            | none => rw [h9] at hok; nomatch hok
                            | some newDbs =>
                              rw [h9] at hok; dsimp only at hok
                              rw [commitRootAbstractBytes_borrows_eq hok]
                              exact hne2

private theorem writeIntrinsicReturnWithProtectors_stmtStepBorrowsNeNil
    {ms : MachineState} {bodyLocalDecls : List LocalDecl} {bodyLayouts : LayoutTable}
    {locals' : List LocalSlot} {destination : Place} {targetOpt : Option BasicBlockIdx}
    {retVal : Value} (h_ne : ms.memory.borrows ≠ []) :
    stmtStepBorrowsNeNil
      (writeIntrinsicReturnWithProtectors ms bodyLocalDecls bodyLayouts locals'
        destination targetOpt retVal) := by
  unfold writeIntrinsicReturnWithProtectors
  cases targetOpt with
  | none => exact sn_fail
  | some targetBb =>
    dsimp only
    split
    · exact sn_fail
    · cases hW : writeReturnDestination locals' ms.memory destination retVal bodyLocalDecls bodyLayouts with
      | ub => exact sn_fail
      | unsupported => exact sn_unsup
      | ok updL mem' => exact sn_step (writeReturnDestination_borrows_ne_nil h_ne hW)

private theorem intrinsicMissingPointeeStep_stmtStepBorrowsNeNil
    (ld : List LocalDecl) (ly : LayoutTable) (argOps : List Operand) :
    stmtStepBorrowsNeNil (intrinsicMissingPointeeStep ld ly argOps) := by
  rcases intrinsicMissingPointeeStep_fault ld ly argOps with ⟨_, hf⟩ | hu
  · rw [hf]; exact sn_fail
  · rw [hu]; exact sn_unsup

private theorem evalCoreMemPtrIntrinsicCall?_stmtStepBorrowsNeNil
    (kind : RustIntrinsicKind) (ms : MachineState) (target : ResolvedCallTarget)
    (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetOpt : Option BasicBlockIdx) {stepNode : MirStepNode}
    (h_ne : ms.memory.borrows ≠ [])
    (h_cm :
      evalCoreMemPtrIntrinsicCall? kind ms target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetOpt = some stepNode) :
    stmtStepBorrowsNeNil stepNode := by
  have hrel := evalCoreMemPtrIntrinsicCall?_rel_self (fun m => m.borrows ≠ []) kind ms target
    bodyLocalDecls bodyLayouts argOps argVals locals' destination targetOpt h_cm h_ne
    (fun _ _ _ _ hm hb => endpointBorrowsAfterRead_ne_nil hm hb)
    (fun _ _ _ _ hm hb => endpointBorrowsAfterWrite_ne_nil hm hb)
    (fun _ _ _ _ _ _ hm hok => by rw [commitRootAbstractBytes_borrows_eq hok]; exact hm)
    (fun _ _ _ _ _ hok => evalCopyMemory_borrows_ne_nil h_ne hok)
  cases hrel with
  | fail _ => exact sn_fail
  | unsupported => exact sn_unsup
  | write m l rv hm_ne => exact writeIntrinsicReturnWithProtectors_stmtStepBorrowsNeNil hm_ne

private theorem evalCoreMemPtrIntrinsicCall?_borrows_ne_nil_of_noCallWP
    (kind : RustIntrinsicKind) (ms : MachineState) (target : ResolvedCallTarget)
    (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) {stepNode : MirStepNode}
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_cm :
      evalCoreMemPtrIntrinsicCall? kind ms target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination (.some targetBb) = some stepNode)
    (h_st : evalNodeNoCallWP Q (mirNormalPost P) stepNode) :
    ∃ nextSt : MachineState,
      stepNode = MirStepNode.step nextSt ∧ nextSt.memory.borrows ≠ [] := by
  rcases evalCoreMemPtrIntrinsicCall?_isStmtNode kind ms target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination (.some targetBb) h_cm with ⟨ns, rfl⟩ | ⟨fk, rfl⟩ | rfl
  · exact ⟨ns, rfl,
      evalCoreMemPtrIntrinsicCall?_stmtStepBorrowsNeNil kind ms target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination (.some targetBb) h_ne h_cm ns rfl⟩
  · exact False.elim h_st
  · exact False.elim h_st

private theorem evalDirectRustIntrinsic?_borrows_ne_nil_of_noCallWP
    (ms : MachineState) (curBody : CapturedMir)
    (target : ResolvedCallTarget) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (unwind : UnwindAction)
    (stepNode : MirStepNode)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_ne : ms.memory.borrows ≠ [])
    (h_di :
      evalDirectRustIntrinsic? ms (some curBody) target
        curBody.localDecls curBody.layouts argOps argVals locals'
        destination targetBb unwind = some stepNode)
    (h_st : evalNodeNoCallWP Q (mirNormalPost P) stepNode) :
    ∃ nextSt : MachineState,
      stepNode = MirStepNode.step nextSt ∧ nextSt.memory.borrows ≠ [] := by
  cases h_cl : classifyRustIntrinsic? target.defPath with
  | none =>
    unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di; cases h_di
  | some rk =>
    by_cases h_cs : rk = .constEvalSelect
    · subst h_cs
      rcases argVals with _ | ⟨tupleArgVal, _ | ⟨ctFnVal, _ | ⟨rtFnVal, _ | _⟩⟩⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
      · rw [evalDirectRustIntrinsic?_constEvalSelect_three _ _ _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn; subst h_sn
        revert h_st
        unfold evalConstEvalSelectThree; dsimp only
        cases unpackConstEvalSelectArgs? tupleArgVal (selectTupleTyOpt target.typeArgs) with
        | none => intro h_st; exact False.elim h_st
        | some unpackedArgs =>
          dsimp only
          cases resolveConstEvalSelectTarget? ms target curBody.localDecls curBody.layouts
              (selectRtFnOpOpt argOps) rtFnVal (length unpackedArgs) with
          | none => intro h_st; exact False.elim h_st
          | some rtTarget =>
            dsimp only
            cases lookupCallee ms.memory.callees curBody.layouts rtTarget.defPath rtTarget.typeArgs ms.memory.traitImpls with
            | some subCallee =>
              dsimp only
              cases constEvalSelectCalleeCompatible rtTarget subCallee (length unpackedArgs) with
              | false => intro h_st; exact False.elim h_st
              | true =>
                intro _
                exact ⟨pushCalleeFrame ms curBody locals' destination targetBb subCallee
                  (constEvalSelectEntryArgs subCallee unpackedArgs) unwind, rfl, h_ne⟩
            | none =>
              dsimp only
              cases rtTarget.isIndirect with
              | true =>
                cases isGenericClosureArityMismatch ms.memory.callees rtTarget.defPath rtTarget.typeArgs <;>
                  (intro h_st; exact False.elim h_st)
              | false =>
                dsimp only
                cases isDirectExactDivTarget rtTarget with
                | true =>
                  dsimp only
                  rcases unpackedArgs with _ | ⟨_ | lhs | _ | _ | _, _ | ⟨_ | rhs | _ | _ | _, _ | _⟩⟩ <;>
                    try (intro h_st; exact False.elim h_st)
                  dsimp only
                  cases resolveIntrinsicIsSigned
                      (withConstEvalSelectIntrinsicTypeArgs rtTarget (selectTupleTyOpt target.typeArgs) false)
                      curBody.localDecls curBody.layouts
                      (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs)) with
                  | none => intro h_st; exact False.elim h_st
                  | some isSigned =>
                    dsimp only [writeIntrinsicScalarResult]
                    cases evalExactDiv lhs rhs isSigned with
                    | none => intro h_st; exact False.elim h_st
                    | some retSc =>
                      dsimp only
                      intro h_st
                      exact writeIntrinsicReturn_borrows_ne_nil_of_noCallWP
                        ms locals' destination targetBb (.scalar retSc) h_ne h_st
                | false =>
                  dsimp only
                  cases classifyRustIntrinsic? rtTarget.defPath with
                  | some rtKind =>
                    have h_step : ∀ (k : RustIntrinsicKind),
                        evalNodeNoCallWP Q (mirNormalPost P)
                          (match evalCoreMemPtrIntrinsicCall? k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) →
                        ∃ nextSt,
                          (match evalCoreMemPtrIntrinsicCall? k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k ms
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) = MirStepNode.step nextSt ∧
                          nextSt.memory.borrows ≠ [] := by
                      intro k h_st
                      cases h_cm : evalCoreMemPtrIntrinsicCall? k ms _ curBody.localDecls curBody.layouts
                          _ unpackedArgs locals' destination (.some targetBb) with
                      | some sn =>
                        rw [h_cm] at h_st
                        exact evalCoreMemPtrIntrinsicCall?_borrows_ne_nil_of_noCallWP
                          k ms _ curBody.localDecls curBody.layouts _ unpackedArgs locals'
                          destination targetBb h_ne h_cm h_st
                      | none =>
                        rw [h_cm] at h_st
                        exact evalNonSelectIntrinsicCall_borrows_ne_nil_of_noCallWP
                          k ms _ curBody.localDecls curBody.layouts _ unpackedArgs locals'
                          destination targetBb (Q := Q) (P := P) h_ne h_st
                    cases h_cs2 : (match rtKind with | .constEvalSelect => true | _ => false) with
                    | true =>
                      have : rtKind = .constEvalSelect := by cases rtKind <;> first | rfl | cases h_cs2
                      subst this; intro h_st; exact False.elim h_st
                    | false =>
                      have h_eq : ∀ (st : MachineState),
                          (match some rtKind with
                           | some .constEvalSelect => MirStepNode.fail .ub
                           | some k =>
                             match evalCoreMemPtrIntrinsicCall? k st
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 curBody.localDecls curBody.layouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination (.some targetBb) with
                             | some sn => sn
                             | none => evalNonSelectIntrinsicCall k st
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 curBody.localDecls curBody.layouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination targetBb
                           | none =>
                             match isUnreachableCallTarget rtTarget.defPath with
                             | true => MirStepNode.fail .ub
                             | false =>
                               match isAbortingPanicDefPath rtTarget.defPath with
                               | true => MirStepNode.retOutcome .abort
                               | false =>
                                 match isUnwindingPanicDefPath rtTarget.defPath with
                                 | true =>
                                   match applyUnwindAction st locals' st.memory unwind with
                                   | .running nextState => MirStepNode.step nextState
                                   | .halted out => MirStepNode.retOutcome out
                                   | .faulted fk => MirStepNode.fail fk
                                 | false =>
                                   MirStepNode.extCall
                                     { defPath := rtTarget.defPath, typeArgs := rtTarget.typeArgs,
                                       args := unpackedArgs, memory := st.memory }
                                     (resumeExternalCall st locals' destination targetBb unwind)) =
                          (match evalCoreMemPtrIntrinsicCall? rtKind st
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall rtKind st
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              curBody.localDecls curBody.layouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) := fun st => by
                        cases rtKind <;> first | (cases h_cs2; done) | rfl
                      rw [h_eq ms]
                      exact h_step rtKind
                  | none =>
                    dsimp only
                    cases isUnreachableCallTarget rtTarget.defPath with
                    | true => intro h_st; exact False.elim h_st
                    | false =>
                      dsimp only
                      cases isAbortingPanicDefPath rtTarget.defPath with
                      | true => intro h_st; exact False.elim h_st
                      | false =>
                        dsimp only
                        cases isUnwindingPanicDefPath rtTarget.defPath with
                        | false => intro h_st; exact False.elim h_st
                        | true =>
                          dsimp only
                          cases h_ap : applyUnwindAction ms locals' ms.memory unwind with
                          | running nextSt =>
                            intro _
                            exact ⟨nextSt, rfl, applyUnwindAction_borrows_ne_nil h_ne h_ap⟩
                          | halted out =>
                            cases out with
                            | panic => intro h_st; exact False.elim h_st
                            | abort => intro h_st; exact False.elim h_st
                            | normal rv =>
                              exact False.elim (applyUnwindAction_ne_normal ms locals' ms.memory unwind rv h_ap)
                          | faulted _ => intro h_st; exact False.elim h_st
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; exact False.elim h_st
    · by_cases h_cn : rk = .copyNonOverlapping
      · subst h_cn
        rw [evalDirectRustIntrinsic?_copyNonOverlapping _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn; subst h_sn
        exact evalCopyNonOverlappingCall_borrows_ne_nil_of_noCallWP ms curBody.localDecls
          curBody.layouts argOps argVals locals' destination targetBb h_ne h_st
      by_cases h_wb : rk = .writeBytes
      · subst h_wb
        rw [evalDirectRustIntrinsic?_writeBytes _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn; subst h_sn
        exact evalWriteBytesCall_borrows_ne_nil_of_noCallWP ms target curBody.localDecls
          curBody.layouts argOps argVals locals' destination targetBb h_ne h_st
      cases h_cmk : isCoreMemPtrIntrinsicKind rk with
      | true =>
        rcases evalDirectRustIntrinsic?_coreMemPtr ms (some curBody) target curBody.localDecls
            curBody.layouts argOps argVals locals' destination targetBb unwind h_cl h_cmk with
          ⟨sn0, h_cm0, h_eq0⟩
        rw [h_eq0] at h_di
        injection h_di with h_sn; subst h_sn
        exact evalCoreMemPtrIntrinsicCall?_borrows_ne_nil_of_noCallWP rk ms target
          curBody.localDecls curBody.layouts argOps argVals locals' destination targetBb
          h_ne h_cm0 h_st
      | false =>
        rw [evalDirectRustIntrinsic?_nonSelect _ _ _ _ _ _ _ _ _ _ _ h_cl h_cs h_cn h_wb h_cmk] at h_di
        injection h_di with h_sn; subst h_sn
        exact evalNonSelectIntrinsicCall_borrows_ne_nil_of_noCallWP
          rk ms target curBody.localDecls curBody.layouts argOps argVals locals' destination targetBb h_ne h_st

theorem wpMirExecNoCallSym_borrows_nil
    {f : Nat} {calleeBody : CapturedMir} {st : MirExecState}
    {P : Value → Memory → Prop}
    (h_bor_out : ∀ rv m, P rv m → m.borrows = [])
    (h_wp : wpMirExecNoCallSym f calleeBody st (mirNormalPost P)) :
    ∀ ms : MachineState, st = .running ms → ms.memory.borrows = [] := by
  induction f generalizing st with
  | zero => exact False.elim h_wp
  | succ f' ih =>
    intro ms h_eq
    subst h_eq
    suffices h_not_ne : ¬ ms.memory.borrows ≠ [] by
      cases h_mb : ms.memory.borrows with
      | nil => rfl
      | cons _ _ => exact False.elim (h_not_ne (by rw [h_mb]; nofun))
    intro h_ne
    have ih_run {ns : MachineState}
        (hw : wpMirExecNoCallSym f' calleeBody (.running ns) (mirNormalPost P)) :
        ns.memory.borrows = [] :=
      ih hw ns rfl
    unfold wpMirExecNoCallSym at h_wp
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval] at h_wp
    dsimp only [stepMirState] at h_wp
    let curBody := ms.memory.activeCallee.getD calleeBody
    rw [stepMirFn_eq_ite] at h_wp
    dsimp only at h_wp
    cases h_ph : isOtherPhase curBody.phase with
    | true =>
      rcases isOtherPhase_eq_true_iff h_ph with ⟨tag, h_t⟩
      rw [h_t] at h_wp; exact h_wp
    | false =>
      change isOtherPhase (ms.memory.activeCallee.getD calleeBody).phase = false at h_ph
      simp only [h_ph, Bool.false_eq_true, ite_false] at h_wp
      cases h_bb : get? curBody.basicBlocks (ms.frame.blockIdx : Nat) with
      | none => rw [h_bb] at h_wp; exact h_wp
      | some bb =>
        rw [h_bb] at h_wp; dsimp only at h_wp
        cases h_stmt : get? bb.statements (ms.frame.stmtIdx : Nat) with
        | some stmt =>
          rw [h_stmt] at h_wp; dsimp only at h_wp
          rcases evalStmt_isStmtNode ms stmt curBody.localDecls curBody.layouts with
            ⟨ns, h_ev⟩ | ⟨fk, h_ev⟩ | h_ev
          · rw [h_ev] at h_wp
            dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
            exact absurd (ih_run h_wp) (evalStmt_borrows_ne_nil h_ne ns h_ev)
          · rw [h_ev] at h_wp; exact h_wp
          · rw [h_ev] at h_wp; exact h_wp
        | none =>
          rw [h_stmt] at h_wp; dsimp only at h_wp
          by_cases h_len : (ms.frame.stmtIdx == length bb.statements) = true
          · simp only [h_len, ite_true] at h_wp
            rcases bb with ⟨stmts, ⟨tkind, tspan⟩, isCl⟩
            dsimp only at h_wp
            cases tkind with
            | goto target =>
              dsimp only [evalTerminator, MirStepNode.step, evalNodeNoCallWP] at h_wp
              exact absurd (ih_run h_wp) h_ne
            | switchInt discr targets =>
              dsimp only [evalTerminator, bodyLocalDeclsOf] at h_wp
              cases h_op : evalOperandWithBodyCast ms.frame.locals discr ms.memory.borrows
                  ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
              | ub => rw [h_op] at h_wp; exact h_wp
              | unsupported => rw [h_op] at h_wp; exact h_wp
              | ok v locals1 =>
                rw [h_op] at h_wp
                cases v with
                | scalar sc =>
                  dsimp only [MirStepNode.emitStep, evalNodeNoCallWP] at h_wp
                  exact absurd (ih_run h_wp) h_ne
                | _ => exact h_wp
            | unreachable => exact h_wp
            | unwindTerminate => exact h_wp
            | unwindResume =>
              dsimp only [evalTerminator] at h_wp
              cases h_uw : unwindFromCallStack ms.memory.callStack ms.memory with
              | running nextSt =>
                rw [h_uw] at h_wp
                dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                exact absurd (ih_run h_wp) (unwindFromCallStack_borrows_ne_nil h_ne h_uw)
              | halted out =>
                rw [h_uw] at h_wp
                cases out with
                | panic => exact h_wp
                | abort => exact h_wp
                | normal rv => exact unwindFromCallStack_ne_normal ms.memory.callStack ms.memory rv h_uw
              | faulted _ => rw [h_uw] at h_wp; exact h_wp
            | drop place target unw =>
              rcases evalTerminator_drop_isStmtNode ms place target unw tspan (some curBody) with
                ⟨ns, h_ev⟩ | ⟨fk, h_ev⟩ | h_ev
              · rw [h_ev] at h_wp
                dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                exact absurd (ih_run h_wp) (evalTerminator_drop_borrows_ne_nil h_ne ns h_ev)
              · rw [h_ev] at h_wp; exact h_wp
              · rw [h_ev] at h_wp; exact h_wp
            | assert cond expected target aUnwind =>
              dsimp only [evalTerminator, bodyLocalDeclsOf] at h_wp
              cases h_op : evalOperandWithBodyCast ms.frame.locals cond ms.memory.borrows
                  ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
              | ub => rw [h_op] at h_wp; exact h_wp
              | unsupported => rw [h_op] at h_wp; exact h_wp
              | ok v locals1 =>
                rw [h_op] at h_wp
                cases v with
                | scalar sc =>
                  cases expected <;> dsimp only at h_wp
                  all_goals
                    cases h_b : Nat.beq sc.bits _ with
                    | true =>
                      rw [h_b] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                      exact absurd (ih_run h_wp) h_ne
                    | false =>
                      rw [h_b] at h_wp; dsimp only at h_wp
                      cases h_ap : applyUnwindAction ms locals1 ms.memory aUnwind with
                      | running nextSt =>
                        rw [h_ap] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                        exact absurd (ih_run h_wp) (applyUnwindAction_borrows_ne_nil h_ne h_ap)
                      | halted out =>
                        rw [h_ap] at h_wp
                        cases out with
                        | panic => exact h_wp
                        | abort => exact h_wp
                        | normal rv => exact applyUnwindAction_ne_normal ms locals1 ms.memory aUnwind rv h_ap
                      | faulted _ => rw [h_ap] at h_wp; exact h_wp
                | _ => exact h_wp
            | tailCall func argOps =>
              dsimp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf] at h_wp
              cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
              | ub => rw [h_rt] at h_wp; exact h_wp
              | unsupported => rw [h_rt] at h_wp; exact h_wp
              | ok rTarget localsAfterFunc =>
                rw [h_rt] at h_wp; dsimp only at h_wp
                cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps ms.memory.borrows
                    ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                | ub => rw [h_ops] at h_wp; exact h_wp
                | unsupported => rw [h_ops] at h_wp; exact h_wp
                | ok aVals _ =>
                  rw [h_ops] at h_wp; dsimp only at h_wp
                  cases h_p : hasFrameDeallocProtectorConflict ms.memory.borrows ms.memory.activeProtectors
                      (length ms.memory.callStack) (length ms.frame.locals) with
                  | true => rw [h_p] at h_wp; exact h_wp
                  | false =>
                    rw [h_p] at h_wp; dsimp only at h_wp
                    cases h_lk : lookupCallee ms.memory.callees curBody.layouts rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                    | none =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_gc : rTarget.isIndirect && isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                        (rw [h_gc] at h_wp; exact h_wp)
                    | some subCallee =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                      | false => rw [h_ck] at h_wp; exact h_wp
                      | true =>
                        rw [h_ck] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                        exact absurd (ih_run h_wp) (tailCalleeEntryMemory_borrows_ne_nil (disableFrameBorrows_ne_nil h_ne))
            | call func argOps cDest cTarget cUnwind =>
              cases cTarget with
              | none =>
                dsimp only [evalTerminator, bodyLocalDeclsOf] at h_wp
                cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                | ub => rw [h_rt] at h_wp; exact h_wp
                | unsupported => rw [h_rt] at h_wp; exact h_wp
                | ok rTarget localsAfterFunc =>
                  rw [h_rt] at h_wp; dsimp only at h_wp
                  cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps ms.memory.borrows
                      ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                  | ub => rw [h_ops] at h_wp; exact h_wp
                  | unsupported => rw [h_ops] at h_wp; exact h_wp
                  | ok aVals cLocals' =>
                    rw [h_ops] at h_wp; dsimp only at h_wp
                    cases h_lk : lookupCallee ms.memory.callees curBody.layouts rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                    | some subCallee =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                      | false => rw [h_ck] at h_wp; exact h_wp
                      | true =>
                        rw [h_ck] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                        exact absurd (ih_run h_wp) h_ne
                    | none =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_ind : rTarget.isIndirect with
                      | true =>
                        rw [h_ind] at h_wp; dsimp only at h_wp
                        cases h_gc : isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                          (rw [h_gc] at h_wp; exact h_wp)
                      | false =>
                        rw [h_ind] at h_wp; dsimp only at h_wp
                        cases h_unr : isUnreachableCallTarget rTarget.defPath with
                        | true => rw [h_unr] at h_wp; exact h_wp
                        | false =>
                          rw [h_unr] at h_wp; dsimp only at h_wp
                          cases h_ab : isAbortingPanicDefPath rTarget.defPath with
                          | true => rw [h_ab] at h_wp; exact h_wp
                          | false =>
                            rw [h_ab] at h_wp; dsimp only at h_wp
                            cases h_up : isUnwindingPanicDefPath rTarget.defPath with
                            | false =>
                              rw [h_up] at h_wp; dsimp only at h_wp
                              rcases evalDivergingRustIntrinsic?_eq_none_or_fault ms rTarget
                                  curBody.localDecls curBody.layouts argOps aVals cLocals' cDest with
                                h_di | ⟨fk, h_di⟩ | h_di <;> (rw [h_di] at h_wp; exact h_wp)
                            | true =>
                              rw [h_up] at h_wp; dsimp only at h_wp
                              cases h_ap : applyUnwindAction ms cLocals' ms.memory cUnwind with
                              | running nextSt =>
                                rw [h_ap] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                                exact absurd (ih_run h_wp) (applyUnwindAction_borrows_ne_nil h_ne h_ap)
                              | halted out =>
                                rw [h_ap] at h_wp
                                cases out with
                                | panic => exact h_wp
                                | abort => exact h_wp
                                | normal rv => exact applyUnwindAction_ne_normal ms cLocals' ms.memory cUnwind rv h_ap
                              | faulted _ => rw [h_ap] at h_wp; exact h_wp
              | some cTargetBb =>
                dsimp only [evalTerminator, bodyLocalDeclsOf] at h_wp
                cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                | ub => rw [h_rt] at h_wp; exact h_wp
                | unsupported => rw [h_rt] at h_wp; exact h_wp
                | ok rTarget localsAfterFunc =>
                  rw [h_rt] at h_wp; dsimp only at h_wp
                  cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps ms.memory.borrows
                      ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                  | ub => rw [h_ops] at h_wp; exact h_wp
                  | unsupported => rw [h_ops] at h_wp; exact h_wp
                  | ok aVals cLocals' =>
                    rw [h_ops] at h_wp; dsimp only at h_wp
                    cases h_lk : lookupCallee ms.memory.callees curBody.layouts rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                    | some subCallee =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                      | false => rw [h_ck] at h_wp; exact h_wp
                      | true =>
                        rw [h_ck] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                        exact absurd (ih_run h_wp) h_ne
                    | none =>
                      rw [h_lk] at h_wp; dsimp only at h_wp
                      cases h_ed : isDirectExactDivTarget rTarget with
                      | false =>
                        rw [h_ed] at h_wp; dsimp only at h_wp
                        cases h_ind : rTarget.isIndirect with
                        | true =>
                          rw [h_ind] at h_wp; dsimp only at h_wp
                          cases h_gc : isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                            (rw [h_gc] at h_wp; exact h_wp)
                        | false =>
                          rw [h_ind] at h_wp; dsimp only at h_wp
                          cases h_di : evalDirectRustIntrinsic? ms (some curBody) rTarget
                              curBody.localDecls curBody.layouts argOps aVals cLocals' cDest cTargetBb cUnwind with
                          | none => rw [h_di] at h_wp; exact h_wp
                          | some stepNode =>
                            rw [h_di] at h_wp; dsimp only at h_wp
                            rcases evalDirectRustIntrinsic?_borrows_ne_nil_of_noCallWP
                                ms curBody rTarget argOps aVals cLocals' cDest cTargetBb cUnwind
                                stepNode h_ne h_di h_wp with ⟨nextSt, rfl, h_nb⟩
                            dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                            exact absurd (ih_run h_wp) h_nb
                      | true =>
                        rw [h_ed] at h_wp; dsimp only at h_wp
                        rcases aVals with _ | ⟨_ | lhsSc | _ | _, _ | ⟨_ | rhsSc | _ | _, _ | _⟩⟩ <;> try exact h_wp
                        dsimp only at h_wp
                        cases h_sig : resolveIntrinsicIsSigned rTarget curBody.localDecls curBody.layouts argOps with
                        | none => rw [h_sig] at h_wp; exact h_wp
                        | some isSigned =>
                          rw [h_sig] at h_wp; dsimp only at h_wp
                          cases h_div : evalExactDiv lhsSc rhsSc isSigned with
                          | none => rw [h_div] at h_wp; exact h_wp
                          | some retSc =>
                            rw [h_div] at h_wp; dsimp only at h_wp
                            rcases writeIntrinsicReturn_borrows_ne_nil_of_noCallWP
                                ms cLocals' cDest cTargetBb (.scalar retSc) h_ne h_wp with
                              ⟨nextSt, h_wr_eq, h_nb⟩
                            rw [h_wr_eq] at h_wp
                            dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                            exact absurd (ih_run h_wp) h_nb
            | return_ =>
              dsimp only [evalTerminator] at h_wp
              cases h_g : get? ms.frame.locals 0 with
              | none => rw [h_g] at h_wp; exact h_wp
              | some slot =>
                rw [h_g] at h_wp
                cases slot with
                | uninit => exact h_wp
                | dead => exact h_wp
                | init retVal =>
                  dsimp only at h_wp
                  cases h_p : hasFrameDeallocProtectorConflict ms.memory.borrows ms.memory.activeProtectors
                      (length ms.memory.callStack) (length ms.frame.locals) with
                  | true => rw [h_p] at h_wp; exact h_wp
                  | false =>
                    rw [h_p] at h_wp; dsimp only at h_wp
                    have h_b1 : disableFrameBorrows ms.memory.borrows (length ms.memory.callStack) (length ms.frame.locals) ≠ [] :=
                      disableFrameBorrows_ne_nil h_ne
                    cases h_stk : ms.memory.callStack with
                    | nil =>
                      rw [h_stk] at h_wp h_b1
                      cases h_vu : valueContainsUninit retVal with
                      | true => rw [h_vu] at h_wp; exact h_wp
                      | false =>
                        rw [h_vu] at h_wp
                        dsimp only [MirStepNode.retNormal, evalNodeNoCallWP, mirNormalPost] at h_wp
                        exact h_b1 (h_bor_out retVal _ h_wp)
                    | cons innerCaller innerRest =>
                      rw [h_stk] at h_wp h_b1; dsimp only at h_wp
                      cases h_div : innerCaller.isDiverging with
                      | true => rw [h_div] at h_wp; exact h_wp
                      | false =>
                        rw [h_div] at h_wp; dsimp only at h_wp
                        cases h_vu : valueContainsUninit retVal with
                        | true => rw [h_vu] at h_wp; exact h_wp
                        | false =>
                          rw [h_vu] at h_wp; dsimp only at h_wp
                          cases h_wr : writeReturnDestination innerCaller.frame.locals
                              { ms.memory with
                                borrows := disableFrameBorrows ms.memory.borrows (length (innerCaller :: innerRest)) (length ms.frame.locals)
                                callStack := innerRest
                                activeCallee := some innerCaller.callerBody
                                activeProtectors := restoreCallerProtectors innerCaller }
                              innerCaller.destination retVal
                              innerCaller.callerBody.localDecls innerCaller.callerBody.layouts with
                          | ub => rw [h_wr] at h_wp; exact h_wp
                          | unsupported => rw [h_wr] at h_wp; exact h_wp
                          | ok updLocals mem' =>
                            rw [h_wr] at h_wp; dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_wp
                            exact absurd (ih_run h_wp) (writeReturnDestination_borrows_ne_nil h_b1 h_wr)
            | _ => exact h_wp
          · simp only [h_len, Bool.false_eq_true, ite_false] at h_wp
            exact h_wp


/--
Core stack-frame suffix simulation theorem (`wpMirExecNoCallSym_pushCalleeFrame`):
Suppose `calleeBody` converges without external calls (`wpMirExecNoCallSym`) from
an unstacked entry state `(initPureState calleeBody argVals).toMachineState
{ s.memory with callStack := [], activeCallee := none }` to `mirNormalPost P`,
where every normal exit memory `memOut` satisfying `P retVal memOut` has
`memOut.borrows = []` (`h_bor_out`; under frame-scoped Tree Borrows
`DIV-MR-CALL-TARGET-LOCAL` and `DIV-MR-TB-FNENTRY-LOCAL-DEALLOC`, unstacked
depth-0 execution commutes with stacked execution at depth `length baseStack`
precisely when no borrow tags are live along the path).
Then from `pushCalleeFrame s callerBody locals' destination targetBb calleeBody
argVals unwind`, `outerBody` steps (`MirStepsConverges`) across the entire
execution of `calleeBody` and its root `.return_` directly into the resumed
caller frame via `writeReturnDestination` whenever `h_cont` holds for every
`(retVal, memOut)` satisfying `P retVal memOut`.
-/
theorem wpMirExecNoCallSym_pushCalleeFrame
    {outerBody callerBody calleeBody : CapturedMir}
    {s : MachineState}
    {locals' : List LocalSlot}
    {destination : Place}
    {targetBb : BasicBlockIdx}
    {argVals : List Value}
    {unwind : UnwindAction}
    {P : Value → Memory → Prop}
    {mid : MachineState → Prop}
    {post : MirOutcome → Prop}
    (h_callee :
      MirNoCallWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { s.memory with callStack := [], activeCallee := none })
        (mirNormalPost P))
    (h_prot_nil : s.memory.activeProtectors = [])
    (h_bor_out : ∀ retVal memOut, P retVal memOut → memOut.borrows = [])
    (h_cont :
      ∀ (retVal : Value) (memOut : Memory),
        P retVal memOut →
        ∃ (updatedLocals : List LocalSlot) (memResumed : Memory),
          writeReturnDestination locals'
            { memOut with
              callStack := s.memory.callStack
              activeCallee := some callerBody
              activeProtectors := []
              rootUnwindCeiling := s.memory.rootUnwindCeiling }
            destination retVal callerBody.localDecls callerBody.layouts =
            .ok updatedLocals memResumed ∧
          mid {
            frame := {
              s.frame with
              blockIdx := targetBb
              stmtIdx := 0
              locals := updatedLocals
            }
            memory := memResumed
          })
    (h_ceil : s.memory.rootUnwindCeiling = true := by rfl) :
    MirStepsConverges outerBody
      (pushCalleeFrame s callerBody locals' destination targetBb calleeBody
        argVals unwind)
      mid post := by
  rcases h_callee with ⟨fuel, h_wp⟩
  let savedCaller : SavedCallerFrame := {
    callerBody := callerBody
    frame := { s.frame with locals := locals' }
    destination := destination
    returnTarget := targetBb
    calleeProtectors := s.memory.activeProtectors
    returnUnwind := unwind
    isDiverging := false
  }
  let baseStack : List SavedCallerFrame := savedCaller :: s.memory.callStack
  have h_restore_prot : restoreCallerProtectors savedCaller = [] := by
    simp [savedCaller, restoreCallerProtectors, h_prot_nil]
  suffices ∀ (f : Nat) (st : MirExecState),
      wpMirExecNoCallSym f calleeBody st (mirNormalPost P) →
      (∀ rv m, st = .halted (.normal (rv, m)) → False) →
      ∃ f_out : Nat,
        wpMirExecStepsSym f_out outerBody
          (MirExecState.pushBaseStack calleeBody baseStack st)
          (fun
            | .running ms' => mid ms'
            | .halted out => post out
            | .faulted _ => False)
          post by
    have h_init_eq :
        MirExecState.pushBaseStack calleeBody baseStack
          (.running (initMachineStateWithMemory calleeBody argVals
            { s.memory with callStack := [], activeCallee := none })) =
        .running (pushCalleeFrame s callerBody locals' destination targetBb
          calleeBody argVals unwind) := by
      rcases s with ⟨_, ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _⟩⟩
      dsimp only [baseStack, MirExecState.pushBaseStack, MachineState.pushBaseStack,
        Memory.pushBaseStack, initMachineStateWithMemory, pushCalleeFrame,
        narrowCallStackForTailCallee] at h_ceil ⊢
      subst h_ceil; rfl
    rcases this fuel _ h_wp (fun _ _ h_eq => by cases h_eq) with ⟨f_out, hf_out⟩
    rw [h_init_eq] at hf_out
    exact ⟨f_out, hf_out⟩
  intro f
  induction f with
  | zero =>
    intro st h_st
    exact False.elim h_st
  | succ f' ih =>
    intro st h_st h_not_halted
    have h_st_orig := h_st
    unfold wpMirExecNoCallSym at h_st
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval] at h_st
    have mkStep :
        ∀ {f_sub : Nat},
          evalNodeNoCallWP
            (fun st' =>
              wpMirExecStepsSym f_sub outerBody st'
                (fun
                  | .running ms' => mid ms'
                  | .halted out => post out
                  | .faulted _ => False)
                post)
            post
            (stepMirState outerBody
              (MirExecState.pushBaseStack calleeBody baseStack st)) →
          ∃ f_out : Nat,
            wpMirExecStepsSym f_out outerBody
              (MirExecState.pushBaseStack calleeBody baseStack st)
              (fun
                | .running ms' => mid ms'
                | .halted out => post out
                | .faulted _ => False)
              post := by
      intro f_sub h_node
      refine ⟨f_sub + 1, ?_⟩
      unfold wpMirExecStepsSym
      rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
      exact h_node
    cases st with
    | faulted fk =>
      exact False.elim h_st
    | halted out =>
      cases out with
      | normal rv => exact False.elim (h_not_halted rv.1 rv.2 rfl)
      | panic => exact False.elim h_st
      | abort => exact False.elim h_st
    | running ms =>
      have h_ms_bor : ms.memory.borrows = [] :=
        wpMirExecNoCallSym_borrows_nil h_bor_out h_st_orig ms rfl
      clear h_st_orig
      dsimp only [MirExecState.pushBaseStack, stepMirState] at h_st ⊢
      have h_act :
          (MachineState.pushBaseStack calleeBody baseStack ms).memory.activeCallee.getD outerBody =
            ms.memory.activeCallee.getD calleeBody := rfl
      let curBody := ms.memory.activeCallee.getD calleeBody
      rw [stepMirFn_eq_ite] at h_st
      dsimp only at h_st
      have liftTau :
          ∀ {st_un : MirExecState},
            stepMirFn outerBody (MachineState.pushBaseStack calleeBody baseStack ms) =
              .tau (MirExecState.pushBaseStack calleeBody baseStack st_un) →
            wpMirExecNoCallSym f' calleeBody st_un (mirNormalPost P) →
            (∀ rv m, st_un = .halted (.normal (rv, m)) → False) →
            ∃ f_out : Nat,
              wpMirExecStepsSym f_out outerBody
                (.running (MachineState.pushBaseStack calleeBody baseStack ms))
                (fun
                  | .running ms' => mid ms'
                  | .halted out => post out
                  | .faulted _ => False)
                post := by
        intro st_un h_step_eq h_next h_nh
        rcases ih st_un h_next h_nh with ⟨f_sub, hf_sub⟩
        refine mkStep (f_sub := f_sub) ?_
        dsimp only [MirExecState.pushBaseStack, stepMirState]
        rw [h_step_eq]
        exact hf_sub
      have liftObs :
          ∀ {obs : MirObsE.I} {k_un : PUnit → MirExecState},
            stepMirFn outerBody (MachineState.pushBaseStack calleeBody baseStack ms) =
              .vis (.inr (.inl obs))
                (fun u => MirExecState.pushBaseStack calleeBody baseStack (k_un u)) →
            wpMirExecNoCallSym f' calleeBody (k_un PUnit.unit) (mirNormalPost P) →
            (∀ rv m, k_un PUnit.unit = .halted (.normal (rv, m)) → False) →
            ∃ f_out : Nat,
              wpMirExecStepsSym f_out outerBody
                (.running (MachineState.pushBaseStack calleeBody baseStack ms))
                (fun
                  | .running ms' => mid ms'
                  | .halted out => post out
                  | .faulted _ => False)
                post := by
        intro obs k_un h_step_eq h_next h_nh
        rcases ih (k_un PUnit.unit) h_next h_nh with ⟨f_sub, hf_sub⟩
        refine mkStep (f_sub := f_sub) ?_
        dsimp only [MirExecState.pushBaseStack, stepMirState]
        rw [h_step_eq]
        exact hf_sub
      have h_phase_or :
          (∃ tag, curBody.phase = .other tag) ∨
          (evalNodeNoCallWP
              (fun st' => wpMirExecNoCallSym f' calleeBody st' (mirNormalPost P))
              (mirNormalPost P)
              (match get? curBody.basicBlocks ms.frame.blockIdx with
               | none => MirStepNode.fail .ub
               | some bb =>
                 match get? bb.statements ms.frame.stmtIdx with
                 | some stmt =>
                   evalStmt ms stmt curBody.localDecls curBody.layouts
                 | none =>
                   if ms.frame.stmtIdx == length bb.statements then
                     evalTerminator ms bb.terminator (some curBody)
                   else MirStepNode.fail .ub) ∧
           stepMirFn outerBody (MachineState.pushBaseStack calleeBody baseStack ms) =
              match get? curBody.basicBlocks ms.frame.blockIdx with
              | none => MirStepNode.fail .ub
              | some bb =>
                match get? bb.statements ms.frame.stmtIdx with
                | some stmt =>
                  evalStmt (MachineState.pushBaseStack calleeBody baseStack ms)
                    stmt curBody.localDecls curBody.layouts
                | none =>
                  if ms.frame.stmtIdx == length bb.statements then
                    evalTerminator (MachineState.pushBaseStack calleeBody baseStack ms)
                      bb.terminator (some curBody)
                  else MirStepNode.fail .ub) := by
        cases h_ph : isOtherPhase curBody.phase with
        | true => exact Or.inl (isOtherPhase_eq_true_iff h_ph)
        | false =>
          refine Or.inr ⟨?_, ?_⟩
          · rw [h_ph] at h_st; exact h_st
          · rw [stepMirFn_eq_ite]
            dsimp only
            rw [h_act, h_ph]
            rfl
      rcases h_phase_or with ⟨tag, h_ph⟩ | ⟨h_st_body, h_step_body⟩
      · rw [h_ph] at h_st
        exact False.elim h_st
      · clear h_st
        have h_st := h_st_body
        clear h_st_body
        cases h_bb : get? curBody.basicBlocks (ms.frame.blockIdx : Nat) with
        | none =>
          rw [h_bb] at h_st
          exact False.elim h_st
        | some bb =>
          rw [h_bb] at h_st h_step_body
          dsimp only at h_st h_step_body
          cases h_stmt : get? bb.statements (ms.frame.stmtIdx : Nat) with
          | some stmt =>
            rw [h_stmt] at h_st h_step_body
            dsimp only at h_st h_step_body
            rcases evalStmt_isStmtNode ms stmt curBody.localDecls curBody.layouts with
              ⟨ns, h_ev⟩ | ⟨fk, h_ev⟩ | h_ev
            · rw [h_ev] at h_st
              dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st
              have h_ns_bor : ns.memory.borrows = [] :=
                wpMirExecNoCallSym_borrows_nil h_bor_out h_st ns rfl
              rw [evalStmt_borrows_nil_pushBaseStack calleeBody baseStack ms ns stmt
                curBody.localDecls curBody.layouts h_ms_bor h_ev h_ns_bor] at h_step_body
              dsimp only [MirStepNode.step] at h_step_body
              exact liftTau (st_un := .running ns) h_step_body h_st (fun _ _ h => nomatch h)
            · rw [h_ev] at h_st; exact False.elim h_st
            · rw [h_ev] at h_st; exact False.elim h_st
          | none =>
            rw [h_stmt] at h_st h_step_body
            dsimp only at h_st h_step_body
            by_cases h_len : (ms.frame.stmtIdx == length bb.statements) = true
            · simp only [h_len, ite_true] at h_st h_step_body
              rcases bb with ⟨stmts, ⟨tkind, tspan⟩, isCl⟩
              dsimp only at h_st h_step_body
              cases tkind with
              | goto target =>
                dsimp only [evalTerminator, MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                exact liftTau
                  (st_un := .running {
                    ms with frame := { ms.frame with blockIdx := target, stmtIdx := 0 } })
                  h_step_body h_st (fun _ _ h => by cases h)
              | switchInt discr targets =>
                simp only [evalTerminator, bodyLocalDeclsOf, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                  Memory.pushBaseStack_globals, Memory.pushBaseStack_callerLocals, h_ms_bor,
                  evalOperandWithBodyCast_nil_borrows_callStack] at h_st h_step_body
                cases h_op : evalOperandWithBodyCast ms.frame.locals discr []
                    ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls [] with
                | ub => rw [h_op] at h_st; exact False.elim h_st
                | unsupported => rw [h_op] at h_st; exact False.elim h_st
                | ok v locals1 =>
                  rw [h_op] at h_st h_step_body
                  cases v with
                  | scalar sc =>
                    dsimp only [MirStepNode.emitStep, evalNodeNoCallWP] at h_st h_step_body
                    exact liftObs
                      (k_un := fun _ => .running {
                        ms with frame := {
                          blockIdx := lookupSwitchTarget sc.bits targets.branches targets.otherwise
                          stmtIdx := 0
                          locals := locals1 } })
                      h_step_body h_st (fun _ _ h => by cases h)
                  | _ => exact False.elim h_st
              | unreachable =>
                exact False.elim h_st
              | unwindTerminate =>
                exact False.elim h_st
              | unwindResume =>
                simp only [evalTerminator, MachineState.pushBaseStack_memory] at h_st h_step_body
                have h_cs_bs : (Memory.pushBaseStack calleeBody baseStack ms.memory).callStack =
                    ms.memory.callStack ++ narrowCallStackForTailCallee baseStack ms.memory.rootUnwindCeiling := rfl
                rw [h_cs_bs] at h_step_body
                have h_np : unwindFromCallStack ms.memory.callStack ms.memory ≠ .halted .panic := by
                  intro h_p; rw [h_p] at h_st; exact h_st
                have h_nu : unwindFromCallStack ms.memory.callStack ms.memory ≠ .faulted .ub := by
                  intro h_u; rw [h_u] at h_st; exact h_st
                have h_uw_eq := unwindFromCallStack_pushBaseStack_of_ne_panic
                  calleeBody baseStack ms.memory.callStack ms.memory h_np h_nu (Or.inr h_ms_bor)
                rw [h_uw_eq] at h_step_body
                cases h_uw : unwindFromCallStack ms.memory.callStack ms.memory with
                | running nextSt =>
                  rw [h_uw] at h_st h_step_body
                  dsimp only [MirExecState.pushBaseStack, MirStepNode.step,
                    evalNodeNoCallWP] at h_st h_step_body
                  exact liftTau (st_un := .running nextSt) h_step_body h_st (fun _ _ h => by cases h)
                | halted out =>
                  rw [h_uw] at h_st
                  cases out with
                  | panic => exact False.elim h_st
                  | abort => exact False.elim h_st
                  | normal rv =>
                    exact False.elim (unwindFromCallStack_ne_normal ms.memory.callStack ms.memory rv h_uw)
                | faulted fk =>
                  rw [h_uw] at h_st
                  exact False.elim h_st
              | drop place target unw =>
                rw [evalTerminator_drop_pushBaseStack_borrows_nil calleeBody baseStack ms place target unw tspan (some curBody) h_ms_bor] at h_step_body
                rcases evalTerminator_drop_isStmtNode ms place target unw tspan (some curBody) with
                  ⟨ns, h_ev⟩ | ⟨fk, h_ev⟩ | h_ev
                · rw [h_ev] at h_st h_step_body
                  dsimp only [MirStepNode.pushBaseStack, MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                  exact liftTau (st_un := .running ns) h_step_body h_st (fun _ _ h => by cases h)
                · rw [h_ev] at h_st; exact False.elim h_st
                · rw [h_ev] at h_st; exact False.elim h_st
              | assert cond expected target aUnwind =>
                simp only [evalTerminator, bodyLocalDeclsOf, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                  Memory.pushBaseStack_globals, Memory.pushBaseStack_callerLocals, h_ms_bor,
                  evalOperandWithBodyCast_nil_borrows_callStack] at h_st h_step_body
                cases h_op : evalOperandWithBodyCast ms.frame.locals cond []
                    ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls [] with
                | ub => rw [h_op] at h_st; exact False.elim h_st
                | unsupported => rw [h_op] at h_st; exact False.elim h_st
                | ok v locals1 =>
                  rw [h_op] at h_st h_step_body
                  cases v with
                  | scalar sc =>
                    have h_assert_branch :
                        ∀ expBit : Nat,
                          evalNodeNoCallWP
                            (fun st' => wpMirExecNoCallSym f' calleeBody st' (mirNormalPost P))
                            (mirNormalPost P)
                            (match Nat.beq sc.bits expBit with
                             | true =>
                               MirStepNode.step { ms with frame := { blockIdx := target, stmtIdx := 0, locals := locals1 } }
                             | false =>
                               match applyUnwindAction ms locals1 ms.memory aUnwind with
                               | .running nextSt => MirStepNode.step nextSt
                               | .halted out => MirStepNode.retOutcome out
                               | .faulted fk => MirStepNode.fail fk) →
                          stepMirFn outerBody (MachineState.pushBaseStack calleeBody baseStack ms) =
                            (match Nat.beq sc.bits expBit with
                             | true =>
                               MirStepNode.step
                                 { MachineState.pushBaseStack calleeBody baseStack ms with
                                   frame := { blockIdx := target, stmtIdx := 0, locals := locals1 } }
                             | false =>
                               match applyUnwindAction (MachineState.pushBaseStack calleeBody baseStack ms)
                                   locals1 (Memory.pushBaseStack calleeBody baseStack ms.memory) aUnwind with
                               | .running nextSt => MirStepNode.step nextSt
                               | .halted out => MirStepNode.retOutcome out
                               | .faulted fk => MirStepNode.fail fk) →
                          ∃ f_out : Nat,
                            wpMirExecStepsSym f_out outerBody
                              (.running (MachineState.pushBaseStack calleeBody baseStack ms))
                              (fun
                                | .running ms' => mid ms'
                                | .halted out => post out
                                | .faulted _ => False)
                              post := by
                      intro expBit h_st_a h_sb_a
                      cases h_b : Nat.beq sc.bits expBit with
                      | true =>
                        rw [h_b] at h_st_a h_sb_a
                        dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st_a h_sb_a
                        exact liftTau
                          (st_un := .running {
                            ms with frame := { blockIdx := target, stmtIdx := 0, locals := locals1 } })
                          h_sb_a h_st_a (fun _ _ h => by cases h)
                      | false =>
                        rw [h_b] at h_st_a h_sb_a
                        dsimp only at h_st_a h_sb_a
                        have h_np : applyUnwindAction ms locals1 ms.memory aUnwind ≠ .halted .panic := by
                          intro h_p; rw [h_p] at h_st_a; exact h_st_a
                        have h_nu : applyUnwindAction ms locals1 ms.memory aUnwind ≠ .faulted .ub := by
                          intro h_u; rw [h_u] at h_st_a; exact h_st_a
                        have h_ap_eq := applyUnwindAction_pushBaseStack_of_ne_panic
                          calleeBody baseStack ms locals1 aUnwind h_np h_nu (Or.inr h_ms_bor)
                        rw [h_ap_eq] at h_sb_a
                        cases h_ap : applyUnwindAction ms locals1 ms.memory aUnwind with
                        | running nextSt =>
                          rw [h_ap] at h_st_a h_sb_a
                          dsimp only [MirExecState.pushBaseStack, MirStepNode.step,
                            evalNodeNoCallWP] at h_st_a h_sb_a
                          exact liftTau (st_un := .running nextSt) h_sb_a h_st_a (fun _ _ h => by cases h)
                        | halted out =>
                          rw [h_ap] at h_st_a
                          cases out with
                          | panic => exact False.elim h_st_a
                          | abort => exact False.elim h_st_a
                          | normal rv =>
                            exact False.elim
                              (applyUnwindAction_ne_normal ms locals1 ms.memory aUnwind rv h_ap)
                        | faulted _ =>
                          rw [h_ap] at h_st_a
                          exact False.elim h_st_a
                    cases expected with
                    | true => exact h_assert_branch 1 h_st h_step_body
                    | false => exact h_assert_branch 0 h_st h_step_body
                  | _ => exact False.elim h_st
              | tailCall func argOps =>
                simp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf,
                  resolveCallTarget_borrows_nil_pushBaseStack calleeBody baseStack ms func (length argOps) curBody.localDecls curBody.layouts h_ms_bor,
                  MachineState.pushBaseStack_frame, MachineState.pushBaseStack_memory,
                  Memory.pushBaseStack_borrows, Memory.pushBaseStack_globals,
                  Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_callees,
                  Memory.pushBaseStack_traitImpls, Memory.pushBaseStack_activeProtectors,
                  h_ms_bor, evalOperandsWithBodyCast_nil_borrows_callStack,
                  hasFrameDeallocProtectorConflict_nil, disableFrameBorrows] at h_st h_step_body
                cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                | ub => rw [h_rt] at h_st; exact False.elim h_st
                | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                | ok rTarget localsAfterFunc =>
                  rw [h_rt] at h_st h_step_body
                  dsimp only at h_st h_step_body
                  cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps []
                      ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls [] with
                  | ub => rw [h_ops] at h_st; exact False.elim h_st
                  | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                  | ok aVals _ =>
                    rw [h_ops] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_lk : lookupCallee ms.memory.callees curBody.layouts
                        rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                    | none =>
                      rw [h_lk] at h_st; dsimp only at h_st
                      cases h_gc : rTarget.isIndirect && isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                        (rw [h_gc] at h_st; exact False.elim h_st)
                    | some subCallee =>
                      rw [h_lk] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                      | false => rw [h_ck] at h_st; exact False.elim h_st
                      | true =>
                        rw [h_ck] at h_st h_step_body
                        dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                        have h_st' : wpMirExecNoCallSym f' calleeBody (.running (enterTailCalleeFrame ms.memory subCallee (calleeEntryArgs rTarget subCallee aVals))) (mirNormalPost P) :=
                          Eq.mp (by
                            rcases ms with ⟨msFr, ⟨_, _, bor, _, _, _, cs, _, _, _, _, _, _, _⟩⟩
                            dsimp only at h_ms_bor ⊢; subst h_ms_bor
                            cases cs with
                            | cons _ _ => rfl
                            | nil =>
                              dsimp only [tailCalleeEntryMemory, relocateRootCallerReferents, hasAnyRootCallerReferent]
                              cases Nat.blt (length msFr.locals) (length (initLocals subCallee (calleeEntryArgs rTarget subCallee aVals))) <;> rfl) h_st
                        have h_step_body' :
                            stepMirFn outerBody (MachineState.pushBaseStack calleeBody baseStack ms) =
                              Trusted.ITree.ITreeF.tau
                                (MirExecState.pushBaseStack calleeBody baseStack
                                  (.running (enterTailCalleeFrame ms.memory subCallee (calleeEntryArgs rTarget subCallee aVals)))) :=
                          h_step_body.trans (by
                            rcases ms with ⟨_, ⟨_, _, bor, _, _, _, cs, ac, _, _, _, _, _, ruc⟩⟩
                            dsimp only [baseStack, enterTailCalleeFrame, MachineState.pushBaseStack,
                              MirExecState.pushBaseStack, Memory.pushBaseStack,
                              narrowCallStackForTailCallee, tailCalleeEntryMemory] at h_ms_bor ⊢
                            subst h_ms_bor
                            cases cs <;> cases ruc <;> cases subCallee.fnAbi.canUnwind <;> cases ac <;> rfl)
                        exact liftTau
                          (st_un := .running (enterTailCalleeFrame ms.memory subCallee (calleeEntryArgs rTarget subCallee aVals)))
                          h_step_body' h_st' (fun _ _ h => by cases h)
              | call func argOps cDest cTarget cUnwind =>
                cases cTarget with
                | none =>
                  simp only [evalTerminator, bodyLocalDeclsOf,
                    resolveCallTarget_borrows_nil_pushBaseStack calleeBody baseStack ms func (length argOps) curBody.localDecls curBody.layouts h_ms_bor,
                    MachineState.pushBaseStack_memory,
                    Memory.pushBaseStack_borrows, Memory.pushBaseStack_globals,
                    Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_callees,
                    Memory.pushBaseStack_traitImpls, h_ms_bor,
                    evalOperandsWithBodyCast_nil_borrows_callStack] at h_st h_step_body
                  cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                  | ub => rw [h_rt] at h_st; exact False.elim h_st
                  | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                  | ok rTarget localsAfterFunc =>
                    rw [h_rt] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps []
                        ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls [] with
                    | ub => rw [h_ops] at h_st; exact False.elim h_st
                    | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                    | ok aVals cLocals' =>
                      rw [h_ops] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_lk : lookupCallee ms.memory.callees curBody.layouts
                          rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                      | some subCallee =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                        | false => rw [h_ck] at h_st; exact False.elim h_st
                        | true =>
                          rw [h_ck] at h_st h_step_body
                          dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                          exact liftTau
                            (st_un := .running (pushDivergingCalleeFrame ms curBody cLocals'
                              cDest cUnwind subCallee (calleeEntryArgs rTarget subCallee aVals)))
                            h_step_body h_st (fun _ _ h => by cases h)
                      | none =>
                        rw [h_lk] at h_st h_step_body
                        cases h_ind : rTarget.isIndirect with
                        | true =>
                          rw [h_ind] at h_st; dsimp only at h_st
                          cases h_gc : isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                            (rw [h_gc] at h_st; exact False.elim h_st)
                        | false =>
                          rw [h_ind] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases h_unr : isUnreachableCallTarget rTarget.defPath with
                          | true => rw [h_unr] at h_st; exact False.elim h_st
                          | false =>
                            rw [h_unr] at h_st h_step_body
                            dsimp only at h_st h_step_body
                            cases h_ab : isAbortingPanicDefPath rTarget.defPath with
                            | true => rw [h_ab] at h_st; exact False.elim h_st
                            | false =>
                              rw [h_ab] at h_st h_step_body
                              dsimp only at h_st h_step_body
                              cases h_up : isUnwindingPanicDefPath rTarget.defPath with
                              | false =>
                                rw [h_up] at h_st; dsimp only at h_st
                                rcases evalDivergingRustIntrinsic?_eq_none_or_fault ms rTarget
                                    curBody.localDecls curBody.layouts argOps aVals cLocals' cDest with
                                  h_di | ⟨fk, h_di⟩ | h_di <;> (rw [h_di] at h_st; exact False.elim h_st)
                              | true =>
                                rw [h_up] at h_st h_step_body
                                dsimp only at h_st h_step_body
                                have h_np :
                                    applyUnwindAction ms cLocals' ms.memory cUnwind ≠
                                      .halted .panic := by
                                  intro h_p; rw [h_p] at h_st; exact h_st
                                have h_nu :
                                    applyUnwindAction ms cLocals' ms.memory cUnwind ≠
                                      .faulted .ub := by
                                  intro h_u; rw [h_u] at h_st; exact h_st
                                have h_ap_eq := applyUnwindAction_pushBaseStack_of_ne_panic
                                  calleeBody baseStack ms cLocals' cUnwind h_np h_nu (Or.inr h_ms_bor)
                                rw [h_ap_eq] at h_step_body
                                cases h_ap : applyUnwindAction ms cLocals' ms.memory cUnwind with
                                | running nextSt =>
                                  rw [h_ap] at h_st h_step_body
                                  dsimp only [MirExecState.pushBaseStack, MirStepNode.step,
                                    evalNodeNoCallWP] at h_st h_step_body
                                  exact liftTau (st_un := .running nextSt) h_step_body h_st (fun _ _ h => by cases h)
                                | halted out =>
                                  rw [h_ap] at h_st
                                  cases out with
                                  | panic => exact False.elim h_st
                                  | abort => exact False.elim h_st
                                  | normal rv =>
                                    exact False.elim
                                      (applyUnwindAction_ne_normal ms cLocals' ms.memory cUnwind rv h_ap)
                                | faulted _ =>
                                  rw [h_ap] at h_st
                                  exact False.elim h_st
                | some cTargetBb =>
                  simp only [evalTerminator, bodyLocalDeclsOf,
                    resolveCallTarget_borrows_nil_pushBaseStack calleeBody baseStack ms func (length argOps) curBody.localDecls curBody.layouts h_ms_bor,
                    MachineState.pushBaseStack_memory,
                    Memory.pushBaseStack_borrows, Memory.pushBaseStack_globals,
                    Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_callees,
                    Memory.pushBaseStack_traitImpls, h_ms_bor,
                    evalOperandsWithBodyCast_nil_borrows_callStack] at h_st h_step_body
                  cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                  | ub => rw [h_rt] at h_st; exact False.elim h_st
                  | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                  | ok rTarget localsAfterFunc =>
                    rw [h_rt] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_ops : evalOperandsWithBodyCast localsAfterFunc argOps []
                        ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls [] with
                    | ub => rw [h_ops] at h_st; exact False.elim h_st
                    | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                    | ok aVals cLocals' =>
                      rw [h_ops] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_lk : lookupCallee ms.memory.callees curBody.layouts
                          rTarget.defPath rTarget.typeArgs ms.memory.traitImpls with
                      | some subCallee =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ck : checkCalleeTargetCompatible rTarget subCallee (length aVals) with
                        | false => rw [h_ck] at h_st; exact False.elim h_st
                        | true =>
                          rw [h_ck] at h_st h_step_body
                          dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                          exact liftTau
                            (st_un := .running (pushCalleeFrame ms curBody cLocals'
                              cDest cTargetBb subCallee (calleeEntryArgs rTarget subCallee aVals) cUnwind))
                            h_step_body h_st (fun _ _ h => by cases h)
                      | none =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ed : isDirectExactDivTarget rTarget with
                        | false =>
                          rw [h_ed] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases h_ind : rTarget.isIndirect with
                          | true =>
                            rw [h_ind] at h_st; dsimp only at h_st
                            cases h_gc : isGenericClosureArityMismatch ms.memory.callees rTarget.defPath rTarget.typeArgs <;>
                              (rw [h_gc] at h_st; exact False.elim h_st)
                          | false =>
                            rw [h_ind] at h_st h_step_body
                            dsimp only at h_st h_step_body
                            cases h_di :
                              evalDirectRustIntrinsic? ms (some curBody) rTarget
                                curBody.localDecls curBody.layouts argOps aVals
                                cLocals' cDest cTargetBb cUnwind with
                            | none => rw [h_di] at h_st; exact False.elim h_st
                            | some stepNode =>
                              rw [h_di] at h_st
                              dsimp only at h_st
                              rcases evalDirectRustIntrinsic?_pushBaseStack_of_noCallWP
                                  calleeBody baseStack ms curBody rTarget argOps
                                  aVals cLocals' cDest cTargetBb cUnwind stepNode
                                  h_di h_st (Or.inr h_ms_bor) with
                                ⟨nextSt, rfl, h_m2⟩
                              rw [h_m2] at h_step_body
                              dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                              exact liftTau (st_un := .running nextSt) h_step_body h_st
                                (fun _ _ h => by cases h)
                        | true =>
                          rw [h_ed] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases aVals with
                          | nil => exact False.elim h_st
                          | cons v1 tl1 =>
                            cases v1 <;> try exact False.elim h_st
                            cases tl1 with
                            | nil => exact False.elim h_st
                            | cons v2 tl2 =>
                              cases v2 <;> try exact False.elim h_st
                              cases tl2 with
                              | cons _ _ => exact False.elim h_st
                              | nil =>
                                rename_i lhsSc rhsSc
                                dsimp only at h_st h_step_body
                                cases h_sig :
                                  resolveIntrinsicIsSigned rTarget curBody.localDecls
                                    curBody.layouts argOps with
                                | none => rw [h_sig] at h_st; exact False.elim h_st
                                | some isSigned =>
                                  rw [h_sig] at h_st h_step_body
                                  dsimp only at h_st h_step_body
                                  cases h_div : evalExactDiv lhsSc rhsSc isSigned with
                                  | none => rw [h_div] at h_st; exact False.elim h_st
                                  | some retSc =>
                                    rw [h_div] at h_st h_step_body
                                    dsimp only at h_st h_step_body
                                    rcases writeIntrinsicReturn_pushBaseStack_of_noCallWP
                                        calleeBody baseStack ms cLocals' cDest cTargetBb
                                        (.scalar retSc) h_st (Or.inr h_ms_bor) with
                                      ⟨nextSt, h_m1, h_m2⟩
                                    rw [h_m1] at h_st
                                    rw [h_m2] at h_step_body
                                    dsimp only [MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                                    exact liftTau (st_un := .running nextSt) h_step_body h_st
                                      (fun _ _ h => by cases h)
              | return_ =>
                have h_cs_bs : (Memory.pushBaseStack calleeBody baseStack ms.memory).callStack =
                    ms.memory.callStack ++ narrowCallStackForTailCallee baseStack ms.memory.rootUnwindCeiling := rfl
                simp only [evalTerminator, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                  Memory.pushBaseStack_activeProtectors, h_cs_bs, h_ms_bor,
                  hasFrameDeallocProtectorConflict_nil, disableFrameBorrows] at h_st h_step_body
                cases h_g : get? ms.frame.locals 0 with
                | none => rw [h_g] at h_st; exact False.elim h_st
                | some slot =>
                  rw [h_g] at h_st h_step_body
                  cases slot with
                  | uninit => exact False.elim h_st
                  | dead => exact False.elim h_st
                  | init retVal =>
                    dsimp only at h_st h_step_body
                    cases h_stk : ms.memory.callStack with
                    | cons innerCaller innerRest =>
                      rw [h_stk] at h_st h_step_body
                      dsimp only [List.cons_append] at h_st h_step_body
                      cases h_div : innerCaller.isDiverging with
                      | true => rw [h_div] at h_st; exact False.elim h_st
                      | false =>
                        rw [h_div] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_vu : valueContainsUninit retVal with
                        | true => rw [h_vu] at h_st; exact False.elim h_st
                        | false =>
                          rw [h_vu] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          let cMem : Memory := {
                            ms.memory with
                            borrows := []
                            callStack := innerRest
                            activeCallee := some innerCaller.callerBody
                            activeProtectors := restoreCallerProtectors innerCaller
                          }
                          have h_cm_push :
                              { Memory.pushBaseStack calleeBody baseStack ms.memory with
                                borrows := []
                                callStack := innerRest ++ narrowCallStackForTailCallee baseStack ms.memory.rootUnwindCeiling
                                activeCallee := some innerCaller.callerBody
                                activeProtectors := restoreCallerProtectors innerCaller } =
                              Memory.pushBaseStack calleeBody baseStack cMem := by
                            rcases ms with ⟨_, ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _⟩⟩
                            dsimp only [baseStack, cMem, Memory.pushBaseStack]
                            rfl
                          rw [h_cm_push, writeReturnDestination_borrows_nil_pushBaseStack
                            calleeBody baseStack innerCaller.frame.locals cMem
                            innerCaller.destination retVal innerCaller.callerBody.localDecls
                            innerCaller.callerBody.layouts rfl] at h_step_body
                          cases h_wr : writeReturnDestination innerCaller.frame.locals cMem
                              innerCaller.destination retVal innerCaller.callerBody.localDecls
                              innerCaller.callerBody.layouts with
                          | ub => rw [h_wr] at h_st; exact False.elim h_st
                          | unsupported => rw [h_wr] at h_st; exact False.elim h_st
                          | ok updLocals mem' =>
                            rw [h_wr] at h_st h_step_body
                            dsimp only [FrameWriteResult.pushBaseStack, MirStepNode.step,
                              evalNodeNoCallWP] at h_st h_step_body
                            exact liftTau
                              (st_un := .running {
                                frame := {
                                  innerCaller.frame with
                                  blockIdx := innerCaller.returnTarget
                                  stmtIdx := 0
                                  locals := updLocals }
                                memory := mem' })
                              h_step_body h_st (fun _ _ h => by cases h)
                    | nil =>
                      rw [h_stk] at h_st h_step_body
                      cases h_vu : valueContainsUninit retVal with
                      | true => rw [h_vu] at h_st; exact False.elim h_st
                      | false =>
                        rw [h_vu] at h_st h_step_body
                        dsimp only [List.nil_append, MirStepNode.retNormal,
                          evalNodeNoCallWP, mirNormalPost, baseStack] at h_st h_step_body
                        have h_p : P retVal ms.memory :=
                          Eq.mp (by
                            rcases ms with ⟨_, ⟨_, _, bor, _, _, _, cs, _, _, _, _, _, _, _⟩⟩
                            dsimp only at h_ms_bor h_stk ⊢; subst h_ms_bor h_stk; rfl) h_st
                        rcases h_cont retVal ms.memory h_p with ⟨updLocals, memResumed, h_wr, h_mid⟩
                        refine mkStep (f_sub := 0) ?_
                        dsimp only [MirExecState.pushBaseStack, stepMirState]
                        rw [h_step_body]
                        have h_wr' :
                            writeReturnDestination
                              { s.frame with locals := locals' }.locals
                              { nextAllocId := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).nextAllocId
                                globals := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).globals
                                borrows := []
                                nextTag := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).nextTag
                                callees := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).callees
                                traitImpls := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).traitImpls
                                callStack := s.memory.callStack
                                activeCallee := some callerBody
                                activeProtectors := []
                                nextProtector := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).nextProtector
                                callerLocals := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).callerLocals
                                fnPtrs := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).fnPtrs
                                exposedAllocIds := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).exposedAllocIds
                                rootUnwindCeiling := (Memory.pushBaseStack calleeBody (savedCaller :: s.memory.callStack) ms.memory).rootUnwindCeiling }
                              destination retVal callerBody.localDecls callerBody.layouts =
                            .ok updLocals memResumed :=
                          Eq.mp (by
                            rcases ms with ⟨_, ⟨_, _, bor, _, _, _, _, ac, _, _, _, _, _, _⟩⟩
                            dsimp only [Memory.pushBaseStack] at h_ms_bor h_ceil ⊢
                            rw [h_ceil]; subst h_ms_bor; cases ac <;> rfl) h_wr
                        dsimp only [savedCaller] at h_wr'
                        rw [h_prot_nil] at h_wr'
                        cases ms.memory.rootUnwindCeiling <;>
                          (dsimp only [narrowCallStackForTailCallee, savedCaller, restoreCallerProtectors]
                           rw [h_prot_nil]
                           rw [h_wr']
                           dsimp only [MirStepNode.step, evalNodeNoCallWP, wpMirExecStepsSym]
                           exact h_mid)
              | inlineAsm =>
                dsimp only [evalTerminator, evalNodeNoCallWP] at h_st
                exact False.elim h_st
            · simp only [h_len] at h_st
              exact False.elim h_st

/-! ## 8. Callee-Aware Pure Execution (`PureMirConvergesWithCallees`) & 1-Step Compositional `call_summary` -/

/--
Default upper bound on transitive inline call-stack depth (`32` frames) for
bounded syntactic callee checking (`checkPureMirWithCallees`) and compositional
call-depth guards (`callDepth < maxCallDepth`).
-/
abbrev defaultMaxCallDepth : Nat := 32

/--
Canonical pure callee-resolution memory seeding `Memory.callees := callees` and
`Memory.traitImpls := traitImpls` over `emptyMemory` (with empty heap, borrow
table, call stack, and protector list).
-/
def pureCalleeMemory
    (callees : List CapturedMir)
    (traitImpls : List TraitImplEntry := []) : Memory :=
  { emptyMemory with callees := callees, traitImpls := traitImpls }

@[simp]
theorem pureCalleeMemory_nil_nil : pureCalleeMemory [] [] = emptyMemory := rfl

@[simp]
theorem pureCalleeMemory_callees
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).callees = callees := rfl

@[simp]
theorem pureCalleeMemory_traitImpls
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).traitImpls = traitImpls := rfl

@[simp]
theorem pureCalleeMemory_borrows
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).borrows = [] := rfl

@[simp]
theorem pureCalleeMemory_globals
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).globals = [] := rfl

@[simp]
theorem pureCalleeMemory_callStack
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).callStack = [] := rfl

@[simp]
theorem pureCalleeMemory_activeCallee
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).activeCallee = none := rfl

@[simp]
theorem pureCalleeMemory_activeProtectors
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).activeProtectors = [] := rfl

@[simp]
theorem pureCalleeMemory_callerLocals
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).callerLocals = [] := rfl

@[simp]
theorem pureCalleeMemory_fnPtrs
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    (pureCalleeMemory callees traitImpls).fnPtrs = [] := rfl

@[simp]
theorem rootActiveMemory_pureCalleeMemory
    (callees : List CapturedMir) (traitImpls : List TraitImplEntry) :
    RootActiveMemory (pureCalleeMemory callees traitImpls) :=
  ⟨rfl, rfl, rfl, rfl, rfl⟩

/--
Every `MirCallE` interaction emitted by `stepMirFn` maps `MirCallAns.aborted`
to `.halted .abort` (`resumeExternalCall`, `resumeExternalDivergingCall`, and
`resumeExternalTailCall`).
-/
theorem evalStmt_not_extCall
    (s : MachineState) (stmt : Statement)
    (decls : List LocalDecl) (layouts : LayoutTable)
    (c : MirCallE.I) (k : MirCallE.O c → MirExecState) :
    evalStmt s stmt decls layouts ≠ .vis (.inr (.inr c)) k := by
  intro h_ev
  rcases evalStmt_isStmtNode s stmt decls layouts with
    ⟨_, h_sh⟩ | ⟨_, h_sh⟩ | h_sh <;> rw [h_sh] at h_ev <;> cases h_ev

def extCallAbortsProp : MirStepNode → Prop
  | .vis (.inr (.inr _)) k => k .aborted = .halted .abort
  | _ => True

theorem extCallAbortsProp_step (s : MachineState) :
    extCallAbortsProp (MirStepNode.step s) := trivial

theorem extCallAbortsProp_fail (fk : FailureKind) :
    extCallAbortsProp (MirStepNode.fail fk) := trivial

theorem extCallAbortsProp_unsupported :
    extCallAbortsProp MirStepNode.unsupported := trivial

theorem extCallAbortsProp_emitStep (obs : MirObs) (s : MachineState) :
    extCallAbortsProp (MirStepNode.emitStep obs s) := by
  cases obs <;> trivial

theorem extCallAbortsProp_retNormal (v : Value) (m : Memory) :
    extCallAbortsProp (MirStepNode.retNormal v m) := trivial

theorem extCallAbortsProp_retOutcome (out : MirOutcome) :
    extCallAbortsProp (MirStepNode.retOutcome out) := trivial

theorem extCallAbortsProp_extCall_resume
    (req : MirCallReq) (s : MachineState) (l : List LocalSlot)
    (d : Place) (t : BasicBlockIdx) (u : UnwindAction) :
    extCallAbortsProp (MirStepNode.extCall req (resumeExternalCall s l d t u)) := rfl

theorem extCallAbortsProp_extCall_diverging
    (req : MirCallReq) (s : MachineState) (l : List LocalSlot) (u : UnwindAction) :
    extCallAbortsProp (MirStepNode.extCall req (resumeExternalDivergingCall s l u)) := rfl

theorem extCallAbortsProp_extCall_tail
    (req : MirCallReq) (rootCeiling : Bool) (extUnwind : Option Bool) :
    extCallAbortsProp
      (MirStepNode.extCall req (resumeExternalTailCallWithAbi rootCeiling extUnwind)) := rfl

theorem evalStmt_extCall_aborts_prop
    (s : MachineState) (stmt : Statement)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    extCallAbortsProp (evalStmt s stmt localDecls layouts) := by
  cases h_ev : evalStmt s stmt localDecls layouts with
  | ret _ => trivial
  | tau _ => trivial
  | vis i k =>
    rcases i with _ | (_ | c)
    · trivial
    · trivial
    · exact False.elim (evalStmt_not_extCall s stmt localDecls layouts c k h_ev)

theorem extCallAbortsProp_writeIntrinsicReturn
    (s : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (retVal : Value) :
    extCallAbortsProp
      (writeIntrinsicReturn s locals' destination targetBb retVal) := by
  unfold writeIntrinsicReturn
  repeat' (first | trivial | split)

theorem extCallAbortsProp_writeIntrinsicScalarResult
    (s : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (res : Option ScalarInt) :
    extCallAbortsProp
      (writeIntrinsicScalarResult s locals' destination targetBb res) := by
  cases res with
  | none => trivial
  | some sc =>
    exact extCallAbortsProp_writeIntrinsicReturn s locals' destination targetBb (.scalar sc)

theorem extCallAbortsProp_evalNonSelectIntrinsicCall
    (kind : RustIntrinsicKind) (s : MachineState)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) :
    extCallAbortsProp
      (evalNonSelectIntrinsicCall kind s target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb) := by
  rcases evalNonSelectIntrinsicCall_cases kind target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb with ⟨retVal, h_wr⟩ | ⟨fk, h_fl⟩ | h_un
  · rw [h_wr s]; exact extCallAbortsProp_writeIntrinsicReturn s locals' destination targetBb retVal
  · rw [h_fl s]; trivial
  · rw [h_un s]; trivial

theorem extCallAbortsProp_finishMemIntrinsicCall (s : MachineState) (node : MirStepNode)
    (destination : Place) (targetBb : BasicBlockIdx) (h_node : IsStmtNode node) :
    extCallAbortsProp (finishMemIntrinsicCall s node destination targetBb) := by
  rcases h_node with ⟨s', rfl⟩ | ⟨fk, rfl⟩ | rfl
  · rw [finishMemIntrinsicCall_step]
    exact extCallAbortsProp_writeIntrinsicReturn _ _ _ _ _
  · trivial
  · trivial

theorem extCallAbortsProp_evalCopyNonOverlappingCall
    (s : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) :
    extCallAbortsProp
      (evalCopyNonOverlappingCall s bodyLocalDecls bodyLayouts argOps argVals locals'
        destination targetBb) := by
  unfold evalCopyNonOverlappingCall
  rcases argOps with _ | ⟨srcOp, _ | ⟨dstOp, _ | ⟨_cntOp, _ | _⟩⟩⟩ <;>
    rcases argVals with
      _ | ⟨srcVal, _ | ⟨dstVal, _ | ⟨_ | countSc | _ | _ | _, _ | _⟩⟩⟩ <;>
    try trivial
  · dsimp only
    cases Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts) with
    | false => trivial
    | true =>
      exact extCallAbortsProp_finishMemIntrinsicCall _ _ _ _
        (evalCopyNonOverlappingWithCount_isStmtNode _ _ _ _ _ _ _ _ _)

theorem extCallAbortsProp_evalWriteBytesCall
    (s : MachineState) (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand) (argVals : List Value)
    (locals' : List LocalSlot) (destination : Place) (targetBb : BasicBlockIdx) :
    extCallAbortsProp
      (evalWriteBytesCall s target bodyLocalDecls bodyLayouts argOps argVals locals'
        destination targetBb) := by
  unfold evalWriteBytesCall
  cases writeBytesAction s.memory.borrows (length s.memory.callStack) target bodyLocalDecls
      bodyLayouts argOps argVals with
  | fault _ => trivial
  | noWrite => exact extCallAbortsProp_writeIntrinsicReturn _ _ _ _ _
  | store _ _ _ _ =>
    exact extCallAbortsProp_finishMemIntrinsicCall _ _ _ _
      (commitWriteBytesDstPlaceWrite_isStmtNode _ _ _ _ _ _ _)

private theorem extCallAbortsProp_of_isStmtNode {n : MirStepNode} (h : IsStmtNode n) :
    extCallAbortsProp n := by
  rcases h with ⟨_, rfl⟩ | ⟨_, rfl⟩ | rfl <;> trivial

theorem extCallAbortsProp_evalDirectRustIntrinsic?
    (s : MachineState) (currentBody : Option CapturedMir)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (unwind : UnwindAction)
    (stepNode : MirStepNode)
    (h_di :
      evalDirectRustIntrinsic? s currentBody target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb unwind = some stepNode) :
    extCallAbortsProp stepNode := by
  cases h_cl : classifyRustIntrinsic? target.defPath with
  | none =>
    unfold evalDirectRustIntrinsic? at h_di
    rw [h_cl] at h_di
    cases h_di
  | some rk =>
    by_cases h_cs : rk = .constEvalSelect
    · subst h_cs
      rcases argVals with _ | ⟨tupleArgVal, _ | ⟨ctFnVal, _ | ⟨rtFnVal, _ | _⟩⟩⟩
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; trivial
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; trivial
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; trivial
      · rw [evalDirectRustIntrinsic?_constEvalSelect_three _ _ _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        unfold evalConstEvalSelectThree
        dsimp only
        cases unpackConstEvalSelectArgs? tupleArgVal (selectTupleTyOpt target.typeArgs) with
        | none => trivial
        | some unpackedArgs =>
          dsimp only
          cases resolveConstEvalSelectTarget? s target bodyLocalDecls bodyLayouts
              (selectRtFnOpOpt argOps) rtFnVal (length unpackedArgs) with
          | none => trivial
          | some rtTarget =>
            dsimp only
            cases lookupCallee s.memory.callees bodyLayouts rtTarget.defPath
                rtTarget.typeArgs s.memory.traitImpls with
            | some calleeBody =>
              dsimp only
              cases constEvalSelectCalleeCompatible rtTarget calleeBody (length unpackedArgs) with
              | false => trivial
              | true => dsimp only; cases currentBody <;> trivial
            | none =>
              dsimp only
              cases rtTarget.isIndirect with
              | true =>
                cases isGenericClosureArityMismatch s.memory.callees rtTarget.defPath rtTarget.typeArgs with
                | true => trivial
                | false => exact extCallAbortsProp_extCall_resume _ _ _ _ _ _
              | false =>
                dsimp only
                cases isDirectExactDivTarget rtTarget with
                | true =>
                  dsimp only
                  rcases unpackedArgs with _ | ⟨_ | lhs | _ | _ | _, _ | ⟨_ | rhs | _ | _ | _, _ | _⟩⟩ <;>
                    try trivial
                  dsimp only
                  cases resolveIntrinsicIsSigned
                      (withConstEvalSelectIntrinsicTypeArgs rtTarget
                        (selectTupleTyOpt target.typeArgs) false)
                      bodyLocalDecls bodyLayouts
                      (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs)) with
                  | none => trivial
                  | some isSigned =>
                    exact extCallAbortsProp_writeIntrinsicScalarResult s locals'
                      destination targetBb (evalExactDiv lhs rhs isSigned)
                | false =>
                  dsimp only
                  cases classifyRustIntrinsic? rtTarget.defPath with
                  | some rtKind =>
                    have h_step : ∀ (k : RustIntrinsicKind),
                        extCallAbortsProp
                          (match evalCoreMemPtrIntrinsicCall? k s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall k s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) := by
                      intro k
                      cases h_cm : evalCoreMemPtrIntrinsicCall? k s _ bodyLocalDecls bodyLayouts
                          _ unpackedArgs locals' destination (.some targetBb) with
                      | some sn =>
                        exact extCallAbortsProp_of_isStmtNode
                          (evalCoreMemPtrIntrinsicCall?_isStmtNode k s _ bodyLocalDecls bodyLayouts
                            _ unpackedArgs locals' destination (.some targetBb) h_cm)
                      | none =>
                        exact extCallAbortsProp_evalNonSelectIntrinsicCall k s _ bodyLocalDecls bodyLayouts
                          _ unpackedArgs locals' destination targetBb
                    cases h_cs2 : (match rtKind with | .constEvalSelect => true | _ => false) with
                    | true =>
                      have : rtKind = .constEvalSelect := by cases rtKind <;> first | rfl | cases h_cs2
                      subst this; trivial
                    | false =>
                      have h_eq :
                          (match some rtKind with
                           | some .constEvalSelect => MirStepNode.fail .ub
                           | some k =>
                             match evalCoreMemPtrIntrinsicCall? k s
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 bodyLocalDecls bodyLayouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination (.some targetBb) with
                             | some sn => sn
                             | none => evalNonSelectIntrinsicCall k s
                                 (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                   (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind k))
                                 bodyLocalDecls bodyLayouts
                                 (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                                 unpackedArgs locals' destination targetBb
                           | none =>
                             match isUnreachableCallTarget rtTarget.defPath with
                             | true => MirStepNode.fail .ub
                             | false =>
                               match isAbortingPanicDefPath rtTarget.defPath with
                               | true => MirStepNode.retOutcome .abort
                               | false =>
                                 match isUnwindingPanicDefPath rtTarget.defPath with
                                 | true =>
                                   match applyUnwindAction s locals' s.memory unwind with
                                   | .running nextState => MirStepNode.step nextState
                                   | .halted out => MirStepNode.retOutcome out
                                   | .faulted fk => MirStepNode.fail fk
                                 | false =>
                                   MirStepNode.extCall
                                     { defPath := rtTarget.defPath, typeArgs := rtTarget.typeArgs,
                                       args := unpackedArgs, memory := s.memory }
                                     (resumeExternalCall s locals' destination targetBb unwind)) =
                          (match evalCoreMemPtrIntrinsicCall? rtKind s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination (.some targetBb) with
                           | some sn => sn
                           | none => evalNonSelectIntrinsicCall rtKind s
                              (withConstEvalSelectIntrinsicTypeArgs rtTarget
                                (selectTupleTyOpt target.typeArgs) (isPtrPointeeIntrinsicKind rtKind))
                              bodyLocalDecls bodyLayouts
                              (constEvalSelectTupleArgOps (selectTupleTyOpt target.typeArgs))
                              unpackedArgs locals' destination targetBb) := by
                        cases rtKind <;> first | (cases h_cs2; done) | rfl
                      rw [h_eq]
                      exact h_step rtKind
                  | none =>
                    dsimp only
                    cases isUnreachableCallTarget rtTarget.defPath with
                    | true => trivial
                    | false =>
                      dsimp only
                      cases isAbortingPanicDefPath rtTarget.defPath with
                      | true => trivial
                      | false =>
                        dsimp only
                        cases isUnwindingPanicDefPath rtTarget.defPath with
                        | true =>
                          dsimp only
                          cases applyUnwindAction s locals' s.memory unwind <;> trivial
                        | false => exact extCallAbortsProp_extCall_resume _ _ _ _ _ _
      · unfold evalDirectRustIntrinsic? at h_di; rw [h_cl] at h_di
        injection h_di with h_sn; subst h_sn; trivial
    · by_cases h_cn : rk = .copyNonOverlapping
      · subst h_cn
        rw [evalDirectRustIntrinsic?_copyNonOverlapping _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        exact extCallAbortsProp_evalCopyNonOverlappingCall s bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb
      by_cases h_wb : rk = .writeBytes
      · subst h_wb
        rw [evalDirectRustIntrinsic?_writeBytes _ _ _ _ _ _ _ _ _ _ _ h_cl] at h_di
        injection h_di with h_sn
        subst h_sn
        exact extCallAbortsProp_evalWriteBytesCall s target bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb
      cases h_cmk : isCoreMemPtrIntrinsicKind rk with
      | true =>
        rcases evalDirectRustIntrinsic?_coreMemPtr s currentBody target bodyLocalDecls
            bodyLayouts argOps argVals locals' destination targetBb unwind h_cl h_cmk with
          ⟨sn0, h_cm0, h_eq0⟩
        rw [h_eq0] at h_di
        injection h_di with h_sn; subst h_sn
        exact extCallAbortsProp_of_isStmtNode
          (evalCoreMemPtrIntrinsicCall?_isStmtNode rk s target bodyLocalDecls bodyLayouts
            argOps argVals locals' destination (.some targetBb) h_cm0)
      | false =>
        rw [evalDirectRustIntrinsic?_nonSelect _ _ _ _ _ _ _ _ _ _ _ h_cl h_cs h_cn h_wb h_cmk] at h_di
        injection h_di with h_sn
        subst h_sn
        exact extCallAbortsProp_evalNonSelectIntrinsicCall rk s target
          bodyLocalDecls bodyLayouts argOps argVals locals' destination targetBb

theorem stepMirFn_extCall_aborts_prop
    (body : CapturedMir) (s : MachineState) :
    extCallAbortsProp (stepMirFn body s) := by
  rw [stepMirFn_eq_ite]
  dsimp only
  cases isOtherPhase (s.memory.activeCallee.getD body).phase with
  | true =>
    simp only [ite_true]
    trivial
  | false =>
    simp only [Bool.false_eq_true, ite_false]
    cases get? (s.memory.activeCallee.getD body).basicBlocks s.frame.blockIdx with
    | none => trivial
    | some bb =>
      dsimp only
      cases get? bb.statements s.frame.stmtIdx with
      | some stmt =>
        exact evalStmt_extCall_aborts_prop s stmt
          (s.memory.activeCallee.getD body).localDecls
          (s.memory.activeCallee.getD body).layouts
      | none =>
        dsimp only
        by_cases h_len : (s.frame.stmtIdx == length bb.statements) = true
        · simp only [h_len, ite_true]
          rcases bb with ⟨_, ⟨tkind, _⟩, _⟩
          cases tkind with
          | call func argOps destination targetOpt unwind =>
            cases targetOpt with
            | none =>
              dsimp only [evalTerminator, bodyLocalDeclsOf]
              cases resolveCallTarget s func (length argOps) _ _ with
              | ub => trivial
              | unsupported => trivial
              | ok target localsAfterFunc =>
                dsimp only
                cases evalOperandsWithBodyCast localsAfterFunc argOps _ _ _ _ _ _ with
                | ub => trivial
                | unsupported => trivial
                | ok argVals locals' =>
                  dsimp only
                  cases lookupCallee _ _ _ _ _ with
                  | some calleeBody =>
                    dsimp only
                    cases checkCalleeTargetCompatible target calleeBody (length argVals) <;> trivial
                  | none =>
                    dsimp only
                    cases target.isIndirect with
                    | true =>
                      cases isGenericClosureArityMismatch s.memory.callees target.defPath target.typeArgs with
                      | true => trivial
                      | false => exact extCallAbortsProp_extCall_diverging _ _ _ _
                    | false =>
                      dsimp only
                      cases isUnreachableCallTarget target.defPath with
                      | true => trivial
                      | false =>
                        dsimp only
                        cases isAbortingPanicDefPath target.defPath with
                        | true => trivial
                        | false =>
                          dsimp only
                          cases isUnwindingPanicDefPath target.defPath with
                          | true =>
                            dsimp only
                            cases applyUnwindAction s locals' s.memory unwind <;> trivial
                          | false =>
                            dsimp only
                            rcases evalDivergingRustIntrinsic?_eq_none_or_fault s target _ _ argOps argVals locals' destination with
                              h_di | ⟨fk, h_di⟩ | h_di
                            · rw [h_di]; exact extCallAbortsProp_extCall_diverging _ _ _ _
                            · rw [h_di]; trivial
                            · rw [h_di]; trivial
            | some targetBb =>
              dsimp only [evalTerminator, bodyLocalDeclsOf]
              cases resolveCallTarget s func (length argOps) _ _ with
              | ub => trivial
              | unsupported => trivial
              | ok target localsAfterFunc =>
                dsimp only
                cases evalOperandsWithBodyCast localsAfterFunc argOps _ _ _ _ _ _ with
                | ub => trivial
                | unsupported => trivial
                | ok argVals locals' =>
                  dsimp only
                  cases lookupCallee _ _ _ _ _ with
                  | some calleeBody =>
                    dsimp only
                    cases checkCalleeTargetCompatible target calleeBody (length argVals) <;> trivial
                  | none =>
                    dsimp only
                    cases isDirectExactDivTarget target with
                    | true =>
                      dsimp only
                      rcases argVals with _ | ⟨_ | lhs | _ | _, _ | ⟨_ | rhs | _ | _, _ | _⟩⟩ <;>
                        try trivial
                      dsimp only
                      cases resolveIntrinsicIsSigned target _ _ argOps with
                      | none => trivial
                      | some isSigned =>
                        dsimp only
                        cases evalExactDiv lhs rhs isSigned with
                        | none => trivial
                        | some sc =>
                          exact extCallAbortsProp_writeIntrinsicReturn s locals'
                            destination targetBb (.scalar sc)
                    | false =>
                      dsimp only
                      cases target.isIndirect with
                      | true =>
                        cases isGenericClosureArityMismatch s.memory.callees target.defPath target.typeArgs with
                        | true => trivial
                        | false => exact extCallAbortsProp_extCall_resume _ _ _ _ _ _
                      | false =>
                        dsimp only
                        cases h_di :
                          evalDirectRustIntrinsic? s _ target _ _ argOps argVals
                            locals' destination targetBb unwind with
                        | none => exact extCallAbortsProp_extCall_resume _ _ _ _ _ _
                        | some stepNode =>
                          exact extCallAbortsProp_evalDirectRustIntrinsic? s _ target
                            _ _ argOps argVals locals' destination targetBb unwind
                            stepNode h_di
          | goto _ => exact extCallAbortsProp_step _
          | switchInt discr _ =>
            dsimp only [evalTerminator, bodyLocalDeclsOf]
            cases evalOperandWithBodyCast s.frame.locals discr s.memory.borrows
                s.memory.globals _ s.memory.callerLocals _ _ with
            | ub => trivial
            | unsupported => trivial
            | ok v _ => cases v <;> trivial
          | unwindResume =>
            dsimp only [evalTerminator]
            cases unwindFromCallStack s.memory.callStack s.memory <;> trivial
          | unwindTerminate => trivial
          | return_ =>
            dsimp only [evalTerminator]
            cases get? s.frame.locals 0 with
            | none => trivial
            | some slot =>
              cases slot with
              | dead => trivial
              | uninit => trivial
              | init retVal =>
                dsimp only
                cases hasFrameDeallocProtectorConflict s.memory.borrows
                    s.memory.activeProtectors (length s.memory.callStack)
                    (length s.frame.locals) with
                | true => trivial
                | false =>
                  dsimp only
                  cases s.memory.callStack with
                  | nil =>
                    cases valueContainsUninit retVal <;> trivial
                  | cons caller _ =>
                    dsimp only
                    cases caller.isDiverging with
                    | true => trivial
                    | false =>
                      dsimp only
                      cases valueContainsUninit retVal with
                      | true => trivial
                      | false =>
                        dsimp only
                        cases writeReturnDestination caller.frame.locals _
                          caller.destination retVal caller.callerBody.localDecls
                          caller.callerBody.layouts <;> trivial
          | unreachable => trivial
          | drop place target unw =>
            rcases evalTerminator_drop_isStmtNode s place target unw _ _ with
              ⟨_, h_ev⟩ | ⟨_, h_ev⟩ | h_ev <;> (rw [h_ev]; trivial)
          | tailCall func argOps =>
            dsimp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf]
            cases resolveCallTarget s func (length argOps) _ _ with
            | ub => trivial
            | unsupported => trivial
            | ok target localsAfterFunc =>
              dsimp only
              cases evalOperandsWithBodyCast localsAfterFunc argOps _ _ _ _ _ _ with
              | ub => trivial
              | unsupported => trivial
              | ok argVals _ =>
                dsimp only
                cases hasFrameDeallocProtectorConflict s.memory.borrows
                    s.memory.activeProtectors (length s.memory.callStack)
                    (length s.frame.locals) with
                | true => trivial
                | false =>
                  dsimp only
                  cases lookupCallee _ _ _ _ _ with
                  | some calleeBody =>
                    dsimp only
                    cases checkCalleeTargetCompatible target calleeBody (length argVals) <;> trivial
                  | none =>
                    cases target.isIndirect && isGenericClosureArityMismatch s.memory.callees target.defPath target.typeArgs with
                    | true => trivial
                    | false => exact extCallAbortsProp_extCall_tail _ _ _
          | assert cond expected _ unwind =>
            dsimp only [evalTerminator, bodyLocalDeclsOf]
            cases evalOperandWithBodyCast s.frame.locals cond s.memory.borrows
                s.memory.globals _ s.memory.callerLocals _ _ with
            | ub => trivial
            | unsupported => trivial
            | ok v locals' =>
              cases v with
              | scalar sc =>
                cases expected with
                | false =>
                  dsimp only
                  cases Nat.beq sc.bits 0 with
                  | true => trivial
                  | false =>
                    dsimp only
                    cases applyUnwindAction s locals' s.memory unwind <;> trivial
                | true =>
                  dsimp only
                  cases Nat.beq sc.bits 1 with
                  | true => trivial
                  | false =>
                    dsimp only
                    cases applyUnwindAction s locals' s.memory unwind <;> trivial
              | _ => trivial
          | inlineAsm _ _ _ => trivial
        · simp only [h_len]; trivial

/--
Any panic-and-abort-forbidding `wpMirExecSym` proof (`mirNormalPost P`) implies
call-forbidding `wpMirExecNoCallSym` at the exact same fuel budget, because any
un-inlined `MirCallE` interaction would admit `MirCallAns.aborted` and violate
`mirNormalPost P`.
-/
theorem wpMirExecNoCallSym_of_wpMirExecSym_normal
    {fuel : Nat} {body : CapturedMir} {st : MirExecState}
    {P : Value → Memory → Prop}
    (h : wpMirExecSym fuel body st (mirNormalPost P)) :
    wpMirExecNoCallSym fuel body st (mirNormalPost P) := by
  induction fuel generalizing st with
  | zero => exact False.elim h
  | succ fuel' ih =>
    unfold wpMirExecSym at h
    unfold wpMirExecNoCallSym
    rw [evalSymNodeTree_eq, stepMirExecSymTree_eval] at h
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    cases st with
    | halted out => exact h
    | faulted fk => exact False.elim h
    | running s =>
      dsimp only [stepMirState] at h ⊢
      have h_ext := stepMirFn_extCall_aborts_prop body s
      cases h_step : stepMirFn body s with
      | ret out =>
        rw [h_step] at h
        exact h
      | tau st' =>
        rw [h_step] at h
        exact ih h
      | vis i k =>
        rw [h_step] at h h_ext
        rcases i with f | (e | c)
        · exact False.elim h
        · cases e
          exact ih h
        · rcases c with ⟨req⟩
          have h_ab := h .aborted
          rw [h_ext] at h_ab
          cases fuel' with
          | zero => exact False.elim h_ab
          | succ f'' =>
            unfold wpMirExecSym at h_ab
            rw [evalSymNodeTree_eq, stepMirExecSymTree_eval] at h_ab
            exact False.elim h_ab

/--
Lift any `MirWpConverges` summary with `mirNormalPost P` into
`MirNoCallWpConverges` without requiring syntactic purity of `body`.
-/
theorem mirNoCallWpConverges_of_mirWpConverges_normal
    {body : CapturedMir} {s : MachineState} {P : Value → Memory → Prop}
    (h : MirWpConverges body s (mirNormalPost P)) :
    MirNoCallWpConverges body s (mirNormalPost P) := by
  rcases h with ⟨fuel, h_wp⟩
  exact ⟨fuel, wpMirExecNoCallSym_of_wpMirExecSym_normal h_wp⟩

/-- Sequential composition of `MirStepsConverges` with `MirNoCallWpConverges`. -/
theorem MirNoCallWpConverges.bind
    {body : CapturedMir} {s : MachineState}
    {mid : MachineState → Prop} {post : MirOutcome → Prop}
    (h₁ : MirStepsConverges body s mid post)
    (h₂ : ∀ s', mid s' → MirNoCallWpConverges body s' post) :
    MirNoCallWpConverges body s post := by
  rcases h₁ with ⟨f₁, h_steps⟩
  suffices ∀ st : MirExecState,
      wpMirExecStepsSym f₁ body st
        (fun
          | .running s' => mid s'
          | .halted out => post out
          | .faulted _ => False)
        post →
      ∃ f_tot : Nat, wpMirExecNoCallSym f_tot body st post from
    this (.running s) h_steps
  clear h_steps s
  induction f₁ with
  | zero =>
    intro st h_mid
    cases st with
    | running s' => exact h₂ s' h_mid
    | halted out =>
      refine ⟨1, ?_⟩
      unfold wpMirExecNoCallSym
      rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
      exact h_mid
    | faulted _ => exact False.elim h_mid
  | succ f₁' ih =>
    intro st h_st
    unfold wpMirExecStepsSym at h_st
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval] at h_st
    cases h_step : stepMirState body st with
    | ret out =>
      rw [h_step] at h_st
      refine ⟨1, ?_⟩
      unfold wpMirExecNoCallSym
      rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval, h_step]
      exact h_st
    | tau st' =>
      rw [h_step] at h_st
      rcases ih st' h_st with ⟨f_sub, hf_sub⟩
      refine ⟨f_sub + 1, ?_⟩
      unfold wpMirExecNoCallSym
      rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval, h_step]
      exact hf_sub
    | vis i k =>
      rw [h_step] at h_st
      rcases i with f | (e | c)
      · exact False.elim h_st
      · cases e
        rcases ih (k PUnit.unit) h_st with ⟨f_sub, hf_sub⟩
        refine ⟨f_sub + 1, ?_⟩
        unfold wpMirExecNoCallSym
        rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval, h_step]
        exact hf_sub
      · exact False.elim h_st

/-- Single-step unfolding rule for `MirNoCallWpConverges`. -/
theorem MirNoCallWpConverges.step
    {body : CapturedMir} {s : MachineState} {post : MirOutcome → Prop}
    (h :
      evalNodeNoCallWP
        (fun
          | .running s' => MirNoCallWpConverges body s' post
          | .halted out => post out
          | .faulted _ => False)
        post
        (stepMirFn body s)) :
    MirNoCallWpConverges body s post := by
  have h1 : MirStepsConverges body s
      (fun s' => MirNoCallWpConverges body s' post) post := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    cases h_sf : stepMirFn body s with
    | ret out =>
      rw [h_sf] at h
      exact h
    | tau st' =>
      rw [h_sf] at h
      dsimp only [evalNodeNoCallWP, wpMirExecStepsSym] at h ⊢
      exact h
    | vis i k =>
      rw [h_sf] at h
      rcases i with f | (e | c)
      · exact False.elim h
      · cases e
        dsimp only [evalNodeNoCallWP, wpMirExecStepsSym] at h ⊢
        exact h
      · exact False.elim h
  exact MirNoCallWpConverges.bind h1 (fun _ hw => hw)

theorem wpMirExecNoCallSym_halted_panic_false
    {fuel : Nat} {body : CapturedMir} {P : Value → Memory → Prop}
    (h : wpMirExecNoCallSym fuel body (.halted .panic) (mirNormalPost P)) :
    False := by
  cases fuel with
  | zero => exact h
  | succ f' =>
    unfold wpMirExecNoCallSym at h
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval] at h
    exact h

def fwAcEq (m : Memory) : FrameWriteResult → Prop
  | .ok _ m' => m'.activeCallee = m.activeCallee
  | _ => True

theorem commitForeignFrameLocals_activeCallee
    {m m₂ : Memory} {t : ForeignFrameTarget} {locs : List LocalSlot}
    (h : commitForeignFrameLocals m t locs = some m₂) :
    m₂.activeCallee = m.activeCallee := by
  unfold commitForeignFrameLocals at h
  cases t with
  | callerReferent _ => injection h with h; subst h; rfl
  | savedFrame idx _ =>
    dsimp only at h
    cases h_g : get? m.callStack idx with
    | none => rw [h_g] at h; nomatch h
    | some sf =>
      rw [h_g] at h
      dsimp only at h
      cases h_s : set? m.callStack idx
          { sf with frame := { sf.frame with locals := locs } } with
      | none => rw [h_s] at h; nomatch h
      | some _ => rw [h_s] at h; injection h with h; subst h; rfl

theorem writeReturnDestination_activeCallee
    {cl l' : List LocalSlot} {m m' : Memory} {dst : Place}
    {rv : Value} {ld : List LocalDecl} {ly : LayoutTable}
    (hw : writeReturnDestination cl m dst rv ld ly = .ok l' m') :
    m'.activeCallee = m.activeCallee := by
  suffices fwAcEq m (writeReturnDestination cl m dst rv ld ly) by
    rw [hw] at this; exact this
  have h_ff (rp : List ProjectionElem) :
      fwAcEq m (foreignFrameDerefWrite cl m dst rp rv ld ly) := by
    unfold foreignFrameDerefWrite
    cases get? cl dst.local_ with
    | none => trivial
    | some sl =>
      cases sl with
      | dead => trivial
      | uninit => trivial
      | init rootVal =>
        dsimp only
        cases extractDerefPtrVal? rootVal with
        | none => trivial
        | some ptrVal =>
          dsimp only
          cases lookupBorrow m.borrows ptrVal.tag with
          | none => trivial
          | some entry =>
            dsimp only
            cases activeFrameSlot? cl m.callStack entry.targetFrameDepth entry.targetLocal with
            | some _ => trivial
            | none =>
              dsimp only
              cases foreignFrameTarget? m.callStack m.callerLocals entry.targetFrameDepth entry.targetLocal with
              | none => trivial
              | some target =>
                dsimp only
                split
                · next targetLocals' _ =>
                  split
                  · trivial
                  · cases h_c : commitForeignFrameLocals m target targetLocals' with
                    | none => trivial
                    | some mem₂ =>
                      dsimp only [fwAcEq]
                      exact commitForeignFrameLocals_activeCallee h_c
                · trivial
                · trivial
  rcases dst with ⟨dLoc, dProj⟩
  cases dProj with
  | nil =>
    unfold writeReturnDestination; dsimp only
    cases get? cl dLoc with
    | none => trivial
    | some sl =>
      cases sl with
      | dead => trivial
      | uninit | init _ =>
        dsimp only
        cases hasProtectedWriteConflict m.borrows m.activeProtectors dLoc none [] 0 0 (length m.callStack) with
        | true => trivial
        | false =>
          dsimp only
          cases set? cl dLoc (.init rv) <;> first | exact trivial | exact rfl
  | cons hd tl =>
    by_cases h_nd : hd = .deref
    · subst h_nd
      unfold writeReturnDestination; dsimp only
      cases evalPlaceWrite cl m.borrows ⟨dLoc, .deref :: tl⟩ rv m.activeProtectors ld ly m.callStack with
      | unsupported => trivial
      | ok _ =>
        dsimp only
        cases derefWriteTreeUB cl m.borrows ⟨dLoc, .deref :: tl⟩ ||
            derefWriteUnionProtectorUB ld ly cl m.borrows m.activeProtectors ⟨dLoc, .deref :: tl⟩ tl m.callStack <;>
          first | exact trivial | exact rfl
      | ub => exact h_ff tl
    · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (hd :: tl) with h_s | h_nr
      · cases hd with
        | opaqueCast castTy =>
          unfold writeReturnDestination; rw [h_s]; dsimp only
          split
          · trivial
          · cases get? cl dLoc with
            | none => trivial
            | some sl =>
              cases sl with
              | dead => trivial
              | uninit | init _ =>
                dsimp only
                cases hasProtectedWriteConflict m.borrows m.activeProtectors dLoc none [] 0 0 (length m.callStack) with
                | true => trivial
                | false =>
                  dsimp only
                  cases set? cl dLoc (.init rv) <;> first | exact trivial | exact rfl
        | _ => cases h_s
      · rw [writeReturnDestination_nonDeref cl m dLoc hd tl rv ld ly h_nd h_nr]
        let ld' := eraseLeadingOpaqueCastDecls ld ly dLoc (hd :: tl)
        dsimp only
        cases hasProtectedWriteConflict m.borrows m.activeProtectors dLoc none
            (resolveBorrowWriteLocalProj ld' ly cl dLoc (hd :: tl)) 0 0 (length m.callStack) with
        | true => trivial
        | false =>
          dsimp only
          split
          · trivial
          · rename_i rootVal _
            cases writeProjectedForLocal cl ld' ly dLoc rootVal (hd :: tl) rv with
            | ub | unsupported => trivial
            | ok rootVal' =>
              dsimp only
              cases set? cl dLoc (.init rootVal') <;> first | exact trivial | exact rfl

/--
Lifting `wpMirExecNoCallSym` along `MirExecState.pushBaseStack body []`:
normalizing `activeCallee` from `none` to `some body` at the root frame preserves
execution step-for-step at the identical fuel budget.
-/
theorem wpMirExecNoCallSym_pushBaseStack_nil_outer
    {fuel : Nat} {outerBody body : CapturedMir} {st : MirExecState}
    {P : Value → Memory → Prop}
    (h : wpMirExecNoCallSym fuel body st (mirNormalPost P)) :
    wpMirExecNoCallSym fuel outerBody (MirExecState.pushBaseStack body [] st)
      (mirNormalPost
        (fun retVal mem' =>
          ∃ mem₀, mem' = Memory.pushBaseStack body [] mem₀ ∧ P retVal mem₀)) := by
  induction fuel generalizing st with
  | zero => exact False.elim h
  | succ f' ih =>
    unfold wpMirExecNoCallSym at h ⊢
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval] at h ⊢
    cases st with
    | faulted fk => exact False.elim h
    | halted out =>
      cases out with
      | normal rv => exact ⟨rv.2, rfl, h⟩
      | panic => exact False.elim h
      | abort => exact False.elim h
    | running ms =>
      dsimp only [MirExecState.pushBaseStack, stepMirState] at h ⊢
      have h_act :
          (MachineState.pushBaseStack body [] ms).memory.activeCallee.getD outerBody =
            ms.memory.activeCallee.getD body := rfl
      let curBody := ms.memory.activeCallee.getD body
      rw [stepMirFn_eq_ite] at h
      dsimp only at h
      have h_phase_or :
          (∃ tag, curBody.phase = .other tag) ∨
          (evalNodeNoCallWP
              (fun st' => wpMirExecNoCallSym f' body st' (mirNormalPost P))
              (mirNormalPost P)
              (match get? curBody.basicBlocks ms.frame.blockIdx with
               | none => MirStepNode.fail .ub
               | some bb =>
                 match get? bb.statements ms.frame.stmtIdx with
                 | some stmt =>
                   evalStmt ms stmt curBody.localDecls curBody.layouts
                 | none =>
                   if ms.frame.stmtIdx == length bb.statements then
                     evalTerminator ms bb.terminator (some curBody)
                   else MirStepNode.fail .ub) ∧
           stepMirFn outerBody (MachineState.pushBaseStack body [] ms) =
              match get? curBody.basicBlocks ms.frame.blockIdx with
              | none => MirStepNode.fail .ub
              | some bb =>
                match get? bb.statements ms.frame.stmtIdx with
                | some stmt =>
                  evalStmt (MachineState.pushBaseStack body [] ms)
                    stmt curBody.localDecls curBody.layouts
                | none =>
                  if ms.frame.stmtIdx == length bb.statements then
                    evalTerminator (MachineState.pushBaseStack body [] ms)
                      bb.terminator (some curBody)
                  else MirStepNode.fail .ub) := by
        cases h_ph : isOtherPhase curBody.phase with
        | true => exact Or.inl (isOtherPhase_eq_true_iff h_ph)
        | false =>
          refine Or.inr ⟨?_, ?_⟩
          · rw [h_ph] at h; exact h
          · rw [stepMirFn_eq_ite]
            dsimp only
            rw [h_act, h_ph]
            rfl
      rcases h_phase_or with ⟨tag, h_oth⟩ | ⟨h_st, h_step_body⟩
      · rw [h_oth] at h; exact False.elim h
      · cases h_bb : get? curBody.basicBlocks ms.frame.blockIdx with
        | none =>
          rw [h_bb] at h_st; exact False.elim h_st
        | some bb =>
          rw [h_bb] at h_st h_step_body
          dsimp only at h_st h_step_body
          cases h_stmt : get? bb.statements ms.frame.stmtIdx with
          | some stmt =>
            rw [h_stmt] at h_st h_step_body
            dsimp only at h_st h_step_body
            have h_es :=
              evalStmt_pushBaseStack body ms stmt curBody.localDecls curBody.layouts
            cases h_ev : evalStmt ms stmt curBody.localDecls curBody.layouts with
            | ret out =>
              rcases evalStmt_isStmtNode ms stmt curBody.localDecls curBody.layouts with
                ⟨_, h_sh⟩ | ⟨_, h_sh⟩ | h_sh <;> rw [h_sh] at h_ev <;> cases h_ev
            | tau st1 =>
              rw [h_ev] at h_st h_es
              dsimp only [MirStepNode.pushBaseStack, evalNodeNoCallWP] at h_st h_es
              rw [h_step_body, h_es]
              exact ih h_st
            | vis i k =>
              rw [h_ev] at h_st h_es
              rcases i with f | (e | c)
              · exact False.elim h_st
              · cases e
                dsimp only [MirStepNode.pushBaseStack, evalNodeNoCallWP] at h_st h_es
                rw [h_step_body, h_es]
                exact ih h_st
              · exact False.elim h_st
          | none =>
            rw [h_stmt] at h_st h_step_body
            dsimp only at h_st h_step_body
            by_cases h_len : (ms.frame.stmtIdx == length bb.statements) = true
            · simp only [h_len, ite_true] at h_st h_step_body
              rcases bb with ⟨_, ⟨tkind, tspan⟩, _⟩
              cases tkind with
              | goto target =>
                rw [h_step_body]
                exact ih h_st
              | switchInt discr targets =>
                simp only [evalTerminator, bodyLocalDeclsOf, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                  Memory.pushBaseStack_globals, Memory.pushBaseStack_callerLocals,
                  Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                cases h_op : evalOperandWithBodyCast ms.frame.locals discr ms.memory.borrows
                    ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                | ub => rw [h_op] at h_st; exact False.elim h_st
                | unsupported => rw [h_op] at h_st; exact False.elim h_st
                | ok v locs' =>
                  rw [h_op] at h_st h_step_body
                  cases v with
                  | scalar sc =>
                    rw [h_step_body]
                    exact ih h_st
                  | _ => exact False.elim h_st
              | unwindResume =>
                simp only [evalTerminator, MachineState.pushBaseStack_memory,
                  Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                have h_ne_pan : unwindFromCallStack ms.memory.callStack ms.memory ≠ .halted .panic := by
                  intro h_pan
                  rw [h_pan] at h_st
                  exact h_st
                have h_ne_ub : unwindFromCallStack ms.memory.callStack ms.memory ≠ .faulted .ub := by
                  intro h_ub
                  rw [h_ub] at h_st
                  exact h_st
                have h_uw := unwindFromCallStack_pushBaseStack_of_ne_panic body []
                  ms.memory.callStack ms.memory h_ne_pan h_ne_ub (Or.inl rfl)
                cases h_u : unwindFromCallStack ms.memory.callStack ms.memory with
                | faulted fk => rw [h_u] at h_st; exact False.elim h_st
                | halted out =>
                  rw [h_u] at h_st h_uw
                  cases out with
                  | normal rv => exact False.elim (unwindFromCallStack_ne_normal _ _ _ h_u)
                  | panic => exact False.elim (h_ne_pan h_u)
                  | abort => exact False.elim h_st
                | running ns =>
                  rw [h_u] at h_st h_uw
                  rw [h_step_body, h_uw]
                  exact ih h_st
              | unwindTerminate =>
                exact False.elim h_st
              | unreachable =>
                exact False.elim h_st
              | inlineAsm =>
                exact False.elim h_st
              | drop pl target unw =>
                rw [evalTerminator_drop_pushBaseStack_nil body ms pl target unw tspan (some curBody)] at h_step_body
                rcases evalTerminator_drop_isStmtNode ms pl target unw tspan (some curBody) with
                  ⟨ns, h_ev⟩ | ⟨fk, h_ev⟩ | h_ev
                · rw [h_ev] at h_st h_step_body
                  dsimp only [MirStepNode.pushBaseStack, MirStepNode.step, evalNodeNoCallWP] at h_st h_step_body
                  rw [h_step_body]
                  exact ih h_st
                · rw [h_ev] at h_st; exact False.elim h_st
                · rw [h_ev] at h_st; exact False.elim h_st
              | assert cond exp target unw =>
                simp only [evalTerminator, bodyLocalDeclsOf, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                  Memory.pushBaseStack_globals, Memory.pushBaseStack_callerLocals,
                  Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                cases h_op : evalOperandWithBodyCast ms.frame.locals cond ms.memory.borrows
                    ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                | ub => rw [h_op] at h_st; exact False.elim h_st
                | unsupported => rw [h_op] at h_st; exact False.elim h_st
                | ok v locs' =>
                  rw [h_op] at h_st h_step_body
                  cases v with
                  | scalar sc =>
                    dsimp only at h_st h_step_body
                    have h_ab :
                        ∀ expBit : Nat,
                          evalNodeNoCallWP
                            (fun st' => wpMirExecNoCallSym f' body st' (mirNormalPost P))
                            (mirNormalPost P)
                            (match Nat.beq sc.bits expBit with
                             | true =>
                               MirStepNode.step
                                 { ms with frame := { blockIdx := target, stmtIdx := 0, locals := locs' } }
                             | false =>
                               match applyUnwindAction ms locs' ms.memory unw with
                               | .running ns => MirStepNode.step ns
                               | .halted out => MirStepNode.retOutcome out
                               | .faulted fk => MirStepNode.fail fk) →
                          stepMirFn outerBody (MachineState.pushBaseStack body [] ms) =
                            (match Nat.beq sc.bits expBit with
                             | true =>
                               MirStepNode.step
                                 { frame := { blockIdx := target, stmtIdx := 0, locals := locs' }
                                   memory := Memory.pushBaseStack body [] ms.memory }
                             | false =>
                               match applyUnwindAction (MachineState.pushBaseStack body [] ms) locs'
                                   (Memory.pushBaseStack body [] ms.memory) unw with
                               | .running ns => MirStepNode.step ns
                               | .halted out => MirStepNode.retOutcome out
                               | .faulted fk => MirStepNode.fail fk) →
                          evalNodeNoCallWP
                            (fun st' =>
                              wpMirExecNoCallSym f' outerBody st'
                                (mirNormalPost (fun retVal mem' => ∃ mem₀, mem' = Memory.pushBaseStack body [] mem₀ ∧ P retVal mem₀)))
                            (mirNormalPost (fun retVal mem' => ∃ mem₀, mem' = Memory.pushBaseStack body [] mem₀ ∧ P retVal mem₀))
                            (stepMirFn outerBody (MachineState.pushBaseStack body [] ms)) := by
                      intro expBit h_st_b h_sb_b
                      cases h_eqb : Nat.beq sc.bits expBit with
                      | true =>
                        rw [h_eqb] at h_st_b h_sb_b
                        rw [h_sb_b]
                        exact ih h_st_b
                      | false =>
                        rw [h_eqb] at h_st_b h_sb_b
                        dsimp only at h_st_b h_sb_b
                        have h_ne_pan : applyUnwindAction ms locs' ms.memory unw ≠ .halted .panic := by
                          intro h_pan; rw [h_pan] at h_st_b; exact h_st_b
                        have h_ne_ub : applyUnwindAction ms locs' ms.memory unw ≠ .faulted .ub := by
                          intro h_ub; rw [h_ub] at h_st_b; exact h_st_b
                        have h_au := applyUnwindAction_pushBaseStack_of_ne_panic body [] ms locs' unw h_ne_pan h_ne_ub (Or.inl rfl)
                        cases h_a : applyUnwindAction ms locs' ms.memory unw with
                        | faulted fk => rw [h_a] at h_st_b; exact False.elim h_st_b
                        | halted out =>
                          rw [h_a] at h_st_b h_au
                          cases out with
                          | normal rv => exact False.elim (applyUnwindAction_ne_normal _ _ _ _ _ h_a)
                          | panic => exact False.elim (h_ne_pan h_a)
                          | abort => exact False.elim h_st_b
                        | running ns =>
                          rw [h_a] at h_st_b h_au
                          rw [h_sb_b, h_au]
                          exact ih h_st_b
                    cases exp with
                    | true => exact h_ab 1 h_st h_step_body
                    | false => exact h_ab 0 h_st h_step_body
                  | _ => exact False.elim h_st
              | tailCall func argOps =>
                simp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf,
                  resolveCallTarget_pushBaseStack, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory,
                  Memory.pushBaseStack_borrows, Memory.pushBaseStack_globals,
                  Memory.pushBaseStack_callees, Memory.pushBaseStack_traitImpls,
                  Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_activeProtectors,
                  Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                | ub => rw [h_rt] at h_st; exact False.elim h_st
                | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                | ok target locsF =>
                  rw [h_rt] at h_st h_step_body
                  dsimp only at h_st h_step_body
                  cases h_ops : evalOperandsWithBodyCast locsF argOps ms.memory.borrows ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                  | ub => rw [h_ops] at h_st; exact False.elim h_st
                  | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                  | ok avs _ =>
                    rw [h_ops] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_pc : hasFrameDeallocProtectorConflict ms.memory.borrows ms.memory.activeProtectors
                        (length ms.memory.callStack) (length ms.frame.locals) with
                    | true => rw [h_pc] at h_st; exact False.elim h_st
                    | false =>
                      rw [h_pc] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_lk : lookupCallee ms.memory.callees curBody.layouts target.defPath target.typeArgs ms.memory.traitImpls with
                      | none =>
                        rw [h_lk] at h_st; dsimp only at h_st
                        cases h_gc : target.isIndirect && isGenericClosureArityMismatch ms.memory.callees target.defPath target.typeArgs <;>
                          (rw [h_gc] at h_st; exact False.elim h_st)
                      | some nextCallee =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ok : checkCalleeTargetCompatible target nextCallee (length avs) with
                        | false => rw [h_ok] at h_st; exact False.elim h_st
                        | true =>
                          rw [h_ok] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          rw [h_step_body]
                          dsimp only [MirStepNode.step, evalNodeNoCallWP]
                          exact Eq.mp (by
                            rcases ms with ⟨msFr, ⟨_, _, bor, _, _, _, cs, ac, _, _, cloc, _, _, ruc⟩⟩
                            dsimp only [enterTailCalleeFrame, MachineState.pushBaseStack,
                              MirExecState.pushBaseStack, Memory.pushBaseStack, tailCalleeEntryMemory]
                            cases cs with
                            | cons _ _ => cases ruc <;> cases nextCallee.fnAbi.canUnwind <;> cases ac <;> rfl
                            | nil =>
                              unfold relocateRootCallerReferents
                              have h_len0 : length ([] : List SavedCallerFrame) = 0 := rfl
                              rw [h_len0]
                              dsimp only
                              cases Nat.blt (length msFr.locals) (length (initLocals nextCallee (calleeEntryArgs target nextCallee avs))) <;>
                                (try dsimp only) <;>
                                cases hasAnyRootCallerReferent (disableFrameBorrows bor 0 (length msFr.locals)) (length msFr.locals) <;>
                                (try dsimp only) <;>
                                cases Nat.blt (length msFr.locals) (length cloc) <;>
                                cases ruc <;> cases nextCallee.fnAbi.canUnwind <;> cases ac <;> rfl) (ih h_st)
              | call func argOps cDest cTarget cUnw =>
                cases cTarget with
                | none =>
                  simp only [evalTerminator, bodyLocalDeclsOf,
                    resolveCallTarget_pushBaseStack,
                    MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                    Memory.pushBaseStack_globals, Memory.pushBaseStack_callees,
                    Memory.pushBaseStack_traitImpls,
                    Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                  cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                  | ub => rw [h_rt] at h_st; exact False.elim h_st
                  | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                  | ok target locsF =>
                    rw [h_rt] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_ops : evalOperandsWithBodyCast locsF argOps ms.memory.borrows ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                    | ub => rw [h_ops] at h_st; exact False.elim h_st
                    | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                    | ok avs cLocals' =>
                      rw [h_ops] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_lk : lookupCallee ms.memory.callees curBody.layouts target.defPath target.typeArgs ms.memory.traitImpls with
                      | some nextCallee =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ok : checkCalleeTargetCompatible target nextCallee (length avs) with
                        | false => rw [h_ok] at h_st; exact False.elim h_st
                        | true =>
                          rw [h_ok] at h_st h_step_body
                          rw [h_step_body]
                          have h_eq_dc :
                              pushDivergingCalleeFrame (MachineState.pushBaseStack body [] ms) curBody cLocals' cDest cUnw nextCallee (calleeEntryArgs target nextCallee avs) =
                                MachineState.pushBaseStack body [] (pushDivergingCalleeFrame ms curBody cLocals' cDest cUnw nextCallee (calleeEntryArgs target nextCallee avs)) := by
                            simp [pushDivergingCalleeFrame, MachineState.pushBaseStack, Memory.pushBaseStack]
                          dsimp only
                          rw [h_eq_dc]
                          exact ih h_st
                      | none =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ind : target.isIndirect with
                        | true =>
                          rw [h_ind] at h_st; dsimp only at h_st
                          cases h_gc : isGenericClosureArityMismatch ms.memory.callees target.defPath target.typeArgs <;>
                            (rw [h_gc] at h_st; exact False.elim h_st)
                        | false =>
                          rw [h_ind] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases h_unr : isUnreachableCallTarget target.defPath with
                          | true => rw [h_unr] at h_st; exact False.elim h_st
                          | false =>
                            rw [h_unr] at h_st h_step_body
                            dsimp only at h_st h_step_body
                            cases h_abp : isAbortingPanicDefPath target.defPath with
                            | true => rw [h_abp] at h_st; exact False.elim h_st
                            | false =>
                              rw [h_abp] at h_st h_step_body
                              dsimp only at h_st h_step_body
                              cases h_uwp : isUnwindingPanicDefPath target.defPath with
                              | false =>
                                rw [h_uwp] at h_st; dsimp only at h_st
                                rcases evalDivergingRustIntrinsic?_eq_none_or_fault ms target
                                    curBody.localDecls curBody.layouts argOps avs cLocals' cDest with
                                  h_di | ⟨fk, h_di⟩ | h_di <;> (rw [h_di] at h_st; exact False.elim h_st)
                              | true =>
                                rw [h_uwp] at h_st h_step_body
                                dsimp only at h_st h_step_body
                                have h_ne_pan : applyUnwindAction ms cLocals' ms.memory cUnw ≠ .halted .panic := by
                                  intro h_pan; rw [h_pan] at h_st; exact h_st
                                have h_ne_ub : applyUnwindAction ms cLocals' ms.memory cUnw ≠ .faulted .ub := by
                                  intro h_ub; rw [h_ub] at h_st; exact h_st
                                have h_au := applyUnwindAction_pushBaseStack_of_ne_panic body [] ms cLocals' cUnw h_ne_pan h_ne_ub (Or.inl rfl)
                                cases h_a : applyUnwindAction ms cLocals' ms.memory cUnw with
                                | faulted fk => rw [h_a] at h_st; exact False.elim h_st
                                | halted out =>
                                  rw [h_a] at h_st h_au
                                  cases out with
                                  | normal rv => exact False.elim (applyUnwindAction_ne_normal _ _ _ _ _ h_a)
                                  | panic => exact False.elim (h_ne_pan h_a)
                                  | abort => exact False.elim h_st
                                | running ns =>
                                  rw [h_a] at h_st h_au
                                  rw [h_step_body, h_au]
                                  exact ih h_st
                | some cTargetBb =>
                  simp only [evalTerminator, bodyLocalDeclsOf,
                    resolveCallTarget_pushBaseStack,
                    MachineState.pushBaseStack_memory, Memory.pushBaseStack_borrows,
                    Memory.pushBaseStack_globals, Memory.pushBaseStack_callees,
                    Memory.pushBaseStack_traitImpls,
                    Memory.pushBaseStack_callerLocals, Memory.pushBaseStack_nil_callStack] at h_st h_step_body
                  cases h_rt : resolveCallTarget ms func (length argOps) curBody.localDecls curBody.layouts with
                  | ub => rw [h_rt] at h_st; exact False.elim h_st
                  | unsupported => rw [h_rt] at h_st; exact False.elim h_st
                  | ok target locsF =>
                    rw [h_rt] at h_st h_step_body
                    dsimp only at h_st h_step_body
                    cases h_ops : evalOperandsWithBodyCast locsF argOps ms.memory.borrows ms.memory.globals curBody.layouts ms.memory.callerLocals curBody.localDecls ms.memory.callStack with
                    | ub => rw [h_ops] at h_st; exact False.elim h_st
                    | unsupported => rw [h_ops] at h_st; exact False.elim h_st
                    | ok avs cLocals' =>
                      rw [h_ops] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_lk : lookupCallee ms.memory.callees curBody.layouts target.defPath target.typeArgs ms.memory.traitImpls with
                      | some nextCallee =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ok : checkCalleeTargetCompatible target nextCallee (length avs) with
                        | false => rw [h_ok] at h_st; exact False.elim h_st
                        | true =>
                          rw [h_ok] at h_st h_step_body
                          rw [h_step_body]
                          have h_eq_pc :
                              pushCalleeFrame (MachineState.pushBaseStack body [] ms) curBody cLocals' cDest cTargetBb nextCallee (calleeEntryArgs target nextCallee avs) cUnw =
                                MachineState.pushBaseStack body [] (pushCalleeFrame ms curBody cLocals' cDest cTargetBb nextCallee (calleeEntryArgs target nextCallee avs) cUnw) := by
                            simp [pushCalleeFrame, MachineState.pushBaseStack, Memory.pushBaseStack]
                          dsimp only
                          rw [h_eq_pc]
                          exact ih h_st
                      | none =>
                        rw [h_lk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_ed : isDirectExactDivTarget target with
                        | false =>
                          rw [h_ed] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases h_ind : target.isIndirect with
                          | true =>
                            rw [h_ind] at h_st; dsimp only at h_st
                            cases h_gc : isGenericClosureArityMismatch ms.memory.callees target.defPath target.typeArgs <;>
                              (rw [h_gc] at h_st; exact False.elim h_st)
                          | false =>
                            rw [h_ind] at h_st h_step_body
                            dsimp only at h_st h_step_body
                            cases h_di :
                              evalDirectRustIntrinsic? ms (some curBody) target
                                curBody.localDecls curBody.layouts argOps avs
                                cLocals' cDest cTargetBb cUnw with
                            | none => rw [h_di] at h_st; exact False.elim h_st
                            | some stepNode =>
                              rw [h_di] at h_st
                              dsimp only at h_st
                              rcases evalDirectRustIntrinsic?_pushBaseStack_of_noCallWP
                                  body [] ms curBody target argOps avs cLocals'
                                  cDest cTargetBb cUnw stepNode h_di h_st (Or.inl rfl) with
                                ⟨nextSt, rfl, h_m2⟩
                              rw [h_m2] at h_step_body
                              rw [h_step_body]
                              exact ih h_st
                        | true =>
                          rw [h_ed] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases avs with
                          | nil => exact False.elim h_st
                          | cons v1 tl1 =>
                            cases v1 <;> try exact False.elim h_st
                            cases tl1 with
                            | nil => exact False.elim h_st
                            | cons v2 tl2 =>
                              cases v2 <;> try exact False.elim h_st
                              cases tl2 with
                              | cons _ _ => exact False.elim h_st
                              | nil =>
                                rename_i lhsSc rhsSc
                                dsimp only at h_st h_step_body
                                cases h_sig :
                                  resolveIntrinsicIsSigned target curBody.localDecls
                                    curBody.layouts argOps with
                                | none => rw [h_sig] at h_st; exact False.elim h_st
                                | some isSigned =>
                                  rw [h_sig] at h_st h_step_body
                                  dsimp only at h_st h_step_body
                                  cases h_div : evalExactDiv lhsSc rhsSc isSigned with
                                  | none => rw [h_div] at h_st; exact False.elim h_st
                                  | some retSc =>
                                    rw [h_div] at h_st h_step_body
                                    dsimp only at h_st h_step_body
                                    rcases writeIntrinsicReturn_pushBaseStack_of_noCallWP
                                        body [] ms cLocals' cDest cTargetBb
                                        (.scalar retSc) h_st (Or.inl rfl) with
                                      ⟨nextSt, h_m1, h_m2⟩
                                    rw [h_m1] at h_st
                                    rw [h_m2] at h_step_body
                                    rw [h_step_body]
                                    exact ih h_st
              | return_ =>
                simp only [evalTerminator, MachineState.pushBaseStack_frame,
                  MachineState.pushBaseStack_memory, Memory.pushBaseStack_nil_callStack,
                  Memory.pushBaseStack_borrows, Memory.pushBaseStack_activeProtectors] at h_st h_step_body
                cases h_g : get? ms.frame.locals 0 with
                | none => rw [h_g] at h_st; exact False.elim h_st
                | some slot =>
                  rw [h_g] at h_st h_step_body
                  cases slot with
                  | uninit => exact False.elim h_st
                  | dead => exact False.elim h_st
                  | init retVal =>
                    dsimp only at h_st h_step_body
                    cases h_pc : hasFrameDeallocProtectorConflict ms.memory.borrows ms.memory.activeProtectors
                        (length ms.memory.callStack) (length ms.frame.locals) with
                    | true => rw [h_pc] at h_st; exact False.elim h_st
                    | false =>
                      rw [h_pc] at h_st h_step_body
                      dsimp only at h_st h_step_body
                      cases h_stk : ms.memory.callStack with
                      | cons innerCaller innerRest =>
                        rw [h_stk] at h_st h_step_body
                        dsimp only at h_st h_step_body
                        cases h_div : innerCaller.isDiverging with
                        | true => rw [h_div] at h_st; exact False.elim h_st
                        | false =>
                          rw [h_div] at h_st h_step_body
                          dsimp only at h_st h_step_body
                          cases h_vu : valueContainsUninit retVal with
                          | true => rw [h_vu] at h_st; exact False.elim h_st
                          | false =>
                            rw [h_vu] at h_st h_step_body
                            dsimp only at h_st h_step_body
                            let cMem : Memory := {
                              ms.memory with
                              borrows := disableFrameBorrows ms.memory.borrows (length (innerCaller :: innerRest)) (length ms.frame.locals)
                              callStack := innerRest
                              activeCallee := some innerCaller.callerBody
                              activeProtectors := restoreCallerProtectors innerCaller
                            }
                            have h_cm_eq :
                                { Memory.pushBaseStack body [] ms.memory with
                                  borrows := disableFrameBorrows ms.memory.borrows (length (innerCaller :: innerRest)) (length ms.frame.locals)
                                  callStack := innerRest
                                  activeCallee := some innerCaller.callerBody
                                  activeProtectors := restoreCallerProtectors innerCaller } = cMem := by
                              rcases ms with ⟨_, ⟨_, _, _, _, _, _, _, _, _, _, _, _, _⟩⟩
                              dsimp only [cMem, Memory.pushBaseStack]
                            rw [h_cm_eq] at h_step_body
                            cases h_wr : writeReturnDestination innerCaller.frame.locals cMem
                                innerCaller.destination retVal innerCaller.callerBody.localDecls
                                innerCaller.callerBody.layouts with
                            | ub => rw [h_wr] at h_st; exact False.elim h_st
                            | unsupported => rw [h_wr] at h_st; exact False.elim h_st
                            | ok updLocals mem' =>
                              rw [h_wr] at h_st h_step_body
                              have h_ac_mem' : mem'.activeCallee = some innerCaller.callerBody :=
                                writeReturnDestination_activeCallee h_wr
                              have h_push_id :
                                  MirExecState.pushBaseStack body []
                                    (.running {
                                      frame := {
                                        innerCaller.frame with
                                        blockIdx := innerCaller.returnTarget
                                        stmtIdx := 0
                                        locals := updLocals }
                                      memory := mem' }) =
                                  .running {
                                    frame := {
                                      innerCaller.frame with
                                      blockIdx := innerCaller.returnTarget
                                      stmtIdx := 0
                                      locals := updLocals }
                                    memory := mem' } := by
                                cases mem'; dsimp only [MirExecState.pushBaseStack, MachineState.pushBaseStack, Memory.pushBaseStack] at h_ac_mem' ⊢
                                subst h_ac_mem'; rfl
                              have ih_res := ih h_st
                              rw [h_push_id] at ih_res
                              rw [h_step_body]
                              exact ih_res
                      | nil =>
                        rw [h_stk] at h_st h_step_body
                        cases h_vu : valueContainsUninit retVal with
                        | true => rw [h_vu] at h_st; exact False.elim h_st
                        | false =>
                          rw [h_vu] at h_st h_step_body
                          dsimp only [MirStepNode.retNormal, evalNodeNoCallWP, mirNormalPost, length] at h_st h_step_body
                          rw [h_step_body]
                          dsimp only [evalNodeNoCallWP, mirNormalPost]
                          refine ⟨_, ?_, h_st⟩
                          rcases ms with ⟨_, ⟨_, _, _, _, _, _, cs, ac, _, _, _, _, _⟩⟩
                          dsimp only [Memory.pushBaseStack] at h_stk ⊢
            · simp only [h_len] at h_st
              exact False.elim h_st

/--
Specialization of `wpMirExecNoCallSym_pushBaseStack_nil_outer` when `outerBody =
body`.
-/
theorem wpMirExecNoCallSym_pushBaseStack_nil
    {fuel : Nat} {body : CapturedMir} {st : MirExecState}
    {P : Value → Memory → Prop}
    (h : wpMirExecNoCallSym fuel body st (mirNormalPost P)) :
    wpMirExecNoCallSym fuel body (MirExecState.pushBaseStack body [] st)
      (mirNormalPost
        (fun retVal mem' =>
          ∃ mem₀, mem' = Memory.pushBaseStack body [] mem₀ ∧ P retVal mem₀)) :=
  wpMirExecNoCallSym_pushBaseStack_nil_outer h

/--
Fuel-bounded callee-aware pure execution predicate over `PureState`, seeding
`pureCalleeMemory callees traitImpls` and requiring `ActiveRootMemory`
preservation alongside `post retVal`.
-/
def wpPureMirExecWithCallees
    (fuel : Nat)
    (body : CapturedMir)
    (callees : List CapturedMir)
    (ps : PureState)
    (post : Value → Prop)
    (traitImpls : List TraitImplEntry := body.traitImpls) : Prop :=
  wpMirExecNoCallSym fuel body
    (.running (ps.toMachineState (pureCalleeMemory callees traitImpls)))
    (mirNormalPost
      (fun retVal mem' =>
        ActiveRootMemory body (pureCalleeMemory callees traitImpls) mem' ∧
        post retVal))

/--
Fuel-bounded partial-correctness (`mirSafePost`) callee-aware pure execution
predicate over `PureState`.
-/
def wpPureMirSafeExecWithCallees
    (fuel : Nat)
    (body : CapturedMir)
    (callees : List CapturedMir)
    (ps : PureState)
    (post : Value → Prop)
    (traitImpls : List TraitImplEntry := body.traitImpls) : Prop :=
  wpMirExecSym fuel body
    (.running (ps.toMachineState (pureCalleeMemory callees traitImpls)))
    (mirSafePost
      (fun retVal mem' =>
        ActiveRootMemory body (pureCalleeMemory callees traitImpls) mem' ∧
        post retVal))

/--
Fuel-free callee-aware total-correctness convergence over `PureState`.
-/
def PureMirConvergesWithCallees
    (body : CapturedMir)
    (callees : List CapturedMir)
    (ps : PureState)
    (post : Value → Prop)
    (traitImpls : List TraitImplEntry := body.traitImpls) : Prop :=
  ∃ fuel : Nat, wpPureMirExecWithCallees fuel body callees ps post traitImpls

/--
Fuel-free callee-aware partial-correctness (`mirSafePost`) convergence over
`PureState`.
-/
def PureMirSafeConvergesWithCallees
    (body : CapturedMir)
    (callees : List CapturedMir)
    (ps : PureState)
    (post : Value → Prop)
    (traitImpls : List TraitImplEntry := body.traitImpls) : Prop :=
  ∃ fuel : Nat, wpPureMirSafeExecWithCallees fuel body callees ps post traitImpls

/-- Postcondition monotonicity for `PureMirConvergesWithCallees`. -/
theorem PureMirConvergesWithCallees.mono
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {P Q : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h_imp : ∀ v, P v → Q v)
    (h : PureMirConvergesWithCallees body callees ps P traitImpls) :
    PureMirConvergesWithCallees body callees ps Q traitImpls := by
  rcases h with ⟨fuel, h_wp⟩
  refine ⟨fuel, wpMirExecNoCallSym_mono_post ?_ h_wp⟩
  intro out h_out
  cases out with
  | normal rv => exact ⟨h_out.1, h_imp rv.1 h_out.2⟩
  | panic => exact False.elim h_out
  | abort => exact False.elim h_out

/-- Postcondition monotonicity for `PureMirSafeConvergesWithCallees`. -/
theorem PureMirSafeConvergesWithCallees.mono
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {P Q : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h_imp : ∀ v, P v → Q v)
    (h : PureMirSafeConvergesWithCallees body callees ps P traitImpls) :
    PureMirSafeConvergesWithCallees body callees ps Q traitImpls := by
  rcases h with ⟨fuel, h_wp⟩
  refine ⟨fuel, wpMirExecSym_mono_post ?_ h_wp⟩
  intro out h_out
  cases out with
  | normal rv => exact ⟨h_out.1, h_imp rv.1 h_out.2⟩
  | panic => trivial
  | abort => trivial

/--
Every `PureMirConvergesWithCallees` proof implies
`PureMirSafeConvergesWithCallees`.
-/
theorem PureMirSafeConvergesWithCallees.of_pureMirConvergesWithCallees
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h : PureMirConvergesWithCallees body callees ps post traitImpls) :
    PureMirSafeConvergesWithCallees body callees ps post traitImpls := by
  rcases h with ⟨fuel, h_wp⟩
  exact ⟨fuel, wpMirExecSym_mono_post (fun _ => mirNormalPost_imp_mirSafePost)
    (wpMirExecSym_of_wpMirExecNoCallSym h_wp)⟩

/--
Lift any `FF-2.1` call-free `PureMirConverges body ps post` proof into
`PureMirConvergesWithCallees body callees ps post traitImpls` for arbitrary
`callees` and `traitImpls`.
-/
theorem PureMirConvergesWithCallees.of_pureMirConverges
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h_pure : checkPureMir body = true)
    (h : PureMirConverges body ps post) :
    PureMirConvergesWithCallees body callees ps post traitImpls := by
  rcases h with ⟨fuel, h_wp⟩
  have h_nc : wpMirExecNoCallSym fuel body
      (.running (ps.toMachineState emptyMemory))
      (mirNormalPost (fun retVal _ => post retVal)) :=
    wpMirExecNoCallSym_of_wpMirExecSym_normal h_wp
  have h_lifted :=
    wpMirExecNoCallSym_withMem_of_emptyMemory
      (mem₀ := pureCalleeMemory callees traitImpls)
      (.running (ps.toMachineState emptyMemory))
      h_pure
      (rootActiveMemory_pureCalleeMemory callees traitImpls)
      h_nc
  refine ⟨fuel, wpMirExecNoCallSym_mono_post ?_ h_lifted⟩
  intro out h_out
  cases out with
  | normal rv => exact ⟨Or.inl h_out.1, h_out.2⟩
  | panic => exact False.elim h_out
  | abort => exact False.elim h_out

/-- Alias `PureMirConverges.toWithCallees` for dot-notation lifting. -/
theorem PureMirConverges.toWithCallees
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h : PureMirConverges body ps post)
    (h_pure : checkPureMir body = true) :
    PureMirConvergesWithCallees body callees ps post traitImpls :=
  PureMirConvergesWithCallees.of_pureMirConverges h_pure h

/--
Lift `PureMirConvergesWithCallees` from `ps.toMachineState m0` to
`ps.toMachineState { m0 with activeCallee := some body }` (`Memory.pushBaseStack
body [] m0`)
so post-return continuations in `body` compose without exposing `activeCallee`.
-/
theorem PureMirConvergesWithCallees.toNoCall_some_activeCallee
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h : PureMirConvergesWithCallees body callees ps post traitImpls) :
    MirNoCallWpConverges body
      (ps.toMachineState { pureCalleeMemory callees traitImpls with activeCallee := some body })
      (mirNormalPost
        (fun retVal mem' =>
          ActiveRootMemory body (pureCalleeMemory callees traitImpls) mem' ∧
          post retVal)) := by
  rcases h with ⟨fuel, h_wp⟩
  have h_pushed := wpMirExecNoCallSym_pushBaseStack_nil h_wp
  have h_state_eq :
      MirExecState.pushBaseStack body []
        (.running (ps.toMachineState (pureCalleeMemory callees traitImpls))) =
      .running (ps.toMachineState
        { pureCalleeMemory callees traitImpls with activeCallee := some body }) := rfl
  rw [h_state_eq] at h_pushed
  refine ⟨fuel, wpMirExecNoCallSym_mono_post ?_ h_pushed⟩
  intro out h_out
  cases out with
  | panic => exact False.elim h_out
  | abort => exact False.elim h_out
  | normal rv =>
    rcases rv with ⟨retVal, mem'⟩
    rcases h_out with ⟨mem₀, rfl, h_act, h_post⟩
    refine ⟨?_, h_post⟩
    rcases h_act with rfl | ⟨b, ruc, rfl⟩
    · exact Or.inr ⟨body, _, rfl⟩
    · exact Or.inr ⟨b, ruc, rfl⟩

/--
Single-step symbolic unfolding rule for `PureMirConvergesWithCallees` over
`PureState` (covering statements, `goto`, `switchInt`, `assert`, `drop`,
`return_`, and inline `core::intrinsics::exact_div`).
-/
theorem PureMirConvergesWithCallees.step
    {body : CapturedMir} {callees : List CapturedMir}
    {ps : PureState} {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    (h :
      evalNodeNoCallWP
        (fun
          | .running s' =>
            s'.memory = pureCalleeMemory callees traitImpls ∧
            PureMirConvergesWithCallees body callees
              (PureState.ofMachineState s') post traitImpls
          | .halted out =>
            mirNormalPost
              (fun retVal mem' =>
                ActiveRootMemory body (pureCalleeMemory callees traitImpls) mem' ∧
                post retVal) out
          | .faulted _ => False)
        (mirNormalPost
          (fun retVal mem' =>
            ActiveRootMemory body (pureCalleeMemory callees traitImpls) mem' ∧
            post retVal))
        (stepMirFn body (ps.toMachineState (pureCalleeMemory callees traitImpls)))) :
    PureMirConvergesWithCallees body callees ps post traitImpls := by
  refine MirNoCallWpConverges.step ?_
  cases h_sf : stepMirFn body (ps.toMachineState (pureCalleeMemory callees traitImpls)) with
  | ret out =>
    rw [h_sf] at h
    exact h
  | tau st' =>
    rw [h_sf] at h
    cases st' with
    | faulted _ => exact False.elim h
    | halted out => exact h
    | running s' =>
      dsimp only [evalNodeNoCallWP] at h ⊢
      rcases h with ⟨h_mem, h_conv⟩
      have h_eq : (PureState.ofMachineState s').toMachineState (pureCalleeMemory callees traitImpls) = s' := by
        cases s'
        dsimp only [PureState.ofMachineState, PureState.toMachineState] at h_mem ⊢
        subst h_mem
        rfl
      rw [← h_eq]
      exact h_conv
  | vis i k =>
    rw [h_sf] at h
    rcases i with f | (e | c)
    · exact False.elim h
    · cases e
      dsimp only [evalNodeNoCallWP] at h ⊢
      cases h_ku : k PUnit.unit with
      | faulted _ =>
        rw [h_ku] at h
        exact False.elim h
      | halted out =>
        rw [h_ku] at h
        exact h
      | running s' =>
        rw [h_ku] at h
        rcases h with ⟨h_mem, h_conv⟩
        have h_eq : (PureState.ofMachineState s').toMachineState (pureCalleeMemory callees traitImpls) = s' := by
          cases s'
          dsimp only [PureState.ofMachineState, PureState.toMachineState] at h_mem ⊢
          subst h_mem
          rfl
        rw [← h_eq]
        exact h_conv
    · exact False.elim h

theorem get?_length_eq_none {α : Type} (xs : List α) :
    get? xs (length xs) = none := by
  induction xs with
  | nil => rfl
  | cons _ tl ih => exact ih

/--
Pure caller return-destination write over `List SlotState`:
matches `writeReturnDestination env emptyMemory dst val localDecls layouts`
(handling projected `.uninit` struct field shells and union sibling resets,
while reducing definitionally to `set? env dst.local_ (.init val)` whenever
`dst.projection = []`).
-/
def writePureReturnDestination
    (env : List SlotState)
    (dst : Place)
    (val : Value)
    (localDecls : List LocalDecl := [])
    (layouts : LayoutTable := emptyLayoutTable) : PlaceWriteResult :=
  match writeReturnDestination env emptyMemory dst val localDecls layouts with
  | .ok env' _ => .ok env'
  | .ub => .ub
  | .unsupported => .unsupported

def FrameWriteResult.withMem (m : Memory) : FrameWriteResult → FrameWriteResult
  | .ok locs _ => .ok locs m
  | .ub => .ub
  | .unsupported => .unsupported

theorem hasFrameDeallocProtectorConflict_of_eq_nil
    {borrows : List BorrowEntry} {activeProtectors : List Nat}
    (h_ap : activeProtectors = []) (depth nLocals : Nat) :
    hasFrameDeallocProtectorConflict borrows activeProtectors depth nLocals = false := by
  subst h_ap; cases borrows <;> rfl

theorem writeReturnDestination_borrows_nil_eq
    (callerLocals : List LocalSlot) (mem : Memory) (dst : Place)
    (retVal : Value) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (h_bor : mem.borrows = []) (h_ap : mem.activeProtectors = []) :
    writeReturnDestination callerLocals mem dst retVal localDecls layouts =
      FrameWriteResult.withMem mem
        (writeReturnDestination callerLocals emptyMemory dst retVal localDecls layouts) := by
  rcases mem with ⟨nA, gl, bor, nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ru⟩
  dsimp only at h_bor h_ap; subst h_bor h_ap
  rcases dst with ⟨dLoc, dProj⟩
  cases dProj with
  | nil =>
    unfold writeReturnDestination
    dsimp only [emptyMemory, hasProtectedWriteConflict, invalidateConflictingBorrows]
    cases get? callerLocals dLoc with
    | none => rfl
    | some sl =>
      cases sl with
      | dead => rfl
      | uninit => cases set? callerLocals dLoc (.init retVal) <;> rfl
      | init _ => cases set? callerLocals dLoc (.init retVal) <;> rfl
  | cons hd tl =>
    by_cases h_nd : hd = .deref
    · subst h_nd
      unfold writeReturnDestination
      dsimp only [emptyMemory]
      simp only [evalPlaceWrite_deref_nil_borrows]
      rw [foreignFrameDerefWrite_nil_borrows _ _ _ _ _ rfl localDecls layouts,
          foreignFrameDerefWrite_nil_borrows _ _ _ _ _ rfl localDecls layouts]
      rfl
    · rcases stripLeadingOpaqueCast_eq_nil_or_ne_nil (hd :: tl) with h_s | h_nr
      · cases hd with
        | opaqueCast castTy =>
          unfold writeReturnDestination
          rw [h_s]
          dsimp only [emptyMemory, hasProtectedWriteConflict, invalidateConflictingBorrows]
          split
          · rfl
          · cases get? callerLocals dLoc with
            | none => rfl
            | some sl =>
              cases sl with
              | dead => rfl
              | uninit | init _ => cases set? callerLocals dLoc (.init retVal) <;> rfl
        | _ => cases h_s
      · rw [writeReturnDestination_nonDeref callerLocals
              ⟨nA, gl, [], nT, cal, tr, cs, ac, [], nP, cl, fp, ex, ru⟩
              dLoc hd tl retVal localDecls layouts h_nd h_nr,
            writeReturnDestination_nonDeref callerLocals emptyMemory
              dLoc hd tl retVal localDecls layouts h_nd h_nr]
        let decls' := eraseLeadingOpaqueCastDecls localDecls layouts dLoc (hd :: tl)
        dsimp only [emptyMemory, hasProtectedWriteConflict, invalidateConflictingBorrowsAtProj]
        cases get? callerLocals dLoc with
        | none => rfl
        | some sl =>
          cases sl with
          | dead => rfl
          | uninit =>
            dsimp only
            cases uninitFieldWriteShell? localDecls layouts dLoc hd tl with
            | none => rfl
            | some rootVal =>
              dsimp only
              cases writeProjectedForLocal callerLocals decls' layouts dLoc rootVal (hd :: tl) retVal with
              | ub => rfl
              | unsupported => rfl
              | ok rv' => dsimp only; cases set? callerLocals dLoc (.init rv') <;> rfl
          | init rv0 =>
            dsimp only
            cases ensureNestedFieldShells rv0 (hd :: tl) decls' layouts
                (placeTy decls' layouts { local_ := dLoc, projection := .nil }) with
            | none => rfl
            | some rootVal =>
              dsimp only
              cases writeProjectedForLocal callerLocals decls' layouts dLoc rootVal (hd :: tl) retVal with
              | ub => rfl
              | unsupported => rfl
              | ok rv' => dsimp only; cases set? callerLocals dLoc (.init rv') <;> rfl

theorem writeReturnDestination_of_writePureReturnDestination
    {callerLocals updatedEnv : List LocalSlot} {mem : Memory} {dst : Place}
    {retVal : Value} {localDecls : List LocalDecl} {layouts : LayoutTable}
    (h_bor : mem.borrows = []) (h_ap : mem.activeProtectors = [])
    (h_pure_wr : writePureReturnDestination callerLocals dst retVal localDecls layouts = .ok updatedEnv) :
    writeReturnDestination callerLocals mem dst retVal localDecls layouts = .ok updatedEnv mem := by
  rw [writeReturnDestination_borrows_nil_eq callerLocals mem dst retVal localDecls layouts h_bor h_ap]
  unfold writePureReturnDestination at h_pure_wr
  cases h_w : writeReturnDestination callerLocals emptyMemory dst retVal localDecls layouts with
  | ok env' _ =>
    rw [h_w] at h_pure_wr
    injection h_pure_wr with h_eq
    subst h_eq
    rfl
  | ub => rw [h_w] at h_pure_wr; nomatch h_pure_wr
  | unsupported => rw [h_w] at h_pure_wr; nomatch h_pure_wr

/--
General stateful 1-step compositional callee summary rule
(`MirWpConverges.call_summary`):
when the active frame in `s` reaches `TerminatorKind.call func argOps
destination (.some targetBb) unwind`
with `s.memory.callStack.length < maxCallDepth`, `s.memory.activeProtectors =
[]`, and `s.memory.borrows = []` (required so the unstacked depth-0 `calleeBody`
summary commutes with stacked execution at depth `s.memory.callStack.length + 1`
under frame-scoped Tree Borrows `DIV-MR-CALL-TARGET-LOCAL` and
`DIV-MR-TB-FNENTRY-LOCAL-DEALLOC`),
resolving `(defPath, typeArgs)` via `resolveCallTarget` and `lookupCallee` to
`calleeBody`
with `checkCalleeTargetCompatible = true`, and `calleeBody` has an established
`MirWpConverges` summary producing `calleePost retVal` while preserving
`ActiveRootMemory`,
the caller steps in **1 compositional step** to `targetBb` with `destination :=
retVal` via `writeReturnDestination`
without re-stepping `calleeBody`'s basic blocks or guessing combined fuel.
-/
theorem MirWpConverges.call_summary
    {outerBody : CapturedMir}
    {s : MachineState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {destination : Place}
    {targetBb : BasicBlockIdx}
    {unwind : UnwindAction}
    {resolvedTarget : ResolvedCallTarget}
    {localsAfterFunc localsAfterArgs : List LocalSlot}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : MirOutcome → Prop}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, (s.memory.activeCallee.getD outerBody).phase ≠ .other tag)
    (h_bb : get? (s.memory.activeCallee.getD outerBody).basicBlocks s.frame.blockIdx = some bb)
    (h_end : s.frame.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .call func argOps destination (.some targetBb) unwind)
    (h_depth : s.memory.callStack.length < maxCallDepth := by
      first | decide | exact Nat.lt_succ_self _)
    (h_prot : s.memory.activeProtectors = [] := by rfl)
    (h_borrows : s.memory.borrows = [] := by rfl)
    (h_resolve :
      resolveCallTarget s func (length argOps)
        (s.memory.activeCallee.getD outerBody).localDecls
        (s.memory.activeCallee.getD outerBody).layouts =
        .ok resolvedTarget localsAfterFunc)
    (h_args :
      evalOperandsWithBodyCast localsAfterFunc argOps s.memory.borrows s.memory.globals
        (s.memory.activeCallee.getD outerBody).layouts s.memory.callerLocals
        (s.memory.activeCallee.getD outerBody).localDecls s.memory.callStack =
        .ok argVals localsAfterArgs)
    (h_lookup :
      lookupCallee s.memory.callees
        (s.memory.activeCallee.getD outerBody).layouts
        resolvedTarget.defPath resolvedTarget.typeArgs s.memory.traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      MirWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { s.memory with callStack := [], activeCallee := none })
        (mirNormalPost
          (fun retVal memOut =>
            ActiveRootMemory calleeBody
              { s.memory with callStack := [], activeCallee := none } memOut ∧
            calleePost retVal)))
    (h_after :
      ∀ (retVal : Value),
        calleePost retVal →
        ∃ (updatedLocals : List LocalSlot) (memResumed : Memory),
          writeReturnDestination localsAfterArgs
            { s.memory with
              activeCallee := some (s.memory.activeCallee.getD outerBody)
              activeProtectors := [] }
            destination retVal
            (s.memory.activeCallee.getD outerBody).localDecls
            (s.memory.activeCallee.getD outerBody).layouts =
            .ok updatedLocals memResumed ∧
          MirWpConverges outerBody
            { frame := { s.frame with blockIdx := targetBb, stmtIdx := 0, locals := updatedLocals }
              memory := memResumed }
            post)
    (h_ceil : s.memory.rootUnwindCeiling = true := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    MirWpConverges outerBody s post := by
  let _ := h_depth
  let curBody := s.memory.activeCallee.getD outerBody
  have h_stmt_none : get? bb.statements s.frame.stmtIdx = none := by
    rw [h_end]
    exact get?_length_eq_none bb.statements
  have h_step_eq :
      stepMirFn outerBody s =
        MirStepNode.step
          (pushCalleeFrame s curBody localsAfterArgs destination targetBb
            calleeBody argVals unwind) := by
    rw [stepMirFn_eq_ite]
    dsimp only
    cases h_ph : isOtherPhase curBody.phase with
    | true => exact False.elim (Bool.noConfusion (h_ph.symm.trans (isOtherPhase_eq_false h_phase)))
    | false =>
      simp only [Bool.false_eq_true, ite_false]
      rw [h_bb]
      dsimp only
      rw [h_stmt_none]
      dsimp only
      have h_beq : (s.frame.stmtIdx == length bb.statements) = true := by
        simp [h_end]
      simp only [h_beq, ite_true]
      rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
      dsimp only at h_term
      rw [h_term]
      dsimp only [evalTerminator, bodyLocalDeclsOf]
      rw [h_resolve]
      dsimp only
      rw [h_args]
      dsimp only
      rw [h_lookup]
      dsimp only
      rw [h_compat, h_entry]
  have h_callee_nc := mirNoCallWpConverges_of_mirWpConverges_normal h_callee_summary
  have h_bor_out :
      ∀ retVal memOut,
        ActiveRootMemory calleeBody
          { s.memory with callStack := [], activeCallee := none } memOut ∧
          calleePost retVal →
        memOut.borrows = [] := by
    intro _ memOut ⟨h_act_out, _⟩
    rcases h_act_out with rfl | ⟨_, _, rfl⟩ <;> exact h_borrows
  have h_push_steps :
      MirStepsConverges outerBody
        (pushCalleeFrame s curBody localsAfterArgs destination targetBb
          calleeBody argVals unwind)
        (fun ms' => MirWpConverges outerBody ms' post)
        post := by
    refine wpMirExecNoCallSym_pushCalleeFrame h_callee_nc h_prot h_bor_out ?_ h_ceil
    intro retVal memOut ⟨h_act_out, h_cpost⟩
    have h_mem_eq :
        { memOut with
          callStack := s.memory.callStack
          activeCallee := some curBody
          activeProtectors := []
          rootUnwindCeiling := s.memory.rootUnwindCeiling } =
        { s.memory with activeCallee := some curBody, activeProtectors := [] } := by
      rcases s with ⟨sFrame, sMem⟩
      cases sMem
      rcases h_act_out with rfl | ⟨_, _, rfl⟩ <;> rfl
    rw [h_mem_eq]
    exact h_after retVal h_cpost
  have h_one_step :
      MirStepsConverges outerBody s
        (fun ms' => ms' = pushCalleeFrame s curBody localsAfterArgs destination targetBb
          calleeBody argVals unwind)
        post := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    rw [h_step_eq]
    rfl
  exact MirWpConverges.bind h_one_step (fun ms' h_eq => by
    subst h_eq
    exact MirWpConverges.bind h_push_steps (fun _ hw => hw))

/-- Top-level alias for `MirWpConverges.call_summary`. -/
abbrev mirWpConverges_call_summary := @MirWpConverges.call_summary

/--
Stateful 1-step compositional root `tailCall` summary rule
(`MirWpConverges.tailCall_summary`):
when a root frame (`s.memory.callStack = []`, `s.memory.activeProtectors = []`
so frame-0 deallocation has no protector conflict under
`DIV-MR-TB-FNENTRY-LOCAL-DEALLOC`) reaches `TerminatorKind.tailCall func argOps`
with `0 < maxCallDepth`, resolving `(defPath, typeArgs)` via `resolveCallTarget`
and `lookupCallee` to `calleeBody` with `checkCalleeTargetCompatible = true`,
and `calleeBody` has an established `MirWpConverges` summary producing
`calleePost retVal` while preserving `ActiveRootMemory` over frame-0-deallocated
memory, the caller steps in **1 compositional step** to `post` without
re-stepping `calleeBody`'s basic blocks or exposing fuel.
-/
theorem MirWpConverges.tailCall_summary
    {outerBody : CapturedMir}
    {s : MachineState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {resolvedTarget : ResolvedCallTarget}
    {localsAfterFunc localsAfterArgs : List LocalSlot}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : MirOutcome → Prop}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, (s.memory.activeCallee.getD outerBody).phase ≠ .other tag)
    (h_bb : get? (s.memory.activeCallee.getD outerBody).basicBlocks s.frame.blockIdx = some bb)
    (h_end : s.frame.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .tailCall func argOps)
    (h_stack : s.memory.callStack = [] := by rfl)
    (h_prot : s.memory.activeProtectors = [] := by rfl)
    (h_depth : 0 < maxCallDepth := by
      first | decide | exact Nat.zero_lt_succ 31)
    (h_resolve :
      resolveCallTarget s func (length argOps)
        (s.memory.activeCallee.getD outerBody).localDecls
        (s.memory.activeCallee.getD outerBody).layouts =
        .ok resolvedTarget localsAfterFunc)
    (h_args :
      evalOperandsWithBodyCast localsAfterFunc argOps s.memory.borrows s.memory.globals
        (s.memory.activeCallee.getD outerBody).layouts s.memory.callerLocals
        (s.memory.activeCallee.getD outerBody).localDecls s.memory.callStack =
        .ok argVals localsAfterArgs)
    (h_lookup :
      lookupCallee s.memory.callees
        (s.memory.activeCallee.getD outerBody).layouts
        resolvedTarget.defPath resolvedTarget.typeArgs s.memory.traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      MirWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { (tailCalleeEntryMemory []
              { s.memory with borrows := disableFrameBorrows s.memory.borrows 0 (length s.frame.locals) }
              (length s.frame.locals) (length (initLocals calleeBody argVals))) with
            callStack := []
            activeCallee := none
            rootUnwindCeiling := Bool.and s.memory.rootUnwindCeiling calleeBody.fnAbi.canUnwind })
        (mirNormalPost
          (fun retVal memOut =>
            ActiveRootMemory calleeBody
              { (tailCalleeEntryMemory []
                  { s.memory with borrows := disableFrameBorrows s.memory.borrows 0 (length s.frame.locals) }
                  (length s.frame.locals) (length (initLocals calleeBody argVals))) with
                callStack := []
                activeCallee := none
                rootUnwindCeiling := Bool.and s.memory.rootUnwindCeiling calleeBody.fnAbi.canUnwind } memOut ∧
            calleePost retVal)))
    (h_after :
      ∀ (retVal : Value) (memOut : Memory),
        ActiveRootMemory outerBody
          { (tailCalleeEntryMemory []
              { s.memory with borrows := disableFrameBorrows s.memory.borrows 0 (length s.frame.locals) }
              (length s.frame.locals) (length (initLocals calleeBody argVals))) with
            callStack := []
            activeCallee := none
            rootUnwindCeiling := Bool.and s.memory.rootUnwindCeiling calleeBody.fnAbi.canUnwind } memOut →
        calleePost retVal →
        post (.normal (retVal, memOut)))
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    MirWpConverges outerBody s post := by
  let _ := h_depth
  let curBody := s.memory.activeCallee.getD outerBody
  let memPopped : Memory :=
    tailCalleeEntryMemory []
      { s.memory with borrows := disableFrameBorrows s.memory.borrows 0 (length s.frame.locals) }
      (length s.frame.locals) (length (initLocals calleeBody argVals))
  have h_stmt_none : get? bb.statements s.frame.stmtIdx = none := by
    rw [h_end]
    exact get?_length_eq_none bb.statements
  have h_step_eq :
      stepMirFn outerBody s =
        MirStepNode.step (enterTailCalleeFrame memPopped calleeBody argVals) := by
    rw [stepMirFn_eq_ite]
    dsimp only
    cases h_ph : isOtherPhase curBody.phase with
    | true => exact False.elim (Bool.noConfusion (h_ph.symm.trans (isOtherPhase_eq_false h_phase)))
    | false =>
      simp only [Bool.false_eq_true, ite_false]
      rw [h_bb]
      dsimp only
      rw [h_stmt_none]
      dsimp only
      have h_beq : (s.frame.stmtIdx == length bb.statements) = true := by
        simp [h_end]
      simp only [h_beq, ite_true]
      rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
      dsimp only at h_term
      rw [h_term]
      dsimp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf]
      rw [h_resolve]
      dsimp only
      rw [h_args]
      dsimp only
      rw [hasFrameDeallocProtectorConflict_of_eq_nil h_prot]
      dsimp only
      rw [h_lookup]
      dsimp only
      rw [h_compat, h_entry]
      rcases s with ⟨sFrame, sMem⟩
      cases sMem
      dsimp only [memPopped] at h_stack ⊢
      subst h_stack
      rfl
  rcases mirNoCallWpConverges_of_mirWpConverges_normal h_callee_summary with ⟨fuel_c, h_nc⟩
  have h_pushed :=
    wpMirExecNoCallSym_pushBaseStack_nil_outer (outerBody := outerBody) h_nc
  have h_state_eq :
      MirExecState.pushBaseStack calleeBody []
        (.running (initMachineStateWithMemory calleeBody argVals
          { memPopped with
            callStack := []
            activeCallee := none
            rootUnwindCeiling := Bool.and s.memory.rootUnwindCeiling calleeBody.fnAbi.canUnwind })) =
      .running (enterTailCalleeFrame memPopped calleeBody argVals) := by
    have h_mp_cs : memPopped.callStack = [] := by
      dsimp only [memPopped, tailCalleeEntryMemory, relocateRootCallerReferents]
      split
      · exact h_stack
      · split <;> exact h_stack
    have h_mp_ap : memPopped.activeProtectors = [] := by
      dsimp only [memPopped, tailCalleeEntryMemory, relocateRootCallerReferents]
      split
      · exact h_prot
      · split <;> exact h_prot
    have h_mp_ruc : memPopped.rootUnwindCeiling = s.memory.rootUnwindCeiling := by
      dsimp only [memPopped, tailCalleeEntryMemory, relocateRootCallerReferents]
      split
      · rfl
      · split <;> rfl
    have h_gen :
        ∀ (mp : Memory),
          mp.callStack = [] →
          mp.activeProtectors = [] →
          mp.rootUnwindCeiling = s.memory.rootUnwindCeiling →
          MirExecState.pushBaseStack calleeBody []
            (.running (initMachineStateWithMemory calleeBody argVals
              { mp with
                callStack := []
                activeCallee := none
                rootUnwindCeiling := Bool.and s.memory.rootUnwindCeiling calleeBody.fnAbi.canUnwind })) =
          .running (enterTailCalleeFrame mp calleeBody argVals) := by
      rintro ⟨nA, gl, bor, nT, cal, tr, cs, ac, ap, nP, cl, fp, ex, ruc⟩ hcs hap hruc
      dsimp only at hcs hap hruc
      subst hcs hap
      rw [← hruc]
      unfold enterTailCalleeFrame
      cases ruc <;> cases calleeBody.fnAbi.canUnwind <;> rfl
    exact h_gen memPopped h_mp_cs h_mp_ap h_mp_ruc
  rw [h_state_eq] at h_pushed
  have h_tail_nc :
      MirNoCallWpConverges outerBody
        (enterTailCalleeFrame memPopped calleeBody argVals) post := by
    refine ⟨fuel_c, wpMirExecNoCallSym_mono_post ?_ h_pushed⟩
    intro out h_out
    cases out with
    | panic => exact False.elim h_out
    | abort => exact False.elim h_out
    | normal rv =>
      rcases rv with ⟨retVal, mem'⟩
      rcases h_out with ⟨mem₀, rfl, h_act₀, h_cp⟩
      refine h_after retVal (Memory.pushBaseStack calleeBody [] mem₀) ?_ h_cp
      rcases h_act₀ with rfl | ⟨ab, ruc, rfl⟩
      · exact Or.inr ⟨calleeBody, _, rfl⟩
      · exact Or.inr ⟨ab, ruc, rfl⟩
  have h_one_step :
      MirStepsConverges outerBody s
        (fun ms' => ms' = enterTailCalleeFrame memPopped calleeBody argVals)
        post := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    rw [h_step_eq]
    rfl
  have h_root_nc : MirNoCallWpConverges outerBody s post :=
    MirNoCallWpConverges.bind h_one_step (fun ms' h_eq => by
      subst h_eq
      exact h_tail_nc)
  rcases h_root_nc with ⟨fuel_tot, h_tot⟩
  exact ⟨fuel_tot, wpMirExecSym_of_wpMirExecNoCallSym h_tot⟩

/--
Stateful 1-step compositional nested `tailCall` summary rule
(`MirWpConverges.tailCall_nested_summary`):
when a non-root frame (`s.memory.callStack = caller :: restStack` with
`caller.isDiverging = false`, `caller.calleeProtectors = []`, and
`s.memory.borrows = []` so unstacked depth-0 execution of `calleeBody` commutes
with stacked execution at depth `restStack.length + 1` under frame-scoped Tree
Borrows) executes `TerminatorKind.tailCall func argOps`, `calleeBody` returns
directly into the suspended `caller` frame via `writeReturnDestination` without
growing `callStack`.
-/
theorem MirWpConverges.tailCall_nested_summary
    {outerBody : CapturedMir}
    {s : MachineState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {caller : SavedCallerFrame}
    {restStack : List SavedCallerFrame}
    {resolvedTarget : ResolvedCallTarget}
    {localsAfterFunc localsAfterArgs : List LocalSlot}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : MirOutcome → Prop}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, (s.memory.activeCallee.getD outerBody).phase ≠ .other tag)
    (h_bb : get? (s.memory.activeCallee.getD outerBody).basicBlocks s.frame.blockIdx = some bb)
    (h_end : s.frame.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .tailCall func argOps)
    (h_stack : s.memory.callStack = caller :: restStack)
    (h_depth : s.memory.callStack.length < maxCallDepth := by
      first | decide | exact Nat.lt_succ_self _)
    (h_prot : s.memory.activeProtectors = [] := by rfl)
    (h_borrows : s.memory.borrows = [] := by rfl)
    (h_cprot : caller.calleeProtectors = [] := by rfl)
    (h_ccprot : caller.callerProtector = none := by rfl)
    (h_cdiv : caller.isDiverging = false := by rfl)
    (h_resolve :
      resolveCallTarget s func (length argOps)
        (s.memory.activeCallee.getD outerBody).localDecls
        (s.memory.activeCallee.getD outerBody).layouts =
        .ok resolvedTarget localsAfterFunc)
    (h_args :
      evalOperandsWithBodyCast localsAfterFunc argOps s.memory.borrows s.memory.globals
        (s.memory.activeCallee.getD outerBody).layouts s.memory.callerLocals
        (s.memory.activeCallee.getD outerBody).localDecls s.memory.callStack =
        .ok argVals localsAfterArgs)
    (h_lookup :
      lookupCallee s.memory.callees
        (s.memory.activeCallee.getD outerBody).layouts
        resolvedTarget.defPath resolvedTarget.typeArgs s.memory.traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      MirWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { s.memory with callStack := [], activeCallee := none })
        (mirNormalPost
          (fun retVal memOut =>
            ActiveRootMemory calleeBody
              { s.memory with callStack := [], activeCallee := none } memOut ∧
            calleePost retVal)))
    (h_after :
      ∀ (retVal : Value),
        calleePost retVal →
        ∃ (updatedLocals : List LocalSlot) (memResumed : Memory),
          writeReturnDestination caller.frame.locals
            { s.memory with
              callStack := restStack
              activeCallee := some caller.callerBody
              activeProtectors := [] }
            caller.destination retVal
            caller.callerBody.localDecls caller.callerBody.layouts =
            .ok updatedLocals memResumed ∧
          MirWpConverges outerBody
            { frame := {
                caller.frame with
                blockIdx := caller.returnTarget
                stmtIdx := 0
                locals := updatedLocals }
              memory := memResumed }
            post)
    (h_ceil : s.memory.rootUnwindCeiling = true := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    MirWpConverges outerBody s post := by
  let _ := h_depth
  let curBody := s.memory.activeCallee.getD outerBody
  have h_stmt_none : get? bb.statements s.frame.stmtIdx = none := by
    rw [h_end]
    exact get?_length_eq_none bb.statements
  have h_step_eq :
      stepMirFn outerBody s =
        MirStepNode.step (enterTailCalleeFrame s.memory calleeBody argVals) := by
    rw [stepMirFn_eq_ite]
    dsimp only
    cases h_ph : isOtherPhase curBody.phase with
    | true => exact False.elim (Bool.noConfusion (h_ph.symm.trans (isOtherPhase_eq_false h_phase)))
    | false =>
      simp only [Bool.false_eq_true, ite_false]
      rw [h_bb]
      dsimp only
      rw [h_stmt_none]
      dsimp only
      have h_beq : (s.frame.stmtIdx == length bb.statements) = true := by
        simp [h_end]
      simp only [h_beq, ite_true]
      rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
      dsimp only at h_term
      rw [h_term]
      dsimp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf]
      rw [h_resolve]
      dsimp only
      rw [h_args]
      dsimp only
      rw [hasFrameDeallocProtectorConflict_of_eq_nil h_prot]
      dsimp only
      rw [h_lookup]
      dsimp only
      rw [h_compat, h_entry]
      rcases s with ⟨sFrame, sMem⟩
      cases sMem
      dsimp only at h_borrows h_stack ⊢
      subst h_borrows
      rw [h_stack]
      rfl
  let sParent : MachineState := {
    frame := caller.frame
    memory := { s.memory with callStack := restStack, activeProtectors := [] }
  }
  let effUnwind : UnwindAction :=
    match calleeBody.fnAbi.canUnwind with
    | true => caller.returnUnwind
    | false => .unreachable
  have h_enter_eq :
      enterTailCalleeFrame s.memory calleeBody argVals =
        pushCalleeFrame sParent caller.callerBody caller.frame.locals
          caller.destination caller.returnTarget calleeBody argVals
          effUnwind := by
    have h_frame_eta :
        ({ caller.frame with locals := caller.frame.locals } : StackFrame) =
          caller.frame := by
      cases caller.frame
      rfl
    rcases s with ⟨sFrame, sMem⟩
    cases sMem
    cases caller
    dsimp only [sParent, effUnwind, enterTailCalleeFrame, pushCalleeFrame,
      narrowCallStackForTailCallee] at h_stack h_prot h_cprot h_ccprot h_cdiv h_frame_eta ⊢
    rw [h_frame_eta]
    subst h_stack h_prot h_cprot h_ccprot h_cdiv
    cases calleeBody.fnAbi.canUnwind <;> rfl
  have h_init_eq :
      initMachineStateWithMemory calleeBody argVals
        { sParent.memory with callStack := [], activeCallee := none } =
      initMachineStateWithMemory calleeBody argVals
        { s.memory with callStack := [], activeCallee := none } := by
    rcases s with ⟨sFrame, sMem⟩
    cases sMem
    dsimp only [sParent] at h_prot ⊢
    subst h_prot
    rfl
  have h_callee_nc :
      MirNoCallWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { sParent.memory with callStack := [], activeCallee := none })
        (mirNormalPost
          (fun retVal memOut =>
            ActiveRootMemory calleeBody
              { s.memory with callStack := [], activeCallee := none } memOut ∧
            calleePost retVal)) := by
    rw [h_init_eq]
    exact mirNoCallWpConverges_of_mirWpConverges_normal h_callee_summary
  have h_bor_out :
      ∀ retVal memOut,
        ActiveRootMemory calleeBody
          { s.memory with callStack := [], activeCallee := none } memOut ∧
          calleePost retVal →
        memOut.borrows = [] := by
    intro _ memOut ⟨h_act_out, _⟩
    rcases h_act_out with rfl | ⟨_, _, rfl⟩ <;> exact h_borrows
  have h_push_steps :
      MirStepsConverges outerBody
        (enterTailCalleeFrame s.memory calleeBody argVals)
        (fun ms' => MirWpConverges outerBody ms' post)
        post := by
    rw [h_enter_eq]
    refine wpMirExecNoCallSym_pushCalleeFrame h_callee_nc rfl h_bor_out ?_ h_ceil
    intro retVal memOut ⟨h_act_out, h_cpost⟩
    have h_mem_eq :
        { memOut with
          callStack := sParent.memory.callStack
          activeCallee := some caller.callerBody
          activeProtectors := []
          rootUnwindCeiling := sParent.memory.rootUnwindCeiling } =
        { s.memory with
          callStack := restStack
          activeCallee := some caller.callerBody
          activeProtectors := [] } := by
      rcases s with ⟨sFrame, sMem⟩
      cases sMem
      rcases h_act_out with rfl | ⟨_, _, rfl⟩ <;> rfl
    rw [h_mem_eq]
    exact h_after retVal h_cpost
  have h_one_step :
      MirStepsConverges outerBody s
        (fun ms' => ms' = enterTailCalleeFrame s.memory calleeBody argVals)
        post := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    rw [h_step_eq]
    rfl
  exact MirWpConverges.bind h_one_step (fun ms' h_eq => by
    subst h_eq
    exact MirWpConverges.bind h_push_steps (fun _ hw => hw))

/--
Compositional 1-step callee summary rule on `PureState`
(`PureMirConvergesWithCallees.call_summary`):
when `body` at `ps` reaches `TerminatorKind.call func argOps destination (.some
targetBb) unwind`
with `0 < maxCallDepth`, resolving `(defPath, typeArgs)` via `resolveCallTarget`
and
`lookupCallee callees body.layouts resolvedTarget.defPath
resolvedTarget.typeArgs traitImpls`
(including polymorphic instantiation and `TraitImplEntry` dispatch) to
`calleeBody`
with `checkCalleeTargetCompatible = true`, and `calleeBody` has an established
`PureMirConvergesWithCallees` summary producing `calleePost retVal`, the caller
steps directly in **1 compositional step** to `{ bb := targetBb, stmtIdx := 0,
env := updatedEnv }` via `writePureReturnDestination`
in `PureState` without re-stepping `calleeBody`'s basic blocks or guessing
combined fuel.
-/
theorem PureMirConvergesWithCallees.call_summary
    {body : CapturedMir}
    {callees : List CapturedMir}
    {ps : PureState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {destination : Place}
    {targetBb : BasicBlockIdx}
    {unwind : UnwindAction}
    {resolvedTarget : ResolvedCallTarget}
    {envAfterFunc envAfterArgs : List SlotState}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, body.phase ≠ .other tag)
    (h_bb : get? body.basicBlocks ps.bb = some bb)
    (h_end : ps.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .call func argOps destination (.some targetBb) unwind)
    (h_depth : 0 < maxCallDepth := by
      first | decide | exact Nat.zero_lt_succ 31)
    (h_resolve :
      resolveCallTarget
        (ps.toMachineState (pureCalleeMemory callees traitImpls))
        func (length argOps) body.localDecls body.layouts =
        .ok resolvedTarget envAfterFunc)
    (h_args :
      evalPureOperands envAfterFunc argOps body.layouts =
        .ok argVals envAfterArgs)
    (h_lookup :
      lookupCallee callees body.layouts
        resolvedTarget.defPath resolvedTarget.typeArgs traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      PureMirConvergesWithCallees calleeBody callees
        (initPureState calleeBody argVals) calleePost traitImpls)
    (h_after :
      ∀ (retVal : Value),
        calleePost retVal →
        ∃ updatedEnv : List SlotState,
          writePureReturnDestination envAfterArgs destination retVal
            body.localDecls body.layouts = .ok updatedEnv ∧
          PureMirConvergesWithCallees body callees
            { bb := targetBb, stmtIdx := 0, env := updatedEnv } post traitImpls)
    (h_no_cast : operandsHaveLeadingOpaqueCastMove argOps = false := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    PureMirConvergesWithCallees body callees ps post traitImpls := by
  let _ := h_depth
  let m0 := pureCalleeMemory callees traitImpls
  let s0 := ps.toMachineState m0
  have h_stmt_none : get? bb.statements ps.stmtIdx = none := by
    rw [h_end]
    exact get?_length_eq_none bb.statements
  have h_step_eq :
      stepMirFn body s0 =
        MirStepNode.step
          (pushCalleeFrame s0 body envAfterArgs destination targetBb
            calleeBody argVals unwind) := by
    unfold stepMirFn
    dsimp only [s0, m0, PureState.toMachineState, pureCalleeMemory_activeCallee, Option.getD]
    cases h_ph : body.phase with
    | other tag => exact False.elim (h_phase tag h_ph)
    | _ =>
      dsimp only
      rw [h_bb]
      dsimp only
      rw [h_stmt_none]
      dsimp only
      have h_beq : (ps.stmtIdx == length bb.statements) = true := by
        simp [h_end]
      simp only [h_beq, ite_true]
      rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
      dsimp only at h_term
      rw [h_term]
      dsimp only [PureState.toMachineState] at h_resolve
      unfold evalPureOperands at h_args
      dsimp only [evalTerminator, bodyLocalDeclsOf,
        pureCalleeMemory_borrows, pureCalleeMemory_globals,
        pureCalleeMemory_callerLocals, pureCalleeMemory_callees,
        pureCalleeMemory_traitImpls, pureCalleeMemory_callStack]
      rw [h_resolve]
      dsimp only
      rw [evalOperandsWithBodyCast_eq_evalOperands _ _ _ _ _ _ _ _ h_no_cast, h_args]
      dsimp only
      rw [h_lookup]
      dsimp only
      rw [h_compat, h_entry]
  have h_init_eq :
      initMachineStateWithMemory calleeBody argVals
        { s0.memory with callStack := [], activeCallee := none } =
      (initPureState calleeBody argVals).toMachineState m0 := rfl
  have h_callee_nc :
      MirNoCallWpConverges calleeBody
        (initMachineStateWithMemory calleeBody argVals
          { s0.memory with callStack := [], activeCallee := none })
        (mirNormalPost
          (fun retVal memOut =>
            ActiveRootMemory calleeBody m0 memOut ∧ calleePost retVal)) := by
    rw [h_init_eq]
    exact h_callee_summary
  let targetPost :=
    mirNormalPost
      (fun retVal mem' =>
        ActiveRootMemory body m0 mem' ∧ post retVal)
  have h_push_steps :
      MirStepsConverges body
        (pushCalleeFrame s0 body envAfterArgs destination targetBb
          calleeBody argVals unwind)
        (fun ms' => MirNoCallWpConverges body ms' targetPost)
        targetPost := by
    refine wpMirExecNoCallSym_pushCalleeFrame h_callee_nc rfl
      (fun _ _ h => ActiveRootMemory.borrows_eq h.1) ?_
    intro retVal memOut ⟨h_act_out, h_cpost⟩
    rcases h_after retVal h_cpost with ⟨updEnv, h_wr, h_next_conv⟩
    have h_mem_eq :
        { memOut with
          callStack := s0.memory.callStack
          activeCallee := some body
          activeProtectors := []
          rootUnwindCeiling := s0.memory.rootUnwindCeiling } =
        { m0 with activeCallee := some body } := by
      rcases h_act_out with rfl | ⟨_, _, rfl⟩ <;> rfl
    refine ⟨updEnv, { m0 with activeCallee := some body }, ?_, ?_⟩
    · rw [h_mem_eq]
      exact writeReturnDestination_of_writePureReturnDestination rfl rfl h_wr
    · exact PureMirConvergesWithCallees.toNoCall_some_activeCallee h_next_conv
  have h_one_step :
      MirStepsConverges body s0
        (fun ms' => ms' = pushCalleeFrame s0 body envAfterArgs destination targetBb
          calleeBody argVals unwind)
        targetPost := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    rw [h_step_eq]
    rfl
  exact MirNoCallWpConverges.bind h_one_step (fun ms' h_eq => by
    subst h_eq
    exact MirNoCallWpConverges.bind h_push_steps (fun _ hw => hw))

/--
Headline compositional 1-step callee summary rule
(`PureMirConverges.call_summary`,
`FF-2.2` Section 4): resolves direct or polymorphic `(defPath, typeArgs)`
callees
in `callees` (with `0 < maxCallDepth`) using an established
`PureMirConvergesWithCallees`
summary (which includes leaf `PureMirConverges` summaries via `.toWithCallees`
as
well as nested multi-callee summaries) and advances the caller directly to
`{ bb := targetBb, stmtIdx := 0, env := updatedEnv }` in 1 compositional step.
-/
theorem PureMirConverges.call_summary
    {body : CapturedMir}
    {callees : List CapturedMir}
    {ps : PureState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {destination : Place}
    {targetBb : BasicBlockIdx}
    {unwind : UnwindAction}
    {resolvedTarget : ResolvedCallTarget}
    {envAfterFunc envAfterArgs : List SlotState}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, body.phase ≠ .other tag)
    (h_bb : get? body.basicBlocks ps.bb = some bb)
    (h_end : ps.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .call func argOps destination (.some targetBb) unwind)
    (h_depth : 0 < maxCallDepth := by
      first | decide | exact Nat.zero_lt_succ 31)
    (h_resolve :
      resolveCallTarget
        (ps.toMachineState (pureCalleeMemory callees traitImpls))
        func (length argOps) body.localDecls body.layouts =
        .ok resolvedTarget envAfterFunc)
    (h_args :
      evalPureOperands envAfterFunc argOps body.layouts =
        .ok argVals envAfterArgs)
    (h_lookup :
      lookupCallee callees body.layouts
        resolvedTarget.defPath resolvedTarget.typeArgs traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      PureMirConvergesWithCallees calleeBody callees
        (initPureState calleeBody argVals) calleePost traitImpls)
    (h_after :
      ∀ (retVal : Value),
        calleePost retVal →
        ∃ updatedEnv : List SlotState,
          writePureReturnDestination envAfterArgs destination retVal
            body.localDecls body.layouts = .ok updatedEnv ∧
          PureMirConvergesWithCallees body callees
            { bb := targetBb, stmtIdx := 0, env := updatedEnv } post traitImpls)
    (h_no_cast : operandsHaveLeadingOpaqueCastMove argOps = false := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    PureMirConvergesWithCallees body callees ps post traitImpls :=
  PureMirConvergesWithCallees.call_summary
    h_phase h_bb h_end h_term h_depth h_resolve h_args h_lookup h_compat
    h_callee_summary h_after h_no_cast h_entry

/--
Leaf specialization of `PureMirConverges.call_summary` accepting an `FF-2.1`
call-free `PureMirConverges calleeBody (initPureState calleeBody argVals)
calleePost`
summary directly (given `checkPureMir calleeBody = true`).
-/
theorem PureMirConverges.call_leaf_summary
    {body : CapturedMir}
    {callees : List CapturedMir}
    {ps : PureState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {destination : Place}
    {targetBb : BasicBlockIdx}
    {unwind : UnwindAction}
    {resolvedTarget : ResolvedCallTarget}
    {envAfterFunc envAfterArgs : List SlotState}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, body.phase ≠ .other tag)
    (h_bb : get? body.basicBlocks ps.bb = some bb)
    (h_end : ps.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .call func argOps destination (.some targetBb) unwind)
    (h_depth : 0 < maxCallDepth := by
      first | decide | exact Nat.zero_lt_succ 31)
    (h_resolve :
      resolveCallTarget
        (ps.toMachineState (pureCalleeMemory callees traitImpls))
        func (length argOps) body.localDecls body.layouts =
        .ok resolvedTarget envAfterFunc)
    (h_args :
      evalPureOperands envAfterFunc argOps body.layouts =
        .ok argVals envAfterArgs)
    (h_lookup :
      lookupCallee callees body.layouts
        resolvedTarget.defPath resolvedTarget.typeArgs traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_pure : checkPureMir calleeBody = true)
    (h_callee_summary :
      PureMirConverges calleeBody (initPureState calleeBody argVals) calleePost)
    (h_after :
      ∀ (retVal : Value),
        calleePost retVal →
        ∃ updatedEnv : List SlotState,
          writePureReturnDestination envAfterArgs destination retVal
            body.localDecls body.layouts = .ok updatedEnv ∧
          PureMirConvergesWithCallees body callees
            { bb := targetBb, stmtIdx := 0, env := updatedEnv } post traitImpls)
    (h_no_cast : operandsHaveLeadingOpaqueCastMove argOps = false := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    PureMirConvergesWithCallees body callees ps post traitImpls :=
  PureMirConverges.call_summary
    h_phase h_bb h_end h_term h_depth h_resolve h_args h_lookup h_compat
    (PureMirConvergesWithCallees.of_pureMirConverges h_callee_pure h_callee_summary)
    h_after h_no_cast h_entry

/--
Compositional 1-step `tailCall` summary rule on `PureState`
(`PureMirConvergesWithCallees.tailCall_summary`):
when `body` at `ps` reaches `TerminatorKind.tailCall func argOps` with
`0 < maxCallDepth`, resolving `(defPath, typeArgs)` via `resolveCallTarget` and
`lookupCallee` to `calleeBody` with `checkCalleeTargetCompatible = true`, and
`calleeBody` has an established `PureMirConvergesWithCallees` summary producing
`calleePost retVal`, the caller converges in **1 compositional step** to `post`
without re-stepping `calleeBody`'s basic blocks or exposing fuel.
-/
theorem PureMirConvergesWithCallees.tailCall_summary
    {body : CapturedMir}
    {callees : List CapturedMir}
    {ps : PureState}
    {bb : BasicBlockData}
    {func : Operand}
    {argOps : List Operand}
    {resolvedTarget : ResolvedCallTarget}
    {envAfterFunc envAfterArgs : List SlotState}
    {argVals : List Value}
    {calleeBody : CapturedMir}
    {calleePost : Value → Prop}
    {post : Value → Prop}
    {traitImpls : List TraitImplEntry}
    {maxCallDepth : Nat}
    (h_phase : ∀ tag, body.phase ≠ .other tag)
    (h_bb : get? body.basicBlocks ps.bb = some bb)
    (h_end : ps.stmtIdx = length bb.statements)
    (h_term : bb.terminator.kind = .tailCall func argOps)
    (h_depth : 0 < maxCallDepth := by
      first | decide | exact Nat.zero_lt_succ 31)
    (h_resolve :
      resolveCallTarget
        (ps.toMachineState (pureCalleeMemory callees traitImpls))
        func (length argOps) body.localDecls body.layouts =
        .ok resolvedTarget envAfterFunc)
    (h_args :
      evalPureOperands envAfterFunc argOps body.layouts =
        .ok argVals envAfterArgs)
    (h_lookup :
      lookupCallee callees body.layouts
        resolvedTarget.defPath resolvedTarget.typeArgs traitImpls =
        some calleeBody)
    (h_compat :
      checkCalleeTargetCompatible resolvedTarget calleeBody (length argVals) = true := by rfl)
    (h_callee_summary :
      PureMirConvergesWithCallees calleeBody callees
        (initPureState calleeBody argVals) calleePost traitImpls)
    (h_imp : ∀ retVal : Value, calleePost retVal → post retVal)
    (h_unwind : calleeBody.fnAbi.canUnwind = true := by rfl)
    (h_no_cast : operandsHaveLeadingOpaqueCastMove argOps = false := by rfl)
    (h_entry :
      calleeEntryArgs resolvedTarget calleeBody argVals = argVals := by rfl) :
    PureMirConvergesWithCallees body callees ps post traitImpls := by
  let _ := h_depth
  let m0 := pureCalleeMemory callees traitImpls
  let s0 := ps.toMachineState m0
  have h_stmt_none : get? bb.statements ps.stmtIdx = none := by
    rw [h_end]
    exact get?_length_eq_none bb.statements
  have h_step_eq :
      stepMirFn body s0 =
        MirStepNode.step (enterTailCalleeFrame m0 calleeBody argVals) := by
    unfold stepMirFn
    dsimp only [s0, m0, PureState.toMachineState, pureCalleeMemory_activeCallee, Option.getD]
    cases h_ph : body.phase with
    | other tag => exact False.elim (h_phase tag h_ph)
    | _ =>
      dsimp only
      rw [h_bb]
      dsimp only
      rw [h_stmt_none]
      dsimp only
      have h_beq : (ps.stmtIdx == length bb.statements) = true := by
        simp [h_end]
      simp only [h_beq, ite_true]
      rcases bb with ⟨stmts, ⟨tk, tsp⟩, isCl⟩
      dsimp only at h_term
      rw [h_term]
      dsimp only [PureState.toMachineState] at h_resolve
      unfold evalPureOperands at h_args
      dsimp only [evalTerminator, evalTailCallTerminator, bodyLocalDeclsOf,
        pureCalleeMemory_borrows, pureCalleeMemory_globals,
        pureCalleeMemory_callerLocals, pureCalleeMemory_callees,
        pureCalleeMemory_traitImpls, pureCalleeMemory_callStack,
        pureCalleeMemory_activeProtectors]
      rw [h_resolve]
      dsimp only
      rw [evalOperandsWithBodyCast_eq_evalOperands _ _ _ _ _ _ _ _ h_no_cast, h_args]
      dsimp only
      rw [h_lookup]
      dsimp only
      rw [h_compat, h_entry]
      dsimp only [tailCalleeEntryMemory, relocateRootCallerReferents, hasAnyRootCallerReferent]
      cases Nat.blt (length ps.env) (length (initLocals calleeBody argVals)) <;> rfl
  rcases h_callee_summary with ⟨fuel_c, h_wp_c⟩
  have h_pushed :=
    wpMirExecNoCallSym_pushBaseStack_nil_outer (outerBody := body) h_wp_c
  have h_state_eq :
      MirExecState.pushBaseStack calleeBody []
        (.running ((initPureState calleeBody argVals).toMachineState m0)) =
      .running (enterTailCalleeFrame m0 calleeBody argVals) := by
    dsimp only [MirExecState.pushBaseStack, MachineState.pushBaseStack,
      Memory.pushBaseStack, PureState.toMachineState, initPureState,
      enterTailCalleeFrame, m0, pureCalleeMemory, emptyMemory]
    rw [h_unwind]
    rfl
  rw [h_state_eq] at h_pushed
  let targetPost :=
    mirNormalPost
      (fun retVal mem' =>
        ActiveRootMemory body m0 mem' ∧ post retVal)
  have h_tail_nc :
      MirNoCallWpConverges body
        (enterTailCalleeFrame m0 calleeBody argVals) targetPost := by
    refine ⟨fuel_c, wpMirExecNoCallSym_mono_post ?_ h_pushed⟩
    intro out h_out
    cases out with
    | panic => exact False.elim h_out
    | abort => exact False.elim h_out
    | normal rv =>
      rcases rv with ⟨retVal, mem'⟩
      rcases h_out with ⟨memOut, rfl, h_act_out, h_cp⟩
      refine ⟨?_, h_imp retVal h_cp⟩
      rcases h_act_out with rfl | ⟨ab, ruc, rfl⟩
      · exact Or.inr ⟨calleeBody, _, rfl⟩
      · exact Or.inr ⟨ab, ruc, rfl⟩
  have h_one_step :
      MirStepsConverges body s0
        (fun ms' => ms' = enterTailCalleeFrame m0 calleeBody argVals)
        targetPost := by
    refine ⟨1, ?_⟩
    unfold wpMirStepsSym wpMirExecStepsSym
    rw [evalSymNodeTreeNoCall_eq, stepMirExecSymTree_eval]
    dsimp only [stepMirState]
    rw [h_step_eq]
    rfl
  exact MirNoCallWpConverges.bind h_one_step (fun ms' h_eq => by
    subst h_eq
    exact h_tail_nc)

/--
Headline compositional 1-step `tailCall` summary rule
(`PureMirConverges.tailCall_summary`).
-/
