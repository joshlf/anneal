  | ub => rfl
  | unsupported => rfl
  | ok srcVal locals₁ =>
    dsimp only
    cases evalOperand locals₁ dst s.memory.borrows s.memory.globals layouts s.memory.callerLocals localDecls s.memory.callStack with
    | ub => rfl
    | unsupported => rfl
    | ok dstVal locals₂ =>
