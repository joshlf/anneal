                (.binaryOp .le (.move { local_ := 6, projection := [] })
                  (.constant { ty := { kind := .int .i8, layoutIdx := 0 },
                               val := .scalar (.int { bits := 0, sizeBytes := 1 }) }))
              span := "core/src/cmp.rs:1:5" }]
         terminator := { kind := .goto 1, span := "core/src/cmp.rs:1:6" }
         isCleanup := false },
       { statements :=
