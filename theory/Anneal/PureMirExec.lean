theorem verifyTotalMir_of_pureExec
    (c : TotalClaim)
    (h_pure : checkPureMir c.body = true)
    (h_root : ∀ args mem, c.pre args mem → RootActiveMemory mem)
    (h_wp :
      ∀ (args : List Value) (mem : Memory),
