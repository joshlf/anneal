  exact MirWpConverges.mono
    (fun out h_out => by
      cases out with
      | normal rv =>
        rcases rv with ⟨retVal, mem'⟩
        exact h_out.2 mem' h_out.1
      | panic => exact False.elim h_out
      | abort => exact False.elim h_out)
    h

