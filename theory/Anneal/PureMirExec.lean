theorem evalNonSelectIntrinsicCall_pushBaseStack_of_noCallWP
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (kind : RustIntrinsicKind) (ms : MachineState)
    (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalNonSelectIntrinsicCall kind ms target bodyLocalDecls bodyLayouts
          argOps argVals locals' destination targetBb))
    (h_bor : baseStack = [] ∨ ms.memory.borrows = []) :
    ∃ nextSt : MachineState,
      evalNonSelectIntrinsicCall kind ms target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb =
        MirStepNode.step nextSt ∧
      evalNonSelectIntrinsicCall kind
        (MachineState.pushBaseStack calleeBody baseStack ms) target
        bodyLocalDecls bodyLayouts argOps argVals locals' destination targetBb =
        MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack nextSt) := by
  rcases evalNonSelectIntrinsicCall_cases kind target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb with ⟨retVal, h_wr⟩ | ⟨fk, h_fl⟩ | h_un
  · rw [h_wr ms] at h_st ⊢
    rw [h_wr (MachineState.pushBaseStack calleeBody baseStack ms)]
    exact writeIntrinsicReturn_pushBaseStack_of_noCallWP calleeBody baseStack
      ms locals' destination targetBb retVal h_st h_bor
  · rw [h_fl ms] at h_st; exact False.elim h_st
  · rw [h_un ms] at h_st; exact False.elim h_st

/-- `Trusted.finishMemIntrinsicCall` after a statement step `s'` writes `()` from the call's
frame, with `s'`'s memory and frame locals. -/
theorem finishMemIntrinsicCall_step (s s' : MachineState) (destination : Place)
    (targetBb : BasicBlockIdx) :
    finishMemIntrinsicCall s (MirStepNode.step s') destination targetBb =
      writeIntrinsicReturn { s with memory := s'.memory } s'.frame.locals destination targetBb
        .unit :=
  rfl

theorem commitCopyDstPlaceWrite_pushBaseStack
    (calleeBody : CapturedMir) (s : MachineState) (dstPlace : Place) (dstLoc : Local)
    (dstTag : Nat) (locals₃ : List LocalSlot) (newVal : Value)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    commitCopyDstPlaceWrite (MachineState.pushBaseStack calleeBody [] s) dstPlace dstLoc dstTag
        locals₃ newVal localDecls layouts =
      MirStepNode.pushBaseStack calleeBody []
        (commitCopyDstPlaceWrite s dstPlace dstLoc dstTag locals₃ newVal localDecls layouts) :=
  copyWriteDstVal_pushBaseStack calleeBody s locals₃ dstPlace dstLoc dstTag newVal localDecls
    layouts

theorem commitCopyDstPlaceWrite_isStmtNode
    (s : MachineState) (dstPlace : Place) (dstLoc : Local) (dstTag : Nat)
    (locals₃ : List LocalSlot) (newVal : Value)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    IsStmtNode
      (commitCopyDstPlaceWrite s dstPlace dstLoc dstTag locals₃ newVal localDecls layouts) :=
  copyWriteDstVal_isStmtNode s locals₃ dstPlace dstLoc dstTag newVal localDecls layouts

theorem commitWriteBytesDstPlaceWrite_pushBaseStack
    (calleeBody : CapturedMir) (s : MachineState) (dstPlace : Place)
    (dstTag : Nat) (locals₃ : List LocalSlot) (newVal : Value)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    commitWriteBytesDstPlaceWrite (MachineState.pushBaseStack calleeBody [] s) dstPlace dstTag
        locals₃ newVal localDecls layouts =
      MirStepNode.pushBaseStack calleeBody []
        (commitWriteBytesDstPlaceWrite s dstPlace dstTag locals₃ newVal localDecls layouts) := by
  unfold commitWriteBytesDstPlaceWrite
  dsimp only [MachineState.pushBaseStack, Memory.pushBaseStack]
  repeat' (first | exact step_push_fail | exact step_push_unsupported | exact step_push_step rfl | split)

theorem commitWriteBytesDstPlaceWrite_isStmtNode
    (s : MachineState) (dstPlace : Place) (dstTag : Nat)
    (locals₃ : List LocalSlot) (newVal : Value)
    (localDecls : List LocalDecl) (layouts : LayoutTable) :
    IsStmtNode
      (commitWriteBytesDstPlaceWrite s dstPlace dstTag locals₃ newVal localDecls layouts) := by
  unfold commitWriteBytesDstPlaceWrite
  dsimp only
  repeat' (first
    | exact Or.inl ⟨_, rfl⟩
    | exact Or.inr (Or.inl ⟨_, rfl⟩)
    | exact Or.inr (Or.inr rfl)
    | split)

/-- With no Tree Borrows entries, a `write_bytes` call never writes: its destination pointer has
no borrow entry, so `writeBytesAction` faults. -/
theorem writeBytesAction_borrows_nil (frameDepth : Nat) (target : ResolvedCallTarget)
    (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable) (argOps : List Operand)
    (argVals : List Value) :
    ∃ fk : FailureKind,
      writeBytesAction [] frameDepth target bodyLocalDecls bodyLayouts argOps argVals =
        .fault fk := by
  unfold writeBytesAction
  dsimp only
  cases argVals with
  | nil => exact ⟨.ub, rfl⟩
  | cons v1 tl1 =>
    cases v1 with
    | ptr dstPtr dstSz =>
      cases tl1 with
      | nil => exact ⟨.ub, rfl⟩
      | cons v2 tl2 =>
        cases v2 with
        | scalar valSc =>
          cases tl2 with
          | nil => exact ⟨.ub, rfl⟩
          | cons v3 tl3 =>
            cases v3 with
            | scalar countSc =>
              cases tl3 with
              | cons _ _ => exact ⟨.ub, rfl⟩
              | nil =>
                dsimp only
                cases Bool.and (Nat.beq dstSz (layoutPointerBytes bodyLayouts))
                    (Bool.and (Nat.beq valSc.sizeBytes 1)
                      (Bool.and (Nat.blt valSc.bits 256)
                        (Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts)))) with
                | false => exact ⟨.ub, rfl⟩
                | true =>
                  have h_elem (elemTy : RigidTy) :
                      ∃ fk : FailureKind,
                        (match
                            intrinsicRigidTyByteSize bodyLocalDecls bodyLayouts elemTy,
                            intrinsicRigidTyAlign bodyLocalDecls bodyLayouts elemTy
                          with
                          | .some elemSize, .some elemAlign =>
                            let byteCount := Nat.mul countSc.bits elemSize
                            match Nat.ble byteCount
                                (Nat.sub (Nat.div (scalarModulus (layoutPointerBytes bodyLayouts)) 2) 1) with
                            | false => WriteBytesAction.fault .ub
                            | true => WriteBytesAction.fault .unsupported
                          | _, _ =>
                            match isUnsizedRigidTy 8 elemTy with
                            | true => WriteBytesAction.fault .ub
                            | false => WriteBytesAction.fault .unsupported) = .fault fk := by
                    cases intrinsicRigidTyByteSize bodyLocalDecls bodyLayouts elemTy with
                    | none => cases isUnsizedRigidTy 8 elemTy <;> exact ⟨_, rfl⟩
                    | some elemSize =>
                      cases intrinsicRigidTyAlign bodyLocalDecls bodyLayouts elemTy with
                      | none => cases isUnsizedRigidTy 8 elemTy <;> exact ⟨_, rfl⟩
                      | some elemAlign =>
                        dsimp only
                        cases Nat.ble (Nat.mul countSc.bits elemSize)
                            (Nat.sub (Nat.div (scalarModulus (layoutPointerBytes bodyLayouts)) 2) 1) <;>
                          exact ⟨_, rfl⟩
                  rcases target with ⟨defPath, _ | ⟨elemTy, _ | _⟩, fnSig, isIndirect⟩
                  · cases argOps with
                    | nil => exact ⟨.unsupported, rfl⟩
                    | cons dstOp _ =>
                      dsimp only
                      cases operandPointeeTy bodyLocalDecls bodyLayouts dstOp with
                      | none => exact ⟨.unsupported, rfl⟩
                      | some pt => exact h_elem pt.kind
                  · exact h_elem elemTy
                  · exact ⟨.unsupported, rfl⟩
            | _ => exact ⟨.ub, rfl⟩
        | _ => exact ⟨.ub, rfl⟩
    | _ => exact ⟨.ub, rfl⟩

/-- Call-form `copy_nonoverlapping` commutes with `MachineState.pushBaseStack` on every
successful (call-free) step. -/
theorem evalCopyNonOverlappingCall_pushBaseStack_of_noCallWP
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (ms : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalCopyNonOverlappingCall ms bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb))
    (h_bor : baseStack = [] ∨ ms.memory.borrows = []) :
    ∃ nextSt : MachineState,
      evalCopyNonOverlappingCall ms bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb = MirStepNode.step nextSt ∧
      evalCopyNonOverlappingCall (MachineState.pushBaseStack calleeBody baseStack ms)
          bodyLocalDecls bodyLayouts argOps argVals locals' destination targetBb =
        MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack nextSt) := by
  unfold evalCopyNonOverlappingCall at h_st ⊢
  rcases argOps with _ | ⟨srcOp, _ | ⟨dstOp, _ | ⟨cntOp, _ | ⟨_, _⟩⟩⟩⟩ <;>
    rcases argVals with
      _ | ⟨srcVal, _ | ⟨dstVal, _ | ⟨_ | countSc | ⟨_, _⟩ | ⟨_, _⟩, _ | ⟨_, _⟩⟩⟩⟩ <;>
    try exact False.elim h_st
  · -- exactly three operands and values, the last a `count` scalar
    dsimp only at h_st ⊢
    cases h_w : Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts) with
    | false => rw [h_w] at h_st; exact False.elim h_st
    | true =>
      rw [h_w] at h_st
      dsimp only at h_st ⊢
      rcases evalCopyNonOverlappingWithCount_isStmtNode ms srcOp dstOp bodyLocalDecls bodyLayouts
          srcVal dstVal countSc.bits locals' with ⟨s', hs'⟩ | ⟨fk, hf⟩ | hu
      · rcases h_bor with rfl | h_nil
        · rw [hs'] at h_st
          rw [evalCopyNonOverlappingWithCount_pushBaseStack, hs']
          exact writeIntrinsicReturn_pushBaseStack_of_noCallWP calleeBody []
            { ms with memory := s'.memory } s'.frame.locals destination targetBb .unit h_st
            (Or.inl rfl)
        · rcases evalCopyNonOverlappingWithCount_borrows_nil ms srcOp dstOp bodyLocalDecls
              bodyLayouts srcVal dstVal countSc.bits locals' h_nil with ⟨h_c, h_eq⟩ | ⟨fk, hf⟩
          · rw [h_eq] at h_st ⊢
            rw [evalCopyNonOverlappingWithCount_eq, h_c]
            exact writeIntrinsicReturn_pushBaseStack_of_noCallWP calleeBody baseStack ms locals'
              destination targetBb .unit h_st (Or.inr h_nil)
          · rw [hf] at h_st; exact False.elim h_st
      · rw [hf] at h_st; exact False.elim h_st
      · rw [hu] at h_st; exact False.elim h_st

/-- Call-form `write_bytes` commutes with `MachineState.pushBaseStack` on every successful
(call-free) step. -/
theorem evalWriteBytesCall_pushBaseStack_of_noCallWP
    (calleeBody : CapturedMir) (baseStack : List SavedCallerFrame)
    (ms : MachineState) (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand) (argVals : List Value)
    (locals' : List LocalSlot) (destination : Place) (targetBb : BasicBlockIdx)
    {Q : MirExecState → Prop} {P : Value → Memory → Prop}
    (h_st :
      evalNodeNoCallWP Q (mirNormalPost P)
        (evalWriteBytesCall ms target bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb))
    (h_bor : baseStack = [] ∨ ms.memory.borrows = []) :
    ∃ nextSt : MachineState,
      evalWriteBytesCall ms target bodyLocalDecls bodyLayouts argOps argVals locals'
          destination targetBb = MirStepNode.step nextSt ∧
      evalWriteBytesCall (MachineState.pushBaseStack calleeBody baseStack ms) target
          bodyLocalDecls bodyLayouts argOps argVals locals' destination targetBb =
        MirStepNode.step (MachineState.pushBaseStack calleeBody baseStack nextSt) := by
  rcases h_bor with rfl | h_nil
  · have h_act :
        writeBytesAction (MachineState.pushBaseStack calleeBody [] ms).memory.borrows
            (length (MachineState.pushBaseStack calleeBody [] ms).memory.callStack) target
            bodyLocalDecls bodyLayouts argOps argVals =
          writeBytesAction ms.memory.borrows (length ms.memory.callStack) target
            bodyLocalDecls bodyLayouts argOps argVals := rfl
    unfold evalWriteBytesCall at h_st ⊢
    rw [h_act]
    cases h_a : writeBytesAction ms.memory.borrows (length ms.memory.callStack) target
        bodyLocalDecls bodyLayouts argOps argVals with
    | fault fk => rw [h_a] at h_st; exact False.elim h_st
    | noWrite =>
      rw [h_a] at h_st
      exact writeIntrinsicReturn_pushBaseStack_of_noCallWP calleeBody [] ms locals' destination
        targetBb .unit h_st (Or.inl rfl)
    | store dstPlace _ dstTag newVal =>
      rw [h_a] at h_st
      dsimp only at h_st ⊢
      rw [commitWriteBytesDstPlaceWrite_pushBaseStack]
      rcases commitWriteBytesDstPlaceWrite_isStmtNode ms dstPlace dstTag locals' newVal
          bodyLocalDecls bodyLayouts with ⟨s', hs'⟩ | ⟨fk, hf⟩ | hu
      · rw [hs'] at h_st ⊢
        exact writeIntrinsicReturn_pushBaseStack_of_noCallWP calleeBody []
          { ms with memory := s'.memory } s'.frame.locals destination targetBb .unit h_st
          (Or.inl rfl)
      · rw [hf] at h_st; exact False.elim h_st
      · rw [hu] at h_st; exact False.elim h_st
  · obtain ⟨fk, h_fk⟩ := writeBytesAction_borrows_nil (length ms.memory.callStack) target
      bodyLocalDecls bodyLayouts argOps argVals
    unfold evalWriteBytesCall at h_st
    rw [h_nil, h_fk] at h_st
    exact False.elim h_st

@[reducible]
def isCoreMemPtrIntrinsicKind : RustIntrinsicKind → Bool
  | .copy | .compareBytes | .rawEq | .typedSwapNonOverlapping
  | .ptrOffsetFrom | .ptrOffsetFromUnsigned | .ptrMask | .blackBox => true
  | _ => false

theorem writeIntrinsicReturnWithProtectors_isStmtNode
    (s : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (locals' : List LocalSlot) (destination : Place)
    (targetOpt : Option BasicBlockIdx) (retVal : Value) :
    IsStmtNode
      (writeIntrinsicReturnWithProtectors s bodyLocalDecls bodyLayouts locals'
        destination targetOpt retVal) := by
  unfold writeIntrinsicReturnWithProtectors
  cases targetOpt with
  | none => exact Or.inr (Or.inl ⟨.ub, rfl⟩)
  | some targetBb =>
    dsimp only
    split
    · exact Or.inr (Or.inl ⟨.ub, rfl⟩)
    · cases writeReturnDestination locals' s.memory destination retVal bodyLocalDecls bodyLayouts with
      | ok _ _ => exact Or.inl ⟨_, rfl⟩
      | ub => exact Or.inr (Or.inl ⟨.ub, rfl⟩)
      | unsupported => exact Or.inr (Or.inr rfl)

theorem writeIntrinsicReturnWithProtectors_none_eq_ub
    (s : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (locals' : List LocalSlot) (destination : Place) (retVal : Value) :
    writeIntrinsicReturnWithProtectors s bodyLocalDecls bodyLayouts locals'
      destination none retVal = MirStepNode.fail .ub :=
  rfl

private theorem intrinsicMissingPointeeStep_isStmtNode
    (ld : List LocalDecl) (ly : LayoutTable) (argOps : List Operand) :
    IsStmtNode (intrinsicMissingPointeeStep ld ly argOps) := by
  unfold intrinsicMissingPointeeStep
  repeat' (first | exact Or.inr (Or.inl ⟨_, rfl⟩) | exact Or.inr (Or.inr rfl) | split)

private theorem intrinsicMissingPointeeStep_fault
    (ld : List LocalDecl) (ly : LayoutTable) (argOps : List Operand) :
    (∃ fk, intrinsicMissingPointeeStep ld ly argOps = MirStepNode.fail fk) ∨
      intrinsicMissingPointeeStep ld ly argOps = MirStepNode.unsupported := by
  unfold intrinsicMissingPointeeStep
  repeat' (first | exact Or.inl ⟨_, rfl⟩ | exact Or.inr rfl | split)

theorem divergingCallReturnStep_fault {node : MirStepNode} (h : IsStmtNode node) :
    (∃ fk, divergingCallReturnStep node = MirStepNode.fail fk) ∨
      divergingCallReturnStep node = MirStepNode.unsupported := by
  rcases h with ⟨_, rfl⟩ | ⟨fk, rfl⟩ | rfl
  · exact Or.inl ⟨.ub, rfl⟩
  · exact Or.inl ⟨fk, rfl⟩
  · exact Or.inr rfl

private theorem writeIntrinsicReturn_isStmtNode
    (s : MachineState) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) (retVal : Value) :
    IsStmtNode (writeIntrinsicReturn s locals' destination targetBb retVal) := by
  unfold writeIntrinsicReturn
  repeat' (first
    | exact Or.inl ⟨_, rfl⟩
    | exact Or.inr (Or.inl ⟨_, rfl⟩)
    | exact Or.inr (Or.inr rfl)
    | split)

private theorem evalNonSelectIntrinsicCall_isStmtNode
    (kind : RustIntrinsicKind) (s : MachineState) (target : ResolvedCallTarget)
    (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) :
    IsStmtNode
      (evalNonSelectIntrinsicCall kind s target bodyLocalDecls bodyLayouts
        argOps argVals locals' destination targetBb) := by
  rcases evalNonSelectIntrinsicCall_cases kind target bodyLocalDecls bodyLayouts
      argOps argVals locals' destination targetBb with ⟨retVal, h_wr⟩ | ⟨fk, h_fl⟩ | h_un
  · rw [h_wr s]; exact writeIntrinsicReturn_isStmtNode s locals' destination targetBb retVal
  · rw [h_fl s]; exact Or.inr (Or.inl ⟨fk, rfl⟩)
  · rw [h_un s]; exact Or.inr (Or.inr rfl)

private theorem finishMemIntrinsicCall_isStmtNode
    (s : MachineState) (node : MirStepNode) (destination : Place) (targetBb : BasicBlockIdx)
    (h : IsStmtNode node) :
    IsStmtNode (finishMemIntrinsicCall s node destination targetBb) := by
  rcases h with ⟨s', rfl⟩ | ⟨fk, rfl⟩ | rfl
  · rw [finishMemIntrinsicCall_step]
    exact writeIntrinsicReturn_isStmtNode _ _ _ _ _
  · exact Or.inr (Or.inl ⟨fk, rfl⟩)
  · exact Or.inr (Or.inr rfl)

private theorem evalCopyNonOverlappingCall_isStmtNode
    (s : MachineState) (bodyLocalDecls : List LocalDecl) (bodyLayouts : LayoutTable)
    (argOps : List Operand) (argVals : List Value) (locals' : List LocalSlot)
    (destination : Place) (targetBb : BasicBlockIdx) :
    IsStmtNode
      (evalCopyNonOverlappingCall s bodyLocalDecls bodyLayouts argOps argVals
        locals' destination targetBb) := by
  unfold evalCopyNonOverlappingCall
  rcases argOps with _ | ⟨srcOp, _ | ⟨dstOp, _ | ⟨_cntOp, _ | _⟩⟩⟩ <;>
    rcases argVals with
      _ | ⟨srcVal, _ | ⟨dstVal, _ | ⟨_ | countSc | _ | _ | _, _ | _⟩⟩⟩ <;>
    try exact Or.inr (Or.inl ⟨.ub, rfl⟩)
  · dsimp only
    cases Nat.beq countSc.sizeBytes (layoutPointerBytes bodyLayouts) with
    | false => exact Or.inr (Or.inl ⟨.ub, rfl⟩)
    | true =>
      exact finishMemIntrinsicCall_isStmtNode _ _ _ _
        (evalCopyNonOverlappingWithCount_isStmtNode _ _ _ _ _ _ _ _ _)

private theorem evalWriteBytesCall_isStmtNode
    (s : MachineState) (target : ResolvedCallTarget) (bodyLocalDecls : List LocalDecl)
    (bodyLayouts : LayoutTable) (argOps : List Operand) (argVals : List Value)
    (locals' : List LocalSlot) (destination : Place) (targetBb : BasicBlockIdx) :
    IsStmtNode
      (evalWriteBytesCall s target bodyLocalDecls bodyLayouts argOps argVals
        locals' destination targetBb) := by
  unfold evalWriteBytesCall
  cases writeBytesAction s.memory.borrows (length s.memory.callStack) target bodyLocalDecls
      bodyLayouts argOps argVals with
  | fault fk => exact Or.inr (Or.inl ⟨fk, rfl⟩)
  | noWrite => exact writeIntrinsicReturn_isStmtNode _ _ _ _ _
  | store _ _ _ _ =>
    exact finishMemIntrinsicCall_isStmtNode _ _ _ _
      (commitWriteBytesDstPlaceWrite_isStmtNode _ _ _ _ _ _ _)

/-- Equality on the three memory tables read by `isBackedPtr` and all pure byte/value codecs & validators. -/
def MemBGFEq (m₁ m₂ : Memory) : Prop :=
  m₁.borrows = m₂.borrows ∧ m₁.globals = m₂.globals ∧ m₁.fnPtrs = m₂.fnPtrs

/-- Equality on all non-callee-context runtime memory fields read by memory/pointer intrinsics. -/
def MemCoreEq (m₁ m₂ : Memory) : Prop :=
  m₁.borrows = m₂.borrows ∧ m₁.globals = m₂.globals ∧ m₁.fnPtrs = m₂.fnPtrs ∧
  m₁.callStack = m₂.callStack ∧ m₁.callerLocals = m₂.callerLocals ∧
  m₁.activeProtectors = m₂.activeProtectors

theorem MemCoreEq.toBGFEq {m₁ m₂ : Memory} (h : MemCoreEq m₁ m₂) : MemBGFEq m₁ m₂ :=
  ⟨h.1, h.2.1, h.2.2.1⟩

theorem MemBGFEq.withBorrows {m₁ m₂ : Memory} (h : MemBGFEq m₁ m₂) (b : List BorrowEntry) :
    MemBGFEq { m₁ with borrows := b } { m₂ with borrows := b } :=
  ⟨rfl, h.2.1, h.2.2⟩

theorem MemCoreEq.withBorrows {m₁ m₂ : Memory} (h : MemCoreEq m₁ m₂) (b : List BorrowEntry) :
    MemCoreEq { m₁ with borrows := b } { m₂ with borrows := b } :=
  ⟨rfl, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2⟩

theorem memBGFEq_pushBaseStack (c : CapturedMir) (b : List SavedCallerFrame) (m : Memory) :
    MemBGFEq (Memory.pushBaseStack c b m) m :=
  ⟨rfl, rfl, rfl⟩

theorem memCoreEq_pushBaseStack_nil (c : CapturedMir) (m : Memory) :
    MemCoreEq (Memory.pushBaseStack c [] m) m :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩

theorem isBackedPtr_congr {m₁ m₂ : Memory} (h : MemBGFEq m₁ m₂) (p : ProvenancePtr) :
    isBackedPtr m₁ p = isBackedPtr m₂ p := by
  unfold isBackedPtr
  rw [h.1, h.2.1, h.2.2]

theorem isNullThinPtr_congr {m₁ m₂ : Memory} (h : MemBGFEq m₁ m₂) (w : Nat) (v : Value) :
    isNullThinPtr m₁ w v = isNullThinPtr m₂ w v := by
  cases v with
  | ptr p sz => unfold isNullThinPtr; dsimp only; rw [isBackedPtr_congr h]
  | _ => rfl

theorem isValidWidePtrMetaValForWidth_congr {m₁ m₂ : Memory} (h : MemBGFEq m₁ m₂)
    (w : Nat) (v : Value) :
    isValidWidePtrMetaValForWidth m₁ w v = isValidWidePtrMetaValForWidth m₂ w v := by
  unfold isValidWidePtrMetaValForWidth
  rw [isNullThinPtr_congr h]

theorem decodeUsizeArg?_congr {m₁ m₂ : Memory} (h : MemBGFEq m₁ m₂) (w : Nat) (v : Value) :
