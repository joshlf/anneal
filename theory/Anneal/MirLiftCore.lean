private theorem evalForeignFrameDerefWrite_ctxAndCB {cs : List SavedCallerFrame}
    (c : CalleeEnv) (ac : Option CapturedMir) (ti : List TraitImplEntry)
    (s : MachineState) (locals₁ : List LocalSlot) (mem₁ : Memory) (dst : Place)
