private theorem evalFnEntryRetag_ctxAndCB
    (c : CalleeEnv) (ac : Option CapturedMir) (ti : List TraitImplEntry)
    (s : MachineState) (localDecls : List LocalDecl) (layouts : LayoutTable)
    (place : Place) (ptrVal : ProvenancePtr) (sz : Nat)
