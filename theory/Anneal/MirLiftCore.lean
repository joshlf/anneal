    ∃ fuel, LiftBlock body 0 env₀ post fuel :=
  dagBlockInduct_of_isCfgDag h_dag BlockInv
    (fun bbIdx env => ∃ fuel, LiftBlock body bbIdx env post fuel)
    h_init h_step

