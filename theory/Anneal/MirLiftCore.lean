  verifyMirNoPanic_of_pureExec c
    (checkPureMir_of_mirLiftReady h_ready)
    (fun args h_pre =>
      let ⟨_, hf⟩ := h_lift args h_pre
      lift_PureMirConverges_of_mirLiftReady h_ready hf)

