      ∃ x : Nat, x < 4294967295 ∧ args = [.scalar { bits := x, sizeBytes := 4 }])
    (extraPost := fun args retVal =>
      ∀ x : Nat,
        args = [.scalar { bits := x, sizeBytes := 4 }] →
