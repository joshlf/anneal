theorem LiftStmtsConverges.mono {body : CapturedMir}
    {bbIdx : BasicBlockIdx} {stmtIdx : Nat} {env : PureEnv}
    {stmts : List Statement} {term : Terminator} {P Q : Value → Prop}
    (h_imp : ∀ v, P v → Q v)
