"""Hardware-matched resource wrapper for `lake`, `lean`, and `cargo` commands.

Probes the host's logical CPU count, physical RAM (`MemTotal` and
`MemAvailable`), and cgroup v2 non-reclaimable working set (`anon + shmem` vs
reclaimable `file` page cache in `memory.stat`) at invocation time, partitions
threads and memory across the active worktree concurrency factor `W`, and
executes the target command inside a fail-fast OS memory boundary (`MemoryMax`
with `MemorySwapMax=0` when `systemd` user scopes are available) and a
wall-clock timeout.

Why this wrapper exists:
- Lean 4's `-M <MB>` flag bounds only the internal small-object allocator and
  does not cap total process RSS, `mmap` regions, or child processes spawned by
  `lake build`.
- On hosts with large swap partitions, an unbounded kernel `whnf` or `dsimp`
  blowup pages tens of gigabytes per minute to disk (`iowait ~90%`) instead of
  failing fast, wedging interactive SSH sessions and background daemons.
- Setting `MemorySwapMax=0` alongside `MemoryMax` derived from physical RAM
  forces the kernel cgroup controller to terminate only the runaway `lean`
  scope immediately (`exit 137`) with zero swap thrashing.
- On Linux cgroup v2 hosts, `memory.current` conflates reclaimable `.olean`
  `file` page cache with true non-reclaimable heap (`anon + shmem`). Budgeting
  cgroup headroom via `memory.max - (anon + shmem)` prevents `.olean` file cache
  from falsely throttling concurrent builds while still throttling when genuine
  anonymous working-set pressure rises.
"""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from typing import Any, Callable, Iterator, Mapping

sys.dont_write_bytecode = True

MIB = 1024 * 1024

_LAKE_VALUE_OPTS: frozenset[str] = frozenset(
    {"-d", "--dir", "-f", "--file", "-K", "--key", "-p", "--packages"}
)
_LAKE_VALUE_EQ_PREFIXES: tuple[str, ...] = (
    "-d=",
    "--dir=",
    "-f=",
    "--file=",
    "-K=",
    "--key=",
    "-p=",
    "--packages=",
)
_LAKE_FLAG_OPTS: frozenset[str] = frozenset(
    {
        "-q",
        "--quiet",
        "-v",
        "--verbose",
        "-R",
        "--reconfigure",
        "-U",
        "--update",
        "--keep-toolchain",
        "--wfail",
        "--old",
        "--offline",
        "--no-build",
    }
)


def _clamp(val: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, val))


def _env_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or not raw.strip():
        return default
    try:
        return int(raw.strip())
    except ValueError:
        return default


def _env_optional_pos_int(name: str) -> int | None:
    raw = os.environ.get(name)
    if raw is None or not raw.strip():
        return None
    try:
        val = int(raw.strip())
        return val if val >= 1 else None
    except ValueError:
        return None


def _has_user_systemd_sock(p: Path) -> bool:
    """True if systemd --user (systemd 255+/260 private/varlink or D-Bus) socket exists."""
    try:
        return any(
            (p / rel).is_socket()
            for rel in ("systemd/private", "systemd/io.systemd.Manager", "bus")
        )
    except OSError:
        return False


def resolve_runtime_base() -> tuple[Path, bool]:
    """Returns (runtime_dir, user_systemd_sock_alive). Always prefers UID-owned /run/user/<uid>."""
    uid = os.getuid()
    run_user = Path(f"/run/user/{uid}")
    if run_user.is_dir() and os.access(run_user, os.W_OK | os.X_OK):
        try:
            if run_user.stat().st_uid == uid:
                return run_user, _has_user_systemd_sock(run_user)
        except OSError:
            pass
    xdg = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if xdg:
        p = Path(xdg)
        if p.is_dir() and os.access(p, os.W_OK | os.X_OK):
            return p, _has_user_systemd_sock(p)
    return Path("/tmp"), False


def _systemd_env(
    runtime_base: Path,
    user_systemd_sock_alive: bool,
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    env = dict(base_env if base_env is not None else os.environ)
    if user_systemd_sock_alive:
        env["XDG_RUNTIME_DIR"] = str(runtime_base)
    return env


def _find_systemctl() -> str | None:
    found = shutil.which("systemctl")
    if found:
        return found
    return "/usr/bin/systemctl" if Path("/usr/bin/systemctl").is_file() else None


def _find_systemd_run() -> str | None:
    found = shutil.which("systemd-run")
    if found:
        return found
    return "/usr/bin/systemd-run" if Path("/usr/bin/systemd-run").is_file() else None


def check_user_systemd_active(
    runtime_base: Path | None = None,
    user_systemd_sock_alive: bool | None = None,
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    uid: int | None = None,
) -> bool:
    """Zero-scope-spam read-only check that `systemd --user` is live with memory delegation."""
    if runtime_base is None or user_systemd_sock_alive is None:
        runtime_base, user_systemd_sock_alive = resolve_runtime_base()
    if not user_systemd_sock_alive:
        return False

    eff_uid = os.getuid() if uid is None else uid
    user_cg = (
        cgroup_root / "user.slice" / f"user-{eff_uid}.slice" / f"user@{eff_uid}.service"
    )
    try:
        if not (user_cg / "cgroup.controllers").is_file():
            return False
        subtree_path = user_cg / "cgroup.subtree_control"
        if not subtree_path.is_file():
            return False
        controllers = subtree_path.read_text(encoding="utf-8", errors="replace").split()
        if "memory" not in controllers:
            return False
    except OSError:
        return False

    systemctl_bin = _find_systemctl()
    if not systemctl_bin:
        return False
    try:
        res = subprocess.run(
            [systemctl_bin, "--user", "show", "-p", "Version", "--value"],
            env=_systemd_env(runtime_base, True),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
            timeout=2.0,
        )
        return res.returncode == 0 and bool(res.stdout.strip())
    except Exception:
        return False


def read_concurrency_config_file(config_path: Path | None = None) -> int | None:
    """Reads optional positive integer concurrency from `$XDG_CONFIG_HOME/anneal/concurrency`."""
    if config_path is None:
        xdg_cfg = os.environ.get("XDG_CONFIG_HOME", "").strip()
        base = Path(xdg_cfg) if xdg_cfg else (Path.home() / ".config")
        config_path = base / "anneal" / "concurrency"
    try:
        if not config_path.is_file():
            return None
        val = int(config_path.read_text(encoding="utf-8", errors="replace").strip())
        return val if val >= 1 else None
    except (OSError, ValueError):
        return None


def _m_safety_host(mem_total_mb: int) -> int:
    return _clamp((8 * mem_total_mb) // 100, 1024, 8192)


def _m_safety_cg(c_mb: int) -> int:
    return _clamp(c_mb // 10, 256, 8192)


def _r_cg(c_mb: int) -> int:
    return c_mb - _m_safety_cg(c_mb)


def _m_cp_floor(c_mb: int, is_shared_user_slice: bool) -> int:
    if not is_shared_user_slice:
        return 0
    r = _r_cg(c_mb)
    return min(10240, max(0, (9 * (r - 7168)) // 10))


def compute_cgroup_working_set_bytes(cg: Path) -> int:
    """Computes W(cg) = anon + shmem + kernel + min(file, active_file + file_dirty + file_writeback)."""
    try:
        if not cg.is_dir():
            return 0
    except OSError:
        return 0
    stat = parse_memory_stat(cg / "memory.stat")
    if stat and any(k in stat for k in ("anon", "shmem", "kernel", "file", "active_file")):
        anon = stat.get("anon", 0)
        shmem = stat.get("shmem", 0)
        kernel = stat.get("kernel", 0)
        file_bytes = stat.get(
            "file", stat.get("active_file", 0) + stat.get("inactive_file", 0)
        )
        active_dirty_wb = (
            stat.get("active_file", 0)
            + stat.get("file_dirty", 0)
            + stat.get("file_writeback", 0)
        )
        return max(0, anon + shmem + kernel + min(file_bytes, active_dirty_wb))
    cur = _read_cgroup_int(cg / "memory.current")
    if cur is not None:
        if "inactive_file" in stat:
            return max(0, cur - stat["inactive_file"])
        return max(0, cur)
    return 0


def read_cgroup_working_set_mib(cg: Path) -> int:
    return compute_cgroup_working_set_bytes(cg) // MIB


def compute_cgroup_nonrecl_bytes(cg: Path) -> int:
    """Computes W_nonrecl(cg) = anon + shmem + slab_unreclaimable (fallback: anon+shmem+kernel)."""
    try:
        if not cg.is_dir():
            return 0
    except OSError:
        return 0
    stat = parse_memory_stat(cg / "memory.stat")
    if not stat:
        return 0
    if "slab_unreclaimable" in stat:
        return max(
            0,
            stat.get("anon", 0) + stat.get("shmem", 0) + stat["slab_unreclaimable"],
        )
    if any(k in stat for k in ("anon", "shmem", "kernel")):
        return max(
            0, stat.get("anon", 0) + stat.get("shmem", 0) + stat.get("kernel", 0)
        )
    return 0


def read_cgroup_nonrecl_mib(cg: Path) -> int:
    return compute_cgroup_nonrecl_bytes(cg) // MIB


def read_cgroup_ceiling_mib(cg: Path) -> int | None:
    """Returns min(finite(memory.high), finite(memory.max)) in MiB, or None if unbounded."""
    hi = _read_cgroup_int(cg / "memory.high")
    mx = _read_cgroup_int(cg / "memory.max")
    vals = [v for v in (hi, mx) if v is not None]
    if not vals:
        return None
    return min(vals) // MIB


def read_events_local_high(cg: Path) -> int:
    """Reads `high` counter from `cg/memory.events.local` (returns 0 on missing/error)."""
    p = cg / "memory.events.local"
    try:
        if not p.is_file():
            return 0
        for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.strip().split()
            if len(parts) == 2 and parts[0] == "high":
                return max(0, int(parts[1]))
    except (OSError, ValueError):
        pass
    return 0


def _read_memory_events_oom_kill(cg: Path) -> int:
    """Best-effort read of `oom_kill` from `cg/memory.events`."""
    p = cg / "memory.events"
    try:
        if not p.is_file():
            return 0
        for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.strip().split()
            if len(parts) == 2 and parts[0] == "oom_kill":
                return max(0, int(parts[1]))
    except (OSError, ValueError):
        pass
    return 0


def read_psi_full_avg10(cg: Path) -> float:
    """Reads `full avg10=<val>` from `cg/memory.pressure` (returns 0.0 on missing/error)."""
    p = cg / "memory.pressure"
    try:
        if not p.is_file():
            return 0.0
        for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line.startswith("full "):
                continue
            for tok in line.split()[1:]:
                if tok.startswith("avg10="):
                    return float(tok.split("=", 1)[1])
    except (OSError, ValueError):
        pass
    return 0.0


def count_active_build_slots(
    runtime_base: Path, uid: int | None = None
) -> int:
    """Counts currently held `slot-*.lock` files in `runtime_base/anneal-build-slots-<uid>`."""
    eff_uid = os.getuid() if uid is None else uid
    slot_dir = runtime_base / f"anneal-build-slots-{eff_uid}"
    try:
        if not slot_dir.is_dir():
            return 0
        lock_files = sorted(slot_dir.glob("slot-*.lock"))
    except OSError:
        return 0
    active = 0
    for lf in lock_files:
        fd: int | None = None
        try:
            fd = os.open(str(lf), os.O_RDONLY)
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                try:
                    fcntl.flock(fd, fcntl.LOCK_UN)
                except OSError:
                    pass
            except BlockingIOError:
                active += 1
        except OSError:
            continue
        finally:
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
    return active


def parse_proc_cgroup_v2(
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> str | None:
    """Parses `/proc/self/cgroup` for the unified hierarchy `0::<rel_path>` line."""
    try:
        if not proc_cgroup_path.is_file():
            return None
        raw = proc_cgroup_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None

    for line in raw.splitlines():
        line = line.strip()
        if not line.startswith("0::"):
            continue
        rel = line.split("::", 1)[1].strip()
        if rel.endswith(" (deleted)"):
            rel = rel[: -len(" (deleted)")].strip()
        if not rel or rel == "/":
            return "/"
        return "/" + rel.lstrip("/")
    return None


def parse_memory_stat(source: str | Path) -> dict[str, int]:
    """Parses cgroup v2 `memory.stat` key-value integer pairs (in bytes)."""
    raw: str
    if isinstance(source, Path):
        try:
            raw = source.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return {}
    elif isinstance(source, str):
        if "\n" not in source and " " not in source and source.strip():
            p = Path(source)
            try:
                if p.is_file():
                    raw = p.read_text(encoding="utf-8", errors="replace")
                else:
                    raw = source
            except OSError:
                raw = source
        else:
            raw = source
    else:
        return {}

    stats: dict[str, int] = {}
    for line in raw.splitlines():
        parts = line.strip().split()
        if len(parts) != 2:
            continue
        key, val_str = parts
        try:
            val = int(val_str)
        except ValueError:
            continue
        if val >= 0:
            stats[key] = val
    return stats


def _read_cgroup_int(path: Path) -> int | None:
    """Reads a finite non-negative integer from a cgroup file, or None for 'max'/missing."""
    try:
        if not path.is_file():
            return None
        raw = path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return None
    if not raw or raw == "max":
        return None
    first = raw.split()[0]
    try:
        val = int(first)
    except ValueError:
        return None
    return val if val >= 0 else None


def _empty_cgroup_info() -> dict[str, Any]:
    return {
        "cgroup_v2": False,
        "cgroup_path": None,
        "cgroup_anon_mib": None,
        "cgroup_shmem_mib": None,
        "cgroup_anon_shmem_mib": None,
        "cgroup_file_cache_mib": None,
        "cgroup_current_mib": None,
        "cgroup_memory_max_mib": None,
        "cgroup_avail_mib": None,
    }


def _has_cgroup_memory_files(directory: Path) -> bool:
    try:
        if not directory.is_dir():
            return False
        return any(
            (directory / name).is_file()
            for name in ("memory.stat", "memory.current", "memory.max")
        )
    except OSError:
        return False


def probe_cgroup_v2_memory(
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> dict[str, Any]:
    """Probes cgroup v2 `memory.stat` (`anon + shmem` vs `file`) and ancestor `memory.max`.

    Never raises: this runs on every `anneal-lean-run` invocation (and inside
    the timeout/OOM diagnostic paths), so any unexpected error (e.g. an
    `EACCES` from `Path.is_file()` on older Pythons) degrades to
    `cgroup_v2 = False` instead of aborting the wrapped command.
    """
    try:
        return _probe_cgroup_v2_memory_impl(cgroup_root, proc_cgroup_path)
    except Exception:  # noqa: BLE001 - telemetry must never break execution
        return _empty_cgroup_info()


def _probe_cgroup_v2_memory_impl(
    cgroup_root: Path,
    proc_cgroup_path: Path,
) -> dict[str, Any]:
    try:
        if not cgroup_root.is_dir():
            return _empty_cgroup_info()
    except OSError:
        return _empty_cgroup_info()

    rel_path: str | None = None
    try:
        proc_exists = proc_cgroup_path.is_file()
    except OSError:
        proc_exists = False

    if proc_exists:
        rel_path = parse_proc_cgroup_v2(proc_cgroup_path)
        if rel_path is None:
            return _empty_cgroup_info()
    else:
        # Allow unit tests that pass a custom `cgroup_root` without overriding
        # `proc_cgroup_path` on non-Linux hosts to probe `cgroup_root` directly.
        if (
            proc_cgroup_path == Path("/proc/self/cgroup")
            and cgroup_root != Path("/sys/fs/cgroup")
            and _has_cgroup_memory_files(cgroup_root)
        ):
            rel_path = "/"
        else:
            return _empty_cgroup_info()

    rel_clean = rel_path.lstrip("/")
    rel_parts = [p for p in Path(rel_clean).parts if p not in ("", ".")]
    if ".." in rel_parts:
        return _empty_cgroup_info()

    candidate = cgroup_root.joinpath(*rel_parts) if rel_parts else cgroup_root
    try:
        candidate_is_dir = candidate.is_dir()
    except OSError:
        candidate_is_dir = False

    if candidate_is_dir and (
        _has_cgroup_memory_files(candidate)
        or (candidate / "cgroup.controllers").is_file()
        or (candidate / "cgroup.procs").is_file()
    ):
        leaf_dir = candidate
        resolved_cgroup_path = "/" + "/".join(rel_parts) if rel_parts else "/"
    elif rel_parts and _has_cgroup_memory_files(cgroup_root):
        # Container namespace where `/proc/self/cgroup` reports a host-relative
        # path while `/sys/fs/cgroup` is already mounted at the container leaf
        # (or a unit test populating `cgroup_root` directly).
        leaf_dir = cgroup_root
        resolved_cgroup_path = "/"
    else:
        return _empty_cgroup_info()

    try:
        root_res = cgroup_root.resolve()
        curr_res = leaf_dir.resolve()
    except OSError:
        return _empty_cgroup_info()

    if curr_res != root_res and root_res not in curr_res.parents:
        return _empty_cgroup_info()

    levels: list[Path] = []
    curr = curr_res
    while True:
        levels.append(curr)
        if curr == root_res or curr.parent == curr:
            break
        curr = curr.parent

    if not any(_has_cgroup_memory_files(lvl) for lvl in levels):
        return _empty_cgroup_info()

    leaf_stat: dict[str, int] = {}
    for lvl in levels:
        stat_file = lvl / "memory.stat"
        if stat_file.is_file():
            parsed = parse_memory_stat(stat_file)
            if parsed:
                leaf_stat = parsed
                break

    leaf_anon_shmem_bytes: int | None = None
    cgroup_anon_mib: int | None = None
    cgroup_shmem_mib: int | None = None
    cgroup_anon_shmem_mib: int | None = None
    cgroup_file_cache_mib: int | None = None

    if leaf_stat:
        anon_bytes = leaf_stat.get("anon", 0)
        shmem_bytes = leaf_stat.get("shmem", 0)
        file_bytes = leaf_stat.get(
            "file",
            leaf_stat.get("inactive_file", 0) + leaf_stat.get("active_file", 0),
        )
        leaf_anon_shmem_bytes = anon_bytes + shmem_bytes
        cgroup_anon_mib = anon_bytes // MIB
        cgroup_shmem_mib = shmem_bytes // MIB
        cgroup_anon_shmem_mib = leaf_anon_shmem_bytes // MIB
        cgroup_file_cache_mib = file_bytes // MIB

    leaf_current_bytes: int | None = None
    for lvl in levels:
        cur_val = _read_cgroup_int(lvl / "memory.current")
        if cur_val is not None:
            leaf_current_bytes = cur_val
            break
    cgroup_current_mib = (
        (leaf_current_bytes // MIB) if leaf_current_bytes is not None else None
    )

    min_max_mib: int | None = None
    min_avail_mib: int | None = None

    for lvl in levels:
        lvl_max_bytes = _read_cgroup_int(lvl / "memory.max")
        if lvl_max_bytes is None or lvl_max_bytes <= 0:
            continue
        lvl_cur_bytes = _read_cgroup_int(lvl / "memory.current")
        lvl_stat_path = lvl / "memory.stat"
        lvl_stat = parse_memory_stat(lvl_stat_path) if lvl_stat_path.is_file() else {}

        if "anon" in lvl_stat or "shmem" in lvl_stat:
            lvl_used_bytes = lvl_stat.get("anon", 0) + lvl_stat.get("shmem", 0)
        elif "inactive_file" in lvl_stat and lvl_cur_bytes is not None:
            lvl_used_bytes = max(0, lvl_cur_bytes - lvl_stat["inactive_file"])
        elif lvl_cur_bytes is not None:
            lvl_used_bytes = lvl_cur_bytes
        elif leaf_anon_shmem_bytes is not None:
            lvl_used_bytes = leaf_anon_shmem_bytes
        else:
            lvl_used_bytes = 0

        lvl_avail_bytes = max(0, lvl_max_bytes - lvl_used_bytes)
        lvl_max_mib = lvl_max_bytes // MIB
        lvl_avail_mib = lvl_avail_bytes // MIB

        if min_max_mib is None or lvl_max_mib < min_max_mib:
            min_max_mib = lvl_max_mib
        if min_avail_mib is None or lvl_avail_mib < min_avail_mib:
            min_avail_mib = lvl_avail_mib

    return {
        "cgroup_v2": True,
        "cgroup_path": resolved_cgroup_path,
        "cgroup_anon_mib": cgroup_anon_mib,
        "cgroup_shmem_mib": cgroup_shmem_mib,
        "cgroup_anon_shmem_mib": cgroup_anon_shmem_mib,
        "cgroup_file_cache_mib": cgroup_file_cache_mib,
        "cgroup_current_mib": cgroup_current_mib,
        "cgroup_memory_max_mib": min_max_mib,
        "cgroup_avail_mib": min_avail_mib,
    }


probe_cgroup_v2 = probe_cgroup_v2_memory


def _read_raw_meminfo_and_cpus(
    meminfo_path: Path = Path("/proc/meminfo"),
) -> tuple[int, int, int]:
    """Returns raw `(cpu_cores, mem_total_mb, mem_avail_mb)` without cgroup clamping."""
    cpu_cores = max(1, os.cpu_count() or 4)
    mem_total_mb = 16384
    mem_avail_mb = 12288

    if meminfo_path.is_file():
        try:
            raw = meminfo_path.read_text(encoding="utf-8", errors="replace")
            kv: dict[str, int] = {}
            for line in raw.splitlines():
                parts = line.split(":")
                if len(parts) != 2:
                    continue
                key = parts[0].strip()
                val_parts = parts[1].strip().split()
                if val_parts and val_parts[0].isdigit():
                    kv[key] = int(val_parts[0]) // 1024
            if "MemTotal" in kv and kv["MemTotal"] > 0:
                mem_total_mb = kv["MemTotal"]
            if "MemAvailable" in kv and kv["MemAvailable"] >= 0:
                mem_avail_mb = kv["MemAvailable"]
            elif "MemFree" in kv:
                mem_avail_mb = kv["MemFree"] + kv.get("Cached", 0)
        except OSError:
            pass
    elif sys.platform == "darwin" and meminfo_path == Path("/proc/meminfo"):
        try:
            res = subprocess.run(
                ["sysctl", "-n", "hw.memsize"],
                capture_output=True,
                text=True,
                check=False,
                timeout=2.0,
            )
            if res.returncode == 0 and res.stdout.strip().isdigit():
                mem_total_mb = max(1, int(res.stdout.strip()) // MIB)
                mem_avail_mb = (75 * mem_total_mb) // 100
        except Exception:
            pass

    mem_total_mb = max(1, mem_total_mb)
    mem_avail_mb = max(0, min(mem_total_mb, mem_avail_mb))
    return cpu_cores, mem_total_mb, mem_avail_mb


def probe_host_hardware(
    meminfo_path: Path = Path("/proc/meminfo"),
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> dict[str, Any]:
    """Returns raw host logical CPU count, physical memory in MiB, and cgroup v2 stats."""
    cpu_cores, mem_total_mb, mem_avail_mb = _read_raw_meminfo_and_cpus(meminfo_path)
    cg = probe_cgroup_v2_memory(
        cgroup_root=cgroup_root, proc_cgroup_path=proc_cgroup_path
    )
    return {
        "cpu_cores": cpu_cores,
        "mem_total_mb": mem_total_mb,
        "mem_avail_mb": mem_avail_mb,
        **cg,
    }


def _resolve_target_cgroup_ancestors(
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
    user_systemd_active: bool = False,
    uid: int | None = None,
) -> tuple[Path | None, list[dict[str, Any]], bool, bool, int, int, int, str | None]:
    """Resolves `T_cg` and ancestor chain for `WorkloadMemoryEnvelope`.

    Returns `(t_cg, ancestors, eff_user_systemd_active, t_cg_is_user_service,
              w_cg_mb, w_cg_nonrecl_mb, l_ws_mb, w_cg_path_str)`.
    """
    eff_uid = os.getuid() if uid is None else uid
    try:
        if not cgroup_root.is_dir():
            return None, [], False, False, 0, 0, 0, None
        root_res = cgroup_root.resolve()
    except OSError:
        return None, [], False, False, 0, 0, 0, None

    t_cg: Path | None = None
    eff_systemd_active = False
    t_cg_is_user_service = False

    user_cg = (
        cgroup_root / "user.slice" / f"user-{eff_uid}.slice" / f"user@{eff_uid}.service"
    )
    if user_systemd_active:
        try:
            if user_cg.is_dir():
                t_cg = user_cg.resolve()
                eff_systemd_active = True
                t_cg_is_user_service = True
        except OSError:
            t_cg = None

    if t_cg is None:
        rel_path: str | None = None
        try:
            proc_exists = proc_cgroup_path.is_file()
        except OSError:
            proc_exists = False
        if proc_exists:
            rel_path = parse_proc_cgroup_v2(proc_cgroup_path)
        elif (
            proc_cgroup_path == Path("/proc/self/cgroup")
            and cgroup_root != Path("/sys/fs/cgroup")
            and _has_cgroup_memory_files(cgroup_root)
        ):
            rel_path = "/"

        if rel_path is not None:
            rel_clean = rel_path.lstrip("/")
            rel_parts = [p for p in Path(rel_clean).parts if p not in ("", ".")]
            if ".." not in rel_parts:
                cand = cgroup_root.joinpath(*rel_parts) if rel_parts else cgroup_root
                try:
                    cand_ok = cand.is_dir() and (
                        _has_cgroup_memory_files(cand)
                        or (cand / "cgroup.controllers").is_file()
                        or (cand / "cgroup.procs").is_file()
                    )
                except OSError:
                    cand_ok = False
                if cand_ok:
                    leaf = cand
                elif rel_parts and _has_cgroup_memory_files(cgroup_root):
                    leaf = cgroup_root
                else:
                    leaf = None
                if leaf is not None:
                    try:
                        leaf_res = leaf.resolve()
                        if leaf_res == root_res or root_res in leaf_res.parents:
                            t_cg = leaf_res
                    except OSError:
                        t_cg = None

    if t_cg is None:
        return None, [], False, False, 0, 0, 0, None

    levels: list[Path] = []
    curr = t_cg
    while True:
        levels.append(curr)
        if curr == root_res or curr.parent == curr:
            break
        curr = curr.parent

    shared_names = ("user.slice", f"user-{eff_uid}.slice", f"user@{eff_uid}.service")
    ancestors: list[dict[str, Any]] = []
    for lvl in levels:
        ancestors.append(
            {
                "path": str(lvl),
                "name": lvl.name,
                "c_high_mb": read_cgroup_ceiling_mib(lvl),
                "w_mb": read_cgroup_working_set_mib(lvl),
                "is_shared_user_slice": eff_systemd_active and (lvl.name in shared_names),
            }
        )

    w_cg = t_cg / "anneal.slice" / "anneal-workloads.slice"
    w_cg_path_str = str(w_cg)
    w_cg_mb = 0
    w_cg_nonrecl_mb = 0
    l_ws_mb = 0
    try:
        if w_cg.is_dir():
            w_cg_mb = read_cgroup_working_set_mib(w_cg)
            w_cg_nonrecl_mb = read_cgroup_nonrecl_mib(w_cg)
            l_bytes = 0
            for scope_dir in w_cg.glob("anneal-lsp-daemon-*.scope"):
                if scope_dir.is_dir():
                    l_bytes += compute_cgroup_working_set_bytes(scope_dir)
            l_ws_mb = l_bytes // MIB
    except OSError:
        pass

    return (
        t_cg,
        ancestors,
        eff_systemd_active,
        t_cg_is_user_service,
        w_cg_mb,
        w_cg_nonrecl_mb,
        l_ws_mb,
        w_cg_path_str,
    )


def resolve_effective_concurrency(
    *,
    is_cg_capped: bool,
    s_heavy_safe: int,
    w_file: int | None,
    cli_concurrency: int | None,
    env_concurrency: int | None,
    exclusive: bool = False,
    is_probe: bool = False,
) -> tuple[int, int]:
    """Resolves `(w_eff, build_slots)` with heterogeneous-safe host-bounded precedence.

    `build_slots` is the number of host build locks and never depends on `is_probe`.
    `w_eff` divides the memory pool. Execution raises it to at least the host's
    concurrency file (`w_file`); `--probe` with an explicit `--concurrency` instead
    answers "what if" for exactly that concurrency, so it can report `w_eff <
    build_slots` and a larger `memory_max_mb` than execution gets. A caller that wants
    the execution plan re-probes with `--concurrency <build_slots>`
    (`scripts/run_nightly_verification_suite.py`). `--exclusive` holds every slot and
    resolves `w_eff = 1` in both.
    """
    s_safe = max(1, int(s_heavy_safe))
    if cli_concurrency is not None:
        w_req = max(1, int(cli_concurrency))
    elif env_concurrency is not None:
        w_req = max(1, int(env_concurrency))
    else:
        w_req = max(1, int(w_file)) if w_file is not None else 1

    if is_probe and cli_concurrency is not None:
        w_eff = 1 if exclusive else (min(w_req, s_safe) if is_cg_capped else w_req)
        if w_file is not None:
            w_host = min(max(1, int(w_file)), s_safe) if is_cg_capped else max(1, int(w_file))
            build_slots = w_host
        else:
            build_slots = min(w_req, s_safe) if is_cg_capped else w_req
        return w_eff, build_slots

    if w_file is not None:
        w_host = min(max(1, int(w_file)), s_safe) if is_cg_capped else max(1, int(w_file))
        build_slots = w_host
        if exclusive:
            w_eff = 1
        else:
            w_eff = min(max(w_req, w_host), s_safe) if is_cg_capped else max(w_req, w_host)
        return w_eff, build_slots

    w_unconf = min(w_req, s_safe) if is_cg_capped else w_req
    build_slots = w_unconf
    w_eff = 1 if exclusive else w_unconf
    return w_eff, build_slots


def compute_workload_memory_envelope(
    *,
    cpu_cores: int,
    mem_total_mb: int,
    mem_avail_mb: int,
    ancestors: list[dict[str, Any]] | None = None,
    w_cg_mb: int = 0,
    w_cg_nonrecl_mb: int = 0,
    l_ws_mb: int = 0,
    user_systemd_active: bool = False,
    lsp_pinned: bool = False,
    w_file: int | None = None,
    cli_concurrency: int | None = None,
    env_concurrency: int | None = None,
    exclusive: bool = False,
    is_probe: bool = False,
    mode: str = "build",
    override_mem_mb: int | None = None,
    override_timeout_sec: int | None = None,
    unsafe_ignore_cgroup: bool = False,
    runtime_base: str = "/tmp",
    w_cg_path: str | None = None,
    t_cg_path: str | None = None,
    t_cg_is_user_service: bool = False,
    active_build_slots: int = 0,
) -> dict[str, Any]:
    """Pure 1-MiB-monotonic two-regime `WorkloadMemoryEnvelope` computation."""
    eff_cores = max(1, int(cpu_cores))
    eff_total = max(1, int(mem_total_mb))
    eff_avail = max(0, min(eff_total, int(mem_avail_mb)))
    eff_w_cg = max(0, int(w_cg_mb))
    eff_w_cg_nonrecl = max(0, int(w_cg_nonrecl_mb))
    eff_l_ws = max(0, int(l_ws_mb))
    anc_list = list(ancestors or [])

    capped_ancestors: list[dict[str, Any]] = []
    a_lim: dict[str, Any] | None = None
    min_c_high = eff_total
    for anc in anc_list:
        c_a = anc.get("c_high_mb")
        if isinstance(c_a, int) and c_a < eff_total:
            capped_ancestors.append(anc)
            # On exact ties walking leaf->root, prefer the broader/outer ancestor.
            if c_a <= min_c_high:
                min_c_high = c_a
                a_lim = anc

    is_cg_capped = bool(capped_ancestors and a_lim is not None)
    c_high_mb = min_c_high if is_cg_capped else eff_total
    a_lim_path = str(a_lim["path"]) if (is_cg_capped and a_lim is not None) else None

    m_safety_host = _m_safety_host(eff_total)
    w_host_live = eff_avail + eff_w_cg_nonrecl - m_safety_host
    uncapped_slice_max = (3 * eff_total) // 4

    if is_cg_capped:
        static_caps: list[int] = []
        cg_live_vals: list[int] = []
        for anc in capped_ancestors:
            c_a = int(anc["c_high_mb"])
            is_shared = bool(anc.get("is_shared_user_slice", False))
            r_a = _r_cg(c_a)
            m_cp_a = _m_cp_floor(c_a, is_shared)
            static_caps.append(max(0, r_a - m_cp_a))
            b_non_wl_a = max(0, int(anc.get("w_mb", 0)) - eff_w_cg)
            cg_live_vals.append(r_a - max(m_cp_a, b_non_wl_a))
        w_slice_max_mb = min(uncapped_slice_max, min(static_caps))
        w_slice_high_mb = (94 * w_slice_max_mb) // 100
        w_cg_live_mb: int | None = min(cg_live_vals)
        w_live_mb = max(0, min(w_slice_max_mb, w_cg_live_mb, w_host_live))
        m_safety_mb = _m_safety_cg(c_high_mb)
    else:
        w_slice_max_mb = uncapped_slice_max
        w_slice_high_mb = (94 * w_slice_max_mb) // 100
        w_cg_live_mb = None
        w_live_mb = max(0, min(w_slice_max_mb, w_host_live))
        m_safety_mb = m_safety_host

    w_non_lsp_mb = max(0, eff_w_cg - eff_l_ws)
    usable_mem_mb = max(
        0, w_live_mb - (eff_w_cg if lsp_pinned else w_non_lsp_mb)
    )
    usable_workload_mem_gb = usable_mem_mb // 1024

    s_heavy_safe = min(
        max(1, eff_cores // 8),
        max(1, w_slice_max_mb // 12288),
    )

    w_eff, build_slots = resolve_effective_concurrency(
        is_cg_capped=is_cg_capped,
        s_heavy_safe=s_heavy_safe,
        w_file=w_file,
        cli_concurrency=cli_concurrency,
        env_concurrency=env_concurrency,
        exclusive=exclusive,
        is_probe=is_probe,
    )

    b_evict_pool = max(0, w_live_mb - (eff_l_ws if lsp_pinned else 0))
    b_evict_free = max(0, w_live_mb - (eff_w_cg if lsp_pinned else w_non_lsp_mb))
    b_max_evict_mb = min(
        ((90 * b_evict_pool) // 100) // w_eff,
        (90 * b_evict_free) // 100,
    )
    single_build_budget_gb = round(b_max_evict_mb / 1024.0, 2)

    l_max_mb = min(
        w_slice_high_mb,
        _clamp((55 * w_slice_max_mb) // 100, 2048, 32768),
    )
    max_lean_workers = (
        1
        if w_slice_max_mb < 16384
        else min(4, max(2, w_slice_max_mb // 12288))
    )
    max_rust_workers = 1 if w_slice_max_mb < 24576 else 2
    idle_ttl_seconds = 300 if w_slice_max_mb < 16384 else 900

    b_avail_pool = max(0, w_live_mb - eff_l_ws)
    b_avail_free = max(0, w_live_mb - eff_w_cg)
    term1 = ((90 * b_avail_pool) // 100) // w_eff
    term2 = (90 * b_avail_free) // 100
    if mode == "file":
        file_ceiling = min((50 * w_slice_max_mb) // 100, 16384)
        computed_b_max_mb = min(term1, term2, file_ceiling)
        default_timeout = 180
    else:
        computed_b_max_mb = min(term1, term2)
        default_timeout = 900

    if override_mem_mb is not None and override_mem_mb > 0:
        if is_cg_capped and not unsafe_ignore_cgroup:
            b_max_mb = min(int(override_mem_mb), w_slice_max_mb)
        else:
            b_max_mb = int(override_mem_mb)
    else:
        b_max_mb = computed_b_max_mb

    lean_m_mb = (75 * b_max_mb) // 100
    timeout_sec = (
        int(override_timeout_sec)
        if (override_timeout_sec is not None and override_timeout_sec > 0)
        else default_timeout
    )

    if is_cg_capped and c_high_mb <= 32768:
        threads = min(max(1, eff_cores // w_eff), max(2, b_max_mb // 1800))
    else:
        threads = max(1, eff_cores // w_eff)

    skip_evict = (
        w_slice_max_mb >= 16384
        and (w_live_mb - eff_w_cg) >= min(14336, (75 * w_live_mb) // 100)
    )

    return {
        # Canonical lowercase snake_case contract keys
        "mem_total_mb": eff_total,
        "mem_avail_mb": eff_avail,
        "user_systemd_active": bool(user_systemd_active),
        "is_cg_capped": is_cg_capped,
        "w_eff": w_eff,
        "runtime_base": str(runtime_base),
        "w_cg_path": w_cg_path,
        "a_lim_path": a_lim_path,
        "c_high_mb": c_high_mb,
        "m_safety_mb": m_safety_mb,
        "w_slice_max_mb": w_slice_max_mb,
        "w_slice_high_mb": w_slice_high_mb,
        "usable_workload_mem_gb": usable_workload_mem_gb,
        "single_build_budget_gb": single_build_budget_gb,
        "s_heavy_safe": s_heavy_safe,
        "l_max_mb": l_max_mb,
        "max_lean_workers": max_lean_workers,
        "max_rust_workers": max_rust_workers,
        "idle_ttl_seconds": idle_ttl_seconds,
        "active_build_slots": max(0, int(active_build_slots)),
        # Execution & backward-compatible fields
        "mode": mode,
        "concurrency": w_eff,
        "cpu_cores": eff_cores,
        "threads": threads,
        "memory_max_mb": b_max_mb,
        "lean_m_mb": lean_m_mb,
        "timeout_sec": timeout_sec,
        "build_slots": build_slots,
        "systemd_user_scope": bool(user_systemd_active),
        "w_live_mb": w_live_mb,
        "w_cg_live_mb": w_cg_live_mb,
        "w_host_live_mb": w_host_live,
        "w_cg_mb": eff_w_cg,
        "w_cg_nonrecl_mb": eff_w_cg_nonrecl,
        "w_non_lsp_mb": w_non_lsp_mb,
        "l_ws_mb": eff_l_ws,
        "b_max_evict_mb": b_max_evict_mb,
        "skip_evict": skip_evict,
        "t_cg_path": t_cg_path,
        "t_cg_is_user_service": bool(t_cg_is_user_service),
        "capped_ancestors": [
            {"path": str(a["path"]), "c_high_mb": int(a["c_high_mb"])}
            for a in capped_ancestors
        ],
    }


def probe_host_envelope(
    *,
    meminfo_path: Path = Path("/proc/meminfo"),
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
    cpu_cores: int | None = None,
    mem_total_mb: int | None = None,
    mem_avail_mb: int | None = None,
    user_systemd_active: bool | None = None,
    runtime_base: Path | None = None,
    user_systemd_sock_alive: bool | None = None,
    uid: int | None = None,
    concurrency_file_path: Path | None = None,
    w_file: int | None = None,
    cli_concurrency: int | None = None,
    env_concurrency: int | None = None,
    exclusive: bool = False,
    is_probe: bool = False,
    mode: str = "build",
    override_mem_mb: int | None = None,
    override_timeout_sec: int | None = None,
    unsafe_ignore_cgroup: bool = False,
    lsp_pinned: bool | None = None,
) -> dict[str, Any]:
    """Probes live host hardware, cgroup v2 ancestry, and `WorkloadMemoryEnvelope`."""
    eff_uid = os.getuid() if uid is None else uid
    if runtime_base is None or user_systemd_sock_alive is None:
        rb, sock_alive = resolve_runtime_base()
        if runtime_base is None:
            runtime_base = rb
        if user_systemd_sock_alive is None:
            user_systemd_sock_alive = sock_alive

    raw_cores, raw_total, raw_avail = _read_raw_meminfo_and_cpus(meminfo_path)
    eff_cores = raw_cores if cpu_cores is None else max(1, int(cpu_cores))
    eff_total = raw_total if mem_total_mb is None else max(1, int(mem_total_mb))
    eff_avail = raw_avail if mem_avail_mb is None else max(0, min(eff_total, int(mem_avail_mb)))

    has_cg_override = (
        cgroup_root != Path("/sys/fs/cgroup")
        or proc_cgroup_path != Path("/proc/self/cgroup")
    )
    if user_systemd_active is None:
        if has_cg_override:
            eff_systemd_req = False
        else:
            eff_systemd_req = check_user_systemd_active(
                runtime_base=runtime_base,
                user_systemd_sock_alive=user_systemd_sock_alive,
                cgroup_root=cgroup_root,
                uid=eff_uid,
            )
    else:
        eff_systemd_req = bool(user_systemd_active)

    (
        t_cg,
        ancestors,
        eff_systemd_active,
        t_cg_is_user_service,
        w_cg_mb,
        w_cg_nonrecl_mb,
        l_ws_mb,
        w_cg_path_str,
    ) = _resolve_target_cgroup_ancestors(
        cgroup_root=cgroup_root,
        proc_cgroup_path=proc_cgroup_path,
        user_systemd_active=eff_systemd_req,
        uid=eff_uid,
    )

    eff_w_file = (
        w_file
        if w_file is not None
        else read_concurrency_config_file(concurrency_file_path)
    )
    eff_env_conc = (
        env_concurrency
        if env_concurrency is not None
        else _env_optional_pos_int("ANNEAL_WORKTREE_CONCURRENCY")
    )
    eff_lsp_pinned = (
        lsp_pinned
        if lsp_pinned is not None
        else (os.environ.get("ANNEAL_LSP_NO_EVICT") == "1")
    )
    active_slots = count_active_build_slots(runtime_base, uid=eff_uid)

    env_dict = compute_workload_memory_envelope(
        cpu_cores=eff_cores,
        mem_total_mb=eff_total,
        mem_avail_mb=eff_avail,
        ancestors=ancestors,
        w_cg_mb=w_cg_mb,
        w_cg_nonrecl_mb=w_cg_nonrecl_mb,
        l_ws_mb=l_ws_mb,
        user_systemd_active=eff_systemd_active,
        lsp_pinned=eff_lsp_pinned,
        w_file=eff_w_file,
        cli_concurrency=cli_concurrency,
        env_concurrency=eff_env_conc,
        exclusive=exclusive,
        is_probe=is_probe,
        mode=mode,
        override_mem_mb=override_mem_mb,
        override_timeout_sec=override_timeout_sec,
        unsafe_ignore_cgroup=unsafe_ignore_cgroup,
        runtime_base=str(runtime_base),
        w_cg_path=w_cg_path_str,
        t_cg_path=str(t_cg) if t_cg is not None else None,
        t_cg_is_user_service=t_cg_is_user_service,
        active_build_slots=active_slots,
    )
    # Include legacy cgroup_v2 telemetry keys for compatibility.
    cg = probe_cgroup_v2_memory(
        cgroup_root=cgroup_root, proc_cgroup_path=proc_cgroup_path
    )
    for k, v in cg.items():
        env_dict.setdefault(k, v)
    return env_dict


def _lake_subcommand_index(cmd: list[str]) -> int | None:
    """Returns index of the Lake subcommand in `cmd`, scanning past global options."""
    if not cmd or Path(cmd[0]).name != "lake":
        return None
    i = 1
    n = len(cmd)
    while i < n:
        arg = cmd[i]
        if arg == "--":
            return None
        if arg.startswith("+") and len(arg) > 1:
            i += 1
            continue
        if arg in _LAKE_VALUE_OPTS:
            i += 2
            continue
        if arg.startswith(_LAKE_VALUE_EQ_PREFIXES):
            i += 1
            continue
        if len(arg) > 2 and arg[:2] in ("-d", "-f", "-K", "-p"):
            i += 1
            continue
        if arg in _LAKE_FLAG_OPTS:
            i += 1
            continue
        if arg.startswith("-"):
            return None
        return i
    return None


def _lake_env_lean_index(cmd: list[str]) -> int | None:
    """Returns index of `lean` in `lake [global-opts] env [--] <*/lean> ...`, or None."""
    sub_idx = _lake_subcommand_index(cmd)
    if sub_idx is None or cmd[sub_idx] != "env":
        return None
    j = sub_idx + 1
    if j < len(cmd) and cmd[j] == "--":
        j += 1
    if j < len(cmd) and Path(cmd[j]).name == "lean":
        return j
    return None


def detect_mode(cmd: list[str], requested_mode: str) -> str:
    """Determines whether `cmd` is a single-file check or a workspace build."""
    if requested_mode in ("file", "build"):
        return requested_mode
    if not cmd:
        return "build"

    exe = Path(cmd[0]).name
    if exe == "lean" and "--run" not in cmd[1:]:
        return "file"
    lean_idx = _lake_env_lean_index(cmd)
    if lean_idx is not None and "--run" not in cmd[lean_idx + 1 :]:
        return "file"
    return "build"


def compute_limits(
    hw: dict[str, Any],
    mode: str,
    concurrency: int | None = None,
    override_mem_mb: int | None = None,
    override_timeout_sec: int | None = None,
    unsafe_ignore_cgroup: bool = False,
) -> dict[str, Any]:
    """Compatibility wrapper computing limits from a hardware/envelope dict."""
    if "w_slice_max_mb" in hw and "single_build_budget_gb" in hw:
        # Already a full WorkloadMemoryEnvelope; recompute if mode/concurrency/overrides differ.
        ancestors: list[dict[str, Any]] = []
        if hw.get("is_cg_capped") and hw.get("a_lim_path"):
            ancestors = [
                {
                    "path": hw["a_lim_path"],
                    "name": Path(hw["a_lim_path"]).name,
                    "c_high_mb": hw["c_high_mb"],
                    "w_mb": hw.get("w_cg_mb", 0),
                    "is_shared_user_slice": bool(hw.get("user_systemd_active", False)),
                }
            ]
        return compute_workload_memory_envelope(
            cpu_cores=int(hw["cpu_cores"]),
            mem_total_mb=int(hw["mem_total_mb"]),
            mem_avail_mb=int(hw["mem_avail_mb"]),
            ancestors=ancestors,
            w_cg_mb=int(hw.get("w_cg_mb", 0)),
            w_cg_nonrecl_mb=int(hw.get("w_cg_nonrecl_mb", 0)),
            l_ws_mb=int(hw.get("l_ws_mb", 0)),
            user_systemd_active=bool(hw.get("user_systemd_active", False)),
            cli_concurrency=concurrency,
            mode=mode,
            override_mem_mb=override_mem_mb,
            override_timeout_sec=override_timeout_sec,
            unsafe_ignore_cgroup=unsafe_ignore_cgroup,
            runtime_base=str(hw.get("runtime_base") or "/tmp"),
            w_cg_path=hw.get("w_cg_path"),
            t_cg_path=hw.get("t_cg_path"),
            t_cg_is_user_service=bool(hw.get("t_cg_is_user_service", False)),
            active_build_slots=int(hw.get("active_build_slots", 0)),
        )

    cg_max_mib = hw.get("cgroup_memory_max_mib")
    ancestors = []
    if isinstance(cg_max_mib, int) and cg_max_mib > 0 and cg_max_mib < int(hw["mem_total_mb"]):
        w_used = hw.get("cgroup_anon_shmem_mib")
        if w_used is None:
            w_used = hw.get("cgroup_current_mib") or 0
        ancestors.append(
            {
                "path": str(hw.get("cgroup_path") or "/"),
                "name": Path(str(hw.get("cgroup_path") or "/")).name or "root",
                "c_high_mb": cg_max_mib,
                "w_mb": int(w_used),
                "is_shared_user_slice": False,
            }
        )
    res = compute_workload_memory_envelope(
        cpu_cores=int(hw["cpu_cores"]),
        mem_total_mb=int(hw["mem_total_mb"]),
        mem_avail_mb=int(hw["mem_avail_mb"]),
        ancestors=ancestors,
        cli_concurrency=concurrency if concurrency is not None else 1,
        mode=mode,
        override_mem_mb=override_mem_mb,
        override_timeout_sec=override_timeout_sec,
        unsafe_ignore_cgroup=unsafe_ignore_cgroup,
    )
    for k in (
        "cgroup_v2",
        "cgroup_path",
        "cgroup_anon_mib",
        "cgroup_shmem_mib",
        "cgroup_anon_shmem_mib",
        "cgroup_file_cache_mib",
        "cgroup_current_mib",
        "cgroup_memory_max_mib",
        "cgroup_avail_mib",
    ):
        res[k] = hw.get(k)
    return res


def format_cgroup_probe_line(limits: dict[str, Any]) -> str:
    """Formats the human-readable `Cgroup v2 Memory` line for `--probe`."""
    if not limits.get("cgroup_v2") and not limits.get("is_cg_capped"):
        return "  Cgroup v2 Memory   : unavailable (using /proc/meminfo)"
    regime = "capped" if limits.get("is_cg_capped") else "uncapped"
    c_high = limits.get("c_high_mb")
    w_smax = limits.get("w_slice_max_mb")
    w_shigh = limits.get("w_slice_high_mb")
    w_live = limits.get("w_live_mb")
    a_lim = limits.get("a_lim_path") or "none"
    return (
        f"  Cgroup v2 Envelope : regime={regime}, C_high={c_high} MiB ({a_lim}), "
        f"W_slice_max={w_smax} MiB, W_slice_high={w_shigh} MiB, W_live={w_live} MiB"
    )


def format_cgroup_diagnostic_snapshot(
    cg: dict[str, Any] | None = None,
    pid: int | None = None,
) -> str:
    """Formats a post-mortem cgroup v2 memory snapshot for timeout/OOM stderr diagnostics."""
    try:
        info = cg
        if info is None and pid is not None and pid > 0:
            pid_cg = Path(f"/proc/{pid}/cgroup")
            if pid_cg.is_file():
                cand = probe_cgroup_v2_memory(proc_cgroup_path=pid_cg)
                if cand.get("cgroup_v2"):
                    info = cand
        if info is None:
            info = probe_cgroup_v2_memory()
        if not info.get("cgroup_v2"):
            return ""
        anon_shmem = info.get("cgroup_anon_shmem_mib")
        file_cache = info.get("cgroup_file_cache_mib")
        current = info.get("cgroup_current_mib")
        cg_max = info.get("cgroup_memory_max_mib")
        cg_avail = info.get("cgroup_avail_mib")
        max_str = (
            f"{cg_max}M (avail={cg_avail}M)" if cg_max is not None else "unbounded"
        )
        return (
            f"  Cgroup v2 Snapshot : anon+shmem={anon_shmem}M, "
            f"file={file_cache}M, current={current}M, memory.max={max_str}\n"
        )
    except Exception:  # noqa: BLE001 - diagnostics must never mask exit codes
        return ""


def systemd_user_scope_available() -> bool:
    """Zero-scope-spam check returning True if `systemd --user` with memory delegation is live."""
    return check_user_systemd_active()


def _workloads_slice_unit_path() -> Path:
    xdg_cfg = os.environ.get("XDG_CONFIG_HOME", "").strip()
    base = Path(xdg_cfg) if xdg_cfg else (Path.home() / ".config")
    return base / "systemd" / "user" / "anneal-workloads.slice"


def render_workloads_slice_unit(w_slice_high_mb: int, w_slice_max_mb: int) -> str:
    """Renders the static `anneal-workloads.slice` systemd user unit."""
    return (
        "[Unit]\n"
        "Description=Anneal Bounded Compute & Warm LSP Workloads Slice\n"
        "\n"
        "[Slice]\n"
        "MemoryAccounting=yes\n"
        f"MemoryHigh={int(w_slice_high_mb)}M\n"
        f"MemoryMax={int(w_slice_max_mb)}M\n"
        "MemorySwapMax=0\n"
        "ManagedOOMMemoryPressure=kill\n"
        "ManagedOOMMemoryPressureLimit=40%\n"
    )


def ensure_workloads_slice(
    env_info: dict[str, Any],
    *,
    unit_path: Path | None = None,
    reload_systemd: bool = True,
) -> tuple[bool, bool, str]:
    """Single-writer `anneal-workloads.slice` reconciler.

    Gated STRICTLY on `user_systemd_active is True` AND `T_cg == user@<uid>.service`.
    Content-diffs before writing and running `systemctl --user daemon-reload`.
    Returns `(ok, changed, message)`.
    """
    if not env_info.get("user_systemd_active") or not env_info.get("t_cg_is_user_service"):
        return (
            False,
            False,
            "Refusing to write anneal-workloads.slice: user_systemd_active is False "
            "or target execution cgroup is not user@<uid>.service.",
        )

    target = unit_path if unit_path is not None else _workloads_slice_unit_path()
    rendered = render_workloads_slice_unit(
        int(env_info["w_slice_high_mb"]), int(env_info["w_slice_max_mb"])
    )
    try:
        if target.is_file():
            existing = target.read_text(encoding="utf-8", errors="replace")
            if existing == rendered:
                return (True, False, f"{target} is already up to date.")
    except OSError:
        pass

    tmp_path: str | None = None
    try:
        target.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(
            prefix=".anneal-workloads.slice.", dir=str(target.parent)
        )
        try:
            os.write(fd, rendered.encode("utf-8"))
        finally:
            os.close(fd)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, str(target))
        tmp_path = None
    except OSError as exc:
        if tmp_path:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        return (False, False, f"Failed writing {target}: {exc}")

    if reload_systemd:
        systemctl_bin = _find_systemctl()
        if not systemctl_bin:
            return (False, True, f"Wrote {target} but `systemctl` binary is missing.")
        runtime_base = Path(str(env_info.get("runtime_base") or "/tmp"))
        try:
            res = subprocess.run(
                [systemctl_bin, "--user", "daemon-reload"],
                env=_systemd_env(runtime_base, True),
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                check=False,
                timeout=5.0,
            )
            if res.returncode != 0:
                detail = res.stderr.strip() or res.stdout.strip() or f"exit {res.returncode}"
                return (False, True, f"Wrote {target} but daemon-reload failed: {detail}")
        except Exception as exc:
            return (False, True, f"Wrote {target} but daemon-reload errored: {exc}")

    return (True, True, f"Updated {target} and reloaded user systemd.")


@contextmanager
def acquire_build_slot(
    max_slots: int,
    timeout_sec: float,
    enabled: bool,
    *,
    exclusive: bool = False,
    runtime_base: Path | None = None,
    poll_interval: float = 0.5,
) -> Iterator[int | list[int] | None]:
    """Fail-closed host build lock acquisition (normal 1-of-N or ascending `--exclusive` 1..N)."""
    if not enabled or max_slots <= 0:
        yield None
        return

    base = runtime_base if runtime_base is not None else resolve_runtime_base()[0]
    slot_dir = Path(base) / f"anneal-build-slots-{os.getuid()}"
    slot_dir.mkdir(parents=True, exist_ok=True)

    deadline = time.monotonic() + max(0.0, float(timeout_sec))
    warned = False

    if exclusive:
        acquired: list[tuple[int, int]] = []
        try:
            for slot_idx in range(1, max_slots + 1):
                lock_path = slot_dir / f"slot-{slot_idx}.lock"
                while True:
                    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        try:
                            os.ftruncate(fd, 0)
                            os.write(
                                fd,
                                f"pid={os.getpid()} ts={int(time.time())} exclusive=1\n".encode(
                                    "utf-8"
                                ),
                            )
                        except OSError:
                            pass
                        acquired.append((slot_idx, fd))
                        break
                    except BlockingIOError:
                        os.close(fd)
                        rem = deadline - time.monotonic()
                        if rem <= 0:
                            raise TimeoutError(
                                f"BUILD_SLOT_TIMEOUT: Timed out after {timeout_sec}s "
                                f"waiting for exclusive slot {slot_idx}/{max_slots} in {slot_dir}"
                            )
                        if not warned:
                            sys.stderr.write(
                                f"[anneal-lean-run] Waiting for exclusive access to all "
                                f"{max_slots} host build slot(s) (blocked on slot {slot_idx})...\n"
                            )
                            warned = True
                        time.sleep(min(poll_interval, max(0.01, rem)))
            yield [idx for idx, _ in acquired]
        finally:
            for _, fd in reversed(acquired):
                try:
                    fcntl.flock(fd, fcntl.LOCK_UN)
                except OSError:
                    pass
                try:
                    os.close(fd)
                except OSError:
                    pass
        return

    while True:
        for slot_idx in range(1, max_slots + 1):
            lock_path = slot_dir / f"slot-{slot_idx}.lock"
            try:
                fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
            except OSError:
                continue
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                try:
                    os.ftruncate(fd, 0)
                    os.write(
                        fd,
                        f"pid={os.getpid()} ts={int(time.time())}\n".encode("utf-8"),
                    )
                except OSError:
                    pass
                try:
                    yield slot_idx
                finally:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_UN)
                    except OSError:
                        pass
                    os.close(fd)
                return
            except BlockingIOError:
                os.close(fd)
                continue

        rem = deadline - time.monotonic()
        if rem <= 0:
            raise TimeoutError(
                f"BUILD_SLOT_TIMEOUT: Timed out after {timeout_sec}s waiting for "
                f"1 of {max_slots} host build slot(s) in {slot_dir}"
            )
        if not warned:
            sys.stderr.write(
                f"[anneal-lean-run] All {max_slots} host build slot(s) busy; "
                "queuing to prevent RAM/swap exhaustion...\n"
            )
            warned = True
        time.sleep(min(poll_interval, max(0.01, rem)))


def _has_lean_m_arg(args: list[str]) -> bool:
    for a in args:
        if a == "--":
            break
        if a == "-M" or a.startswith("-M") or a == "--memory" or a.startswith("--memory="):
            return True
    return False


def inject_lean_m_flag(cmd: list[str], lean_m_mb: int) -> list[str]:
    """Injects `-M <lean_m_mb>` into direct `lean` or `lake [opts] env [--] lean` calls."""
    if not cmd or lean_m_mb <= 0:
        return list(cmd)
    exe = Path(cmd[0]).name
    if exe == "lean":
        if "--run" in cmd[1:] or _has_lean_m_arg(cmd[1:]):
            return list(cmd)
        return [cmd[0], "-M", str(lean_m_mb), *cmd[1:]]
    lean_idx = _lake_env_lean_index(cmd)
    if lean_idx is not None:
        lean_args = cmd[lean_idx + 1 :]
        if "--run" in lean_args or _has_lean_m_arg(lean_args):
            return list(cmd)
        return [*cmd[: lean_idx + 1], "-M", str(lean_m_mb), *lean_args]
    return list(cmd)


class _ForwardSignal(BaseException):
    """Raised when `anneal-lean-run` receives a termination signal."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def terminate_process_group(pgid: int, grace_sec: float = 2.0) -> None:
    """Terminates process group `pgid` with `SIGTERM`, escalating to `SIGKILL`."""
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + grace_sec
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.1)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def _kill_systemd_scope(
    unit_name: str | None,
    proc: subprocess.Popen[Any],
    runtime_base: Path,
    user_systemd_sock_alive: bool,
    grace_sec: float = 2.0,
) -> None:
    """Kills a transient systemd scope (including detached grandchildren) + pgid fallback."""
    systemctl_bin = _find_systemctl() if (unit_name and user_systemd_sock_alive) else None
    env = _systemd_env(runtime_base, user_systemd_sock_alive)

    if systemctl_bin and unit_name:
        try:
            subprocess.run(
                [systemctl_bin, "--user", "kill", "-s", "SIGTERM", unit_name],
                env=env,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                check=False,
                timeout=2.0,
            )
        except Exception:
            pass
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

    deadline = time.monotonic() + grace_sec
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            break
        time.sleep(0.1)

    if systemctl_bin and unit_name:
        try:
            subprocess.run(
                [systemctl_bin, "--user", "kill", "-s", "SIGKILL", unit_name],
                env=env,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                check=False,
                timeout=2.0,
            )
        except Exception:
            pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        proc.wait(timeout=5.0)
    except Exception:
        pass


def _send_lsp_restart_all(sock_path: Path, timeout_sec: float = 5.0) -> bool:
    """Sends `lean_restart_workspace({"root": "all"})` over a raw Unix socket if alive."""
    try:
        if not sock_path.is_socket():
            return False
    except OSError:
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout_sec)
            s.connect(str(sock_path))
            payload = (
                json.dumps({"action": "lean_restart_workspace", "args": {"root": "all"}})
                + "\n"
            )
            s.sendall(payload.encode("utf-8"))
            buf = bytearray()
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf.extend(chunk)
                if b"\n" in chunk:
                    break
        if not buf:
            return False
        resp = json.loads(bytes(buf).split(b"\n", 1)[0].decode("utf-8", errors="replace"))
        return bool(resp.get("ok"))
    except Exception:
        return False


def _evict_lsp_workers(
    env_info: dict[str, Any],
    *,
    timeout_sec: float = 5.0,
    sock_path: Path | None = None,
) -> bool:
    """Evicts warm LSP workers via raw Unix RPC, falling back to `SIGKILL` + cgroup poll."""
    if os.environ.get("ANNEAL_LSP_NO_EVICT") == "1":
        return False
    eff_sock = (
        sock_path
        if sock_path is not None
        else Path(os.environ.get("ANNEAL_LSP_SOCKET", "/tmp/anneal-lean-lsp.sock"))
    )
    try:
        if not eff_sock.is_socket():
            return False
    except OSError:
        return False

    if _send_lsp_restart_all(eff_sock, timeout_sec=timeout_sec):
        return True

    if env_info.get("user_systemd_active"):
        systemctl_bin = _find_systemctl()
        runtime_base = Path(str(env_info.get("runtime_base") or "/tmp"))
        if systemctl_bin:
            try:
                subprocess.run(
                    [
                        systemctl_bin,
                        "--user",
                        "kill",
                        "-s",
                        "SIGKILL",
                        "anneal-lsp-daemon-*.scope",
                    ],
                    env=_systemd_env(runtime_base, True),
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    check=False,
                    timeout=3.0,
                )
            except Exception:
                pass
        w_cg_raw = env_info.get("w_cg_path")
        w_cg = Path(w_cg_raw) if w_cg_raw else None
        poll_deadline = time.monotonic() + 1.0
        while time.monotonic() < poll_deadline:
            if w_cg is None or not w_cg.is_dir():
                break
            scopes = [p for p in w_cg.glob("anneal-lsp-daemon-*.scope") if p.is_dir()]
            if not scopes:
                break
            l_bytes = sum(compute_cgroup_working_set_bytes(p) for p in scopes)
            if (l_bytes // MIB) < 128:
                break
            time.sleep(0.1)
        return True
    return False


def _canonical_git_root(cwd: str | Path | None = None) -> str:
    work_dir = Path(cwd) if cwd is not None else Path.cwd()
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(work_dir),
            env=_git_env(),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
            timeout=2.0,
        )
        if res.returncode == 0 and res.stdout.strip():
            return os.path.realpath(res.stdout.strip())
    except Exception:
        pass
    return os.path.realpath(str(work_dir))


def stamp_last_oom(
    runtime_base: Path,
    mode: str,
    reason: str,
    budget_gb: float,
    *,
    cwd: str | Path | None = None,
    now: float | None = None,
    uid: int | None = None,
) -> Path:
    """`flock`-guarded update of `runtime_base/anneal-last-oom-<uid>.json` (pruning `>15m`)."""
    eff_uid = os.getuid() if uid is None else uid
    eff_now = time.time() if now is None else float(now)
    oom_path = Path(runtime_base) / f"anneal-last-oom-{eff_uid}.json"
    lock_path = Path(runtime_base) / f"anneal-last-oom-{eff_uid}.lock"
    canonical_root = _canonical_git_root(cwd)

    try:
        oom_path.parent.mkdir(parents=True, exist_ok=True)
        with open(lock_path, "a+", encoding="utf-8") as lf:
            fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
            try:
                data: dict[str, Any] = {"entries": {}}
                if oom_path.is_file():
                    try:
                        loaded = json.loads(
                            oom_path.read_text(encoding="utf-8", errors="replace")
                        )
                        if isinstance(loaded, dict) and isinstance(
                            loaded.get("entries"), dict
                        ):
                            data = loaded
                    except Exception:
                        data = {"entries": {}}

                entries: dict[str, dict[str, Any]] = {}
                for root_key, modes_map in data.get("entries", {}).items():
                    if not isinstance(modes_map, dict):
                        continue
                    kept: dict[str, Any] = {}
                    for m_key, m_val in modes_map.items():
                        if not isinstance(m_val, dict):
                            continue
                        ts_val = m_val.get("ts")
                        try:
                            if eff_now - float(ts_val) <= 900.0:
                                kept[m_key] = m_val
                        except (TypeError, ValueError):
                            continue
                    if kept:
                        entries[root_key] = kept

                entries.setdefault(canonical_root, {})[mode] = {
                    "reason": reason,
                    "budget_gb": round(float(budget_gb), 2),
                    "ts": eff_now,
                }
                payload = json.dumps({"entries": entries}, indent=2) + "\n"
                fd, tmp_name = tempfile.mkstemp(
                    prefix=".anneal-last-oom.", dir=str(oom_path.parent)
                )
                try:
                    os.write(fd, payload.encode("utf-8"))
                finally:
                    os.close(fd)
                os.chmod(tmp_name, 0o600)
                os.replace(tmp_name, str(oom_path))
            finally:
                try:
                    fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
                except OSError:
                    pass
    except OSError:
        pass
    return oom_path


def _try_oom_offload(
    cmd: list[str], mode: str, local_budget_gb: float
) -> tuple[int, float | None] | None:
    """Optional Phase-2 `ANNEAL_OOM_OFFLOAD_CMD` hook; returns `(rc, remote_budget_gb)` or None."""
    raw_cmd = os.environ.get("ANNEAL_OOM_OFFLOAD_CMD", "").strip()
    if not raw_cmd:
        return None
    try:
        offload_argv = [*shlex.split(raw_cmd), "--", *cmd]
    except ValueError:
        return None
    with tempfile.TemporaryDirectory(prefix="anneal-oom-offload-") as tmpdir:
        budget_file = Path(tmpdir) / "remote_budget.json"
        env = os.environ.copy()
        env["ANNEAL_OOM_LOCAL_BUDGET_GB"] = f"{local_budget_gb:.2f}"
        env["ANNEAL_OOM_MODE"] = mode
        env["ANNEAL_OOM_REMOTE_BUDGET_FILE"] = str(budget_file)
        try:
            res = subprocess.run(offload_argv, env=env, check=False)
        except OSError:
            return (137, None)
        remote_budget: float | None = None
        if budget_file.is_file():
            try:
                raw_txt = budget_file.read_text(encoding="utf-8", errors="replace").strip()
                if raw_txt.startswith("{"):
                    obj = json.loads(raw_txt)
                    val = obj.get("remote_budget_gb", obj.get("budget_gb"))
                    if val is not None:
                        remote_budget = float(val)
                elif raw_txt:
                    remote_budget = float(raw_txt)
            except Exception:
                remote_budget = None
        return (res.returncode, remote_budget)


class BuildWatchdog:
    """Two-tier 2.0s mid-build watchdog (Tier 1 LSP shed + Tier 2 multi-ancestor abort)."""

    def __init__(
        self,
        *,
        is_cg_capped: bool,
        w_cg_path: Path | None,
        w_slice_high_mb: int,
        a_lim_path: Path | None,
        c_high_mb: int,
        capped_ancestors: list[tuple[Path, int]],
        lsp_shed_fn: Callable[[], bool] | None = None,
        read_w_fn: Callable[[Path], int] = read_cgroup_working_set_mib,
        read_local_high_fn: Callable[[Path], int] = read_events_local_high,
        read_psi_fn: Callable[[Path], float] = read_psi_full_avg10,
        lsp_no_evict: bool | None = None,
    ) -> None:
        self.is_cg_capped = is_cg_capped
        self.w_cg_path = w_cg_path
        self.w_slice_high_mb = max(0, int(w_slice_high_mb))
        self.a_lim_path = a_lim_path
        self.c_high_mb = int(c_high_mb)
        self.capped_ancestors = list(capped_ancestors)
        self._lsp_shed_fn = lsp_shed_fn
        self._read_w = read_w_fn
        self._read_local_high = read_local_high_fn
        self._read_psi = read_psi_fn
        self._lsp_no_evict = lsp_no_evict
        self.last_proactive_shed_ts: float = -1e9
        self.breach_ticks: int = 0
        self.prev_local_high: dict[Path, int] = {
            a_path: self._read_local_high(a_path)
            for a_path, _ in self.capped_ancestors
        }

    def _can_shed(self, now: float) -> bool:
        no_evict = (
            self._lsp_no_evict
            if self._lsp_no_evict is not None
            else (os.environ.get("ANNEAL_LSP_NO_EVICT") == "1")
        )
        return (not no_evict) and ((now - self.last_proactive_shed_ts) >= 10.0)

    def _fire_shed(self, now: float) -> bool:
        if not self._can_shed(now):
            return False
        if self._lsp_shed_fn is not None:
            fired = bool(self._lsp_shed_fn())
        else:
            sock_p = Path(
                os.environ.get("ANNEAL_LSP_SOCKET", "/tmp/anneal-lean-lsp.sock")
            )
            fired = _send_lsp_restart_all(sock_p, timeout_sec=0.5)
        if fired:
            self.last_proactive_shed_ts = now
        return fired

    def tick(self, now: float) -> dict[str, Any]:
        """Executes one 2.0s watchdog evaluation tick."""
        tier1_triggered = False
        shed_fired = False

        # Tier 1: proactive LSP shedding on ALL systemd hosts (never kills build).
        tier1_slice = False
        if self.w_cg_path is not None and self.w_slice_high_mb > 0:
            w_cg_cur = self._read_w(self.w_cg_path)
            slice_thresh = self.w_slice_high_mb - min(1024, self.w_slice_high_mb // 4)
            tier1_slice = w_cg_cur >= slice_thresh

        tier1_alim = False
        if self.is_cg_capped and self.a_lim_path is not None:
            w_alim_cur = self._read_w(self.a_lim_path)
            tier1_alim = w_alim_cur >= (self.c_high_mb - _m_safety_cg(self.c_high_mb))

        if tier1_slice or tier1_alim:
            tier1_triggered = True
            shed_fired = self._fire_shed(now)

        # Tier 2: multi-ancestor build abort strictly on cgroup-capped hosts.
        if not self.is_cg_capped:
            return {
                "action": "ok",
                "tier1_triggered": tier1_triggered,
                "shed_fired": shed_fired,
                "breach_ticks": 0,
            }

        any_breached = False
        for a_path, c_high_a in self.capped_ancestors:
            cur_local_high = self._read_local_high(a_path)
            delta_local_high = cur_local_high - self.prev_local_high.get(a_path, 0)
            # Immediately advance prev_local_high on EVERY tick.
            self.prev_local_high[a_path] = cur_local_high

            w_a = self._read_w(a_path)
            psi_full = self._read_psi(a_path)
            thresh_a = c_high_a - min(1024, _m_safety_cg(c_high_a))
            if (w_a >= thresh_a) or (delta_local_high > 0 and psi_full >= 20.0):
                any_breached = True

        if any_breached:
            self.breach_ticks += 1
            if self.breach_ticks == 1:
                if self._fire_shed(now):
                    shed_fired = True
            if self.breach_ticks >= 3:
                return {
                    "action": "abort_pressure",
                    "tier1_triggered": tier1_triggered,
                    "shed_fired": shed_fired,
                    "breach_ticks": self.breach_ticks,
                }
        else:
            self.breach_ticks = 0

        return {
            "action": "ok",
            "tier1_triggered": tier1_triggered,
            "shed_fired": shed_fired,
            "breach_ticks": self.breach_ticks,
        }


# Per-tool parallelism variables of the bounded command (`_resolve_thread_env`).
_THREAD_ENV_VARS: tuple[str, ...] = (
    "LEAN_NUM_THREADS",
    "CARGO_BUILD_JOBS",
    "RAYON_NUM_THREADS",
)


# Most significant digits of a thread count `_parse_positive_thread_count` accepts:
# every accepted count is below 10**9, so it is representable as a signed 32-bit
# integer (Cargo's `build.jobs` type).
_MAX_THREAD_COUNT_DIGITS = 9


def _parse_positive_thread_count(raw: object) -> int | None:
    """Parse an ASCII base-10 positive integer thread count, or `None`.

    Rejects blank strings, zero/negative values, floats, unary signs, Python
    underscore literals (`1_2`), and non-ASCII Unicode digits so Lean, Lake,
    Cargo, and Rayon never see values their parsers reject. A count with more than
    `_MAX_THREAD_COUNT_DIGITS` significant digits (leading zeros are not significant)
    is rejected too: no host has that many threads, such a value may not fit a tool's
    integer job count, and past `sys.get_int_max_str_digits()` digits `int()` itself
    raises `ValueError`.
    """
    if not isinstance(raw, str):
        return None
    stripped = raw.strip()
    if not stripped or not (stripped.isascii() and stripped.isdigit()):
        return None
    significant = stripped.lstrip("0")
    if not significant or len(significant) > _MAX_THREAD_COUNT_DIGITS:
        return None
    return int(significant)


def _resolve_thread_env(
    threads: int,
    is_cg_capped: bool,
    base_env: Mapping[str, str] | None = None,
) -> dict[str, int]:
    """Thread count the bounded command runs with, for each `_THREAD_ENV_VARS` variable.

    `threads` is the envelope's thread budget. A positive value the caller already
    exported (in `base_env`, default `os.environ`) is kept when it is at most that
    budget, so a caller can always ask for fewer threads (`LEAN_NUM_THREADS=1`). A
    larger one is clamped to the budget on a memory-capped slice and kept otherwise.
    Anything else (unset, blank, non-numeric, zero or negative) resolves to the budget.
    """
    env = os.environ if base_env is None else base_env
    resolved: dict[str, int] = {}
    for var in _THREAD_ENV_VARS:
        existing = _parse_positive_thread_count(env.get(var))
        if existing is not None:
            resolved[var] = min(existing, threads) if is_cg_capped else existing
        else:
            resolved[var] = threads
    return resolved


def format_threads_diagnostic(
    threads: int, child_env: Mapping[str, str] | None = None
) -> str:
    """`threads=<n>` field of the timeout / OOM / pressure-abort diagnostics.

    `<n>` is the `LEAN_NUM_THREADS` the command actually ran with (`child_env`, the
    environment `_build_child_env` handed it), not the envelope's thread budget
    `threads`: a caller that exported `LEAN_NUM_THREADS=1` on a 3- or 64-thread budget
    ran single-threaded and is reported as `threads=1`. When the two differ, the
    budget (which `CPUQuota` still reflects) follows as `thread_budget=<threads>`.
    """
    effective = threads
    if child_env is not None:
        parsed = _parse_positive_thread_count(child_env.get("LEAN_NUM_THREADS"))
        if parsed is not None:
            effective = parsed
    if effective == threads:
        return f"threads={effective}"
    return f"threads={effective}, thread_budget={threads}"


def _build_child_env(
    threads: int,
    lean_m_mb: int,
    is_cg_capped: bool,
    runtime_base: Path,
    user_systemd_sock_alive: bool,
    base_env: dict[str, str] | None = None,
) -> dict[str, str]:
    env = _systemd_env(runtime_base, user_systemd_sock_alive, base_env)
    env["ANNEAL_LEAN_RUN_IN_SCOPE"] = "1"
    env["ANNEAL_LEAN_RUN_ACTIVE"] = "1"
    env["ANNEAL_LEAN_RUN_LEAN_M_MB"] = str(lean_m_mb)
    for var, count in _resolve_thread_env(threads, is_cg_capped, env).items():
        env[var] = str(count)
    return env


def _build_scope_launch_cmd(
    effective_cmd: list[str],
    *,
    b_max_mb: int,
    threads: int,
    timeout_sec: int,
    user_systemd_active: bool,
    unit_name: str,
) -> tuple[list[str], bool]:
    """Builds the bounded command (systemd leaf scope + oom_score_adj=700 wrapper).

    `threads` is the envelope's thread budget. `CPUQuota` is a ceiling for the whole
    scope (Lake, `lean`, `cargo`, `rustc`, linkers), so it stays at that budget even
    when the caller exported a smaller `LEAN_NUM_THREADS` (`_resolve_thread_env`),
    which bounds Lean/Lake workers only; the diagnostics report the smaller count
    (`format_threads_diagnostic`).
    """
    wrapped_cmd = [
        "/bin/sh",
        "-c",
        'printf 700 > /proc/self/oom_score_adj 2>/dev/null; exec "$@"',
        "_",
        *effective_cmd,
    ]
    systemd_run_bin = _find_systemd_run() if user_systemd_active else None
    if user_systemd_active and systemd_run_bin:
        full_cmd = [
            systemd_run_bin,
            "--user",
            "--scope",
            "--collect",
            "--quiet",
            "--slice=anneal-workloads.slice",
            f"--unit={unit_name}",
            "-p",
            f"MemoryMax={b_max_mb}M",
            "-p",
            "MemorySwapMax=0",
            "-p",
            "OOMPolicy=kill",
            "-p",
            f"CPUQuota={threads * 100}%",
            "-p",
            f"RuntimeMaxSec={timeout_sec + 5}s",
            "--",
            *wrapped_cmd,
        ]
        return full_cmd, True
    return wrapped_cmd, False


def _exec_passthrough(cmd: list[str]) -> int:
    """Re-entrancy pass-through when already inside an enclosing `anneal-lean-run` scope."""
    lean_m_mb = _env_int("ANNEAL_LEAN_RUN_LEAN_M_MB", 0)
    effective_cmd = inject_lean_m_flag(cmd, lean_m_mb) if lean_m_mb > 0 else list(cmd)
    os.environ["ANNEAL_LEAN_RUN_ACTIVE"] = "1"
    os.environ["ANNEAL_LEAN_RUN_IN_SCOPE"] = "1"
    try:
        os.execvp(effective_cmd[0], effective_cmd)
    except FileNotFoundError:
        sys.stderr.write(
            f"[anneal-lean-run] ERROR: Command not found: {effective_cmd[0]}\n"
        )
        return 127
    except OSError as exc:
        sys.stderr.write(
            f"[anneal-lean-run] ERROR: Failed to exec {effective_cmd[0]}: {exc}\n"
        )
        return 126


def _should_retry_oom(
    *,
    rc: int,
    oom_event_detected: bool,
    watchdog_aborted: bool,
    timed_out: bool,
    mode: str,
    no_oom_retry: bool,
    skip_evict_at_launch: bool,
    b_max_at_launch: int,
    b_max_evict_at_launch: int,
    rem_timeout: int,
    lsp_no_evict: bool,
) -> bool:
    """Exact guard for single on-OOM LSP evict-and-retry."""
    if watchdog_aborted or timed_out:
        return False
    if not (rc in (137, -9) or oom_event_detected):
        return False
    if mode != "build" or no_oom_retry or lsp_no_evict:
        return False
    if not skip_evict_at_launch:
        return False
    if b_max_evict_at_launch < b_max_at_launch + 256:
        return False
    if rem_timeout < 120:
        return False
    return True


def run_bounded_command(
    cmd: list[str],
    limits: dict[str, Any],
    use_slot_lock: bool,
    *,
    exclusive: bool = False,
    no_oom_retry: bool = False,
    cli_concurrency: int | None = None,
    override_mem_mb: int | None = None,
    override_timeout_sec: int | None = None,
    unsafe_ignore_cgroup: bool = False,
    probe_fn: Callable[..., dict[str, Any]] | None = None,
    evict_fn: Callable[[dict[str, Any]], bool] | None = None,
    slot_timeout_override: float | None = None,
) -> int:
    """Executes `cmd` inside `anneal-workloads.slice`, slot locks, and 2-tier watchdog."""
    mode = str(limits["mode"])
    build_slots = int(limits["build_slots"])
    is_cg_capped = bool(limits.get("is_cg_capped", False))
    w_slice_max_mb = int(limits.get("w_slice_max_mb", 0))
    runtime_base = Path(str(limits.get("runtime_base") or "/tmp"))
    default_rb, default_sock_alive = resolve_runtime_base()
    user_systemd_sock_alive = (
        default_sock_alive
        if str(runtime_base) == str(default_rb)
        else _has_user_systemd_sock(runtime_base)
    )

    # Auto-ensure `anneal-workloads.slice` on first build/file run when absent or stale.
    if limits.get("user_systemd_active") and limits.get("t_cg_is_user_service"):
        ensure_workloads_slice(limits)

    if exclusive:
        need_slot = True
        slot_timeout = 1200 if mode == "build" else 180
    elif not use_slot_lock:
        need_slot = False
        slot_timeout = 1200 if mode == "build" else 180
    elif mode == "build":
        need_slot = True
        slot_timeout = 1200
    elif mode == "file" and is_cg_capped and w_slice_max_mb < 16384:
        need_slot = True
        slot_timeout = 180
    else:
        need_slot = False
        slot_timeout = 180

    def _reprobe() -> dict[str, Any]:
        eff_probe = probe_fn if probe_fn is not None else probe_host_envelope
        return eff_probe(
            cli_concurrency=cli_concurrency,
            exclusive=exclusive,
            mode=mode,
            override_mem_mb=override_mem_mb,
            override_timeout_sec=override_timeout_sec,
            unsafe_ignore_cgroup=unsafe_ignore_cgroup,
        )

    def _run_single_attempt(
        att_limits: dict[str, Any], att_timeout: int
    ) -> tuple[int, bool, bool, bool, float | None, str]:
        att_threads = int(att_limits["threads"])
        att_b_max = int(att_limits["memory_max_mb"])
        att_lean_m = int(att_limits["lean_m_mb"])
        att_user_systemd = bool(att_limits.get("user_systemd_active", False))
        att_capped = bool(att_limits.get("is_cg_capped", False))
        att_rt_base = Path(str(att_limits.get("runtime_base") or runtime_base))
        att_sock_alive = att_user_systemd or _has_user_systemd_sock(att_rt_base)

        effective_cmd = inject_lean_m_flag(cmd, att_lean_m)
        unit_name = f"anneal-run-{os.getpid()}-{time.monotonic_ns()}.scope"
        full_cmd, in_scope = _build_scope_launch_cmd(
            effective_cmd,
            b_max_mb=att_b_max,
            threads=att_threads,
            timeout_sec=att_timeout,
            user_systemd_active=att_user_systemd,
            unit_name=unit_name,
        )
        env = _build_child_env(
            threads=att_threads,
            lean_m_mb=att_lean_m,
            is_cg_capped=att_capped,
            runtime_base=att_rt_base,
            user_systemd_sock_alive=att_sock_alive,
        )
        # What the command really runs with: a caller's lower `LEAN_NUM_THREADS` wins
        # over the envelope's `att_threads` budget (`_resolve_thread_env`).
        att_threads_diag = format_threads_diagnostic(att_threads, env)

        w_cg_raw = att_limits.get("w_cg_path")
        w_cg_p = Path(w_cg_raw) if w_cg_raw else None
        a_lim_raw = att_limits.get("a_lim_path")
        a_lim_p = Path(a_lim_raw) if a_lim_raw else None
        cap_ancs = [
            (Path(str(a["path"])), int(a["c_high_mb"]))
            for a in (att_limits.get("capped_ancestors") or [])
        ]
        watchdog: BuildWatchdog | None = None
        if att_user_systemd and in_scope:
            watchdog = BuildWatchdog(
                is_cg_capped=att_capped,
                w_cg_path=w_cg_p,
                w_slice_high_mb=int(att_limits.get("w_slice_high_mb", 0)),
                a_lim_path=a_lim_p,
                c_high_mb=int(att_limits.get("c_high_mb", 0)),
                capped_ancestors=cap_ancs,
            )

        proc = subprocess.Popen(
            full_cmd,
            env=env,
            start_new_session=True,
        )
        prev_handlers: dict[int, object] = {}

        def _handle_signal(signum: int, _frame: object) -> None:
            raise _ForwardSignal(signum)

        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            prev_handlers[sig] = signal.getsignal(sig)
            signal.signal(sig, _handle_signal)

        att_rc = 0
        att_timed_out = False
        att_wd_aborted = False
        att_pressure_budget: float | None = None
        att_oom_evt = False
        deadline = time.monotonic() + att_timeout
        try:
            while True:
                rem = deadline - time.monotonic()
                if rem <= 0:
                    att_timed_out = True
                    cg_snap = format_cgroup_diagnostic_snapshot(pid=proc.pid)
                    _kill_systemd_scope(
                        unit_name if in_scope else None,
                        proc,
                        att_rt_base,
                        att_sock_alive,
                    )
                    sys.stderr.write(
                        f"\n[anneal-lean-run] ERROR: Command timed out after "
                        f"{att_timeout}s (mode={mode}, MemoryMax={att_b_max}M, "
                        f"{att_threads_diag}).\n"
                        f"{cg_snap}"
                        "  Remediation: Inspect proof goals interactively with "
                        "`lean_goal` / wildcard `change ... _` "
                        "(`skills/anneal-lsp/SKILL.md`) and apply the kernel "
                        "proof-scaling patterns in `skills/anneal-prove/SKILL.md` "
                        "(`BlockCtx`, `Hold`, `bitwiseAndBitsFast`).\n"
                    )
                    att_rc = 124
                    break
                step = min(2.0, rem) if watchdog is not None else rem
                try:
                    att_rc = proc.wait(timeout=step)
                    break
                except subprocess.TimeoutExpired:
                    if watchdog is not None:
                        wd_res = watchdog.tick(time.monotonic())
                        if wd_res.get("action") == "abort_pressure":
                            att_wd_aborted = True
                            # Measure live budget BEFORE killing the scope.
                            try:
                                fresh = _reprobe()
                                w_self = (
                                    read_cgroup_working_set_mib(w_cg_p / unit_name)
                                    if w_cg_p is not None
                                    else 0
                                )
                                w_sibs = max(
                                    0, int(fresh.get("w_non_lsp_mb", 0)) - w_self
                                )
                                live_avail = max(
                                    0, int(fresh.get("w_live_mb", 0)) - w_sibs
                                )
                                att_pressure_budget = round(
                                    min(att_b_max, live_avail) / 1024.0, 2
                                )
                            except Exception:
                                att_pressure_budget = round(att_b_max / 1024.0, 2)
                            _kill_systemd_scope(
                                unit_name if in_scope else None,
                                proc,
                                att_rt_base,
                                att_sock_alive,
                            )
                            stamp_last_oom(
                                att_rt_base,
                                mode,
                                "pressure",
                                att_pressure_budget,
                            )
                            sys.stderr.write(
                                f"\n[anneal-lean-run] ERROR: USER_SLICE_PRESSURE_ABORT: "
                                f"Aborted build after 3 consecutive ancestor pressure ticks "
                                f"(mode={mode}, {att_threads_diag}, "
                                f"budget_gb={att_pressure_budget:.2f}).\n"
                            )
                            att_rc = 137
                            break
        except _ForwardSignal as caught:
            _kill_systemd_scope(
                unit_name if in_scope else None, proc, att_rt_base, att_sock_alive
            )
            return (128 + caught.signum, False, False, False, None, att_threads_diag)
        finally:
            for sig, handler in prev_handlers.items():
                signal.signal(sig, handler)  # type: ignore[arg-type]
            if proc.poll() is None:
                _kill_systemd_scope(
                    unit_name if in_scope else None, proc, att_rt_base, att_sock_alive
                )

        if (
            not att_wd_aborted
            and not att_timed_out
            and in_scope
            and w_cg_p is not None
        ):
            att_oom_evt = _read_memory_events_oom_kill(w_cg_p / unit_name) > 0

        return (
            att_rc,
            att_timed_out,
            att_wd_aborted,
            att_oom_evt,
            att_pressure_budget,
            att_threads_diag,
        )

    eff_slot_timeout = (
        float(slot_timeout_override)
        if slot_timeout_override is not None
        else float(slot_timeout)
    )

    try:
        with acquire_build_slot(
            build_slots,
            eff_slot_timeout,
            enabled=need_slot,
            exclusive=exclusive,
            runtime_base=runtime_base,
        ):
            slot_t0 = time.monotonic()

            # Re-probe strictly INSIDE the held build slot so queued builds see fresh headroom.
            cur_limits = _reprobe()
            skip_evict_at_launch = bool(cur_limits.get("skip_evict", False))

            if mode == "build" and not skip_evict_at_launch:
                evicted = (
                    evict_fn(cur_limits)
                    if evict_fn is not None
                    else _evict_lsp_workers(cur_limits)
                )
                if evicted:
                    cur_limits = _reprobe()

            b_max_1 = int(cur_limits["memory_max_mb"])
            b_max_evict_at_launch = int(cur_limits["b_max_evict_mb"])
            cur_rt_base = Path(str(cur_limits.get("runtime_base") or runtime_base))
            timeout_1 = int(cur_limits["timeout_sec"])

            # Fail-fast admission gate (NO unsafe upward clamp).
            min_required = 2048 if mode == "build" else 1024
            if override_mem_mb is None and b_max_1 < min_required:
                budget_gb = round(b_max_1 / 1024.0, 2)
                stamp_last_oom(cur_rt_base, mode, "headroom", budget_gb)
                sys.stderr.write(
                    f"[anneal-lean-run] ERROR: INSUFFICIENT_CGROUP_HEADROOM: "
                    f"Computed B_max={b_max_1}M < {min_required}M for mode={mode} "
                    f"(budget_gb={budget_gb:.2f}). Refusing to launch.\n"
                )
                return 137

            rc, timed_out, watchdog_aborted, oom_evt, _, final_threads_diag = (
                _run_single_attempt(cur_limits, timeout_1)
            )
            final_b_max = b_max_1

            # Single on-OOM evict-and-retry (gated on not watchdog_aborted and not timed_out).
            rem_timeout = int(1200 - (time.monotonic() - slot_t0))
            lsp_no_evict = os.environ.get("ANNEAL_LSP_NO_EVICT") == "1"
            if _should_retry_oom(
                rc=rc,
                oom_event_detected=oom_evt,
                watchdog_aborted=watchdog_aborted,
                timed_out=timed_out,
                mode=mode,
                no_oom_retry=no_oom_retry,
                skip_evict_at_launch=skip_evict_at_launch,
                b_max_at_launch=b_max_1,
                b_max_evict_at_launch=b_max_evict_at_launch,
                rem_timeout=rem_timeout,
                lsp_no_evict=lsp_no_evict,
            ):
                if evict_fn is not None:
                    evict_fn(cur_limits)
                else:
                    _evict_lsp_workers(cur_limits)
                retry_limits = _reprobe()
                b_max_retry = int(retry_limits["memory_max_mb"])
                if b_max_retry >= b_max_1 + 256:
                    retry_timeout = min(900, max(120, int(1200 - (time.monotonic() - slot_t0))))
                    sys.stderr.write(
                        f"[anneal-lean-run] INFO: Attempt 1 OOMed at {b_max_1}M; "
                        f"evicted LSP workers and retrying once at {b_max_retry}M "
                        f"(timeout={retry_timeout}s).\n"
                    )
                    final_b_max = b_max_retry
                    rc, timed_out, watchdog_aborted, oom_evt, _, final_threads_diag = (
                        _run_single_attempt(retry_limits, retry_timeout)
                    )

            if watchdog_aborted:
                return 137
            if timed_out:
                return 124
            if rc in (137, -9) or oom_evt:
                local_budget_gb = round(final_b_max / 1024.0, 2)
                offload_res = _try_oom_offload(cmd, mode, local_budget_gb)
                if offload_res is not None:
                    off_rc, remote_gb = offload_res
                    if off_rc == 0:
                        return 0
                    if off_rc == 137 and remote_gb is not None:
                        stamp_gb = round(max(local_budget_gb, remote_gb), 2)
                    else:
                        stamp_gb = local_budget_gb
                else:
                    stamp_gb = local_budget_gb

                stamp_last_oom(cur_rt_base, mode, "oom", stamp_gb)
                cg_snap = format_cgroup_diagnostic_snapshot()
                sys.stderr.write(
                    f"\n[anneal-lean-run] ERROR: Command was terminated by the OS "
                    f"memory guard (exit 137, MemoryMax={final_b_max}M, "
                    f"MemorySwapMax=0, mode={mode}, {final_threads_diag}, "
                    f"budget_gb={stamp_gb:.2f}).\n"
                    f"{cg_snap}"
                    "  Why: The process exceeded its hardware-matched physical RAM "
                    "ceiling and was killed before it could thrash host swap.\n"
                    "  Remediation: Avoid unfolding multi-block "
                    "`Mir.<Crate>.<Item>.body` or `wpMirExecSym` inside `dsimp`; "
                    "use `BlockCtx`, `Hold`, and top-down wildcard `change` "
                    "(`skills/anneal-prove/SKILL.md` Section 5).\n"
                )
                return 137

            return rc
    except (TimeoutError, OSError) as exc:
        sys.stderr.write(f"[anneal-lean-run] ERROR: {exc}\n")
        return 124


# Repository-location variables that Git exports to hooks and aliases.
# Scrubbed from git subprocesses so `git rev-parse --show-toplevel` uses cwd.
_GIT_LOCAL_ENV_VARS: tuple[str, ...] = (
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_DIR",
    "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NO_REPLACE_OBJECTS",
    "GIT_OBJECT_DIRECTORY",
    "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE",
    "GIT_SHALLOW_FILE",
    "GIT_WORK_TREE",
)


def _git_env() -> dict[str, str]:
    env = os.environ.copy()
    for name in _GIT_LOCAL_ENV_VARS:
        env.pop(name, None)
    return env



def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description=(
            "Run `lake`, `lean`, or `cargo` commands with hardware-matched "
            "CPU thread, physical RAM (`MemoryMax`), zero-swap "
            "(`MemorySwapMax=0`), and wall-clock timeout limits inside "
            "`anneal-workloads.slice`."
        )
    )
    p.add_argument(
        "--probe",
        "--print-limits",
        dest="probe",
        action="store_true",
        help=(
            "Print detected host hardware, cgroup v2 workload envelope, and "
            "computed resource limits without running a command."
        ),
    )
    p.add_argument(
        "--ensure-slice",
        action="store_true",
        help=(
            "Idempotently create/update `~/.config/systemd/user/anneal-workloads.slice` "
            "when `systemd --user` is active under `user@<uid>.service`."
        ),
    )
    p.add_argument(
        "--json",
        action="store_true",
        help=(
            "Format `--probe` / `--print-limits` or `--ensure-slice` output as JSON."
        ),
    )
    p.add_argument(
        "--mode",
        choices=("auto", "file", "build"),
        default="auto",
        help=(
            "Resource profile: 'file' for single-file `lean` checks, 'build' "
            "for `lake build`/`cargo` (default: auto)."
        ),
    )
    p.add_argument(
        "--concurrency",
        "-W",
        type=int,
        default=None,
        help=(
            "Number of concurrent active build worktrees sharing this host "
            "(default: $ANNEAL_WORKTREE_CONCURRENCY, `$XDG_CONFIG_HOME/anneal/concurrency`, or 1)."
        ),
    )
    p.add_argument(
        "--exclusive",
        action="store_true",
        help=(
            "Acquire all `1..build_slots` host build locks in ascending order "
            "and execute with `w_eff = 1` (forces locking even in `file` mode)."
        ),
    )
    p.add_argument(
        "--memory-max-mb",
        type=int,
        default=_env_int("ANNEAL_LEAN_MEMORY_MAX_MB", 0) or None,
        help="Override the computed hard physical RAM ceiling in MiB.",
    )
    p.add_argument(
        "--unsafe-ignore-cgroup",
        action="store_true",
        help="Allow explicit `--memory-max-mb` to exceed `W_slice_max` on cgroup-capped hosts.",
    )
    p.add_argument(
        "--timeout",
        type=int,
        default=_env_int("ANNEAL_LEAN_TIMEOUT_SEC", 0) or None,
        help=(
            "Override the wall-clock timeout in seconds (default: 180s for "
            "file, 900s for build)."
        ),
    )
    p.add_argument(
        "--no-slot-lock",
        action="store_true",
        help="Disable the host-wide concurrent build slot lock (ignored with `--exclusive`).",
    )
    p.add_argument(
        "--nested-ok",
        action="store_true",
        help="Disable `ANNEAL_LEAN_RUN_IN_SCOPE=1` re-entrancy pass-through.",
    )
    p.add_argument(
        "--no-oom-retry",
        action="store_true",
        help="Disable single on-OOM LSP eviction and retry in `build` mode.",
    )
    p.add_argument(
        "cmd",
        nargs=argparse.REMAINDER,
        help=(
            "Command and arguments to execute (e.g., `lake build` or "
            "`lake env lean File.lean`)."
        ),
    )
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    cmd = list(args.cmd)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    if args.ensure_slice:
        env_info = probe_host_envelope(
            cli_concurrency=args.concurrency,
            exclusive=args.exclusive,
            is_probe=True,
            mode="build",
        )
        ok, changed, msg = ensure_workloads_slice(env_info)
        if not ok:
            sys.stderr.write(f"[anneal-lean-run] ERROR: {msg}\n")
        if args.json:
            print(
                json.dumps(
                    {
                        "ok": ok,
                        "changed": changed,
                        "message": msg,
                        "w_slice_max_mb": env_info["w_slice_max_mb"],
                        "w_slice_high_mb": env_info["w_slice_high_mb"],
                        "user_systemd_active": env_info["user_systemd_active"],
                    },
                    indent=2,
                )
            )
        elif ok:
            print(f"[anneal-lean-run] {msg}")
        return 0 if ok else 1

    if args.probe:
        eff_mode = detect_mode(cmd, args.mode)
        limits = probe_host_envelope(
            cli_concurrency=args.concurrency,
            exclusive=args.exclusive,
            is_probe=True,
            mode=eff_mode,
            override_mem_mb=args.memory_max_mb,
            override_timeout_sec=args.timeout,
            unsafe_ignore_cgroup=args.unsafe_ignore_cgroup,
        )
        if args.json:
            print(json.dumps(limits, indent=2))
        else:
            probe_lean_threads = _resolve_thread_env(
                int(limits["threads"]), bool(limits.get("is_cg_capped", False))
            )["LEAN_NUM_THREADS"]
            print(
                f"=== Anneal Hardware-Matched Resource Limits "
                f"(mode={limits['mode']}, W={limits['w_eff']}) ===\n"
                f"  Host CPUs          : {limits['cpu_cores']} logical cores\n"
                f"  Host Physical RAM  : {limits['mem_total_mb']} MiB total, "
                f"{limits['mem_avail_mb']} MiB available\n"
                f"{format_cgroup_probe_line(limits)}\n"
                f"  Usable / Budget    : usable={limits['usable_workload_mem_gb']} GiB, "
                f"single_build_budget={limits['single_build_budget_gb']:.2f} GiB\n"
                f"  Thread Budget (-j) : {limits['threads']} threads "
                f"(LEAN_NUM_THREADS={probe_lean_threads})\n"
                f"  Hard RAM Cap       : {limits['memory_max_mb']} MiB "
                f"(MemorySwapMax=0, lean -M {limits['lean_m_mb']})\n"
                f"  LSP Pool Limits    : L_max={limits['l_max_mb']} MiB, "
                f"lean={limits['max_lean_workers']}, rust={limits['max_rust_workers']}, "
                f"ttl={limits['idle_ttl_seconds']}s\n"
                f"  Wall-Clock Timeout : {limits['timeout_sec']}s\n"
                f"  Host Build Slots   : {limits['build_slots']} (s_heavy_safe={limits['s_heavy_safe']}, active={limits['active_build_slots']})\n"
                f"  Systemd User Scope : {limits['user_systemd_active']} (runtime_base={limits['runtime_base']})"
            )
        return 0

    if not cmd:
        parser.print_help(sys.stderr)
        return 2

    # Decoupled re-entrancy pass-through gated STRICTLY on ANNEAL_LEAN_RUN_IN_SCOPE == "1".
    if os.environ.get("ANNEAL_LEAN_RUN_IN_SCOPE") == "1" and not args.nested_ok:
        return _exec_passthrough(cmd)

    eff_mode = detect_mode(cmd, args.mode)
    limits = probe_host_envelope(
        cli_concurrency=args.concurrency,
        exclusive=args.exclusive,
        is_probe=False,
        mode=eff_mode,
        override_mem_mb=args.memory_max_mb,
        override_timeout_sec=args.timeout,
        unsafe_ignore_cgroup=args.unsafe_ignore_cgroup,
    )
    return run_bounded_command(
        cmd=cmd,
        limits=limits,
        use_slot_lock=not args.no_slot_lock,
        exclusive=args.exclusive,
        no_oom_retry=args.no_oom_retry,
        cli_concurrency=args.concurrency,
        override_mem_mb=args.memory_max_mb,
        override_timeout_sec=args.timeout,
        unsafe_ignore_cgroup=args.unsafe_ignore_cgroup,
    )


if __name__ == "__main__":
    sys.exit(main())
