"""Hardware-matched resource wrapper for `lake`, `lean`, and `cargo` commands,
plus pre-export fast-forward bundle verification (`--verify-bundle-ff`).

Probes the host's logical CPU count, physical RAM (`MemTotal` and
`MemAvailable`), and cgroup v2 non-reclaimable working set (`anon + shmem` vs
reclaimable `file` page cache in `memory.stat`) at invocation time, partitions
threads and memory across the active worktree concurrency factor `W`, and
executes the target command inside a fail-fast OS memory boundary (`MemoryMax`
with `MemorySwapMax=0` when `systemd` user scopes are available) and a
wall-clock timeout.

Why this wrapper exists:
- Lean 4's `-M <MB>` flag bounds only the internal small-object allocator and
  does not cap total process RSS, `mmap` regions, or child processes spawned by
  `lake build`.
- On hosts with large swap partitions, an unbounded kernel `whnf` or `dsimp`
  blowup pages tens of gigabytes per minute to disk (`iowait ~90%`) instead of
  failing fast, wedging interactive SSH sessions and background daemons.
- Setting `MemorySwapMax=0` alongside `MemoryMax` derived from physical RAM
  forces the kernel cgroup controller to terminate only the runaway `lean`
  scope immediately (`exit 137`) with zero swap thrashing.
- On Linux cgroup v2 hosts, `memory.current` conflates reclaimable `.olean`
  `file` page cache with true non-reclaimable heap (`anon + shmem`). Budgeting
  cgroup headroom via `memory.max - (anon + shmem)` prevents `.olean` file cache
  from falsely throttling concurrent builds while still throttling when genuine
  anonymous working-set pressure rises.
- Pre-export bundle verification (`--verify-bundle-ff` / `--check-unstable-ff`)
  guards shared integration refs (`refs/heads/unstable`) in x20 Git bundles
  against accidental non-fast-forward rollbacks.
"""

from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import posixpath
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from typing import Any, Iterator

sys.dont_write_bytecode = True

MIB = 1024 * 1024
X20_FUSE_PREFIXES: tuple[str, ...] = ("/google/data/rw/", "/google/data/ro/")
X20_URI_PREFIX = "/x20/"


def _env_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or not raw.strip():
        return default
    try:
        return int(raw.strip())
    except ValueError:
        return default


def parse_proc_cgroup_v2(
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> str | None:
    """Parses `/proc/self/cgroup` for the unified hierarchy `0::<rel_path>` line."""
    try:
        if not proc_cgroup_path.is_file():
            return None
        raw = proc_cgroup_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None

    for line in raw.splitlines():
        line = line.strip()
        if not line.startswith("0::"):
            continue
        rel = line.split("::", 1)[1].strip()
        if rel.endswith(" (deleted)"):
            rel = rel[: -len(" (deleted)")].strip()
        if not rel or rel == "/":
            return "/"
        return "/" + rel.lstrip("/")
    return None


def parse_memory_stat(source: str | Path) -> dict[str, int]:
    """Parses cgroup v2 `memory.stat` key-value integer pairs (in bytes)."""
    raw: str
    if isinstance(source, Path):
        try:
            raw = source.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return {}
    elif isinstance(source, str):
        if "\n" not in source and " " not in source and source.strip():
            p = Path(source)
            try:
                if p.is_file():
                    raw = p.read_text(encoding="utf-8", errors="replace")
                else:
                    raw = source
            except OSError:
                raw = source
        else:
            raw = source
    else:
        return {}

    stats: dict[str, int] = {}
    for line in raw.splitlines():
        parts = line.strip().split()
        if len(parts) != 2:
            continue
        key, val_str = parts
        try:
            val = int(val_str)
        except ValueError:
            continue
        if val >= 0:
            stats[key] = val
    return stats


def _read_cgroup_int(path: Path) -> int | None:
    """Reads a finite non-negative integer from a cgroup file, or None for 'max'/missing."""
    try:
        if not path.is_file():
            return None
        raw = path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return None
    if not raw or raw == "max":
        return None
    first = raw.split()[0]
    try:
        val = int(first)
    except ValueError:
        return None
    return val if val >= 0 else None


def _empty_cgroup_info() -> dict[str, Any]:
    return {
        "cgroup_v2": False,
        "cgroup_path": None,
        "cgroup_anon_mib": None,
        "cgroup_shmem_mib": None,
        "cgroup_anon_shmem_mib": None,
        "cgroup_file_cache_mib": None,
        "cgroup_current_mib": None,
        "cgroup_memory_max_mib": None,
        "cgroup_avail_mib": None,
    }


def _has_cgroup_memory_files(directory: Path) -> bool:
    try:
        if not directory.is_dir():
            return False
        return any(
            (directory / name).is_file()
            for name in ("memory.stat", "memory.current", "memory.max")
        )
    except OSError:
        return False


def probe_cgroup_v2_memory(
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> dict[str, Any]:
    """Probes cgroup v2 `memory.stat` (`anon + shmem` vs `file`) and ancestor `memory.max`.

    Never raises: this runs on every `anneal-lean-run` invocation (and inside
    the timeout/OOM diagnostic paths), so any unexpected error (e.g. an
    `EACCES` from `Path.is_file()` on older Pythons) degrades to
    `cgroup_v2 = False` instead of aborting the wrapped command.
    """
    try:
        return _probe_cgroup_v2_memory_impl(cgroup_root, proc_cgroup_path)
    except Exception:  # noqa: BLE001 - telemetry must never break execution
        return _empty_cgroup_info()


def _probe_cgroup_v2_memory_impl(
    cgroup_root: Path,
    proc_cgroup_path: Path,
) -> dict[str, Any]:
    try:
        if not cgroup_root.is_dir():
            return _empty_cgroup_info()
    except OSError:
        return _empty_cgroup_info()

    rel_path: str | None = None
    try:
        proc_exists = proc_cgroup_path.is_file()
    except OSError:
        proc_exists = False

    if proc_exists:
        rel_path = parse_proc_cgroup_v2(proc_cgroup_path)
        if rel_path is None:
            return _empty_cgroup_info()
    else:
        # Allow unit tests that pass a custom `cgroup_root` without overriding
        # `proc_cgroup_path` on non-Linux hosts to probe `cgroup_root` directly.
        if (
            proc_cgroup_path == Path("/proc/self/cgroup")
            and cgroup_root != Path("/sys/fs/cgroup")
            and _has_cgroup_memory_files(cgroup_root)
        ):
            rel_path = "/"
        else:
            return _empty_cgroup_info()

    rel_clean = rel_path.lstrip("/")
    rel_parts = [p for p in Path(rel_clean).parts if p not in ("", ".")]
    if ".." in rel_parts:
        return _empty_cgroup_info()

    candidate = cgroup_root.joinpath(*rel_parts) if rel_parts else cgroup_root
    try:
        candidate_is_dir = candidate.is_dir()
    except OSError:
        candidate_is_dir = False

    if candidate_is_dir and (
        _has_cgroup_memory_files(candidate)
        or (candidate / "cgroup.controllers").is_file()
        or (candidate / "cgroup.procs").is_file()
    ):
        leaf_dir = candidate
        resolved_cgroup_path = "/" + "/".join(rel_parts) if rel_parts else "/"
    elif rel_parts and _has_cgroup_memory_files(cgroup_root):
        # Container namespace where `/proc/self/cgroup` reports a host-relative
        # path while `/sys/fs/cgroup` is already mounted at the container leaf
        # (or a unit test populating `cgroup_root` directly).
        leaf_dir = cgroup_root
        resolved_cgroup_path = "/"
    else:
        return _empty_cgroup_info()

    try:
        root_res = cgroup_root.resolve()
        curr_res = leaf_dir.resolve()
    except OSError:
        return _empty_cgroup_info()

    if curr_res != root_res and root_res not in curr_res.parents:
        return _empty_cgroup_info()

    levels: list[Path] = []
    curr = curr_res
    while True:
        levels.append(curr)
        if curr == root_res or curr.parent == curr:
            break
        curr = curr.parent

    if not any(_has_cgroup_memory_files(lvl) for lvl in levels):
        return _empty_cgroup_info()

    leaf_stat: dict[str, int] = {}
    for lvl in levels:
        stat_file = lvl / "memory.stat"
        if stat_file.is_file():
            parsed = parse_memory_stat(stat_file)
            if parsed:
                leaf_stat = parsed
                break

    leaf_anon_shmem_bytes: int | None = None
    cgroup_anon_mib: int | None = None
    cgroup_shmem_mib: int | None = None
    cgroup_anon_shmem_mib: int | None = None
    cgroup_file_cache_mib: int | None = None

    if leaf_stat:
        anon_bytes = leaf_stat.get("anon", 0)
        shmem_bytes = leaf_stat.get("shmem", 0)
        file_bytes = leaf_stat.get(
            "file",
            leaf_stat.get("inactive_file", 0) + leaf_stat.get("active_file", 0),
        )
        leaf_anon_shmem_bytes = anon_bytes + shmem_bytes
        cgroup_anon_mib = anon_bytes // MIB
        cgroup_shmem_mib = shmem_bytes // MIB
        cgroup_anon_shmem_mib = leaf_anon_shmem_bytes // MIB
        cgroup_file_cache_mib = file_bytes // MIB

    leaf_current_bytes: int | None = None
    for lvl in levels:
        cur_val = _read_cgroup_int(lvl / "memory.current")
        if cur_val is not None:
            leaf_current_bytes = cur_val
            break
    cgroup_current_mib = (
        (leaf_current_bytes // MIB) if leaf_current_bytes is not None else None
    )

    min_max_mib: int | None = None
    min_avail_mib: int | None = None

    for lvl in levels:
        lvl_max_bytes = _read_cgroup_int(lvl / "memory.max")
        if lvl_max_bytes is None or lvl_max_bytes <= 0:
            continue
        lvl_cur_bytes = _read_cgroup_int(lvl / "memory.current")
        lvl_stat_path = lvl / "memory.stat"
        lvl_stat = parse_memory_stat(lvl_stat_path) if lvl_stat_path.is_file() else {}

        if "anon" in lvl_stat or "shmem" in lvl_stat:
            lvl_used_bytes = lvl_stat.get("anon", 0) + lvl_stat.get("shmem", 0)
        elif "inactive_file" in lvl_stat and lvl_cur_bytes is not None:
            lvl_used_bytes = max(0, lvl_cur_bytes - lvl_stat["inactive_file"])
        elif lvl_cur_bytes is not None:
            lvl_used_bytes = lvl_cur_bytes
        elif leaf_anon_shmem_bytes is not None:
            lvl_used_bytes = leaf_anon_shmem_bytes
        else:
            lvl_used_bytes = 0

        lvl_avail_bytes = max(0, lvl_max_bytes - lvl_used_bytes)
        lvl_max_mib = lvl_max_bytes // MIB
        lvl_avail_mib = lvl_avail_bytes // MIB

        if min_max_mib is None or lvl_max_mib < min_max_mib:
            min_max_mib = lvl_max_mib
        if min_avail_mib is None or lvl_avail_mib < min_avail_mib:
            min_avail_mib = lvl_avail_mib

    return {
        "cgroup_v2": True,
        "cgroup_path": resolved_cgroup_path,
        "cgroup_anon_mib": cgroup_anon_mib,
        "cgroup_shmem_mib": cgroup_shmem_mib,
        "cgroup_anon_shmem_mib": cgroup_anon_shmem_mib,
        "cgroup_file_cache_mib": cgroup_file_cache_mib,
        "cgroup_current_mib": cgroup_current_mib,
        "cgroup_memory_max_mib": min_max_mib,
        "cgroup_avail_mib": min_avail_mib,
    }


probe_cgroup_v2 = probe_cgroup_v2_memory


def probe_host_hardware(
    meminfo_path: Path = Path("/proc/meminfo"),
    cgroup_root: Path = Path("/sys/fs/cgroup"),
    proc_cgroup_path: Path = Path("/proc/self/cgroup"),
) -> dict[str, Any]:
    """Returns host logical CPU count, physical memory in MiB, and cgroup v2 stats."""
    cpu_cores = os.cpu_count() or 4
    mem_total_mb = 16384
    mem_avail_mb = 12288

    if meminfo_path.is_file():
        try:
            raw = meminfo_path.read_text(encoding="utf-8", errors="replace")
            kv: dict[str, int] = {}
            for line in raw.splitlines():
                parts = line.split(":")
                if len(parts) != 2:
                    continue
                key = parts[0].strip()
                val_parts = parts[1].strip().split()
                if val_parts and val_parts[0].isdigit():
                    kv[key] = int(val_parts[0]) // 1024
            if "MemTotal" in kv and kv["MemTotal"] > 0:
                mem_total_mb = kv["MemTotal"]
            if "MemAvailable" in kv and kv["MemAvailable"] > 0:
                mem_avail_mb = kv["MemAvailable"]
            elif "MemFree" in kv:
                mem_avail_mb = kv["MemFree"] + kv.get("Cached", 0)
        except OSError:
            pass
    elif sys.platform == "darwin" and meminfo_path == Path("/proc/meminfo"):
        try:
            res = subprocess.run(
                ["sysctl", "-n", "hw.memsize"],
                capture_output=True,
                text=True,
                check=False,
                timeout=2.0,
            )
            if res.returncode == 0 and res.stdout.strip().isdigit():
                mem_total_mb = int(res.stdout.strip()) // MIB
                mem_avail_mb = int(mem_total_mb * 0.75)
        except Exception:
            pass

    cg = probe_cgroup_v2_memory(
        cgroup_root=cgroup_root, proc_cgroup_path=proc_cgroup_path
    )
    cg_max_mib = cg.get("cgroup_memory_max_mib")
    if isinstance(cg_max_mib, int) and cg_max_mib > 0:
        mem_total_mb = max(1024, min(mem_total_mb, cg_max_mib))

    mem_avail_mb = max(512, min(mem_total_mb, mem_avail_mb))
    cg_avail_mib = cg.get("cgroup_avail_mib")
    if isinstance(cg_avail_mib, int) and cg_avail_mib >= 0:
        mem_avail_mb = max(512, min(mem_total_mb, mem_avail_mb, cg_avail_mib))

    return {
        "cpu_cores": max(1, cpu_cores),
        "mem_total_mb": max(1024, mem_total_mb),
        "mem_avail_mb": max(512, min(mem_total_mb, mem_avail_mb)),
        **cg,
    }


def detect_mode(cmd: list[str], requested_mode: str) -> str:
    """Determines whether `cmd` is a single-file check or a workspace build."""
    if requested_mode in ("file", "build"):
        return requested_mode
    if not cmd:
        return "build"

    exe = Path(cmd[0]).name
    if exe == "lean" and "--run" not in cmd:
        return "file"
    if (
        exe == "lake"
        and len(cmd) >= 3
        and cmd[1] == "env"
        and Path(cmd[2]).name == "lean"
        and "--run" not in cmd
    ):
        return "file"
    return "build"


def compute_limits(
    hw: dict[str, Any],
    mode: str,
    concurrency: int,
    override_mem_mb: int | None = None,
    override_timeout_sec: int | None = None,
) -> dict[str, Any]:
    """Computes hardware-matched thread, RAM, and wall-clock limits."""
    w = max(1, concurrency)
    cpu_cores = max(1, int(hw["cpu_cores"]))
    mem_total_mb = max(1024, int(hw["mem_total_mb"]))
    mem_avail_mb = max(512, int(hw["mem_avail_mb"]))

    cg_max_mib = hw.get("cgroup_memory_max_mib")
    if isinstance(cg_max_mib, int) and cg_max_mib > 0:
        mem_total_mb = max(1024, min(mem_total_mb, cg_max_mib))

    mem_avail_mb = max(512, min(mem_total_mb, mem_avail_mb))
    cg_avail_mib = hw.get("cgroup_avail_mib")
    if isinstance(cg_avail_mib, int) and cg_avail_mib >= 0:
        mem_avail_mb = max(512, min(mem_total_mb, mem_avail_mb, cg_avail_mib))

    threads = max(1, cpu_cores // w)

    # Reserve at least 30% of total RAM for the OS, editors, and warm LSP
    # servers, and never allocate more than 80% of currently available RAM.
    per_worker_total_share = int((mem_total_mb * 0.70) // w)
    avail_share = int(mem_avail_mb * 0.80)

    if mode == "file":
        # A single `.lean` module check should never consume more than 15% of
        # total RAM or 16 GiB; exceeding that indicates an exponential kernel
        # `whnf` or `dsimp` blowup.
        file_ceiling = min(int(mem_total_mb * 0.15), 16384)
        computed_mem_mb = max(
            1024, min(per_worker_total_share, avail_share, file_ceiling)
        )
        default_timeout = 180
    else:
        computed_mem_mb = max(2048, min(per_worker_total_share, avail_share))
        default_timeout = 900

    memory_max_mb = (
        override_mem_mb
        if (override_mem_mb and override_mem_mb > 0)
        else computed_mem_mb
    )
    lean_m_mb = max(512, int(memory_max_mb * 0.75))
    timeout_sec = (
        override_timeout_sec
        if (override_timeout_sec and override_timeout_sec > 0)
        else default_timeout
    )

    # Number of concurrent heavy `lake build` / `cargo` slots the host can
    # safely sustain (~24 GiB physical RAM per concurrent full build, min 1).
    build_slots = max(1, mem_total_mb // 24576)

    return {
        "mode": mode,
        "concurrency": w,
        "cpu_cores": cpu_cores,
        "mem_total_mb": mem_total_mb,
        "mem_avail_mb": mem_avail_mb,
        "threads": threads,
        "memory_max_mb": memory_max_mb,
        "lean_m_mb": lean_m_mb,
        "timeout_sec": timeout_sec,
        "build_slots": build_slots,
        "cgroup_v2": bool(hw.get("cgroup_v2", False)),
        "cgroup_path": hw.get("cgroup_path"),
        "cgroup_anon_mib": hw.get("cgroup_anon_mib"),
        "cgroup_shmem_mib": hw.get("cgroup_shmem_mib"),
        "cgroup_anon_shmem_mib": hw.get("cgroup_anon_shmem_mib"),
        "cgroup_file_cache_mib": hw.get("cgroup_file_cache_mib"),
        "cgroup_current_mib": hw.get("cgroup_current_mib"),
        "cgroup_memory_max_mib": cg_max_mib if isinstance(cg_max_mib, int) else None,
        "cgroup_avail_mib": cg_avail_mib if isinstance(cg_avail_mib, int) else None,
    }


def format_cgroup_probe_line(limits: dict[str, Any]) -> str:
    """Formats the human-readable `Cgroup v2 Memory` line for `--probe`."""
    if not limits.get("cgroup_v2"):
        return "  Cgroup v2 Memory   : unavailable (using /proc/meminfo)"
    anon_shmem = limits.get("cgroup_anon_shmem_mib")
    anon = limits.get("cgroup_anon_mib")
    shmem = limits.get("cgroup_shmem_mib")
    file_cache = limits.get("cgroup_file_cache_mib")
    current = limits.get("cgroup_current_mib")
    cg_max = limits.get("cgroup_memory_max_mib")
    cg_avail = limits.get("cgroup_avail_mib")

    ws_str = (
        f"{anon_shmem} MiB (anon={anon} MiB, shmem={shmem} MiB)"
        if anon_shmem is not None
        else "n/a"
    )
    file_str = f"{file_cache} MiB" if file_cache is not None else "n/a"
    cur_str = f"{current} MiB" if current is not None else "n/a"
    if cg_max is not None:
        max_str = (
            f"{cg_max} MiB (avail={cg_avail} MiB)"
            if cg_avail is not None
            else f"{cg_max} MiB"
        )
    else:
        max_str = "unbounded"

    return (
        f"  Cgroup v2 Memory   : anon+shmem={ws_str}, "
        f"file={file_str}, current={cur_str}, memory.max={max_str}"
    )


def format_cgroup_diagnostic_snapshot(
    cg: dict[str, Any] | None = None,
    pid: int | None = None,
) -> str:
    """Formats a post-mortem cgroup v2 memory snapshot for timeout/OOM stderr diagnostics.

    When `pid` is provided (e.g. a timed-out child before `SIGKILL`), probes
    `/proc/<pid>/cgroup` first so transient `systemd-run --user --scope` stats
    are captured while the scope is still alive, falling back to `/proc/self/cgroup`.
    Never raises, so a telemetry failure can never turn a structured `124` /
    `137` diagnostic into a Python traceback with exit code `1`.
    """
    try:
        info = cg
        if info is None and pid is not None and pid > 0:
            pid_cg = Path(f"/proc/{pid}/cgroup")
            if pid_cg.is_file():
                cand = probe_cgroup_v2_memory(proc_cgroup_path=pid_cg)
                if cand.get("cgroup_v2"):
                    info = cand
        if info is None:
            info = probe_cgroup_v2_memory()
        if not info.get("cgroup_v2"):
            return ""
        anon_shmem = info.get("cgroup_anon_shmem_mib")
        file_cache = info.get("cgroup_file_cache_mib")
        current = info.get("cgroup_current_mib")
        cg_max = info.get("cgroup_memory_max_mib")
        cg_avail = info.get("cgroup_avail_mib")
        max_str = (
            f"{cg_max}M (avail={cg_avail}M)" if cg_max is not None else "unbounded"
        )
        return (
            f"  Cgroup v2 Snapshot : anon+shmem={anon_shmem}M, "
            f"file={file_cache}M, current={current}M, memory.max={max_str}\n"
        )
    except Exception:  # noqa: BLE001 - diagnostics must never mask exit codes
        return ""


def systemd_user_scope_available() -> bool:
    """Returns True if `systemd-run --user --scope` can create cgroup scopes."""
    if shutil.which("systemd-run") is None:
        return False
    try:
        res = subprocess.run(
            [
                "systemd-run",
                "--user",
                "--scope",
                "--quiet",
                "-p",
                "MemoryMax=512M",
                "true",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=3.0,
        )
        return res.returncode == 0
    except Exception:
        return False


@contextmanager
def acquire_build_slot(
    max_slots: int, timeout_sec: int, enabled: bool
) -> Iterator[int | None]:
    """Acquires one of `max_slots` host build locks to prevent RAM stampedes."""
    if not enabled or max_slots <= 0:
        yield None
        return

    runtime_base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    slot_dir = Path(runtime_base) / f"anneal-build-slots-{os.getuid()}"
    try:
        slot_dir.mkdir(parents=True, exist_ok=True)
    except OSError:
        yield None
        return

    deadline = time.monotonic() + max(30, timeout_sec)
    warned = False
    while True:
        for slot_idx in range(1, max_slots + 1):
            lock_path = slot_dir / f"slot-{slot_idx}.lock"
            try:
                fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
            except OSError:
                continue
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                try:
                    os.ftruncate(fd, 0)
                    os.write(
                        fd,
                        f"pid={os.getpid()} ts={int(time.time())}\n".encode(
                            "utf-8"
                        ),
                    )
                except OSError:
                    pass
                try:
                    yield slot_idx
                finally:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_UN)
                    except OSError:
                        pass
                    os.close(fd)
                return
            except BlockingIOError:
                os.close(fd)
                continue

        if time.monotonic() >= deadline:
            yield None
            return
        if not warned:
            sys.stderr.write(
                f"[anneal-lean-run] All {max_slots} host build slot(s) busy; "
                "queuing to prevent RAM/swap exhaustion...\n"
            )
            warned = True
        time.sleep(1.0)


def inject_lean_m_flag(cmd: list[str], lean_m_mb: int) -> list[str]:
    """Injects `-M <lean_m_mb>` into direct `lean` calls when absent."""
    if "-M" in cmd or any(a.startswith("-M") for a in cmd):
        return list(cmd)
    if not cmd:
        return []
    exe = Path(cmd[0]).name
    if exe == "lean" and "--run" not in cmd:
        return [cmd[0], "-M", str(lean_m_mb), *cmd[1:]]
    if (
        exe == "lake"
        and len(cmd) >= 3
        and cmd[1] == "env"
        and Path(cmd[2]).name == "lean"
        and "--run" not in cmd
    ):
        return [cmd[0], cmd[1], cmd[2], "-M", str(lean_m_mb), *cmd[3:]]
    return list(cmd)


class _ForwardSignal(BaseException):
    """Raised when `anneal-lean-run` receives a termination signal."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def terminate_process_group(pgid: int, grace_sec: float = 2.0) -> None:
    """Terminates process group `pgid` with `SIGTERM`, escalating to `SIGKILL`."""
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + grace_sec
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.1)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def run_bounded_command(
    cmd: list[str], limits: dict[str, Any], use_slot_lock: bool
) -> int:
    """Executes `cmd` inside the computed memory, swap, thread, and time bounds."""
    threads = int(limits["threads"])
    memory_max_mb = int(limits["memory_max_mb"])
    lean_m_mb = int(limits["lean_m_mb"])
    timeout_sec = int(limits["timeout_sec"])
    build_slots = int(limits["build_slots"])
    mode = str(limits["mode"])

    effective_cmd = inject_lean_m_flag(cmd, lean_m_mb)
    has_systemd_scope = systemd_user_scope_available()
    if has_systemd_scope:
        # Set `RuntimeMaxSec` slightly above `timeout_sec` so Python's `wait`
        # reports a structured timeout diagnostic under normal operation, while
        # `systemd` still reaps the transient scope if this wrapper receives an
        # uncatchable `SIGKILL`.
        full_cmd = [
            "systemd-run",
            "--user",
            "--scope",
            "--quiet",
            "-p",
            f"MemoryMax={memory_max_mb}M",
            "-p",
            "MemorySwapMax=0",
            "-p",
            f"CPUQuota={threads * 100}%",
            "-p",
            f"RuntimeMaxSec={timeout_sec + 5}s",
            "--",
            *effective_cmd,
        ]
    else:
        full_cmd = effective_cmd

    env = os.environ.copy()
    env.setdefault("LEAN_NUM_THREADS", str(threads))
    env.setdefault("CARGO_BUILD_JOBS", str(threads))
    env.setdefault("RAYON_NUM_THREADS", str(threads))

    need_slot = use_slot_lock and (mode == "build")
    with acquire_build_slot(build_slots, timeout_sec, enabled=need_slot):
        # `start_new_session=True` isolates descendants into process group
        # `proc.pid` for atomic group cleanup, which also detaches them from
        # signals sent to this wrapper's group unless forwarded explicitly.
        proc = subprocess.Popen(
            full_cmd,
            env=env,
            start_new_session=True,
        )
        prev_handlers: dict[int, object] = {}

        def _handle_signal(signum: int, _frame: object) -> None:
            raise _ForwardSignal(signum)

        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            prev_handlers[sig] = signal.getsignal(sig)
            signal.signal(sig, _handle_signal)
        try:
            rc = proc.wait(timeout=timeout_sec)
        except _ForwardSignal as caught:
            terminate_process_group(proc.pid)
            proc.wait()
            return 128 + caught.signum
        except subprocess.TimeoutExpired:
            cg_snap = format_cgroup_diagnostic_snapshot(pid=proc.pid)
            terminate_process_group(proc.pid)
            proc.wait()
            sys.stderr.write(
                f"\n[anneal-lean-run] ERROR: Command timed out after "
                f"{timeout_sec}s (mode={mode}, MemoryMax={memory_max_mb}M, "
                f"threads={threads}).\n"
                f"{cg_snap}"
                "  Remediation: Inspect proof goals interactively with "
                "`lean_goal` / wildcard `change ... _` "
                "(`skills/anneal-lsp/SKILL.md`) and apply the kernel "
                "proof-scaling patterns in `skills/anneal-prove/SKILL.md` "
                "(`BlockCtx`, `Hold` barrier, `bitwiseAndBitsFast`).\n"
            )
            return 124
        finally:
            for sig, handler in prev_handlers.items():
                signal.signal(sig, handler)  # type: ignore[arg-type]
            if proc.poll() is None:
                terminate_process_group(proc.pid)

    if rc in (137, -9):
        cg_snap = format_cgroup_diagnostic_snapshot()
        sys.stderr.write(
            f"\n[anneal-lean-run] ERROR: Command was terminated by the OS "
            f"memory guard (exit 137, MemoryMax={memory_max_mb}M, "
            f"MemorySwapMax=0, mode={mode}).\n"
            f"{cg_snap}"
            "  Why: The process exceeded its hardware-matched physical RAM "
            "ceiling and was killed before it could thrash host swap.\n"
            "  Remediation: Avoid unfolding multi-block "
            "`Mir.<Crate>.<Item>.body` or `wpMirExecSym` inside `dsimp`; "
            "use `BlockCtx`, `Hold`, and top-down wildcard `change` "
            "(`skills/anneal-prove/SKILL.md` Section 5).\n"
        )
        return 137

    return rc


def is_x20_path(bundle_path: str | Path) -> bool:
    """Returns True if `bundle_path` is an `/x20/` URI or `/google/data/r{w,o}/` path."""
    s = str(bundle_path).strip()
    if not s.startswith("/"):
        return False
    norm = posixpath.normpath(s)
    if norm.startswith("//"):
        norm = "/" + norm.lstrip("/")
    return (
        norm == "/x20"
        or norm.startswith(X20_URI_PREFIX)
        or any(
            norm == p.rstrip("/") or norm.startswith(p)
            for p in X20_FUSE_PREFIXES
        )
    )


def to_x20_uri(bundle_path: str | Path) -> str:
    """Translates `/google/data/r{w,o}/...` FUSE paths to normalized `/x20/...` URIs."""
    s = str(bundle_path).strip()
    if not s:
        return s
    if is_x20_path(s):
        norm = posixpath.normpath(s)
        if norm.startswith("//"):
            norm = "/" + norm.lstrip("/")
        for prefix in X20_FUSE_PREFIXES:
            base = prefix.rstrip("/")
            if norm == base:
                return "/x20"
            if norm.startswith(prefix):
                return posixpath.normpath(X20_URI_PREFIX + norm[len(prefix) :])
        return norm
    return s


def normalize_git_ref(ref: str) -> str:
    """Normalizes a branch shorthand (e.g. `unstable`) to `refs/heads/<branch>`."""
    r = ref.strip()
    if not r:
        return "refs/heads/unstable"
    if r == "HEAD" or r.startswith("refs/"):
        return r
    if r.startswith(("heads/", "tags/", "remotes/")):
        return f"refs/{r}"
    return f"refs/heads/{r}"


# Repository-location variables that Git exports to hooks and aliases (see
# `git rev-parse --local-env-vars` and githooks(5)). They are scrubbed from
# every `git` subprocess so that `--repo-dir` stays authoritative even when this
# guard runs inside a `pre-push` hook or `git x20-push` alias, where an inherited
# `GIT_DIR` / `GIT_INDEX_FILE` would otherwise silently redirect the ancestry
# check, dirty-worktree check, and ref update to a different repository/index.
_GIT_LOCAL_ENV_VARS: tuple[str, ...] = (
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_DIR",
    "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NO_REPLACE_OBJECTS",
    "GIT_OBJECT_DIRECTORY",
    "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE",
    "GIT_SHALLOW_FILE",
    "GIT_WORK_TREE",
)


def _git_env() -> dict[str, str]:
    env = os.environ.copy()
    for name in _GIT_LOCAL_ENV_VARS:
        env.pop(name, None)
    return env


def _run_git(
    args: list[str], cwd: Path | None = None
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["git", *args],
            cwd=str(cwd) if cwd is not None else None,
            env=_git_env(),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            check=False,
        )
    except OSError as exc:
        # Missing `git` binary or vanished `cwd`: report a failed command so
        # every caller fails closed instead of crashing with a traceback.
        return subprocess.CompletedProcess(
            ["git", *args], 127, "", f"failed to execute git: {exc}"
        )


FILEUTIL_CP_TIMEOUT_SEC = 300.0
FILEUTIL_STAT_TIMEOUT_SEC = 60.0

# Any of these in `fileutil` output vetoes a "not found" classification.
_X20_FATAL_ERROR_MARKERS: tuple[str, ...] = (
    "permission_denied",
    "permission denied",
    "deadline_exceeded",
    "deadline exceeded",
    "unauthenticated",
    "unavailable",
    "resource_exhausted",
    "internal error",
)


def _is_x20_remote_not_found(output: str, x20_uri: str) -> bool:
    """Returns True only for an x20 server-side NOT_FOUND that names `x20_uri`.

    Real `fileutil` failures look like:
      remote missing: `generic::not_found: /x20/<p>: File not found: /<p>
                       [storage_x20.pb.Error] { code: NO_SUCH_FILE_OR_DIRECTORY }`
      local failure : `generic::not_found: open failed for /tmp/<staged>:
                       No such file or directory`
    Generic "not found" / ENOENT text (e.g. a vanished local staging directory,
    a missing credential file) must never be mistaken for a missing remote
    bundle, because `no_remote_bundle` is a fail-open (`ok = True`) verdict.
    """
    lower = output.lower()
    if any(marker in lower for marker in _X20_FATAL_ERROR_MARKERS):
        return False
    uri = x20_uri.strip().rstrip("/").lower()
    if not uri:
        return False
    if f"not_found: {uri}:" in lower:
        return True
    return (
        "storage_x20" in lower
        and "no_such_file_or_directory" in lower
        and uri in lower
    )


def _x20_stat_exists(
    fileutil_bin: str, x20_uri: str
) -> tuple[bool | None, str]:
    """Independently probes `x20_uri` via `fileutil stat` (no local writes).

    Returns `(True, ...)` if the remote file exists, `(False, ...)` only for a
    confirmed x20 NOT_FOUND naming `x20_uri`, and `(None, detail)` otherwise.
    """
    try:
        res = subprocess.run(
            [
                fileutil_bin,
                "--x20_force_client_creation_at_head",
                "stat",
                x20_uri,
            ],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            check=False,
            timeout=FILEUTIL_STAT_TIMEOUT_SEC,
        )
    except Exception as exc:  # noqa: BLE001 - fail closed on any error
        return (None, f"fileutil stat could not run: {exc}")
    if res.returncode == 0:
        return (True, "fileutil stat reports the remote bundle exists")
    combined = f"{res.stderr}\n{res.stdout}"
    if _is_x20_remote_not_found(combined, x20_uri):
        return (False, "fileutil stat confirms the remote bundle does not exist")
    detail = res.stderr.strip() or res.stdout.strip() or f"exit code {res.returncode}"
    return (None, f"fileutil stat failed: {detail}")


def _x20_source_for(raw_str: str) -> str | None:
    """Returns the x20 path to stage via `fileutil`, or None for plain local files.

    Besides literal `/x20/` URIs and `/google/data/r{w,o}/` paths, this also
    catches local symlinks (e.g. `~/x20 -> /google/data/rw/users/...` or
    `~/bundle.bundle -> /x20/teams/...`) whose target lives on x20 or the
    `x20fsd` FUSE mount, so their contents are never read through FUSE's stale
    cached `st_size`.
    """
    if is_x20_path(raw_str):
        return raw_str
    try:
        cur = Path(raw_str)
        for _ in range(40):
            cur_str = str(cur)
            if is_x20_path(cur_str):
                return cur_str
            if not cur.is_symlink():
                break
            target = os.readlink(cur)
            if is_x20_path(target):
                return target
            cur = Path(
                os.path.normpath(os.path.join(os.path.dirname(cur_str), target))
            )
        real = os.path.realpath(raw_str)
    except (OSError, ValueError):
        return None
    return real if is_x20_path(real) else None


@contextmanager
def stage_bundle_for_verification(
    bundle_path: str | Path,
    fileutil_bin: str | None = None,
) -> Iterator[tuple[str, Path | None, str | None]]:
    """Safely stages a local or x20 bundle for inspection, cleaning up temporary files.

    Yields exactly once: `("staged", path, None)`, `("no_remote_bundle", None,
    None)`, or `("bundle_error", None, detail)`.
    """
    raw_str = str(bundle_path).strip()
    if not raw_str:
        yield ("bundle_error", None, "Empty bundle path")
        return

    x20_source = _x20_source_for(raw_str)
    if x20_source is not None:
        x20_uri = to_x20_uri(x20_source)
        eff_fileutil = fileutil_bin
        if eff_fileutil is None:
            eff_fileutil = (
                "/usr/bin/fileutil"
                if Path("/usr/bin/fileutil").is_file()
                else shutil.which("fileutil")
            )
        if not eff_fileutil:
            yield (
                "bundle_error",
                None,
                f"fileutil is required to stage x20 bundle {x20_uri} safely without FUSE",
            )
            return

        try:
            tmpdir = Path(tempfile.mkdtemp(prefix="anneal-bundle-ff-"))
        except OSError as exc:
            yield (
                "bundle_error",
                None,
                f"Cannot create a local staging directory for {x20_uri}: {exc}",
            )
            return
        try:
            staged_file = tmpdir / "remote.bundle"
            status: str = "bundle_error"
            staged: Path | None = None
            detail_msg: str | None = None
            try:
                res = subprocess.run(
                    [
                        eff_fileutil,
                        "--x20_force_client_creation_at_head",
                        "cp",
                        "-f",
                        x20_uri,
                        str(staged_file),
                    ],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    text=True,
                    encoding="utf-8",
                    errors="replace",
                    check=False,
                    timeout=FILEUTIL_CP_TIMEOUT_SEC,
                )
            except Exception as exc:  # noqa: BLE001 - fail closed on any error
                res = None
                detail_msg = f"Failed executing fileutil for {x20_uri}: {exc}"

            if res is not None and res.returncode != 0:
                combined = f"{res.stderr}\n{res.stdout}"
                cp_detail = (
                    res.stderr.strip()
                    or res.stdout.strip()
                    or f"exit code {res.returncode}"
                )
                if _is_x20_remote_not_found(combined, x20_uri):
                    # Double-check with an independent `fileutil stat` before
                    # emitting the fail-open `no_remote_bundle` verdict.
                    exists, stat_detail = _x20_stat_exists(eff_fileutil, x20_uri)
                    if exists is False:
                        status = "no_remote_bundle"
                    else:
                        detail_msg = (
                            f"fileutil cp reported {x20_uri} as missing but the "
                            f"existence re-check disagreed ({stat_detail}); "
                            f"cp error: {cp_detail}"
                        )
                else:
                    detail_msg = f"fileutil cp failed for {x20_uri}: {cp_detail}"
            elif res is not None:
                try:
                    size = (
                        staged_file.stat().st_size if staged_file.is_file() else 0
                    )
                except OSError as exc:
                    size = 0
                    detail_msg = f"Cannot stat staged bundle from {x20_uri}: {exc}"
                if size > 0:
                    status, staged = "staged", staged_file
                elif detail_msg is None:
                    detail_msg = f"Staged bundle from {x20_uri} is missing or empty"

            yield (status, staged, None if status != "bundle_error" else detail_msg)
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)
        return

    local_p = Path(raw_str)
    local_status: str
    local_staged: Path | None = None
    local_detail: str | None = None
    try:
        if local_p.is_symlink() and not local_p.exists():
            local_status = "bundle_error"
            local_detail = f"Bundle path {raw_str} is a broken symlink"
        elif not local_p.exists():
            local_status = "no_remote_bundle"
        elif not local_p.is_file():
            local_status = "bundle_error"
            local_detail = f"Bundle path {raw_str} is not a regular file"
        elif local_p.stat().st_size == 0:
            local_status = "bundle_error"
            local_detail = f"Bundle file {raw_str} is empty (0 bytes)"
        else:
            local_status = "staged"
            local_staged = local_p.resolve()
    except OSError as exc:
        local_status = "bundle_error"
        local_staged = None
        local_detail = f"Cannot access bundle {raw_str}: {exc}"
    # Yield outside the `try` so exceptions raised by the caller's `with` body
    # propagate instead of being swallowed into a second `yield`.
    yield (local_status, local_staged, local_detail)


def parse_bundle_heads(
    bundle_file: Path,
    cwd: Path | None = None,
) -> tuple[bool, dict[str, str], str | None]:
    """Runs `git bundle list-heads` on `bundle_file` and returns `(ok, ref_map, error)`.

    `cwd` should be the local repository being verified, so that bundles
    without an explicit `@object-format` capability are parsed with that
    repository's hash algorithm rather than whatever repository happens to
    contain the caller's working directory.
    """
    try:
        bundle_arg = str(Path(bundle_file).resolve())
    except OSError:
        bundle_arg = str(bundle_file)
    res = _run_git(["bundle", "list-heads", "--", bundle_arg], cwd=cwd)
    if res.returncode != 0:
        detail = (
            res.stderr.strip()
            or res.stdout.strip()
            or f"git bundle list-heads exited with {res.returncode}"
        )
        return (False, {}, detail)

    heads: dict[str, str] = {}
    for raw_line in res.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 2:
            return (
                False,
                {},
                f"Malformed line in git bundle list-heads output: {line!r}",
            )
        sha, ref_name = parts[0].lower(), parts[1]
        # 40 hex digits for SHA-1 repositories, 64 for SHA-256 repositories.
        if len(sha) not in (40, 64) or any(
            c not in "0123456789abcdef" for c in sha
        ):
            return (
                False,
                {},
                f"Invalid commit SHA in git bundle list-heads output: {sha!r}",
            )
        heads[ref_name] = sha

    if not heads:
        return (False, {}, "Bundle lists zero heads")
    return (True, heads, None)


def _resolve_commit(repo_path: Path, rev: str) -> str | None:
    if not rev or rev.startswith("-"):
        return None
    res = _run_git(
        ["rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}"], cwd=repo_path
    )
    out = res.stdout.strip().lower()
    return out if (res.returncode == 0 and out) else None


def _worktree_git_dir(wt_path: Path) -> Path | None:
    """Resolves the per-worktree git directory for `wt_path`."""
    try:
        dot_git = wt_path / ".git"
        if dot_git.is_dir():
            return dot_git.resolve()
        if dot_git.is_file():
            raw = dot_git.read_text(encoding="utf-8", errors="replace").strip()
            if raw.startswith("gitdir:"):
                gd_str = raw[len("gitdir:") :].strip()
                gd_path = Path(gd_str)
                if not gd_path.is_absolute():
                    gd_path = wt_path / gd_path
                return gd_path.resolve()
    except OSError:
        pass
    res = _run_git(["rev-parse", "--git-dir"], cwd=wt_path)
    if res.returncode != 0 or not res.stdout.strip():
        return None
    gd_path = Path(res.stdout.strip())
    if not gd_path.is_absolute():
        gd_path = wt_path / gd_path
    try:
        return gd_path.resolve()
    except OSError:
        return gd_path


def _worktree_detached_target_ref(git_dir: Path) -> str | None:
    """Returns the normalized branch ref being rebased/bisected in `git_dir`, if any."""
    for rel in ("rebase-merge/head-name", "rebase-apply/head-name", "BISECT_START"):
        p = git_dir / rel
        try:
            if p.is_file():
                val = p.read_text(encoding="utf-8", errors="replace").strip()
                if val:
                    return normalize_git_ref(val)
        except OSError:
            continue
    return None


def _worktree_in_progress_operation(git_dir: Path) -> str | None:
    """Returns the name of any in-progress git sequencer/merge operation in `git_dir`."""
    for marker in (
        "MERGE_HEAD",
        "CHERRY_PICK_HEAD",
        "REVERT_HEAD",
        "BISECT_LOG",
        "BISECT_START",
        "rebase-merge",
        "rebase-apply",
    ):
        try:
            if (git_dir / marker).exists():
                return marker
        except OSError:
            continue
    return None


def _sync_local_ref_to_remote(
    repo_path: Path,
    normalized_ref: str,
    old_tip: str | None,
    new_tip: str,
) -> tuple[bool, str | None]:
    """Safely advances `normalized_ref` to `new_tip`, checking all linked worktrees.

    Only local branches (`refs/heads/*`) are ever moved: `git update-ref HEAD`
    would silently move whichever branch is checked out underneath its index
    and working tree, and tags/remote-tracking refs are not ours to rewrite.
    Non-checked-out branches are moved with an atomic compare-and-swap
    (`git update-ref <ref> <new> <old>`, or `<new> ""` to require that a
    missing ref is still absent), and the final ref value is re-verified.
    """
    if not normalized_ref.startswith("refs/heads/"):
        return (
            False,
            "`--sync-if-behind` only fast-forwards local branches "
            f"(refs/heads/*); refusing to move {normalized_ref}",
        )

    top_res = _run_git(["rev-parse", "--show-toplevel"], cwd=repo_path)
    current_toplevel = (
        Path(top_res.stdout.strip()).resolve()
        if (top_res.returncode == 0 and top_res.stdout.strip())
        else None
    )

    wt_res = _run_git(["worktree", "list", "--porcelain"], cwd=repo_path)
    if wt_res.returncode != 0:
        return (
            False,
            wt_res.stderr.strip() or "Failed to inspect git worktree list",
        )

    stanzas: list[dict[str, str]] = []
    cur_stanza: dict[str, str] = {}
    for raw_line in wt_res.stdout.splitlines():
        line = raw_line.strip()
        if not line:
            if cur_stanza:
                stanzas.append(cur_stanza)
                cur_stanza = {}
            continue
        if line.startswith("worktree "):
            if cur_stanza:
                stanzas.append(cur_stanza)
            cur_stanza = {"worktree": line[len("worktree ") :].strip()}
        elif line.startswith("branch "):
            cur_stanza["branch"] = line[len("branch ") :].strip()
    if cur_stanza:
        stanzas.append(cur_stanza)

    reflog_msg = (
        f"anneal-lean-run --sync-if-behind: fast-forward {normalized_ref} "
        f"{old_tip or '(new)'} -> {new_tip}"
    )
    synced_via_checkout = False
    for entry in stanzas:
        wt_str = entry.get("worktree", "")
        if not wt_str:
            continue
        try:
            wt_path = Path(wt_str).resolve()
        except OSError:
            return (False, f"Cannot resolve worktree path {wt_str}")

        wt_git_dir = _worktree_git_dir(wt_path)
        if wt_git_dir is not None:
            detached_ref = _worktree_detached_target_ref(wt_git_dir)
            if detached_ref == normalized_ref:
                return (
                    False,
                    f"{normalized_ref} has an active rebase or bisect in worktree {wt_path}",
                )

        if entry.get("branch") != normalized_ref:
            continue

        if current_toplevel is None or wt_path != current_toplevel:
            return (
                False,
                f"{normalized_ref} is checked out in linked worktree {wt_path}",
            )

        if wt_git_dir is not None:
            op_marker = _worktree_in_progress_operation(wt_git_dir)
            if op_marker is not None:
                return (
                    False,
                    f"{normalized_ref} has an in-progress git operation ({op_marker}) in worktree {current_toplevel}",
                )

        st_res = _run_git(["status", "--porcelain"], cwd=current_toplevel)
        if st_res.returncode != 0 or st_res.stdout.strip():
            return (
                False,
                f"{normalized_ref} is checked out in dirty worktree {current_toplevel}",
            )

        if old_tip is not None:
            ff_res = _run_git(
                ["merge", "--ff-only", "--", new_tip], cwd=current_toplevel
            )
        else:
            # `<ref>` is the unborn branch of a clean worktree.
            ff_res = _run_git(
                ["reset", "--hard", new_tip], cwd=current_toplevel
            )
        if ff_res.returncode != 0:
            return (
                False,
                ff_res.stderr.strip() or "git merge --ff-only failed",
            )
        synced_via_checkout = True
        break

    if not synced_via_checkout:
        up_res = _run_git(
            [
                "update-ref",
                "-m",
                reflog_msg,
                "--",
                normalized_ref,
                new_tip,
                old_tip if old_tip is not None else "",
            ],
            cwd=repo_path,
        )
        if up_res.returncode != 0:
            return (False, up_res.stderr.strip() or "git update-ref failed")

    actual = _resolve_commit(repo_path, normalized_ref)
    if actual != new_tip.lower():
        return (
            False,
            f"post-sync verification failed: {normalized_ref} is at "
            f"{actual or '<missing>'}, expected {new_tip}",
        )
    return (True, None)


def verify_bundle_ff(
    bundle_path: str | Path,
    ref: str = "refs/heads/unstable",
    repo_dir: str | Path = ".",
    local_rev: str | None = None,
    sync_if_behind: bool = False,
    fileutil_bin: str | None = None,
) -> dict[str, Any]:
    """Verifies that local `ref` (or `local_rev`) is a fast-forward descendant of `bundle_path`."""
    bundle_str = str(bundle_path)
    normalized_ref = normalize_git_ref(ref)
    repo_path = Path(repo_dir)
    local_rev_clean = local_rev.strip() if local_rev is not None else ""
    local_rev_is_override = bool(
        local_rev_clean and normalize_git_ref(local_rev_clean) != normalized_ref
    )
    # When `--local-rev` merely spells `--ref` (e.g. `unstable`), resolve the
    # fully-qualified ref: git's DWIM order (`refs/tags/<x>` before
    # `refs/heads/<x>`) would otherwise let a same-named tag shadow the branch
    # that `git bundle create ... --branches` actually exports.
    target_local_rev = local_rev_clean if local_rev_is_override else normalized_ref
    # Name the revision actually compared in human-readable messages.
    local_label = (
        f"{target_local_rev} [--local-rev for {normalized_ref}]"
        if local_rev_is_override
        else normalized_ref
    )

    def _verdict(
        ok: bool,
        status: str,
        remote_tip: str | None,
        local_tip: str | None,
        synced: bool,
        message: str,
    ) -> dict[str, Any]:
        return {
            "ok": ok,
            "status": status,
            "bundle_path": bundle_str,
            "ref": normalized_ref,
            "remote_tip": remote_tip,
            "local_tip": local_tip,
            "synced": synced,
            "message": message,
        }

    is_git_repo = False
    local_tip: str | None = None
    try:
        if repo_path.is_dir():
            git_chk = _run_git(["rev-parse", "--git-dir"], cwd=repo_path)
            if git_chk.returncode == 0:
                is_git_repo = True
                local_tip = _resolve_commit(repo_path, target_local_rev)
    except OSError:
        is_git_repo = False
        local_tip = None

    with stage_bundle_for_verification(
        bundle_path, fileutil_bin=fileutil_bin
    ) as (stage_status, staged_path, stage_err):
        if stage_status == "no_remote_bundle":
            return _verdict(
                ok=True,
                status="no_remote_bundle",
                remote_tip=None,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Remote bundle {bundle_str} does not exist yet; "
                    "first-time bundle export is allowed."
                ),
            )

        if stage_status != "staged" or staged_path is None:
            return _verdict(
                ok=False,
                status="bundle_error",
                remote_tip=None,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Failed to stage or read remote bundle {bundle_str}: "
                    f"{stage_err or 'unknown error'} (failing closed)."
                ),
            )

        ok_heads, heads, heads_err = parse_bundle_heads(
            staged_path, cwd=repo_path if is_git_repo else None
        )
        if not ok_heads:
            return _verdict(
                ok=False,
                status="bundle_error",
                remote_tip=None,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Corrupt or unreadable remote bundle {bundle_str}: "
                    f"{heads_err or 'git bundle list-heads failed'} (failing closed)."
                ),
            )

        remote_tip = heads.get(normalized_ref)
        if remote_tip is None:
            return _verdict(
                ok=True,
                status="no_remote_ref",
                remote_tip=None,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Ref {normalized_ref} is not present in remote bundle "
                    f"{bundle_str}; export is allowed."
                ),
            )

        if not is_git_repo or local_tip is None:
            if not is_git_repo or not sync_if_behind or local_rev_is_override:
                reason = (
                    f"Directory {repo_path} is not a valid Git repository"
                    if not is_git_repo
                    else f"Local ref/revision {target_local_rev} does not exist in {repo_path}"
                )
                return _verdict(
                    ok=False,
                    status="missing_local_ref",
                    remote_tip=remote_tip,
                    local_tip=None,
                    synced=False,
                    message=(
                        f"{reason} while remote bundle {bundle_str} has "
                        f"{normalized_ref} at {remote_tip}. Remediation: run "
                        "`git x20-pull` or pass `--sync-if-behind` before exporting."
                    ),
                )

            fetch_res = _run_git(
                ["fetch", "--no-tags", "--quiet", "--", str(staged_path), normalized_ref],
                cwd=repo_path,
            )
            has_obj = (
                _run_git(
                    ["cat-file", "-e", f"{remote_tip}^{{commit}}"],
                    cwd=repo_path,
                ).returncode
                == 0
            )
            if fetch_res.returncode != 0 or not has_obj:
                detail = (
                    fetch_res.stderr.strip()
                    or "failed to fetch remote_tip commit from bundle"
                )
                return _verdict(
                    ok=False,
                    status="bundle_error",
                    remote_tip=remote_tip,
                    local_tip=None,
                    synced=False,
                    message=(
                        f"Failed fetching {normalized_ref} ({remote_tip}) from "
                        f"bundle {bundle_str}: {detail} (failing closed)."
                    ),
                )

            sync_ok, sync_err = _sync_local_ref_to_remote(
                repo_path, normalized_ref, None, remote_tip
            )
            if not sync_ok:
                return _verdict(
                    ok=False,
                    status="missing_local_ref",
                    remote_tip=remote_tip,
                    local_tip=None,
                    synced=False,
                    message=(
                        f"Local {normalized_ref} is missing and `--sync-if-behind` "
                        f"could not create it at {remote_tip}: {sync_err}."
                    ),
                )
            return _verdict(
                ok=True,
                status="synced_missing_local_ref",
                remote_tip=remote_tip,
                local_tip=remote_tip,
                synced=True,
                message=(
                    f"Fetched and created missing local {normalized_ref} at "
                    f"{remote_tip} from {bundle_str}."
                ),
            )

        if local_tip == remote_tip:
            return _verdict(
                ok=True,
                status="up_to_date",
                remote_tip=remote_tip,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Local {local_label} ({local_tip}) matches remote "
                    f"bundle {bundle_str} ({remote_tip})."
                ),
            )

        has_remote_obj = (
            _run_git(
                ["cat-file", "-e", f"{remote_tip}^{{commit}}"], cwd=repo_path
            ).returncode
            == 0
        )
        if has_remote_obj:
            is_ff = (
                _run_git(
                    ["merge-base", "--is-ancestor", remote_tip, local_tip],
                    cwd=repo_path,
                ).returncode
                == 0
            )
            if is_ff:
                return _verdict(
                    ok=True,
                    status="fast_forward",
                    remote_tip=remote_tip,
                    local_tip=local_tip,
                    synced=False,
                    message=(
                        f"Local {local_label} ({local_tip}) is a fast-forward "
                        f"descendant of remote bundle {bundle_str} ({remote_tip})."
                    ),
                )
        else:
            if not sync_if_behind:
                return _verdict(
                    ok=False,
                    status="unfetched_remote_tip",
                    remote_tip=remote_tip,
                    local_tip=local_tip,
                    synced=False,
                    message=(
                        f"Remote bundle {bundle_str} has {normalized_ref} at "
                        f"{remote_tip}, which is not present in local repository "
                        f"{repo_path} (local tip: {local_tip}). Remediation: run "
                        "`git x20-pull` or pass `--sync-if-behind` before exporting."
                    ),
                )

            fetch_res = _run_git(
                ["fetch", "--no-tags", "--quiet", "--", str(staged_path), normalized_ref],
                cwd=repo_path,
            )
            has_remote_obj = (
                _run_git(
                    ["cat-file", "-e", f"{remote_tip}^{{commit}}"],
                    cwd=repo_path,
                ).returncode
                == 0
            )
            if fetch_res.returncode != 0 or not has_remote_obj:
                detail = (
                    fetch_res.stderr.strip()
                    or "failed to fetch remote_tip commit from bundle"
                )
                return _verdict(
                    ok=False,
                    status="bundle_error",
                    remote_tip=remote_tip,
                    local_tip=local_tip,
                    synced=False,
                    message=(
                        f"Failed fetching {normalized_ref} ({remote_tip}) from "
                        f"bundle {bundle_str}: {detail} (failing closed)."
                    ),
                )

            if (
                _run_git(
                    ["merge-base", "--is-ancestor", remote_tip, local_tip],
                    cwd=repo_path,
                ).returncode
                == 0
            ):
                return _verdict(
                    ok=True,
                    status="fast_forward",
                    remote_tip=remote_tip,
                    local_tip=local_tip,
                    synced=False,
                    message=(
                        f"Local {local_label} ({local_tip}) is a fast-forward "
                        f"descendant of remote bundle {bundle_str} ({remote_tip})."
                    ),
                )

        is_behind = (
            _run_git(
                ["merge-base", "--is-ancestor", local_tip, remote_tip],
                cwd=repo_path,
            ).returncode
            == 0
        )
        if not is_behind:
            return _verdict(
                ok=False,
                status="diverged",
                remote_tip=remote_tip,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Local {local_label} ({local_tip}) has diverged from "
                    f"remote bundle {bundle_str} tip ({remote_tip}); neither is "
                    "an ancestor of the other. Remediation: run `git x20-pull` "
                    f"and rebase or merge {normalized_ref} before exporting."
                ),
            )

        cnt_res = _run_git(
            ["rev-list", "--count", f"{local_tip}..{remote_tip}"],
            cwd=repo_path,
        )
        behind_count = (
            int(cnt_res.stdout.strip())
            if (cnt_res.returncode == 0 and cnt_res.stdout.strip().isdigit())
            else 1
        )

        if not sync_if_behind or local_rev_is_override:
            return _verdict(
                ok=False,
                status="stale_behind",
                remote_tip=remote_tip,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Local {local_label} ({local_tip}) is stale "
                    f"({behind_count} commit(s) behind remote bundle {bundle_str} "
                    f"tip {remote_tip}). Remediation: run `git x20-pull` or "
                    "pass `--sync-if-behind` to fast-forward before exporting."
                ),
            )

        sync_ok, sync_err = _sync_local_ref_to_remote(
            repo_path, normalized_ref, local_tip, remote_tip
        )
        if not sync_ok:
            return _verdict(
                ok=False,
                status="stale_behind",
                remote_tip=remote_tip,
                local_tip=local_tip,
                synced=False,
                message=(
                    f"Local {local_label} ({local_tip}) is stale "
                    f"({behind_count} commit(s) behind remote bundle {bundle_str} "
                    f"tip {remote_tip}), and `--sync-if-behind` refused to "
                    f"update: {sync_err}. Remediation: clean the worktree or "
                    "run `git x20-pull` before exporting."
                ),
            )

        return _verdict(
            ok=True,
            status="synced_fast_forward",
            remote_tip=remote_tip,
            local_tip=remote_tip,
            synced=True,
            message=(
                f"Fast-forwarded local {normalized_ref} from {local_tip} to "
                f"remote bundle {bundle_str} tip {remote_tip} "
                f"({behind_count} commit(s))."
            ),
        )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description=(
            "Run `lake`, `lean`, or `cargo` commands with hardware-matched "
            "CPU thread, physical RAM (`MemoryMax`), zero-swap "
            "(`MemorySwapMax=0`), and wall-clock timeout limits, or verify "
            "fast-forward bundle ancestry (`--verify-bundle-ff`)."
        )
    )
    p.add_argument(
        "--probe",
        "--print-limits",
        dest="probe",
        action="store_true",
        help=(
            "Print detected host hardware, cgroup v2 working-set stats, and "
            "computed resource limits without running a command."
        ),
    )
    p.add_argument(
        "--json",
        action="store_true",
        help=(
            "Format `--probe` / `--print-limits` or `--verify-bundle-ff` "
            "output as JSON."
        ),
    )
    p.add_argument(
        "--mode",
        choices=("auto", "file", "build"),
        default="auto",
        help=(
            "Resource profile: 'file' for single-file `lean` checks, 'build' "
            "for `lake build`/`cargo` (default: auto)."
        ),
    )
    p.add_argument(
        "--concurrency",
        "-W",
        type=int,
        default=_env_int("ANNEAL_WORKTREE_CONCURRENCY", 1),
        help=(
            "Number of concurrent active build worktrees sharing this host "
            "(default: $ANNEAL_WORKTREE_CONCURRENCY or 1)."
        ),
    )
    p.add_argument(
        "--memory-max-mb",
        type=int,
        default=_env_int("ANNEAL_LEAN_MEMORY_MAX_MB", 0) or None,
        help="Override the computed hard physical RAM ceiling in MiB.",
    )
    p.add_argument(
        "--timeout",
        type=int,
        default=_env_int("ANNEAL_LEAN_TIMEOUT_SEC", 0) or None,
        help=(
            "Override the wall-clock timeout in seconds (default: 180s for "
            "file, 900s for build)."
        ),
    )
    p.add_argument(
        "--no-slot-lock",
        action="store_true",
        help="Disable the host-wide concurrent build slot lock for `build` mode.",
    )
    p.add_argument(
        "--verify-bundle-ff",
        "--check-unstable-ff",
        dest="verify_bundle_ff",
        metavar="BUNDLE_PATH",
        default=None,
        help=(
            "Verify that local `--ref` (default: refs/heads/unstable) is a "
            "fast-forward descendant of `--ref` in BUNDLE_PATH before exporting."
        ),
    )
    p.add_argument(
        "--ref",
        default="refs/heads/unstable",
        help=(
            "Git ref to check with `--verify-bundle-ff` "
            "(default: refs/heads/unstable)."
        ),
    )
    p.add_argument(
        "--repo-dir",
        default=".",
        help="Local Git repository directory for `--verify-bundle-ff` (default: .).",
    )
    p.add_argument(
        "--local-rev",
        default=None,
        help=(
            "Optional local commit/ref override for `--verify-bundle-ff` "
            "(default: same as `--ref`)."
        ),
    )
    p.add_argument(
        "--sync-if-behind",
        action="store_true",
        help=(
            "When `--verify-bundle-ff` detects that local `--ref` is missing "
            "or strictly behind the remote bundle tip, safely fetch and "
            "fast-forward local `--ref`."
        ),
    )
    p.add_argument(
        "cmd",
        nargs=argparse.REMAINDER,
        help=(
            "Command and arguments to execute (e.g., `lake build` or "
            "`lake env lean File.lean`)."
        ),
    )
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    cmd = list(args.cmd)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    if args.verify_bundle_ff is not None:
        if args.probe or cmd:
            sys.stderr.write(
                "[anneal-lean-run] ERROR: `--verify-bundle-ff` cannot be "
                "combined with `--probe` or a command execution.\n"
            )
            return 2
        verdict = verify_bundle_ff(
            bundle_path=args.verify_bundle_ff,
            ref=args.ref,
            repo_dir=args.repo_dir,
            local_rev=args.local_rev,
            sync_if_behind=args.sync_if_behind,
        )
        if not verdict["ok"]:
            sys.stderr.write(f"[anneal-lean-run] ERROR: {verdict['message']}\n")
        if args.json:
            print(json.dumps(verdict, indent=2))
        elif verdict["ok"]:
            print(
                f"[anneal-lean-run] OK ({verdict['status']}): "
                f"{verdict['message']}"
            )
        return 0 if verdict["ok"] else 1

    hw = probe_host_hardware()
    eff_mode = detect_mode(cmd, args.mode)
    limits = compute_limits(
        hw=hw,
        mode=eff_mode,
        concurrency=args.concurrency,
        override_mem_mb=args.memory_max_mb,
        override_timeout_sec=args.timeout,
    )

    if args.probe or not cmd:
        if not args.probe and not cmd:
            parser.print_help(sys.stderr)
            return 2
        limits["systemd_user_scope"] = systemd_user_scope_available()
        if args.json:
            print(json.dumps(limits, indent=2))
        else:
            print(
                f"=== Anneal Hardware-Matched Resource Limits "
                f"(mode={limits['mode']}, W={limits['concurrency']}) ===\n"
                f"  Host CPUs          : {limits['cpu_cores']} logical cores\n"
                f"  Host Physical RAM  : {limits['mem_total_mb']} MiB total, "
                f"{limits['mem_avail_mb']} MiB available\n"
                f"{format_cgroup_probe_line(limits)}\n"
                f"  Thread Budget (-j) : {limits['threads']} threads "
                f"(LEAN_NUM_THREADS={limits['threads']})\n"
                f"  Hard RAM Cap       : {limits['memory_max_mb']} MiB "
                f"(MemorySwapMax=0, lean -M {limits['lean_m_mb']})\n"
                f"  Wall-Clock Timeout : {limits['timeout_sec']}s\n"
                f"  Host Build Slots   : {limits['build_slots']} concurrent build(s)\n"
                f"  Systemd User Scope : {limits['systemd_user_scope']}"
            )
        return 0

    return run_bounded_command(
        cmd=cmd,
        limits=limits,
        use_slot_lock=not args.no_slot_lock,
    )


if __name__ == "__main__":
    sys.exit(main())
