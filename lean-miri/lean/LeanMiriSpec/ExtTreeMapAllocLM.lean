/-- **End-to-end `FnEntry` retag → intra-call access → `BorrowTree.releaseProtector` simulation
contrasting `writableChildWrite` (`&mut T`) vs `rustcNoWritable` (`#[rustc_no_writable]`)**
(`charon#1619` + `lean-miri#74`):
for ANY allocation `id`, ANY mutable live `alloc` carrying the 2-node `[root: Unique, sib: Frozen]`
tree over ANY nonzero size `len` (`0 < len < 2^64`), and ANY `sibProtected : Bool`:
1. **`writableChildWrite` (`rustcNoWritable = false`)**:
   * `RetagPolicy.create` yields `.Unique` + `.StrongProtector`;
   * when `sibProtected = true`, **BOTH** vendored `RetagPipeline.retagPointerValue` fails with
     `.error (.treeAccess ...)` AND theory `execFnEntryMutRetagPrunedSourceOrder … .writableChildWrite`
     fails with `.error (.protectedForeignConflict 1)`;
   * when `sibProtected = false`, **BOTH** succeed, sibling `2` is disabled (`.Frozen → .Disabled`),
     child `3` is strongly protected `.Unique`, an intra-call Read on sibling `2` fails (`.Disabled`)
     while an intra-call Write on child `3` succeeds on BOTH sides, AND `BorrowTree.releaseProtector`
     executes a real implicit **Write** matching `execFrameExitMiri` while preserving
     `BorrowTreeWorldRel`.
2. **`rustcNoWritable` (`rustcNoWritable = true`, BOTH `sibProtected = false` and `true`)**:
   * `RetagPolicy.create` yields `.ReservedFrz false` + `.StrongProtector`;
   * **BOTH** vendored `RetagPipeline.retagPointerValue` AND theory
     `execFnEntryMutRetagPrunedSourceOrder … .rustcNoWritable` SUCCEED, minting strongly protected
     child `3` as `.ReservedFrz false` (`accessed = true`) while **preserving sibling `2` as
     `.Frozen`**;
   * an intra-call Read on sibling `2` AND an intra-call Read on child `3` BOTH succeed on BOTH
     vendored `BorrowTree.performBorrowAccessRange` and theory `execWorldRangeRead` while preserving
     sibling `2 : Frozen`;
   * `BorrowTree.releaseProtector` executes a real implicit **Read** (`ReservedFrz false`,
     `accessed = true`), SUCCEEDS for BOTH `sibProtected = false` and `true`, preserves sibling `2`
     as `.Frozen`, AND matches `execFrameExitMiri` via `BorrowTreeWorldRel` / `realAccessReleaseSim`. -/
theorem fnEntry_endToEnd_writableChildWrite_vs_rustcNoWritable {MachineKind : Type}
    [DecidableEq MachineKind]
    (id : Miri.Memory.AllocId)
    (alloc : Miri.Memory.Allocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree)
    (kind : Miri.Memory.MemoryKind MachineKind)
    (len : Nat) (hlenPos : 0 < len) (hlenU64 : len < 2 ^ 64)
    (hmut : alloc.mutability = .Mut)
    (hextra : alloc.extra = fnEntryContrastInitTree (UInt64.ofNat len)) :
    let s := UInt64.ofNat len
    let sz := Miri.ABI.Size.ofBytes s
    let tagOf : Miri.Memory.BorTag → Nat := fun t => t.value.toNat - 1
    let w0 := fnEntryContrastInitWorld len
    Miri.TreeBorrows.RetagPolicy.create ⟨true, true, true⟩ .Mutable .FnEntry ⟨true, false⟩ =
      some ⟨.Unique, .Unique, .ReservedFrz false, some .StrongProtector⟩ ∧
    Miri.TreeBorrows.RetagPolicy.create ⟨true, true, true⟩ .Mutable .FnEntry ⟨true, true⟩ =
      some ⟨.ReservedFrz false, .ReservedFrz false, .ReservedFrz false, some .StrongProtector⟩ ∧
    ((Miri.TreeBorrows.RetagPipeline.retagPointerValue
        (fnEntryContrastMachine id alloc kind true)
        (fnEntryContrastRequest id s false)).outcome =
      .error (.treeAccess ⟨0, s⟩ (.AccessFailure ⟨0, s⟩ (.TransitionError 1 (.ProtectedDisabled .Frozen)))) ∧
     execFnEntryMutRetagPrunedSourceOrder (w0 true) 0 0 len .writableChildWrite =
      .error (.protectedForeignConflict 1)) ∧
    (let res := Miri.TreeBorrows.RetagPipeline.retagPointerValue
        (fnEntryContrastMachine id alloc kind false)
        (fnEntryContrastRequest id s false);
      res.outcome = .ok (some (.concrete id ⟨3, by decide⟩)) ∧
      res.state.frame.protectedTags = #[(id, ⟨3, by decide⟩)] ∧
      ∃ entry w1 w1Dense,
        res.state.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        execFnEntryMutRetagPrunedSourceOrder (w0 false) 0 0 len .writableChildWrite = .ok (w1, 2) ∧
        (∀ t, findNode? w1.nodes t = findNode? w1Dense.nodes t) ∧
        w1.activeProtectors = w1Dense.activeProtectors ∧
        BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
          entry.allocation.extra w1Dense ∧
        (entry.allocation.extra.performBorrowAccessRange (.concrete ⟨2, by decide⟩)
          Miri.ABI.Size.ZERO sz .Read res.state.global.protectedTags .VisitChildrenOfAccessed).status =
          .AccessFailure ⟨0, s⟩ (.TransitionError 1 (.ChildAccessForbidden .Disabled)) ∧
        (execWorldRangeRead w1 1 0 len).isOk = false ∧
        (let intra := entry.allocation.extra.performBorrowAccessRange (.concrete ⟨3, by decide⟩)
            Miri.ABI.Size.ZERO sz .Write res.state.global.protectedTags .VisitChildrenOfAccessed;
          intra.status = .Completed ∧
          ∃ w2 w2Dense,
            execWorldRangeWrite w1 2 0 len = .ok w2 ∧
            (∀ t, findNode? w2.nodes t = findNode? w2Dense.nodes t) ∧
            w2.activeProtectors = w2Dense.activeProtectors ∧
            BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
              intra.tree w2Dense ∧
            (let rel := intra.tree.releaseProtector ⟨3, by decide⟩ res.state.global.protectedTags;
              rel.status = .Released ∧
              ∃ w3 w3Dense,
                execProtectorEndAccessFor protectorEndAccessIsWrite? w2 2 = .ok w3 ∧
                execFrameExitMiri w2 [(2, 20)] = .ok (releaseProtectors w3 [20]) ∧
                (∀ t, findNode? w3.nodes t = findNode? w3Dense.nodes t) ∧
                w3.activeProtectors = w3Dense.activeProtectors ∧
                BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
                  rel.tree w3Dense))) ∧
    (∀ sibProtected : Bool,
      let res := Miri.TreeBorrows.RetagPipeline.retagPointerValue
        (fnEntryContrastMachine id alloc kind sibProtected)
        (fnEntryContrastRequest id s true);
      res.outcome = .ok (some (.concrete id ⟨3, by decide⟩)) ∧
      res.state.frame.protectedTags = #[(id, ⟨3, by decide⟩)] ∧
      ∃ entry w1 w1Dense,
        res.state.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        execFnEntryMutRetagPrunedSourceOrder (w0 sibProtected) 0 0 len .rustcNoWritable = .ok (w1, 2) ∧
        (∀ t, findNode? w1.nodes t = findNode? w1Dense.nodes t) ∧
        w1.activeProtectors = w1Dense.activeProtectors ∧
        BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
          entry.allocation.extra w1Dense ∧
        (let sibRead := entry.allocation.extra.performBorrowAccessRange (.concrete ⟨2, by decide⟩)
            Miri.ABI.Size.ZERO sz .Read res.state.global.protectedTags .VisitChildrenOfAccessed;
          sibRead.status = .Completed ∧
          ∃ w2, execWorldRangeRead w1 1 0 len = .ok w2 ∧
            (let childRead := sibRead.tree.performBorrowAccessRange (.concrete ⟨3, by decide⟩)
              Miri.ABI.Size.ZERO sz .Read res.state.global.protectedTags .VisitChildrenOfAccessed;
              childRead.status = .Completed ∧
              ∃ w3 w3Dense,
                execWorldRangeRead w2 2 0 len = .ok w3 ∧
                (∀ t, findNode? w3.nodes t = findNode? w3Dense.nodes t) ∧
                w3.activeProtectors = w3Dense.activeProtectors ∧
                BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
                  childRead.tree w3Dense ∧
                (let rel := childRead.tree.releaseProtector ⟨3, by decide⟩ res.state.global.protectedTags;
                  rel.status = .Released ∧
                  (rel.tree.locations.entries[0]?.bind fun seg =>
                    (seg.data.perms.get ⟨1⟩).map (·.permission)) = some .Frozen ∧
                  ∃ w4 w4Dense,
                    execProtectorEndAccessFor protectorEndAccessIsWrite? w3 2 = .ok w4 ∧
                    execFrameExitMiri w3 [(2, 20)] = .ok (releaseProtectors w4 [20]) ∧
                    (findNode? w4.nodes 1).map (·.perm) = some .frozen ∧
                    (∀ t, findNode? w4.nodes t = findNode? w4Dense.nodes t) ∧
                    w4.activeProtectors = w4Dense.activeProtectors ∧
                    BorrowTreeWorldRel res.state.global.protectedTags (fun t => t = ⟨3, by decide⟩) tagOf
                      rel.tree w4Dense)))) :=
  let hw := fnEntry_endToEnd_writable_part id alloc kind len hlenPos hlenU64 hmut hextra
  ⟨rfl, rfl, hw.1, hw.2, fnEntry_endToEnd_noWritable_part id alloc kind len hlenPos hlenU64 hmut hextra⟩

/-! ### 2E.2 Multi-reader & multi-byte vector-clock correspondence and full end-to-end
`AllocationMachine.deallocate` ↔ `KeyedAllocWorld.deallocateMachine` lockstep (`lean-miri#73`) -/

private theorem vclock_allLE_iff_forall_lt :
    ∀ (xs ys : List Miri.Concurrency.VTimestamp),
      (miri_etm_private% Miri.Concurrency.VectorClock Miri.Concurrency.VClock.allLE) xs ys = true ↔
        ∀ i, i < xs.length → i < ys.length →
          (xs.getD i Miri.Concurrency.VTimestamp.ZERO).time ≤
            (ys.getD i Miri.Concurrency.VTimestamp.ZERO).time
  | [], _ => by
    constructor
    · intro _ i hi; cases hi
    · intro _; rfl
  | _ :: _, [] => by
    constructor
    · intro _ i _ hi; cases hi
    · intro _; rfl
  | x :: xs, y :: ys => by
    change (decide (x.time ≤ y.time) &&
        (miri_etm_private% Miri.Concurrency.VectorClock Miri.Concurrency.VClock.allLE) xs ys) = true ↔ _
    rw [Bool.and_eq_true, decide_eq_true_eq, vclock_allLE_iff_forall_lt xs ys]
    constructor
    · rintro ⟨hxy, hrest⟩ i hiX hiY
      cases i with
      | zero => exact hxy
      | succ i' =>
        simp only [List.length_cons, Nat.succ_lt_succ_iff] at hiX hiY
        exact hrest i' hiX hiY
    · intro h
      refine ⟨h 0 (Nat.zero_lt_succ _) (Nat.zero_lt_succ _), fun i hiX hiY => ?_⟩
      exact h (i + 1) (Nat.succ_lt_succ hiX) (Nat.succ_lt_succ hiY)

/-- **Pointwise vector-clock ordering characterization** (`lean-miri#73`, choice-free):
because vendored `VClock` enforces canonical trailing-zero-free representation
(`last_time_nonzero`), `left.le right = true` holds iff EVERY coordinate `i : Nat` satisfies
`left[i].time ≤ right[i].time` (defaulting out-of-range coordinates to `VTimestamp.ZERO`). -/
theorem vclock_le_iff_forall_index (left right : Miri.Concurrency.VClock) :
    left.le right = true ↔
      ∀ i : Nat, (left.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≤
        (right.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time := by
  unfold Miri.Concurrency.VClock.le Miri.Concurrency.VClock.length
  rw [Bool.and_eq_true, decide_eq_true_eq, vclock_allLE_iff_forall_lt]
  constructor
  · rintro ⟨hlen, hall⟩ i
    by_cases hi : i < left.asList.length
    · exact hall i hi (Nat.lt_of_lt_of_le hi hlen)
    · have hge : left.asList.length ≤ i := Nat.le_of_not_lt hi
      have hget : left.asList.getD i Miri.Concurrency.VTimestamp.ZERO =
          Miri.Concurrency.VTimestamp.ZERO := by
        simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hge]
      rw [hget]
      exact Nat.zero_le _
  · intro h
    have hlen : left.asList.length ≤ right.asList.length := by
      cases left with
      | zero => exact Nat.zero_le _
      | nonzero earlier last hnz =>
        have hi := h earlier.length
        have hleftAt : ((earlier ++ [last]).getD earlier.length Miri.Concurrency.VTimestamp.ZERO) = last := by
          simp [List.getD_eq_getElem?_getD]
        have hi' : last.time ≤ (right.asList.getD earlier.length Miri.Concurrency.VTimestamp.ZERO).time := by
          simpa [Miri.Concurrency.VClock.asList, hleftAt] using hi
        have hlenL : (Miri.Concurrency.VClock.nonzero earlier last hnz).asList.length = earlier.length + 1 := by
          simp [Miri.Concurrency.VClock.asList]
        rw [hlenL]
        match Nat.lt_or_ge earlier.length right.asList.length with
        | .inl hlt => omega
        | .inr hge =>
          have hrightAt : right.asList.getD earlier.length Miri.Concurrency.VTimestamp.ZERO =
              Miri.Concurrency.VTimestamp.ZERO := by
            simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hge]
          rw [hrightAt] at hi'
          have hz : Miri.Concurrency.VTimestamp.ZERO.time = 0 := rfl
          rw [hz] at hi'
          exact absurd (Nat.le_zero.mp hi') hnz
    exact ⟨hlen, fun i _ _ => h i⟩

/-- **Multi-reader vector-clock correspondence relation** connecting a vendored `MemoryCellClocks`
(plus active deallocating thread `thread`) to a theory `RaceClockEntry` and `DeallocActor`, covering
the last writer, primary reader, AND arbitrarily many concurrent `extraReaders`. -/
structure ClockEntryRel (actor : DeallocActor) (thread : Miri.Concurrency.ThreadClockSet)
    (cell : Miri.Concurrency.MemoryCellClocks) (clk : RaceClockEntry) : Prop where
  noAtomic : cell.atomicOps = none
  selfWriteOrdered : clk.writerThread = actor.threadId →
    cell.write.2.time ≤ (thread.clock.index cell.write.1).time
  otherWriteSync : clk.writerThread ≠ actor.threadId →
    cell.write.2.time = clk.writeTimestamp.toNat ∧
    (thread.clock.index cell.write.1).time = (actor.viewFor clk.writerThread).toNat
  readsSound : ∀ i : Nat,
    (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≠ 0 →
    (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≤
      (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ∨
    ∃ rt rts, (rt, rts) ∈ (clk.readerThread, clk.readTimestamp) :: clk.extraReaders ∧
      rt ≠ actor.threadId ∧
      (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time = rts.toNat ∧
      (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time = (actor.viewFor rt).toNat
  readsComplete : ∀ rt rts,
    (rt, rts) ∈ (clk.readerThread, clk.readTimestamp) :: clk.extraReaders →
    rt ≠ actor.threadId →
    ∃ i : Nat,
      (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time = rts.toNat ∧
      (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time = (actor.viewFor rt).toNat

/-- **Multi-reader single-cell deallocation race iff** (`lean-miri#73`, choice-free):
generalizes `nonAtomicWriteDetect_dealloc_writer_race_iff` to arbitrary concurrent reader sets
(`clk.readerThread` + arbitrary `clk.extraReaders`) and arbitrary `DeallocActor`. -/
theorem nonAtomicWriteDetect_dealloc_multiReader_race_iff
    (actor : DeallocActor) (thread : Miri.Concurrency.ThreadClockSet)
    (actorIdx : Miri.Concurrency.VectorIdx)
    (cell : Miri.Concurrency.MemoryCellClocks) (clk : RaceClockEntry)
    (hrel : ClockEntryRel actor thread cell clk) :
    (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).result =
      if hasDeallocDataRace actor clk then .race else .ok := by
  have hwriterIff : cell.writeWasBefore thread.clock = false ↔
      (clk.writerThread != actor.threadId && clk.writeTimestamp != 0 &&
        decide (actor.viewFor clk.writerThread < clk.writeTimestamp)) = true := by
    unfold Miri.Concurrency.MemoryCellClocks.writeWasBefore
    if hself : clk.writerThread = actor.threadId then
      have hord := hrel.selfWriteOrdered hself
      simp [hself, hord]
    else
      obtain ⟨hwt, hvw⟩ := hrel.otherWriteSync hself
      have hneB : (clk.writerThread != actor.threadId) = true := bne_iff_ne.mpr hself
      simp only [hneB, Bool.true_and, hwt, hvw, decide_eq_false_iff_not, Bool.and_eq_true,
        decide_eq_true_eq, bne_iff_ne, UInt64.lt_iff_toNat_lt]
      constructor
      · intro hnotLe
        refine ⟨fun hz => by rw [hz] at hnotLe; exact hnotLe (Nat.zero_le _), Nat.lt_of_not_le hnotLe⟩
      · rintro ⟨_, hlt⟩; exact Nat.not_le_of_gt hlt
  have hreadIff : cell.read.le thread.clock = false ↔
      ((clk.readerThread != actor.threadId && clk.readTimestamp != 0 &&
          decide (actor.viewFor clk.readerThread < clk.readTimestamp)) ||
       clk.extraReaders.any fun (rt, rts) =>
         rt != actor.threadId && rts != 0 && decide (actor.viewFor rt < rts)) = true := by
    have hmemIff :
        ((clk.readerThread != actor.threadId && clk.readTimestamp != 0 &&
            decide (actor.viewFor clk.readerThread < clk.readTimestamp)) ||
         clk.extraReaders.any fun (rt, rts) =>
           rt != actor.threadId && rts != 0 && decide (actor.viewFor rt < rts)) = true ↔
        ∃ rt rts, (rt, rts) ∈ (clk.readerThread, clk.readTimestamp) :: clk.extraReaders ∧
          rt ≠ actor.threadId ∧ rts ≠ 0 ∧ actor.viewFor rt < rts := by
      simp only [Bool.or_eq_true, Bool.and_eq_true, bne_iff_ne, decide_eq_true_eq,
        List.any_eq_true, List.mem_cons]
      constructor
      · rintro (⟨⟨h1, h2⟩, h3⟩ | ⟨⟨rt, rts⟩, hmem, ⟨h1, h2⟩, h3⟩)
        · exact ⟨clk.readerThread, clk.readTimestamp, Or.inl rfl, h1, h2, h3⟩
        · exact ⟨rt, rts, Or.inr hmem, h1, h2, h3⟩
      · rintro ⟨rt, rts, hmem, h1, h2, h3⟩
        rcases hmem with hEq | hrest
        · injection hEq with hrt hrts; subst hrt; subst hrts
          exact Or.inl ⟨⟨h1, h2⟩, h3⟩
        · exact Or.inr ⟨(rt, rts), hrest, ⟨h1, h2⟩, h3⟩
    rw [hmemIff]
    constructor
    · intro hleFalse
      -- Scan `0 .. cell.read.asList.length - 1` constructively to find a violating coordinate `i`.
      have hnotAll : ¬ ∀ i : Nat, (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≤
          (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time := by
        intro hall
        have ht := (vclock_le_iff_forall_index cell.read thread.clock).mpr hall
        rw [ht] at hleFalse; cases hleFalse
      have hfindViol : ∀ (n : Nat),
          (∀ i ≥ n, (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≤
            (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time) →
          ∃ i < n, (thread.clock.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time <
            (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time := by
        intro n
        induction n with
        | zero =>
          intro hall
          exact absurd (fun i => hall i (Nat.zero_le _)) hnotAll
        | succ m ih =>
          intro hge
          match Nat.lt_or_ge (thread.clock.asList.getD m Miri.Concurrency.VTimestamp.ZERO).time
              (cell.read.asList.getD m Miri.Concurrency.VTimestamp.ZERO).time with
          | .inl hlt => exact ⟨m, Nat.lt_succ_self _, hlt⟩
          | .inr hleM =>
            obtain ⟨i, hi, hlt⟩ := ih (fun k hk => by
              cases Nat.eq_or_lt_of_le hk with
              | inl hEq => subst hEq; exact hleM
              | inr hgt => exact hge k hgt)
            exact ⟨i, Nat.lt_succ_of_lt hi, hlt⟩
      obtain ⟨i, _, hviol⟩ := hfindViol cell.read.asList.length (fun k hk => by
        have hget : cell.read.asList.getD k Miri.Concurrency.VTimestamp.ZERO =
            Miri.Concurrency.VTimestamp.ZERO := by
          simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hk]
        rw [hget]; exact Nat.zero_le _)
      have hnz : (cell.read.asList.getD i Miri.Concurrency.VTimestamp.ZERO).time ≠ 0 :=
        fun hz => by rw [hz] at hviol; exact Nat.not_lt_zero _ hviol
      rcases hrel.readsSound i hnz with hok | ⟨rt, rts, hmem, hne, hrEq, hvEq⟩
      · exact absurd hviol (Nat.not_lt.mpr hok)
      · rw [hrEq, hvEq] at hviol
        refine ⟨rt, rts, hmem, hne, fun hz => by rw [hz] at hviol; simp at hviol, ?_⟩
        rw [UInt64.lt_iff_toNat_lt]; exact hviol
    · rintro ⟨rt, rts, hmem, hne, _, hlt⟩
      obtain ⟨i, hrEq, hvEq⟩ := hrel.readsComplete rt rts hmem hne
      cases hle : cell.read.le thread.clock with
      | false => rfl
      | true =>
        have hleI := (vclock_le_iff_forall_index cell.read thread.clock).mp hle i
        rw [hrEq, hvEq] at hleI
        rw [UInt64.lt_iff_toNat_lt] at hlt
        exact absurd hlt (Nat.not_lt.mpr hleI)
  unfold Miri.Concurrency.MemoryCellClocks.nonAtomicWriteDetect hasDeallocDataRace
  simp only [hrel.noAtomic, Option.all_none, Bool.and_true]
  cases hw : cell.writeWasBefore thread.clock <;> cases hr : cell.read.le thread.clock
  · have h1 := hwriterIff.mp hw
    simp [h1]
  · have h1 := hwriterIff.mp hw
    simp [h1]
  · have h2 := hreadIff.mp hr
    simp only [Bool.true_and, Bool.not_false, ↓reduceIte, Bool.or_assoc, h2, Bool.or_true]
  · have h1 : (clk.writerThread != actor.threadId && clk.writeTimestamp != 0 &&
        decide (actor.viewFor clk.writerThread < clk.writeTimestamp)) = false := by
      cases hb : (clk.writerThread != actor.threadId && clk.writeTimestamp != 0 &&
          decide (actor.viewFor clk.writerThread < clk.writeTimestamp)) with
      | false => rfl
      | true => have := hwriterIff.mpr hb; rw [hw] at this; cases this
    have h2 : ((clk.readerThread != actor.threadId && clk.readTimestamp != 0 &&
          decide (actor.viewFor clk.readerThread < clk.readTimestamp)) ||
        clk.extraReaders.any fun (rt, rts) =>
          rt != actor.threadId && rts != 0 && decide (actor.viewFor rt < rts)) = false := by
      cases hb : ((clk.readerThread != actor.threadId && clk.readTimestamp != 0 &&
          decide (actor.viewFor clk.readerThread < clk.readTimestamp)) ||
        clk.extraReaders.any fun (rt, rts) =>
          rt != actor.threadId && rts != 0 && decide (actor.viewFor rt < rts)) with
      | false => rfl
      | true => have := hreadIff.mpr hb; rw [hr] at this; cases this
    simp [h1, h2]

private theorem vclockAlloc_cellAt_setCell_ne (alloc : Miri.Concurrency.VClockAlloc)
    (off k : Nat) (cell : Miri.Concurrency.MemoryCellClocks) (hlt : off < alloc.allocRanges.length.bytes)
    (hne : k ≠ off) :
    (Miri.Concurrency.VClockAlloc.mk
      { alloc.allocRanges with
        overrides := (off, cell) ::
          (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides)
            alloc.allocRanges.overrides off }).cellAt k = alloc.cellAt k := by
  have hfindRem : ∀ (xs : List (Nat × Miri.Concurrency.MemoryCellClocks)),
      (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.findOverride)
        ((miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides) xs off) k =
      (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.findOverride) xs k := by
    intro xs
    induction xs with
    | nil =>
      rw [miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides.eq_1]
    | cons p rest ih =>
      obtain ⟨o, v⟩ := p
      rw [miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides.eq_2,
        miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.findOverride.eq_2]
      if hoo : o = off then
        subst hoo
        simp only [↓reduceIte, Ne.symm hne]
        exact ih
      else
        simp only [hoo, ↓reduceIte]
        rw [miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.findOverride.eq_2]
        if hok : o = k then
          simp [hok]
        else
          simp only [hok, ↓reduceIte]; exact ih
  unfold Miri.Concurrency.VClockAlloc.cellAt Miri.Concurrency.AllocationRanges.cellAt
  if hk : k < alloc.allocRanges.length.bytes then
    simp only [hk, ↓reduceIte]
    rw [miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.findOverride.eq_2]
    simp only [Ne.symm hne, ↓reduceIte, hfindRem]
  else
    simp [hk]

/-- **Multi-byte uniform `VClockAlloc.writeNonAtomic` deallocation race iff** (`lean-miri#73`,
choice-free): for any nonzero allocation `[0, len)` whose bytes share cell clock state `cell`
matching `ClockEntryRel actor thread cell clk`, vendored `VClockAlloc.writeNonAtomic` across the
full range `[0, len)` returns `.race` iff `hasDeallocDataRace actor clk = true` and `.ok` otherwise!
This directly discharges the detecting-race hypothesis of `memoryRaceAccess_dealloc_rel_machineDeallocHook`. -/
theorem writeNonAtomic_uniform_dealloc_race_iff
    (alloc : Miri.Concurrency.VClockAlloc) (thread : Miri.Concurrency.ThreadClockSet)
    (actorIdx : Miri.Concurrency.VectorIdx) (actor : DeallocActor)
    (cell : Miri.Concurrency.MemoryCellClocks) (clk : RaceClockEntry)
    (len : Nat) (hlenPos : 0 < len) (hlenU64 : len < 2 ^ 64)
    (hlenLe : len ≤ alloc.allocRanges.length.bytes)
    (huniform : ∀ k, k < len → alloc.cellAt k = .ok cell)
    (hrel : ClockEntryRel actor thread cell clk) :
    (alloc.writeNonAtomic
      ⟨Miri.Concurrency.ByteSize.ofU64 0 (by decide),
       Miri.Concurrency.ByteSize.ofU64 len hlenU64⟩
      thread actorIdx .Deallocate).result =
      if hasDeallocDataRace actor clk then .race else .ok := by
  have hcellRes := nonAtomicWriteDetect_dealloc_multiReader_race_iff actor thread actorIdx cell clk hrel
  have hcellTh : (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).thread = thread := by
    unfold Miri.Concurrency.MemoryCellClocks.nonAtomicWriteDetect
    dsimp only
    split <;> rfl
  unfold Miri.Concurrency.VClockAlloc.writeNonAtomic Miri.Concurrency.VClockAlloc.runRange
  simp only [Miri.Concurrency.ByteSize.bytes_ofU64, Nat.zero_add, hlenLe, ↓reduceIte]
  cases hr : hasDeallocDataRace actor clk with
  | true =>
    rw [hr] at hcellRes
    obtain ⟨rem, rfl⟩ : ∃ m, len = m + 1 := ⟨len - 1, (Nat.sub_add_cancel hlenPos).symm⟩
    have hc0 := huniform 0 (Nat.zero_lt_succ _)
    have hlt0 : 0 < alloc.allocRanges.length.bytes :=
      Nat.lt_of_lt_of_le (Nat.zero_lt_succ rem) hlenLe
    have hset0 : alloc.setCell 0 (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).cell =
        .ok (Miri.Concurrency.VClockAlloc.mk { alloc.allocRanges with
          overrides := (0, (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).cell) ::
            (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides)
              alloc.allocRanges.overrides 0 }) := by
      unfold Miri.Concurrency.VClockAlloc.setCell Miri.Concurrency.AllocationRanges.setCell
      simp [hlt0, bind, Bind.bind, Except.bind, pure, Pure.pure, Except.pure]
    change (match alloc.cellAt 0 with
      | .error failure => ({ allocation := alloc, thread := thread, result := failure } : Miri.Concurrency.VClockAlloc.RangeTransition)
      | .ok c =>
        let t := c.nonAtomicWriteDetect thread actorIdx .Deallocate
        match alloc.setCell 0 t.cell with
        | .error failure => ({ allocation := alloc, thread := t.thread, result := failure } : Miri.Concurrency.VClockAlloc.RangeTransition)
        | .ok u => if t.result = Miri.Concurrency.DataRaceResult.ok then _
            else ({ allocation := u, thread := t.thread, result := t.result } : Miri.Concurrency.VClockAlloc.RangeTransition)).result =
      Miri.Concurrency.DataRaceResult.race
    rw [hc0]; dsimp only; rw [hset0, hcellRes]; rfl
  | false =>
    rw [hr] at hcellRes
    have hloop : ∀ (rem off : Nat) (a : Miri.Concurrency.VClockAlloc),
        off + rem ≤ a.allocRanges.length.bytes →
        (∀ k, off ≤ k → k < off + rem → a.cellAt k = .ok cell) →
        ((miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.VClockAlloc.runRangeLoop)
          a thread (fun c t => c.nonAtomicWriteDetect t actorIdx .Deallocate) off rem).result = .ok := by
      intro rem
      induction rem with
      | zero => intro _ _ _ _; rfl
      | succ rem' ih =>
        intro off a hbd hunif
        have hcOff := hunif off (Nat.le_refl _) (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem'))
        have hltOff : off < a.allocRanges.length.bytes :=
          Nat.lt_of_lt_of_le (Nat.lt_add_of_pos_right (Nat.zero_lt_succ rem')) hbd
        let a' : Miri.Concurrency.VClockAlloc :=
          ⟨{ a.allocRanges with
             overrides := (off, (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).cell) ::
               (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.AllocationRanges.removeOverrides)
                 a.allocRanges.overrides off }⟩
        have hset : a.setCell off (cell.nonAtomicWriteDetect thread actorIdx .Deallocate).cell = .ok a' := by
          unfold Miri.Concurrency.VClockAlloc.setCell Miri.Concurrency.AllocationRanges.setCell
          simp [hltOff, bind, Bind.bind, Except.bind, pure, Pure.pure, Except.pure, a']
        change (match a.cellAt off with
          | .error failure => ({ allocation := a, thread := thread, result := failure } : Miri.Concurrency.VClockAlloc.RangeTransition)
          | .ok c =>
            let t := c.nonAtomicWriteDetect thread actorIdx .Deallocate
            match a.setCell off t.cell with
            | .error failure => ({ allocation := a, thread := t.thread, result := failure } : Miri.Concurrency.VClockAlloc.RangeTransition)
            | .ok u =>
              if t.result = Miri.Concurrency.DataRaceResult.ok then
                (miri_etm_private% Miri.Concurrency.DataRace Miri.Concurrency.VClockAlloc.runRangeLoop)
                  u t.thread (fun c t => c.nonAtomicWriteDetect t actorIdx .Deallocate) (off + 1) rem'
              else ({ allocation := u, thread := t.thread, result := t.result } : Miri.Concurrency.VClockAlloc.RangeTransition)).result =
          Miri.Concurrency.DataRaceResult.ok
        rw [hcOff]; dsimp only; rw [hset, hcellRes, hcellTh]
        exact ih (off + 1) a'
          (by change off + 1 + rem' ≤ a.allocRanges.length.bytes
              rw [Nat.add_assoc, Nat.add_comm 1 rem']; exact hbd)
          (fun k hk1 hk2 => by
            rw [vclockAlloc_cellAt_setCell_ne a off k _ hltOff (Nat.ne_of_gt (Nat.lt_of_succ_le hk1))]
            exact hunif k (Nat.le_of_succ_le hk1)
              (by rw [Nat.add_assoc, Nat.add_comm 1 rem'] at hk2; exact hk2))
    exact hloop len 0 alloc (by rw [Nat.zero_add]; exact hlenLe)
      (fun k _ hk => huniform k (by rw [Nat.zero_add] at hk; exact hk))

/-- Congruence of `KeyedAllocWorld.deallocateWith` under two hook functions with identical `.isOk`
verdict: `world`, `detached`, and all non-hook outcomes are identical, while `.hookFailure` outcomes
correspond 1-to-1. -/
theorem keyed_deallocateWith_hook_congr (w : KeyedAllocWorld) (ptr : DeallocPtr)
    (expectedLayout : Option (UInt64 × UInt8)) (expectedKind : AllocMemKind)
    (h1 h2 : KeyedAllocWorld → MiriAllocId → LiveAllocEntry → Except String Unit)
    (hsame : ∀ w' id e,
      match h1 w' id e, h2 w' id e with
      | .ok (), .ok () => True
      | .error _, .error _ => True
      | _, _ => False) :
    let r1 := w.deallocateWith ptr expectedLayout expectedKind h1
    let r2 := w.deallocateWith ptr expectedLayout expectedKind h2
    r1.world = r2.world ∧
    r1.detached = r2.detached ∧
    (match r1.outcome, r2.outcome with
     | .ok (), .ok () => True
     | .error (.hookFailure _), .error (.hookFailure _) => True
     | .error e1, .error e2 => e1 = e2
     | _, _ => False) := by
  dsimp only
  unfold KeyedAllocWorld.deallocateWith
  cases ptr with
  | dangling addr => exact ⟨rfl, rfl, rfl⟩
  | provenanced id off =>
    by_cases hoff : off != 0
    · simp only [hoff, ↓reduceIte]; exact ⟨trivial, trivial, trivial⟩
    · simp only [hoff, Bool.false_eq_true, ↓reduceIte]
      cases hrem : w.removeLive id with
      | mk wAfter entry? =>
        cases entry? with
        | none =>
          cases w.findGlobal? id <;> exact ⟨rfl, rfl, rfl⟩
        | some entry =>
          cases hm : entry.mutability == .not with
          | true => simp only [hm, ↓reduceIte]; exact ⟨trivial, trivial, trivial⟩
          | false =>
            simp only [hm, Bool.false_eq_true, ↓reduceIte]
            cases hk : entry.kind != expectedKind with
            | true => simp only [↓reduceIte]; exact ⟨trivial, trivial, trivial⟩
            | false =>
              simp only [Bool.false_eq_true, ↓reduceIte]
              cases hl : deallocLayoutMismatch? entry expectedLayout with
              | some _ => exact ⟨rfl, rfl, rfl⟩
              | none =>
                have hs := hsame wAfter id entry
                cases hh1 : h1 wAfter id entry <;> cases hh2 : h2 wAfter id entry
                · exact ⟨rfl, rfl, trivial⟩
                · rw [hh1, hh2] at hs; exact False.elim hs
                · rw [hh1, hh2] at hs; exact False.elim hs
                · cases wAfter.findDead? id
                  · exact ⟨rfl, rfl, trivial⟩
                  · exact ⟨rfl, rfl, rfl⟩

/-- Project a full vendored `MachineHooks.MachineState` (BOTH `memory` AND `raceAllocations`) into
a `KeyedAllocWorld`. -/
def machineToKeyed {K User : Type}
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (m : Miri.Interpreter.MachineHooks.MachineState K User) : KeyedAllocWorld :=
  memoryStateToKeyed proj m.memory
    (m.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))

private theorem memoryStateToKeyed_filter_race {K : Type}
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (mem : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (races : Array (Miri.Memory.AllocId × Miri.Concurrency.VClockAlloc))
    (id : Miri.Memory.AllocId) :
    memoryStateToKeyed proj mem
      ((races.filter fun e => e.1 != id).toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)) =
    (memoryStateToKeyed proj mem
      (races.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))).removeRace (ofMiriAllocId id) := by
  apply KeyedAllocWorld.ext
  · rfl
  · rfl
  · intro _; rfl
  · intro _; rfl
  · intro _; rfl
  · intro _; rfl
  · intro q
    unfold memoryStateToKeyed memoryStateToLinear KeyedAllocWorld.ofLinear
      KeyedAllocWorld.removeRace KeyedAllocWorld.findRace?
    dsimp only [MiriAllocRows.toLinear, memoryStateToRows]
    rw [get?_ofLinearRows, Array.toList_filter]
    have hfilt : (races.toList.filter fun e => e.1 != id).map
        (fun p => (ofMiriAllocId p.1, raceEntryOf p.2)) =
        (races.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)).filter
          (fun p => p.1 != ofMiriAllocId id) := by
      rw [List.filter_map]; congr 1; apply congrArg (List.filter · _); funext row
      simp only [Function.comp_apply, bne, ofMiriAllocId_beq]
    rw [hfilt, linearFind?_filter_ne]
    by_cases hq : q = ofMiriAllocId id
    · subst hq
      simp only [beq_self_eq_true, ↓reduceIte, ExtTreeMap0.get?_erase_self]
    · simp only [beq_false_of_ne hq, Bool.false_eq_true, ↓reduceIte]
      rw [ExtTreeMap0.get?_erase_ne _ hq, get?_ofLinearRows]

/-- Exact outcome relation between vendored `AllocationMachine.deallocate` (`Except StepError Unit`)
and theory `KeyedAllocWorld.deallocateMachine` (`Except DeallocErr Unit`) across ALL 12 branches:
clean live→dead, all 8 lifecycle errors via `deallocErrOfMiri`, missing race clock, detecting data
race, and Tree Borrows protected deallocation. -/
inductive DeallocMachineOutcomeRel {K User Payload : Type}
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload) :
    Except Miri.Interpreter.StepError Unit → Except DeallocErr Unit → Prop
  | ok : DeallocMachineOutcomeRel h (.ok ()) (.ok ())
  | lifecycle (me : Miri.Memory.MemoryLifecycleError) (ke : DeallocErr)
      (hmap : deallocErrOfMiri me = some ke)
      (hnotHook : ∀ name msg, me ≠ .hookFailure name msg) :
      DeallocMachineOutcomeRel h (.error (h.error me)) (.error ke)
  | missingClock (msg : String) :
      DeallocMachineOutcomeRel h (.error (.invalidProgram msg))
        (.error (.hookFailure "MissingVectorClockExtra"))
  | dataRace (msg : String) :
      DeallocMachineOutcomeRel h (.error (.undefinedBehavior msg))
        (.error (.hookFailure "DataRace"))
  | tbProtected (msg : String) :
      DeallocMachineOutcomeRel h (.error (.undefinedBehavior msg))
        (.error (.hookFailure "TreeBorrowsProtectedDealloc"))

private theorem deallocMachineOutcomeRel_dataRace_inv {K User Payload : Type}
    {h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload}
    {mOut : Except Miri.Interpreter.StepError Unit}
    (hrel : DeallocMachineOutcomeRel h mOut (.error (.hookFailure "DataRace"))) :
    ∃ msg, mOut = .error (.undefinedBehavior msg) := by
  generalize hk : (Except.error (.hookFailure "DataRace") : Except DeallocErr Unit) = kOut at hrel
  cases hrel with
  | ok => cases hk
  | lifecycle me ke' hmap hnh =>
    injection hk with hke; subst hke
    cases me <;> simp [deallocErrOfMiri] at hmap
    exact absurd rfl (hnh _ _)
  | missingClock _ => injection hk with hke; injection hke with hs; exact absurd hs (by decide)
  | dataRace msg => exact ⟨msg, rfl⟩
  | tbProtected _ => injection hk with hke; injection hke with hs; exact absurd hs (by decide)

private theorem deallocMachineOutcomeRel_missingClock_inv {K User Payload : Type}
    {h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload}
    {mOut : Except Miri.Interpreter.StepError Unit}
    (hrel : DeallocMachineOutcomeRel h mOut (.error (.hookFailure "MissingVectorClockExtra"))) :
    ∃ msg, mOut = .error (.invalidProgram msg) := by
  generalize hk : (Except.error (.hookFailure "MissingVectorClockExtra") : Except DeallocErr Unit) = kOut at hrel
  cases hrel with
  | ok => cases hk
  | lifecycle me ke' hmap hnh =>
    injection hk with hke; subst hke
    cases me <;> simp [deallocErrOfMiri] at hmap
    exact absurd rfl (hnh _ _)
  | missingClock msg => exact ⟨msg, rfl⟩
  | dataRace _ => injection hk with hke; injection hke with hs; exact absurd hs (by decide)
  | tbProtected _ => injection hk with hke; injection hke with hs; exact absurd hs (by decide)

private theorem deallocMachineOutcomeRel_lifecycle_inv {K User Payload : Type}
    {h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload}
    {e : Miri.Interpreter.StepError} {ke : DeallocErr}
    (hnotHook : ∀ s, ke ≠ .hookFailure s)
    (hrel : DeallocMachineOutcomeRel h (.error e) (.error ke)) :
    ∃ me, e = h.error me ∧ deallocErrOfMiri me = some ke := by
  generalize hm : (Except.error e : Except Miri.Interpreter.StepError Unit) = mOut at hrel
  generalize hk : (Except.error ke : Except DeallocErr Unit) = kOut at hrel
  cases hrel with
  | ok => cases hk
  | lifecycle me ke' hmap _ =>
    injection hm with he; injection hk with hke; subst he; subst hke
    exact ⟨me, rfl, hmap⟩
  | missingClock _ => injection hk with hke; exact absurd hke (hnotHook _)
  | dataRace _ => injection hk with hke; exact absurd hke (hnotHook _)
  | tbProtected _ => injection hk with hke; exact absurd hke (hnotHook _)


private theorem allocationMachine_deallocate_beforeSpec {K User Payload : Type}
    [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (actor : DeallocActor) (tb : DeallocHookSpec)
    (id : Miri.Memory.AllocId) (row : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (pe : Miri.Memory.ProvenanceExtra)
    (htbDomain : tb = .ok ∨ tb = .protectedDealloc)
    (hactiveRace : ∀ global, st.machine.dataRace = some global → global.raceDetecting = true →
      ∃ index clocks, global.activeThreadState st.machine.threads = .ok (index, clocks) ∧
        ∀ vc,
          st.machine.raceAllocations.find? (fun e => e.1 == id) = some (id, vc) →
          row.allocation.byteSize.bytes ≠ 0 →
          ∃ cell,
            row.allocation.byteSize.bytes.toNat ≤ vc.allocRanges.length.bytes ∧
            (∀ k < row.allocation.byteSize.bytes.toNat, vc.cellAt k = .ok cell) ∧
            ClockEntryRel actor clocks cell (raceEntryOf vc))
    (htbMatch :
      match st.machine.borrowTracker with
      | none => tb = .ok
      | some tracker =>
        let r := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
          row.allocation.byteSize tracker.global.protectedTags
        (r.status != .Deallocated) = (tb == .protectedDealloc))
    (hdiag : ∀ m id, ∃ m', h.diagnostic id m = .ok () m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations ∧
      m'.dataRace = m.dataRace ∧ m'.threads = m.threads ∧ m'.borrowTracker = m.borrowTracker ∧
      m'.user = m.user)
    (hretain : ∀ a m, (h.retainDetached a m).memory = m.memory ∧
      (h.retainDetached a m).raceAllocations = m.raceAllocations ∧
      (h.retainDetached a m).user = m.user)
    (hsyncOk : ∀ m,
      m.user = st.machine.user →
      ∃ m', Miri.Interpreter.MemoryExtras.beforeDeallocationSync h.extras id m = .ok () m' ∧
        m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations)
    (hspanOk : ∀ m, ∃ sp m', h.currentSpan m = .ok sp m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations)
    (hfreeOk : ∀ m id sz al k, ∃ m', h.freeAllocId id sz al k m = .ok () m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations)
    (mDetached : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K) :
    let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
    let mIn : Miri.Interpreter.MachineHooks.MachineState K User := { st.machine with memory := mDetached }
    let kh := machineDeallocHook (raceModeOfMachine st.machine) actor tb
      ((memoryStateToKeyed proj mDetached raceRows).findRace? (ofMiriAllocId id))
      row.allocation.byteSize.bytes
    match miriAllocMachBefore h row.allocation id pe row.allocation.byteSize row.allocation.align kind mIn with
    | .ok () mOut =>
      mOut.memory = mDetached ∧
      (mOut.raceAllocations.filter fun e => e.1 != id) =
        (st.machine.raceAllocations.filter fun e => e.1 != id) ∧
      kh = .ok ()
    | .error err mOut =>
      mOut.memory = mDetached ∧
      (mOut.raceAllocations.filter fun e => e.1 != id) =
        (st.machine.raceAllocations.filter fun e => e.1 != id) ∧
      (match err, kh with
       | .invalidProgram _, .error "MissingVectorClockExtra" => True
       | .undefinedBehavior _, .error "DataRace" => True
       | .undefinedBehavior _, .error "TreeBorrowsProtectedDealloc" => True
       | _, _ => False) := by
  dsimp only
  let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
  · have hfindRaceEq :
        (memoryStateToKeyed proj mDetached raceRows).findRace? (ofMiriAllocId id) =
        (st.machine.raceAllocations.find? fun e => e.1 == id).map (fun p => raceEntryOf p.2) := by
      unfold memoryStateToKeyed memoryStateToLinear KeyedAllocWorld.ofLinear KeyedAllocWorld.findRace?
      dsimp only [MiriAllocRows.toLinear, memoryStateToRows]
      rw [get?_ofLinearRows, ← Array.find?_toList]
      have hgo : ∀ (xs : List (Miri.Memory.AllocId × Miri.Concurrency.VClockAlloc)),
          linearFind? (xs.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)) (ofMiriAllocId id) =
            (xs.find? fun e => e.1 == id).map (fun p => raceEntryOf p.2) := by
        intro xs
        induction xs with
        | nil => rfl
        | cons x rest ih =>
          have hcons1 : linearFind? (((x :: rest).map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)))
              (ofMiriAllocId id) =
              if (ofMiriAllocId x.1 == ofMiriAllocId id) then some (raceEntryOf x.2)
              else linearFind? (rest.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)) (ofMiriAllocId id) := by
            unfold linearFind?
            simp only [List.map_cons, List.find?]
            cases ofMiriAllocId x.1 == ofMiriAllocId id <;> rfl
          rw [hcons1, ofMiriAllocId_beq, List.find?]
          cases hx : x.1 == id
          · simpa using ih
          · rfl
      exact hgo st.machine.raceAllocations.toList
    have hfilterPres : ∀ (xs : Array (Miri.Memory.AllocId × Miri.Concurrency.VClockAlloc))
        (vc' : Miri.Concurrency.VClockAlloc),
        ((xs.filter fun e => e.1 != id).push (id, vc')).filter (fun e => e.1 != id) =
          xs.filter (fun e => e.1 != id) := by
      intro xs vc'
      apply Array.ext'
      rw [Array.toList_filter, Array.toList_push, List.filter_append, Array.toList_filter]
      simp [List.filter_filter]
    -- Unfold `before` step-by-step using `est_bind_ok`/`est_bind_err` to keep kernel terms small.
    rw [hfindRaceEq]
    obtain ⟨m1, hm1, hm1Mem, hm1Race, hm1DR, hm1Th, hm1BT, hm1User⟩ := hdiag { st.machine with memory := mDetached } id
    -- Stage 1: standalone evaluation of `memoryRaceAccess m1 ...` against the race half of `machineDeallocHook`.
    have hraceSpec :
        let (m2, r) := Miri.Interpreter.MachineHooks.memoryRaceAccess m1 id
          ⟨Miri.ABI.Size.ZERO, row.allocation.byteSize⟩ (some .Deallocate) .Read
        m2.memory = mDetached ∧
        (m2.raceAllocations.filter fun e => e.1 != id) =
          (st.machine.raceAllocations.filter fun e => e.1 != id) ∧
        m2.borrowTracker = st.machine.borrowTracker ∧
        m2.user = st.machine.user ∧
        match r with
        | .ok () =>
          machineDeallocHook (raceModeOfMachine st.machine) actor tb
            ((st.machine.raceAllocations.find? fun e => e.1 == id).map fun p => raceEntryOf p.2)
            row.allocation.byteSize.bytes = tb.run
        | .error err =>
          match err, machineDeallocHook (raceModeOfMachine st.machine) actor tb
              ((st.machine.raceAllocations.find? fun e => e.1 == id).map fun p => raceEntryOf p.2)
              row.allocation.byteSize.bytes with
          | .invalidProgram _, .error "MissingVectorClockExtra" => True
          | .undefinedBehavior _, .error "DataRace" => True
          | _, _ => False := by
      unfold Miri.Interpreter.MachineHooks.memoryRaceAccess raceModeOfMachine machineDeallocHook
      cases hdr : st.machine.dataRace with
      | none =>
        rw [hm1DR, hdr]
        simp only [Id.run, pure, Pure.pure]
        exact ⟨hm1Mem, by rw [hm1Race], hm1BT, hm1User, trivial⟩
      | some global =>
        rw [hm1DR, hdr, hm1Race]
        cases hrf : st.machine.raceAllocations.find? (fun e => e.1 == id) with
        | none =>
          simp only [Id.run, bind, Bind.bind, pure, Pure.pure, Option.map_none]
          exact ⟨hm1Mem, by rw [hm1Race], hm1BT, hm1User, trivial⟩
        | some rpair =>
          obtain ⟨rid, vc⟩ := rpair
          have hrid : rid = id := eq_of_beq (by
            have := Array.find?_toList (p := fun e : Miri.Memory.AllocId × Miri.Concurrency.VClockAlloc => e.1 == id)
              (xs := st.machine.raceAllocations)
            rw [hrf] at this
            simpa using List.find?_some this)
          cases hrid
          cases hdet : global.raceDetecting with
          | false =>
            simp only [hdet, Id.run, bind, Bind.bind, pure, Pure.pure, Bool.not_false, ↓reduceIte,
              Bool.false_and, Bool.false_eq_true, Option.map_some]
            exact ⟨hm1Mem, by rw [hm1Race], hm1BT, hm1User, trivial⟩
          | true =>
            obtain ⟨index, clocks, hact, hclks⟩ := hactiveRace global hdr hdet
            rw [hm1Th]
            simp only [hdet, hact, Id.run, bind, Bind.bind, pure, Pure.pure, Bool.not_true,
              Bool.false_eq_true, ↓reduceIte, Option.map_some, Bool.true_and]
            by_cases hz : row.allocation.byteSize.bytes = 0
            · have hzb : (row.allocation.byteSize.bytes != 0) = false := by simp [hz]
              have hw0 : (vc.writeNonAtomic ⟨miriRaceSize Miri.ABI.Size.ZERO, miriRaceSize row.allocation.byteSize⟩
                  clocks index .Deallocate).result = .ok := by
                have hsz0 : row.allocation.byteSize = ⟨0⟩ := by
                  cases hsz : row.allocation.byteSize with | mk b => rw [hsz] at hz; simp at hz; subst hz; rfl
                rw [hsz0]
                exact (writeNonAtomic_zeroSize_ok vc clocks index (miriRaceSize Miri.ABI.Size.ZERO)
                  (Nat.zero_le _) actor (raceEntryOf vc)).1
              simp only [hw0, hzb, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
              exact ⟨hm1Mem, hfilterPres _ _, hm1BT, hm1User, trivial⟩
            · have hnzb : (row.allocation.byteSize.bytes != 0) = true := bne_iff_ne.mpr hz
              obtain ⟨cell, hlenLe, hunif, hcrel⟩ := hclks vc hrf hz
              have hpos : 0 < row.allocation.byteSize.bytes.toNat := by
                have : row.allocation.byteSize.bytes.toNat ≠ 0 := fun h0 => hz (UInt64.toNat_inj.mp h0)
                omega
              have hlt64 : row.allocation.byteSize.bytes.toNat < 2 ^ 64 :=
                row.allocation.byteSize.bytes.toBitVec.isLt
              have hwRes := writeNonAtomic_uniform_dealloc_race_iff vc clocks index actor cell
                (raceEntryOf vc) row.allocation.byteSize.bytes.toNat hpos hlt64 hlenLe hunif hcrel
              have hrangeEq : (⟨miriRaceSize Miri.ABI.Size.ZERO, miriRaceSize row.allocation.byteSize⟩ :
                  Miri.Concurrency.AccessRange) =
                  ⟨Miri.Concurrency.ByteSize.ofU64 0 (by decide),
                   Miri.Concurrency.ByteSize.ofU64 row.allocation.byteSize.bytes.toNat hlt64⟩ := rfl
              rw [hrangeEq, hwRes]
              cases hrace : hasDeallocDataRace actor (raceEntryOf vc) with
              | true =>
                simp only [hnzb, Bool.true_and, ↓reduceIte]
                exact ⟨hm1Mem, hfilterPres _ _, hm1BT, hm1User, trivial⟩
              | false =>
                simp only [hnzb, Bool.true_and, Bool.false_eq_true, ↓reduceIte]
                exact ⟨hm1Mem, hfilterPres _ _, hm1BT, hm1User, trivial⟩
    -- Stage 2: evaluate the 6-step bookkeeping tail standalone.
    let tailAction : EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User) Unit := do
      Miri.Interpreter.MemoryExtras.beforeDeallocationSync h.extras id
      let span ← h.currentSpan
      modify fun (machine : Miri.Interpreter.MachineHooks.MachineState K User) =>
        { machine with allocationSpans := machine.allocationSpans.map fun (old, allocated, freed) =>
          (old, allocated, if old == id then some span else freed) }
      h.freeAllocId id row.allocation.byteSize row.allocation.align kind
      Miri.Interpreter.MemoryExtras.removeAllocation h.extras id
      modify fun (machine : Miri.Interpreter.MachineHooks.MachineState K User) =>
        { machine with raceAllocations := machine.raceAllocations.filter fun entry => entry.1 != id }
    have htailOk : ∀ (mA : Miri.Interpreter.MachineHooks.MachineState K User),
        mA.memory = mDetached →
        (mA.raceAllocations.filter fun e => e.1 != id) =
          (st.machine.raceAllocations.filter fun e => e.1 != id) →
        mA.user = st.machine.user →
        ∃ mFin,
          tailAction mA = .ok () mFin ∧
          mFin.memory = mDetached ∧
          (mFin.raceAllocations.filter fun e => e.1 != id) =
            (st.machine.raceAllocations.filter fun e => e.1 != id) := by
      intro mA hmAMem hmARace hmAUser
      obtain ⟨m3, hm3, hm3Mem, hm3Race⟩ := hsyncOk mA hmAUser
      obtain ⟨sp, m4, hm4, hm4Mem, hm4Race⟩ := hspanOk m3
      let m4' : Miri.Interpreter.MachineHooks.MachineState K User :=
        { m4 with allocationSpans := m4.allocationSpans.map fun (old, allocated, freed) =>
            (old, allocated, if old == id then some sp else freed) }
      obtain ⟨m5, hm5, hm5Mem, hm5Race⟩ := hfreeOk m4' id row.allocation.byteSize row.allocation.align kind
      let reg5 := h.extras.get m5.user
      let reg6 : Miri.Interpreter.MemoryExtras.Registry Payload :=
        { reg5 with allocations := reg5.allocations.filter fun entry => entry.1 != id }
      let m6 : Miri.Interpreter.MachineHooks.MachineState K User :=
        { m5 with user := h.extras.put m5.user reg6 }
      have hm6 : Miri.Interpreter.MemoryExtras.removeAllocation h.extras id m5 = .ok () m6 := rfl
      refine ⟨{ m6 with raceAllocations := m6.raceAllocations.filter fun entry => entry.1 != id }, ?_, ?_, ?_⟩
      · refine (est_bind_ok _ _ _ _ () hm3).trans ?_
        refine (est_bind_ok _ _ _ _ sp hm4).trans ?_
        refine (est_bind_ok _ _ _ _ () (rfl : (modify
          (m := EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User))
          fun machine =>
          { machine with allocationSpans := machine.allocationSpans.map fun (old, allocated, freed) =>
            (old, allocated, if old == id then some sp else freed) }) m4 = .ok () m4')).trans ?_
        refine (est_bind_ok _ _ _ _ () hm5).trans ?_
        refine (est_bind_ok _ _ _ _ () hm6).trans rfl
      · dsimp only [m6]; rw [hm5Mem, hm4Mem, hm3Mem, hmAMem]
      · dsimp only [m6]
        have hff : (m5.raceAllocations.filter fun e => e.1 != id).filter (fun e => e.1 != id) =
            m5.raceAllocations.filter (fun e => e.1 != id) := by
          apply Array.ext'; simp
        rw [hff, hm5Race, hm4Race, hm3Race, hmARace]
    -- Stage 3: compose `diagnostic` → `memoryRaceAccess` → Tree Borrows → `tailAction` via `est_bind_*`.
    let tbAndTail : EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User) Unit := do
      if let some tracker := (← get).borrowTracker then
        let result := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
          row.allocation.byteSize tracker.global.protectedTags
        modify (h.retainDetached (row.allocation.setExtra result.tree))
        if result.status != Miri.TreeBorrows.BorrowTree.BorrowTreeDeallocStatus.Deallocated then
          throw (Miri.Interpreter.StepError.undefinedBehavior s!"Tree Borrows deallocation: {reprStr result.status}")
      tailAction
    let raceAndRest : EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User) Unit := do
      let (machine, result) := Miri.Interpreter.MachineHooks.memoryRaceAccess (← get) id
        ⟨Miri.ABI.Size.ZERO, row.allocation.byteSize⟩ (some .Deallocate) .Read
      set machine
      match result with | .error error => throw error | .ok () => pure ()
      tbAndTail
    have hbeforeEq : miriAllocMachBefore h row.allocation id pe row.allocation.byteSize row.allocation.align kind
        { st.machine with memory := mDetached } = raceAndRest m1 :=
      est_bind_ok (h.diagnostic id) (fun _ => raceAndRest) _ m1 () hm1
    rw [hbeforeEq]
    have hraceStep : ∀ (m2' : Miri.Interpreter.MachineHooks.MachineState K User)
        (r' : Except Miri.Interpreter.StepError Unit),
        Miri.Interpreter.MachineHooks.memoryRaceAccess m1 id
          ⟨Miri.ABI.Size.ZERO, row.allocation.byteSize⟩ (some .Deallocate) .Read = (m2', r') →
        raceAndRest m1 =
          (match r' with
           | .error err => .error err m2'
           | .ok () => tbAndTail m2') := by
      intro m2' r' hr'
      dsimp only [raceAndRest]
      have hg1 : (get : EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User) _) m1 =
          .ok m1 m1 := rfl
      refine (est_bind_ok _ _ _ m1 m1 hg1).trans ?_
      rw [hr']; dsimp only
      have hset2 : (set m2' : EStateM Miri.Interpreter.StepError
          (Miri.Interpreter.MachineHooks.MachineState K User) Unit) m1 = .ok () m2' := rfl
      refine (est_bind_ok _ _ _ m2' () hset2).trans ?_
      cases r' with
      | error err => exact est_bind_err _ _ _ m2' err rfl
      | ok u => cases u; rfl
    rcases hr : Miri.Interpreter.MachineHooks.memoryRaceAccess m1 id
        ⟨Miri.ABI.Size.ZERO, row.allocation.byteSize⟩ (some .Deallocate) .Read with ⟨m2, r⟩
    rw [hr] at hraceSpec
    rcases hraceSpec with ⟨hm2Mem, hm2Race, hm2BT, hm2User, hrSpec⟩
    rw [hraceStep m2 r hr]
    cases r with
    | error err =>
      dsimp only at hrSpec ⊢
      refine ⟨hm2Mem, hm2Race, ?_⟩
      cases hk : machineDeallocHook (raceModeOfMachine st.machine) actor tb
          ((st.machine.raceAllocations.find? fun e => e.1 == id).map fun p => raceEntryOf p.2)
          row.allocation.byteSize.bytes with
      | ok _ => rw [hk] at hrSpec; cases err <;> cases hrSpec
      | error msg =>
        rw [hk] at hrSpec
        cases err <;> first
          | cases hrSpec
          | (by_cases h1 : msg = "MissingVectorClockExtra"
             · subst h1; trivial
             · simp [h1] at hrSpec)
          | (by_cases h2 : msg = "DataRace"
             · subst h2; trivial
             · simp [h2] at hrSpec)
    | ok u =>
      cases u
      dsimp only at hrSpec ⊢
      rw [hrSpec]
      have htb := htbMatch
      have htbEval : tbAndTail m2 =
          match st.machine.borrowTracker with
          | none => tailAction m2
          | some tracker =>
            let result := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
              row.allocation.byteSize tracker.global.protectedTags
            let mRet := h.retainDetached (row.allocation.setExtra result.tree) m2
            if result.status != Miri.TreeBorrows.BorrowTree.BorrowTreeDeallocStatus.Deallocated then
              .error (.undefinedBehavior s!"Tree Borrows deallocation: {reprStr result.status}") mRet
            else tailAction mRet := by
        dsimp only [tbAndTail]
        have hg : (get : EStateM Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.MachineState K User) _) m2 =
            .ok m2 m2 := rfl
        refine (est_bind_ok _ _ _ m2 m2 hg).trans ?_
        rw [hm2BT]
        cases st.machine.borrowTracker with
        | none => rfl
        | some tracker =>
          dsimp only
          let result := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
            row.allocation.byteSize tracker.global.protectedTags
          let mRet := h.retainDetached (row.allocation.setExtra result.tree) m2
          have hmod : (modify (m := EStateM Miri.Interpreter.StepError
              (Miri.Interpreter.MachineHooks.MachineState K User))
              (h.retainDetached (row.allocation.setExtra result.tree))) m2 = .ok () mRet := rfl
          refine (est_bind_ok _ _ _ mRet () hmod).trans ?_
          cases hstat : (result.status != Miri.TreeBorrows.BorrowTree.BorrowTreeDeallocStatus.Deallocated) with
          | true =>
            simp only [↓reduceIte]
            exact est_bind_err _ _ _ mRet _ rfl
          | false =>
            simp only [Bool.false_eq_true, ↓reduceIte]
            rfl
      rw [htbEval]
      cases hbt : st.machine.borrowTracker with
      | none =>
        rw [hbt] at htb; subst htb
        obtain ⟨mFin, hfinEq, hfinMem, hfinRace⟩ := htailOk m2 hm2Mem hm2Race hm2User
        rw [hfinEq]
        exact ⟨hfinMem, hfinRace, rfl⟩
      | some tracker =>
        rw [hbt] at htb
        dsimp only at htb ⊢
        have hret := hretain (row.allocation.setExtra
          (row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
            row.allocation.byteSize tracker.global.protectedTags).tree) m2
        cases hstat : ((row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
            row.allocation.byteSize tracker.global.protectedTags).status !=
              Miri.TreeBorrows.BorrowTree.BorrowTreeDeallocStatus.Deallocated) with
        | true =>
          rw [hstat] at htb
          have htbP : tb = .protectedDealloc := eq_of_beq htb.symm
          subst htbP
          simp only [↓reduceIte]
          exact ⟨by rw [hret.1, hm2Mem], by rw [hret.2.1, hm2Race], trivial⟩
        | false =>
          rw [hstat] at htb
          have htbOk : tb = .ok := by
            rcases htbDomain with rfl | rfl
            · rfl
            · cases htb
          subst htbOk
          simp only [Bool.false_eq_true, ↓reduceIte]
          obtain ⟨mFin, hfinEq, hfinMem, hfinRace⟩ := htailOk (h.retainDetached _ m2)
            (by rw [hret.1, hm2Mem]) (by rw [hret.2.1, hm2Race]) (by rw [hret.2.2, hm2User])
          rw [hfinEq]
          exact ⟨hfinMem, hfinRace, rfl⟩

private theorem allocationMachine_deallocate_unfold {K User Payload : Type}
    [DecidableEq K]
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User) :
    Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st =
      (let hooks : Miri.Memory.MemoryDeallocationHooks Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K
          (Miri.Interpreter.PlaceMachine.AccessState K User) Miri.Memory.ProvenanceExtra :=
         { synchronizeMemory := fun memory access => { access with machine := { access.machine with memory } }
           resolvePointer := h.resolvePointer
           beforeDeallocation := miriAllocMachCallback h }
       let res := Miri.Memory.MemoryLifecycle.deallocatePtrWith
         st.machine.memory ⟨st.machine, none⟩ ptr oldLayout kind hooks
       let nextMachine :=
         match res.detached with
         | some (allocId, _) =>
           { res.hooks.machine with
             memory := res.memory
             user := h.extras.put res.hooks.machine.user
               { (h.extras.get res.hooks.machine.user) with
                 allocations := (h.extras.get res.hooks.machine.user).allocations.filter fun e => e.1 != allocId }
             raceAllocations := res.hooks.machine.raceAllocations.filter fun e => e.1 != allocId }
         | none => { res.hooks.machine with memory := res.memory }
       let nextSt := { st with machine := nextMachine }
       let afterDrop : EStateM.Result Miri.Interpreter.StepError (Miri.Interpreter.MachineHooks.State K User) Unit :=
         match res.detached with
         | some (_, detached) =>
           if detached.allocation.nativeBuffer.isSome then
             match h.nativeDrop with
             | none => .error (.invalidProgram "native detached backing lacks drop capability") nextSt
             | some drop => drop detached.allocation nextSt
           else .ok () nextSt
         | none => .ok () nextSt
       match afterDrop with
       | .error err s' => .error err s'
       | .ok () s' =>
         match res.outcome with
         | .ok () => .ok () s'
         | .error error => .error (res.hooks.pendingError.getD (h.error error)) s') := by
  unfold Miri.Interpreter.AllocationMachine.deallocate
  let hooks : Miri.Memory.MemoryDeallocationHooks Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K
      (Miri.Interpreter.PlaceMachine.AccessState K User) Miri.Memory.ProvenanceExtra :=
    { synchronizeMemory := fun memory access => { access with machine := { access.machine with memory } }
      resolvePointer := h.resolvePointer
      beforeDeallocation := miriAllocMachCallback h }
  simp only [get, getThe, MonadStateOf.get, EStateM.get, bind, Bind.bind, EStateM.bind,
    modify, modifyGet, MonadStateOf.modifyGet, pure, Pure.pure,
    throw, throwThe, MonadExceptOf.throw]
  generalize Miri.Memory.MemoryLifecycle.deallocatePtrWith st.machine.memory
    ({ machine := st.machine, pendingError := none } : Miri.Interpreter.PlaceMachine.AccessState K User)
    ptr oldLayout kind hooks = res
  cases hdet : res.detached with
  | none => cases res.outcome <;> rfl
  | some pair =>
    dsimp only
    cases hnat : pair.2.allocation.nativeBuffer.isSome with
    | false => simp only [Bool.false_eq_true, ↓reduceIte]; cases res.outcome <;> rfl
    | true =>
      simp only [↓reduceIte]
      cases hnd : h.nativeDrop with
      | none => rfl
      | some drop =>
        dsimp only [EStateM.bind, EStateM.modifyGet]
        cases drop pair.2.allocation _ <;> cases res.outcome <;> rfl

private theorem allocationMachine_deallocate_postLayout {K User Payload : Type}
    [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (actor : DeallocActor) (tb : DeallocHookSpec)
    (afterRemove : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (allocId : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (provExtra : Miri.Memory.ProvenanceExtra)
    (hbf :
      let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
      let hookRes := machineDeallocHook (raceModeOfMachine st.machine) actor tb
        ((memoryStateToKeyed proj afterRemove raceRows).findRace? (ofMiriAllocId allocId))
        entry.allocation.byteSize.bytes
      match miriAllocMachBefore h entry.allocation allocId provExtra entry.allocation.byteSize
          entry.allocation.align kind { st.machine with memory := afterRemove } with
      | .ok () mOut =>
        mOut.memory = afterRemove ∧
        (mOut.raceAllocations.filter fun e => e.1 != allocId) =
          (st.machine.raceAllocations.filter fun e => e.1 != allocId) ∧
        hookRes = .ok ()
      | .error err mOut =>
        mOut.memory = afterRemove ∧
        (mOut.raceAllocations.filter fun e => e.1 != allocId) =
          (st.machine.raceAllocations.filter fun e => e.1 != allocId) ∧
        match err, hookRes with
        | .invalidProgram _, .error "MissingVectorClockExtra" => True
        | .undefinedBehavior _, .error "DataRace" => True
        | .undefinedBehavior _, .error "TreeBorrowsProtectedDealloc" => True
        | _, _ => False) :
    let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
    let cb := miriAllocMachCallback h afterRemove ⟨{ st.machine with memory := afterRemove }, none⟩
      entry.allocation ptr allocId provExtra entry.allocation.byteSize entry.allocation.align kind
    let beforeState : Miri.Interpreter.PlaceMachine.AccessState K User :=
      { cb.state with machine := { cb.state.machine with memory := cb.memory } }
    let mres : Miri.Memory.MemoryDeallocationResult Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K
        (Miri.Interpreter.PlaceMachine.AccessState K User) :=
      match cb.outcome with
      | .error msg => ⟨cb.memory, beforeState, some (allocId, entry), .error (.hookFailure "beforeMemoryDeallocation" msg)⟩
      | .ok () =>
        let dup := cb.memory.dead.any fun old => old.allocId == allocId
        let nextMem := miriMSInsertDead cb.memory ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩
        let finalState : Miri.Interpreter.PlaceMachine.AccessState K User :=
          { beforeState with machine := { beforeState.machine with memory := nextMem } }
        if dup then ⟨nextMem, finalState, some (allocId, entry), .error (.duplicateDeadAllocation allocId)⟩
        else ⟨nextMem, finalState, some (allocId, entry), .ok ()⟩
    let stFin : Miri.Interpreter.MachineHooks.State K User :=
      { st with machine :=
        { mres.hooks.machine with
          memory := mres.memory
          user := h.extras.put mres.hooks.machine.user
            { (h.extras.get mres.hooks.machine.user) with
              allocations := (h.extras.get mres.hooks.machine.user).allocations.filter fun e => e.1 != allocId }
          raceAllocations := mres.hooks.machine.raceAllocations.filter fun e => e.1 != allocId } }
    let mOut : Except Miri.Interpreter.StepError Unit :=
      match mres.outcome with
      | .ok () => .ok ()
      | .error e => .error (mres.hooks.pendingError.getD (h.error e))
    let kres' := KeyedAllocWorld.detachRaceClock
      (match machineDeallocHook (raceModeOfMachine st.machine) actor tb
          ((memoryStateToKeyed proj afterRemove raceRows).findRace? (ofMiriAllocId allocId))
          (liveEntryOfMiri proj entry).sizeBytes with
        | .error msg =>
          ⟨memoryStateToKeyed proj afterRemove raceRows,
           some (ofMiriAllocId allocId, liveEntryOfMiri proj entry),
           .error (.hookFailure msg)⟩
        | .ok () =>
          let dup := ((memoryStateToKeyed proj afterRemove raceRows).findDead? (ofMiriAllocId allocId)).isSome
          let wDead := (memoryStateToKeyed proj afterRemove raceRows).insertDead
            (ofMiriAllocId allocId) ⟨(liveEntryOfMiri proj entry).sizeBytes, (liveEntryOfMiri proj entry).alignPow2⟩
          if dup then ⟨wDead, some (ofMiriAllocId allocId, liveEntryOfMiri proj entry),
            .error (.duplicateDeadAllocation (ofMiriAllocId allocId))⟩
          else ⟨wDead, some (ofMiriAllocId allocId, liveEntryOfMiri proj entry), .ok ()⟩)
    machineToKeyed proj raceEntryOf stFin.machine = kres'.world ∧
    DeallocMachineOutcomeRel h mOut kres'.outcome := by
  dsimp only [liveEntryOfMiri] at hbf ⊢
  let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
  have hcbEq : miriAllocMachCallback h afterRemove ⟨{ st.machine with memory := afterRemove }, none⟩
      entry.allocation ptr allocId provExtra entry.allocation.byteSize entry.allocation.align kind =
      match miriAllocMachBefore h entry.allocation allocId provExtra
          entry.allocation.byteSize entry.allocation.align kind { st.machine with memory := afterRemove } with
      | .ok value machine => ⟨machine.memory, ⟨machine, none⟩, .ok value⟩
      | .error error machine => ⟨machine.memory, ⟨machine, some error⟩, .error (reprStr error)⟩ := rfl
  rw [hcbEq]
  cases hbo : miriAllocMachBefore h entry.allocation allocId provExtra
      entry.allocation.byteSize entry.allocation.align kind { st.machine with memory := afterRemove } with
  | error err mOut =>
    rw [hbo] at hbf
    obtain ⟨hmMem, hmRace, hrelErr⟩ := hbf
    cases hkh : machineDeallocHook (raceModeOfMachine st.machine) actor tb
        ((memoryStateToKeyed proj afterRemove raceRows).findRace? (ofMiriAllocId allocId))
        entry.allocation.byteSize.bytes with
    | ok _ => rw [hkh] at hrelErr; cases err <;> exact False.elim hrelErr
    | error msg =>
      rw [hkh] at hrelErr
      refine ⟨?_, ?_⟩
      · unfold machineToKeyed KeyedAllocWorld.detachRaceClock
        dsimp only
        rw [hmMem, hmRace]
        exact memoryStateToKeyed_filter_race proj raceEntryOf afterRemove _ allocId
      · cases err with
        | invalidProgram s =>
          by_cases hm : msg = "MissingVectorClockExtra"
          · subst hm; exact .missingClock s
          · simp [hm] at hrelErr
        | undefinedBehavior s =>
          by_cases hm1 : msg = "DataRace"
          · subst hm1; exact .dataRace s
          · by_cases hm2 : msg = "TreeBorrowsProtectedDealloc"
            · subst hm2; exact .tbProtected s
            · simp [hm1, hm2] at hrelErr
        | _ => cases hrelErr
  | ok u mOut =>
    cases u
    rw [hbo] at hbf
    obtain ⟨hmMem, hmRace, hkhOk⟩ := hbf
    simp only [hkhOk]
    have had : (afterRemove.dead.any fun old => old.allocId == allocId) =
        ((memoryStateToKeyed proj afterRemove raceRows).findDead? (ofMiriAllocId allocId)).isSome := by
      have hkw : (memoryStateToKeyed proj afterRemove raceRows).findDead? (ofMiriAllocId allocId) =
          ((memoryStateToRows afterRemove).toKeyed proj).findDead? (ofMiriAllocId allocId) := rfl
      rw [hkw, toKeyed_findDead?, isSome_map_find?, ← Array.any_toList]; rfl
    rw [hmMem, had]
    have hworldDead :
        machineToKeyed proj raceEntryOf
          { mOut with
            memory := miriMSInsertDead afterRemove ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩
            user := h.extras.put mOut.user
              { (h.extras.get mOut.user) with
                allocations := (h.extras.get mOut.user).allocations.filter fun e => e.1 != allocId }
            raceAllocations := mOut.raceAllocations.filter fun e => e.1 != allocId } =
        ((memoryStateToKeyed proj afterRemove raceRows).insertDead (ofMiriAllocId allocId)
          ⟨entry.allocation.byteSize.bytes, UInt8.ofNat entry.allocation.align.pow2⟩).removeRace
          (ofMiriAllocId allocId) := by
      unfold machineToKeyed
      dsimp only
      rw [hmRace, memoryStateToKeyed_filter_race proj raceEntryOf,
        insertDead_toKeyed]
      rfl
    cases ((memoryStateToKeyed proj afterRemove raceRows).findDead? (ofMiriAllocId allocId)).isSome with
    | true =>
      simp only [↓reduceIte, KeyedAllocWorld.detachRaceClock]
      exact ⟨hworldDead, DeallocMachineOutcomeRel.lifecycle (.duplicateDeadAllocation allocId)
        (.duplicateDeadAllocation (ofMiriAllocId allocId)) rfl (fun _ _ h => by cases h)⟩
    | false =>
      simp only [Bool.false_eq_true, ↓reduceIte, KeyedAllocWorld.detachRaceClock]
      exact ⟨hworldDead, DeallocMachineOutcomeRel.ok⟩

private def deallocateLiveRes {K User Payload : Type} [DecidableEq K]
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (afterRemove : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (allocId : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (provExtra : Miri.Memory.ProvenanceExtra) :
    Miri.Memory.MemoryDeallocationResult Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K
      (Miri.Interpreter.PlaceMachine.AccessState K User) :=
  let state0 : Miri.Interpreter.PlaceMachine.AccessState K User :=
    ⟨{ st.machine with memory := afterRemove }, none⟩
  if entry.allocation.mutability == .Not then
    ⟨afterRemove, state0, some (allocId, entry), .error (.immutableAllocation allocId)⟩
  else if entry.kind ≠ kind then
    ⟨afterRemove, state0, some (allocId, entry), .error (.memoryKindMismatch allocId)⟩
  else
    let runCb : Miri.Memory.MemoryDeallocationResult Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K
        (Miri.Interpreter.PlaceMachine.AccessState K User) :=
      let cb := miriAllocMachCallback h afterRemove state0
        entry.allocation ptr allocId provExtra entry.allocation.byteSize entry.allocation.align kind
      let beforeState : Miri.Interpreter.PlaceMachine.AccessState K User :=
        { cb.state with machine := { cb.state.machine with memory := cb.memory } }
      match cb.outcome with
      | .error msg => ⟨cb.memory, beforeState, some (allocId, entry), .error (.hookFailure "beforeMemoryDeallocation" msg)⟩
      | .ok () =>
        let dup := cb.memory.dead.any fun old => old.allocId == allocId
        let nextMem := miriMSInsertDead cb.memory ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩
        let finalState : Miri.Interpreter.PlaceMachine.AccessState K User :=
          { beforeState with machine := { beforeState.machine with memory := nextMem } }
        if dup then ⟨nextMem, finalState, some (allocId, entry), .error (.duplicateDeadAllocation allocId)⟩
        else ⟨nextMem, finalState, some (allocId, entry), .ok ()⟩
    match oldLayout with
    | none => runCb
    | some (reqSize, reqAlign) =>
      if reqSize != entry.allocation.byteSize || reqAlign != entry.allocation.align then
        ⟨afterRemove, state0, some (allocId, entry),
          .error (.layoutMismatch allocId entry.allocation.byteSize reqSize entry.allocation.align reqAlign)⟩
      else runCb

private theorem allocationMachine_deallocate_live {K User Payload : Type}
    [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (actor : DeallocActor) (tb : DeallocHookSpec)
    (afterRemove : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (allocId : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (provExtra : Miri.Memory.ProvenanceExtra)
    (halignLive : entry.allocation.align.pow2 < 256)
    (halignReq : ∀ sz al, oldLayout = some (sz, al) → al.pow2 < 256)
    (hkindFaithful :
      (memKindOfMiri proj.machineKind entry.kind == memKindOfMiri proj.machineKind kind) =
        decide (entry.kind = kind))
    (hbf :
      let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
      let hookRes := machineDeallocHook (raceModeOfMachine st.machine) actor tb
        ((memoryStateToKeyed proj afterRemove raceRows).findRace? (ofMiriAllocId allocId))
        entry.allocation.byteSize.bytes
      match miriAllocMachBefore h entry.allocation allocId provExtra entry.allocation.byteSize
          entry.allocation.align kind { st.machine with memory := afterRemove } with
      | .ok () mOut =>
        mOut.memory = afterRemove ∧
        (mOut.raceAllocations.filter fun e => e.1 != allocId) =
          (st.machine.raceAllocations.filter fun e => e.1 != allocId) ∧
        hookRes = .ok ()
      | .error err mOut =>
        mOut.memory = afterRemove ∧
        (mOut.raceAllocations.filter fun e => e.1 != allocId) =
          (st.machine.raceAllocations.filter fun e => e.1 != allocId) ∧
        match err, hookRes with
        | .invalidProgram _, .error "MissingVectorClockExtra" => True
        | .undefinedBehavior _, .error "DataRace" => True
        | .undefinedBehavior _, .error "TreeBorrowsProtectedDealloc" => True
        | _, _ => False) :
    let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
    let mres := deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra
    let stFin : Miri.Interpreter.MachineHooks.State K User :=
      { st with machine :=
        { mres.hooks.machine with
          memory := mres.memory
          user := h.extras.put mres.hooks.machine.user
            { (h.extras.get mres.hooks.machine.user) with
              allocations := (h.extras.get mres.hooks.machine.user).allocations.filter fun e => e.1 != allocId }
          raceAllocations := mres.hooks.machine.raceAllocations.filter fun e => e.1 != allocId } }
    let mOut : Except Miri.Interpreter.StepError Unit :=
      match mres.outcome with
      | .ok () => .ok ()
      | .error e => .error (mres.hooks.pendingError.getD (h.error e))
    let kres := KeyedAllocWorld.detachRaceClock
      (let wAfter := memoryStateToKeyed proj afterRemove raceRows
       let le := liveEntryOfMiri proj entry
       if le.mutability == .not then
         ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.immutableAllocation (ofMiriAllocId allocId))⟩
       else if le.kind != memKindOfMiri proj.machineKind kind then
         ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.memoryKindMismatch (ofMiriAllocId allocId))⟩
       else
         match deallocLayoutMismatch? le (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2)) with
         | some (reqSz, reqAl) =>
           ⟨wAfter, some (ofMiriAllocId allocId, le),
            .error (.layoutMismatch (ofMiriAllocId allocId) le.sizeBytes reqSz le.alignPow2 reqAl)⟩
         | none =>
           match machineDeallocHook (raceModeOfMachine st.machine) actor tb
               (wAfter.findRace? (ofMiriAllocId allocId)) le.sizeBytes with
           | .error msg =>
             ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.hookFailure msg)⟩
           | .ok () =>
             let dup := (wAfter.findDead? (ofMiriAllocId allocId)).isSome
             let wDead := wAfter.insertDead (ofMiriAllocId allocId) ⟨le.sizeBytes, le.alignPow2⟩
             if dup then ⟨wDead, some (ofMiriAllocId allocId, le),
               .error (.duplicateDeadAllocation (ofMiriAllocId allocId))⟩
             else ⟨wDead, some (ofMiriAllocId allocId, le), .ok ()⟩)
    machineToKeyed proj raceEntryOf stFin.machine = kres.world ∧
    DeallocMachineOutcomeRel h mOut kres.outcome := by
  dsimp only [deallocateLiveRes]
  have hmutEq : (entry.allocation.mutability == .Not) =
      ((liveEntryOfMiri proj entry).mutability == .not) := by
    unfold liveEntryOfMiri mutabilityOfMiri; cases entry.allocation.mutability <;> rfl
  cases hm : entry.allocation.mutability == .Not with
  | true =>
    rw [hm] at hmutEq
    simp only [← hmutEq, ↓reduceIte, KeyedAllocWorld.detachRaceClock]
    exact ⟨by unfold machineToKeyed; exact memoryStateToKeyed_filter_race proj raceEntryOf afterRemove _ allocId,
      DeallocMachineOutcomeRel.lifecycle (.immutableAllocation allocId)
        (.immutableAllocation (ofMiriAllocId allocId)) rfl (fun _ _ h => by cases h)⟩
  | false =>
    rw [hm] at hmutEq
    simp only [← hmutEq, Bool.false_eq_true, ↓reduceIte]
    by_cases hk : entry.kind = kind
    · have hkBne : ((liveEntryOfMiri proj entry).kind != memKindOfMiri proj.machineKind kind) = false := by
        show (!(memKindOfMiri proj.machineKind entry.kind == memKindOfMiri proj.machineKind kind)) = false
        rw [hkindFaithful, decide_eq_true hk]; rfl
      simp only [hk, ne_eq, not_true_eq_false, hkBne, Bool.false_eq_true, ↓reduceIte]
      have hrunCb := allocationMachine_deallocate_postLayout proj raceEntryOf h ptr kind st actor tb
        afterRemove allocId entry provExtra hbf
      cases oldLayout with
      | none =>
        simp only [Option.map_none, deallocLayoutMismatch?]
        exact hrunCb
      | some pair =>
        rcases pair with ⟨reqSize, reqAlign⟩
        have hreqLt := halignReq reqSize reqAlign rfl
        have hszEq : (reqSize != entry.allocation.byteSize) =
            (reqSize.bytes != entry.allocation.byteSize.bytes) := by
          rcases reqSize with ⟨b1⟩; rcases entry.allocation.byteSize with ⟨b2⟩
          by_cases hb : b1 = b2
          · simp [hb]
          · have hne : ({ bytes := b1 } : Miri.ABI.Size) ≠ { bytes := b2 } :=
              fun h => hb (congrArg Miri.ABI.Size.bytes h)
            simp [bne_iff_ne.mpr hne, bne_iff_ne.mpr hb]
        have halEq : (reqAlign != entry.allocation.align) =
            (UInt8.ofNat reqAlign.pow2 != UInt8.ofNat entry.allocation.align.pow2) := by
          by_cases ha : reqAlign.pow2 = entry.allocation.align.pow2
          · have ha' : reqAlign = entry.allocation.align := by
              rcases h1 : reqAlign with ⟨p1⟩; rcases h2 : entry.allocation.align with ⟨p2⟩
              rw [h1, h2] at ha; simp at ha; subst ha; rfl
            simp [ha']
          · have hne : reqAlign ≠ entry.allocation.align :=
              fun h => ha (congrArg Miri.ABI.Align.pow2 h)
            have hne8 : UInt8.ofNat reqAlign.pow2 ≠ UInt8.ofNat entry.allocation.align.pow2 := by
              intro hEq
              have := congrArg UInt8.toNat hEq
              simp [UInt8.toNat_ofNat', Nat.mod_eq_of_lt hreqLt, Nat.mod_eq_of_lt halignLive] at this
              exact ha this
            simp [bne_iff_ne.mpr hne, bne_iff_ne.mpr hne8]
        simp only [Option.map_some, deallocLayoutMismatch?, liveEntryOfMiri, hszEq, halEq]
        by_cases hlm : (reqSize.bytes != entry.allocation.byteSize.bytes ||
            UInt8.ofNat reqAlign.pow2 != UInt8.ofNat entry.allocation.align.pow2) = true
        · simp only [hlm, ↓reduceIte, KeyedAllocWorld.detachRaceClock]
          exact ⟨by unfold machineToKeyed; exact memoryStateToKeyed_filter_race proj raceEntryOf afterRemove _ allocId,
            DeallocMachineOutcomeRel.lifecycle
              (.layoutMismatch allocId entry.allocation.byteSize reqSize entry.allocation.align reqAlign)
              (.layoutMismatch (ofMiriAllocId allocId) entry.allocation.byteSize.bytes reqSize.bytes
                (UInt8.ofNat entry.allocation.align.pow2) (UInt8.ofNat reqAlign.pow2)) rfl (fun _ _ h => by cases h)⟩
        · simp only [hlm]
          exact hrunCb
    · have hkBne : ((liveEntryOfMiri proj entry).kind != memKindOfMiri proj.machineKind kind) = true := by
        show (!(memKindOfMiri proj.machineKind entry.kind == memKindOfMiri proj.machineKind kind)) = true
        rw [hkindFaithful, decide_eq_false hk]; rfl
      simp only [hk, ne_eq, not_false_eq_true, hkBne, ↓reduceIte, KeyedAllocWorld.detachRaceClock]
      exact ⟨by unfold machineToKeyed; exact memoryStateToKeyed_filter_race proj raceEntryOf afterRemove _ allocId,
        DeallocMachineOutcomeRel.lifecycle (.memoryKindMismatch allocId)
          (.memoryKindMismatch (ofMiriAllocId allocId)) rfl (fun _ _ h => by cases h)⟩

/-- A successful vendored `removeLive` pins the first-match live row and the detached memory. -/
private theorem miriMSRemoveLive_find {Prov Extra MachineKind : Type}
    (mem after : Miri.Memory.MemoryState Prov Extra MachineKind) (id : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Prov Extra MachineKind)
    (hrem : miriMSRemoveLive mem id = (after, some entry)) :
    mem.live.find? (fun e => e.1 == id) = some (id, entry) ∧
    after = { mem with live := mem.live.filter fun e => e.1 != id } := by
  refine ⟨?_, (congrArg Prod.fst hrem).symm⟩
  have hfl : (mem.live.find? fun x => x.1 == id).map Prod.snd = some entry :=
    congrArg Prod.snd hrem
  cases hf : mem.live.find? (fun e => e.1 == id) with
  | none => rw [hf] at hfl; cases hfl
  | some pair =>
    rw [hf] at hfl; injection hfl with h2
    have h1 : pair.1 = id := eq_of_beq (by
      rw [← Array.find?_toList] at hf; simpa using List.find?_some hf)
    cases pair; simp only at h1 h2; subst h1; subst h2; rfl

/-- Normal form of `AllocationMachine.deallocate` on a zero-offset pointer that resolves to a live,
non-native allocation: the lifecycle result is `deallocateLiveRes`, the detached row's registry
entry and race clock leave the machine, and the outcome is the lifecycle outcome. -/
private theorem allocationMachine_deallocate_live_eq {K User Payload : Type}
    [DecidableEq K]
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (afterRemove : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (allocId : Miri.Memory.AllocId) (offset : Miri.ABI.Size)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (provExtra : Miri.Memory.ProvenanceExtra)
    (hres : h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0 =
      ⟨st.machine.memory, ⟨st.machine, none⟩, .ok (allocId, offset, provExtra)⟩)
    (hne : (offset.bytes != 0) = false)
    (hremM : miriMSRemoveLive st.machine.memory allocId = (afterRemove, some entry))
    (hnn : entry.allocation.nativeBuffer = none) :
    Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st =
      (let mres := deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra
       let stFin : Miri.Interpreter.MachineHooks.State K User :=
         { st with machine :=
           { mres.hooks.machine with
             memory := mres.memory
             user := h.extras.put mres.hooks.machine.user
               { (h.extras.get mres.hooks.machine.user) with
                 allocations := (h.extras.get mres.hooks.machine.user).allocations.filter fun e => e.1 != allocId }
             raceAllocations := mres.hooks.machine.raceAllocations.filter fun e => e.1 != allocId } }
       match mres.outcome with
       | .ok () => .ok () stFin
       | .error e => .error (mres.hooks.pendingError.getD (h.error e)) stFin) := by
  have hdetEq : (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).detached =
      some (allocId, entry) := by
    unfold deallocateLiveRes
    dsimp only
    split
    · rfl
    · split
      · rfl
      · cases oldLayout with
        | none =>
          dsimp only
          cases (miriAllocMachCallback h afterRemove _ entry.allocation ptr allocId provExtra
            entry.allocation.byteSize entry.allocation.align kind).outcome with
          | error _ => rfl
          | ok _ => dsimp only; split <;> rfl
        | some p =>
          rcases p with ⟨reqSize, reqAlign⟩
          dsimp only
          split
          · rfl
          · cases (miriAllocMachCallback h afterRemove _ entry.allocation ptr allocId provExtra
              entry.allocation.byteSize entry.allocation.align kind).outcome with
            | error _ => rfl
            | ok _ => dsimp only; split <;> rfl
  have hresBody :
      Miri.Memory.MemoryLifecycle.deallocatePtrWith st.machine.memory ⟨st.machine, none⟩ ptr oldLayout kind
        { synchronizeMemory := fun memory access => { access with machine := { access.machine with memory } }
          resolvePointer := h.resolvePointer
          beforeDeallocation := miriAllocMachCallback h } =
        deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra := by
    unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith deallocateLiveRes
    simp only [Id.run, bind, Bind.bind, pure, Pure.pure, hres, hne,
      Bool.false_eq_true, ↓reduceIte, hremM]
    split
    · rfl
    · split
      · rfl
      · cases oldLayout with
        | none =>
          cases (miriAllocMachCallback h afterRemove _ entry.allocation ptr allocId provExtra
            entry.allocation.byteSize entry.allocation.align kind).outcome <;> rfl
        | some p =>
          rcases p with ⟨reqSize, reqAlign⟩
          dsimp only
          split
          · rfl
          · cases (miriAllocMachCallback h afterRemove _ entry.allocation ptr allocId provExtra
              entry.allocation.byteSize entry.allocation.align kind).outcome <;> rfl
  rw [allocationMachine_deallocate_unfold]
  dsimp only
  rw [hresBody, hdetEq]
  have hnatFalse : entry.allocation.nativeBuffer.isSome = false := by rw [hnn]; rfl
  simp only [hnatFalse, Bool.false_eq_true, ↓reduceIte]

/-- A successful `deallocateLiveRes` tombstones exactly the detached memory, provided the machine
`before_memory_deallocation` hook leaves `memory` untouched. -/
private theorem deallocateLiveRes_ok_memory {K User Payload : Type} [DecidableEq K]
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (afterRemove : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (allocId : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (provExtra : Miri.Memory.ProvenanceExtra)
    (hbfMem : ∀ mOut, miriAllocMachBefore h entry.allocation allocId provExtra entry.allocation.byteSize
        entry.allocation.align kind { st.machine with memory := afterRemove } = .ok () mOut →
      mOut.memory = afterRemove)
    (hO : (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).outcome = .ok ()) :
    (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).memory =
      miriMSInsertDead afterRemove ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩ := by
  have hcbEq : miriAllocMachCallback h afterRemove ⟨{ st.machine with memory := afterRemove }, none⟩
      entry.allocation ptr allocId provExtra entry.allocation.byteSize entry.allocation.align kind =
      match miriAllocMachBefore h entry.allocation allocId provExtra
          entry.allocation.byteSize entry.allocation.align kind { st.machine with memory := afterRemove } with
      | .ok value machine => ⟨machine.memory, ⟨machine, none⟩, .ok value⟩
      | .error error machine => ⟨machine.memory, ⟨machine, some error⟩, .error (reprStr error)⟩ := rfl
  unfold deallocateLiveRes at hO ⊢
  dsimp only at hO ⊢
  by_cases hm : (entry.allocation.mutability == Miri.Memory.Mutability.Not) = true
  · rw [ite_t hm] at hO; cases hO
  · rw [ite_f hm] at hO ⊢
    by_cases hk : entry.kind ≠ kind
    · rw [ite_t hk] at hO; cases hO
    · rw [ite_f hk] at hO ⊢
      cases oldLayout with
      | none =>
        dsimp only at hO ⊢
        cases hbo : miriAllocMachBefore h entry.allocation allocId provExtra entry.allocation.byteSize
            entry.allocation.align kind { st.machine with memory := afterRemove } with
        | error err mOut => rw [hcbEq, hbo] at hO; cases hO
        | ok u mOut =>
          cases u
          rw [hcbEq, hbo] at hO ⊢
          dsimp only at hO ⊢
          split <;> exact congrArg (fun m => miriMSInsertDead m
            ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩) (hbfMem mOut hbo)
      | some p =>
        obtain ⟨rs, ra⟩ := p
        dsimp only at hO ⊢
        by_cases hlm : (rs != entry.allocation.byteSize || ra != entry.allocation.align) = true
        · rw [ite_t hlm] at hO; cases hO
        · rw [ite_f hlm] at hO ⊢
          cases hbo : miriAllocMachBefore h entry.allocation allocId provExtra entry.allocation.byteSize
              entry.allocation.align kind { st.machine with memory := afterRemove } with
          | error err mOut => rw [hcbEq, hbo] at hO; cases hO
          | ok u mOut =>
            cases u
            rw [hcbEq, hbo] at hO ⊢
            dsimp only at hO ⊢
            split <;> exact congrArg (fun m => miriMSInsertDead m
              ⟨allocId, entry.allocation.byteSize, entry.allocation.align⟩) (hbfMem mOut hbo)

/-- **Full end-to-end `AllocationMachine.deallocate` ↔ `KeyedAllocWorld.deallocateMachine` lockstep**
(`lean-miri#73`): connects the COMPLETE vendored `Miri.Interpreter.AllocationMachine.deallocate`
operation to `KeyedAllocWorld.deallocateMachine` across ALL 12 branches (`dangling`,
`nonzeroOffset`, `globalErr`, `useAfterFree`, `immutable`, `kindMismatch` detached-state retention,
`layoutMismatch`, ZST race-check skip, `RaceDetectorMode` unconfigured/off/missingExtra/detecting
with multi-reader vector clocks, Tree Borrows `deallocateBorrowRange` failure,
`duplicateDeadAllocation`, and clean live→dead transition), proving:
1. Exact propositional post-state equality `machineToKeyed proj raceEntryOf st'.machine = kres.world`;
2. Exact outcome classification `DeallocMachineOutcomeRel h mOut kres.outcome`. -/
theorem allocationMachine_deallocate_eq_deallocateMachine {K User Payload : Type}
    [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (dptr : DeallocPtr) (actor : DeallocActor) (tb : DeallocHookSpec)
    (htbDomain : tb = .ok ∨ tb = .protectedDealloc)
    (hresMem : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).memory = st.machine.memory)
    (hresState : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).state = ⟨st.machine, none⟩)
    (hresOut :
      match (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome, dptr with
      | .error addr, .dangling daddr => addr = daddr
      | .ok (id, off, _), .provenanced kid koff => ofMiriAllocId id = kid ∧ off.bytes = koff
      | _, _ => False)
    (halignLive : ∀ row ∈ st.machine.memory.live.toList, row.2.allocation.align.pow2 < 256)
    (halignReq : ∀ sz al, oldLayout = some (sz, al) → al.pow2 < 256)
    (hkindFaithful : ∀ row ∈ st.machine.memory.live.toList,
      (memKindOfMiri proj.machineKind row.2.kind == memKindOfMiri proj.machineKind kind) =
        decide (row.2.kind = kind))
    (hnoNative : ∀ row ∈ st.machine.memory.live.toList, row.2.allocation.nativeBuffer = none)
    -- Uniform multi-reader clock correspondence when the detector is active, required ONLY of the
    -- nonzero live allocation that `ptr` actually resolves to (other allocations are unconstrained):
    (hactiveRace : ∀ global, st.machine.dataRace = some global → global.raceDetecting = true →
      ∃ index clocks, global.activeThreadState st.machine.threads = .ok (index, clocks) ∧
        ∀ id off pe vc row,
          (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
          st.machine.raceAllocations.find? (fun e => e.1 == id) = some (id, vc) →
          st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
          row.allocation.byteSize.bytes ≠ 0 →
          ∃ cell,
            row.allocation.byteSize.bytes.toNat ≤ vc.allocRanges.length.bytes ∧
            (∀ k < row.allocation.byteSize.bytes.toNat, vc.cellAt k = .ok cell) ∧
            ClockEntryRel actor clocks cell (raceEntryOf vc))
    -- Tree Borrows verdict matches `tb`, required ONLY at the resolved allocation `id` and the
    -- resolved provenance extra `pe`. (Quantifying over EVERY provenance extra would over-constrain
    -- `tb = .ok` under an active tracker: by the definition of vendored `deallocateBorrowRange`, a
    -- concrete tag absent from the tree ends in `.MissingTag` / `.AccessFailure`. This is a reading
    -- of the vendored definition, not a lemma of this module.)
    (htbMatch : ∀ id off pe row,
      (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
      st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
      match st.machine.borrowTracker with
      | none => tb = .ok
      | some tracker =>
        let r := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
          row.allocation.byteSize tracker.global.protectedTags
        (r.status != .Deallocated) = (tb == .protectedDealloc))
    -- Machine bookkeeping hooks preserve `memory`, `raceAllocations`, `dataRace`, `threads`, `borrowTracker`, `user`:
    (hdiag : ∀ m id, ∃ m', h.diagnostic id m = .ok () m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations ∧
      m'.dataRace = m.dataRace ∧ m'.threads = m.threads ∧ m'.borrowTracker = m.borrowTracker ∧
      m'.user = m.user)
    (hretain : ∀ a m, (h.retainDetached a m).memory = m.memory ∧
      (h.retainDetached a m).raceAllocations = m.raceAllocations ∧
      (h.retainDetached a m).user = m.user)
    (hsyncOk : ∀ m id off pe row,
      (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
      st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
      m.user = st.machine.user →
      ∃ m', Miri.Interpreter.MemoryExtras.beforeDeallocationSync h.extras id m = .ok () m' ∧
        m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations)
    (hspanOk : ∀ m, ∃ sp m', h.currentSpan m = .ok sp m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations)
    (hfreeOk : ∀ m id sz al k, ∃ m', h.freeAllocId id sz al k m = .ok () m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations) :
    let mExec := Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st
    let expLayout := oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2)
    let kres := (machineToKeyed proj raceEntryOf st.machine).deallocateMachine dptr expLayout
      (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor tb
    let (mOut, st') := match mExec with
      | .ok () s => (Except.ok (), s)
      | .error e s => (Except.error e, s)
    machineToKeyed proj raceEntryOf st'.machine = kres.world ∧
    DeallocMachineOutcomeRel h mOut kres.outcome := by
  dsimp only
  let raceRows := st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)
  rcases hres : h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0 with ⟨rmem, rstate, rout⟩
  rw [hres] at hresMem hresState hresOut
  dsimp only at hresMem hresState hresOut
  subst hresMem
  subst hresState
  cases hro : rout with
  | error addr =>
    rw [hro] at hresOut
    cases dptr with
    | provenanced _ _ => exact False.elim hresOut
    | dangling daddr =>
      subst hresOut
      rw [allocationMachine_deallocate_unfold]
      unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith KeyedAllocWorld.deallocateMachine
        KeyedAllocWorld.detachRaceClock KeyedAllocWorld.deallocateWith
      simp only [Id.run, pure, Pure.pure, hres, hro]
      exact ⟨trivial, DeallocMachineOutcomeRel.lifecycle (.danglingPointer addr) (.danglingPointer addr) rfl (fun _ _ h => by cases h)⟩
  | ok triple =>
    rcases triple with ⟨allocId, offset, provExtra⟩
    have hout : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome =
        .ok (allocId, offset, provExtra) := by rw [hres]; exact hro
    rw [hro] at hresOut
    cases dptr with
    | dangling _ => exact False.elim hresOut
    | provenanced kid koff =>
      rcases hresOut with ⟨rfl, rfl⟩
      have hrem := removeLive_toKeyed proj st.machine.memory allocId raceRows
      have hfindGlob : (memoryStateToKeyed proj st.machine.memory raceRows).findGlobal? (ofMiriAllocId allocId) =
          (st.machine.memory.findGlobal? allocId).map (globalEntryOfMiri proj) := by
        have hkw : (memoryStateToKeyed proj st.machine.memory raceRows).findGlobal? (ofMiriAllocId allocId) =
            ((memoryStateToRows st.machine.memory).toKeyed proj).findGlobal? (ofMiriAllocId allocId) := rfl
        rw [hkw, toKeyed_findGlobal?, memoryState_findGlobal?_eq_list_find?]; rfl
      have hmkEq : machineToKeyed proj raceEntryOf st.machine =
          memoryStateToKeyed proj st.machine.memory raceRows := rfl
      by_cases hoff : offset.bytes = 0
      · have hne : (offset.bytes != 0) = false := by simp [hoff]
        cases hremM : miriMSRemoveLive st.machine.memory allocId with
        | mk afterRemove entry? =>
          rw [hremM] at hrem
          rcases hrem with ⟨hremW, hremE⟩
          cases entry? with
          | none =>
            simp only [Option.map_none] at hremE
            have hkwNone : (machineToKeyed proj raceEntryOf st.machine).deallocateMachine
                (.provenanced (ofMiriAllocId allocId) offset.bytes)
                (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2))
                (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor tb =
                match st.machine.memory.findGlobal? allocId with
                | some g => ⟨machineToKeyed proj raceEntryOf st.machine, none,
                    .error (.globalErr (ofMiriAllocId allocId) (globalKindOfMiri g.kind))⟩
                | none => ⟨machineToKeyed proj raceEntryOf st.machine, none,
                    .error (.useAfterFree (ofMiriAllocId allocId))⟩ := by
              rw [hmkEq]
              generalize hkw : memoryStateToKeyed proj st.machine.memory raceRows = kw at hremE hfindGlob ⊢
              unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.detachRaceClock KeyedAllocWorld.deallocateWith
              simp only [hne, Bool.false_eq_true, ↓reduceIte]
              rw [show kw.removeLive (ofMiriAllocId allocId) = ((kw.removeLive (ofMiriAllocId allocId)).1, none) from
                Prod.ext rfl hremE.symm, hfindGlob]
              cases st.machine.memory.findGlobal? allocId <;> rfl
            rw [hkwNone, allocationMachine_deallocate_unfold]
            unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith
            simp only [Id.run, bind, Bind.bind, pure, Pure.pure, hres, hro, hne,
              Bool.false_eq_true, ↓reduceIte, hremM]
            cases hfg : st.machine.memory.findGlobal? allocId with
            | none =>
              exact ⟨rfl, DeallocMachineOutcomeRel.lifecycle (.useAfterFree allocId)
                (.useAfterFree (ofMiriAllocId allocId)) rfl (fun _ _ h => by cases h)⟩
            | some g =>
              exact ⟨rfl, DeallocMachineOutcomeRel.lifecycle (.globalAllocationDeallocation allocId g.kind)
                (.globalErr (ofMiriAllocId allocId) (globalKindOfMiri g.kind)) rfl (fun _ _ h => by cases h)⟩
          | some entry =>
            simp only [Option.map_some] at hremE
            have hliveRow := (miriMSRemoveLive_find st.machine.memory afterRemove allocId entry hremM).1
            have hrowMem : (allocId, entry) ∈ st.machine.memory.live.toList := by
              rw [← Array.find?_toList] at hliveRow; exact List.mem_of_find?_eq_some hliveRow
            have hnn := hnoNative (allocId, entry) hrowMem
            have hkwSome : (machineToKeyed proj raceEntryOf st.machine).deallocateMachine
                (.provenanced (ofMiriAllocId allocId) offset.bytes)
                (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2))
                (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor tb =
                KeyedAllocWorld.detachRaceClock
                  (let wAfter := memoryStateToKeyed proj afterRemove raceRows
                   let le := liveEntryOfMiri proj entry
                   if le.mutability == .not then
                     ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.immutableAllocation (ofMiriAllocId allocId))⟩
                   else if le.kind != memKindOfMiri proj.machineKind kind then
                     ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.memoryKindMismatch (ofMiriAllocId allocId))⟩
                   else
                     match deallocLayoutMismatch? le (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2)) with
                     | some (reqSz, reqAl) =>
                       ⟨wAfter, some (ofMiriAllocId allocId, le),
                        .error (.layoutMismatch (ofMiriAllocId allocId) le.sizeBytes reqSz le.alignPow2 reqAl)⟩
                     | none =>
                       match machineDeallocHook (raceModeOfMachine st.machine) actor tb
                           (wAfter.findRace? (ofMiriAllocId allocId)) le.sizeBytes with
                       | .error msg =>
                         ⟨wAfter, some (ofMiriAllocId allocId, le), .error (.hookFailure msg)⟩
                       | .ok () =>
                         let dup := (wAfter.findDead? (ofMiriAllocId allocId)).isSome
                         let wDead := wAfter.insertDead (ofMiriAllocId allocId) ⟨le.sizeBytes, le.alignPow2⟩
                         if dup then ⟨wDead, some (ofMiriAllocId allocId, le),
                           .error (.duplicateDeadAllocation (ofMiriAllocId allocId))⟩
                         else ⟨wDead, some (ofMiriAllocId allocId, le), .ok ()⟩) := by
              rw [hmkEq]
              generalize hkw : memoryStateToKeyed proj st.machine.memory raceRows = kw at hremW hremE ⊢
              unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.deallocateWith
              simp only [hne, Bool.false_eq_true, ↓reduceIte]
              rw [show kw.removeLive (ofMiriAllocId allocId) =
                  (memoryStateToKeyed proj afterRemove raceRows, some (liveEntryOfMiri proj entry)) from
                Prod.ext hremW.symm hremE.symm]
              rfl
            rw [hkwSome]
            have hgoal := allocationMachine_deallocate_live proj raceEntryOf h ptr oldLayout kind st
              actor tb afterRemove allocId entry provExtra
              (halignLive (allocId, entry) hrowMem) halignReq
              (hkindFaithful (allocId, entry) hrowMem)
              (allocationMachine_deallocate_beforeSpec proj raceEntryOf h kind st actor tb
                allocId entry provExtra htbDomain
                (fun global hdr hdet => by
                  obtain ⟨index, clocks, hact, hclks⟩ := hactiveRace global hdr hdet
                  exact ⟨index, clocks, hact, fun vc hrf hz =>
                    hclks allocId offset provExtra vc entry hout hrf hliveRow hz⟩)
                (htbMatch allocId offset provExtra entry hout hliveRow)
                hdiag hretain
                (fun m hu => hsyncOk m allocId offset provExtra entry hout hliveRow hu)
                hspanOk hfreeOk afterRemove)
            rw [allocationMachine_deallocate_live_eq h ptr oldLayout kind st afterRemove allocId offset entry
              provExtra (by rw [hres, hro]) hne hremM hnn]
            dsimp only
            cases hresOut : (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).outcome with
            | ok u => cases u; dsimp only at hgoal; rw [hresOut] at hgoal; exact hgoal
            | error err => dsimp only at hgoal; rw [hresOut] at hgoal; exact hgoal
      · have hne : (offset.bytes != 0) = true := bne_iff_ne.mpr hoff
        rw [allocationMachine_deallocate_unfold]
        unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith KeyedAllocWorld.deallocateMachine
          KeyedAllocWorld.detachRaceClock KeyedAllocWorld.deallocateWith
        simp only [Id.run, bind, Bind.bind, pure, Pure.pure, hres, hro, hne, ↓reduceIte]
        exact ⟨trivial, DeallocMachineOutcomeRel.lifecycle (.nonzeroAllocationOffset "deallocate" allocId offset)
          (.nonzeroOffset (ofMiriAllocId allocId) offset.bytes) rfl (fun _ _ h => by cases h)⟩

/-! ### 2E.2a.1 Keyed-world frame of store / retag / frame-exit write-backs, and derived
deallocation corollaries of the full lockstep (`lean-miri#73`, `lean-miri#74`)

`MemoryState.setLiveAllocation` — the commit primitive of `Allocation.writeScalar` stores, of
`RetagPipeline` borrow-tree updates, and of the frame-pop release loop — rewrites the row of an
allocation by `filter` + `push`, i.e. it REORDERS `memory.live`. This section proves that the reorder
is unobservable in `KeyedAllocWorld` with no distinct-key or row-order hypothesis, that frame exit is
therefore exactly invisible in the keyed projection, and derives protected / clean / double-free
deallocation facts from `allocationMachine_deallocate_eq_deallocateMachine` instead of assuming
them. -/

/-- Keyed projection of an in-place live-row replacement (`filter` + `push`) is `insertLive`. -/
private theorem memoryStateToKeyed_replaceLive {Prov Extra MachineKind : Type}
    (proj : RowProjection Prov Extra MachineKind)
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind)
    (id : Miri.Memory.AllocId) (row : Miri.Memory.LocalAllocation Prov Extra MachineKind)
    (race : List (MiriAllocId × RaceClockEntry)) :
    memoryStateToKeyed proj { mem with live := (mem.live.filter fun r => r.1 != id).push (id, row) } race =
      (memoryStateToKeyed proj mem race).insertLive (ofMiriAllocId id) (liveEntryOfMiri proj row) := by
  apply KeyedAllocWorld.ext
  · rfl
  · rfl
  · intro _; rfl
  · intro _; rfl
  · intro q
    unfold memoryStateToKeyed memoryStateToLinear KeyedAllocWorld.ofLinear
      KeyedAllocWorld.insertLive KeyedAllocWorld.findLive?
    dsimp only [MiriAllocRows.toLinear, memoryStateToRows]
    rw [get?_ofLinearRows]
    have hfiltL : (mem.live.toList.filter fun r => r.1 != id).map
        (fun x => (ofMiriAllocId x.1, liveEntryOfMiri proj x.2)) =
        (mem.live.toList.map fun x => (ofMiriAllocId x.1, liveEntryOfMiri proj x.2)).filter
          (fun p => p.1 != ofMiriAllocId id) := by
      rw [List.filter_map]; congr 1; apply congrArg (List.filter · _); funext x
      simp only [Function.comp_apply, bne, ofMiriAllocId_beq]
    change linearFind? (((mem.live.filter fun r => r.1 != id).push (id, row)).toList.map
        fun x => (ofMiriAllocId x.1, liveEntryOfMiri proj x.2)) q = _
    rw [Array.toList_push, Array.toList_filter, List.map_append, List.map_singleton, hfiltL,
      linearFind?_filter_append_single]
    by_cases hq : q = ofMiriAllocId id
    · subst hq; rw [beq_self_eq_true, ExtTreeMap0.get?_insert_self]; rfl
    · rw [beq_false_of_ne hq, ExtTreeMap0.get?_insert_ne _ _ hq, get?_ofLinearRows]; rfl
  · intro _; rfl
  · intro _; rfl

/-- Re-inserting the entry a key already maps to is the identity on `KeyedAllocWorld`. -/
private theorem keyedAllocWorld_insertLive_self (kw : KeyedAllocWorld) (id : MiriAllocId)
    (e : LiveAllocEntry) (h : kw.findLive? id = some e) : kw.insertLive id e = kw := by
  apply KeyedAllocWorld.ext
  · rfl
  · rfl
  · intro _; rfl
  · intro _; rfl
  · intro q
    unfold KeyedAllocWorld.insertLive KeyedAllocWorld.findLive?
    by_cases hq : q = id
    · subst hq; rw [ExtTreeMap0.get?_insert_self]; exact h.symm
    · rw [ExtTreeMap0.get?_insert_ne _ _ hq]
  · intro _; rfl
  · intro _; rfl

private theorem memoryStateToKeyed_findLive?_of_find {Prov Extra MachineKind : Type}
    (proj : RowProjection Prov Extra MachineKind)
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind)
    (id : Miri.Memory.AllocId) (race : List (MiriAllocId × RaceClockEntry)) :
    (memoryStateToKeyed proj mem race).findLive? (ofMiriAllocId id) =
      (mem.live.find? fun r => r.1 == id).map fun r => liveEntryOfMiri proj r.2 := by
  have hkw : (memoryStateToKeyed proj mem race).findLive? (ofMiriAllocId id) =
      ((memoryStateToRows mem).toKeyed proj).findLive? (ofMiriAllocId id) := rfl
  rw [hkw, toKeyed_findLive?, ← Array.find?_toList]; rfl

/-- **`MemoryState.setLiveAllocation` ↔ `KeyedAllocWorld.insertLive` lockstep & frame**
(`lean-miri#73`): writing an allocation back into an existing live row — the commit primitive of
`Allocation.writeScalar` stores, `RetagPipeline` borrow-tree updates, and the frame-pop release
loop — succeeds, replaces exactly the row of `id` (moving it to the END of `live`: the row ORDER
changes), preserves the allocation-ID cursor, the exhaustion latch, the source-allocation-ID switch,
`issuedIds`, `globals` and `dead`, leaves every other key's first-match lookup untouched, and is
exactly `KeyedAllocWorld.insertLive` on the keyed projection — with NO distinct-key (`Nodup`) or
row-order hypothesis on `live`. When the projected entry is unchanged (e.g. a borrow-tree-only
update under a projection that ignores `extra`), the keyed world is exactly unchanged. -/
theorem memoryState_setLiveAllocation_eq_keyed {Prov Extra MachineKind : Type} [DecidableEq MachineKind]
    (proj : RowProjection Prov Extra MachineKind)
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind)
    (id : Miri.Memory.AllocId) (entry : Miri.Memory.LocalAllocation Prov Extra MachineKind)
    (alloc' : Miri.Memory.Allocation Prov Extra)
    (race : List (MiriAllocId × RaceClockEntry))
    (hfind : mem.live.find? (fun row => row.1 == id) = some (id, entry)) :
    let mem' : Miri.Memory.MemoryState Prov Extra MachineKind :=
      { mem with live := (mem.live.filter fun r => r.1 != id).push (id, ⟨entry.kind, alloc'⟩) }
    mem.setLiveAllocation id alloc' = .ok mem' ∧
    mem'.nextAllocId = mem.nextAllocId ∧
    mem'.idSupplyExhausted = mem.idSupplyExhausted ∧
    mem'.sourceAllocIdWorldActive = mem.sourceAllocIdWorldActive ∧
    mem'.issuedIds = mem.issuedIds ∧
    mem'.globals = mem.globals ∧
    mem'.dead = mem.dead ∧
    mem'.live.find? (fun row => row.1 == id) = some (id, ⟨entry.kind, alloc'⟩) ∧
    (∀ id', id' ≠ id →
      mem'.live.find? (fun row => row.1 == id') = mem.live.find? (fun row => row.1 == id')) ∧
    memoryStateToKeyed proj mem' race =
      (memoryStateToKeyed proj mem race).insertLive (ofMiriAllocId id)
        (liveEntryOfMiri proj ⟨entry.kind, alloc'⟩) ∧
    (liveEntryOfMiri proj ⟨entry.kind, alloc'⟩ = liveEntryOfMiri proj entry →
      memoryStateToKeyed proj mem' race = memoryStateToKeyed proj mem race) := by
  intro mem'
  have hkw := memoryStateToKeyed_replaceLive proj mem id ⟨entry.kind, alloc'⟩ race
  refine ⟨Miri.Memory.MemoryState.setLiveAllocation_of_find mem id entry alloc' hfind,
    rfl, rfl, rfl, rfl, rfl, rfl, find?_filter_push_self mem.live id _,
    fun id' hne => find?_filter_push_ne mem.live id id' _ hne, hkw, fun hsame => ?_⟩
  rw [hkw, hsame]
  exact keyedAllocWorld_insertLive_self _ _ _ (by
    rw [memoryStateToKeyed_findLive?_of_find, hfind]; rfl)

/-- Projections whose live-entry payload ignores the borrow-tracker `extra` component (e.g. every
`miriAllocBytes`-based projection such as `annealRowProjection`, by
`miriAllocBytes_rowProjection_extraInsensitive`). -/
def RowProjection.ExtraInsensitive {Prov Extra MachineKind : Type}
    (proj : RowProjection Prov Extra MachineKind) : Prop :=
  ∀ (a : Miri.Memory.Allocation Prov Extra) (t : Extra), proj.liveBytes (a.setExtra t) = proj.liveBytes a

/-- Every projection whose live bytes are `miriAllocBytes` — in particular the byte-preserving
`annealRowProjection` — ignores the borrow-tracker `extra` component (`ExtraInsensitive`). -/
theorem miriAllocBytes_rowProjection_extraInsensitive {Prov Extra MachineKind : Type}
    (machineKind : MachineKind → AllocMemKind)
    (globalBytes : Miri.Memory.GlobalAllocation → List MemByte) :
    (⟨machineKind, miriAllocBytes, globalBytes⟩ : RowProjection Prov Extra MachineKind).ExtraInsensitive ∧
    annealRowProjection.ExtraInsensitive :=
  ⟨fun _ _ => rfl, fun _ _ => rfl⟩

private theorem liveEntryOfMiri_setExtra {Prov Extra MachineKind : Type}
    (proj : RowProjection Prov Extra MachineKind) (hproj : proj.ExtraInsensitive)
    (entry : Miri.Memory.LocalAllocation Prov Extra MachineKind) (t : Extra) :
    liveEntryOfMiri proj { entry with allocation := entry.allocation.setExtra t } =
      liveEntryOfMiri proj entry := by
  unfold liveEntryOfMiri
  have hb := hproj entry.allocation t
  have hsz : (entry.allocation.setExtra t).byteSize = entry.allocation.byteSize := rfl
  have hal : (entry.allocation.setExtra t).align = entry.allocation.align := rfl
  have hmu : (entry.allocation.setExtra t).mutability = entry.allocation.mutability := rfl
  simp only [hb, hsz, hal, hmu]

private theorem stackPopWriteBack_toKeyed {K : Type}
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hproj : proj.ExtraInsensitive)
    (mem : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (id : Miri.Memory.AllocId)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (tree : Miri.TreeBorrows.BorrowTree) (race : List (MiriAllocId × RaceClockEntry))
    (hfind : mem.live.find? (fun e => e.1 == id) = some (id, entry)) :
    memoryStateToKeyed proj (stackPopWriteBack mem id entry tree) race =
      memoryStateToKeyed proj mem race := by
  unfold stackPopWriteBack
  rw [memoryStateToKeyed_replaceLive, liveEntryOfMiri_setExtra proj hproj]
  exact keyedAllocWorld_insertLive_self _ _ _ (by
    rw [memoryStateToKeyed_findLive?_of_find, hfind]; rfl)

/-- **The whole frame-pop release fold is invisible in the keyed projection** — on clean completion
AND on a mid-sequence failure (whose partial tree mutations are committed) — for ANY protector list,
with no distinct-key, row-order, or simulation hypothesis. -/
theorem stackPopReleaseAll_preserves_toKeyed {K : Type}
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hproj : proj.ExtraInsensitive)
    (pt : Miri.TreeBorrows.ProtectedTags) (race : List (MiriAllocId × RaceClockEntry))
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag)) :
    ∀ (mem mem' : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
      (res : Option Miri.Interpreter.StepError),
      stackPopReleaseAll pt prots mem = some (mem', res) →
      memoryStateToKeyed proj mem' race = memoryStateToKeyed proj mem race := by
  induction prots with
  | nil =>
    intro mem mem' res h
    injection h with hEq; injection hEq with hm _
    subst hm; rfl
  | cons p rest ih =>
    intro mem mem' res h
    obtain ⟨pid, ptag⟩ := p
    cases hf : mem.live.find? (fun e => e.1 == pid) with
    | none => simp only [stackPopReleaseAll, hf] at h; cases h
    | some pair =>
      simp only [stackPopReleaseAll, hf] at h
      have hpid : pair.1 = pid := eq_of_beq (by simpa using Array.find?_some hf)
      have hf' : mem.live.find? (fun e => e.1 == pid) = some (pid, pair.2) := by
        rw [hf, ← hpid]
      have hwb := stackPopWriteBack_toKeyed proj hproj mem pid pair.2
        (pair.2.allocation.extra.releaseProtector ptag pt).tree race hf'
      cases hE : stackPopReleaseErr (pair.2.allocation.extra.releaseProtector ptag pt).status with
      | none => rw [hE] at h; cases h
      | some r =>
        rw [hE] at h
        cases r with
        | some err =>
          injection h with hEq; injection hEq with hm _
          subst hm; exact hwb
        | none => exact (ih _ mem' res h).trans hwb

/-- **Frame exit is invisible in `KeyedAllocWorld`** (`lean-miri#73` × `lean-miri#74`): for any
projection whose live-entry payload ignores the borrow-tracker `extra`,
`MachineHooks.beforeStackPopWithEnsure` leaves `machineToKeyed` EXACTLY unchanged — both when every
protector release succeeds and when a mid-sequence release raises UB with its partial tree
mutations committed — even though every release rewrites its allocation's row to the END of
`memory.live` (`filter` + `push`). Keying the allocation table by `AllocId` discharges the
row-order obligation outright: no distinct-key, row-order, or simulation hypothesis is used. The
only domain hypothesis is that the release fold is defined (`stackPopReleaseAll … = some _`). -/
theorem miri_beforeStackPopWithEnsure_preserves_machineToKeyed
    {K User : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hproj : proj.ExtraInsensitive)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (prots : Array (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨prots⟩)
    (mem' : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (res : Option Miri.Interpreter.StepError)
    (hall : stackPopReleaseAll tracker.global.protectedTags prots.toList st.machine.memory =
      some (mem', res)) :
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st with
    | .ok () st' =>
      res = none ∧
      machineToKeyed proj raceEntryOf st'.machine = machineToKeyed proj raceEntryOf st.machine
    | .error err st' =>
      res = some err ∧
      machineToKeyed proj raceEntryOf st'.machine = machineToKeyed proj raceEntryOf st.machine := by
  have hrun := miri_beforeStackPopWithEnsure_eq_releaseAll st tracker frame prots
    htracker hframe hbf mem' res hall
  have hkw := stackPopReleaseAll_preserves_toKeyed proj hproj tracker.global.protectedTags
    (st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))
    prots.toList st.machine.memory mem' res hall
  rw [hrun]
  cases res with
  | none => exact ⟨rfl, hkw⟩
  | some err => exact ⟨rfl, hkw⟩

/-- **Bundled environment hypotheses of `allocationMachine_deallocate_eq_deallocateMachine`** (same
content, one argument): pointer resolution is pure and matches `dptr`; alignment exponents fit one
byte; `proj.machineKind` is faithful on the live kinds; no native-backed rows; and — ONLY at the
allocation `id` and provenance extra `pe` that `ptr` resolves to — the uniform vector-clock
correspondence, the Tree Borrows verdict `tb`, and the bookkeeping-hook frame. -/
structure DeallocLockstepEnv {K User Payload : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align))
    (kind : Miri.Memory.MemoryKind K)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (dptr : DeallocPtr) (actor : DeallocActor) (tb : DeallocHookSpec) : Prop where
  tbDomain : tb = .ok ∨ tb = .protectedDealloc
  resMem : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).memory = st.machine.memory
  resState : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).state = ⟨st.machine, none⟩
  resOut :
    match (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome, dptr with
    | .error addr, .dangling daddr => addr = daddr
    | .ok (id, off, _), .provenanced kid koff => ofMiriAllocId id = kid ∧ off.bytes = koff
    | _, _ => False
  alignLive : ∀ row ∈ st.machine.memory.live.toList, row.2.allocation.align.pow2 < 256
  alignReq : ∀ sz al, oldLayout = some (sz, al) → al.pow2 < 256
  kindFaithful : ∀ row ∈ st.machine.memory.live.toList,
    (memKindOfMiri proj.machineKind row.2.kind == memKindOfMiri proj.machineKind kind) =
      decide (row.2.kind = kind)
  noNative : ∀ row ∈ st.machine.memory.live.toList, row.2.allocation.nativeBuffer = none
  activeRace : ∀ global, st.machine.dataRace = some global → global.raceDetecting = true →
    ∃ index clocks, global.activeThreadState st.machine.threads = .ok (index, clocks) ∧
      ∀ id off pe vc row,
        (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
        st.machine.raceAllocations.find? (fun e => e.1 == id) = some (id, vc) →
        st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
        row.allocation.byteSize.bytes ≠ 0 →
        ∃ cell,
          row.allocation.byteSize.bytes.toNat ≤ vc.allocRanges.length.bytes ∧
          (∀ k < row.allocation.byteSize.bytes.toNat, vc.cellAt k = .ok cell) ∧
          ClockEntryRel actor clocks cell (raceEntryOf vc)
  tbMatch : ∀ id off pe row,
    (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
    st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
    match st.machine.borrowTracker with
    | none => tb = .ok
    | some tracker =>
      let r := row.allocation.extra.deallocateBorrowRange pe Miri.ABI.Size.ZERO
        row.allocation.byteSize tracker.global.protectedTags
      (r.status != .Deallocated) = (tb == .protectedDealloc)
  diag : ∀ m id, ∃ m', h.diagnostic id m = .ok () m' ∧
    m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations ∧
    m'.dataRace = m.dataRace ∧ m'.threads = m.threads ∧ m'.borrowTracker = m.borrowTracker ∧
    m'.user = m.user
  retain : ∀ a m, (h.retainDetached a m).memory = m.memory ∧
    (h.retainDetached a m).raceAllocations = m.raceAllocations ∧
    (h.retainDetached a m).user = m.user
  syncOk : ∀ m id off pe row,
    (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) →
    st.machine.memory.live.find? (fun e => e.1 == id) = some (id, row) →
    m.user = st.machine.user →
    ∃ m', Miri.Interpreter.MemoryExtras.beforeDeallocationSync h.extras id m = .ok () m' ∧
      m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations
  spanOk : ∀ m, ∃ sp m', h.currentSpan m = .ok sp m' ∧
    m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations
  freeOk : ∀ m id sz al k, ∃ m', h.freeAllocId id sz al k m = .ok () m' ∧
    m'.memory = m.memory ∧ m'.raceAllocations = m.raceAllocations

private theorem machineDeallocHook_protected_isError (mode : RaceDetectorMode) (actor : DeallocActor)
    (clk? : Option RaceClockEntry) (sz : UInt64) :
    ∃ msg, machineDeallocHook mode actor .protectedDealloc clk? sz = .error msg := by
  unfold machineDeallocHook
  cases mode with
  | unconfigured => exact ⟨_, rfl⟩
  | configured rd =>
    cases clk? with
    | none => exact ⟨_, rfl⟩
    | some c =>
      dsimp only
      split
      · exact ⟨_, rfl⟩
      · exact ⟨_, rfl⟩

private theorem keyed_detachRaceClock_outcome (res : DeallocResult KeyedAllocWorld) :
    (KeyedAllocWorld.detachRaceClock res).outcome = res.outcome := by
  unfold KeyedAllocWorld.detachRaceClock
  split <;> rfl

/-- Under a Tree Borrows protected-deallocation verdict, EVERY `deallocateMachine` outcome is an
error (no branch can tombstone the allocation). -/
private theorem keyed_deallocateMachine_protected_isError (kw : KeyedAllocWorld) (dptr : DeallocPtr)
    (lay : Option (UInt64 × UInt8)) (kind : AllocMemKind) (mode : RaceDetectorMode)
    (actor : DeallocActor) :
    ∃ e, (kw.deallocateMachine dptr lay kind mode actor .protectedDealloc).outcome = .error e := by
  unfold KeyedAllocWorld.deallocateMachine
  rw [keyed_detachRaceClock_outcome]
  unfold KeyedAllocWorld.deallocateWith
  cases dptr with
  | dangling a => exact ⟨_, rfl⟩
  | provenanced id off =>
    dsimp only
    by_cases hoff : (off != 0) = true
    · simp only [hoff, ↓reduceIte]; exact ⟨_, rfl⟩
    · simp only [hoff]
      cases hr : (kw.removeLive id).2 with
      | none => dsimp only; cases kw.findGlobal? id <;> exact ⟨_, rfl⟩
      | some entry =>
        dsimp only
        by_cases hm : (entry.mutability == .not) = true
        · simp only [hm, ↓reduceIte]; exact ⟨_, rfl⟩
        · simp only [hm]
          by_cases hk : (entry.kind != kind) = true
          · simp only [hk, ↓reduceIte]; exact ⟨_, rfl⟩
          · simp only [hk]
            cases hlm : deallocLayoutMismatch? entry lay with
            | some p => obtain ⟨a, b⟩ := p; exact ⟨_, rfl⟩
            | none =>
              dsimp only
              obtain ⟨msg, hmsg⟩ := machineDeallocHook_protected_isError mode actor
                ((kw.removeLive id).1.findRace? id) entry.sizeBytes
              rw [hmsg]
              exact ⟨_, rfl⟩

/-- A zero-offset `deallocateMachine` never leaves its target allocation live — on success and on
EVERY failure branch (post-removal failures retain the detached state). -/
private theorem keyed_deallocateMachine_target_not_live (kw : KeyedAllocWorld) (id : MiriAllocId)
    (lay : Option (UInt64 × UInt8)) (kind : AllocMemKind) (mode : RaceDetectorMode)
    (actor : DeallocActor) (tb : DeallocHookSpec) :
    (kw.deallocateMachine (.provenanced id 0) lay kind mode actor tb).world.findLive? id = none := by
  cases hfl : kw.findLive? id with
  | none =>
    have hrem : kw.removeLive id = (kw, none) := by
      unfold KeyedAllocWorld.removeLive; rw [hfl]
    unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.detachRaceClock KeyedAllocWorld.deallocateWith
    simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, hrem]
    cases kw.findGlobal? id <;> exact hfl
  | some e =>
    have hrem : kw.removeLive id =
        ({ kw with table := { kw.table with live := kw.table.live.erase id } }, some e) := by
      unfold KeyedAllocWorld.removeLive; rw [hfl]
    unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.detachRaceClock KeyedAllocWorld.deallocateWith
    simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, hrem,
      KeyedAllocWorld.removeRace, KeyedAllocWorld.insertDead, KeyedAllocWorld.findLive?]
    repeat first | exact ExtTreeMap0.get?_erase_self _ _ | split

/-- Exact result of a clean machine deallocation of a live, mutable, kind-matching allocation with
no requested layout, a passing hook, and no stale tombstone. -/
private theorem keyed_deallocateMachine_clean (kw : KeyedAllocWorld) (id : MiriAllocId)
    (kind : AllocMemKind) (mode : RaceDetectorMode) (actor : DeallocActor) (tb : DeallocHookSpec)
    (e : LiveAllocEntry)
    (hlive : kw.findLive? id = some e) (hmut : (e.mutability == .not) = false)
    (hkind : (e.kind != kind) = false)
    (hhook : machineDeallocHook mode actor tb (kw.findRace? id) e.sizeBytes = .ok ())
    (hdead : kw.findDead? id = none) :
    kw.deallocateMachine (.provenanced id 0) none kind mode actor tb =
      ⟨((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id,
        some (id, e), .ok ()⟩ := by
  have hrem : kw.removeLive id =
      ({ kw with table := { kw.table with live := kw.table.live.erase id } }, some e) := by
    unfold KeyedAllocWorld.removeLive; rw [hlive]
  have hrace : (kw.removeLive id).1.findRace? id = kw.findRace? id := by rw [hrem]; rfl
  have hdead' : (kw.removeLive id).1.findDead? id = none := by rw [hrem]; exact hdead
  unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.deallocateWith
  simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, hrace, hdead',
    Option.isSome_none, deallocLayoutMismatch?]
  rw [hrem]
  simp only [hmut, hkind, Bool.false_eq_true, ↓reduceIte]
  rw [hhook]
  rfl

/-- A zero-offset `deallocateMachine` of an ID that is neither live nor a global is exactly
`useAfterFree`, leaving the world unchanged (double free / never allocated). -/
private theorem keyed_deallocateMachine_useAfterFree (kw : KeyedAllocWorld) (id : MiriAllocId)
    (lay : Option (UInt64 × UInt8)) (kind : AllocMemKind) (mode : RaceDetectorMode)
    (actor : DeallocActor) (tb : DeallocHookSpec)
    (hlive : kw.findLive? id = none) (hglob : kw.findGlobal? id = none) :
    kw.deallocateMachine (.provenanced id 0) lay kind mode actor tb =
      ⟨kw, none, .error (.useAfterFree id)⟩ := by
  unfold KeyedAllocWorld.deallocateMachine KeyedAllocWorld.deallocateWith KeyedAllocWorld.removeLive
  simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, hlive, hglob]
  rfl

/-- **Keyed world after a clean deallocation** (choice-free): the cursor, exhaustion latch, issued
set, globals and every OTHER live/dead entry are untouched; the target is no longer live, is
tombstoned with its exact layout, has no race clock, and — unless it is also a compiler global — is
not live and rejects EVERY nonzero-size access (`use-after-free`). -/
theorem keyed_clean_dealloc_world_props (kw : KeyedAllocWorld) (id : MiriAllocId) (e : LiveAllocEntry)
    (hlive : kw.findLive? id = some e) :
    let kw' := ((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id
    kw'.nextAllocId = kw.nextAllocId ∧
    kw'.idSupplyExhausted = kw.idSupplyExhausted ∧
    (∀ q, kw'.hasIssued q = kw.hasIssued q) ∧
    (∀ q, kw'.findGlobal? q = kw.findGlobal? q) ∧
    kw'.findLive? id = none ∧
    (∀ q, q ≠ id → kw'.findLive? q = kw.findLive? q) ∧
    kw'.findDead? id = some ⟨e.sizeBytes, e.alignPow2⟩ ∧
    (∀ q, q ≠ id → kw'.findDead? q = kw.findDead? q) ∧
    kw'.findRace? id = none ∧
    (kw.findGlobal? id = none → kw'.isAllocLive id = false ∧
      ∀ (off : UInt64) (n : Nat), n ≠ 0 → kw'.checkPtrAccess (some (id, off)) n = false) := by
  intro kw'
  have hrem : kw.removeLive id =
      ({ kw with table := { kw.table with live := kw.table.live.erase id } }, some e) := by
    unfold KeyedAllocWorld.removeLive; rw [hlive]
  have hL : kw'.findLive? id = none := by
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findLive? id = none
    rw [hrem]; exact ExtTreeMap0.get?_erase_self _ _
  have hD : kw'.findDead? id = some ⟨e.sizeBytes, e.alignPow2⟩ := by
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findDead? id = _
    rw [hrem]; exact ExtTreeMap0.get?_insert_self _ _ _
  have hG : ∀ q, kw'.findGlobal? q = kw.findGlobal? q := fun q => by
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findGlobal? q = _
    rw [hrem]; rfl
  refine ⟨?_, ?_, ?_, hG, hL, ?_, hD, ?_, ?_, fun hg => ⟨?_, fun off n hn => ?_⟩⟩
  · show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).nextAllocId = _
    rw [hrem]; rfl
  · show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).idSupplyExhausted = _
    rw [hrem]; rfl
  · intro q
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).hasIssued q = _
    rw [hrem]; rfl
  · intro q hq
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findLive? q = _
    rw [hrem]; exact ExtTreeMap0.get?_erase_ne _ hq
  · intro q hq
    show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findDead? q = _
    rw [hrem]; exact ExtTreeMap0.get?_insert_ne _ _ hq
  · show (((kw.removeLive id).1.insertDead id ⟨e.sizeBytes, e.alignPow2⟩).removeRace id).findRace? id = none
    rw [hrem]; exact ExtTreeMap0.get?_erase_self _ _
  · unfold KeyedAllocWorld.isAllocLive
    rw [hL, hG, hg]; rfl
  · unfold KeyedAllocWorld.checkPtrAccess KeyedAllocWorld.getAllocInfo
    have hn0 : (n == 0) = false := beq_false_of_ne hn
    simp only [hn0, Bool.false_eq_true, ↓reduceIte, hL, hG, hg, hD]
    split <;> rfl

section DeallocCorollaries

variable {K User Payload : Type} [DecidableEq K]
  {proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K}
  {raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry}
  {h : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload}
  {ptr : Miri.Memory.Pointer (Option Miri.Memory.Provenance)}
  {oldLayout : Option (Miri.ABI.Size × Miri.ABI.Align)}
  {kind : Miri.Memory.MemoryKind K}
  {st : Miri.Interpreter.MachineHooks.State K User}
  {dptr : DeallocPtr} {actor : DeallocActor} {tb : DeallocHookSpec}

private theorem DeallocLockstepEnv.lockstep
    (env : DeallocLockstepEnv proj raceEntryOf h ptr oldLayout kind st dptr actor tb) :
    let mExec := Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st
    let expLayout := oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2)
    let kres := (machineToKeyed proj raceEntryOf st.machine).deallocateMachine dptr expLayout
      (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor tb
    let (mOut, st') := match mExec with
      | .ok () s => (Except.ok (), s)
      | .error e s => (Except.error e, s)
    machineToKeyed proj raceEntryOf st'.machine = kres.world ∧
    DeallocMachineOutcomeRel h mOut kres.outcome :=
  allocationMachine_deallocate_eq_deallocateMachine proj raceEntryOf h ptr oldLayout kind st dptr actor tb
    env.tbDomain env.resMem env.resState env.resOut env.alignLive env.alignReq env.kindFaithful
    env.noNative env.activeRace env.tbMatch env.diag env.retain env.syncOk env.spanOk env.freeOk

/-- **Protected deallocation fails and detaches — DERIVED from the full lockstep** (`lean-miri#73` ×
`lean-miri#74`): under a Tree Borrows protected-deallocation verdict (`tb = .protectedDealloc`),
vendored `AllocationMachine.deallocate` ALWAYS fails (for every pointer shape and every earlier
failure branch); its failure state is exactly the theory's `deallocateMachine … .protectedDealloc`
world with a related outcome, and a zero-offset target is NOT live in the failure state (the
detached allocation is retained by the failure, never re-inserted). -/
theorem allocationMachine_deallocate_protected_fails_detached
    (env : DeallocLockstepEnv proj raceEntryOf h ptr oldLayout kind st dptr actor .protectedDealloc) :
    let kres := (machineToKeyed proj raceEntryOf st.machine).deallocateMachine dptr
      (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2))
      (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor .protectedDealloc
    ∃ err st',
      Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st = .error err st' ∧
      machineToKeyed proj raceEntryOf st'.machine = kres.world ∧
      DeallocMachineOutcomeRel h (.error err) kres.outcome ∧
      (∀ kid, dptr = .provenanced kid 0 →
        (machineToKeyed proj raceEntryOf st'.machine).findLive? kid = none) := by
  intro kres
  have hl := env.lockstep
  dsimp only at hl
  obtain ⟨e, he⟩ := keyed_deallocateMachine_protected_isError (machineToKeyed proj raceEntryOf st.machine)
    dptr (oldLayout.map fun p => (p.1.bytes, UInt8.ofNat p.2.pow2))
    (memKindOfMiri proj.machineKind kind) (raceModeOfMachine st.machine) actor
  cases hrun : Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st with
  | ok u s =>
    cases u
    rw [hrun] at hl
    dsimp only at hl
    rw [he] at hl
    cases hl.2
  | error err s =>
    rw [hrun] at hl
    dsimp only at hl
    refine ⟨err, s, rfl, hl.1, hl.2, fun kid hd => ?_⟩
    subst hd
    rw [hl.1]
    exact keyed_deallocateMachine_target_not_live _ _ _ _ _ _ _

/-- **Clean deallocation succeeds and tombstones — DERIVED from the full lockstep**: for a live,
mutable, kind-matching allocation with no requested layout, a passing race/Tree-Borrows hook
(`tb = .ok`) and no stale tombstone, vendored `AllocationMachine.deallocate` returns `.ok`, and the
post-state's keyed world is exactly the theory's live → dead transition. -/
theorem allocationMachine_deallocate_clean_ok
    {id : Miri.Memory.AllocId}
    (env : DeallocLockstepEnv proj raceEntryOf h ptr none kind st
      (.provenanced (ofMiriAllocId id) 0) actor .ok)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hfind : st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry))
    (hmut : entry.allocation.mutability = .Mut)
    (hkind : entry.kind = kind)
    (hhook : machineDeallocHook (raceModeOfMachine st.machine) actor .ok
      ((machineToKeyed proj raceEntryOf st.machine).findRace? (ofMiriAllocId id))
      entry.allocation.byteSize.bytes = .ok ())
    (hdead : ∀ d ∈ st.machine.memory.dead.toList, d.allocId ≠ id) :
    let kw := machineToKeyed proj raceEntryOf st.machine
    ∃ st',
      Miri.Interpreter.AllocationMachine.deallocate h ptr none kind st = .ok () st' ∧
      machineToKeyed proj raceEntryOf st'.machine =
        ((kw.removeLive (ofMiriAllocId id)).1.insertDead (ofMiriAllocId id)
          ⟨entry.allocation.byteSize.bytes, UInt8.ofNat entry.allocation.align.pow2⟩).removeRace
            (ofMiriAllocId id) ∧
      kw.findLive? (ofMiriAllocId id) = some (liveEntryOfMiri proj entry) := by
  intro kw
  have hl := env.lockstep
  dsimp only at hl
  have hkl : kw.findLive? (ofMiriAllocId id) = some (liveEntryOfMiri proj entry) := by
    show (memoryStateToKeyed proj st.machine.memory _).findLive? (ofMiriAllocId id) = _
    rw [memoryStateToKeyed_findLive?_of_find, hfind]; rfl
  have hkd : kw.findDead? (ofMiriAllocId id) = none := by
    have hkw : kw.findDead? (ofMiriAllocId id) =
        ((memoryStateToRows st.machine.memory).toKeyed proj).findDead? (ofMiriAllocId id) := rfl
    rw [hkw, toKeyed_findDead?]
    have hnone : (memoryStateToRows st.machine.memory).dead.toList.find?
        (fun entry => entry.allocId == id) = none := by
      rw [List.find?_eq_none]
      intro d hd hb
      exact hdead d hd (eq_of_beq hb)
    rw [hnone]; rfl
  have hmutK : ((liveEntryOfMiri proj entry).mutability == .not) = false := by
    unfold liveEntryOfMiri mutabilityOfMiri; rw [hmut]; rfl
  have hkindK : ((liveEntryOfMiri proj entry).kind != memKindOfMiri proj.machineKind kind) = false := by
    unfold liveEntryOfMiri; rw [hkind]; exact bne_self_eq_false _
  have hclean := keyed_deallocateMachine_clean kw (ofMiriAllocId id) (memKindOfMiri proj.machineKind kind)
    (raceModeOfMachine st.machine) actor .ok (liveEntryOfMiri proj entry) hkl hmutK hkindK hhook hkd
  have hexp : (Option.map (fun p : Miri.ABI.Size × Miri.ABI.Align => (p.1.bytes, UInt8.ofNat p.2.pow2)) none) =
      (none : Option (UInt64 × UInt8)) := rfl
  rw [hexp, hclean] at hl
  cases hrun : Miri.Interpreter.AllocationMachine.deallocate h ptr none kind st with
  | error err s =>
    rw [hrun] at hl
    dsimp only at hl
    cases hl.2
  | ok u s =>
    cases u
    rw [hrun] at hl
    dsimp only at hl
    exact ⟨s, rfl, hl.1, hkl⟩

/-- **Double free / use-after-free deallocation is rejected — DERIVED from the full lockstep**:
deallocating a zero-offset pointer whose allocation is neither live nor a global fails with
`useAfterFree` and leaves the keyed world unchanged. -/
theorem allocationMachine_deallocate_useAfterFree
    {id : Miri.Memory.AllocId}
    (env : DeallocLockstepEnv proj raceEntryOf h ptr oldLayout kind st
      (.provenanced (ofMiriAllocId id) 0) actor tb)
    (hlive : (machineToKeyed proj raceEntryOf st.machine).findLive? (ofMiriAllocId id) = none)
    (hglob : (machineToKeyed proj raceEntryOf st.machine).findGlobal? (ofMiriAllocId id) = none) :
    ∃ err st',
      Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st = .error err st' ∧
      DeallocMachineOutcomeRel h (.error err) (.error (.useAfterFree (ofMiriAllocId id))) ∧
      machineToKeyed proj raceEntryOf st'.machine = machineToKeyed proj raceEntryOf st.machine := by
  have hl := env.lockstep
  dsimp only at hl
  rw [keyed_deallocateMachine_useAfterFree _ _ _ _ _ _ _ hlive hglob] at hl
  cases hrun : Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st with
  | ok u s =>
    cases u
    rw [hrun] at hl
    dsimp only at hl
    cases hl.2
  | error err s =>
    rw [hrun] at hl
    dsimp only at hl
    exact ⟨err, s, rfl, hl.2, hl.1⟩

/-- **Exact vendored memory after a successful machine deallocation** (`lean-miri#73`): whenever
`AllocationMachine.deallocate` returns `.ok`, the pointer resolved at offset `0` to a live row
`(id, entry)`, and the post-state memory is the pre-state memory with EXACTLY that row filtered out
of `live` and its tombstone `⟨id, size, align⟩` pushed onto `dead` — every other `MemoryState`
component (allocation-ID cursor, exhaustion latch, issued IDs, globals, source-ID switch, …) is
untouched, and the stack is unchanged. In particular deallocation never rewinds `nextAllocId`. -/
theorem allocationMachine_deallocate_ok_memory_eq
    (env : DeallocLockstepEnv proj raceEntryOf h ptr oldLayout kind st dptr actor tb)
    (st' : Miri.Interpreter.MachineHooks.State K User)
    (hok : Miri.Interpreter.AllocationMachine.deallocate h ptr oldLayout kind st = .ok () st') :
    ∃ id off pe entry,
      (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome = .ok (id, off, pe) ∧
      off.bytes = 0 ∧
      st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
      st'.machine.memory = { st.machine.memory with
        live := st.machine.memory.live.filter fun e => e.1 != id
        dead := (st.machine.memory.dead.filter fun d => d.allocId != id).push
          ⟨id, entry.allocation.byteSize, entry.allocation.align⟩ } ∧
      st'.stack = st.stack := by
  obtain ⟨htbDomain, hresMem, hresState, _, _, _, _, hnoNative, hactiveRace, htbMatch, hdiag, hretain,
    hsyncOk, hspanOk, hfreeOk⟩ := env
  rcases hres : h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0 with ⟨rmem, rstate, rout⟩
  rw [hres] at hresMem hresState
  dsimp only at hresMem hresState
  subst hresMem
  subst hresState
  cases hro : rout with
  | error addr =>
    exfalso
    rw [allocationMachine_deallocate_unfold] at hok
    unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith at hok
    simp only [Id.run, pure, Pure.pure, hres, hro] at hok
    cases hok
  | ok triple =>
    rcases triple with ⟨allocId, offset, provExtra⟩
    have hout : (h.resolvePointer st.machine.memory ⟨st.machine, none⟩ ptr 0).outcome =
        .ok (allocId, offset, provExtra) := by rw [hres]; exact hro
    by_cases hoff : offset.bytes = 0
    · have hne : (offset.bytes != 0) = false := by simp [hoff]
      cases hremM : miriMSRemoveLive st.machine.memory allocId with
      | mk afterRemove entry? =>
        cases entry? with
        | none =>
          exfalso
          rw [allocationMachine_deallocate_unfold] at hok
          unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith at hok
          simp only [Id.run, bind, Bind.bind, pure, Pure.pure, hres, hro, hne,
            Bool.false_eq_true, ↓reduceIte, hremM] at hok
          cases hfg : st.machine.memory.findGlobal? allocId with
          | none => rw [hfg] at hok; cases hok
          | some g => rw [hfg] at hok; cases hok
        | some entry =>
          obtain ⟨hliveRow, hafter⟩ := miriMSRemoveLive_find st.machine.memory afterRemove allocId entry hremM
          have hrowMem : (allocId, entry) ∈ st.machine.memory.live.toList := by
            rw [← Array.find?_toList] at hliveRow; exact List.mem_of_find?_eq_some hliveRow
          have hnn := hnoNative (allocId, entry) hrowMem
          rw [allocationMachine_deallocate_live_eq h ptr oldLayout kind st afterRemove allocId offset entry
            provExtra (by rw [hres, hro]) hne hremM hnn] at hok
          dsimp only at hok
          have hbf := allocationMachine_deallocate_beforeSpec proj raceEntryOf h kind st actor tb
            allocId entry provExtra htbDomain
            (fun global hdr hdet => by
              obtain ⟨index, clocks, hact, hclks⟩ := hactiveRace global hdr hdet
              exact ⟨index, clocks, hact, fun vc hrf hz =>
                hclks allocId offset provExtra vc entry hout hrf hliveRow hz⟩)
            (htbMatch allocId offset provExtra entry hout hliveRow)
            hdiag hretain
            (fun m hu => hsyncOk m allocId offset provExtra entry hout hliveRow hu)
            hspanOk hfreeOk afterRemove
          dsimp only at hbf
          have hbfMem : ∀ mOut, miriAllocMachBefore h entry.allocation allocId provExtra
              entry.allocation.byteSize entry.allocation.align kind
              { st.machine with memory := afterRemove } = .ok () mOut → mOut.memory = afterRemove := by
            intro mOut hbo
            rw [hbo] at hbf
            exact hbf.1
          cases hO : (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).outcome with
          | error e => rw [hO] at hok; cases hok
          | ok u =>
            cases u
            rw [hO] at hok
            have hmem := deallocateLiveRes_ok_memory h ptr oldLayout kind st afterRemove allocId entry
              provExtra hbfMem hO
            injection hok with _ hst
            subst hst
            refine ⟨allocId, offset, provExtra, entry, rfl, hoff, hliveRow, ?_, rfl⟩
            show (deallocateLiveRes h ptr oldLayout kind st afterRemove allocId entry provExtra).memory = _
            rw [hmem, hafter]
            rfl
    · exfalso
      have hne : (offset.bytes != 0) = true := bne_iff_ne.mpr hoff
      rw [allocationMachine_deallocate_unfold] at hok
      unfold Miri.Memory.MemoryLifecycle.deallocatePtrWith at hok
      simp only [Id.run, bind, Bind.bind, pure, Pure.pure, hres, hro, hne, ↓reduceIte] at hok
      cases hok

end DeallocCorollaries

/-! ### 2E.2a.2 `PlaceMachine.allocateStackRaw` lockstep, the high-water invariant, and the composed
multi-step lifecycle (`allocate -> store commit -> retag commit + protected-dealloc detached failure ->
frame-exit -> deallocate + UAF/double-free -> fresh allocate` without ABA), each stage derived from the
vendored operation that produces its state -/

private theorem memoryState_reserve_highWater_props {Prov Extra MachineKind : Type}
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind)
    (hnosrc : mem.sourceAllocIdWorldActive = false)
    (havail : mem.idSupplyExhausted = false)
    (hnz : mem.nextAllocId ≠ 0)
    (hiss : ∀ id ∈ mem.issuedIds, id.value.toNat < mem.nextAllocId.toNat)
    (hlive : ∀ row ∈ mem.live, row.1.value.toNat < mem.nextAllocId.toNat)
    (hglob : ∀ row ∈ mem.globals, row.allocId.value.toNat < mem.nextAllocId.toNat)
    (hdead : ∀ row ∈ mem.dead, row.allocId.value.toNat < mem.nextAllocId.toNat) :
    let id : Miri.Memory.AllocId := ⟨mem.nextAllocId, hnz⟩
    let res := mem.reserveAllocId
    res.2 = .ok id ∧
    res.1.nextAllocId = mem.nextAllocId + 1 ∧
    res.1.idSupplyExhausted = false ∧
    res.1.sourceAllocIdWorldActive = false ∧
    res.1.live = mem.live ∧
    res.1.dead = mem.dead ∧
    res.1.globals = mem.globals ∧
    res.1.issuedIds = mem.issuedIds.push id := by
  intro id res
  obtain ⟨after, hres⟩ := Miri.Memory.MemoryState.reserve_of_highWater mem havail hnz
    (fun h => by rw [hnosrc] at h; cases h) (fun h => by rw [hnosrc] at h; cases h)
    hiss hlive hglob hdead
  have hof : Miri.Memory.AllocId.ofUInt64 mem.nextAllocId = some id := by
    simp [Miri.Memory.AllocId.ofUInt64, hnz, id]
  have hdef : mem.reserveAllocId =
      (if miriMSContainsId mem id then
        ({ mem with nextAllocId := mem.nextAllocId + 1 }, .error (.alreadyIssued id))
       else
        ({ mem with
           nextAllocId := mem.nextAllocId + 1
           issuedIdTable := ((miri_etm_private% Miri.Memory.MemoryState Miri.Memory.MemoryState.issuedIdTable) mem).push id },
         .ok id)) := by
    unfold Miri.Memory.MemoryState.reserveAllocId
    simp only [Id.run, pure, Pure.pure, havail, hnosrc, Bool.false_and,
      Bool.or_self, Bool.false_eq_true, ↓reduceIte, hof]
  have hres' := hres
  rw [hdef] at hres'
  cases hc : miriMSContainsId mem id with
  | true => rw [hc] at hres'; simp at hres'
  | false =>
    have hEq : res = ({ mem with
        nextAllocId := mem.nextAllocId + 1
        issuedIdTable := ((miri_etm_private% Miri.Memory.MemoryState Miri.Memory.MemoryState.issuedIdTable) mem).push id },
        .ok id) := by
      dsimp only [res]; rw [hdef, hc]; rfl
    rw [hEq]
    refine ⟨rfl, rfl, havail, hnosrc, rfl, rfl, rfl, rfl⟩

private theorem array_filter_id_of_all_ne {α : Type} (xs : Array (Miri.Memory.AllocId × α))
    (id : Miri.Memory.AllocId) (hne : ∀ row ∈ xs, row.1 ≠ id) :
    (xs.filter fun row => row.1 != id) = xs := by
  apply Array.ext'
  rw [Array.toList_filter]
  exact List.filter_eq_self.mpr (fun row hr => bne_iff_ne.mpr (hne row (Array.mem_def.mpr hr)))

private theorem memoryStateToKeyed_pushLive_fresh {Prov Extra MachineKind : Type}
    (proj : RowProjection Prov Extra MachineKind)
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind)
    (id : Miri.Memory.AllocId) (row : Miri.Memory.LocalAllocation Prov Extra MachineKind)
    (hfresh : ∀ r ∈ mem.live, r.1 ≠ id)
    (race : List (MiriAllocId × RaceClockEntry)) :
    memoryStateToKeyed proj { mem with live := mem.live.push (id, row) } race =
      (memoryStateToKeyed proj mem race).insertLive (ofMiriAllocId id) (liveEntryOfMiri proj row) := by
  have h := memoryStateToKeyed_replaceLive proj mem id row race
  rw [array_filter_id_of_all_ne mem.live id hfresh] at h
  exact h

/-- **Vendored `PlaceMachine.allocateStackRaw` <-> `KeyedAllocWorld.allocate` lockstep on the
SUCCESS path**: under the high-water `nextAllocId` invariant, `PlaceMachine.allocateStackRaw` allocates
fresh `id := ⟨st.machine.memory.nextAllocId, hnz⟩`, initializes `BorrowTree.new rootTag size`, advances
`nextAllocId` to `id.value + 1`, appends `id` to `live` and `issuedIds`, preserves `dead` and
`globals`, and matches `KeyedAllocWorld.allocate` propositionally on `machineToKeyed`.

Scope (exact): non-native storage (`nativeStorage = none`), a successful `Allocation.tryNew` within
`maximumObjectSize`, pure `diagnostic` / `allocationTail` / `adjustRootAddress` hooks, and the data-race
detector UNCONFIGURED (`dataRace = none`, so no vector clock is seeded and the theory side is
`allocate`, not `allocateMachine`). The failure branches (storage error, oversized object, exhausted or
already-issued ID, root-tag or clock errors) and the race-configured clock seeding are not covered. -/
theorem placeMachine_allocateStackRaw_eq_keyed {K User : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (cfg : Miri.Interpreter.PlaceMachine.AllocationConfig K User)
    (size : Miri.ABI.Size) (align : Miri.ABI.Align)
    (st : Miri.Interpreter.MachineHooks.State K User)
    (alloc : Miri.Memory.Allocation Miri.Memory.Provenance Unit)
    (hnatCfg : cfg.nativeStorage = none)
    (htry : Miri.Memory.Allocation.tryNew (Prov := Miri.Memory.Provenance) size align .Uninit cfg.zeroedStorage = .ok alloc)
    (hfit : ¬ alloc.byteSize.bytes > cfg.maximumObjectSize.bytes)
    (hnosrc : st.machine.memory.sourceAllocIdWorldActive = false)
    (havail : st.machine.memory.idSupplyExhausted = false)
    (hnz : st.machine.memory.nextAllocId ≠ 0)
    (hiss : ∀ id ∈ st.machine.memory.issuedIds, id.value.toNat < st.machine.memory.nextAllocId.toNat)
    (hlive : ∀ row ∈ st.machine.memory.live, row.1.value.toNat < st.machine.memory.nextAllocId.toNat)
    (hglob : ∀ row ∈ st.machine.memory.globals, row.allocId.value.toNat < st.machine.memory.nextAllocId.toNat)
    (hdead : ∀ row ∈ st.machine.memory.dead, row.allocId.value.toNat < st.machine.memory.nextAllocId.toNat)
    (hnoRace : st.machine.dataRace = none)
    (hdiag : ∀ id m, cfg.diagnostic id size align m = .ok () m)
    (userAfter : User)
    (htail : ∀ m, m.user = st.machine.user →
      cfg.allocationTail ⟨st.machine.memory.nextAllocId, hnz⟩ size align m = .ok () { m with user := userAfter })
    (rootTag : Miri.Memory.BorTag)
    (trackerAfter : Option Miri.Interpreter.MachineHooks.BorrowState)
    (hbt : match st.machine.borrowTracker with
      | none => rootTag = Miri.Memory.BorTag.one ∧ trackerAfter = none
      | some tr =>
        ∃ g', tr.global.rootPointerTag ⟨st.machine.memory.nextAllocId, hnz⟩ = .ok (g', rootTag) ∧
          g'.rootTag? ⟨st.machine.memory.nextAllocId, hnz⟩ = some rootTag ∧
          trackerAfter = some { tr with global := g' })
    (rootPtr : Miri.Memory.Pointer Miri.Memory.Provenance)
    (hadj : ∀ s, cfg.adjustRootAddress ⟨st.machine.memory.nextAllocId, hnz⟩ rootTag s = .ok rootPtr s) :
    let id : Miri.Memory.AllocId := ⟨st.machine.memory.nextAllocId, hnz⟩
    let tree : Miri.TreeBorrows.BorrowTree := Miri.TreeBorrows.BorrowTree.new rootTag size
    let memRes := st.machine.memory.reserveAllocId.1
    let mem' : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
      { memRes with live := memRes.live.push (id, ⟨.stack, alloc.withExtra tree⟩) }
    let st' : Miri.Interpreter.MachineHooks.State K User :=
      { st with machine := { st.machine with memory := mem', borrowTracker := trackerAfter, user := userAfter } }
    let entry := liveEntryOfMiri proj ⟨.stack, alloc.withExtra tree⟩
    let (kw', kres) := (machineToKeyed proj raceEntryOf st.machine).allocate entry
    Miri.Interpreter.PlaceMachine.allocateStackRaw cfg size align st =
      .ok rootPtr.withOptionalProvenance st' ∧
    machineToKeyed proj raceEntryOf st'.machine = kw' ∧
    kres = .ok (ofMiriAllocId id) ∧
    st'.machine.memory.nextAllocId = id.value + 1 ∧
    st'.machine.memory.idSupplyExhausted = false ∧
    st'.machine.memory.sourceAllocIdWorldActive = false ∧
    st'.machine.memory.live = st.machine.memory.live.push (id, ⟨.stack, alloc.withExtra tree⟩) ∧
    st'.machine.memory.dead = st.machine.memory.dead ∧
    st'.machine.memory.globals = st.machine.memory.globals ∧
    st'.machine.memory.issuedIds = st.machine.memory.issuedIds.push id := by
  intro id tree memRes mem' st' entry
  obtain ⟨hres2, hnext, hexh, hsrc, hlv, hdd, hgl, hiss'⟩ :=
    memoryState_reserve_highWater_props st.machine.memory hnosrc havail hnz hiss hlive hglob hdead
  have hresPair : st.machine.memory.reserveAllocId = (memRes, .ok id) := Prod.ext rfl hres2
  have hkwRes := memoryState_reserveAllocId_eq_keyed proj st.machine.memory hnosrc
    (st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))
  have hinitEx :
      Miri.Interpreter.PlaceMachine.initStackExtra cfg.allocationTail id size align
        { st.machine with memory := memRes } =
        .ok tree { st.machine with memory := memRes, borrowTracker := trackerAfter, user := userAfter } := by
    unfold Miri.Interpreter.PlaceMachine.initStackExtra
    cases htr : st.machine.borrowTracker with
    | none =>
      rw [htr] at hbt
      obtain ⟨rfl, rfl⟩ := hbt
      simp only [bind, Bind.bind, pure, Pure.pure, EStateM.bind, EStateM.pure,
        get, MonadState.get, getThe, MonadStateOf.get, EStateM.get,
        set, MonadStateOf.set, EStateM.set, htr, hnoRace]
      rw [htail { st.machine with memory := memRes, borrowTracker := none, dataRace := none } rfl]
    | some tr =>
      rw [htr] at hbt
      obtain ⟨g', hgp, _, rfl⟩ := hbt
      have hgp' : tr.global.rootPointerTag id = .ok (g', rootTag) := hgp
      simp only [bind, Bind.bind, pure, Pure.pure, EStateM.bind, EStateM.pure,
        get, MonadState.get, getThe, MonadStateOf.get, EStateM.get,
        set, MonadStateOf.set, EStateM.set, htr, hgp', hnoRace]
      rw [htail { st.machine with memory := memRes, borrowTracker := some { tr with global := g' }, dataRace := none } rfl]
  have heval : Miri.Interpreter.PlaceMachine.allocateStackRaw cfg size align st =
      .ok rootPtr.withOptionalProvenance st' := by
    unfold Miri.Interpreter.PlaceMachine.allocateStackRaw
    cases htr : st.machine.borrowTracker with
    | none =>
      rw [htr] at hbt; obtain ⟨rfl, rfl⟩ := hbt
      have hadj' : ∀ s, cfg.adjustRootAddress id Miri.Memory.BorTag.one s = .ok rootPtr s := hadj
      simp only [bind, Bind.bind, pure, Pure.pure, EStateM.bind, EStateM.pure,
        get, MonadState.get, getThe, MonadStateOf.get, EStateM.get,
        set, MonadStateOf.set, EStateM.set,
        modify, MonadState.modifyGet, MonadStateOf.modifyGet, EStateM.modifyGet,
        tryCatch, tryCatchThe, MonadExceptOf.tryCatch, EStateM.tryCatch,
        ExceptT.pure, ExceptT.run, EarlyReturn.runK,
        hnatCfg, htry, hfit, ↓reduceIte, hresPair, hdiag, hinitEx, hadj']
      rfl
    | some tr =>
      rw [htr] at hbt; obtain ⟨g', _, hrt, rfl⟩ := hbt
      have hrt' : g'.rootTag? id = some rootTag := hrt
      have hadj' : ∀ s, cfg.adjustRootAddress id rootTag s = .ok rootPtr s := hadj
      simp only [bind, Bind.bind, pure, Pure.pure, EStateM.bind, EStateM.pure,
        get, MonadState.get, getThe, MonadStateOf.get, EStateM.get,
        set, MonadStateOf.set, EStateM.set,
        modify, MonadState.modifyGet, MonadStateOf.modifyGet, EStateM.modifyGet,
        tryCatch, tryCatchThe, MonadExceptOf.tryCatch, EStateM.tryCatch,
        ExceptT.pure, ExceptT.run, EarlyReturn.runK,
        hnatCfg, htry, hfit, ↓reduceIte, hresPair, hdiag, hinitEx, hrt', hadj']
      rfl
  have hfresh : ∀ r ∈ memRes.live, r.1 ≠ id := fun r hr heq => by
    rw [hlv] at hr
    have hlt := hlive r hr
    rw [heq] at hlt
    exact Nat.lt_irrefl _ hlt
  have hkw : machineToKeyed proj raceEntryOf st'.machine =
      ((machineToKeyed proj raceEntryOf st.machine).allocate entry).1 ∧
      ((machineToKeyed proj raceEntryOf st.machine).allocate entry).2 = .ok (ofMiriAllocId id) := by
    unfold KeyedAllocWorld.allocate machineToKeyed
    rw [hresPair] at hkwRes
    cases hk : (memoryStateToKeyed proj st.machine.memory
        (st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))).reserveAllocId with
    | mk kw1 kout =>
      rw [hk] at hkwRes
      rcases hkwRes with ⟨hkw1, hout⟩
      simp only [Except.map, Except.mapError] at hout
      rw [← hout]
      refine ⟨?_, rfl⟩
      have hpush := memoryStateToKeyed_pushLive_fresh proj memRes id ⟨.stack, alloc.withExtra tree⟩ hfresh
        (st.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))
      change memoryStateToKeyed proj { memRes with live := memRes.live.push (id, ⟨.stack, alloc.withExtra tree⟩) } _ = _
      rw [hpush, hkw1]
  exact ⟨heval, hkw.1, hkw.2, hnext, hexh, hsrc, by dsimp only [st', mem']; rw [hlv], hdd, hgl, hiss'⟩

/-- **High-water allocation-ID invariant** of a vendored `MemoryState` — exactly the hypotheses of
vendored `MemoryState.reserve_of_highWater`: no source-allocation-ID world, a live ID supply, and
every issued / live / global / dead ID strictly below the cursor `nextAllocId`. It is an inductive
invariant of the lifecycle operations (`allocateStackRaw` without cursor wrap-around,
`setLiveAllocation`, frame-pop release, clean deallocation). -/
structure MemoryStateHighWater {Prov Extra MachineKind : Type}
    (mem : Miri.Memory.MemoryState Prov Extra MachineKind) : Prop where
  noSource : mem.sourceAllocIdWorldActive = false
  avail : mem.idSupplyExhausted = false
  issued : ∀ id ∈ mem.issuedIds, id.value.toNat < mem.nextAllocId.toNat
  live : ∀ row ∈ mem.live, row.1.value.toNat < mem.nextAllocId.toNat
  globals : ∀ row ∈ mem.globals, row.allocId.value.toNat < mem.nextAllocId.toNat
  dead : ∀ row ∈ mem.dead, row.allocId.value.toNat < mem.nextAllocId.toNat

private theorem array_mem_of_find? {α : Type} {xs : Array α} {p : α → Bool} {a : α}
    (h : xs.find? p = some a) : a ∈ xs := by
  rw [← Array.find?_toList] at h
  exact Array.mem_def.mpr (List.mem_of_find?_eq_some h)

private theorem MemoryStateHighWater.replaceLive {Prov Extra MachineKind : Type}
    {mem : Miri.Memory.MemoryState Prov Extra MachineKind} (hw : MemoryStateHighWater mem)
    (id : Miri.Memory.AllocId) (row : Miri.Memory.LocalAllocation Prov Extra MachineKind)
    (hid : id.value.toNat < mem.nextAllocId.toNat) :
    MemoryStateHighWater { mem with live := (mem.live.filter fun r => r.1 != id).push (id, row) } := by
  refine ⟨hw.noSource, hw.avail, hw.issued, ?_, hw.globals, hw.dead⟩
  intro r hr
  rcases Array.mem_push.mp hr with h1 | h2
  · exact hw.live r (Array.mem_filter.mp h1).1
  · subst h2; exact hid

private theorem MemoryStateHighWater.tombstone {Prov Extra MachineKind : Type}
    {mem : Miri.Memory.MemoryState Prov Extra MachineKind} (hw : MemoryStateHighWater mem)
    (id : Miri.Memory.AllocId) (sz : Miri.ABI.Size) (al : Miri.ABI.Align)
    (hid : id.value.toNat < mem.nextAllocId.toNat) :
    MemoryStateHighWater { mem with
      live := mem.live.filter fun e => e.1 != id
      dead := (mem.dead.filter fun d => d.allocId != id).push ⟨id, sz, al⟩ } := by
  refine ⟨hw.noSource, hw.avail, hw.issued, ?_, hw.globals, ?_⟩
  · intro r hr; exact hw.live r (Array.mem_filter.mp hr).1
  · intro d hd
    rcases Array.mem_push.mp hd with h1 | h2
    · exact hw.dead d (Array.mem_filter.mp h1).1
    · subst h2; exact hid

/-- Allocation at the high-water cursor (reserve + push) re-establishes the invariant one ID later,
provided the cursor does not wrap. -/
private theorem MemoryStateHighWater.reservePush {Prov Extra MachineKind : Type}
    {mem : Miri.Memory.MemoryState Prov Extra MachineKind} (hw : MemoryStateHighWater mem)
    (hnz : mem.nextAllocId ≠ 0) (hnoWrap : mem.nextAllocId.toNat + 1 < 2 ^ 64)
    (row : Miri.Memory.LocalAllocation Prov Extra MachineKind) :
    let id : Miri.Memory.AllocId := ⟨mem.nextAllocId, hnz⟩
    let mem' : Miri.Memory.MemoryState Prov Extra MachineKind :=
      { mem.reserveAllocId.1 with live := mem.reserveAllocId.1.live.push (id, row) }
    MemoryStateHighWater mem' ∧
    mem'.nextAllocId = mem.nextAllocId + 1 ∧
    (mem.nextAllocId + 1).toNat = mem.nextAllocId.toNat + 1 ∧
    mem'.globals = mem.globals ∧
    mem'.dead = mem.dead ∧
    mem'.live.find? (fun e => e.1 == id) = some (id, row) := by
  intro id mem'
  obtain ⟨_, hnext, hexh, hsrc, hlv, hdd, hgl, hiss'⟩ :=
    memoryState_reserve_highWater_props mem hw.noSource hw.avail hnz hw.issued hw.live hw.globals hw.dead
  have hadd : (mem.nextAllocId + 1).toNat = mem.nextAllocId.toNat + 1 := by
    rw [UInt64.toNat_add]
    exact Nat.mod_eq_of_lt (by simpa using hnoWrap)
  refine ⟨⟨hsrc, hexh, ?_, ?_, ?_, ?_⟩, hnext, hadd, hgl, hdd, ?_⟩
  · intro x hx
    have hx' : x ∈ mem.issuedIds.push id := by rw [← hiss']; exact hx
    show x.value.toNat < (mem.reserveAllocId.1.nextAllocId).toNat
    rw [hnext, hadd]
    rcases Array.mem_push.mp hx' with h1 | h2
    · exact Nat.lt_succ_of_lt (hw.issued x h1)
    · subst h2; exact Nat.lt_succ_self _
  · intro r hr
    have hr' : r ∈ mem.live.push (id, row) := by rw [← hlv]; exact hr
    show r.1.value.toNat < (mem.reserveAllocId.1.nextAllocId).toNat
    rw [hnext, hadd]
    rcases Array.mem_push.mp hr' with h1 | h2
    · exact Nat.lt_succ_of_lt (hw.live r h1)
    · subst h2; exact Nat.lt_succ_self _
  · intro g hg
    show g.allocId.value.toNat < (mem.reserveAllocId.1.nextAllocId).toNat
    rw [hnext, hadd]
    exact Nat.lt_succ_of_lt (hw.globals g (by rw [← hgl]; exact hg))
  · intro d hd
    show d.allocId.value.toNat < (mem.reserveAllocId.1.nextAllocId).toNat
    rw [hnext, hadd]
    exact Nat.lt_succ_of_lt (hw.dead d (by rw [← hdd]; exact hd))
  · show (mem.reserveAllocId.1.live.push (id, row)).find? (fun e => e.1 == id) = some (id, row)
    rw [hlv, ← Array.find?_toList, Array.toList_push, List.find?_append]
    have hnone : mem.live.toList.find? (fun e => e.1 == id) = none := by
      rw [List.find?_eq_none]
      intro r hr hb
      have hlt := hw.live r (Array.mem_def.mpr hr)
      rw [eq_of_beq hb] at hlt
      exact Nat.lt_irrefl _ hlt
    rw [hnone]
    simp

/-- The frame-pop release fold preserves the high-water invariant and rewrites live rows ONLY in
their borrow-tree `extra` component (kind, bytes, size, alignment and mutability are untouched) —
on clean completion and on mid-sequence failure alike. -/
private theorem stackPopReleaseAll_highWater_rows {K : Type}
    (pt : Miri.TreeBorrows.ProtectedTags)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag)) :
    ∀ (mem mem' : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
      (res : Option Miri.Interpreter.StepError),
      stackPopReleaseAll pt prots mem = some (mem', res) →
      (MemoryStateHighWater mem → MemoryStateHighWater mem') ∧
      ∀ id entry, mem.live.find? (fun e => e.1 == id) = some (id, entry) →
        ∃ t, mem'.live.find? (fun e => e.1 == id) =
          some (id, { entry with allocation := entry.allocation.setExtra t }) := by
  induction prots with
  | nil =>
    intro mem mem' res h
    injection h with hEq; injection hEq with hm _
    subst hm
    exact ⟨id, fun _ entry hf => ⟨entry.allocation.extra, hf⟩⟩
  | cons p rest ih =>
    intro mem mem' res h
    obtain ⟨pid, ptag⟩ := p
    cases hf : mem.live.find? (fun e => e.1 == pid) with
    | none => simp only [stackPopReleaseAll, hf] at h; cases h
    | some pair =>
      simp only [stackPopReleaseAll, hf] at h
      have hpid : pair.1 = pid := eq_of_beq (by simpa using Array.find?_some hf)
      have hstep : ∀ tree,
          (MemoryStateHighWater mem → MemoryStateHighWater (stackPopWriteBack mem pid pair.2 tree)) ∧
          ∀ i entry, mem.live.find? (fun e => e.1 == i) = some (i, entry) →
            ∃ t, (stackPopWriteBack mem pid pair.2 tree).live.find? (fun e => e.1 == i) =
              some (i, { entry with allocation := entry.allocation.setExtra t }) := by
        intro tree
        refine ⟨fun hw => hw.replaceLive pid _ (by
          have hlt := hw.live pair (array_mem_of_find? hf); rwa [hpid] at hlt), fun i entry hfi => ?_⟩
        by_cases hi : i = pid
        · subst hi
          have hpe : pair.2 = entry := by
            rw [hf] at hfi; injection hfi with hfi; rw [hfi]
          refine ⟨tree, ?_⟩
          rw [← hpe]
          exact find?_filter_push_self mem.live i _
        · exact ⟨entry.allocation.extra, (find?_filter_push_ne mem.live pid i _ hi).trans hfi⟩
      cases hE : stackPopReleaseErr (pair.2.allocation.extra.releaseProtector ptag pt).status with
      | none => rw [hE] at h; cases h
      | some r =>
        rw [hE] at h
        cases r with
        | some err =>
          injection h with hEq; injection hEq with hm _
          subst hm
          exact hstep _
        | none =>
          obtain ⟨hw1, hrows1⟩ := hstep (pair.2.allocation.extra.releaseProtector ptag pt).tree
          obtain ⟨hw2, hrows2⟩ := ih _ mem' res h
          refine ⟨fun hw => hw2 (hw1 hw), fun i entry hfi => ?_⟩
          obtain ⟨t1, h1⟩ := hrows1 i entry hfi
          obtain ⟨t2, h2⟩ := hrows2 i _ h1
          exact ⟨t2, h2⟩

/-- A successful keyed `allocate` makes exactly its returned key live and touches no other live or
dead entry. -/
private theorem keyed_allocate_ok_props (kw : KeyedAllocWorld) (e : LiveAllocEntry) (k : MiriAllocId)
    (h : (kw.allocate e).2 = .ok k) :
    (kw.allocate e).1.findLive? k = some e ∧
    (∀ q, q ≠ k → (kw.allocate e).1.findLive? q = kw.findLive? q) ∧
    (∀ q, (kw.allocate e).1.findDead? q = kw.findDead? q) := by
  unfold KeyedAllocWorld.allocate at h ⊢
  cases hres : kw.reserveAllocId with
  | mk kwR outR =>
    rw [hres] at h
    cases outR with
    | error _ => cases h
    | ok kid =>
      dsimp only at h ⊢
      injection h with hk
      subst hk
      have hT : kwR.table = kw.table := by
        unfold KeyedAllocWorld.reserveAllocId at hres
        split at hres <;> first
          | (injection hres with hk _; subst hk; rfl)
          | (split at hres <;> first
              | (injection hres with hk _; subst hk; rfl)
              | (split at hres <;> (injection hres with hk _; subst hk; rfl)))
      refine ⟨ExtTreeMap0.get?_insert_self _ _ _, fun q hq => ?_, fun q => ?_⟩
      · show (kwR.table.live.insert kid e).get? q = kw.table.live.get? q
        rw [ExtTreeMap0.get?_insert_ne _ _ hq, hT]
      · show kwR.table.dead.get? q = kw.table.dead.get? q
        rw [hT]

/-- **Stage 5–6 conclusion** (`clean deallocation → use-after-free → double free → fresh allocation
without ABA`) for a machine state `st4` holding a live stack allocation `(id₁, entry4)`; proved by
`allocationMachine_deallocate_then_allocateStackRaw_noABA`. All facts about `st5` / `st6` are about
the states PRODUCED by the vendored operations:
* `AllocationMachine.deallocate` on `st4` returns `.ok () st5`; `st5.machine.memory` is `st4`'s
  memory with exactly the row of `id₁` filtered out of `live` and its tombstone pushed onto `dead`;
  the keyed world makes the theory's live → dead transition; `id₁` is no longer live, is dead, and
  every nonzero-size access to it is rejected (use-after-free);
* the high-water invariant and the allocation-ID cursor survive deallocation;
* a second `deallocate` of `id₁` on `st5` (under the hook environment at `st5`) fails with
  `useAfterFree` and leaves the keyed world unchanged (double free);
* a fresh `PlaceMachine.allocateStackRaw` on `st5` (under its hook environment) returns a NEW
  `id₂ = ⟨st5.nextAllocId, _⟩` with `id₁.value < id₂.value` (no ABA), in lockstep with
  `KeyedAllocWorld.allocate`; afterwards `id₁` is still dead and not live, and `id₂` is live. -/
def DeallocReallocNoABA {K User Payload : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (allocCfg : Miri.Interpreter.PlaceMachine.AllocationConfig K User)
    (deallocH : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr1 : Miri.Memory.Pointer (Option Miri.Memory.Provenance)) (actor : DeallocActor)
    (st4 : Miri.Interpreter.MachineHooks.State K User) (id₁ : Miri.Memory.AllocId)
    (entry4 : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K) : Prop :=
  ∃ st5 : Miri.Interpreter.MachineHooks.State K User,
    Miri.Interpreter.AllocationMachine.deallocate deallocH ptr1 none .stack st4 = .ok () st5 ∧
    st5.machine.memory = { st4.machine.memory with
      live := st4.machine.memory.live.filter fun e => e.1 != id₁
      dead := (st4.machine.memory.dead.filter fun d => d.allocId != id₁).push
        ⟨id₁, entry4.allocation.byteSize, entry4.allocation.align⟩ } ∧
    machineToKeyed proj raceEntryOf st5.machine =
      (((machineToKeyed proj raceEntryOf st4.machine).removeLive (ofMiriAllocId id₁)).1.insertDead
        (ofMiriAllocId id₁)
        ⟨entry4.allocation.byteSize.bytes, UInt8.ofNat entry4.allocation.align.pow2⟩).removeRace
          (ofMiriAllocId id₁) ∧
    (machineToKeyed proj raceEntryOf st5.machine).findLive? (ofMiriAllocId id₁) = none ∧
    (machineToKeyed proj raceEntryOf st5.machine).findDead? (ofMiriAllocId id₁) =
      some ⟨entry4.allocation.byteSize.bytes, UInt8.ofNat entry4.allocation.align.pow2⟩ ∧
    (machineToKeyed proj raceEntryOf st5.machine).isAllocLive (ofMiriAllocId id₁) = false ∧
    (∀ (off : UInt64) (n : Nat), n ≠ 0 →
      (machineToKeyed proj raceEntryOf st5.machine).checkPtrAccess (some (ofMiriAllocId id₁, off)) n = false) ∧
    MemoryStateHighWater st5.machine.memory ∧
    st5.machine.memory.nextAllocId = st4.machine.memory.nextAllocId ∧
    st5.machine.memory.nextAllocId ≠ 0 ∧
    (∀ (tb5 : DeallocHookSpec),
      DeallocLockstepEnv proj raceEntryOf deallocH ptr1 none .stack st5
        (.provenanced (ofMiriAllocId id₁) 0) actor tb5 →
      ∃ err5 st5',
        Miri.Interpreter.AllocationMachine.deallocate deallocH ptr1 none .stack st5 = .error err5 st5' ∧
        DeallocMachineOutcomeRel deallocH (.error err5) (.error (.useAfterFree (ofMiriAllocId id₁))) ∧
        machineToKeyed proj raceEntryOf st5'.machine = machineToKeyed proj raceEntryOf st5.machine) ∧
    (∀ (size2 : Miri.ABI.Size) (align2 : Miri.ABI.Align)
       (alloc2 : Miri.Memory.Allocation Miri.Memory.Provenance Unit)
       (hnz5 : st5.machine.memory.nextAllocId ≠ 0) (userAfter2 : User)
       (rootTag2 : Miri.Memory.BorTag)
       (trackerAfter2 : Option Miri.Interpreter.MachineHooks.BorrowState)
       (rootPtr2 : Miri.Memory.Pointer Miri.Memory.Provenance),
      allocCfg.nativeStorage = none →
      Miri.Memory.Allocation.tryNew (Prov := Miri.Memory.Provenance) size2 align2 .Uninit
        allocCfg.zeroedStorage = .ok alloc2 →
      ¬ alloc2.byteSize.bytes > allocCfg.maximumObjectSize.bytes →
      st5.machine.dataRace = none →
      (∀ id m, allocCfg.diagnostic id size2 align2 m = .ok () m) →
      (∀ m, m.user = st5.machine.user →
        allocCfg.allocationTail ⟨st5.machine.memory.nextAllocId, hnz5⟩ size2 align2 m =
          .ok () { m with user := userAfter2 }) →
      (match st5.machine.borrowTracker with
        | none => rootTag2 = Miri.Memory.BorTag.one ∧ trackerAfter2 = none
        | some tr =>
          ∃ g', tr.global.rootPointerTag ⟨st5.machine.memory.nextAllocId, hnz5⟩ = .ok (g', rootTag2) ∧
            g'.rootTag? ⟨st5.machine.memory.nextAllocId, hnz5⟩ = some rootTag2 ∧
            trackerAfter2 = some { tr with global := g' }) →
      (∀ s, allocCfg.adjustRootAddress ⟨st5.machine.memory.nextAllocId, hnz5⟩ rootTag2 s = .ok rootPtr2 s) →
      let id₂ : Miri.Memory.AllocId := ⟨st5.machine.memory.nextAllocId, hnz5⟩
      let row2 : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
        ⟨.stack, alloc2.withExtra (Miri.TreeBorrows.BorrowTree.new rootTag2 size2)⟩
      ∃ st6 : Miri.Interpreter.MachineHooks.State K User,
        id₁.value.toNat < id₂.value.toNat ∧
        id₂ ≠ id₁ ∧
        Miri.Interpreter.PlaceMachine.allocateStackRaw allocCfg size2 align2 st5 =
          .ok rootPtr2.withOptionalProvenance st6 ∧
        machineToKeyed proj raceEntryOf st6.machine =
          ((machineToKeyed proj raceEntryOf st5.machine).allocate (liveEntryOfMiri proj row2)).1 ∧
        ((machineToKeyed proj raceEntryOf st5.machine).allocate (liveEntryOfMiri proj row2)).2 =
          .ok (ofMiriAllocId id₂) ∧
        (machineToKeyed proj raceEntryOf st6.machine).findDead? (ofMiriAllocId id₁) =
          some ⟨entry4.allocation.byteSize.bytes, UInt8.ofNat entry4.allocation.align.pow2⟩ ∧
        (machineToKeyed proj raceEntryOf st6.machine).findLive? (ofMiriAllocId id₁) = none ∧
        (machineToKeyed proj raceEntryOf st6.machine).findLive? (ofMiriAllocId id₂) =
          some (liveEntryOfMiri proj row2))

/-- **Clean deallocation, use-after-free, double free, and fresh re-allocation without ABA — every
step DERIVED from the vendored operations** (`lean-miri#73`): for a machine state `st4` satisfying
the high-water invariant and holding a live, mutable stack allocation `(id₁, entry4)` that is
neither tombstoned nor a global, under the deallocation hook environment `env4` with a passing
race/Tree-Borrows hook, `DeallocReallocNoABA` holds: the deallocation result, the exact post-state
memory, the keyed live → dead transition, use-after-free rejection, double-free rejection, and the
fresh allocation's strictly larger ID are all consequences of `allocationMachine_deallocate_…`
lockstep and `placeMachine_allocateStackRaw_eq_keyed` — no post-state fact (in particular
`nextAllocId` preservation across deallocation) is assumed. Residual hypotheses are only the hook
environments at `st5` (second `deallocate`, fresh `allocateStackRaw`) inside the definition. -/
theorem allocationMachine_deallocate_then_allocateStackRaw_noABA
    {K User Payload : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (allocCfg : Miri.Interpreter.PlaceMachine.AllocationConfig K User)
    (deallocH : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (ptr1 : Miri.Memory.Pointer (Option Miri.Memory.Provenance)) (actor : DeallocActor)
    (st4 : Miri.Interpreter.MachineHooks.State K User) (id₁ : Miri.Memory.AllocId)
    (entry4 : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hw4 : MemoryStateHighWater st4.machine.memory)
    (hfind4 : st4.machine.memory.live.find? (fun e => e.1 == id₁) = some (id₁, entry4))
    (hmut4 : entry4.allocation.mutability = .Mut)
    (hkind4 : entry4.kind = .stack)
    (hnotDead4 : ∀ d ∈ st4.machine.memory.dead.toList, d.allocId ≠ id₁)
    (hnotGlob4 : ∀ g ∈ st4.machine.memory.globals.toList, g.allocId ≠ id₁)
    (env4 : DeallocLockstepEnv proj raceEntryOf deallocH ptr1 none .stack st4
      (.provenanced (ofMiriAllocId id₁) 0) actor .ok)
    (hhook4 : machineDeallocHook (raceModeOfMachine st4.machine) actor .ok
      ((machineToKeyed proj raceEntryOf st4.machine).findRace? (ofMiriAllocId id₁))
      entry4.allocation.byteSize.bytes = .ok ()) :
    DeallocReallocNoABA proj raceEntryOf allocCfg deallocH ptr1 actor st4 id₁ entry4 := by
  obtain ⟨st5, hrun5, hkw5, hkl4⟩ :=
    allocationMachine_deallocate_clean_ok env4 entry4 hfind4 hmut4 hkind4 hhook4 hnotDead4
  obtain ⟨id', off', pe', entry', hout', _, hfind', hmem5, _⟩ :=
    allocationMachine_deallocate_ok_memory_eq env4 st5 hrun5
  have hresOut := env4.resOut
  rw [hout'] at hresOut
  dsimp only at hresOut
  have hid : id' = id₁ := ofMiriAllocId_injective hresOut.1
  subst hid
  have hentry : entry' = entry4 := by
    rw [hfind4] at hfind'; injection hfind' with h1; injection h1 with _ h2; exact h2.symm
  subst hentry
  have hglobK : (machineToKeyed proj raceEntryOf st4.machine).findGlobal? (ofMiriAllocId id') = none := by
    have hkw : (machineToKeyed proj raceEntryOf st4.machine).findGlobal? (ofMiriAllocId id') =
        ((memoryStateToRows st4.machine.memory).toKeyed proj).findGlobal? (ofMiriAllocId id') := rfl
    rw [hkw, toKeyed_findGlobal?]
    have hnone : (memoryStateToRows st4.machine.memory).globals.toList.find?
        (fun g => g.allocId == id') = none := by
      rw [List.find?_eq_none]
      intro g hg hb
      exact hnotGlob4 g hg (eq_of_beq hb)
    rw [hnone]; rfl
  have hprops := keyed_clean_dealloc_world_props (machineToKeyed proj raceEntryOf st4.machine)
    (ofMiriAllocId id') (liveEntryOfMiri proj entry') hkl4
  dsimp only at hprops
  obtain ⟨_, _, _, hpGlob, hpLive, _, hpDead, _, _, hpUaf⟩ := hprops
  have hidLt : id'.value.toNat < st4.machine.memory.nextAllocId.toNat :=
    hw4.live _ (array_mem_of_find? hfind4)
  have hw5 : MemoryStateHighWater st5.machine.memory := by
    rw [hmem5]; exact hw4.tombstone id' _ _ hidLt
  have hnext5 : st5.machine.memory.nextAllocId = st4.machine.memory.nextAllocId := by rw [hmem5]
  have hnz5 : st5.machine.memory.nextAllocId ≠ 0 := by
    intro h0
    rw [hnext5] at h0
    rw [h0] at hidLt
    exact Nat.not_lt_zero _ hidLt
  refine ⟨st5, hrun5, hmem5, hkw5, ?_, ?_, ?_, ?_, hw5, hnext5, hnz5, ?_, ?_⟩
  · rw [hkw5]; exact hpLive
  · rw [hkw5]; exact hpDead
  · rw [hkw5]; exact (hpUaf hglobK).1
  · intro off n hn; rw [hkw5]; exact (hpUaf hglobK).2 off n hn
  · intro tb5 env5
    exact allocationMachine_deallocate_useAfterFree env5 (by rw [hkw5]; exact hpLive)
      (by rw [hkw5]; exact (hpGlob _).trans hglobK)
  · intro size2 align2 alloc2 hnz5' userAfter2 rootTag2 trackerAfter2 rootPtr2
      hnat htry2 hfit2 hnoRace5 hdiag2 htail2 hbt2 hadj2 id₂ row2
    obtain ⟨heval6, hkw6u, hkres6u, _⟩ :=
      placeMachine_allocateStackRaw_eq_keyed proj raceEntryOf allocCfg size2 align2 st5 alloc2
        hnat htry2 hfit2 hw5.noSource hw5.avail hnz5' hw5.issued hw5.live hw5.globals hw5.dead hnoRace5
        hdiag2 userAfter2 htail2 rootTag2 trackerAfter2 hbt2 rootPtr2 hadj2
    have hkw6 : machineToKeyed proj raceEntryOf _ =
        ((machineToKeyed proj raceEntryOf st5.machine).allocate (liveEntryOfMiri proj row2)).1 := hkw6u
    have hkres6 : ((machineToKeyed proj raceEntryOf st5.machine).allocate (liveEntryOfMiri proj row2)).2 =
        .ok (ofMiriAllocId id₂) := hkres6u
    have hlt : id'.value.toNat < id₂.value.toNat := by
      show _ < st5.machine.memory.nextAllocId.toNat
      rw [hnext5]; exact hidLt
    have hne : id₂ ≠ id' := fun heq => by rw [heq] at hlt; exact Nat.lt_irrefl _ hlt
    have hkne : ofMiriAllocId id' ≠ ofMiriAllocId id₂ := fun heq =>
      hne (ofMiriAllocId_injective heq).symm
    obtain ⟨hal1, hal2, hal3⟩ := keyed_allocate_ok_props _ _ _ hkres6
    refine ⟨_, hlt, hne, heval6, hkw6, hkres6, ?_, ?_, ?_⟩
    · rw [hkw6, hal3, hkw5]; exact hpDead
    · rw [hkw6, hal2 _ hkne, hkw5]; exact hpLive
    · rw [hkw6]; exact hal1

/-- `machineToKeyed` is invariant under ANY permutation of the `live` / `dead` row arrays with
distinct keys (machine-level packaging of `memoryState_toKeyed_eq_of_perm`). -/
private theorem machineToKeyed_liveDead_perm {K User : Type}
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (m : Miri.Interpreter.MachineHooks.MachineState K User)
    (livePerm : Array (Miri.Memory.AllocId ×
      Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K))
    (deadPerm : Array Miri.Memory.DeadAllocation)
    (hpl : m.memory.live.toList.Perm livePerm.toList)
    (hpd : m.memory.dead.toList.Perm deadPerm.toList)
    (hndG : (m.memory.globals.toList.map fun g => g.allocId).Nodup)
    (hndL : (m.memory.live.toList.map fun r => r.1).Nodup)
    (hndD : (m.memory.dead.toList.map fun d => d.allocId).Nodup)
    (hndR : (m.raceAllocations.toList.map fun p => ofMiriAllocId p.1).Nodup) :
    memoryStateToKeyed proj { m.memory with live := livePerm, dead := deadPerm }
      (m.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2)) =
      machineToKeyed proj raceEntryOf m := by
  symm
  unfold machineToKeyed
  apply memoryState_toKeyed_eq_of_perm proj
  · rfl
  · rfl
  · exact List.Perm.refl _
  · exact List.Perm.refl _
  · exact hndG
  · exact hpl
  · exact hndL
  · exact hpd
  · exact hndD
  · exact List.Perm.refl _
  · simpa [List.map_map, Function.comp_def] using hndR

/-- **End-to-end composed allocation lifecycle on vendored machine states — every stage's MEMORY is
produced from the previous one by a real vendored operation** (`lean-miri#73` × `lean-miri#74`). Starting from a state
`st0` with the high-water invariant (`MemoryStateHighWater`):
1. **Stage 1 (`PlaceMachine.allocateStackRaw`)** allocates `id₁ = ⟨st0.nextAllocId, _⟩`, producing the
   explicit state `st1`, in lockstep with `KeyedAllocWorld.allocate`.
2. **Stage 2 (store commit)**: for ANY replacement allocation `a2` (e.g. the result of
   `Allocation.writeScalar`), `MemoryState.setLiveAllocation id₁ a2` on `st1`'s memory succeeds with
   the explicit memory `mem2` and is `KeyedAllocWorld.insertLive` on the keyed projection.
3. **Stage 3a (retag commit)**: for ANY borrow tree `tree3`, `setLiveAllocation id₁ (a2.setExtra tree3)`
   on `mem2` succeeds with the explicit memory `mem3`, and — the projection ignoring `extra` — the
   keyed world is EXACTLY unchanged.
   (Stages 2–3a are stated at the level of the write-back primitive that `Allocation.writeScalar`
   stores and `RetagPipeline.retagPointerValue` commit through; the drivers themselves are exercised
   by the closed canary `multiStep_lifecycle_noABA_and_detached_canary`, not by this theorem.)
   For every machine state `st3` carrying `mem3` whose current frame protects `(id₁, protTag)` and
   whose protected trees are `BorrowTreeWorldRel`-related to theory worlds `worlds3` on which the
   theory's frame exit succeeds (`multiAllocEndAccessesPartial … = (worlds4, none)`):
4. **Stage 3b (protected `AllocationMachine.deallocate`)**: under the hook environment with verdict
   `.protectedDealloc`, deallocation FAILS, the failure state's keyed world is the theory's
   `deallocateMachine … .protectedDealloc` world, and `id₁` — live before — is detached.
5. **Stage 4 (`MachineHooks.beforeStackPopWithEnsure`)** SUCCEEDS with the explicit state `st4`
   (memory `mem4`, `endCall` applied); the keyed world is exactly unchanged; `id₁`'s row differs from
   `st3`'s only in its borrow tree; the high-water invariant and the cursor
   (`nextAllocId = st0.nextAllocId + 1`) are preserved; the released trees are related to `worlds4`.
6. **Stages 5–6** (`DeallocReallocNoABA`, for mutable `a2`, under the hook environment at `st4` with
   verdict `.ok` and a passing race hook): clean deallocation of `id₁` succeeds with exact memory and
   keyed effect, `id₁` is tombstoned and every nonzero-size access to it is rejected (use-after-free),
   a second deallocation is rejected as `useAfterFree` (double free), and a fresh
   `allocateStackRaw` returns `id₂` with `id₁.value < id₂.value` (no ABA) while `id₁` stays dead.
No lockstep equation and no post-state fact is assumed: `st1`, `mem2`, `mem3`, `st4`, and the
deallocation / re-allocation states inside `DeallocReallocNoABA` are outputs of the vendored
operations, and each stage's facts are derived from the operation that produced its state. The one
interface that is a HYPOTHESIS rather than a derivation is the retag driver's non-memory effect:
`st3` is any state whose MEMORY is the Stage-3a memory `mem3`; its borrow tracker, protector frame
and remaining machine components are constrained only by the Stage 3b–4 hypotheses (the tracker /
frame updates of `RetagPipeline.retagPointerValue` are not derived here). The other hypotheses are
hook environments (`DeallocLockstepEnv`, the allocation hooks) and the theory-side frame-exit
success `multiAllocEndAccessesPartial … = (worlds4, none)`. -/
theorem multiStep_alloc_storeLoad_retag_frameExit_dealloc_realloc_lifecycle
    {K User Payload : Type} [DecidableEq K]
    (proj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (hproj : proj.ExtraInsensitive)
    (raceEntryOf : Miri.Concurrency.VClockAlloc → RaceClockEntry)
    (allocCfg : Miri.Interpreter.PlaceMachine.AllocationConfig K User)
    (deallocH : Miri.Interpreter.AllocationMachine.DeallocationHooks K User Payload)
    (size1 : Miri.ABI.Size) (align1 : Miri.ABI.Align)
    (st0 : Miri.Interpreter.MachineHooks.State K User)
    (alloc1 : Miri.Memory.Allocation Miri.Memory.Provenance Unit)
    (hnatCfg : allocCfg.nativeStorage = none)
    (htry1 : Miri.Memory.Allocation.tryNew (Prov := Miri.Memory.Provenance) size1 align1 .Uninit
      allocCfg.zeroedStorage = .ok alloc1)
    (hfit1 : ¬ alloc1.byteSize.bytes > allocCfg.maximumObjectSize.bytes)
    (hw0 : MemoryStateHighWater st0.machine.memory)
    (hnz0 : st0.machine.memory.nextAllocId ≠ 0)
    (hnoWrap : st0.machine.memory.nextAllocId.toNat + 1 < 2 ^ 64)
    (hnoRace0 : st0.machine.dataRace = none)
    (hdiag1 : ∀ id m, allocCfg.diagnostic id size1 align1 m = .ok () m)
    (userAfter1 : User)
    (htail1 : ∀ m, m.user = st0.machine.user →
      allocCfg.allocationTail ⟨st0.machine.memory.nextAllocId, hnz0⟩ size1 align1 m =
        .ok () { m with user := userAfter1 })
    (rootTag1 : Miri.Memory.BorTag)
    (trackerAfter1 : Option Miri.Interpreter.MachineHooks.BorrowState)
    (hbt1 : match st0.machine.borrowTracker with
      | none => rootTag1 = Miri.Memory.BorTag.one ∧ trackerAfter1 = none
      | some tr =>
        ∃ g', tr.global.rootPointerTag ⟨st0.machine.memory.nextAllocId, hnz0⟩ = .ok (g', rootTag1) ∧
          g'.rootTag? ⟨st0.machine.memory.nextAllocId, hnz0⟩ = some rootTag1 ∧
          trackerAfter1 = some { tr with global := g' })
    (rootPtr1 : Miri.Memory.Pointer Miri.Memory.Provenance)
    (hadj1 : ∀ s, allocCfg.adjustRootAddress ⟨st0.machine.memory.nextAllocId, hnz0⟩ rootTag1 s =
      .ok rootPtr1 s) :
    let id₁ : Miri.Memory.AllocId := ⟨st0.machine.memory.nextAllocId, hnz0⟩
    let row1 : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
      ⟨.stack, alloc1.withExtra (Miri.TreeBorrows.BorrowTree.new rootTag1 size1)⟩
    let mem1 : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
      { st0.machine.memory.reserveAllocId.1 with
        live := st0.machine.memory.reserveAllocId.1.live.push (id₁, row1) }
    let st1 : Miri.Interpreter.MachineHooks.State K User :=
      { st0 with machine := { st0.machine with
          memory := mem1, borrowTracker := trackerAfter1, user := userAfter1 } }
    -- Stage 1:
    Miri.Interpreter.PlaceMachine.allocateStackRaw allocCfg size1 align1 st0 =
      .ok rootPtr1.withOptionalProvenance st1 ∧
    machineToKeyed proj raceEntryOf st1.machine =
      ((machineToKeyed proj raceEntryOf st0.machine).allocate (liveEntryOfMiri proj row1)).1 ∧
    ((machineToKeyed proj raceEntryOf st0.machine).allocate (liveEntryOfMiri proj row1)).2 =
      .ok (ofMiriAllocId id₁) ∧
    -- Stages 2–3a:
    ∀ (a2 : Miri.Memory.Allocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree)
      (tree3 : Miri.TreeBorrows.BorrowTree),
      let mem2 : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
        { mem1 with live := (mem1.live.filter fun r => r.1 != id₁).push (id₁, ⟨.stack, a2⟩) }
      let mem3 : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K :=
        { mem2 with
          live := (mem2.live.filter fun r => r.1 != id₁).push (id₁, ⟨.stack, a2.setExtra tree3⟩) }
      mem1.setLiveAllocation id₁ a2 = .ok mem2 ∧
      mem2.setLiveAllocation id₁ (a2.setExtra tree3) = .ok mem3 ∧
      (∀ race, memoryStateToKeyed proj mem2 race =
        (memoryStateToKeyed proj mem1 race).insertLive (ofMiriAllocId id₁)
          (liveEntryOfMiri proj ⟨.stack, a2⟩)) ∧
      (∀ race, memoryStateToKeyed proj mem3 race = memoryStateToKeyed proj mem2 race) ∧
      -- Stages 3b–6:
      ∀ (st3 : Miri.Interpreter.MachineHooks.State K User)
        (tracker3 : Miri.Interpreter.MachineHooks.BorrowState)
        (frame3 : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
          Miri.Interpreter.MachineHooks.FrameExtra)
        (protTag : Miri.Memory.BorTag) (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
        (tagOf : Miri.Memory.BorTag → Nat)
        (worlds3 worlds4 : Miri.Memory.AllocId → Option FnEntryBorrowWorld)
        (ptr1 : Miri.Memory.Pointer (Option Miri.Memory.Provenance)) (actor : DeallocActor),
        st3.machine.memory = mem3 →
        st3.machine.borrowTracker = some tracker3 →
        st3.stack.currentFrame? = some frame3 →
        frame3.extra.borrowTracker = some ⟨#[(id₁, protTag)]⟩ →
        frameTag id₁ protTag →
        (∀ id w, worlds3 id = some w →
          ∃ entry, st3.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
            BorrowTreeWorldRel tracker3.global.protectedTags (frameTag id) tagOf
              entry.allocation.extra w) →
        (worlds3 id₁).isSome = true →
        multiAllocEndAccessesPartial tagOf [(id₁, protTag)] worlds3 = (worlds4, none) →
        -- Stage 3b:
        (DeallocLockstepEnv proj raceEntryOf deallocH ptr1 none .stack st3
            (.provenanced (ofMiriAllocId id₁) 0) actor .protectedDealloc →
          ∃ err3 dres3,
            Miri.Interpreter.AllocationMachine.deallocate deallocH ptr1 none .stack st3 =
              .error err3 dres3 ∧
            machineToKeyed proj raceEntryOf dres3.machine =
              ((machineToKeyed proj raceEntryOf st3.machine).deallocateMachine
                (.provenanced (ofMiriAllocId id₁) 0) none .stack (raceModeOfMachine st3.machine)
                actor .protectedDealloc).world ∧
            (machineToKeyed proj raceEntryOf st3.machine).findLive? (ofMiriAllocId id₁) =
              some (liveEntryOfMiri proj ⟨.stack, a2.setExtra tree3⟩) ∧
            (machineToKeyed proj raceEntryOf dres3.machine).findLive? (ofMiriAllocId id₁) = none) ∧
        -- Stage 4:
        ∃ (mem4 : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
          (t4 : Miri.TreeBorrows.BorrowTree),
          let st4 : Miri.Interpreter.MachineHooks.State K User :=
            { st3 with machine := { st3.machine with
                memory := mem4
                borrowTracker := some { tracker3 with
                  global := tracker3.global.endCall ⟨#[(id₁, protTag)]⟩ } } }
          Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st3 = .ok () st4 ∧
          machineToKeyed proj raceEntryOf st4.machine = machineToKeyed proj raceEntryOf st3.machine ∧
          mem4.live.find? (fun e => e.1 == id₁) = some (id₁, ⟨.stack, a2.setExtra t4⟩) ∧
          MemoryStateHighWater mem4 ∧
          mem4.nextAllocId = st0.machine.memory.nextAllocId + 1 ∧
          (∀ id w', worlds4 id = some w' →
            ∃ entry', mem4.live.find? (fun e => e.1 == id) = some (id, entry') ∧
              BorrowTreeWorldRel tracker3.global.protectedTags (frameTag id) tagOf
                entry'.allocation.extra w') ∧
          -- Stages 5–6:
          (a2.mutability = .Mut →
            DeallocLockstepEnv proj raceEntryOf deallocH ptr1 none .stack st4
              (.provenanced (ofMiriAllocId id₁) 0) actor .ok →
            machineDeallocHook (raceModeOfMachine st4.machine) actor .ok
              ((machineToKeyed proj raceEntryOf st4.machine).findRace? (ofMiriAllocId id₁))
              a2.byteSize.bytes = .ok () →
            DeallocReallocNoABA proj raceEntryOf allocCfg deallocH ptr1 actor st4 id₁
              ⟨.stack, a2.setExtra t4⟩) := by
  intro id₁ row1 mem1 st1
  obtain ⟨heval1, hkw1, hkres1, _⟩ :=
    placeMachine_allocateStackRaw_eq_keyed proj raceEntryOf allocCfg size1 align1 st0 alloc1
      hnatCfg htry1 hfit1 hw0.noSource hw0.avail hnz0 hw0.issued hw0.live hw0.globals hw0.dead hnoRace0
      hdiag1 userAfter1 htail1 rootTag1 trackerAfter1 hbt1 rootPtr1 hadj1
  obtain ⟨hw1, hnext1, hadd1, hglob1, hdead1, hfind1⟩ := hw0.reservePush hnz0 hnoWrap row1
  refine ⟨heval1, hkw1, hkres1, ?_⟩
  intro a2 tree3 mem2 mem3
  have hid1Lt : id₁.value.toNat < mem1.nextAllocId.toNat := by
    rw [hnext1, hadd1]; exact Nat.lt_succ_self _
  obtain ⟨hset2, _, _, _, _, _, _, hfind2, _, _, _⟩ :=
    memoryState_setLiveAllocation_eq_keyed proj mem1 id₁ row1 a2 [] hfind1
  obtain ⟨hset3, _, _, _, _, _, _, hfind3, _, _, _⟩ :=
    memoryState_setLiveAllocation_eq_keyed proj mem2 id₁ ⟨.stack, a2⟩ (a2.setExtra tree3) [] hfind2
  have hw3 : MemoryStateHighWater mem3 :=
    (hw1.replaceLive id₁ ⟨.stack, a2⟩ hid1Lt).replaceLive id₁ ⟨.stack, a2.setExtra tree3⟩ hid1Lt
  refine ⟨hset2, hset3,
    fun race => (memoryState_setLiveAllocation_eq_keyed proj mem1 id₁ row1 a2 race hfind1).2.2.2.2.2.2.2.2.2.1,
    fun race => (memoryState_setLiveAllocation_eq_keyed proj mem2 id₁ ⟨.stack, a2⟩ (a2.setExtra tree3)
      race hfind2).2.2.2.2.2.2.2.2.2.2 (liveEntryOfMiri_setExtra proj hproj ⟨.stack, a2⟩ tree3), ?_⟩
  intro st3 tracker3 frame3 protTag frameTag tagOf worlds3 worlds4 ptr1 actor
    hmem3 htr3 hfr3 hbf3 hft3 hsync3 hdom3 hpart3
  have hfind3' : st3.machine.memory.live.find? (fun e => e.1 == id₁) =
      some (id₁, ⟨.stack, a2.setExtra tree3⟩) := by rw [hmem3]; exact hfind3
  refine ⟨fun env3 => ?_, ?_⟩
  · obtain ⟨err3, dres3, hrun3, hkw3, _, hdet3⟩ := allocationMachine_deallocate_protected_fails_detached env3
    refine ⟨err3, dres3, hrun3, hkw3, ?_, hdet3 _ rfl⟩
    show (memoryStateToKeyed proj st3.machine.memory _).findLive? (ofMiriAllocId id₁) = _
    rw [memoryStateToKeyed_findLive?_of_find, hfind3']; rfl
  · obtain ⟨mem4, res, hall, hmatch⟩ :=
      stackPopReleaseAll_multiAlloc_partial_simulates (K := K) tracker3.global.protectedTags frameTag
        tagOf (fun id => BorrowTreeWorldRel tracker3.global.protectedTags (frameTag id) tagOf)
        (fun id => realAccessReleaseSim tracker3.global.protectedTags (frameTag id) tagOf)
        [(id₁, protTag)]
        (fun p hp => by
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rw [hp]; exact hft3)
        st3.machine.memory worlds3 hsync3
        (fun p hp => by
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rw [hp]; exact hdom3)
    rw [hpart3] at hmatch
    cases res with
    | some err => exact False.elim hmatch
    | none =>
      have hrun4 := miri_beforeStackPopWithEnsure_eq_releaseAll st3 tracker3 frame3 #[(id₁, protTag)]
        htr3 hfr3 hbf3 mem4 none (by simpa using hall)
      obtain ⟨hwStep, hrows⟩ := stackPopReleaseAll_highWater_rows tracker3.global.protectedTags
        [(id₁, protTag)] st3.machine.memory mem4 none hall
      obtain ⟨t4, hfind4⟩ := hrows id₁ _ hfind3'
      obtain ⟨hn4, hg4, hd4, _, _, _, _⟩ := stackPopReleaseAll_frame_preserved
        tracker3.global.protectedTags [(id₁, protTag)] st3.machine.memory mem4 none hall
      have hkw4 := stackPopReleaseAll_preserves_toKeyed proj hproj tracker3.global.protectedTags
        (st3.machine.raceAllocations.toList.map fun p => (ofMiriAllocId p.1, raceEntryOf p.2))
        [(id₁, protTag)] st3.machine.memory mem4 none hall
      have hw4 : MemoryStateHighWater mem4 := hwStep (by rw [hmem3]; exact hw3)
      have hid1Eq : id₁.value.toNat = st0.machine.memory.nextAllocId.toNat := rfl
      refine ⟨mem4, t4, hrun4, hkw4, hfind4, hw4, ?_, hmatch, ?_⟩
      · rw [hn4, hmem3]; exact hnext1
      · intro hmut2 env4 hhook4
        refine allocationMachine_deallocate_then_allocateStackRaw_noABA proj raceEntryOf allocCfg
          deallocH ptr1 actor _ id₁ ⟨.stack, a2.setExtra t4⟩ hw4 hfind4 hmut2 rfl ?_ ?_ env4 hhook4
        · intro d hd heq
          have hd' : d ∈ st0.machine.memory.dead := by
            rw [← hdead1]
            have hd3 : d ∈ st3.machine.memory.dead := by rw [← hd4]; exact Array.mem_def.mpr hd
            rw [hmem3] at hd3; exact hd3
          have hlt := hw0.dead d hd'
          rw [heq, hid1Eq] at hlt
          exact Nat.lt_irrefl _ hlt
        · intro g hg heq
          have hg' : g ∈ st0.machine.memory.globals := by
            rw [← hglob1]
            have hg3 : g ∈ st3.machine.memory.globals := by rw [← hg4]; exact Array.mem_def.mpr hg
            rw [hmem3] at hg3; exact hg3
          have hlt := hw0.globals g hg'
          rw [heq, hid1Eq] at hlt
          exact Nat.lt_irrefl _ hlt

/-! ### 2E.2b Closed deallocation canary (placed here for peak memory)

Kernel checking runs in declaration order. This closed canary exceeded the `lean -M` bound when its
kernel check ran near the end of the module, so it sits directly after the lockstep theorem it
instantiates rather than in Part 3 and is checked while less of the module is resident. -/

private def canaryTs (n : Nat) (h : 2 * n < 4294967296 := by decide) : Miri.Concurrency.VTimestamp :=
  Miri.Concurrency.VTimestamp.ofPacked (2 * n) h

private def canaryActorClock : Miri.Concurrency.VClock :=
  Miri.Concurrency.VClock.nonzero [canaryTs 5, canaryTs 2] (canaryTs 1) (by decide)

private def canaryDeallocActor : DeallocActor :=
  DeallocActor.ofVClock 0 [(0, 5), (1, 2), (2, 1)]

private def canaryRaceEntryOf (vc : Miri.Concurrency.VClockAlloc) : RaceClockEntry :=
  let c := vc.allocRanges.initialCell
  { writerThread := UInt32.ofNat c.write.1.toNat
    writeTimestamp := UInt64.ofNat c.write.2.time
    readerThread := 1
    readTimestamp := UInt64.ofNat (c.read.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time
    extraReaders := [(2, UInt64.ofNat (c.read.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time)] }

private def canaryVcUniform (sz : Nat) (hsz : sz < 2 ^ 64)
    (wIdx : Miri.Concurrency.VectorIdx) (wTs : Miri.Concurrency.VTimestamp)
    (readClk : Miri.Concurrency.VClock) : Miri.Concurrency.VClockAlloc :=
  { allocRanges := {
      length := Miri.Concurrency.ByteSize.ofU64 sz hsz
      initialCell := { write := (wIdx, wTs), writeType := .Write, read := readClk, atomicOps := none }
      overrides := [] } }

private def canaryDeallocProj : RowProjection Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree Unit :=
  ⟨fun _ => .heap, fun _ => [], fun _ => []⟩

private def canaryDeallocHooks :
    Miri.Interpreter.AllocationMachine.DeallocationHooks Unit (Miri.Interpreter.MemoryExtras.Registry Unit) Unit where
  extras :=
    { get := id
      put := fun _ r => r
      onAccess := fun _ _ => pure ()
      weakError := fun _ => .invalidProgram "" }
  resolvePointer := fun mem st ptr _ =>
    match ptr.provenance with
    | some (.concrete id tag) => ⟨mem, st, .ok (id, ptr.offset, .concrete tag)⟩
    | _ => ⟨mem, st, .error ptr.offset.bytes⟩
  diagnostic := fun _ => pure ()
  currentSpan := pure ⟨0⟩
  freeAllocId := fun _ _ _ _ => pure ()
  retainDetached := fun _ m => m
  nativeDrop := none
  error := Miri.Interpreter.AllocationMachine.deallocationError

private theorem canaryClockEntryRel_of_uniform
    (wIdx : Miri.Concurrency.VectorIdx) (wTs : Miri.Concurrency.VTimestamp)
    (readClk : Miri.Concurrency.VClock) (sz : Nat) (hsz : sz < 2 ^ 64)
    (hwIdx : wIdx.toNat < 3) (hwTs : wTs.time < 2 ^ 64)
    (hrLen : readClk.asList.length ≤ 3)
    (hr0 : (readClk.asList.getD 0 Miri.Concurrency.VTimestamp.ZERO).time ≤ 5)
    (hr1 : (readClk.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time < 2 ^ 64)
    (hr2 : (readClk.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time < 2 ^ 64)
    (hself : wIdx.toNat = 0 → wTs.time ≤ 5) :
    ClockEntryRel canaryDeallocActor
      { Miri.Concurrency.ThreadClockSet.default with clock := canaryActorClock }
      (canaryVcUniform sz hsz wIdx wTs readClk).allocRanges.initialCell
      (canaryRaceEntryOf (canaryVcUniform sz hsz wIdx wTs readClk)) := by
  have hact0 : (canaryActorClock.asList.getD 0 Miri.Concurrency.VTimestamp.ZERO).time = 5 := by decide
  have hact1 : (canaryActorClock.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time = 2 := by decide
  have hact2 : (canaryActorClock.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time = 1 := by decide
  have hidx0 : ∀ i : Miri.Concurrency.VectorIdx, i.toNat = 0 → (canaryActorClock.index i).time = 5 := by
    intro i hi; unfold Miri.Concurrency.VClock.index; rw [hi]; with_unfolding_all rfl
  have hidx1 : ∀ i : Miri.Concurrency.VectorIdx, i.toNat = 1 → (canaryActorClock.index i).time = 2 := by
    intro i hi; unfold Miri.Concurrency.VClock.index; rw [hi]; with_unfolding_all rfl
  have hidx2 : ∀ i : Miri.Concurrency.VectorIdx, i.toNat = 2 → (canaryActorClock.index i).time = 1 := by
    intro i hi; unfold Miri.Concurrency.VClock.index; rw [hi]; with_unfolding_all rfl
  have hwtNat : (UInt64.ofNat wTs.time).toNat = wTs.time := by
    rw [UInt64.toNat_ofNat', Nat.mod_eq_of_lt hwTs]
  have hr1Nat : (UInt64.ofNat (readClk.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time).toNat =
      (readClk.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time := by
    rw [UInt64.toNat_ofNat', Nat.mod_eq_of_lt hr1]
  have hr2Nat : (UInt64.ofNat (readClk.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time).toNat =
      (readClk.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time := by
    rw [UInt64.toNat_ofNat', Nat.mod_eq_of_lt hr2]
  refine ⟨rfl, ?_, ?_, ?_, ?_⟩
  · intro hs
    dsimp only [canaryRaceEntryOf, canaryVcUniform, canaryDeallocActor] at hs ⊢
    have h0 : wIdx.toNat = 0 := by
      have := congrArg UInt32.toNat hs
      simp only [UInt32.toNat_ofNat', Nat.mod_eq_of_lt (by omega : wIdx.toNat < 2 ^ 32)] at this
      exact this
    rw [hidx0 wIdx h0]
    exact hself h0
  · intro hne
    dsimp only [canaryRaceEntryOf, canaryVcUniform, canaryDeallocActor] at hne ⊢
    refine ⟨hwtNat.symm, ?_⟩
    match hw : wIdx.toNat with
    | 0 => exact absurd (by rw [hw]; rfl) hne
    | 1 => rw [hidx1 wIdx hw]; rfl
    | 2 => rw [hidx2 wIdx hw]; rfl
    | _ + 3 => omega
  · intro i hnz
    dsimp only [canaryRaceEntryOf, canaryVcUniform, canaryDeallocActor]
    match i with
    | 0 => left; rw [hact0]; exact hr0
    | 1 =>
      right
      refine ⟨1, UInt64.ofNat (readClk.asList.getD 1 Miri.Concurrency.VTimestamp.ZERO).time,
        by simp, by decide, hr1Nat.symm, by rw [hact1]; rfl⟩
    | 2 =>
      right
      refine ⟨2, UInt64.ofNat (readClk.asList.getD 2 Miri.Concurrency.VTimestamp.ZERO).time,
        by simp, by decide, hr2Nat.symm, by rw [hact2]; rfl⟩
    | k + 3 =>
      have hnone : readClk.asList[k + 3]? = none := List.getElem?_eq_none (by omega)
      have h0 : (readClk.asList.getD (k + 3) Miri.Concurrency.VTimestamp.ZERO).time = 0 := by
        simp [List.getD_eq_getElem?_getD, hnone]; rfl
      exact absurd h0 hnz
  · intro rt rts hmem hne
    dsimp only [canaryRaceEntryOf, canaryVcUniform, canaryDeallocActor] at hmem hne ⊢
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hmem
    rcases hmem with h1 | h2
    · injection h1 with hrt hrts; subst hrt; subst hrts
      exact ⟨1, hr1Nat.symm, by rw [hact1]; rfl⟩
    · injection h2 with hrt hrts; subst hrt; subst hrts
      exact ⟨2, hr2Nat.symm, by rw [hact2]; rfl⟩

