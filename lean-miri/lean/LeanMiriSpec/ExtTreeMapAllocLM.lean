        rw [hmod]
        dsimp only
        rw [hinsLoc]
        change (let r := (miri_etm_private% Miri.TreeBorrows.TreeState
            Miri.TreeBorrows.BorrowTree.updateSifaAfterRetag) _ ⟨0⟩ .None
