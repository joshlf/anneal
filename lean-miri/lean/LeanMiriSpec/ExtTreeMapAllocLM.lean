  have hdrv := (validatePlace_recursive_oneTracked_eq h c (fuel + 1) outerPlace st name
    ⟨outerTarget.mplace, outerTarget.layout⟩ ((⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref)
    hghost htn hroot).1 err st'
