    { data := #[
        some { tag := ⟨1, by decide⟩, parent := none, children := #[⟨1⟩],
               defaultInitialPermission := .Unique, defaultInitialSifa := .None, isExposed := false },
        some { tag := ⟨2, by decide⟩, parent := some ⟨0⟩, children := #[],
