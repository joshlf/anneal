  · rw [← isUnicodeScalarValue_eq_scalarInt_toChar_isOk]; rfl
  · rw [← isUnicodeScalarValue_eq_scalarInt_toChar_isOk]; rfl
  · rw [← isUnicodeScalarValue_eq_scalarInt_toChar_isOk]; rfl

