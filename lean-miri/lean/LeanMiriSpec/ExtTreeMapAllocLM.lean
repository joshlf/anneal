    let tree3Rc : Miri.TreeBorrows.BorrowTree :=
      { tree3R1 with locations := ⟨#[⟨⟨0, UInt64.ofNat len⟩, loc3Rc⟩]⟩ }
    let w2Conf : FnEntryBorrowWorld :=
