          match Miri.TreeBorrows.UniIndex.ofNat? event.node with
          | none => cacheOutcome := .error (.InvalidIndex event.node)
          | some index =>
            match releaseProtectorSimTree.nodeAt index with
            | none => cacheOutcome := .error (.MissingNode index)
            | some node =>
