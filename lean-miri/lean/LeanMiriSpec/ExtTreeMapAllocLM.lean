    have hnoExp3R : ∀ j < 3, ∃ idx nd, Miri.TreeBorrows.UniIndex.ofNat? j = some idx ∧
        tree3R1.nodeAt idx = some nd ∧ nd.isExposed = false := by
      intro j hj
      rcases j with _ | _ | _ | k
      · exact ⟨⟨0⟩, _, rfl, rfl, rfl⟩
      · exact ⟨⟨1⟩, _, rfl, rfl, rfl⟩
      · exact ⟨⟨2⟩, _, rfl, rfl, rfl⟩
