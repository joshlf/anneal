private theorem fnEntryContrast_rel3 (len : Nat) (hlenPos : 0 < len)
    (sibProtected rustcNoWritable childConflicted : Bool) :
  let pt1 := (if sibProtected then (⟨#[(⟨2, by decide⟩, .StrongProtector)]⟩ : Miri.TreeBorrows.ProtectedTags)
