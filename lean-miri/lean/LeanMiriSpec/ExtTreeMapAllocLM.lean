          obtain ⟨hcomp, hlocAll⟩ := hproc.2.2.2.1 (fun ev hev wne hwne => by
            obtain ⟨y, hok, _⟩ := hallEvOk ev hev wne hwne; exact ⟨y, hok⟩)
          rw [hrelEq.1 hcomp]
          -- Show `nl` matches `w'` at every index `j < w'.nodes.length`.
          have haccFull : ∀ k < acc.tree.locationStates.size,
              ∃ stk, acc.tree.locationStates[k]? = some (some stk) := by
            intro k hk
            rw [hproc.2.1] at hk
            cases hwnk : w.nodes[k]? with
            | none => exfalso; have := List.getElem?_eq_none_iff.mp hwnk; omega
            | some wnk =>
              obtain ⟨stkOld, hlocOld, _, _, _, _⟩ := hnormLocAt k wnk hwnk
              by_cases hexEv : ∃ ev ∈ events, ev.node = k
              · rcases hexEv with ⟨ev, hev, rfl⟩
                obtain ⟨yk, hok, _⟩ := hallEvOk ev hev wnk hwnk
                exact ⟨_, (hlocAll ev.node wnk hwnk).1 ev hev rfl stkOld yk hlocOld hok⟩
              · have hnoK : ∀ ev ∈ events, ev.node ≠ k := fun ev hev hEq => hexEv ⟨ev, hev, hEq⟩
                exact ⟨stkOld, by rw [(hlocAll k wnk hwnk).2 hnoK, hlocOld]⟩
          have hnlAt := performNormalAccessAt_writeback_loop acc.tree.locationStates
            (by rw [hproc.2.1]; exact hR.len_bound) haccFull loc
          -- Transport structural facts from `w` to `w'` via `NodeMetaRel`.
          obtain ⟨_, hdense', hancSame, hchildSame, hwf'⟩ :=
            realAccessReleaseSim_transport_wf w w' hR.hdense hR.hwf hmetaRel hmetaAt
          have hactProtEq : w'.activeProtectors = w.activeProtectors := by rw [hw'Eq]
          -- Helper: if node `j` was NOT in `events`, NO descendant `k` of `j` was in `events`
          -- and every node in `j`'s subtree is unchanged (`w'.nodes[k]? = w.nodes[k]?`).
          have hnoEvSubtree : ∀ (j : Nat) (wnj : TreeTagNode), w.nodes[j]? = some wnj →
              (∀ ev ∈ events, ev.node ≠ j) →
              ∀ (k : Nat) (wnk : TreeTagNode), w.nodes[k]? = some wnk →
                j ∈ ancestorPathTags w.nodes k →
                (∀ ev ∈ events, ev.node ≠ k) ∧ w'.nodes[k]? = some wnk := by
            intro j wnj hwnj hnoJ k wnk hwnk hjInK
            have hjMem : wnj ∈ w.nodes := List.mem_of_getElem? hwnj
            have hjTag : wnj.tag = j := hR.hdense j wnj hwnj
            have hkMem : wnk ∈ w.nodes := List.mem_of_getElem? hwnk
            have hkTag : wnk.tag = k := hR.hdense k wnk hwnk
            have hnoK : ∀ ev ∈ events, ev.node ≠ k := by
              intro ev hev hEq
              cases hrel : ev.relatedness with
              | LocalAccess =>
                have hevEq : ev = ⟨wnk.tag, .LocalAccess⟩ := by
                  cases ev; simp only at hEq hrel hkTag; subst hEq; subst hrel; rw [hkTag]
                have hkInS := (hmemEv.2 wnk hkMem).1.mp (hevEq ▸ hev)
                obtain ⟨_, _, hrs⟩ := hR.hwf.reachesRoot wn hwnMem
                rw [hwnTag] at hrs
                have hjInS := ancestorPathAux_suffix_of_mem hrs (w.nodes.length + 1)
                  (w.nodes.length + 1) (by omega) (by omega) k (hkTag ▸ hkInS) j hjInK
                exact hnoJ ⟨j, .LocalAccess⟩ (hjTag ▸ (hmemEv.2 wnj hjMem).1.mpr (hjTag.symm ▸ hjInS)) rfl
              | ForeignAccess =>
                have hevEq : ev = ⟨wnk.tag, .ForeignAccess⟩ := by
                  cases ev; simp only at hEq hrel hkTag; subst hEq; subst hrel; rw [hkTag]
                obtain ⟨hkNotS, hkNotD, hkUnsk⟩ := (hmemEv.2 wnk hkMem).2.mp (hevEq ▸ hev)
                by_cases hjInS : j ∈ ancestorPathTags w.nodes i
                · exact hnoJ ⟨j, .LocalAccess⟩ (hjTag ▸ (hmemEv.2 wnj hjMem).1.mpr (hjTag.symm ▸ hjInS)) rfl
                · have hjNotD : isStrictDescendantOf w.nodes i wnj = false := by
                    cases hjd : isStrictDescendantOf w.nodes i wnj with
                    | false => rfl
                    | true =>
                      exfalso
                      unfold isStrictDescendantOf at hjd hkNotD
                      have hiInJ : i ∈ (ancestorPathTags w.nodes j).tail := by
                        rw [← hjTag]; simpa [List.contains_eq_mem] using hjd
                      obtain ⟨dk, hdk, hrk⟩ := hR.hwf.reachesRoot wnk hkMem
                      rw [hkTag] at hrk
                      have hiInK : i ∈ ancestorPathTags w.nodes k :=
                        ancestorPathAux_suffix_of_mem hrk (w.nodes.length + 1)
                          (w.nodes.length + 1) (by omega) (by omega) j hjInK i
                          (List.mem_of_mem_tail hiInJ)
                      have hkNeI : k ≠ i := fun h => hkNotS (by
                        rw [hkTag, h]; exact mem_of_head?_eq_some (ancestorPathTags_head w.nodes i))
                      have hiTailK : i ∈ (ancestorPathTags w.nodes k).tail := by
                        have hh := ancestorPathTags_head w.nodes k
                        cases hap : ancestorPathTags w.nodes k with
                        | nil => rw [hap] at hh; cases hh
                        | cons hd tl =>
                          rw [hap] at hh hiInK; injection hh with hhd; subst hd
                          simp only [List.mem_cons] at hiInK
                          rcases hiInK with hEqI | htl
                          · exact absurd hEqI.symm hkNeI
                          · exact htl
                      rw [hkTag] at hkNotD
                      simp [List.contains_eq_mem, hiTailK] at hkNotD
                  have hjUnsk : ∀ a ∈ ancestorPathTags w.nodes j,
                      a ∉ ancestorPathTags w.nodes i → skipped.contains a = false := by
                    intro a haJ haNotS
                    obtain ⟨dk, hdk, hrk⟩ := hR.hwf.reachesRoot wnk hkMem
                    rw [hkTag] at hrk
                    have haInK := ancestorPathAux_suffix_of_mem hrk (w.nodes.length + 1)
                      (w.nodes.length + 1) (by omega) (by omega) j hjInK a haJ
                    exact hkUnsk a (hkTag.symm ▸ haInK) haNotS
                  have hjEv : ⟨j, .ForeignAccess⟩ ∈ events :=
                    hjTag ▸ (hmemEv.2 wnj hjMem).2.mpr ⟨hjTag.symm ▸ hjInS, hjNotD,
                      hjTag.symm ▸ hjUnsk⟩
                  exact hnoJ ⟨j, .ForeignAccess⟩ hjEv rfl
            refine ⟨hnoK, ?_⟩
            have hkLt : k < w.nodes.length := list_getElem?_lt hwnk
            cases hwk' : w'.nodes[k]? with
            | none => exfalso; have := List.getElem?_eq_none_iff.mp hwk'; omega
            | some yk =>
              have hstepR := hrelAt k wnk yk hwnk hwk'
              have hkNotS : k ∉ ancestorPathTags w.nodes i := fun hkS =>
                hnoK ⟨k, .LocalAccess⟩ (hkTag ▸ (hmemEv.2 wnk hkMem).1.mpr (hkTag.symm ▸ hkS)) rfl
              have hcontF : (ancestorPathTags w.nodes i).contains wnk.tag = false := by
                simp [List.contains_eq_mem, hkTag, hkNotS]
              rcases hstepR with ⟨hT, _⟩ | ⟨_, _, hEq⟩ | ⟨_, hnotD, hnotP, hokY⟩
              · rw [hcontF] at hT; cases hT
              · rw [hEq]
              · rcases hunvisitedForeign wnk hkMem (hkTag.symm ▸ hkNotS) hnotD
                  (fun hEv => hnoK ⟨wnk.tag, .ForeignAccess⟩ hEv hkTag) with hpr | hokSelf
                · rw [hpr] at hnotP; cases hnotP
                · rw [hokSelf] at hokY; injection hokY with hEq; rw [← hEq]
          -- Construct `BorrowTreeWorldRel pt frameTag tagOf { tree with locations := ⟨#[⟨range, nl⟩]⟩ } w'`.
          refine ⟨range, nl, off, len, {
            hwf := hwf'
            hdense := hdense'
            len_bound := by rw [hlenEq]; exact hR.len_bound
            roots_eq := hR.roots_eq
            locs_eq := rfl
            hlen_pos := hR.hlen_pos
            nodes_size := by rw [hlenEq]; exact hR.nodes_size
            node_sync := ?_
            frame_tags := fun tag' ht' => by
              obtain ⟨k, hkLt, hidx', htag'⟩ := hR.frame_tags tag' ht'
              exact ⟨k, by rw [hlenEq]; exact hkLt, hidx', htag'⟩
          }⟩
          intro j wn' hwn'
          have hjLt : j < w.nodes.length := by
            have : j < w'.nodes.length := list_getElem?_lt hwn'
            omega
          cases hwnj : w.nodes[j]? with
          | none => exfalso; have := List.getElem?_eq_none_iff.mp hwnj; omega
          | some wnj =>
            obtain ⟨ndj, stj, hndj, hexpj, htagj, hidxj, hparj, hchj, hprotj, hoffj, hlenj,
              hlgj, hpmj, hacj, hpossj, hsfj⟩ := hR.node_sync j wnj hwnj
            obtain ⟨stj', hlocj, hlgj', _, _, _⟩ := hnormLocAt j wnj hwnj
            rw [hlgj] at hlgj'; injection hlgj' with hEq; subst hEq
            have hm := hmetaAt j wnj wn' hwnj hwn'
            have hprotj' : wn'.isProtected w'.activeProtectors = wnj.isProtected w.activeProtectors := by
              rw [hactProtEq]; unfold TreeTagNode.isProtected; rw [hm.2.2.1]
            by_cases hexEv : ∃ ev ∈ events, ev.node = j
            · rcases hexEv with ⟨ev, hev, hnodeJ⟩
              subst hnodeJ
              obtain ⟨yj, hokJ, hyjGet⟩ := hallEvOk ev hev wnj hwnj
              rw [hwn'] at hyjGet; injection hyjGet with hEq; subst hEq
              have haccJ := (hlocAll ev.node wnj hwnj).1 ev hev rfl stj wn' hlocj hokJ
              have hnlJ := hnlAt ev.node (by rw [hproc.2.1]; exact hjLt) _ haccJ
              have hpossJ' : wn'.accessed = true ∨ wn'.perm ≠ .unique := by
                have hovJ : rangesOverlap off len wnj.rangeOffset wnj.rangeLen = true := by
                  rw [hoffj, hlenj]; unfold rangesOverlap
                  have hnz : (len != 0) = true := bne_iff_ne.mpr (by omega)
                  have hltA : off < off + len := by omega
                  simp [hnz, hltA]
                have hnotDis : (!ev.relatedness.isForeign) = false → wnj.perm ≠ .disabled := by
                  intro hfor hdis
                  have hrelF : ev.relatedness = .ForeignAccess := by
                    cases hr : ev.relatedness with
                    | LocalAccess => rw [hr] at hfor; cases hfor
                    | ForeignAccess => rfl
                  have hns := hevNotSkip ev hev stj (by unfold Miri.TreeBorrows.Tree.NormalTreeState.stateAt; rw [hlocj])
                  rw [hrelF] at hns
                  have hskT : (stj.skipIfKnownNoop kind .ForeignAccess == .SkipSelfAndChildren) = true := by
                    unfold Miri.TreeBorrows.Tree.LocationState.skipIfKnownNoop
                    simp [Miri.TreeBorrows.AccessRelatedness.isForeign, hpmj, hdis, annealPermToMiri,
                      Miri.TreeBorrows.Permission.isDisabled]
                  rw [hns] at hskT; cases hskT
                have hperf := locationState_performAccess_rel_stepNode w.activeProtectors off len
                  wnj isWrite (!ev.relatedness.isForeign) (wnj.isProtected w.activeProtectors) .None
                  hovJ rfl hpossj hnotDis
                dsimp only at hperf; rw [hokJ] at hperf
                cases hpa : Miri.TreeBorrows.Tree.LocationState.performAccess
                    ⟨annealPermToMiri wnj.perm, wnj.accessed, .None⟩ _ _ _ with
                | Success _ _ => rw [hpa] at hperf; exact hperf.2.1
                | Error _ _ => rw [hpa] at hperf; exact False.elim hperf
                | PermissionInvariantFailure _ => rw [hpa] at hperf; exact False.elim hperf
                | TransitionApplicationInvariantFailure _ => rw [hpa] at hperf; exact False.elim hperf
                | PossibleInvariantFailure _ => rw [hpa] at hperf; exact False.elim hperf
              -- Verify `SifaMatches w' off len ev.node sifa'`.
              have hsifaJ' : SifaMatches w' off len ev.node
                  (Miri.TreeBorrows.IdempotentForeignAccess.recordNew stj.idempotentForeignAccess
                    (Miri.TreeBorrows.IdempotentForeignAccess.fromAccessAndRelatedness
                      kind ev.relatedness)) := by
                cases hrel : ev.relatedness with
                | LocalAccess =>
                  simp [Miri.TreeBorrows.IdempotentForeignAccess.fromAccessAndRelatedness,
                    Miri.TreeBorrows.AccessRelatedness.isForeign,
                    Miri.TreeBorrows.IdempotentForeignAccess.recordNew,
                    Miri.TreeBorrows.IdempotentForeignAccess.isLocal, SifaMatches]
                | ForeignAccess =>
                  have hsound : ∀ isW : Bool, (isW = false ∨ isWrite = true) →
                      SifaSoundFor w' off len isW ev.node :=
                    realAccessReleaseSim_foreign_sifa_sound loc w w' i off len isWrite skipped events
                      wn wnj ev hR.hwf hR.hdense hwf' hdense' hlenEq hactProtEq hancSame hwnMem hwnTag
                      hwnj hev hrel hmemEv.2 hskippedIff
                      (fun k wnk hwnk => by
                        obtain ⟨_, stk, _, _, _, _, _, _, _, _, _, hlgk, _, _, _, hsfk⟩ := hR.node_sync k wnk hwnk
                        exact ⟨stk, hlgk, hsfk⟩)
                      hallEvOk hnoEvSubtree
                  -- Now finish `SifaMatches` based on `stj.idempotentForeignAccess` and `isWrite`.
                  cases isWrite with
                  | false =>
                    cases hstS : stj.idempotentForeignAccess with
                    | None =>
                      simp only [kind, Miri.TreeBorrows.IdempotentForeignAccess.fromAccessAndRelatedness,
                        Miri.TreeBorrows.AccessRelatedness.isForeign,
                        Miri.TreeBorrows.IdempotentForeignAccess.fromForeign,
                        Miri.TreeBorrows.IdempotentForeignAccess.recordNew,
                        Miri.TreeBorrows.IdempotentForeignAccess.isLocal,
                        Miri.TreeBorrows.IdempotentForeignAccess.max,
                        Miri.TreeBorrows.IdempotentForeignAccess.rank, SifaMatches]
                      exact hsound false (Or.inl rfl)
                    | Read =>
                      exfalso
                      have hns := hevNotSkip ev hev stj
                        (by unfold Miri.TreeBorrows.Tree.NormalTreeState.stateAt; rw [hlocj])
                      rw [hrel] at hns
                      simp only [kind, Bool.false_eq_true, ↓reduceIte] at hns
                      have hskT : (stj.skipIfKnownNoop .Read .ForeignAccess == .SkipSelfAndChildren) = true := by
                        unfold Miri.TreeBorrows.Tree.LocationState.skipIfKnownNoop
                        simp [hstS, Miri.TreeBorrows.AccessRelatedness.isForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.fromForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.canSkipForeignAccess,
                          Miri.TreeBorrows.IdempotentForeignAccess.isLocal,
                          Miri.TreeBorrows.IdempotentForeignAccess.le,
                          Miri.TreeBorrows.IdempotentForeignAccess.rank]
                      rw [hns] at hskT; cases hskT
                    | Write =>
                      exfalso
                      have hns := hevNotSkip ev hev stj
                        (by unfold Miri.TreeBorrows.Tree.NormalTreeState.stateAt; rw [hlocj])
                      rw [hrel] at hns
                      simp only [kind, Bool.false_eq_true, ↓reduceIte] at hns
                      have hskT : (stj.skipIfKnownNoop .Read .ForeignAccess == .SkipSelfAndChildren) = true := by
                        unfold Miri.TreeBorrows.Tree.LocationState.skipIfKnownNoop
                        simp [hstS, Miri.TreeBorrows.AccessRelatedness.isForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.fromForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.canSkipForeignAccess,
                          Miri.TreeBorrows.IdempotentForeignAccess.isLocal,
                          Miri.TreeBorrows.IdempotentForeignAccess.le,
                          Miri.TreeBorrows.IdempotentForeignAccess.rank]
                      rw [hns] at hskT; cases hskT
                  | true =>
                    cases hstS : stj.idempotentForeignAccess with
                    | None | Read =>
                      simp only [kind, Miri.TreeBorrows.IdempotentForeignAccess.fromAccessAndRelatedness,
                        Miri.TreeBorrows.AccessRelatedness.isForeign,
                        Miri.TreeBorrows.IdempotentForeignAccess.fromForeign,
                        Miri.TreeBorrows.IdempotentForeignAccess.recordNew,
                        Miri.TreeBorrows.IdempotentForeignAccess.isLocal,
                        Miri.TreeBorrows.IdempotentForeignAccess.max,
                        Miri.TreeBorrows.IdempotentForeignAccess.rank, SifaMatches]
                      exact ⟨hsound false (Or.inr rfl), hsound true (Or.inr rfl)⟩
                    | Write =>
                      exfalso
                      have hns := hevNotSkip ev hev stj
                        (by unfold Miri.TreeBorrows.Tree.NormalTreeState.stateAt; rw [hlocj])
                      rw [hrel] at hns
                      simp only [kind, ↓reduceIte] at hns
                      have hskT : (stj.skipIfKnownNoop .Write .ForeignAccess == .SkipSelfAndChildren) = true := by
                        unfold Miri.TreeBorrows.Tree.LocationState.skipIfKnownNoop
                        simp [hstS, Miri.TreeBorrows.AccessRelatedness.isForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.fromForeign,
                          Miri.TreeBorrows.IdempotentForeignAccess.canSkipForeignAccess,
                          Miri.TreeBorrows.IdempotentForeignAccess.isLocal,
                          Miri.TreeBorrows.IdempotentForeignAccess.le,
                          Miri.TreeBorrows.IdempotentForeignAccess.rank]
                      rw [hns] at hskT; cases hskT
              refine ⟨ndj, _, hndj, hexpj, htagj, hidxj,
                by rw [hm.2.1]; exact hparj,
                by rw [hchildSame]; exact hchj,
                by rw [hprotj']; exact hprotj,
                by rw [hm.2.2.2.1]; exact hoffj,
                by rw [hm.2.2.2.2.1]; exact hlenj,
                hnlJ, rfl, rfl, hpossJ', hsifaJ'⟩
            · -- Node `j` was NOT in `events`: unchanged, and its entire subtree is unchanged!
              have hnoJ : ∀ ev ∈ events, ev.node ≠ j := fun ev hev hEq => hexEv ⟨ev, hev, hEq⟩
              have hsameJ : w'.nodes[j]? = some wnj :=
                (hnoEvSubtree j wnj hwnj hnoJ j wnj hwnj
                  (mem_of_head?_eq_some (ancestorPathTags_head w.nodes j))).2
              rw [hwn'] at hsameJ; injection hsameJ with hEq; subst hEq
              have haccJ : acc.tree.locationStates[j]? = some (some stj) := by
                rw [(hlocAll j wn' hwnj).2 hnoJ, hlocj]
              have hnlJ := hnlAt j (by rw [hproc.2.1]; exact hjLt) stj haccJ
              have hsifaUnch : ∀ isW, SifaSoundFor w off len isW j →
                  SifaSoundFor w' off len isW j := by
                intro isW hsf k' hk' hjInK'
                rw [hancSame] at hjInK'
                have hk'Get : w'.nodes[k'.tag]? = some k' := by
                  rw [← findNode?_eq_getElem?_of_denseTags hdense']
                  exact findNode?_eq_some_of_mem_of_nodup hwf'.tagsNodup hk'
                have hkLt : k'.tag < w.nodes.length := by
                  have : k'.tag < w'.nodes.length := list_getElem?_lt hk'Get
                  omega
                cases hkOld : w.nodes[k'.tag]? with
                | none => exfalso; have := List.getElem?_eq_none_iff.mp hkOld; omega
                | some kOld =>
                  have hkEq : k' = kOld := by
                    have hsub := (hnoEvSubtree j wn' hwnj hnoJ k'.tag kOld hkOld hjInK').2
                    rw [hk'Get] at hsub; injection hsub
                  subst hkEq
                  rcases hsf k' (List.mem_of_getElem? hkOld) (by
                      rw [hR.hdense k'.tag k' hkOld]; exact hjInK') with
                    ⟨a, ha, haTail, hjInA, haSk⟩ | hokK
                  · left
                    have haGet : w.nodes[a.tag]? = some a := by
                      rw [← findNode?_eq_getElem?_of_denseTags hR.hdense]
                      exact findNode?_eq_some_of_mem_of_nodup hR.hwf.tagsNodup ha
                    have haInW' : a ∈ w'.nodes :=
                      List.mem_of_getElem? (hnoEvSubtree j wn' hwnj hnoJ a.tag a haGet hjInA).2
                    exact ⟨a, haInW', by rw [hancSame]; exact haTail,
                      by rw [hancSame]; exact hjInA, haSk⟩
                  · right; rw [hactProtEq]; exact hokK
              have hsifaJ' : SifaMatches w' off len j stj.idempotentForeignAccess := by
                cases hstS : stj.idempotentForeignAccess with
                | None => trivial
                | Read => rw [hstS] at hsfj; exact hsifaUnch false hsfj
                | Write => rw [hstS] at hsfj; exact ⟨hsifaUnch false hsfj.1, hsifaUnch true hsfj.2⟩
              refine ⟨ndj, stj, hndj, hexpj, htagj, hidxj, hparj,
                by rw [hchildSame]; exact hchj,
                by rw [hprotj']; exact hprotj,
                hoffj, hlenj, hnlJ, hpmj, hacj, hpossj, hsifaJ'⟩

private theorem find?_filter_push_ne {α : Type} (xs : Array (Miri.Memory.AllocId × α))
    (id₁ id₂ : Miri.Memory.AllocId) (v : α) (hne : id₂ ≠ id₁) :
    ((xs.filter fun r => r.1 != id₁).push (id₁, v)).find? (fun e => e.1 == id₂) =
      xs.find? (fun e => e.1 == id₂) := by
  rw [← Array.find?_toList, ← Array.find?_toList, Array.toList_push, List.find?_append,
    Array.toList_filter]
  have h12 : (id₁ == id₂) = false := beq_false_of_ne (Ne.symm hne)
  have hfilt : ∀ (l : List (Miri.Memory.AllocId × α)),
      (l.filter fun r => r.1 != id₁).find? (fun e => e.1 == id₂) =
        l.find? (fun e => e.1 == id₂) := by
    intro l
    induction l with
    | nil => rfl
    | cons x rest ih =>
      simp only [List.filter_cons, List.find?]
      by_cases hx1 : x.1 = id₁
      · subst hx1
        simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, h12]
        exact ih
      · have hxb : (x.1 != id₁) = true := bne_iff_ne.mpr hx1
        simp only [hxb, ↓reduceIte, List.find?]
        cases x.1 == id₂ with
        | true => rfl
        | false => exact ih
  rw [hfilt]
  cases xs.toList.find? (fun e => e.1 == id₂) with
  | some r => rfl
  | none => simp [h12]

/-- Multi-allocation protector-end access fold over a frame's `(AllocId × BorTag)` list, updating each
allocation's `FnEntryBorrowWorld` in `worlds` while keeping ALL protectors active (matching
`MachineHooks.beforeStackPopWithEnsure` across arbitrarily many distinct allocations). -/
def multiAllocEndAccesses (tagOf : Miri.Memory.BorTag → Nat) :
    List (Miri.Memory.AllocId × Miri.Memory.BorTag) →
    (Miri.Memory.AllocId → Option FnEntryBorrowWorld) →
    Except RetagStepErr (Miri.Memory.AllocId → Option FnEntryBorrowWorld)
  | [], worlds => .ok worlds
  | (id, tag) :: rest, worlds =>
    match worlds id with
    | none => .error (.missingParentTag (tagOf tag))
    | some w =>
      match execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
      | .error e => .error e
      | .ok w' =>
        multiAllocEndAccesses tagOf rest (fun a => if a == id then some w' else worlds a)

/-- **Multi-allocation decomposition theorem**: whenever `multiAllocEndAccesses` succeeds with
`worlds'`, for EVERY allocation `id` with initial world `worlds id = some w`, `worlds' id` is
`some w'` where `execProtectorEndAccesses protectorEndAccessIsWrite? w` on `id`'s filtered tags
returns `.ok w'` — hence `execFrameExitMiri` on `id`'s sub-frame returns
`.ok (releaseProtectors w' ...)`. Distinct allocations never interfere. -/
theorem multiAllocEndAccesses_ok_perAlloc_eq (tagOf : Miri.Memory.BorTag → Nat)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag)) :
    ∀ (worlds worlds' : Miri.Memory.AllocId → Option FnEntryBorrowWorld),
      multiAllocEndAccesses tagOf prots worlds = .ok worlds' →
      ∀ id w, worlds id = some w →
        ∃ w', worlds' id = some w' ∧
          execProtectorEndAccesses protectorEndAccessIsWrite? w
            ((prots.filter fun p => p.1 == id).map (fun p => tagOf p.2)) = .ok w' := by
  induction prots with
  | nil =>
    intro worlds worlds' hok id w hw
    injection hok with hEq; subst hEq
    exact ⟨w, hw, rfl⟩
  | cons p rest ih =>
    intro worlds worlds' hok id w hw
    obtain ⟨pid, ptag⟩ := p
    simp only [multiAllocEndAccesses] at hok
    cases hwp : worlds pid with
    | none => rw [hwp] at hok; cases hok
    | some wp =>
      rw [hwp] at hok; dsimp only at hok
      cases hex : execProtectorEndAccessFor protectorEndAccessIsWrite? wp (tagOf ptag) with
      | error e => rw [hex] at hok; cases hok
      | ok wp' =>
        rw [hex] at hok; dsimp only at hok
        let worlds1 := fun a => if a == pid then some wp' else worlds a
        by_cases heq : pid = id
        · subst heq
          rw [hw] at hwp; injection hwp with hEq; subst hEq
          have h1 : worlds1 pid = some wp' := by simp [worlds1]
          obtain ⟨w', hw', hrest⟩ := ih worlds1 worlds' hok pid wp' h1
          refine ⟨w', hw', ?_⟩
          simp only [List.filter_cons, beq_self_eq_true, ↓reduceIte, List.map_cons,
            execProtectorEndAccesses, hex]
          exact hrest
        · have hne : (pid == id) = false := beq_false_of_ne heq
          have hne' : (id == pid) = false := beq_false_of_ne (Ne.symm heq)
          have h1 : worlds1 id = some w := by
            simp only [worlds1, hne', Bool.false_eq_true, ↓reduceIte, hw]
          obtain ⟨w', hw', hrest⟩ := ih worlds1 worlds' hok id w h1
          refine ⟨w', hw', ?_⟩
          simp only [List.filter_cons, hne, Bool.false_eq_true, ↓reduceIte]
          exact hrest

/-- **Explicit scope of `BorrowTreeWorldRel`** (the side conditions of `realAccessReleaseSim`, stated
as a theorem instead of staying implicit in the relation): every related vendored tree has EXACTLY
ONE `DedupRangeMap` location segment and the single root `⟨0⟩`, and every theory node covers one
common NONEMPTY byte range. Depth, fan-out, permissions, protectors and `accessed` bits are
unrestricted. Trees with several location segments (per-offset permission splits) are therefore
outside the relation: one `FnEntryBorrowWorld` node carries one permission, a vendored tag carries
one permission PER segment. -/
theorem borrowTreeWorldRel_scope {pt : Miri.TreeBorrows.ProtectedTags}
    {frameTag : Miri.Memory.BorTag → Prop} {tagOf : Miri.Memory.BorTag → Nat}
    {tree : Miri.TreeBorrows.BorrowTree} {w : FnEntryBorrowWorld}
    (h : BorrowTreeWorldRel pt frameTag tagOf tree w) :
    tree.locations.entries.size = 1 ∧ tree.roots = #[⟨0⟩] ∧
    ∃ off len, 0 < len ∧ ∀ n ∈ w.nodes, n.rangeOffset = off ∧ n.rangeLen = len := by
  obtain ⟨_, _, off, len, hAt⟩ := h
  refine ⟨congrArg (fun l => l.entries.size) hAt.locs_eq, hAt.roots_eq, off, len, hAt.hlen_pos,
    fun n hn => ?_⟩
  obtain ⟨i, hi⟩ := List.getElem?_of_mem hn
  obtain ⟨_, _, _, _, _, _, _, _, _, hoff, hlen, _⟩ := hAt.node_sync i n hi
  exact ⟨hoff, hlen⟩

/-- Theory-side **prefix semantics** of a multi-allocation frame exit: the per-allocation worlds
reached by the longest successful prefix of implicit protector-end accesses, paired with the first
failing `(allocation, tag)` (`none` when every release succeeds). `multiAllocEndAccesses` discards
all state on failure (`Except`); this fold keeps the mutations already committed by earlier
releases, matching the imperative release loop of `MachineHooks.beforeStackPopWithEnsure`. -/
def multiAllocEndAccessesPartial (tagOf : Miri.Memory.BorTag → Nat) :
    List (Miri.Memory.AllocId × Miri.Memory.BorTag) →
    (Miri.Memory.AllocId → Option FnEntryBorrowWorld) →
    (Miri.Memory.AllocId → Option FnEntryBorrowWorld) ×
      Option (Miri.Memory.AllocId × Miri.Memory.BorTag)
  | [], worlds => (worlds, none)
  | (id, tag) :: rest, worlds =>
    match worlds id with
    | none => (worlds, some (id, tag))
    | some w =>
      match execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
      | .error _ => (worlds, some (id, tag))
      | .ok w' =>
        multiAllocEndAccessesPartial tagOf rest (fun a => if a == id then some w' else worlds a)

/-- `multiAllocEndAccesses` is exactly the success projection of `multiAllocEndAccessesPartial`:
`.ok worlds'` iff the prefix fold reports no failing release (with the same final worlds), and
`.error _` iff it reports one. -/
theorem multiAllocEndAccesses_eq_partial (tagOf : Miri.Memory.BorTag → Nat)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag)) :
    ∀ (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld),
      match multiAllocEndAccesses tagOf prots worlds,
          (multiAllocEndAccessesPartial tagOf prots worlds).2 with
      | .ok worlds', none => worlds' = (multiAllocEndAccessesPartial tagOf prots worlds).1
      | .error _, some _ => True
      | _, _ => False := by
  induction prots with
  | nil => intro worlds; exact rfl
  | cons p rest ih =>
    intro worlds
    obtain ⟨id, tag⟩ := p
    cases hw : worlds id with
    | none =>
      have h1 : multiAllocEndAccesses tagOf ((id, tag) :: rest) worlds =
          .error (.missingParentTag (tagOf tag)) := by
        simp only [multiAllocEndAccesses, hw]
      have h2 : multiAllocEndAccessesPartial tagOf ((id, tag) :: rest) worlds =
          (worlds, some (id, tag)) := by
        simp only [multiAllocEndAccessesPartial, hw]
      rw [h1, h2]; exact trivial
    | some w =>
      have h1 : multiAllocEndAccesses tagOf ((id, tag) :: rest) worlds =
          match execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | .error e => .error e
          | .ok w' => multiAllocEndAccesses tagOf rest
              (fun a => if a == id then some w' else worlds a) := by
        simp only [multiAllocEndAccesses, hw]
      have h2 : multiAllocEndAccessesPartial tagOf ((id, tag) :: rest) worlds =
          match execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | .error _ => (worlds, some (id, tag))
          | .ok w' => multiAllocEndAccessesPartial tagOf rest
              (fun a => if a == id then some w' else worlds a) := by
        simp only [multiAllocEndAccessesPartial, hw]
      rw [h1, h2]
      cases execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
      | error e => exact trivial
      | ok w' => exact ih (fun a => if a == id then some w' else worlds a)

/-- **Mid-sequence protector-end UB keeps the committed prefix** (release-fold level): for ANY
per-release simulation, `stackPopReleaseAll` and the prefix fold `multiAllocEndAccessesPartial` agree
on whether, and at WHICH `(allocation, tag)`, the frame exit fails. On failure every allocation
other than the failing one is still `R`-related to its prefix world (mutations of earlier releases
are retained, not rolled back), and the failing allocation holds exactly the tree written back by
the failed `BorrowTree.releaseProtector` from an `R`-related pre-state. -/
theorem stackPopReleaseAll_multiAlloc_partial_simulates {K : Type}
    (pt : Miri.TreeBorrows.ProtectedTags)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf : Miri.Memory.BorTag → Nat)
    (R : Miri.Memory.AllocId → Miri.TreeBorrows.BorrowTree → FnEntryBorrowWorld → Prop)
    (hsim : ∀ id, ProtectorReleaseSim pt (frameTag id) tagOf (R id))
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2) :
    ∀ (mem : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
      (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld),
      (∀ id w, worlds id = some w →
        ∃ entry, mem.live.find? (fun e => e.1 == id) = some (id, entry) ∧
          R id entry.allocation.extra w) →
      (∀ p ∈ prots, (worlds p.1).isSome = true) →
      ∃ mem' res, stackPopReleaseAll pt prots mem = some (mem', res) ∧
        match res, multiAllocEndAccessesPartial tagOf prots worlds with
        | none, (worlds', none) =>
          ∀ id w', worlds' id = some w' →
            ∃ entry', mem'.live.find? (fun e => e.1 == id) = some (id, entry') ∧
              R id entry'.allocation.extra w'
        | some err, (worlds', some (fid, ftag)) =>
          (∀ id w', id ≠ fid → worlds' id = some w' →
            ∃ entry', mem'.live.find? (fun e => e.1 == id) = some (id, entry') ∧
              R id entry'.allocation.extra w') ∧
          ∃ wf pre entry',
            worlds' fid = some wf ∧ R fid pre wf ∧
            (∃ e, execProtectorEndAccessFor protectorEndAccessIsWrite? wf (tagOf ftag) = .error e) ∧
            stackPopReleaseErr (pre.releaseProtector ftag pt).status = some (some err) ∧
            mem'.live.find? (fun e => e.1 == fid) = some (fid, entry') ∧
            entry'.allocation.extra = (pre.releaseProtector ftag pt).tree
        | _, _ => False := by
  induction prots with
  | nil =>
    intro mem worlds hsync _
    exact ⟨mem, none, rfl, hsync⟩
  | cons p rest ih =>
    intro mem worlds hsync hdom
    obtain ⟨id, tag⟩ := p
    have hsome : (worlds id).isSome = true := hdom (id, tag) List.mem_cons_self
    cases hw : worlds id with
    | none => rw [hw] at hsome; cases hsome
    | some w =>
      obtain ⟨entry, hfind, hR⟩ := hsync id w hw
      have hstep := (hsim id).step entry.allocation.extra w tag
        (hprots (id, tag) List.mem_cons_self) hR
      have hunf : stackPopReleaseAll pt ((id, tag) :: rest) mem =
          match stackPopReleaseErr (entry.allocation.extra.releaseProtector tag pt).status with
          | some none => stackPopReleaseAll pt rest
              (stackPopWriteBack mem id entry (entry.allocation.extra.releaseProtector tag pt).tree)
          | some (some err) => some (stackPopWriteBack mem id entry
              (entry.allocation.extra.releaseProtector tag pt).tree, some err)
          | none => none := by
        simp only [stackPopReleaseAll, hfind]
      have hpart : multiAllocEndAccessesPartial tagOf ((id, tag) :: rest) worlds =
          match execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | .error _ => (worlds, some (id, tag))
          | .ok w' => multiAllocEndAccessesPartial tagOf rest
              (fun a => if a == id then some w' else worlds a) := by
        simp only [multiAllocEndAccessesPartial, hw]
      rw [hunf, hpart]
      cases hE : stackPopReleaseErr (entry.allocation.extra.releaseProtector tag pt).status with
      | none =>
        rw [hE] at hstep
        cases hX : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
        | error e => rw [hX] at hstep; exact False.elim hstep
        | ok w1 => rw [hX] at hstep; exact False.elim hstep
      | some r =>
        rw [hE] at hstep
        cases r with
        | none =>
          cases hX : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | error e => rw [hX] at hstep; exact False.elim hstep
          | ok w1 =>
            rw [hX] at hstep
            refine ih (fun q hq => hprots q (List.mem_cons_of_mem _ hq))
              (stackPopWriteBack mem id entry (entry.allocation.extra.releaseProtector tag pt).tree)
              (fun a => if a == id then some w1 else worlds a) ?_ ?_
            · intro a wa hwa
              by_cases ha : a = id
              · subst ha
                simp only [beq_self_eq_true, ↓reduceIte, Option.some.injEq] at hwa
                subst hwa
                exact ⟨_, find?_filter_push_self mem.live a _, hstep⟩
              · have hne : (a == id) = false := beq_false_of_ne ha
                simp only [hne, Bool.false_eq_true, ↓reduceIte] at hwa
                obtain ⟨eA, hfA, hRA⟩ := hsync a wa hwa
                exact ⟨eA, by unfold stackPopWriteBack; rw [find?_filter_push_ne mem.live id a _ ha]; exact hfA, hRA⟩
            · intro q hq
              by_cases hqId : q.1 = id
              · simp [hqId]
              · have hne : (q.1 == id) = false := beq_false_of_ne hqId
                simp [hne, hdom q (List.mem_cons_of_mem _ hq)]
        | some err =>
          cases hX : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | ok w1 => rw [hX] at hstep; exact False.elim hstep
          | error e =>
            refine ⟨_, some err, rfl, ?_, w, entry.allocation.extra, _, hw, hR, ⟨e, hX⟩, hE,
              find?_filter_push_self mem.live id _, rfl⟩
            intro a wa ha hwa
            obtain ⟨eA, hfA, hRA⟩ := hsync a wa hwa
            exact ⟨eA, by unfold stackPopWriteBack; rw [find?_filter_push_ne mem.live id a _ ha]; exact hfA, hRA⟩

/-- **Mid-sequence protector-end UB at `MachineHooks.beforeStackPopWithEnsure`** (`lean-miri#74`):
the vendored frame pop and the prefix fold `multiAllocEndAccessesPartial` either both complete (one
`endCall`, every allocation `R`-related to its final world) or both stop at the SAME failing
`(fid, ftag)`. In the failing case `borrowTracker` is untouched (`endCall` never runs) and the
returned machine state RETAINS the partial mutations: every other allocation is `R`-related to its
prefix world, and `fid` holds the tree written back by the failed `releaseProtector`. -/
theorem miri_beforeStackPopWithEnsure_multiAlloc_partial_simulates
    {K User : Type} [DecidableEq K]
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨prots.toArray⟩)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf : Miri.Memory.BorTag → Nat)
    (R : Miri.Memory.AllocId → Miri.TreeBorrows.BorrowTree → FnEntryBorrowWorld → Prop)
    (hsim : ∀ id, ProtectorReleaseSim tracker.global.protectedTags (frameTag id) tagOf (R id))
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2)
    (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld)
    (hsync : ∀ id w, worlds id = some w →
      ∃ entry, st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        R id entry.allocation.extra w)
    (hdom : ∀ p ∈ prots, (worlds p.1).isSome = true) :
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st,
        multiAllocEndAccessesPartial tagOf prots worlds with
    | .ok () st', (worlds', none) =>
      st'.machine.borrowTracker = some { tracker with
        global := tracker.global.endCall ⟨prots.toArray⟩ } ∧
      ∀ id w', worlds' id = some w' →
        ∃ entry', st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          R id entry'.allocation.extra w'
    | .error err st', (worlds', some (fid, ftag)) =>
      st'.machine.borrowTracker = some tracker ∧
      (∀ id w', id ≠ fid → worlds' id = some w' →
        ∃ entry', st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          R id entry'.allocation.extra w') ∧
      ∃ wf pre entry',
        worlds' fid = some wf ∧ R fid pre wf ∧
        (∃ e, execProtectorEndAccessFor protectorEndAccessIsWrite? wf (tagOf ftag) = .error e) ∧
        stackPopReleaseErr (pre.releaseProtector ftag tracker.global.protectedTags).status =
          some (some err) ∧
        st'.machine.memory.live.find? (fun e => e.1 == fid) = some (fid, entry') ∧
        entry'.allocation.extra = (pre.releaseProtector ftag tracker.global.protectedTags).tree
    | _, _ => False := by
  obtain ⟨mem', res, hall, hmatch⟩ :=
    stackPopReleaseAll_multiAlloc_partial_simulates (K := K) tracker.global.protectedTags frameTag
      tagOf R hsim prots hprots st.machine.memory worlds hsync hdom
  have hrun := miri_beforeStackPopWithEnsure_eq_releaseAll st tracker frame prots.toArray
    htracker hframe hbf mem' res (by simpa using hall)
  rw [hrun]
  generalize multiAllocEndAccessesPartial tagOf prots worlds = part at hmatch ⊢
  obtain ⟨worlds', fail⟩ := part
  cases res with
  | none =>
    cases fail with
    | none => exact ⟨rfl, hmatch⟩
    | some f => obtain ⟨fid, ftag⟩ := f; exact False.elim hmatch
  | some err =>
    cases fail with
    | none => exact False.elim hmatch
    | some f =>
      obtain ⟨fid, ftag⟩ := f
      obtain ⟨h1, h2⟩ := hmatch
      exact ⟨htracker, h1, h2⟩

/-- **Multi-allocation fold simulation**: lifts ANY per-release simulation `ProtectorReleaseSim`
(including `realAccessReleaseSim` for real implicit Reads & Writes!) across a frame protecting
arbitrarily many tags residing in ARBITRARILY MANY distinct live allocations (`prots : List (AllocId × BorTag)`). -/
theorem stackPopReleaseAll_multiAlloc_simulates {K : Type}
    (pt : Miri.TreeBorrows.ProtectedTags)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf : Miri.Memory.BorTag → Nat)
    (R : Miri.Memory.AllocId → Miri.TreeBorrows.BorrowTree → FnEntryBorrowWorld → Prop)
    (hsim : ∀ id, ProtectorReleaseSim pt (frameTag id) tagOf (R id))
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2) :
    ∀ (mem : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
      (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld),
      (∀ id w, worlds id = some w →
        ∃ entry, mem.live.find? (fun e => e.1 == id) = some (id, entry) ∧
          R id entry.allocation.extra w) →
      (∀ p ∈ prots, (worlds p.1).isSome = true) →
      ∃ mem' res, stackPopReleaseAll pt prots mem = some (mem', res) ∧
        match res, multiAllocEndAccesses tagOf prots worlds with
        | none, .ok worlds' =>
          ∀ id w', worlds' id = some w' →
            ∃ entry', mem'.live.find? (fun e => e.1 == id) = some (id, entry') ∧
              R id entry'.allocation.extra w'
        | some _, .error _ => True
        | _, _ => False := by
  intro mem worlds hsync hdom
  obtain ⟨mem', res, hall, hmatch⟩ :=
    stackPopReleaseAll_multiAlloc_partial_simulates pt frameTag tagOf R hsim prots hprots mem worlds hsync hdom
  refine ⟨mem', res, hall, ?_⟩
  have hagr := multiAllocEndAccesses_eq_partial tagOf prots worlds
  cases hpart : multiAllocEndAccessesPartial tagOf prots worlds with
  | mk worlds' fail =>
    rw [hpart] at hmatch hagr
    cases res with
    | none =>
      cases fail with
      | some _ => exact False.elim hmatch
      | none =>
        cases htot : multiAllocEndAccesses tagOf prots worlds with
        | error _ => rw [htot] at hagr; exact False.elim hagr
        | ok wTot => rw [htot] at hagr; subst hagr; exact hmatch
    | some _ =>
      cases fail with
      | none => exact False.elim hmatch
      | some _ =>
        cases htot : multiAllocEndAccesses tagOf prots worlds with
        | ok _ => rw [htot] at hagr; exact False.elim hagr
        | error _ => trivial

/-- **Multi-allocation `MachineHooks.beforeStackPopWithEnsure` ↔ `execFrameExitMiri`**: generalizes
`miri_beforeStackPopWithEnsure_simulates_execFrameExitMiri` from single-allocation frames to frames
protecting tags across ARBITRARILY MANY distinct live allocations, and applies directly to
`realAccessReleaseSim` (`BorrowTreeWorldRel`) for real implicit Reads and Writes! -/
theorem miri_beforeStackPopWithEnsure_multiAlloc_simulates_execFrameExitMiri
    {K User : Type} [DecidableEq K]
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨prots.toArray⟩)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf protOf : Miri.Memory.BorTag → Nat)
    (R : Miri.Memory.AllocId → Miri.TreeBorrows.BorrowTree → FnEntryBorrowWorld → Prop)
    (hsim : ∀ id, ProtectorReleaseSim tracker.global.protectedTags (frameTag id) tagOf (R id))
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2)
    (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld)
    (hsync : ∀ id w, worlds id = some w →
      ∃ entry, st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        R id entry.allocation.extra w)
    (hdom : ∀ p ∈ prots, (worlds p.1).isSome = true) :
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st,
        multiAllocEndAccesses tagOf prots worlds with
    | .ok () st', .ok worlds' =>
      st'.machine.borrowTracker = some { tracker with
        global := tracker.global.endCall ⟨prots.toArray⟩ } ∧
      ∀ id w, worlds id = some w →
        ∃ entry' w',
          worlds' id = some w' ∧
          st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          R id entry'.allocation.extra w' ∧
          execFrameExitMiri w
            ((prots.filter fun p => p.1 == id).map fun p => (tagOf p.2, protOf p.2)) =
            .ok (releaseProtectors w'
              ((prots.filter fun p => p.1 == id).map fun p => protOf p.2))
    | .error _ st', .error _ => st'.machine.borrowTracker = some tracker
    | _, _ => False := by
  have hpart := miri_beforeStackPopWithEnsure_multiAlloc_partial_simulates st tracker frame prots
    htracker hframe hbf frameTag tagOf R hsim hprots worlds hsync hdom
  have hagr := multiAllocEndAccesses_eq_partial tagOf prots worlds
  cases hp : multiAllocEndAccessesPartial tagOf prots worlds with
  | mk worlds' fail =>
    rw [hp] at hpart hagr
    cases hpop : Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st with
    | ok u st' =>
      cases u; rw [hpop] at hpart
      cases fail with
      | some _ => exact False.elim hpart
      | none =>
        cases hX : multiAllocEndAccesses tagOf prots worlds with
        | error _ => rw [hX] at hagr; exact False.elim hagr
        | ok wTot =>
          rw [hX] at hagr; subst hagr
          refine ⟨hpart.1, fun id w hw => ?_⟩
          obtain ⟨w', hw', hper⟩ := multiAllocEndAccesses_ok_perAlloc_eq tagOf prots worlds wTot hX id w hw
          obtain ⟨entry', hf', hR'⟩ := hpart.2 id w' hw'
          refine ⟨entry', w', hw', hf', hR', ?_⟩
          unfold execFrameExitMiri; rw [List.map_map, List.map_map]
          change (match execProtectorEndAccesses protectorEndAccessIsWrite? w
              ((prots.filter fun (p : Miri.Memory.AllocId × Miri.Memory.BorTag) => p.1 == id).map
                fun (p : Miri.Memory.AllocId × Miri.Memory.BorTag) => tagOf p.2) with
            | Except.error e => Except.error e
            | Except.ok w'' => Except.ok (releaseProtectors w''
                ((prots.filter fun (p : Miri.Memory.AllocId × Miri.Memory.BorTag) => p.1 == id).map
                  fun (p : Miri.Memory.AllocId × Miri.Memory.BorTag) => protOf p.2))) = _
          rw [hper]
    | error err st' =>
      rw [hpop] at hpart
      cases fail with
      | none => exact False.elim hpart
      | some _ =>
        cases hX : multiAllocEndAccesses tagOf prots worlds with
        | ok _ => rw [hX] at hagr; exact False.elim hagr
        | error _ => exact hpart.1

/-- **Instantiated multi-allocation real-access frame-exit simulation**: specializes
`miri_beforeStackPopWithEnsure_multiAlloc_simulates_execFrameExitMiri` directly to
`realAccessReleaseSim` (`BorrowTreeWorldRel`), discharging real implicit Reads (`ReservedFrz`,
`Frozen`) and Writes (`Unique`) across arbitrarily many allocations with zero abstract simulation
hypotheses. -/
theorem miri_beforeStackPopWithEnsure_realAccess_multiAlloc_sim
    {K User : Type} [DecidableEq K]
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨prots.toArray⟩)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf protOf : Miri.Memory.BorTag → Nat)
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2)
    (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld)
    (hsync : ∀ id w, worlds id = some w →
      ∃ entry, st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf
          entry.allocation.extra w)
    (hdom : ∀ p ∈ prots, (worlds p.1).isSome = true) :
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st,
        multiAllocEndAccesses tagOf prots worlds with
    | .ok () st', .ok worlds' =>
      st'.machine.borrowTracker = some { tracker with
        global := tracker.global.endCall ⟨prots.toArray⟩ } ∧
      ∀ id w, worlds id = some w →
        ∃ entry' w',
          worlds' id = some w' ∧
          st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf
            entry'.allocation.extra w' ∧
          execFrameExitMiri w
            ((prots.filter fun p => p.1 == id).map fun p => (tagOf p.2, protOf p.2)) =
            .ok (releaseProtectors w'
              ((prots.filter fun p => p.1 == id).map fun p => protOf p.2))
    | .error _ st', .error _ => st'.machine.borrowTracker = some tracker
    | _, _ => False :=
  miri_beforeStackPopWithEnsure_multiAlloc_simulates_execFrameExitMiri st tracker frame prots
    htracker hframe hbf frameTag tagOf protOf
    (fun id => BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf)
    (fun id => realAccessReleaseSim tracker.global.protectedTags (frameTag id) tagOf)
    hprots worlds hsync hdom

/-- **Live vendored `BorrowTree.releaseProtector` simulation** matching `execProtectorEndAccess`,
`execProtectorEndAccess_descendants_untouched`, and `execFrameExit_miri_vs_sequential_separation`:
1. Releasing protected tag `2` while its strict descendant `4` is ALSO protected (sibling `3`
   unprotected) returns `.Released`, disables sibling `3`, and leaves strict descendant `4`
   literally untouched (`.Unique`, accessed) via `.SkipChildrenOfAccessed`.
2. Releasing protected tag `2` while sibling `3` is ALSO protected (same exiting frame, Miri order)
   fails with `.AccessFailure` (`ProtectedDisabled`), whereas releasing tag `2` after removing
   sibling `3`'s protector (sequential MiniRust order) returns `.Released`. -/
theorem miri_releaseProtector_skipChildren_and_siblingConflict :
    let t2 : Miri.Memory.BorTag := ⟨2, by decide⟩
    let t3 : Miri.Memory.BorTag := ⟨3, by decide⟩
    let t4 : Miri.Memory.BorTag := ⟨4, by decide⟩
    let protWithDesc : Miri.TreeBorrows.ProtectedTags :=
      ⟨#[(t2, .StrongProtector), (t4, .StrongProtector)]⟩
    let protWithSib : Miri.TreeBorrows.ProtectedTags :=
      ⟨#[(t2, .StrongProtector), (t3, .StrongProtector)]⟩
    let protAfterSibPop : Miri.TreeBorrows.ProtectedTags :=
      ⟨#[(t2, .StrongProtector)]⟩
    let resDesc := releaseProtectorSimTree.releaseProtector t2 protWithDesc
    let resSib := releaseProtectorSimTree.releaseProtector t2 protWithSib
    let resAfterPop := releaseProtectorSimTree.releaseProtector t2 protAfterSibPop
    resDesc.status = .Released ∧
    ((resDesc.tree.locations.entries[0]?.bind fun seg => seg.data.perms.get ⟨2⟩).map
      fun s => (s.permission, s.accessed)) = some (.Disabled, true) ∧
    (resDesc.tree.locations.entries[0]?.bind fun seg => seg.data.perms.get ⟨3⟩) =
      some ⟨.Unique, true, .None⟩ ∧
    (match resSib.status with | .AccessFailure _ _ => true | _ => false) = true ∧
    resAfterPop.status = .Released := by
  intro t2 t3 t4 protWithDesc protWithSib protAfterSibPop resDesc resSib resAfterPop
  let tagOf : Miri.Memory.BorTag → Nat := fun t => t.value.toNat - 1
  let wSim : List Nat → FnEntryBorrowWorld := fun aps =>
    { nodes := [
        { tag := 0, parentTag := none, perm := .unique, accessed := true, protector := none, rangeOffset := 0, rangeLen := 4 },
        { tag := 1, parentTag := some 0, perm := .unique, accessed := true, protector := some 10, rangeOffset := 0, rangeLen := 4 },
        { tag := 2, parentTag := some 0, perm := .unique, accessed := true, protector := some 20, rangeOffset := 0, rangeLen := 4 },
        { tag := 3, parentTag := some 1, perm := .unique, accessed := true, protector := some 30, rangeOffset := 0, rangeLen := 4 }]
      nextTag := 4, nextProtector := 40, activeProtectors := aps }
  have hrel : ∀ (pt : Miri.TreeBorrows.ProtectedTags) (aps : List Nat),
      pt.contains ⟨1, by decide⟩ = false →
      pt.contains t2 = (aps.any fun q => q == 10) →
      pt.contains t3 = (aps.any fun q => q == 20) →
      pt.contains t4 = (aps.any fun q => q == 30) →
      BorrowTreeWorldRel pt (fun t => t = t2) tagOf releaseProtectorSimTree (wSim aps) := by
    intro pt aps h1 h2 h3 h4
    refine ⟨⟨0, 4⟩,
      { perms := ⟨#[some ⟨.Unique, true, .None⟩, some ⟨.Unique, true, .None⟩,
                    some ⟨.Unique, true, .None⟩, some ⟨.Unique, true, .None⟩]⟩, exposedCache := {} },
      0, 4, ?_⟩
    refine ⟨?_, ?_, by simp [wSim], rfl, rfl, by decide, rfl, ?_, ?_⟩
    · refine ⟨by simp [wSim], fun n hn => ?_⟩
      simp only [wSim, List.mem_cons, List.not_mem_nil, or_false] at hn
      rcases hn with rfl | rfl | rfl | rfl
      · exact ⟨0, by simp [wSim], ReachesRoot.root _ rfl rfl⟩
      · exact ⟨1, by simp [wSim], ReachesRoot.step 0 1 0 _ rfl rfl (ReachesRoot.root _ rfl rfl)⟩
      · exact ⟨1, by simp [wSim], ReachesRoot.step 0 2 0 _ rfl rfl (ReachesRoot.root _ rfl rfl)⟩
      · exact ⟨2, by simp [wSim], ReachesRoot.step 1 3 1 _ rfl rfl (ReachesRoot.step 0 1 0 _ rfl rfl (ReachesRoot.root _ rfl rfl))⟩
    · intro i n h; match i with
      | 0 | 1 | 2 | 3 => simp only [wSim] at h; injection h with h; subst h; rfl
      | _ + 4 => simp [wSim] at h
    · intro i wn h; match i with
      | 0 => simp only [wSim] at h; injection h with h; subst h; exact ⟨_, _, rfl, rfl, rfl, rfl, rfl, rfl, h1, rfl, rfl, rfl, rfl, rfl, Or.inl rfl, trivial⟩
      | 1 => simp only [wSim] at h; injection h with h; subst h; exact ⟨_, _, rfl, rfl, rfl, rfl, rfl, rfl, by simpa [TreeTagNode.isProtected, wSim] using h2, rfl, rfl, rfl, rfl, rfl, Or.inl rfl, trivial⟩
      | 2 => simp only [wSim] at h; injection h with h; subst h; exact ⟨_, _, rfl, rfl, rfl, rfl, rfl, rfl, by simpa [TreeTagNode.isProtected, wSim] using h3, rfl, rfl, rfl, rfl, rfl, Or.inl rfl, trivial⟩
      | 3 => simp only [wSim] at h; injection h with h; subst h; exact ⟨_, _, rfl, rfl, rfl, rfl, rfl, rfl, by simpa [TreeTagNode.isProtected, wSim] using h4, rfl, rfl, rfl, rfl, rfl, Or.inl rfl, trivial⟩
      | _ + 4 => simp [wSim] at h
    · intro tag ht; subst ht; exact ⟨1, by simp [wSim], rfl, rfl⟩
  have hD := (realAccessReleaseSim protWithDesc (fun t => t = t2) tagOf).step
    releaseProtectorSimTree (wSim [10, 30]) t2 rfl (hrel protWithDesc [10, 30] (by decide) (by decide) (by decide) (by decide))
  have hS := (realAccessReleaseSim protWithSib (fun t => t = t2) tagOf).step
    releaseProtectorSimTree (wSim [10, 20]) t2 rfl (hrel protWithSib [10, 20] (by decide) (by decide) (by decide) (by decide))
  have hP := (realAccessReleaseSim protAfterSibPop (fun t => t = t2) tagOf).step
    releaseProtectorSimTree (wSim [10]) t2 rfl (hrel protAfterSibPop [10] (by decide) (by decide) (by decide) (by decide))
  let wDesc' : FnEntryBorrowWorld :=
    { (wSim [10, 30]) with nodes := [
        { tag := 0, parentTag := none, perm := .unique, accessed := true, protector := none, rangeOffset := 0, rangeLen := 4 },
        { tag := 1, parentTag := some 0, perm := .unique, accessed := true, protector := some 10, rangeOffset := 0, rangeLen := 4 },
        { tag := 2, parentTag := some 0, perm := .disabled, accessed := true, protector := some 20, rangeOffset := 0, rangeLen := 4 },
        { tag := 3, parentTag := some 1, perm := .unique, accessed := true, protector := some 30, rangeOffset := 0, rangeLen := 4 }] }
  have hexD : execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10, 30]) (tagOf t2) = .ok wDesc' := by decide
  have hexS : ∃ e, execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10, 20]) (tagOf t2) = .error e := by
    have hok : (execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10, 20]) (tagOf t2)).isOk = false := by decide
    cases h : execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10, 20]) (tagOf t2) with
    | ok _ => rw [h] at hok; cases hok
    | error e => exact ⟨e, rfl⟩
  have hexP : ∃ w', execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10]) (tagOf t2) = .ok w' := by
    have hok : (execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10]) (tagOf t2)).isOk = true := by decide
    cases h : execProtectorEndAccessFor protectorEndAccessIsWrite? (wSim [10]) (tagOf t2) with
    | error _ => rw [h] at hok; cases hok
    | ok w' => exact ⟨w', rfl⟩
  rw [hexD] at hD
  rcases hexS with ⟨eS, hexS⟩; rw [hexS] at hS
  rcases hexP with ⟨wP', hexP⟩; rw [hexP] at hP
  have hDrel : resDesc.status = .Released ∧ BorrowTreeWorldRel protWithDesc (fun t => t = t2) tagOf resDesc.tree wDesc' := by
    cases hst : resDesc.status with
    | Released => rw [hst] at hD; exact ⟨rfl, hD⟩
    | _ => rw [hst] at hD; exact False.elim hD
  have hSfail : (match resSib.status with | .AccessFailure _ _ => true | _ => false) = true := by
    cases hst : resSib.status with
    | AccessFailure _ _ => rfl
    | _ => rw [hst] at hS; exact False.elim hS
  have hPrel : resAfterPop.status = .Released := by
    cases hst : resAfterPop.status with
    | Released => rfl
    | _ => rw [hst] at hP; exact False.elim hP
  rcases hDrel.2 with ⟨rng, loc, off, len, hAt⟩
  have hoff : off = 0 ∧ len = 4 := by
    obtain ⟨_, _, _, _, _, _, _, _, _, ho, hl, _⟩ := hAt.node_sync 0 _ rfl
    exact ⟨ho.symm, hl.symm⟩
  rcases hoff with ⟨rfl, rfl⟩
  have h0seg : resDesc.tree.locations.entries[0]? = some ⟨rng, loc⟩ := by rw [hAt.locs_eq]; rfl
  obtain ⟨_, st2, _, _, _, _, _, _, _, _, _, hperm2, hp2, ha2, _, _⟩ := hAt.node_sync 2 _ rfl
  obtain ⟨_, st3, _, _, _, _, _, _, _, _, _, hperm3, hp3, ha3, _, hsifa3⟩ := hAt.node_sync 3 _ rfl
  have hsifa3None : st3.idempotentForeignAccess = .None := by
    cases hs : st3.idempotentForeignAccess with
    | None => rfl
    | Read =>
      rw [hs] at hsifa3
      have hbad := hsifa3 { tag := 3, parentTag := some 1, perm := .unique, accessed := true, protector := some 30, rangeOffset := 0, rangeLen := 4 }
        (by decide) (by decide)
      rcases hbad with ⟨a, haMem, haTail, haAnc, _⟩ | hfp
      · simp only [wDesc', List.mem_cons, List.not_mem_nil, or_false] at haMem
        rcases haMem with rfl | rfl | rfl | rfl <;> (revert haTail haAnc; decide)
      · revert hfp; decide
    | Write =>
      rw [hs] at hsifa3
      have hbad := hsifa3.1 { tag := 3, parentTag := some 1, perm := .unique, accessed := true, protector := some 30, rangeOffset := 0, rangeLen := 4 }
        (by decide) (by decide)
      rcases hbad with ⟨a, haMem, haTail, haAnc, _⟩ | hfp
      · simp only [wDesc', List.mem_cons, List.not_mem_nil, or_false] at haMem
        rcases haMem with rfl | rfl | rfl | rfl <;> (revert haTail haAnc; decide)
      · revert hfp; decide
  refine ⟨hDrel.1, ?_, ?_, hSfail, hPrel⟩
  · rw [h0seg, Option.bind_some]
    change (loc.perms.get ⟨UInt32.ofNat 2⟩).map (fun s => (s.permission, s.accessed)) = some (.Disabled, true)
    rw [hperm2, Option.map_some, hp2, ha2]; rfl
  · rw [h0seg, Option.bind_some]
    change loc.perms.get ⟨UInt32.ofNat 3⟩ = some ⟨.Unique, true, .None⟩
    rw [hperm3]; congr 1
    cases st3; simp only at hp3 ha3 hsifa3None; subst hp3; subst ha3; subst hsifa3None; rfl

/-! ### 2E.1a.2 Multi-segment `BorrowTree.releaseProtector`, Strong/Weak irrelevance, &
`beforeStackPopWithEnsure` real-access partial simulation with full frame preservation (`lean-miri#74`) -/

private theorem dedupRangeMap_setAtPos_exact {α : Type}
    (m : Miri.DataStructures.DedupRangeMap α) (pos : Nat) (h : pos < m.entries.size) (v : α) :
    m.setAtPos pos v =
      ⟨⟨m.entries.set pos { m.entries[pos] with data := v } h⟩, .ok ()⟩ := by
  unfold Miri.DataStructures.DedupRangeMap.setAtPos
  simp only [Id.run, pure, Pure.pure]
  have hseg : (miri_etm_private% Miri.DataStructures.DedupRangeMap
      Miri.DataStructures.DedupRangeMap.segmentAt?) m.entries pos = some m.entries[pos] := by
    change (if h' : pos < m.entries.size then some m.entries[pos] else none) = _
    simp only [h, ↓reduceDIte]
  have hupd : (miri_etm_private% Miri.DataStructures.DedupRangeMap
      Miri.DataStructures.DedupRangeMap.updateAt) m.entries pos { m.entries[pos] with data := v } =
      .ok (m.entries.set pos { m.entries[pos] with data := v } h) := by
    change (if h' : pos < m.entries.size then
      (Except.ok (m.entries.set pos { m.entries[pos] with data := v } h') :
        Except Miri.DataStructures.DedupRangeMapError _)
      else Except.error (.indexOutOfBounds pos m.entries.size)) = _
    simp only [h, ↓reduceDIte]
  rw [hseg]
  dsimp only
  rw [hupd]

/-- Congruence of the vendored per-location tree access: it depends on the tree only through its
node table, root list, normal / wildcard per-location accesses and minimal exposed child. -/
private theorem performTreeAccessAt_congr
    (t₁ t₂ : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (source? : Option Miri.TreeBorrows.UniIndex) (kind : Miri.TreeBorrows.AccessKind)
    (pt₁ pt₂ : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode) (range : Miri.DataStructures.ByteRange)
    (hnodes : t₁.nodes = t₂.nodes) (hroots : t₁.roots = t₂.roots)
    (hN : ∀ l s, t₁.performNormalAccessAt l s kind pt₁ mode = t₂.performNormalAccessAt l s kind pt₂ mode)
    (hW : ∀ l r m b, t₁.performWildcardAccessAt l r m kind pt₁ b =
      t₂.performWildcardAccessAt l r m kind pt₂ b)
    (hM : miriMinExposedChild t₁ = miriMinExposedChild t₂) :
    miriPerformTreeAccessAt t₁ loc source? kind pt₁ mode range =
    miriPerformTreeAccessAt t₂ loc source? kind pt₂ mode range := by
  change (Id.run do
    let mut currentLocation := loc
    let mut normalAccess : Option Miri.TreeBorrows.Tree.NormalAccessResult := none
    let mut accessedRoot? : Option Miri.TreeBorrows.UniIndex := none
    let mut status : Option Miri.TreeBorrows.BorrowTree.BorrowTreeAccessStatus := none
    if let some source := source? then
      let normal := t₁.performNormalAccessAt currentLocation source kind pt₁ mode
      currentLocation := normal.location
      normalAccess := some normal.access
      match normal.outcome with
      | .error error =>
          return miriTLAMk currentLocation normalAccess (some (.CacheFailure range error))
      | .ok () =>
          if normal.access.status != .Completed then
            return miriTLAMk currentLocation normalAccess (some (.AccessFailure range normal.access.status))
          match Miri.TreeBorrows.UniIndex.ofNat? normal.access.root with
          | none =>
              return miriTLAMk currentLocation normalAccess (some (.AccessFailure range (.MissingLocationState normal.access.root)))
          | some root => accessedRoot? := some root
    let maxLocalTag := accessedRoot?.bind fun root => (t₁.nodes.get root).map Miri.TreeBorrows.TreeNode.tag
    let minExposed := if mode == .SkipChildrenOfAccessed then
        source?.bind (miriMinExposedChild t₁)
      else none
    let mut stopOtherRoots := false
    for rootPosition in [:t₁.roots.size] do
      if status.isNone && !stopOtherRoots then
        match t₁.roots[rootPosition]? with
        | none => pure ()
        | some root =>
            let rootTag := (t₁.nodes.get root).map Miri.TreeBorrows.TreeNode.tag
            let pastMinExposed := match rootTag, minExposed with
              | some tag, some minimum => tag.value > minimum.value
              | _, _ => false
            if mode == .SkipChildrenOfAccessed && pastMinExposed then
              stopOtherRoots := true
            else if accessedRoot? != some root then
              let wildcard := t₁.performWildcardAccessAt currentLocation root
                maxLocalTag kind pt₁ (rootPosition != 0)
              currentLocation := wildcard.location
              if wildcard.status != .Completed then
                status := some (.WildcardFailure range wildcard.status)
    return miriTLAMk currentLocation normalAccess status) = _
  simp only [hN, hW, hM, hnodes, hroots]
  rfl

private theorem performTreeAccessAt_locations_indep
    (tree : Miri.TreeBorrows.BorrowTree)
    (l1 l2 : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree)
    (loc : Miri.TreeBorrows.LocationTree) (source? : Option Miri.TreeBorrows.UniIndex)
    (kind : Miri.TreeBorrows.AccessKind) (pt : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode) (range : Miri.DataStructures.ByteRange) :
    miriPerformTreeAccessAt { tree with locations := l1 } loc source? kind pt mode range =
    miriPerformTreeAccessAt { tree with locations := l2 } loc source? kind pt mode range :=
  performTreeAccessAt_congr { tree with locations := l1 } { tree with locations := l2 } loc source?
    kind pt pt mode range rfl rfl
    (fun _ _ => by unfold Miri.TreeBorrows.BorrowTree.performNormalAccessAt; rfl)
    (fun _ _ _ _ => by unfold Miri.TreeBorrows.BorrowTree.performWildcardAccessAt; rfl) rfl

private theorem performNormalAccessAt_protectedTags_congr
    (tree : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (src : Miri.TreeBorrows.UniIndex) (kind : Miri.TreeBorrows.AccessKind)
    (pt₁ pt₂ : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (h : ∀ t, pt₁.contains t = pt₂.contains t) :
    tree.performNormalAccessAt loc src kind pt₁ mode =
    tree.performNormalAccessAt loc src kind pt₂ mode := by
  have hnorm : miriNormalProjection tree loc pt₁ = miriNormalProjection tree loc pt₂ := by
    rw [miriNormalProjection_eq_struct, miriNormalProjection_eq_struct]
    congr 1
    have hfun : (fun (p : Miri.TreeBorrows.UniIndex × Miri.TreeBorrows.TreeNode) =>
        if pt₁.contains p.2.tag then some p.1.toNat else none) =
      (fun (p : Miri.TreeBorrows.UniIndex × Miri.TreeBorrows.TreeNode) =>
        if pt₂.contains p.2.tag then some p.1.toNat else none) :=
      funext fun ⟨_, nd⟩ => by simp only [h]
    rw [hfun]
  unfold Miri.TreeBorrows.BorrowTree.performNormalAccessAt
  simp only [hnorm, h]

private theorem performTreeAccessAt_protectedTags_congr
    (tree : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (source? : Option Miri.TreeBorrows.UniIndex) (kind : Miri.TreeBorrows.AccessKind)
    (pt₁ pt₂ : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (range : Miri.DataStructures.ByteRange)
    (h : ∀ t, pt₁.contains t = pt₂.contains t) :
    miriPerformTreeAccessAt tree loc source? kind pt₁ mode range =
    miriPerformTreeAccessAt tree loc source? kind pt₂ mode range :=
  performTreeAccessAt_congr tree tree loc source? kind pt₁ pt₂ mode range rfl rfl
    (fun l s => performNormalAccessAt_protectedTags_congr tree l s kind pt₁ pt₂ mode h)
    (fun _ _ _ _ => by unfold Miri.TreeBorrows.BorrowTree.performWildcardAccessAt; simp only [h]) rfl

/-- **Strong vs Weak protector irrelevance in `BorrowTree.releaseProtector` (`lean-miri#74`)**:
`releaseProtector` only inspects protector presence (`ProtectedTags.contains`), never the
`StrongProtector` vs `WeakProtector` distinction (which only affects `deallocateBorrowRange`).
Therefore any two `ProtectedTags` maps with the same protected-tag domain produce identical
`BorrowTree.releaseProtector` outputs across arbitrary multi-segment trees with co-existing
strong and weak protectors! -/
theorem miri_releaseProtector_strong_weak_irrelevant
    (tree : Miri.TreeBorrows.BorrowTree) (tag : Miri.Memory.BorTag)
    (pt₁ pt₂ : Miri.TreeBorrows.ProtectedTags)
    (h : ∀ t, pt₁.contains t = pt₂.contains t) :
    tree.releaseProtector tag pt₁ = tree.releaseProtector tag pt₂ := by
  unfold Miri.TreeBorrows.BorrowTree.releaseProtector
  have hP : ∀ (t : Miri.TreeBorrows.BorrowTree) l s k m r,
      miriPerformTreeAccessAt t l s k pt₁ m r = miriPerformTreeAccessAt t l s k pt₂ m r :=
    fun t l s k m r => performTreeAccessAt_protectedTags_congr t l s k pt₁ pt₂ m r h
  simp only [hP]

/-- Per-segment specification for multi-segment `BorrowTree.releaseProtector` simulation:
* `.skipped`: segment where the released tag is unmaterialized (`perms.get source = none`),
  unaccessed (`accessed = false`), or has `.Cell` (`associatedAccess = none`) — skipped by
  `releaseProtector` without touching `locations`;
* `.tracked w`: segment whose single-segment slice satisfies `BorrowTreeWorldRel` against `w`. -/
inductive SegReleaseSpec where
  | skipped
  | tracked (w : FnEntryBorrowWorld)
  deriving Repr, DecidableEq

/-- Prefix-fold of `execProtectorEndAccessFor` over a list of per-segment `SegReleaseSpec`s,
stopping at the first failing segment index `some pos` and leaving trailing segments untouched. -/
def multiSegEndAccessPartialGo (tagNat : Nat) (pos : Nat) :
    List SegReleaseSpec → List SegReleaseSpec × Option Nat
  | [] => ([], none)
  | .skipped :: rest =>
    let (rest', fail) := multiSegEndAccessPartialGo tagNat (pos + 1) rest
    (.skipped :: rest', fail)
  | .tracked w :: rest =>
    match execProtectorEndAccessFor protectorEndAccessIsWrite? w tagNat with
    | .ok w' =>
      let (rest', fail) := multiSegEndAccessPartialGo tagNat (pos + 1) rest
      (.tracked w' :: rest', fail)
    | .error _ =>
      (.tracked w :: rest, some pos)

/-- Multi-segment protector-release prefix fold starting at segment index `0`. -/
def multiSegEndAccessPartial (tagNat : Nat) (specs : List SegReleaseSpec) :
    List SegReleaseSpec × Option Nat :=
  multiSegEndAccessPartialGo tagNat 0 specs

/-- Per-segment relation between a `RangeMapSegment` inside a multi-segment `BorrowTree` and a
`SegReleaseSpec`. -/
def SegReleaseRel (pt : Miri.TreeBorrows.ProtectedTags)
    (frameTag : Miri.Memory.BorTag → Prop) (tagOf : Miri.Memory.BorTag → Nat)
    (tree : Miri.TreeBorrows.BorrowTree) (source : Miri.TreeBorrows.UniIndex)
    (seg : Miri.DataStructures.RangeMapSegment Miri.TreeBorrows.LocationTree) :
    SegReleaseSpec → Prop
  | .skipped =>
    match seg.data.perms.get source with
    | none => True
    | some st => st.accessed = false ∨ st.permission.associatedAccess = none
  | .tracked w =>
    BorrowTreeWorldRel pt frameTag tagOf { tree with locations := ⟨#[seg]⟩ } w

private def releaseProtectorLoopStep
    (source : Miri.TreeBorrows.UniIndex) (pt : Miri.TreeBorrows.ProtectedTags)
    (position : Nat)
    (s : Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree) :
    Id (ForInStep (Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree)) :=
  match s.2.locations.index position with
  | .error error =>
      ForInStep.done (some { tree := s.2, status := .RangeMapFailure error }, s.2)
  | .ok segment =>
      match segment.data.perms.get source with
      | none => ForInStep.yield (none, s.2)
      | some state =>
          match state.permission.associatedAccess with
          | none => ForInStep.yield (none, s.2)
          | some kind =>
              if state.accessed then
                let access := miriPerformTreeAccessAt
                  s.2 segment.data (some source) kind pt .SkipChildrenOfAccessed segment.range
                let mutation := s.2.locations.setAtPos position
                  ((miri_etm_private% Miri.TreeBorrows.TreeState
                    Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location) access)
                let nextTree : Miri.TreeBorrows.BorrowTree :=
                  { tagMapping := s.2.tagMapping, nodes := s.2.nodes, locations := mutation.state, roots := s.2.roots }
                match mutation.outcome with
                | .error error =>
                    ForInStep.done (some { tree := nextTree, status := .LocationMapFailure error }, nextTree)
                | .ok () =>
                    match (miri_etm_private% Miri.TreeBorrows.TreeState
                        Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status) access with
                    | some status =>
                        ForInStep.done (some { tree := nextTree, status := .AccessFailure segment.range status }, nextTree)
                    | none => ForInStep.yield (none, nextTree)
              else ForInStep.yield (none, s.2)

private theorem releaseProtector_eq_forIn_step
    (tree : Miri.TreeBorrows.BorrowTree) (tag : Miri.Memory.BorTag)
    (source : Miri.TreeBorrows.UniIndex) (pt : Miri.TreeBorrows.ProtectedTags)
    (htag : tree.indexOfTag tag = some source) :
    let loopRes : Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree :=
      forIn (m := Id) (List.range' 0 tree.locations.entries.size) (none, tree)
        (releaseProtectorLoopStep source pt)
    tree.releaseProtector tag pt =
      match loopRes.1 with
      | some r => r
      | none =>
        match (loopRes.2.updateExposureForProtectorRelease tag).outcome with
        | .error error => { tree := (loopRes.2.updateExposureForProtectorRelease tag).tree, status := .ExposureUpdateFailure error }
        | .ok () => { tree := (loopRes.2.updateExposureForProtectorRelease tag).tree, status := .Released } := by
  unfold Miri.TreeBorrows.BorrowTree.releaseProtector
  rw [htag]
  simp only [Id.run, bind, Bind.bind, pure, Pure.pure,
    Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size,
    Nat.sub_zero, Nat.add_sub_cancel, Nat.div_one]
  have hcongr : ∀ (f : Nat → (Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree) →
      Id (ForInStep (Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree))),
      (∀ p s, f p s = releaseProtectorLoopStep source pt p s) →
      forIn (m := Id) (List.range' 0 tree.locations.entries.size) (none, tree) f =
      forIn (m := Id) (List.range' 0 tree.locations.entries.size) (none, tree)
        (releaseProtectorLoopStep source pt) := by
    intro f hf; congr 1; funext p s; exact hf p s
  rw [hcongr _ (fun pos s => by
    unfold releaseProtectorLoopStep
    cases s.2.locations.index pos with
    | error _ => rfl
    | ok seg =>
      cases seg.data.perms.get source with
      | none => rfl
      | some st =>
        cases st.permission.associatedAccess with
        | none => rfl
        | some kind =>
          cases st.accessed <;> rfl)]
  generalize (forIn (m := Id) (List.range' 0 tree.locations.entries.size) (none, tree)
    (releaseProtectorLoopStep source pt) :
      Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree) = r
  rcases r with ⟨r1, r2⟩
  cases r1 with
  | some x => rfl
  | none =>
    cases (r2.updateExposureForProtectorRelease tag).outcome <;> rfl

private theorem releaseProtector_singleSeg_step_eq
    (tree : Miri.TreeBorrows.BorrowTree) (tag : Miri.Memory.BorTag)
    (source : Miri.TreeBorrows.UniIndex) (nd : Miri.TreeBorrows.TreeNode)
    (pt : Miri.TreeBorrows.ProtectedTags)
    (seg : Miri.DataStructures.RangeMapSegment Miri.TreeBorrows.LocationTree)
    (htag : tree.indexOfTag tag = some source)
    (hnd : tree.nodeAt source = some nd)
    (hexp : nd.isExposed = false) :
    let t1 : Miri.TreeBorrows.BorrowTree := { tree with locations := ⟨#[seg]⟩ }
    t1.releaseProtector tag pt =
      match seg.data.perms.get source with
      | none => ⟨t1, .Released⟩
      | some st =>
        match st.permission.associatedAccess with
        | none => ⟨t1, .Released⟩
        | some kind =>
          if st.accessed then
            let acc := miriPerformTreeAccessAt tree seg.data (some source) kind pt .SkipChildrenOfAccessed seg.range
            let loc' := (miri_etm_private% Miri.TreeBorrows.TreeState
              Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location) acc
            let st' := (miri_etm_private% Miri.TreeBorrows.TreeState
              Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status) acc
            let t1' : Miri.TreeBorrows.BorrowTree := { tree with locations := ⟨#[{ seg with data := loc' }]⟩ }
            match st' with
            | some errSt => ⟨t1', .AccessFailure seg.range errSt⟩
            | none => ⟨t1', .Released⟩
          else ⟨t1, .Released⟩ := by
  intro t1
  have hexpAll : ∀ l : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree,
      ({ tree with locations := l }).updateExposureForProtectorRelease tag =
        ⟨{ tree with locations := l }, .ok ()⟩ := by
    intro l
    unfold Miri.TreeBorrows.BorrowTree.updateExposureForProtectorRelease
    have ht : ({ tree with locations := l }).indexOfTag tag = some source := htag
    have hn : ({ tree with locations := l }).nodeAt source = some nd := hnd
    simp [ht, hn, hexp, Id.run, pure]
  have ht1 : t1.indexOfTag tag = some source := htag
  have hlt0 : 0 < t1.locations.entries.size := Nat.zero_lt_one
  have hidx0 : (⟨#[seg]⟩ : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree).index 0 = .ok seg :=
    Miri.TreeBorrows.BorrowTree.ZeroProtection.Release.index_exact ⟨#[seg]⟩ 0 Nat.zero_lt_one
  rw [releaseProtector_eq_forIn_step t1 tag source pt ht1]
  have hrng1 : List.range' 0 t1.locations.entries.size = [0] := rfl
  rw [hrng1]
  simp only [List.forIn_cons, List.forIn_nil, releaseProtectorLoopStep, bind, Bind.bind, pure, Pure.pure]
  dsimp only [t1]
  rw [hidx0]
  dsimp only
  cases hget : seg.data.perms.get source with
  | none => dsimp only; rw [hexpAll]
  | some st =>
    dsimp only
    cases hassoc : st.permission.associatedAccess with
    | none => dsimp only; rw [hexpAll]
    | some kind =>
      dsimp only
      cases haccB : st.accessed with
      | false => simp only [Bool.false_eq_true, ↓reduceIte]; rw [hexpAll]
      | true =>
        simp only [↓reduceIte]
        have hind := performTreeAccessAt_locations_indep tree ⟨#[seg]⟩ tree.locations
          seg.data (some source) kind pt .SkipChildrenOfAccessed seg.range
        have htreeEq : ({ tree with locations := tree.locations } : Miri.TreeBorrows.BorrowTree) = tree := rfl
        rw [htreeEq] at hind
        rw [hind]
        have hset := dedupRangeMap_setAtPos_exact (⟨#[seg]⟩ : Miri.DataStructures.DedupRangeMap _) 0 hlt0
          ((miri_etm_private% Miri.TreeBorrows.TreeState
            Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location)
            (miriPerformTreeAccessAt tree seg.data (some source) kind pt .SkipChildrenOfAccessed seg.range))
        rw [hset]
        dsimp only
        cases ((miri_etm_private% Miri.TreeBorrows.TreeState
            Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status)
            (miriPerformTreeAccessAt tree seg.data (some source) kind pt .SkipChildrenOfAccessed seg.range)) with
        | some errSt => rfl
        | none =>
          dsimp only
          rw [hexpAll]
          rfl

private theorem releaseProtector_multiSeg_loop_sim
    (tree : Miri.TreeBorrows.BorrowTree) (tag : Miri.Memory.BorTag)
    (source : Miri.TreeBorrows.UniIndex) (nd : Miri.TreeBorrows.TreeNode)
    (pt : Miri.TreeBorrows.ProtectedTags)
    (frameTag : Miri.Memory.BorTag → Prop) (tagOf : Miri.Memory.BorTag → Nat)
    (htag : tree.indexOfTag tag = some source)
    (hnd : tree.nodeAt source = some nd)
    (hexp : nd.isExposed = false)
    (ht : frameTag tag) :
    ∀ (remLen start : Nat), start + remLen = tree.locations.entries.size →
      ∀ (locsCur : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree),
      locsCur.entries.size = tree.locations.entries.size →
      ∀ (specs : List SegReleaseSpec), specs.length = remLen →
      (∀ (k : Nat) seg spec, locsCur.entries[start + k]? = some seg → specs[k]? = some spec →
        SegReleaseRel pt frameTag tagOf tree source seg spec) →
      let res : Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree :=
        forIn (m := Id) (List.range' start remLen)
          (none, ({ tree with locations := locsCur } : Miri.TreeBorrows.BorrowTree))
          (releaseProtectorLoopStep source pt)
      let part := multiSegEndAccessPartialGo (tagOf tag) start specs
      res.2.tagMapping = tree.tagMapping ∧
      res.2.nodes = tree.nodes ∧
      res.2.roots = tree.roots ∧
      res.2.locations.entries.size = tree.locations.entries.size ∧
      (∀ (j : Nat), (res.2.locations.entries[j]?).map (·.range) = (locsCur.entries[j]?).map (·.range)) ∧
      (∀ (j : Nat), j < start → res.2.locations.entries[j]? = locsCur.entries[j]?) ∧
      match res.1, part.2 with
      | none, none =>
        ∀ (k : Nat) seg' spec',
          res.2.locations.entries[start + k]? = some seg' →
          part.1[k]? = some spec' →
          SegReleaseRel pt frameTag tagOf tree source seg' spec' ∧
          (specs[k]? = some SegReleaseSpec.skipped →
            res.2.locations.entries[start + k]? = locsCur.entries[start + k]?)
      | some failRes, some failPos =>
        failRes.tree = res.2 ∧
        start ≤ failPos ∧ failPos < tree.locations.entries.size ∧
        (∃ segF errSt, locsCur.entries[failPos]? = some segF ∧
          failRes.status = .AccessFailure segF.range errSt ∧
          ∃ wF e segF',
            (∃ k, failPos = start + k ∧ specs[k]? = some (SegReleaseSpec.tracked wF) ∧
              part.1[k]? = some (SegReleaseSpec.tracked wF)) ∧
            execProtectorEndAccessFor protectorEndAccessIsWrite? wF (tagOf tag) = .error e ∧
            res.2.locations.entries[failPos]? = some segF' ∧
            ({ tree with locations := ⟨#[segF]⟩ } : Miri.TreeBorrows.BorrowTree).releaseProtector tag pt =
              ⟨{ tree with locations := ⟨#[segF']⟩ }, .AccessFailure segF.range errSt⟩) ∧
        (∀ (k : Nat) seg' spec', start + k < failPos →
          res.2.locations.entries[start + k]? = some seg' →
          part.1[k]? = some spec' →
          SegReleaseRel pt frameTag tagOf tree source seg' spec' ∧
          (specs[k]? = some SegReleaseSpec.skipped →
            res.2.locations.entries[start + k]? = locsCur.entries[start + k]?)) ∧
        (∀ (j : Nat), failPos < j → res.2.locations.entries[j]? = locsCur.entries[j]?)
      | _, _ => False := by
  intro remLen
  induction remLen with
  | zero =>
    intro start hsum locsCur hszCur specs hspecsLen hrel
    cases specs with
    | nil =>
      refine ⟨rfl, rfl, rfl, hszCur, fun _ => rfl, fun _ _ => rfl,
        fun _ _ _ _ hsp => by cases hsp⟩
    | cons _ _ => cases hspecsLen
  | succ m ih =>
    intro start hsum locsCur hszCur specs hspecsLen hrel
    cases specs with
    | nil => cases hspecsLen
    | cons spec rest =>
      have hstartLt : start < locsCur.entries.size := by omega
      have hidxStart : locsCur.index start = .ok locsCur.entries[start] :=
        Miri.TreeBorrows.BorrowTree.ZeroProtection.Release.index_exact locsCur start hstartLt
      have hsegStart : locsCur.entries[start]? = some locsCur.entries[start] :=
        Array.getElem?_eq_getElem hstartLt
      have hspecRel : SegReleaseRel pt frameTag tagOf tree source locsCur.entries[start] spec :=
        hrel 0 locsCur.entries[start] spec (by simp only [Nat.add_zero]; exact hsegStart) rfl
      have hrestLen : rest.length = m := Nat.succ.inj hspecsLen
      dsimp only
      rw [List.range'_succ, List.forIn_cons]
      cases spec with
      | skipped =>
        have hstep : releaseProtectorLoopStep source pt start
            (none, { tree with locations := locsCur }) =
            .yield (none, { tree with locations := locsCur }) := by
          unfold releaseProtectorLoopStep
          dsimp only
          rw [hidxStart]
          dsimp only
          unfold SegReleaseRel at hspecRel
          cases hget : locsCur.entries[start].data.perms.get source with
          | none => rfl
          | some st =>
            dsimp only
            rw [hget] at hspecRel
            cases hassoc : st.permission.associatedAccess with
            | none => rfl
            | some kind =>
              dsimp only
              rcases hspecRel with haccF | hcontra
              · simp only [haccF, Bool.false_eq_true, ↓reduceIte]
              · rw [hassoc] at hcontra; cases hcontra
        rw [hstep]
        dsimp only [bind, Bind.bind, multiSegEndAccessPartialGo]
        have hrec := ih (start + 1) (by omega) locsCur hszCur rest hrestLen (fun k seg sp h1 h2 =>
          hrel (k + 1) seg sp (by rwa [show start + (k + 1) = start + 1 + k by omega]) h2)
        dsimp only at hrec
        rcases hrec with ⟨htm, hnd', hrt, hsz', hrng, hpre, hmatch⟩
        refine ⟨htm, hnd', hrt, hsz', hrng, fun j hj => hpre j (by omega), ?_⟩
        cases hres1 : (forIn (m := Id) (List.range' (start + 1) m)
            (none, ({ tree with locations := locsCur } : Miri.TreeBorrows.BorrowTree))
            (releaseProtectorLoopStep source pt) :
              Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree).1 with
        | none =>
          rw [hres1] at hmatch
          cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
          | some fp => rw [hfail] at hmatch; exact False.elim hmatch
          | none =>
            rw [hfail] at hmatch
            intro k seg' sp' hseg' hsp'
            cases k with
            | zero =>
              have hsp0 : sp' = .skipped := Option.some.inj hsp'.symm
              subst hsp0
              have heq0 : (forIn (m := Id) (List.range' (start + 1) m)
                  (none, ({ tree with locations := locsCur } : Miri.TreeBorrows.BorrowTree))
                  (releaseProtectorLoopStep source pt) :
                    Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree).2.locations.entries[start]? =
                  locsCur.entries[start]? := hpre start (Nat.lt_succ_self start)
              simp only [Nat.add_zero] at hseg' ⊢
              rw [heq0, hsegStart] at hseg'
              injection hseg' with hsegEq; subst hsegEq
              exact ⟨hspecRel, fun _ => heq0⟩
            | succ k' =>
              have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
              rw [hidxEq] at hseg' ⊢
              exact hmatch k' seg' sp' hseg' hsp'
        | some failRes =>
          rw [hres1] at hmatch
          cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
          | none => rw [hfail] at hmatch; exact False.elim hmatch
          | some fp =>
            rw [hfail] at hmatch
            rcases hmatch with ⟨hft, hle, hlt, ⟨segF, errSt, hsf, hstF, wF, eF, segF',
              ⟨k', hk1, hk2, hk3⟩, hexF, hentF, hsingF⟩, hpref, htail⟩
            refine ⟨hft, by omega, hlt, ⟨segF, errSt, hsf, hstF, wF, eF, segF',
              ⟨k' + 1, by omega, hk2, hk3⟩, hexF, hentF, hsingF⟩, ?_, htail⟩
            intro k seg' sp' hltFp hseg' hsp'
            cases k with
            | zero =>
              have hsp0 : sp' = .skipped := Option.some.inj hsp'.symm
              subst hsp0
              have heq0 := hpre start (Nat.lt_succ_self start)
              simp only [Nat.add_zero] at hseg' ⊢
              rw [heq0, hsegStart] at hseg'
              injection hseg' with hsegEq; subst hsegEq
              exact ⟨hspecRel, fun _ => heq0⟩
            | succ k' =>
              have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
              rw [hidxEq] at hltFp hseg' ⊢
              exact hpref k' seg' sp' hltFp hseg' hsp'
      | tracked w =>
        let seg0 := locsCur.entries[start]
        let t1 : Miri.TreeBorrows.BorrowTree := { tree with locations := ⟨#[seg0]⟩ }
        have hsim1 := (realAccessReleaseSim pt frameTag tagOf).step t1 w tag ht hspecRel
        have hsingle := releaseProtector_singleSeg_step_eq tree tag source nd pt seg0 htag hnd hexp
        dsimp only at hsingle
        have hstepEq :
            (let acc? : Option (Miri.TreeBorrows.LocationTree × Option Miri.TreeBorrows.BorrowTree.BorrowTreeAccessStatus) :=
              match seg0.data.perms.get source with
              | none => none
              | some st =>
                match st.permission.associatedAccess with
                | none => none
                | some kind =>
                  if st.accessed then
                    let acc := miriPerformTreeAccessAt tree seg0.data (some source) kind pt .SkipChildrenOfAccessed seg0.range
                    some ((miri_etm_private% Miri.TreeBorrows.TreeState
                            Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location) acc,
                          (miri_etm_private% Miri.TreeBorrows.TreeState
                            Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status) acc)
                  else none
            match acc? with
            | none =>
              t1.releaseProtector tag pt = ⟨t1, .Released⟩ ∧
              releaseProtectorLoopStep source pt start (none, { tree with locations := locsCur }) =
                .yield (none, { tree with locations := locsCur })
            | some (loc', none) =>
              t1.releaseProtector tag pt = ⟨{ tree with locations := ⟨#[{ seg0 with data := loc' }]⟩ }, .Released⟩ ∧
              releaseProtectorLoopStep source pt start (none, { tree with locations := locsCur }) =
                .yield (none, { tree with locations := ⟨locsCur.entries.set start { seg0 with data := loc' } hstartLt⟩ })
            | some (loc', some errSt) =>
              t1.releaseProtector tag pt = ⟨{ tree with locations := ⟨#[{ seg0 with data := loc' }]⟩ }, .AccessFailure seg0.range errSt⟩ ∧
              releaseProtectorLoopStep source pt start (none, { tree with locations := locsCur }) =
                .done (some ⟨{ tree with locations := ⟨locsCur.entries.set start { seg0 with data := loc' } hstartLt⟩ },
                             .AccessFailure seg0.range errSt⟩,
                       { tree with locations := ⟨locsCur.entries.set start { seg0 with data := loc' } hstartLt⟩ })) := by
          unfold releaseProtectorLoopStep
          dsimp only
          rw [hidxStart, hsingle]
          dsimp only [seg0]
          cases hget : locsCur.entries[start].data.perms.get source with
          | none => exact ⟨rfl, rfl⟩
          | some st =>
            dsimp only
            cases hassoc : st.permission.associatedAccess with
            | none => exact ⟨rfl, rfl⟩
            | some kind =>
              dsimp only
              cases haccB : st.accessed with
              | false => simp only [Bool.false_eq_true, ↓reduceIte]; exact ⟨rfl, trivial⟩
              | true =>
                simp only [↓reduceIte]
                have hind := performTreeAccessAt_locations_indep tree locsCur tree.locations
                  locsCur.entries[start].data (some source) kind pt .SkipChildrenOfAccessed
                  locsCur.entries[start].range
                have htreeEq : ({ tree with locations := tree.locations } : Miri.TreeBorrows.BorrowTree) = tree := rfl
                rw [htreeEq] at hind
                rw [hind]
                have hset := dedupRangeMap_setAtPos_exact locsCur start hstartLt
                  ((miri_etm_private% Miri.TreeBorrows.TreeState
                    Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location)
                    (miriPerformTreeAccessAt tree locsCur.entries[start].data (some source) kind pt
                      .SkipChildrenOfAccessed locsCur.entries[start].range))
                rw [hset]
                dsimp only
                cases ((miri_etm_private% Miri.TreeBorrows.TreeState
                    Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status)
                    (miriPerformTreeAccessAt tree locsCur.entries[start].data (some source) kind pt
                      .SkipChildrenOfAccessed locsCur.entries[start].range)) with
                | none => exact ⟨rfl, rfl⟩
                | some errSt => exact ⟨rfl, rfl⟩
        dsimp only at hstepEq
        generalize (match seg0.data.perms.get source with
          | none => none
          | some st =>
            match st.permission.associatedAccess with
            | none => none
            | some kind =>
              if st.accessed then
                let acc := miriPerformTreeAccessAt tree seg0.data (some source) kind pt .SkipChildrenOfAccessed seg0.range
                some ((miri_etm_private% Miri.TreeBorrows.TreeState
                        Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.location) acc,
                      (miri_etm_private% Miri.TreeBorrows.TreeState
                        Miri.TreeBorrows.BorrowTree.TreeLocationAccessAtResult.status) acc)
              else none) = accOpt at hstepEq
        rcases accOpt with _ | ⟨loc', _ | errSt⟩
        · rcases hstepEq with ⟨ht1Rel, hloop⟩
          rw [ht1Rel] at hsim1
          simp only [stackPopReleaseErr] at hsim1
          cases hexec : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | error e => rw [hexec] at hsim1; exact False.elim hsim1
          | ok w' =>
            rw [hexec] at hsim1
            rw [hloop]
            dsimp only [bind, Bind.bind, multiSegEndAccessPartialGo]
            rw [hexec]
            dsimp only
            have hrec := ih (start + 1) (by omega) locsCur hszCur rest hrestLen (fun k seg sp h1 h2 =>
              hrel (k + 1) seg sp (by rwa [show start + (k + 1) = start + 1 + k by omega]) h2)
            dsimp only at hrec
            rcases hrec with ⟨htm, hnd', hrt, hsz', hrng, hpre, hmatch⟩
            refine ⟨htm, hnd', hrt, hsz', hrng, fun j hj => hpre j (by omega), ?_⟩
            cases hres1 : (forIn (m := Id) (List.range' (start + 1) m)
                (none, ({ tree with locations := locsCur } : Miri.TreeBorrows.BorrowTree))
                (releaseProtectorLoopStep source pt) :
                  Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree).1 with
            | none =>
              rw [hres1] at hmatch
              cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
              | some fp => rw [hfail] at hmatch; exact False.elim hmatch
              | none =>
                rw [hfail] at hmatch
                intro k seg' sp' hseg' hsp'
                cases k with
                | zero =>
                  have hsp0 : sp' = .tracked w' := Option.some.inj hsp'.symm
                  subst hsp0
                  have heq0 := hpre start (Nat.lt_succ_self start)
                  simp only [Nat.add_zero] at hseg' ⊢
                  rw [heq0, hsegStart] at hseg'
                  injection hseg' with hsegEq; subst hsegEq
                  exact ⟨hsim1, fun h => by cases h⟩
                | succ k' =>
                  have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
                  rw [hidxEq] at hseg' ⊢
                  exact hmatch k' seg' sp' hseg' hsp'
            | some failRes =>
              rw [hres1] at hmatch
              cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
              | none => rw [hfail] at hmatch; exact False.elim hmatch
              | some fp =>
                rw [hfail] at hmatch
                rcases hmatch with ⟨hft, hle, hlt, ⟨segF, errStF, hsf, hstF, wF, eF, segF',
                  ⟨k', hk1, hk2, hk3⟩, hexF, hentF, hsingF⟩, hpref, htail⟩
                refine ⟨hft, by omega, hlt, ⟨segF, errStF, hsf, hstF, wF, eF, segF',
                  ⟨k' + 1, by omega, hk2, hk3⟩, hexF, hentF, hsingF⟩, ?_, htail⟩
                intro k seg' sp' hltFp hseg' hsp'
                cases k with
                | zero =>
                  have hsp0 : sp' = .tracked w' := Option.some.inj hsp'.symm
                  subst hsp0
                  have heq0 := hpre start (Nat.lt_succ_self start)
                  simp only [Nat.add_zero] at hseg' ⊢
                  rw [heq0, hsegStart] at hseg'
                  injection hseg' with hsegEq; subst hsegEq
                  exact ⟨hsim1, fun h => by cases h⟩
                | succ k' =>
                  have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
                  rw [hidxEq] at hltFp hseg' ⊢
                  exact hpref k' seg' sp' hltFp hseg' hsp'
        · rcases hstepEq with ⟨ht1Rel, hloop⟩
          rw [ht1Rel] at hsim1
          simp only [stackPopReleaseErr] at hsim1
          cases hexec : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | error e => rw [hexec] at hsim1; exact False.elim hsim1
          | ok w' =>
            rw [hexec] at hsim1
            rw [hloop]
            dsimp only [bind, Bind.bind, multiSegEndAccessPartialGo]
            rw [hexec]
            dsimp only
            let locsNext : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree :=
              ⟨locsCur.entries.set start { seg0 with data := loc' } hstartLt⟩
            have hszNext : locsNext.entries.size = tree.locations.entries.size := by
              simp [locsNext, hszCur]
            have hnextAt : ∀ (j : Nat), j ≠ start → locsNext.entries[j]? = locsCur.entries[j]? := by
              intro j hj
              simp only [locsNext]
              by_cases hjb : j < locsCur.entries.size
              · rw [Array.getElem?_eq_getElem (by simpa using hjb), Array.getElem?_eq_getElem hjb,
                  Array.getElem_set_ne hstartLt hjb (Ne.symm hj)]
              · rw [Array.getElem?_eq_none (by simpa using Nat.le_of_not_lt hjb),
                  Array.getElem?_eq_none (Nat.le_of_not_lt hjb)]
            have hnextSelf : locsNext.entries[start]? = some { seg0 with data := loc' } := by
              dsimp only [locsNext]
              rw [Array.getElem?_eq_getElem (by simpa using hstartLt), Array.getElem_set_self]
            have hnextRng : ∀ (j : Nat), (locsNext.entries[j]?).map (·.range) = (locsCur.entries[j]?).map (·.range) := by
              intro j
              by_cases hj : j = start
              · subst hj; rw [hnextSelf, hsegStart]; rfl
              · rw [hnextAt j hj]
            have hrec := ih (start + 1) (by omega) locsNext hszNext rest hrestLen (fun k seg sp h1 h2 => by
              rw [hnextAt (start + 1 + k) (by omega)] at h1
              exact hrel (k + 1) seg sp (by rwa [show start + (k + 1) = start + 1 + k by omega]) h2)
            dsimp only at hrec
            rcases hrec with ⟨htm, hnd', hrt, hsz', hrng, hpre, hmatch⟩
            refine ⟨htm, hnd', hrt, hsz', fun j => (hrng j).trans (hnextRng j),
              fun j hj => (hpre j (by omega)).trans (hnextAt j (by omega)), ?_⟩
            cases hres1 : (forIn (m := Id) (List.range' (start + 1) m)
                (none, ({ tree with locations := locsNext } : Miri.TreeBorrows.BorrowTree))
                (releaseProtectorLoopStep source pt) :
                  Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree).1 with
            | none =>
              rw [hres1] at hmatch
              cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
              | some fp => rw [hfail] at hmatch; exact False.elim hmatch
              | none =>
                rw [hfail] at hmatch
                intro k seg' sp' hseg' hsp'
                cases k with
                | zero =>
                  have hsp0 : sp' = .tracked w' := Option.some.inj hsp'.symm
                  subst hsp0
                  have heq0 := hpre start (Nat.lt_succ_self start)
                  simp only [Nat.add_zero] at hseg' ⊢
                  rw [heq0, hnextSelf] at hseg'
                  injection hseg' with hsegEq; subst hsegEq
                  exact ⟨hsim1, fun h => by cases h⟩
                | succ k' =>
                  have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
                  rw [hidxEq] at hseg' ⊢
                  obtain ⟨hR', hsk'⟩ := hmatch k' seg' sp' hseg' hsp'
                  exact ⟨hR', fun hs => (hsk' hs).trans (hnextAt (start + 1 + k') (by omega))⟩
            | some failRes =>
              rw [hres1] at hmatch
              cases hfail : (multiSegEndAccessPartialGo (tagOf tag) (start + 1) rest).2 with
              | none => rw [hfail] at hmatch; exact False.elim hmatch
              | some fp =>
                rw [hfail] at hmatch
                rcases hmatch with ⟨hft, hle, hlt, ⟨segF, errStF, hsf, hstF, wF, eF, segF',
                  ⟨k', hk1, hk2, hk3⟩, hexF, hentF, hsingF⟩, hpref, htail⟩
                rw [hnextAt fp (by omega)] at hsf
                refine ⟨hft, by omega, hlt, ⟨segF, errStF, hsf, hstF, wF, eF, segF',
                  ⟨k' + 1, by omega, hk2, hk3⟩, hexF, hentF, hsingF⟩, ?_,
                  fun j hj => (htail j hj).trans (hnextAt j (by omega))⟩
                intro k seg' sp' hltFp hseg' hsp'
                cases k with
                | zero =>
                  have hsp0 : sp' = .tracked w' := Option.some.inj hsp'.symm
                  subst hsp0
                  have heq0 := hpre start (Nat.lt_succ_self start)
                  simp only [Nat.add_zero] at hseg' ⊢
                  rw [heq0, hnextSelf] at hseg'
                  injection hseg' with hsegEq; subst hsegEq
                  exact ⟨hsim1, fun h => by cases h⟩
                | succ k' =>
                  have hidxEq : start + (k' + 1) = start + 1 + k' := by omega
                  rw [hidxEq] at hltFp hseg' ⊢
                  obtain ⟨hR', hsk'⟩ := hpref k' seg' sp' hltFp hseg' hsp'
                  exact ⟨hR', fun hs => (hsk' hs).trans (hnextAt (start + 1 + k') (by omega))⟩
        · rcases hstepEq with ⟨ht1Rel, hloop⟩
          rw [ht1Rel] at hsim1
          simp only [stackPopReleaseErr] at hsim1
          cases hexec : execProtectorEndAccessFor protectorEndAccessIsWrite? w (tagOf tag) with
          | ok w' => rw [hexec] at hsim1; exact False.elim hsim1
          | error e =>
            rw [hloop]
            dsimp only [bind, Bind.bind, pure, Pure.pure, multiSegEndAccessPartialGo]
            rw [hexec]
            dsimp only
            have hnextAt : ∀ (j : Nat), j ≠ start →
                (locsCur.entries.set start { seg0 with data := loc' } hstartLt)[j]? =
                  locsCur.entries[j]? := by
              intro j hj
              by_cases hjb : j < locsCur.entries.size
              · rw [Array.getElem?_eq_getElem (by simpa using hjb), Array.getElem?_eq_getElem hjb,
                  Array.getElem_set_ne hstartLt hjb (Ne.symm hj)]
              · rw [Array.getElem?_eq_none (by simpa using Nat.le_of_not_lt hjb),
                  Array.getElem?_eq_none (Nat.le_of_not_lt hjb)]
            have hnextRng : ∀ (j : Nat),
                ((locsCur.entries.set start { seg0 with data := loc' } hstartLt)[j]?).map (·.range) =
                  (locsCur.entries[j]?).map (·.range) := by
              intro j
              by_cases hj : j = start
              · subst hj
                rw [Array.getElem?_eq_getElem (by simpa using hstartLt), Array.getElem_set_self, hsegStart]
                rfl
              · rw [hnextAt j hj]
            refine ⟨rfl, rfl, rfl, by simp [hszCur], hnextRng, fun j hj => hnextAt j (by omega),
              rfl, Nat.le_refl _, by omega,
              ⟨seg0, errSt, hsegStart, rfl, w, e, { seg0 with data := loc' }, ⟨0, rfl, rfl, rfl⟩, hexec,
                by rw [Array.getElem?_eq_getElem (by simpa using hstartLt), Array.getElem_set_self],
                ht1Rel⟩,
              fun k _ _ hlt => by omega, fun j hj => hnextAt j (by omega)⟩

/-- **Multi-segment `BorrowTree.releaseProtector` per-segment simulation with exact failure pinning
(`lean-miri#74`)**: lifts single-segment `realAccessReleaseSim` to a `k`-segment `DedupRangeMap`.

**Scope (exact).** The released tag is present and UNEXPOSED (`hexp`; the exposed-tag
`updateExposureForProtectorRelease` pass is not covered), and EVERY segment is classified by
`specs` as either `.skipped` (the released tag is unmaterialized, unaccessed, or has no associated
access there — a per-TAG notion) or `.tracked w` (its single-segment slice satisfies the
single-segment `BorrowTreeWorldRel` against its own theory world `w`; the theory side is one
`FnEntryBorrowWorld` PER SEGMENT, and `BorrowTreeWorldRel` does not tie `w`'s uniform node range to
the segment's `ByteRange`). Under these hypotheses:
1. `tagMapping`, `nodes`, `roots`, `locations.entries.size`, and every segment's `.range` are
   preserved (in this scope `releaseProtector` neither splits nor coalesces segments; this is NOT
   claimed for exposed tags);
2. on full success (`.Released` / `none`), every tracked segment satisfies `BorrowTreeWorldRel`
   against its stepped world and every `.skipped` segment is unchanged;
3. on failure (`.AccessFailure range errSt` / `some failPos`), both sides stop at the SAME segment
   `failPos` with `entries[failPos].range = range`; prefix segments `k < failPos` retain their
   stepped worlds (or are unchanged if `.skipped`); suffix segments `j > failPos` are untouched; and
   the failing segment is pinned EXACTLY: its spec is `.tracked wF`, the theory step on `wF` fails,
   the theory-side spec list is unchanged at `failPos`, and the vendored segment retained at
   `failPos` is precisely the one produced by the single-segment release of that segment (the
   partial, failed access IS committed), with the same `.AccessFailure range errSt` status.
This theorem is per-allocation and per-tag. It is lifted to frame exit only for single-protector
frames (`miri_beforeStackPopWithEnsure_multiSeg_singleProtector_partial_sim`); it is not packaged as
a `ProtectorReleaseSim` instance, so the multi-allocation / multi-protector frame-pop simulations
remain stated for single-segment trees. -/
theorem miri_releaseProtector_multiSeg_partial_sim
    (tree : Miri.TreeBorrows.BorrowTree) (tag : Miri.Memory.BorTag)
    (source : Miri.TreeBorrows.UniIndex) (nd : Miri.TreeBorrows.TreeNode)
    (pt : Miri.TreeBorrows.ProtectedTags)
    (frameTag : Miri.Memory.BorTag → Prop) (tagOf : Miri.Memory.BorTag → Nat)
    (specs : List SegReleaseSpec)
    (htag : tree.indexOfTag tag = some source)
    (hnd : tree.nodeAt source = some nd)
    (hexp : nd.isExposed = false)
    (ht : frameTag tag)
    (hlen : specs.length = tree.locations.entries.size)
    (hrel : ∀ (k : Nat) seg spec, tree.locations.entries[k]? = some seg → specs[k]? = some spec →
      SegReleaseRel pt frameTag tagOf tree source seg spec) :
    let res := tree.releaseProtector tag pt
    let part := multiSegEndAccessPartial (tagOf tag) specs
    res.tree.tagMapping = tree.tagMapping ∧
    res.tree.nodes = tree.nodes ∧
    res.tree.roots = tree.roots ∧
    res.tree.locations.entries.size = tree.locations.entries.size ∧
    (∀ (j : Nat), (res.tree.locations.entries[j]?).map (·.range) =
          (tree.locations.entries[j]?).map (·.range)) ∧
    match res.status, part.2 with
    | .Released, none =>
      ∀ (k : Nat) seg' spec',
        res.tree.locations.entries[k]? = some seg' →
        part.1[k]? = some spec' →
        SegReleaseRel pt frameTag tagOf tree source seg' spec' ∧
        (specs[k]? = some SegReleaseSpec.skipped →
          res.tree.locations.entries[k]? = tree.locations.entries[k]?)
    | .AccessFailure range errSt, some failPos =>
      failPos < tree.locations.entries.size ∧
      (tree.locations.entries[failPos]?).map (·.range) = some range ∧
      (∀ (k : Nat) seg' spec', k < failPos →
        res.tree.locations.entries[k]? = some seg' →
        part.1[k]? = some spec' →
        SegReleaseRel pt frameTag tagOf tree source seg' spec' ∧
        (specs[k]? = some SegReleaseSpec.skipped →
          res.tree.locations.entries[k]? = tree.locations.entries[k]?)) ∧
      (∀ (j : Nat), failPos < j → res.tree.locations.entries[j]? = tree.locations.entries[j]?) ∧
      ∃ segF wF e segF',
        tree.locations.entries[failPos]? = some segF ∧
        specs[failPos]? = some (SegReleaseSpec.tracked wF) ∧
        part.1[failPos]? = some (SegReleaseSpec.tracked wF) ∧
        execProtectorEndAccessFor protectorEndAccessIsWrite? wF (tagOf tag) = .error e ∧
        res.tree.locations.entries[failPos]? = some segF' ∧
        ({ tree with locations := ⟨#[segF]⟩ } : Miri.TreeBorrows.BorrowTree).releaseProtector tag pt =
          ⟨{ tree with locations := ⟨#[segF']⟩ }, .AccessFailure range errSt⟩
    | _, _ => False := by
  have hloop := releaseProtector_multiSeg_loop_sim tree tag source nd pt frameTag tagOf
    htag hnd hexp ht tree.locations.entries.size 0 (Nat.zero_add _) tree.locations rfl specs hlen
    (fun k seg sp h1 h2 => hrel k seg sp (by simpa [Nat.zero_add] using h1) h2)
  dsimp only at hloop
  rcases hloop with ⟨htm, hnd', hrt, hsz', hrng, _, hmatch⟩
  have hexpAll : ∀ t : Miri.TreeBorrows.BorrowTree,
      t.tagMapping = tree.tagMapping → t.nodes = tree.nodes →
      t.updateExposureForProtectorRelease tag = ⟨t, .ok ()⟩ := by
    intro t h1 h2
    unfold Miri.TreeBorrows.BorrowTree.updateExposureForProtectorRelease
    have ht' : t.indexOfTag tag = some source := by
      unfold Miri.TreeBorrows.BorrowTree.indexOfTag; rw [h1]; exact htag
    have hn' : t.nodeAt source = some nd := by
      unfold Miri.TreeBorrows.BorrowTree.nodeAt; rw [h2]; exact hnd
    simp [ht', hn', hexp, Id.run, pure]
  dsimp only [multiSegEndAccessPartial]
  rw [releaseProtector_eq_forIn_step tree tag source pt htag]
  have htreeEq : ({ tree with locations := tree.locations } : Miri.TreeBorrows.BorrowTree) = tree := rfl
  rw [htreeEq] at htm hnd' hrt hsz' hrng hmatch
  generalize (forIn (m := Id) (List.range' 0 tree.locations.entries.size) (none, tree)
    (releaseProtectorLoopStep source pt) :
      Option Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult × Miri.TreeBorrows.BorrowTree) =
    loopRes at htm hnd' hrt hsz' hrng hmatch ⊢
  rcases loopRes with ⟨lr1, lr2⟩
  dsimp only at htm hnd' hrt hsz' hrng hmatch ⊢
  cases lr1 with
  | none =>
    cases h2 : (multiSegEndAccessPartialGo (tagOf tag) 0 specs).2 with
    | some fp => rw [h2] at hmatch; exact False.elim hmatch
    | none =>
      rw [h2] at hmatch
      dsimp only
      rw [hexpAll lr2 htm hnd']
      refine ⟨htm, hnd', hrt, hsz', hrng, ?_⟩
      simpa [Nat.zero_add] using hmatch
  | some failRes =>
    cases h2 : (multiSegEndAccessPartialGo (tagOf tag) 0 specs).2 with
    | none => rw [h2] at hmatch; exact False.elim hmatch
    | some fp =>
      rw [h2] at hmatch
      rcases hmatch with ⟨hft, _, hlt, ⟨segF, errSt, hsf, hstF, wF, eF, segF',
        ⟨k, hk1, hk2, hk3⟩, hexF, hentF, hsingF⟩, hpref, htail⟩
      have hk : k = fp := by omega
      subst hk
      dsimp only
      rw [hstF, hft]
      refine ⟨htm, hnd', hrt, hsz', hrng, hlt, by rw [hsf]; rfl, ?_, htail,
        segF, wF, eF, segF', hsf, hk2, hk3, hexF, hentF, hsingF⟩
      simpa [Nat.zero_add] using hpref

/-- **Multi-segment frame exit for a single-protector frame (`lean-miri#74`)**: lifts
`miri_releaseProtector_multiSeg_partial_sim` through `MachineHooks.beforeStackPopWithEnsure` for a
frame whose protector list is exactly `[(id, tag)]` and whose protected allocation `id` carries a
`k`-segment borrow tree classified by `specs` (same scope as the per-segment theorem: unexposed
released tag, every segment `.skipped` or `.tracked`). The vendored frame pop and the theory's
per-segment prefix fold `multiSegEndAccessPartial` agree on success vs failure:
* both succeed: the release status is `.Released` and the popped state is exactly the tree
  write-back plus `endCall`;
* both fail: the frame pop raises exactly the release's access error, `endCall` does not run, and
  the failure state commits the partially released tree (whose per-segment content is described by
  `miri_releaseProtector_multiSeg_partial_sim`).
Frames with several protectors over multi-segment trees are not covered (the `.skipped`
classification is per released tag). -/
theorem miri_beforeStackPopWithEnsure_multiSeg_singleProtector_partial_sim
    {K User : Type} [DecidableEq K]
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (id : Miri.Memory.AllocId) (tag : Miri.Memory.BorTag)
    (entry : Miri.Memory.LocalAllocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
    (source : Miri.TreeBorrows.UniIndex) (nd : Miri.TreeBorrows.TreeNode)
    (frameTag : Miri.Memory.BorTag → Prop) (tagOf : Miri.Memory.BorTag → Nat)
    (specs : List SegReleaseSpec)
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨#[(id, tag)]⟩)
    (hfind : st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry))
    (htag : entry.allocation.extra.indexOfTag tag = some source)
    (hnd : entry.allocation.extra.nodeAt source = some nd)
    (hexp : nd.isExposed = false)
    (ht : frameTag tag)
    (hlen : specs.length = entry.allocation.extra.locations.entries.size)
    (hrel : ∀ (k : Nat) seg spec, entry.allocation.extra.locations.entries[k]? = some seg →
      specs[k]? = some spec →
      SegReleaseRel tracker.global.protectedTags frameTag tagOf entry.allocation.extra source seg spec) :
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st,
        (multiSegEndAccessPartial (tagOf tag) specs).2 with
    | .ok () st', none =>
      (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).status = .Released ∧
      st' = { st with machine := { st.machine with
        memory := stackPopWriteBack st.machine.memory id entry
          (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).tree
        borrowTracker := some { tracker with global := tracker.global.endCall ⟨#[(id, tag)]⟩ } } }
    | .error err st', some _ =>
      stackPopReleaseErr
        (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).status =
          some (some err) ∧
      st' = stackPopWithMemory st (stackPopWriteBack st.machine.memory id entry
        (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).tree)
    | _, _ => False := by
  have hms := miri_releaseProtector_multiSeg_partial_sim entry.allocation.extra tag source nd
    tracker.global.protectedTags frameTag tagOf specs htag hnd hexp ht hlen hrel
  dsimp only at hms
  obtain ⟨_, _, _, _, _, hmatch⟩ := hms
  cases hst : (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).status with
  | Released =>
    rw [hst] at hmatch
    have hall : stackPopReleaseAll tracker.global.protectedTags [(id, tag)] st.machine.memory =
        some (stackPopWriteBack st.machine.memory id entry
          (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).tree, none) := by
      simp only [stackPopReleaseAll, hfind, hst, stackPopReleaseErr]
    rw [miri_beforeStackPopWithEnsure_eq_releaseAll st tracker frame #[(id, tag)] htracker hframe hbf
      _ none hall]
    cases hp : (multiSegEndAccessPartial (tagOf tag) specs).2 with
    | none => exact ⟨rfl, rfl⟩
    | some fp => rw [hp] at hmatch; exact False.elim hmatch
  | AccessFailure range errSt =>
    rw [hst] at hmatch
    have hall : stackPopReleaseAll tracker.global.protectedTags [(id, tag)] st.machine.memory =
        some (stackPopWriteBack st.machine.memory id entry
          (entry.allocation.extra.releaseProtector tag tracker.global.protectedTags).tree,
          some (miriBorrowAccessError errSt)) := by
      simp only [stackPopReleaseAll, hfind, hst, stackPopReleaseErr]
    rw [miri_beforeStackPopWithEnsure_eq_releaseAll st tracker frame #[(id, tag)] htracker hframe hbf
      _ (some (miriBorrowAccessError errSt)) hall]
    cases hp : (multiSegEndAccessPartial (tagOf tag) specs).2 with
    | none => rw [hp] at hmatch; exact False.elim hmatch
    | some fp => exact ⟨rfl, rfl⟩
  | MissingTag _ => rw [hst] at hmatch; exact False.elim hmatch
  | RangeMapFailure _ => rw [hst] at hmatch; exact False.elim hmatch
  | LocationMapFailure _ => rw [hst] at hmatch; exact False.elim hmatch
  | ExposureUpdateFailure _ => rw [hst] at hmatch; exact False.elim hmatch

private theorem stackPopReleaseAll_frame_preserved {K : Type}
    (pt : Miri.TreeBorrows.ProtectedTags)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag)) :
    ∀ (mem mem' : Miri.Memory.MemoryState Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree K)
      (res : Option Miri.Interpreter.StepError),
      stackPopReleaseAll pt prots mem = some (mem', res) →
      mem'.nextAllocId = mem.nextAllocId ∧
      mem'.globals = mem.globals ∧
      mem'.dead = mem.dead ∧
      mem'.issuedIds = mem.issuedIds ∧
      mem'.sourceAllocIdWorldActive = mem.sourceAllocIdWorldActive ∧
      mem'.idSupplyExhausted = mem.idSupplyExhausted ∧
      ∀ id, (∀ p ∈ prots, p.1 ≠ id) →
        mem'.live.find? (fun e => e.1 == id) = mem.live.find? (fun e => e.1 == id) := by
  induction prots with
  | nil =>
    intro mem mem' res h
    injection h with hEq; injection hEq with hm _
    subst hm
    exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, fun _ _ => rfl⟩
  | cons p rest ih =>
    intro mem mem' res h
    obtain ⟨pid, ptag⟩ := p
    cases hf : mem.live.find? (fun e => e.1 == pid) with
    | none => simp only [stackPopReleaseAll, hf] at h; cases h
    | some pair =>
      simp only [stackPopReleaseAll, hf] at h
      cases hE : stackPopReleaseErr (pair.2.allocation.extra.releaseProtector ptag pt).status with
      | none => rw [hE] at h; cases h
      | some r =>
        rw [hE] at h
        have hwbFind : ∀ id, id ≠ pid →
            (stackPopWriteBack mem pid pair.2 (pair.2.allocation.extra.releaseProtector ptag pt).tree).live.find?
              (fun e => e.1 == id) = mem.live.find? (fun e => e.1 == id) := fun id hne => by
          unfold stackPopWriteBack
          exact find?_filter_push_ne mem.live pid id _ hne
        cases r with
        | some err =>
          injection h with hEq; injection hEq with hm _
          subst hm
          exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, fun id hnot => hwbFind id (Ne.symm (hnot (pid, ptag) List.mem_cons_self))⟩
        | none =>
          obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := ih _ mem' res h
          refine ⟨h1, h2, h3, h4, h5, h6, fun id hnot => ?_⟩
          exact (h7 id (fun q hq => hnot q (List.mem_cons_of_mem _ hq))).trans
            (hwbFind id (Ne.symm (hnot (pid, ptag) List.mem_cons_self)))

/-- **Real-access `MachineHooks.beforeStackPopWithEnsure` partial simulation with full memory/machine
frame preservation (`lean-miri#74`)**: directly instantiates
`miri_beforeStackPopWithEnsure_multiAlloc_partial_simulates` to `realAccessReleaseSim` and adds full
frame invariants (`nextAllocId`, `globals`, `dead`, `issuedIds`, `sourceAllocIdWorldActive`,
`idSupplyExhausted`, `raceAllocations`, and every live allocation outside `prots`) on BOTH clean
completion and mid-sequence UB short-circuiting. -/
theorem miri_beforeStackPopWithEnsure_realAccess_multiAlloc_partial_sim
    {K User : Type} [DecidableEq K]
    (st : Miri.Interpreter.MachineHooks.State K User)
    (tracker : Miri.Interpreter.MachineHooks.BorrowState)
    (frame : Miri.Interpreter.Frame Miri.Memory.Provenance Miri.Interpreter.LocalLayout
      Miri.Interpreter.MachineHooks.FrameExtra)
    (prots : List (Miri.Memory.AllocId × Miri.Memory.BorTag))
    (htracker : st.machine.borrowTracker = some tracker)
    (hframe : st.stack.currentFrame? = some frame)
    (hbf : frame.extra.borrowTracker = some ⟨prots.toArray⟩)
    (frameTag : Miri.Memory.AllocId → Miri.Memory.BorTag → Prop)
    (tagOf : Miri.Memory.BorTag → Nat)
    (hprots : ∀ p ∈ prots, frameTag p.1 p.2)
    (worlds : Miri.Memory.AllocId → Option FnEntryBorrowWorld)
    (hsync : ∀ id w, worlds id = some w →
      ∃ entry, st.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry) ∧
        BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf
          entry.allocation.extra w)
    (hdom : ∀ p ∈ prots, (worlds p.1).isSome = true) :
    let framePreserved (st' : Miri.Interpreter.MachineHooks.State K User) : Prop :=
      st'.machine.memory.nextAllocId = st.machine.memory.nextAllocId ∧
      st'.machine.memory.globals = st.machine.memory.globals ∧
      st'.machine.memory.dead = st.machine.memory.dead ∧
      st'.machine.memory.issuedIds = st.machine.memory.issuedIds ∧
      st'.machine.memory.sourceAllocIdWorldActive = st.machine.memory.sourceAllocIdWorldActive ∧
      st'.machine.memory.idSupplyExhausted = st.machine.memory.idSupplyExhausted ∧
      st'.machine.raceAllocations = st.machine.raceAllocations ∧
      ∀ id, (∀ p ∈ prots, p.1 ≠ id) →
        st'.machine.memory.live.find? (fun e => e.1 == id) =
          st.machine.memory.live.find? (fun e => e.1 == id)
    match Miri.Interpreter.MachineHooks.beforeStackPopWithEnsure (fun _ => pure ()) st,
        multiAllocEndAccessesPartial tagOf prots worlds with
    | .ok () st', (worlds', none) =>
      framePreserved st' ∧
      st'.machine.borrowTracker = some { tracker with
        global := tracker.global.endCall ⟨prots.toArray⟩ } ∧
      ∀ id w', worlds' id = some w' →
        ∃ entry', st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf
            entry'.allocation.extra w'
    | .error err st', (worlds', some (fid, ftag)) =>
      framePreserved st' ∧
      st'.machine.borrowTracker = some tracker ∧
      (∀ id w', id ≠ fid → worlds' id = some w' →
        ∃ entry', st'.machine.memory.live.find? (fun e => e.1 == id) = some (id, entry') ∧
          BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf
            entry'.allocation.extra w') ∧
      ∃ wf pre entry',
        worlds' fid = some wf ∧
        BorrowTreeWorldRel tracker.global.protectedTags (frameTag fid) tagOf pre wf ∧
        (∃ e, execProtectorEndAccessFor protectorEndAccessIsWrite? wf (tagOf ftag) = .error e) ∧
        stackPopReleaseErr (pre.releaseProtector ftag tracker.global.protectedTags).status =
          some (some err) ∧
        st'.machine.memory.live.find? (fun e => e.1 == fid) = some (fid, entry') ∧
        entry'.allocation.extra = (pre.releaseProtector ftag tracker.global.protectedTags).tree
    | _, _ => False := by
  obtain ⟨mem', res, hall, hmatch⟩ :=
    stackPopReleaseAll_multiAlloc_partial_simulates (K := K) tracker.global.protectedTags frameTag
      tagOf (fun id => BorrowTreeWorldRel tracker.global.protectedTags (frameTag id) tagOf)
      (fun id => realAccessReleaseSim tracker.global.protectedTags (frameTag id) tagOf)
      prots hprots st.machine.memory worlds hsync hdom
  obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ :=
    stackPopReleaseAll_frame_preserved tracker.global.protectedTags prots st.machine.memory mem' res hall
  have hrun := miri_beforeStackPopWithEnsure_eq_releaseAll st tracker frame prots.toArray
    htracker hframe hbf mem' res (by simpa using hall)
  dsimp only
  rw [hrun]
  generalize multiAllocEndAccessesPartial tagOf prots worlds = part at hmatch ⊢
  obtain ⟨worlds', fail⟩ := part
  cases res with
  | none =>
    cases fail with
    | none => exact ⟨⟨h1, h2, h3, h4, h5, h6, rfl, h7⟩, rfl, hmatch⟩
    | some f => obtain ⟨fid, ftag⟩ := f; exact False.elim hmatch
  | some err =>
    cases fail with
    | none => exact False.elim hmatch
    | some f =>
      obtain ⟨fid, ftag⟩ := f
      obtain ⟨hA, hB⟩ := hmatch
      exact ⟨⟨h1, h2, h3, h4, h5, h6, rfl, h7⟩, htracker, hA, hB⟩

/-! ### 2E.1b End-to-end `FnEntry` retag (`RetagPolicy.create` + `RetagPipeline.retagPointerValue`) +
intra-call access + `BorrowTree.releaseProtector` contrast (`writableChildWrite` vs
`rustcNoWritable`, `charon#1619` + `lean-miri#74`) -/

private theorem dedupRangeMap_iterMut_singleFull {α : Type} [DecidableEq α]
    (s : UInt64) (hs : s ≠ 0) (v : α) :
    (⟨#[⟨⟨0, s⟩, v⟩]⟩ : Miri.DataStructures.DedupRangeMap α).iterMut
      Miri.ABI.Size.ZERO (Miri.ABI.Size.ofBytes s) =
      ⟨⟨#[⟨⟨0, s⟩, v⟩]⟩, #[0], #[⟨⟨0, s⟩, v⟩], .ok ()⟩ := by
  have hnew : Miri.DataStructures.DedupRangeMap.new (Miri.ABI.Size.ofBytes s) v = ⟨#[⟨⟨0, s⟩, v⟩]⟩ := by
    unfold Miri.DataStructures.DedupRangeMap.new
    simp [Miri.ABI.Size.ofBytes, beq_false_of_ne hs]
  rw [← hnew]
  exact Miri.DataStructures.DedupRangeMap.iterMut_new_full (Miri.ABI.Size.ofBytes s) v hs

private theorem dedupRangeMap_modifyRange_singleFull {α : Type} [DecidableEq α]
    (s : UInt64) (hs : s ≠ 0) (v : α) (f : Miri.DataStructures.ByteRange → α → α) :
    (⟨#[⟨⟨0, s⟩, v⟩]⟩ : Miri.DataStructures.DedupRangeMap α).modifyRange
      Miri.ABI.Size.ZERO (Miri.ABI.Size.ofBytes s) f =
      ⟨⟨#[⟨⟨0, s⟩, f ⟨0, s⟩ v⟩]⟩, #[0], #[⟨⟨0, s⟩, f ⟨0, s⟩ v⟩], .ok ()⟩ := by
  unfold Miri.DataStructures.DedupRangeMap.modifyRange
    Miri.DataStructures.DedupRangeMap.modifyRangeWithClone
  have hit : (⟨#[⟨⟨0, s⟩, v⟩]⟩ : Miri.DataStructures.DedupRangeMap α).iterMutWithClone
      Miri.ABI.Size.ZERO (Miri.ABI.Size.ofBytes s) id =
      ⟨⟨#[⟨⟨0, s⟩, v⟩]⟩, #[0], #[⟨⟨0, s⟩, v⟩], .ok ()⟩ :=
    dedupRangeMap_iterMut_singleFull s hs v
  dsimp only [Id.run, bind, Bind.bind, pure, Pure.pure]
  rw [hit]
  rfl

/-- Initial 2-node live `BorrowTree` for the end-to-end `writableChildWrite` vs `rustcNoWritable`
contrast: root tag `1` (`Unique`, accessed) with child sibling tag `2` (`Frozen`, accessed) over the
single uniform range `[0, s)`. -/
def fnEntryContrastInitTree (s : UInt64) : Miri.TreeBorrows.BorrowTree where
  tagMapping := { mapping := #[(⟨1, by decide⟩, ⟨0⟩), (⟨2, by decide⟩, ⟨1⟩)], deassigned := #[] }
  nodes :=
    { data := #[
        some { tag := ⟨1, by decide⟩, parent := none, children := #[⟨1⟩],
               defaultInitialPermission := .Unique, defaultInitialSifa := .None, isExposed := false },
        some { tag := ⟨2, by decide⟩, parent := some ⟨0⟩, children := #[],
               defaultInitialPermission := .Frozen, defaultInitialSifa := .None, isExposed := false }] }
  locations := ⟨#[⟨⟨0, s⟩,
    { perms := { data := #[some ⟨.Unique, true, .None⟩, some ⟨.Frozen, true, .None⟩] }
      exposedCache := {} }⟩]⟩
  roots := #[⟨0⟩]

/-- Matching initial 2-node `FnEntryBorrowWorld` over `[0, len)` with optional strong outer
protector `10` on sibling tag `1` (corresponding to vendored `BorTag` `2`). -/
def fnEntryContrastInitWorld (len : Nat) (sibProtected : Bool) : FnEntryBorrowWorld where
  nodes := [
    ⟨0, none, .unique, 0, len, none, true⟩,
    ⟨1, some 0, .frozen, 0, len, if sibProtected then some 10 else none, true⟩]
  activeProtectors := if sibProtected then [10] else []
  nextTag := 2
  nextProtector := 20

/-- Vendored `RetagPipeline.Request` for a `FnEntry` `&mut T` (`Freeze`, `Unpin`) retag of root tag
`1` over `[0, s)` under `implicitWrites = true` and configurable `rustcNoWritable`. -/
def fnEntryContrastRequest (id : Miri.Memory.AllocId) (s : UInt64) (rustcNoWritable : Bool) :
    Miri.TreeBorrows.RetagPipeline.Request where
  typeShape := .reference
  typeFacts := ⟨true, true, true⟩
  referenceKind := .Mutable
  mode := .FnEntry
  config := ⟨true, rustcNoWritable⟩
  layoutSize := Miri.ABI.Size.ofBytes s
  originalProvenance := some (.concrete id ⟨1, by decide⟩)
  pointeeIsFreeze := true
  preciseInteriorMut := false
  hooks := { allocationResolution := some ⟨id, Miri.ABI.Size.ZERO, .concrete ⟨1, by decide⟩⟩ }

/-- Initial `RetagPipeline.MachineState` with a single mutable live allocation `id` carrying
`fnEntryContrastInitTree s`, next pointer tag `3`, and optional outer strong protector on sibling
tag `2`. -/
def fnEntryContrastMachine {MachineKind : Type}
    (id : Miri.Memory.AllocId) (alloc : Miri.Memory.Allocation Miri.Memory.Provenance Miri.TreeBorrows.BorrowTree)
    (kind : Miri.Memory.MemoryKind MachineKind) (sibProtected : Bool) :
    Miri.TreeBorrows.RetagPipeline.MachineState MachineKind where
  memory := { live := #[(id, ⟨kind, alloc⟩)], dead := #[] }
  global :=
    { nextPointerTag := ⟨3, by decide⟩
      rootPointerTags := #[(id, ⟨1, by decide⟩)]
      protectedTags := if sibProtected then ⟨#[(⟨2, by decide⟩, .StrongProtector)]⟩ else ⟨#[]⟩
      trackedPointerTags := #[] }
  frame := ⟨#[]⟩

private theorem forIn_range_one_id {α : Type} (init : α) (f : Nat → α → Id (ForInStep α)) :
    forIn ([:1] : Std.Legacy.Range) init f =
      match f 0 init with
      | .done a => a
      | .yield a => a := by
  rw [Std.Legacy.Range.forIn_eq_forIn_range']
  change forIn ([0] : List Nat) init f = _
  simp only [List.forIn_cons, List.forIn_nil, bind, Bind.bind, pure, Pure.pure]
  cases f 0 init <;> rfl

private theorem performBorrowAccessRange_singleFull_eval
    (tree : Miri.TreeBorrows.BorrowTree) (s : UInt64) (hs : s ≠ 0) (loc : Miri.TreeBorrows.LocationTree)
    (hlocs : tree.locations = ⟨#[⟨⟨0, s⟩, loc⟩]⟩)
    (tag : Miri.Memory.BorTag) (src : Miri.TreeBorrows.UniIndex)
    (hidx : tree.indexOfTag tag = some src)
    (kind : Miri.TreeBorrows.AccessKind) (pt : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (accLoc : Miri.TreeBorrows.LocationTree)
    (accNorm : Option Miri.TreeBorrows.Tree.NormalAccessResult)
    (accSt : Option Miri.TreeBorrows.BorrowTree.BorrowTreeAccessStatus)
    (hacc : miriPerformTreeAccessAt tree loc (some src) kind pt mode ⟨0, s⟩ =
      miriTLAMk accLoc accNorm accSt) :
    (tree.performBorrowAccessRange (.concrete tag) Miri.ABI.Size.ZERO (Miri.ABI.Size.ofBytes s)
      kind pt mode).status = accSt.getD .Completed ∧
    (tree.performBorrowAccessRange (.concrete tag) Miri.ABI.Size.ZERO (Miri.ABI.Size.ofBytes s)
      kind pt mode).tree = { tree with locations := ⟨#[⟨⟨0, s⟩, accLoc⟩]⟩ } := by
  have hit := dedupRangeMap_iterMut_singleFull s hs loc
  unfold Miri.TreeBorrows.BorrowTree.performBorrowAccessRange
  dsimp only [Id.run, bind, Bind.bind, pure, Pure.pure]
  rw [hidx, hlocs, hit]
  simp only [Option.isNone_some, Bool.false_eq_true, ↓reduceIte, Array.size_singleton]
  rw [forIn_range_one_id]
  simp only [beq_self_eq_true, ↓reduceIte]
  have hget0 : (#[0] : Array Nat)[0]? = some 0 := rfl
  have hget1 : (#[⟨⟨0, s⟩, loc⟩] : Array (Miri.DataStructures.RangeMapSegment Miri.TreeBorrows.LocationTree))[0]? =
      some ⟨⟨0, s⟩, loc⟩ := rfl
  rw [hget0, hget1]
  dsimp only
  rw [hacc]
  cases accSt <;> exact ⟨rfl, rfl⟩

private theorem performTreeAccessAt_singleRoot0_eval
    (tree : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (src : Miri.TreeBorrows.UniIndex) (kind : Miri.TreeBorrows.AccessKind)
    (pt : Miri.TreeBorrows.ProtectedTags) (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (range : Miri.DataStructures.ByteRange)
    (hroots : tree.roots = #[⟨0⟩])
    (hnoLoc : ∀ l1 l2,
      ({ tree with locations := l1 }).performNormalAccessAt loc src kind pt mode =
      ({ tree with locations := l2 }).performNormalAccessAt loc src kind pt mode)
    (norm : Miri.TreeBorrows.BorrowTree.NormalLocationAccessResult)
    (hnorm : ({ tree with locations := ⟨#[]⟩ }).performNormalAccessAt loc src kind pt mode = norm)
    (hok : norm.outcome = .ok ())
    (hroot0 : norm.access.status = .Completed → norm.access.root = 0) :
    miriPerformTreeAccessAt tree loc (some src) kind pt mode range =
      miriTLAMk norm.location (some norm.access)
        (if norm.access.status == .Completed then none
         else some (Miri.TreeBorrows.BorrowTree.BorrowTreeAccessStatus.AccessFailure range norm.access.status)) := by
  have hnormT : tree.performNormalAccessAt loc src kind pt mode = norm := by
    have := hnoLoc tree.locations ⟨#[]⟩
    rw [hnorm] at this
    exact this
  change (Id.run do
    let mut currentLocation := loc
    let mut normalAccess : Option Miri.TreeBorrows.Tree.NormalAccessResult := none
    let mut accessedRoot? : Option Miri.TreeBorrows.UniIndex := none
    let mut status : Option Miri.TreeBorrows.BorrowTree.BorrowTreeAccessStatus := none
    let normal := tree.performNormalAccessAt currentLocation src kind pt mode
    currentLocation := normal.location
    normalAccess := some normal.access
    match normal.outcome with
    | .error error => return miriTLAMk currentLocation normalAccess (some (.CacheFailure range error))
    | .ok () =>
      if normal.access.status != .Completed then
        return miriTLAMk currentLocation normalAccess (some (.AccessFailure range normal.access.status))
      match Miri.TreeBorrows.UniIndex.ofNat? normal.access.root with
      | none =>
        return miriTLAMk currentLocation normalAccess
          (some (.AccessFailure range (.MissingLocationState normal.access.root)))
      | some root => accessedRoot? := some root
    let maxLocalTag := accessedRoot?.bind fun root => (tree.nodes.get root).map Miri.TreeBorrows.TreeNode.tag
    let minExposed := if mode == .SkipChildrenOfAccessed then
        Option.bind (some src) (miriMinExposedChild tree)
      else none
    let mut stopOtherRoots := false
    for rootPosition in [:tree.roots.size] do
      if status.isNone && !stopOtherRoots then
        match tree.roots[rootPosition]? with
        | none => pure ()
        | some root =>
          let rootTag := (tree.nodes.get root).map Miri.TreeBorrows.TreeNode.tag
          let pastMinExposed : Bool := match rootTag, minExposed with
            | some tag, some minimum => decide (tag.value > minimum.value)
            | _, _ => false
          if mode == .SkipChildrenOfAccessed && pastMinExposed then
            stopOtherRoots := true
          else if accessedRoot? != some root then
            let wildcard := tree.performWildcardAccessAt currentLocation root
              maxLocalTag kind pt (rootPosition != 0)
            currentLocation := wildcard.location
            if wildcard.status != .Completed then
              status := some (.WildcardFailure range wildcard.status)
    return miriTLAMk currentLocation normalAccess status) = _
  dsimp only [Id.run, bind, Bind.bind, pure, Pure.pure]
  rw [hnormT, hok]
  cases hst : norm.access.status with
  | Completed =>
    have hr0 := hroot0 hst
    simp only [bne_self_eq_false, Bool.false_eq_true, ↓reduceIte, hr0, hroots, beq_self_eq_true,
      Array.size_singleton]
    have hof0 : Miri.TreeBorrows.UniIndex.ofNat? 0 = some ⟨0⟩ := rfl
    rw [hof0]
    dsimp only
    rw [forIn_range_one_id]
    have hrootGet : (#[⟨0⟩] : Array Miri.TreeBorrows.UniIndex)[0]? = some ⟨0⟩ := rfl
    simp only [Option.isNone_none, Bool.not_false, Bool.and_self, ↓reduceIte, hrootGet]
    cases mode with
    | VisitChildrenOfAccessed => simp [bne_self_eq_false]
    | SkipChildrenOfAccessed =>
      simp only [beq_self_eq_true, bne_self_eq_false, Bool.true_and, Bool.false_eq_true, ↓reduceIte]
      cases (match (tree.nodes.get ⟨0⟩).map Miri.TreeBorrows.TreeNode.tag,
          Option.bind (some src) (miriMinExposedChild tree) with
        | some tag, some minimum => decide (tag.value > minimum.value)
        | _, _ => false) <;> rfl
  | MissingLocationState _ | TransitionError _ _ | PermissionInvariantFailure _
  | TransitionApplicationInvariantFailure _ | PossibleInvariantFailure _ | RecordDebugAssertion =>
    simp

private theorem performNormalAccessAt_locations_indep
    (tree : Miri.TreeBorrows.BorrowTree) (l1 l2 : Miri.DataStructures.DedupRangeMap Miri.TreeBorrows.LocationTree)
    (loc : Miri.TreeBorrows.LocationTree) (src : Miri.TreeBorrows.UniIndex)
    (kind : Miri.TreeBorrows.AccessKind) (pt : Miri.TreeBorrows.ProtectedTags)
    (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode) :
    ({ tree with locations := l1 }).performNormalAccessAt loc src kind pt mode =
    ({ tree with locations := l2 }).performNormalAccessAt loc src kind pt mode := by
  unfold Miri.TreeBorrows.BorrowTree.performNormalAccessAt
  rfl

private theorem list_forIn_id_yield {α β : Type} (xs : List α) (init : β)
    (f : α → β → Id (ForInStep β)) (g : α → β → β)
    (hf : ∀ a b, f a b = ForInStep.yield (g a b)) :
    forIn (m := Id) xs init f = xs.foldl (fun b a => g a b) init := by
  induction xs generalizing init with
  | nil => rfl
  | cons a as ih =>
    simp only [List.forIn_cons, List.foldl_cons, hf, bind, Bind.bind]
    exact ih (g a init)

private theorem list_forIn_id_const {α β : Type} (xs : List α) (init : β)
    (f : α → β → Id (ForInStep β))
    (hf : ∀ a ∈ xs, f a init = ForInStep.yield init) :
    forIn (m := Id) xs init f = init := by
  induction xs with
  | nil => rfl
  | cons a as ih =>
    simp only [List.forIn_cons, hf a (List.Mem.head _), bind, Bind.bind]
    exact ih (fun x hx => hf x (List.Mem.tail _ hx))

private theorem loop_two_steps {β : Type} (s0 s1 : β) (scan : Unit → β → Id (ForInStep β))
    (h0 : scan () s0 = .yield s1) (h1 : scan () s1 = .done s1) :
    Lean.Loop.forIn (m := Id) {} s0 scan = s1 := by
  rw [Lean.Loop.forIn_eq_of_monadTail, h0]
  dsimp only [bind, Bind.bind]
  rw [Lean.Loop.forIn_eq_of_monadTail, h1]
  rfl

private theorem array_forIn'_singleton_id {α β : Type} (x : α) (init : β)
    (f : (a : α) → a ∈ (#[x] : Array α) → β → Id (ForInStep β))
    (hf : ∀ h, f x h init = ForInStep.yield init) :
    forIn' (m := Id) (#[x] : Array α) init f = init := by
  rw [← Array.forIn'_toList (xs := #[x]) (b := init) (f := fun a ha b => f a (by simpa using ha) b)]
  simp only [List.toList_toArray, List.forIn'_cons, List.forIn'_nil, hf, bind, Bind.bind]
  rfl

private def applyNormalLocationStates (states : Array (Option Miri.TreeBorrows.Tree.LocationState))
    (loc : Miri.TreeBorrows.LocationTree) : Miri.TreeBorrows.LocationTree :=
  (List.range states.size).foldl (fun cur pos =>
    match states[pos]? with
    | some (some st) =>
      match Miri.TreeBorrows.UniIndex.ofNat? pos with
      | some idx => { cur with perms := cur.perms.insert idx st }
      | none => cur
    | _ => cur) loc

private theorem performNormalAccessAt_unexposed_eval
    (tree : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (src : Miri.TreeBorrows.UniIndex) (kind : Miri.TreeBorrows.AccessKind)
    (pt : Miri.TreeBorrows.ProtectedTags) (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (acc : Miri.TreeBorrows.Tree.NormalAccessResult)
    (hacc : Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) src.toNat kind mode = acc)
    (hvis : ∀ ev ∈ acc.visited,
      ∃ idx nd, Miri.TreeBorrows.UniIndex.ofNat? ev.node = some idx ∧
        tree.nodeAt idx = some nd ∧ nd.isExposed = false) :
    tree.performNormalAccessAt loc src kind pt mode =
      ⟨applyNormalLocationStates acc.tree.locationStates loc, acc, .ok ()⟩ := by
  unfold Miri.TreeBorrows.BorrowTree.performNormalAccessAt applyNormalLocationStates
  change (Id.run do
    let access := Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) src.toNat kind mode
    let mut nextLocation := loc
    for position in [:access.tree.locationStates.size] do
      match access.tree.locationStates[position]? with
      | some (some state) =>
        match Miri.TreeBorrows.UniIndex.ofNat? position with
        | some index =>
          nextLocation := { nextLocation with perms := nextLocation.perms.insert index state }
        | none => pure ()
      | _ => pure ()
    let mut cacheOutcome : Except Miri.TreeBorrows.ExposedCacheError Unit := .ok ()
    for event in access.visited do
      if cacheOutcome matches .ok _ then
        match Miri.TreeBorrows.UniIndex.ofNat? event.node with
        | none => cacheOutcome := .error (.InvalidIndex event.node)
        | some index =>
          match tree.nodeAt index with
          | none => cacheOutcome := .error (.MissingNode index)
          | some node =>
            if node.isExposed && (miri_etm_private% Miri.TreeBorrows.TreeState
                Miri.TreeBorrows.BorrowTree.failingNode?) access.status != some event.node then
              match tree.locationStateAt loc index, access.tree.stateAt event.node with
              | some oldState, some newState =>
                match Miri.TreeBorrows.performAccessTransition kind event.relatedness oldState.permission
                    (pt.contains node.tag) with
                | .Transition transition =>
                  if !transition.isNoop then
                    let oldLevel := oldState.permission.strongestAllowedLocalAccess (pt.contains node.tag)
                    let newLevel := newState.permission.strongestAllowedLocalAccess (pt.contains node.tag)
                    let update := nextLocation.exposedCache.updateExposure tree.nodes index oldLevel newLevel
                    nextLocation := { nextLocation with exposedCache := update.cache }
                    cacheOutcome := update.outcome
                | .UndefinedBehavior | .ImpossibleProtectedReservedIM => pure ()
              | _, _ => cacheOutcome := .error (.MissingNode index)
    return (⟨nextLocation, access, cacheOutcome⟩ :
      Miri.TreeBorrows.BorrowTree.NormalLocationAccessResult)) = _
  dsimp only [Id.run, bind, Bind.bind, pure, Pure.pure]
  rw [hacc, Std.Legacy.Range.forIn_eq_forIn_range']
  simp only [Std.Legacy.Range.size, Nat.sub_zero, Nat.add_sub_cancel, Nat.div_one,
    ← List.range_eq_range']
  rw [list_forIn_id_yield (xs := List.range acc.tree.locationStates.size) (g := fun pos cur =>
      match acc.tree.locationStates[pos]? with
      | some (some st) =>
        match Miri.TreeBorrows.UniIndex.ofNat? pos with
        | some idx => { cur with perms := cur.perms.insert idx st }
        | none => cur
      | _ => cur) (hf := fun pos cur => by
        cases acc.tree.locationStates[pos]? with
        | none => rfl
        | some o => cases o with
          | none => rfl
          | some st => cases Miri.TreeBorrows.UniIndex.ofNat? pos <;> rfl)]
  rw [list_forIn_id_const (xs := acc.visited) (hf := fun ev hev => by
    obtain ⟨idx, nd, hidx, hnd, hexp⟩ := hvis ev hev
    simp only [↓reduceIte, hidx, hnd, hexp, Bool.false_and, Bool.false_eq_true])]
  rfl

private theorem performNormalAccessAt_unexposed_lt
    (tree : Miri.TreeBorrows.BorrowTree) (loc : Miri.TreeBorrows.LocationTree)
    (src : Miri.TreeBorrows.UniIndex) (srcNat : Nat) (hsrc : src.toNat = srcNat)
    (kind : Miri.TreeBorrows.AccessKind)
    (pt : Miri.TreeBorrows.ProtectedTags) (mode : Miri.TreeBorrows.Tree.ChildrenVisitMode)
    (n : Nat)
    (resLoc : Miri.TreeBorrows.LocationTree)
    (resStatus : Miri.TreeBorrows.Tree.NormalAccessStatus) (resRoot : Nat)
    (hvisLt : ((Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) srcNat kind mode).visited.all fun ev => decide (ev.node < n)) = true)
    (hnoExp : ∀ j < n, ∃ idx nd, Miri.TreeBorrows.UniIndex.ofNat? j = some idx ∧
      tree.nodeAt idx = some nd ∧ nd.isExposed = false)
    (hloc : applyNormalLocationStates (Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) srcNat kind mode).tree.locationStates loc = resLoc)
    (hst : (Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) srcNat kind mode).status = resStatus)
    (hrt : (Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) srcNat kind mode).root = resRoot) :
    ∃ acc,
      tree.performNormalAccessAt loc src kind pt mode = ⟨resLoc, acc, .ok ()⟩ ∧
      acc.status = resStatus ∧ acc.root = resRoot := by
  subst hsrc
  have hvis : ∀ ev ∈ (Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) src.toNat kind mode).visited,
      ∃ idx nd, Miri.TreeBorrows.UniIndex.ofNat? ev.node = some idx ∧
        tree.nodeAt idx = some nd ∧ nd.isExposed = false := by
    intro ev hev
    have hlt : ev.node < n := of_decide_eq_true (List.all_eq_true.mp hvisLt ev hev)
    exact hnoExp ev.node hlt
  have h := performNormalAccessAt_unexposed_eval tree loc src kind pt mode
    (Miri.TreeBorrows.Tree.NormalTreeState.performAccess
      (miriNormalProjection tree loc pt) src.toNat kind mode) rfl hvis
  rw [hloc] at h
  exact ⟨_, h, hst, hrt⟩

