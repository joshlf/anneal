  intro t1 t2 t3 t4 t9 treeMissing
  have hmiss : (treeMissing.releaseProtector t9 ⟨#[]⟩).status = .MissingTag t9 :=
    congrArg Miri.TreeBorrows.BorrowTree.ProtectorReleaseResult.status
