            cases me with
            | layoutMismatch mid asz rsz aal ral =>
              dsimp only [deallocErrOfMiri] at hmap
              injection hmap with hmap
              injection hmap with h1 h2 h3 h4 h5
              have hid : mid = id3 := ofMiriAllocId_injective h1
              have hasz : asz = ⟨4⟩ := by cases asz; dsimp only at h2; subst h2; rfl
              have hrsz : rsz = ⟨8⟩ := by cases rsz; dsimp only at h3; subst h3; rfl
              subst hid; subst hasz; subst hrsz
              exact ⟨aal, ral, st', hm, h4, h5⟩
            | _ => cases hmap
        · -- (11) `missingVectorClockExtra`:
          have h := hlock canaryGlobalDet id6 0 none none .stack .stack (.configured true)
            (Or.inl rfl) (fun _ _ hx => by cases hx) rfl rfl rfl
          have hkOut := canaryDealloc_kw_postDetachErrs.2.2.2.2.2
          cases hm : Miri.Interpreter.AllocationMachine.deallocate canaryDeallocHooks
              ⟨⟨0⟩, some (.concrete id6 tag1)⟩ none .stack (canaryDeallocSt aMut4 aZst aImm4 canaryGlobalDet) with
          | ok u st' =>
            cases u; rw [hm] at h; rw [hkOut] at h
            obtain ⟨_, hbad⟩ := deallocMachineOutcomeRel_missingClock_inv h.2; cases hbad
          | error e st' =>
            rw [hm] at h; rw [hkOut] at h
            obtain ⟨msg, heq⟩ := deallocMachineOutcomeRel_missingClock_inv h.2
            injection heq with he; subst he
            exact ⟨msg, st', hm⟩
        · -- (12) `raceDetecting = false`:
          have h := hlock canaryGlobalOff id1 0 none none .stack .stack (.configured false)
            (Or.inr rfl) (fun _ _ hx => by cases hx) rfl rfl rfl
          have hkOut := canaryDealloc_kw_zst_and_off.2
          cases hm : Miri.Interpreter.AllocationMachine.deallocate canaryDeallocHooks
              ⟨⟨0⟩, some (.concrete id1 tag1)⟩ none .stack (canaryDeallocSt aMut4 aZst aImm4 canaryGlobalOff) with
          | error e st' => rw [hm] at h; rw [hkOut] at h; cases h.2
          | ok u st' => cases u; exact ⟨st', hm⟩

/-! ### 2E.3 Nested `childSession` (`recursive = true`) vtable precedence at full
`ValidityVisitor.validatePlace` level (`lean-miri#75`, `#79`, `#82`) -/

private theorem eStateM_loop_forIn_unfold {ε S β : Type} (s0 : S)
    (init : β) (f : Unit → β → EStateM ε S (ForInStep β)) :
    Lean.Loop.forIn {} init f =
      (f () init >>= fun
        | .done b => pure b
        | .yield b => Lean.Loop.forIn {} b f) := by
  letI : Lean.Order.MonadTail (EStateM ε S) :=
    { instCCPO := fun {γ} inst =>
        @Lean.Order.instCCPOPi S (fun _ => EStateM.Result ε S γ) (fun _ =>
          @Lean.Order.FlatOrder.instCCPO (EStateM.Result ε S γ)
            (EStateM.Result.ok (@Classical.choice γ inst) s0))
      bind_mono_right := fun {α γ x f g} _ hfg s => by
        change Lean.Order.FlatOrder.rel (EStateM.bind x f s) (EStateM.bind x g s)
        unfold EStateM.bind
        cases hx : x s with
        | error e s' => exact Lean.Order.FlatOrder.rel.refl
        | ok a s' => exact hfg a s' }
  exact Lean.Loop.forIn_eq_of_monadTail

/-- **Full `ValidityVisitor.validatePlace` driver lemma for `recursive = true, reset = false` with
one tracked pointee**: unfolds `validatePlace`'s `while continueLoop` worklist loop via
`eStateM_loop_forIn_unfold`, proving that when root `visit` tracks `(key, childPath)` into
`refTracking`, `validatePlace` pops `childSession := { path := childPath, flags := ⟨false, true⟩,
ctfeMode := none, refTracking := none, dataBytes := none }` and propagates BOTH errors and clean
successes (`dataBytes = none`) of `visit h c (fuel + 1) childSession ⟨.memory key.mplace, key.layout⟩`. -/
theorem validatePlace_recursive_oneTracked_eq {P S C E F A Pad : Type}
    [Miri.Memory.PointerProvenance P] [DecidableEq P]
    (h : Miri.Interpreter.ValidityVisitor.Hooks P S C E F A Pad) (c : C)
    (fuel : Nat) (place : Miri.Interpreter.RuntimePlace P) (st : S)
    (name : String) (key : Miri.Interpreter.ValidityVisitor.Key P)
    (childPath : Miri.Memory.ValidationPath)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c place.layout.ty st = .ok name st)
    (hroot :
      let rootSession : Miri.Interpreter.ValidityVisitor.Session P :=
        { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
          refTracking := some .empty, dataBytes := none }
      let tracked : Miri.Memory.Validity.RefTracking
          (Miri.Interpreter.ValidityVisitor.Key P) Miri.Memory.ValidationPath :=
        ⟨#[key], #[(key, childPath)]⟩
      Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) rootSession place st =
        .ok { rootSession with refTracking := some tracked } st) :
    let childSession : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := childPath, flags := ⟨false, true⟩, ctfeMode := none,
        refTracking := none, dataBytes := none }
    let childPlace : Miri.Interpreter.RuntimePlace P := ⟨.memory key.mplace, key.layout⟩
    (∀ err st',
      Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) childSession childPlace st = .error err st' →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place true false st = .error err st') ∧
    (∀ visited st',
      Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) childSession childPlace st = .ok visited st' →
      visited.dataBytes = none →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place true false st = .ok () st') := by
  dsimp only
  let rootSession : Miri.Interpreter.ValidityVisitor.Session P :=
    { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
      refTracking := some .empty, dataBytes := none }
  let tracked : Miri.Memory.Validity.RefTracking
      (Miri.Interpreter.ValidityVisitor.Key P) Miri.Memory.ValidationPath :=
    ⟨#[key], #[(key, childPath)]⟩
  let childSession : Miri.Interpreter.ValidityVisitor.Session P :=
    { path := childPath, flags := ⟨false, true⟩, ctfeMode := none,
      refTracking := none, dataBytes := none }
  let childPlace : Miri.Interpreter.RuntimePlace P := ⟨.memory key.mplace, key.layout⟩
  have hnext1 : (some tracked).bind Miri.Memory.Validity.RefTracking.next =
      some ((key, childPath), ⟨#[key], #[]⟩) := rfl
  have hnext2 : (some (⟨#[key], #[]⟩ : Miri.Memory.Validity.RefTracking
      (Miri.Interpreter.ValidityVisitor.Key P) Miri.Memory.ValidationPath)).bind
      Miri.Memory.Validity.RefTracking.next = none := rfl
  have hstep1 :
      h.withGhostValidation
        (have session : Miri.Interpreter.ValidityVisitor.Session P :=
          { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
            refTracking := some .empty, dataBytes := none }
         do
           let session ← Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) session place
           (miri_etm_private% Miri.Interpreter.ValidityVisitor
             Miri.Interpreter.ValidityVisitor.resetPadding) h c session place
           pure session) st =
        .ok { rootSession with refTracking := some tracked } st := by
    rw [hghost]
    refine (est_bind_ok _ _ _ _ { rootSession with refTracking := some tracked } hroot).trans ?_
    have hrp : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.resetPadding) h c
        { rootSession with refTracking := some tracked } place = pure () :=
      Miri.Interpreter.ValidityVisitor.resetPadding_no_ranges h c _ place rfl
    rw [hrp]; rfl
  constructor
  · intro err st' hchildErr
    unfold Miri.Interpreter.ValidityVisitor.validatePlace
    refine (est_bind_ok _ _ _ _ name htn).trans ?_
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ { rootSession with refTracking := some tracked } hstep1).trans ?_
    refine (est_bind_err _ _ _ _ err ?_).trans rfl
    dsimp only [forIn]
    rw [eStateM_loop_forIn_unfold st]
    simp only [↓reduceIte, hnext1, Nat.succ_ne_zero, beq_iff_eq]
    refine (est_bind_err _ _ _ _ err ?_).trans rfl
    refine (est_bind_err _ _ _ _ err ?_).trans rfl
    rw [hghost]
    exact est_bind_err _ _ _ _ err hchildErr
  · intro visited st' hchildOk hdb
    unfold Miri.Interpreter.ValidityVisitor.validatePlace
    refine (est_bind_ok _ _ _ _ name htn).trans ?_
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ { rootSession with refTracking := some tracked } hstep1).trans ?_
    refine (est_bind_ok _ _ _ _ ({ rootSession with refTracking := some ⟨#[key], #[]⟩ }, fuel, false) ?_).trans rfl
    -- Iteration 1: pops `(key, childPath)`, validates `childPlace`, updates tracking to empty queue.
    dsimp only [forIn]
    rw [eStateM_loop_forIn_unfold st]
    simp only [↓reduceIte, hnext1, Nat.succ_ne_zero, beq_iff_eq]
    refine (est_bind_ok _ _ st st'
      (ForInStep.yield ({ rootSession with refTracking := some ⟨#[key], #[]⟩ }, fuel, true)) ?_).trans ?_
    · refine (est_bind_ok _ _ st st' () ?_).trans rfl
      rw [hghost]
      refine (est_bind_ok _ _ st st' visited hchildOk).trans ?_
      have hrp := Miri.Interpreter.ValidityVisitor.resetPadding_no_ranges h c visited childPlace hdb
      rw [hrp]; rfl
    -- Iteration 2: empty queue -> sets `continueLoop := false`.
    dsimp only
    rw [eStateM_loop_forIn_unfold st']
    simp only [↓reduceIte, hnext2]
    refine (est_bind_ok _ _ _ _
      (ForInStep.yield ({ rootSession with refTracking := some ⟨#[key], #[]⟩ }, fuel, false)) rfl).trans ?_
    -- Iteration 3: `continueLoop = false` -> `.done`!
    dsimp only
    rw [eStateM_loop_forIn_unfold st']
    rfl

/-- **Full `ValidityVisitor.validatePlace` nested `&(&dyn Trait)` theorem (`lean-miri#75`, `#79`,
`#82`)**: upgrades `visit_nested_wideSafeRef_childSession` from `ValidityVisitor.visit` to the full
recursive `ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st` driver!
1. Root `&(&dyn Trait)` passes outer safe-pointer checks and tracks the 16-byte `&dyn Trait`
   pointee into `refTracking`.
2. `validatePlace`'s `while continueLoop` pops `childSession` (`mayDangle = true`,
   `refTracking = none`):
   * ANY invalid vtable metadata word fails BEFORE any inner data-pointer check (`checkPointerAccess`,
     `addressTooClose`, null, uninhabited, alignment);
   * a valid vtable proceeds under `mayDangle = true`: `addressTooClose` fails with
     `"safe pointer too close to address-space end"`, while a dangling aligned non-null data pointer
     returns `.ok () st` WITHOUT calling `checkPointerAccess`! -/
theorem validatePlace_nested_wideDyn_invalidVTable_precedes_dataPtr {S C E F A Pad : Type}
    (h : Miri.Interpreter.ValidityVisitor.Hooks Miri.Memory.Provenance S C E F A Pad) (c : C)
    (fuel : Nat) (outerPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance) (st : S)
    (name : String) (outerMut innerMut : Bool) (expected : Nat)
    (outerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (outerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (outerSize : Miri.ABI.Size) (outerAlign : Miri.ABI.Align)
    (outerSc : Miri.Memory.Scalar Miri.Memory.Provenance)
    (innerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (innerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (metaScalar : Miri.Memory.Scalar Miri.Memory.Provenance)
    (vtPtr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c outerPlace.layout.ty st = .ok name st)
    -- Root `&(&dyn Trait)` hypotheses:
    (houterCl : h.classify c outerPlace.layout.ty st = .ok (.reference outerMut) st)
    (houterRd : h.readImmediate c outerPlace .reference st = .ok outerImm st)
    (houterPt : h.ptrToPlace c outerImm st = .ok outerTarget st)
    (houterSized : outerTarget.layout.layout.isSized = true)
    (houterSa : h.sizeAndAlign c outerTarget st = .ok (some (outerSize, outerAlign)) st)
    (houterAcc : h.checkPointerAccess c outerTarget.mplace.ptr outerSize st = .ok (.ok ()) st)
    (houterFrom : Miri.Memory.Scalar.fromMaybePointer h.target.base outerTarget.mplace.ptr = .ok outerSc)
    (houterNn : h.scalarMayBeNull c outerSc st = .ok false st)
    (houterInh : h.opsemInhabited c outerTarget.layout.ty st = .ok true st)
    (houterAl : h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.ok ()) st)
    -- Nested 16-byte `&dyn Trait` pointee hypotheses (NO data-pointer validity assumed!):
    (hinnerCl : h.classify c outerTarget.layout.ty st = .ok (.reference innerMut) st)
    (hinnerRd : h.readImmediate c ⟨.memory outerTarget.mplace, outerTarget.layout⟩ .reference st = .ok innerImm st)
    (hinnerPt : h.ptrToPlace c innerImm st = .ok innerTarget st)
    (hinnerUns : innerTarget.layout.layout.isSized = false)
    (hinnerMt : h.metadataTail c innerTarget.layout.ty st = .ok (.dynamic expected) st)
    (hunwrap : innerTarget.mplace.metadata.unwrapMeta = .ok metaScalar)
    (htoptr : metaScalar.toPointer h.target.base = .ok vtPtr) :
    let childPath : Miri.Memory.ValidationPath := (⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref
    (∀ err st',
      Miri.Interpreter.VTable.getPtrVTableType h.vtable c vtPtr (some expected) st = .error err st' →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st = .error err st') ∧
    (∀ vtTy innerSize innerAlign innerSc intVal addr,
      Miri.Interpreter.VTable.getPtrVTableType h.vtable c vtPtr (some expected) st = .ok vtTy st →
      h.sizeAndAlign c innerTarget st = .ok (some (innerSize, innerAlign)) st →
      Miri.Memory.Scalar.fromMaybePointer h.target.base innerTarget.mplace.ptr = .ok innerSc →
      innerSc.tryToScalarInt = .ok (.integer intVal) →
      intVal.toTargetUsize h.target.pointerSize = .ok addr →
      let maximum : Nat := 2 ^ h.target.base.pointerWidth.bits.toNat - 1
      (addr.toNat + innerSize.bytes.toNat ≥ maximum →
        Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st =
          .error (.undefinedBehavior
            s!"validation{childPath.render}: safe pointer too close to address-space end") st) ∧
      (addr.toNat + innerSize.bytes.toNat < maximum →
        h.scalarMayBeNull c innerSc st = .ok false st →
        h.opsemInhabited c innerTarget.layout.ty st = .ok true st →
        h.checkPointerAlignResult c innerTarget.mplace.ptr innerAlign st = .ok (.ok ()) st →
        Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st = .ok () st)) := by
  dsimp only
  have hroot := (visit_root_tracks_pointee_for_childSession h c fuel ⟨name, #[]⟩ outerPlace st
    outerMut outerImm outerTarget outerSize outerAlign outerSc
    houterCl houterRd houterPt (Or.inl houterSized) houterSa houterAcc houterFrom houterNn houterInh houterAl).1
  have hdrv := validatePlace_recursive_oneTracked_eq h c fuel outerPlace st name
    ⟨outerTarget.mplace, outerTarget.layout⟩ ((⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref)
    hghost htn hroot
  have hnested := visit_nested_wideSafeRef_childSession h c fuel ⟨name, #[]⟩
    ⟨.memory outerTarget.mplace, outerTarget.layout⟩ st innerMut expected
    innerImm innerTarget metaScalar vtPtr hinnerCl hinnerRd hinnerPt hinnerUns hinnerMt hunwrap htoptr
  refine ⟨fun err st' hvtErr => hdrv.1 err st' (hnested.1 err st' hvtErr),
    fun vtTy innerSize innerAlign innerSc intVal addr hvtOk hsa hfrom htry haddr => ?_⟩
  have hok := hnested.2 vtTy innerSize innerAlign innerSc intVal addr hvtOk hsa hfrom htry haddr
  exact ⟨fun hge => hdrv.1 _ st (hok.1 hge),
    fun hlt hnn hinh hal => hdrv.2 _ st (hok.2 hlt hnn hinh hal) rfl⟩

/-- **Full `ValidityVisitor.validatePlace` struct-wrapped `&(S { f0: &dyn Trait, ... })` theorem
(`lean-miri#75`, `#79`, `#82`)**: upgrades nested wide-ref vtable precedence to a struct pointee
whose first visited field (`order = idx0 :: rest`) is a 16-byte `&dyn Trait`! Inside `validatePlace
… true false`, the invalid vtable on field `idx0` fails BEFORE ANY inner data-pointer check AND
BEFORE visiting ANY subsequent struct field `rest` (even an uninhabited `!` field!). -/
theorem validatePlace_nested_struct_wideDyn_invalidVTable_precedes_dataPtr {S C E F A Pad : Type}
    (h : Miri.Interpreter.ValidityVisitor.Hooks Miri.Memory.Provenance S C E F A Pad) (c : C)
    (fuel : Nat) (outerPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance) (st : S)
    (name : String) (outerMut innerMut : Bool) (expected : Nat)
    (outerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (outerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (outerSize : Miri.ABI.Size) (outerAlign : Miri.ABI.Align)
    (outerSc : Miri.Memory.Scalar Miri.Memory.Provenance)
    (maybeDang unsafeCell isEnum : Bool) (offsets : Array Miri.ABI.Size)
    (idx0 : Nat) (restOrder : List Nat) (field0Place : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
    (field0Elem : Miri.Memory.PathElem)
    (innerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (innerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (metaScalar : Miri.Memory.Scalar Miri.Memory.Provenance)
    (vtPtr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (err : Miri.Interpreter.StepError) (st' : S)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c outerPlace.layout.ty st = .ok name st)
    -- Root `&(Struct { f0: &dyn Trait, ... })` hypotheses:
    (houterCl : h.classify c outerPlace.layout.ty st = .ok (.reference outerMut) st)
    (houterRd : h.readImmediate c outerPlace .reference st = .ok outerImm st)
    (houterPt : h.ptrToPlace c outerImm st = .ok outerTarget st)
    (houterSized : outerTarget.layout.layout.isSized = true)
    (houterSa : h.sizeAndAlign c outerTarget st = .ok (some (outerSize, outerAlign)) st)
    (houterAcc : h.checkPointerAccess c outerTarget.mplace.ptr outerSize st = .ok (.ok ()) st)
    (houterFrom : Miri.Memory.Scalar.fromMaybePointer h.target.base outerTarget.mplace.ptr = .ok outerSc)
    (houterNn : h.scalarMayBeNull c outerSc st = .ok false st)
    (houterInh : h.opsemInhabited c outerTarget.layout.ty st = .ok true st)
    (houterAl : h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.ok ()) st)
    -- Struct pointee layout & field-0 projection:
    (hstructCl : h.classify c outerTarget.layout.ty st = .ok (.aggregate maybeDang unsafeCell isEnum) st)
    (hstructFields : outerTarget.layout.layout.fields = .Arbitrary offsets (idx0 :: restOrder).toArray)
    (hproj0 : Miri.Interpreter.PlaceDynamic.field h.projection c
      ⟨.memory outerTarget.mplace, outerTarget.layout⟩ idx0 st = .ok field0Place st)
    (hfpath0 : h.fieldPath c outerTarget.layout idx0 field0Place.layout.ty st = .ok field0Elem st)
    -- Field 0 is `&dyn Trait` with an invalid vtable (NO data-pointer check or `restOrder` check!):
    (hinnerCl : h.classify c field0Place.layout.ty st = .ok (.reference innerMut) st)
    (hinnerRd : h.readImmediate c field0Place .reference st = .ok innerImm st)
    (hinnerPt : h.ptrToPlace c innerImm st = .ok innerTarget st)
    (hinnerUns : innerTarget.layout.layout.isSized = false)
    (hinnerMt : h.metadataTail c innerTarget.layout.ty st = .ok (.dynamic expected) st)
    (hunwrap : innerTarget.mplace.metadata.unwrapMeta = .ok metaScalar)
    (htoptr : metaScalar.toPointer h.target.base = .ok vtPtr)
    (hvtErr : Miri.Interpreter.VTable.getPtrVTableType h.vtable c vtPtr (some expected) st = .error err st') :
    Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 2) outerPlace true false st = .error err st' := by
  have hroot := (visit_root_tracks_pointee_for_childSession h c (fuel + 1) ⟨name, #[]⟩ outerPlace st
    outerMut outerImm outerTarget outerSize outerAlign outerSc
    houterCl houterRd houterPt (Or.inl houterSized) houterSa houterAcc houterFrom houterNn houterInh houterAl).1
  have hdrv := (validatePlace_recursive_oneTracked_eq h c (fuel + 1) outerPlace st name
    ⟨outerTarget.mplace, outerTarget.layout⟩ ((⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref)
    hghost htn hroot).1 err st'
  apply hdrv
  let childSession : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance :=
    { path := (⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref
      flags := ⟨false, true⟩, ctfeMode := none, refTracking := none, dataBytes := none }
  let field0Session : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance :=
    { childSession with
      path := childSession.path.push field0Elem
      flags := ⟨false, true || maybeDang⟩ }
  have hf0Err : Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) field0Session field0Place st =
      .error err st' :=
    visit_wideDyn_checkSafe_vtableBeforeDataUB h c fuel field0Session field0Place st innerMut
      expected innerImm innerTarget metaScalar vtPtr err st' rfl
      hinnerCl hinnerRd hinnerPt hinnerUns hinnerMt hunwrap htoptr hvtErr
  unfold Miri.Interpreter.ValidityVisitor.visit
  refine (est_bind_ok _ _ _ _ _ hstructCl).trans ?_
  have hprimNone : (miri_etm_private% Miri.Interpreter.ValidityVisitor
      Miri.Interpreter.ValidityVisitor.primitive) h c childSession
      ⟨.memory outerTarget.mplace, outerTarget.layout⟩ (.aggregate maybeDang unsafeCell isEnum) st =
      .ok none st := rfl
  refine (est_bind_ok _ _ _ _ none hprimNone).trans ?_
  simp only [hstructFields, ← Array.forIn_toList, List.forIn_cons]
  refine (est_bind_err _ _ _ _ err ?_).trans rfl
  refine (est_bind_err _ _ _ _ err ?_).trans rfl
  refine (est_bind_ok _ _ _ _ field0Place hproj0).trans ?_
  refine (est_bind_ok _ _ _ _ field0Elem hfpath0).trans ?_
  exact est_bind_err _ _ _ _ err hf0Err

/-! ### 2E.3b `[T; N]` `Sized` array validity fast-path & nested `[&dyn Trait; N]` / `&[&dyn Trait; N]`
invalid-vtable precedence at full `ValidityVisitor.validatePlace` level (`lean-miri#75`, `#79`, `#82`) -/

private theorem size_mul_zero (s : Miri.ABI.Size) : s.mul 0 = .ok Miri.ABI.Size.ZERO := by
  unfold Miri.ABI.Size.mul Miri.ABI.Size.ZERO Miri.ABI.Size.ofBytes
  simp

private theorem validatePlace_noTrack_eq {P S C E F A Pad : Type}
    [Miri.Memory.PointerProvenance P] [DecidableEq P]
    (h : Miri.Interpreter.ValidityVisitor.Hooks P S C E F A Pad) (c : C)
    (fuel : Nat) (place : Miri.Interpreter.RuntimePlace P) (recursive : Bool) (st : S)
    (name : String)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c place.layout.ty st = .ok name st) :
    let initSession : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    (∀ err st',
      Miri.Interpreter.ValidityVisitor.visit h c fuel initSession place st = .error err st' →
      Miri.Interpreter.ValidityVisitor.validatePlace h c fuel place recursive false st = .error err st') ∧
    (∀ st',
      Miri.Interpreter.ValidityVisitor.visit h c fuel initSession place st = .ok initSession st' →
      Miri.Interpreter.ValidityVisitor.validatePlace h c fuel place recursive false st = .ok () st') := by
  intro initSession
  constructor
  · intro err st' herr
    unfold Miri.Interpreter.ValidityVisitor.validatePlace
    refine (est_bind_ok _ _ _ _ name htn).trans ?_
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_err _ _ _ _ err ?_).trans rfl
    rw [hghost]
    exact est_bind_err _ _ _ _ err herr
  · intro st' hok
    have hstep1 :
        h.withGhostValidation
          (do
            let session := initSession
            let session ← Miri.Interpreter.ValidityVisitor.visit h c fuel session place
            (miri_etm_private% Miri.Interpreter.ValidityVisitor
              Miri.Interpreter.ValidityVisitor.resetPadding) h c session place
            pure session) st = .ok initSession st' := by
      rw [hghost]
      refine (est_bind_ok _ _ _ _ initSession hok).trans ?_
      have hrp : (miri_etm_private% Miri.Interpreter.ValidityVisitor
          Miri.Interpreter.ValidityVisitor.resetPadding) h c initSession place = pure () :=
        Miri.Interpreter.ValidityVisitor.resetPadding_no_ranges h c initSession place rfl
      rw [hrp]; rfl
    cases recursive with
    | false =>
      unfold Miri.Interpreter.ValidityVisitor.validatePlace
      refine (est_bind_ok _ _ _ _ name htn).trans ?_
      simp only [Bool.false_eq_true, ↓reduceIte]
      exact (est_bind_ok _ _ _ _ initSession hstep1).trans rfl
    | true =>
      unfold Miri.Interpreter.ValidityVisitor.validatePlace
      refine (est_bind_ok _ _ _ _ name htn).trans ?_
      simp only [Bool.false_eq_true, ↓reduceIte]
      refine (est_bind_ok _ _ _ _ initSession hstep1).trans ?_
      refine (est_bind_ok _ _ _ _ (initSession, fuel, false) ?_).trans rfl
      dsimp only [forIn]
      rw [eStateM_loop_forIn_unfold st']
      have hnextNone : initSession.refTracking.bind Miri.Memory.Validity.RefTracking.next = none := rfl
      simp only [↓reduceIte, hnextNone]
      refine (est_bind_ok _ _ _ _ (ForInStep.yield (initSession, fuel, false)) rfl).trans ?_
      dsimp only
      rw [eStateM_loop_forIn_unfold st']
      rfl

/-- **Full `ValidityVisitor.validatePlace` `[T; N]` `Sized` array & raw-pointer fast-path theorem
(`lean-miri#75`)**:
1. Raw `*const [T; N]` / `*mut [T; N]` (`sized = true`, e.g. `[u8; usize::MAX]`): returns `.ok ()`
   immediately after `readImmediate` without reading pointee memory or inspecting element count;
2. Direct empty array `[T; 0]` whose ELEMENT is a non-numeric ZST (e.g. `[!; 0]`, `[(); 0]`): returns
   `.ok ()` when `opsemInhabited` holds (`len = 0` skips element traversal completely); empty arrays
   with a non-ZST or numeric element are `validatePlace_array_empty_nonZst_and_numeric_direct`;
3. Direct nonempty uninhabited array `[!; N]` (`N > 0`, e.g. `[!; usize::MAX]`): fails in `O(1)`
   at index `0` with `"validation[0]: never value"`;
4. Direct nonempty ZST unit array `[(); N]` (`N > 0`, e.g. `[(); usize::MAX]`): validates ONLY
   element `0` in `O(1)` via `visit_fieldless` and returns `.ok ()`. -/
theorem validatePlace_array_sized_raw_and_direct {P S C E F A Pad : Type}
    [Miri.Memory.PointerProvenance P] [DecidableEq P]
    (h : Miri.Interpreter.ValidityVisitor.Hooks P S C E F A Pad) (c : C)
    (fuel : Nat) (place : Miri.Interpreter.RuntimePlace P) (st : S) (name : String)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c place.layout.ty st = .ok name st)
    (hdbg : h.debugAssertions = false) :
    (∀ (pointeeTy : Nat) (imm : Miri.Interpreter.RvalueImmTy P) (recursive : Bool),
      h.classify c place.layout.ty st = .ok (.rawPointer pointeeTy true) st →
      h.readImmediate c place .rawPointer st = .ok imm st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place recursive false st = .ok () st) ∧
    (∀ (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
       (elemLayout : Miri.Interpreter.LocalLayout) (recursive : Bool),
      h.classify c place.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok elemKind st →
      elemKind ≠ .integer → elemKind ≠ .float →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      elemLayout.layout.isZst = true →
      Miri.Interpreter.PlaceDynamic.length h.projection c place st = .ok 0 st →
      h.opsemInhabited c place.layout.ty st = .ok true st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place recursive false st = .ok () st) ∧
    (∀ (elemTy : Nat) (elemLayout : Miri.Interpreter.LocalLayout) (len : UInt64)
       (elem0 : Miri.Interpreter.RuntimePlace P) (recursive : Bool),
      h.classify c place.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok .never st →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      elemLayout.layout.isZst = true →
      Miri.Interpreter.PlaceDynamic.length h.projection c place st = .ok len st →
      len > 0 →
      Miri.Interpreter.PlaceDynamic.index h.projection c place 0 st = .ok elem0 st →
      h.classify c elem0.layout.ty st = .ok .never st →
      let errPath : Miri.Memory.ValidationPath := (⟨name, #[]⟩ : Miri.Memory.ValidationPath).push (.arrayElem 0)
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 2) place recursive false st =
        .error (.undefinedBehavior s!"validation{errPath.render}: never value") st) ∧
    (∀ (elemTy : Nat) (elemLayout : Miri.Interpreter.LocalLayout) (len : UInt64)
       (elem0 : Miri.Interpreter.RuntimePlace P) (variant : Nat) (recursive : Bool),
      h.classify c place.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok (.aggregate false false false) st →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      elemLayout.layout.isZst = true →
      Miri.Interpreter.PlaceDynamic.length h.projection c place st = .ok len st →
      len > 0 →
      Miri.Interpreter.PlaceDynamic.index h.projection c place 0 st = .ok elem0 st →
      h.classify c elem0.layout.ty st = .ok (.aggregate false false false) st →
      h.opsemInhabited c elem0.layout.ty st = .ok true st →
      elem0.layout.layout.fields = .Arbitrary #[] #[] →
      elem0.layout.layout.variants = .Single variant →
      h.opsemInhabited c place.layout.ty st = .ok true st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 2) place recursive false st = .ok () st) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro pointeeTy imm recursive hcl hrd
    apply (validatePlace_noTrack_eq h c (fuel + 1) place recursive st name hghost htn).2
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.rawPointer pointeeTy true) st =
        .ok (some initSess) st := by
      with_unfolding_all exact (est_bind_ok _ _ _ _ imm hrd).trans rfl
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    exact (est_bind_ok _ _ _ _ (some initSess) hprim).trans rfl
  · intro elemTy elemKind elemLayout recursive hcl hecl hni hnf hlo hzst hlen hinh
    apply (validatePlace_noTrack_eq h c (fuel + 1) place recursive st name hghost htn).2
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.sequence elemTy) st = .ok none st := rfl
    have hniB : (elemKind == .integer) = false := beq_false_of_ne hni
    have hnfB : (elemKind == .float) = false := beq_false_of_ne hnf
    have hnotgt : ¬ ((0 : UInt64) > 0) := by decide
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    refine (est_bind_ok _ _ _ _ none hprim).trans ?_
    refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
    simp only [hniB, hnfB, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    simp only [hzst, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ 0 hlen).trans ?_
    simp only [hnotgt, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ true hinh).trans ?_
    simp only [↓reduceIte, hdbg, Bool.false_eq_true]
    rfl
  · intro elemTy elemLayout len elem0 recursive hcl hecl hlo hzst hlen hpos hidx he0cl
    apply (validatePlace_noTrack_eq h c (fuel + 2) place recursive st name hghost htn).1
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    let elemSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { initSess with path := initSess.path.push (.arrayElem 0) }
    have hprimSeq : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.sequence elemTy) st = .ok none st := rfl
    have hprimNev : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c elemSess elem0 .never st =
        .error (.undefinedBehavior s!"validation{elemSess.path.render}: never value") st := rfl
    have he0Err : Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1) elemSess elem0 st =
        .error (.undefinedBehavior s!"validation{elemSess.path.render}: never value") st := by
      unfold Miri.Interpreter.ValidityVisitor.visit
      exact (est_bind_ok _ _ _ _ _ he0cl).trans (est_bind_err _ _ _ _ _ hprimNev)
    conv => lhs; unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    refine (est_bind_ok _ _ _ _ none hprimSeq).trans ?_
    refine (est_bind_ok _ _ _ _ .never hecl).trans ?_
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    simp only [hzst, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ len hlen).trans ?_
    simp only [hpos, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elem0 hidx).trans ?_
    exact (est_bind_err _ _ _ _ _ he0Err).trans rfl
  · intro elemTy elemLayout len elem0 variant recursive hcl hecl hlo hzst hlen hpos hidx he0cl he0inh he0f he0v hinh
    apply (validatePlace_noTrack_eq h c (fuel + 2) place recursive st name hghost htn).2
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    let elemSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { initSess with path := initSess.path.push (.arrayElem 0) }
    have hprimSeq : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.sequence elemTy) st = .ok none st := rfl
    have he0Ok := Miri.Interpreter.ValidityVisitor.visit_fieldless h c fuel elemSess elem0 st variant
      he0cl he0inh he0f he0v rfl hdbg
    conv => lhs; unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    refine (est_bind_ok _ _ _ _ none hprimSeq).trans ?_
    refine (est_bind_ok _ _ _ _ (.aggregate false false false) hecl).trans ?_
    simp only [Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    simp only [hzst, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ len hlen).trans ?_
    simp only [hpos, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elem0 hidx).trans ?_
    refine (est_bind_ok _ _ _ _ elemSess he0Ok).trans ?_
    refine (est_bind_ok _ _ _ _ true hinh).trans ?_
    simp only [↓reduceIte, hdbg, Bool.false_eq_true]
    rfl

/-- **Full `ValidityVisitor.validatePlace` safe reference to empty/uninhabited arrays (`lean-miri#75`)**:
for recursive validation (`recursive = true, reset = false`) of `&[T; 0]` / `&[!; N]`:
1. Null `&[T; 0]` fails `"null or maybe-null safe pointer"`;
2. Non-null `&[!; N+1]` (`opsemInhabited = false`) fails `"safe pointer to uninhabited type"`;
3. Non-null dangling **unaligned** `&[u32; 0]` fails `classifyPointerAlignmentError` WITHOUT reading
   memory (zero-size `checkPointerAccess` passes, alignment check still runs!);
4. Non-null dangling **aligned** `&[u32; 0]` / `&[f32; 0]` succeeds `.ok ()` via the numeric
   `size == Size.ZERO` fast-path WITHOUT calling `h.toOp` or `h.readBytes`;
5. Non-null dangling **aligned** `&[!; 0]` (ZST empty array) succeeds `.ok ()`! -/
theorem validatePlace_ref_emptyArray_and_uninhabited {S C E F A Pad : Type}
    (h : Miri.Interpreter.ValidityVisitor.Hooks Miri.Memory.Provenance S C E F A Pad) (c : C)
    (fuel : Nat) (outerPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance) (st : S)
    (name : String) (outerMut : Bool)
    (outerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (outerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (outerSize : Miri.ABI.Size) (outerAlign : Miri.ABI.Align)
    (outerSc : Miri.Memory.Scalar Miri.Memory.Provenance)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c outerPlace.layout.ty st = .ok name st)
    (hdbg : h.debugAssertions = false)
    (houterCl : h.classify c outerPlace.layout.ty st = .ok (.reference outerMut) st)
    (houterRd : h.readImmediate c outerPlace .reference st = .ok outerImm st)
    (houterPt : h.ptrToPlace c outerImm st = .ok outerTarget st)
    (houterSized : outerTarget.layout.layout.isSized = true)
    (houterSa : h.sizeAndAlign c outerTarget st = .ok (some (outerSize, outerAlign)) st)
    (houterAcc : h.checkPointerAccess c outerTarget.mplace.ptr outerSize st = .ok (.ok ()) st)
    (houterFrom : Miri.Memory.Scalar.fromMaybePointer h.target.base outerTarget.mplace.ptr = .ok outerSc) :
    (h.scalarMayBeNull c outerSc st = .ok true st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st =
        .error (.undefinedBehavior s!"validation{(⟨name, #[]⟩ : Miri.Memory.ValidationPath).render}: null or maybe-null safe pointer") st) ∧
    (h.scalarMayBeNull c outerSc st = .ok false st →
      h.opsemInhabited c outerTarget.layout.ty st = .ok false st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st =
        .error (.undefinedBehavior s!"validation{(⟨name, #[]⟩ : Miri.Memory.ValidationPath).render}: safe pointer to uninhabited type") st) ∧
    (∀ (mis : Miri.Memory.Misalignment),
      h.scalarMayBeNull c outerSc st = .ok false st →
      h.opsemInhabited c outerTarget.layout.ty st = .ok true st →
      h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.error mis) st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st =
        .error (Miri.Interpreter.ValidityVisitor.classifyPointerAlignmentError ⟨name, #[]⟩ (.reference outerMut) mis) st) ∧
    (∀ (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
       (elemLayout : Miri.Interpreter.LocalLayout),
      h.scalarMayBeNull c outerSc st = .ok false st →
      h.opsemInhabited c outerTarget.layout.ty st = .ok true st →
      h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.ok ()) st →
      h.classify c outerTarget.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok elemKind st →
      (elemKind = .integer ∨ elemKind = .float) →
      Miri.Interpreter.PlaceDynamic.length h.projection c ⟨.memory outerTarget.mplace, outerTarget.layout⟩ st = .ok 0 st →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st = .ok () st) ∧
    (∀ (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
       (elemLayout : Miri.Interpreter.LocalLayout),
      h.scalarMayBeNull c outerSc st = .ok false st →
      h.opsemInhabited c outerTarget.layout.ty st = .ok true st →
      h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.ok ()) st →
      h.classify c outerTarget.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok elemKind st →
      elemKind ≠ .integer → elemKind ≠ .float →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      elemLayout.layout.isZst = true →
      Miri.Interpreter.PlaceDynamic.length h.projection c ⟨.memory outerTarget.mplace, outerTarget.layout⟩ st = .ok 0 st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) outerPlace true false st = .ok () st) := by
  let rootSession : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance :=
    { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none, refTracking := some .empty, dataBytes := none }
  have hcheckSafe_err :
      (h.scalarMayBeNull c outerSc st = .ok true st →
        (miri_etm_private% Miri.Interpreter.ValidityVisitor Miri.Interpreter.ValidityVisitor.checkSafe)
          h c rootSession outerPlace outerPlace.layout.ty (.reference outerMut) st =
          .error (.undefinedBehavior s!"validation{(⟨name, #[]⟩ : Miri.Memory.ValidationPath).render}: null or maybe-null safe pointer") st) ∧
      (h.scalarMayBeNull c outerSc st = .ok false st →
        h.opsemInhabited c outerTarget.layout.ty st = .ok false st →
        (miri_etm_private% Miri.Interpreter.ValidityVisitor Miri.Interpreter.ValidityVisitor.checkSafe)
          h c rootSession outerPlace outerPlace.layout.ty (.reference outerMut) st =
          .error (.undefinedBehavior s!"validation{(⟨name, #[]⟩ : Miri.Memory.ValidationPath).render}: safe pointer to uninhabited type") st) ∧
      (∀ (mis : Miri.Memory.Misalignment),
        h.scalarMayBeNull c outerSc st = .ok false st →
        h.opsemInhabited c outerTarget.layout.ty st = .ok true st →
        h.checkPointerAlignResult c outerTarget.mplace.ptr outerAlign st = .ok (.error mis) st →
        (miri_etm_private% Miri.Interpreter.ValidityVisitor Miri.Interpreter.ValidityVisitor.checkSafe)
          h c rootSession outerPlace outerPlace.layout.ty (.reference outerMut) st =
          .error (Miri.Interpreter.ValidityVisitor.classifyPointerAlignmentError ⟨name, #[]⟩ (.reference outerMut) mis) st) := by
    refine ⟨?_, ?_, ?_⟩
    · intro hnull
      with_unfolding_all
        refine (est_bind_ok _ _ _ _ outerImm houterRd).trans ?_
        rw [ite_f (by simp [rootSession])]
        dsimp only
        refine (est_bind_ok _ _ _ _ outerTarget houterPt).trans ?_
        rw [houterSized, Bool.not_true, ite_f (by decide)]
        refine (est_bind_ok _ _ _ _ _ houterSa).trans ?_
        rw [Option.getD_some, ite_t (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ (.ok ()) houterAcc).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ none rfl).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ outerSc (by rw [houterFrom]; rfl)).trans ?_
        exact (est_bind_ok _ _ _ _ true hnull).trans rfl
    · intro hnn huninh
      with_unfolding_all
        refine (est_bind_ok _ _ _ _ outerImm houterRd).trans ?_
        rw [ite_f (by simp [rootSession])]
        dsimp only
        refine (est_bind_ok _ _ _ _ outerTarget houterPt).trans ?_
        rw [houterSized, Bool.not_true, ite_f (by decide)]
        refine (est_bind_ok _ _ _ _ _ houterSa).trans ?_
        rw [Option.getD_some, ite_t (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ (.ok ()) houterAcc).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ none rfl).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ outerSc (by rw [houterFrom]; rfl)).trans ?_
        refine (est_bind_ok _ _ _ _ false hnn).trans ?_
        exact (est_bind_ok _ _ _ _ false huninh).trans rfl
    · intro mis hnn hinh hmis
      with_unfolding_all
        refine (est_bind_ok _ _ _ _ outerImm houterRd).trans ?_
        rw [ite_f (by simp [rootSession])]
        dsimp only
        refine (est_bind_ok _ _ _ _ outerTarget houterPt).trans ?_
        rw [houterSized, Bool.not_true, ite_f (by decide)]
        refine (est_bind_ok _ _ _ _ _ houterSa).trans ?_
        rw [Option.getD_some, ite_t (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ (.ok ()) houterAcc).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ none rfl).trans ?_
        dsimp only
        rw [ite_f (by simp [rootSession])]
        refine (est_bind_ok _ _ _ _ outerSc (by rw [houterFrom]; rfl)).trans ?_
        refine (est_bind_ok _ _ _ _ false hnn).trans ?_
        refine (est_bind_ok _ _ _ _ true hinh).trans ?_
        exact (est_bind_err _ _ st st _ (by simp [Miri.Interpreter.ValidityVisitor.mapPointerAlignmentOutcome, hmis]; rfl))
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro hnull
    apply (validatePlace_noTrack_eq h c (fuel + 1) outerPlace true st name hghost htn).1
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ houterCl).trans ?_
    exact est_bind_err _ _ _ _ _ (by with_unfolding_all exact est_bind_err _ _ _ _ _ (hcheckSafe_err.1 hnull))
  · intro hnn huninh
    apply (validatePlace_noTrack_eq h c (fuel + 1) outerPlace true st name hghost htn).1
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ houterCl).trans ?_
    exact est_bind_err _ _ _ _ _ (by with_unfolding_all exact est_bind_err _ _ _ _ _ (hcheckSafe_err.2.1 hnn huninh))
  · intro mis hnn hinh hmis
    apply (validatePlace_noTrack_eq h c (fuel + 1) outerPlace true st name hghost htn).1
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ houterCl).trans ?_
    exact est_bind_err _ _ _ _ _ (by with_unfolding_all exact est_bind_err _ _ _ _ _ (hcheckSafe_err.2.2 mis hnn hinh hmis))
  · intro elemTy elemKind elemLayout hnn hinh hal hseq hecl hnum hlen hlo
    have hroot := (visit_root_tracks_pointee_for_childSession h c fuel ⟨name, #[]⟩ outerPlace st
      outerMut outerImm outerTarget outerSize outerAlign outerSc
      houterCl houterRd houterPt (Or.inl houterSized) houterSa houterAcc houterFrom hnn hinh hal).1
    have hdrv := (validatePlace_recursive_oneTracked_eq h c fuel outerPlace st name
      ⟨outerTarget.mplace, outerTarget.layout⟩ ((⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref)
      hghost htn hroot).2
    let childSess : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance :=
      { path := (⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref
        flags := ⟨false, true⟩, ctfeMode := none, refTracking := none, dataBytes := none }
    refine hdrv childSess st ?_ rfl
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c childSess
        ⟨.memory outerTarget.mplace, outerTarget.layout⟩ (.sequence elemTy) st = .ok none st := rfl
    have hnumB : ((elemKind == .integer) || (elemKind == .float)) = true := by
      rcases hnum with rfl | rfl <;> rfl
    have hsr : miriVVSizeResult (elemLayout.layout.size.mul 0) st = .ok Miri.ABI.Size.ZERO st := by
      rw [size_mul_zero]; rfl
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hseq).trans ?_
    refine (est_bind_ok _ _ _ _ none hprim).trans ?_
    refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
    simp only [hnumB, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ 0 hlen).trans ?_
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    refine (est_bind_ok _ _ _ _ Miri.ABI.Size.ZERO hsr).trans ?_
    rfl
  · intro elemTy elemKind elemLayout hnn hinh hal hseq hecl hni hnf hlo hzst hlen
    have hroot := (visit_root_tracks_pointee_for_childSession h c fuel ⟨name, #[]⟩ outerPlace st
      outerMut outerImm outerTarget outerSize outerAlign outerSc
      houterCl houterRd houterPt (Or.inl houterSized) houterSa houterAcc houterFrom hnn hinh hal).1
    have hdrv := (validatePlace_recursive_oneTracked_eq h c fuel outerPlace st name
      ⟨outerTarget.mplace, outerTarget.layout⟩ ((⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref)
      hghost htn hroot).2
    let childSess : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance :=
      { path := (⟨name, #[]⟩ : Miri.Memory.ValidationPath).push .deref
        flags := ⟨false, true⟩, ctfeMode := none, refTracking := none, dataBytes := none }
    refine hdrv childSess st ?_ rfl
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c childSess
        ⟨.memory outerTarget.mplace, outerTarget.layout⟩ (.sequence elemTy) st = .ok none st := rfl
    have hniB : (elemKind == .integer) = false := beq_false_of_ne hni
    have hnfB : (elemKind == .float) = false := beq_false_of_ne hnf
    have hnotgt : ¬ ((0 : UInt64) > 0) := by decide
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hseq).trans ?_
    refine (est_bind_ok _ _ _ _ none hprim).trans ?_
    refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
    simp only [hniB, hnfB, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    simp only [hzst, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ 0 hlen).trans ?_
    simp only [hnotgt, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ true hinh).trans ?_
    simp only [↓reduceIte, hdbg, Bool.false_eq_true]
    rfl

/-- **Full `ValidityVisitor.validatePlace` direct EMPTY array `[T; 0]` with a NON-ZST or numeric
element (`lean-miri#75`)**: for direct validation (`reset = false`, either `recursive` flag) of a
place classified `.sequence elemTy` whose dynamic length is `0`:
1. Non-numeric, NON-ZST element (`isZst = false`, e.g. `[&dyn Trait; 0]`, `[(u8, u16); 0]`) with
   `fields = .Array stride count`: after the `projection.field` layout query, the zero end offset
   (`stride.mul 0 = Size.ZERO`), the unit layout and the `.inbounds` end-offset projection, the
   stride loop runs zero iterations and validation returns `.ok ()` once `opsemInhabited` holds
   (with `debugAssertions = false`). No hypothesis constrains the projection, read or visit of any
   element, so the result is independent of them.
2. Numeric element (`.integer` / `.float`, e.g. `[u32; 0]`, `[f64; 0]`): validation returns
   `.ok ()` through the `size == Size.ZERO` fast path directly after `length` and `layoutOf`. There
   is no `toOp`, `readBytes`, array-`fields`, `opsemInhabited` or `debugAssertions` hypothesis:
   that branch returns before any of them is consulted.

Scope: every hook result is assumed to leave the state unchanged and `withGhostValidation` is
assumed transparent. The empty ZST-element case is part 2 of
`validatePlace_array_sized_raw_and_direct`. -/
theorem validatePlace_array_empty_nonZst_and_numeric_direct {P S C E F A Pad : Type}
    [Miri.Memory.PointerProvenance P] [DecidableEq P]
    (h : Miri.Interpreter.ValidityVisitor.Hooks P S C E F A Pad) (c : C)
    (fuel : Nat) (place : Miri.Interpreter.RuntimePlace P) (st : S) (name : String)
    (hghost : ∀ {α : Type} (m : Miri.Interpreter.ValidityVisitor.M S α) (s : S),
      h.withGhostValidation m s = m s)
    (htn : h.typeName c place.layout.ty st = .ok name st) :
    (∀ (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
       (elemLayout fieldLayout : Miri.Interpreter.LocalLayout) (stride : Miri.ABI.Size)
       (count : UInt64) (unitLo : Miri.Interpreter.LocalLayout)
       (endPlace : Miri.Interpreter.RuntimePlace P) (recursive : Bool),
      h.debugAssertions = false →
      h.classify c place.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok elemKind st →
      elemKind ≠ .integer → elemKind ≠ .float →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      elemLayout.layout.isZst = false →
      place.layout.layout.fields = .Array stride count →
      Miri.Interpreter.PlaceDynamic.length h.projection c place st = .ok 0 st →
      h.projection.field c place.layout 0 st = .ok fieldLayout st →
      h.unitLayout c st = .ok unitLo st →
      Miri.Interpreter.PlaceDynamic.offsetWithMeta h.projection c place Miri.ABI.Size.ZERO
        .inbounds .none unitLo st = .ok endPlace st →
      h.opsemInhabited c place.layout.ty st = .ok true st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place recursive false st = .ok () st) ∧
    (∀ (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
       (elemLayout : Miri.Interpreter.LocalLayout) (recursive : Bool),
      h.classify c place.layout.ty st = .ok (.sequence elemTy) st →
      h.classify c elemTy st = .ok elemKind st →
      (elemKind = .integer ∨ elemKind = .float) →
      Miri.Interpreter.PlaceDynamic.length h.projection c place st = .ok 0 st →
      h.projection.layoutOf c elemTy st = .ok elemLayout st →
      Miri.Interpreter.ValidityVisitor.validatePlace h c (fuel + 1) place recursive false st = .ok () st) := by
  refine ⟨?_, ?_⟩
  · intro elemTy elemKind elemLayout fieldLayout stride count unitLo endPlace recursive
      hdbg hcl hecl hni hnf hlo hnonZst hfields hlen hfield hunit hendOff hinh
    apply (validatePlace_noTrack_eq h c (fuel + 1) place recursive st name hghost htn).2
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.sequence elemTy) st = .ok none st := rfl
    have hniB : (elemKind == .integer) = false := beq_false_of_ne hni
    have hnfB : (elemKind == .float) = false := beq_false_of_ne hnf
    have hsrEnd : miriVVSizeResult (stride.mul 0) st = .ok Miri.ABI.Size.ZERO st := by
      rw [size_mul_zero]; rfl
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    refine (est_bind_ok _ _ _ _ none hprim).trans ?_
    refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
    simp only [hniB, hnfB, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    simp only [hnonZst, Bool.false_eq_true, ↓reduceIte, hfields]
    refine (est_bind_ok _ _ _ _ 0 hlen).trans ?_
    refine (est_bind_ok _ _ _ _ fieldLayout hfield).trans ?_
    refine (est_bind_ok _ _ _ _ Miri.ABI.Size.ZERO hsrEnd).trans ?_
    refine (est_bind_ok _ _ _ _ unitLo hunit).trans ?_
    refine (est_bind_ok _ _ _ _ endPlace hendOff).trans ?_
    have hloop : ∀ (f : Nat → Miri.Interpreter.ValidityVisitor.Session P →
          Miri.Interpreter.ValidityVisitor.M S (ForInStep (Miri.Interpreter.ValidityVisitor.Session P))),
        (forIn [:UInt64.toNat 0] initSess f :
          Miri.Interpreter.ValidityVisitor.M S (Miri.Interpreter.ValidityVisitor.Session P)) st =
          .ok initSess st := by
      intro f
      have hzero : UInt64.toNat 0 = 0 := rfl
      simp only [Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size, Nat.sub_zero,
        Nat.add_sub_cancel, Nat.div_one, hzero, List.range'_zero, List.forIn_nil]
      rfl
    refine (est_bind_ok _ _ _ _ initSess (hloop _)).trans ?_
    refine (est_bind_ok _ _ _ _ true hinh).trans ?_
    simp only [↓reduceIte, hdbg, Bool.false_eq_true]
    rfl
  · intro elemTy elemKind elemLayout recursive hcl hecl hnum hlen hlo
    apply (validatePlace_noTrack_eq h c (fuel + 1) place recursive st name hghost htn).2
    let initSess : Miri.Interpreter.ValidityVisitor.Session P :=
      { path := ⟨name, #[]⟩, flags := ⟨false, false⟩, ctfeMode := none,
        refTracking := if recursive then some .empty else none, dataBytes := none }
    have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
        Miri.Interpreter.ValidityVisitor.primitive) h c initSess place (.sequence elemTy) st = .ok none st := rfl
    have hnumB : ((elemKind == .integer) || (elemKind == .float)) = true := by
      rcases hnum with rfl | rfl <;> rfl
    have hsr : miriVVSizeResult (elemLayout.layout.size.mul 0) st = .ok Miri.ABI.Size.ZERO st := by
      rw [size_mul_zero]; rfl
    unfold Miri.Interpreter.ValidityVisitor.visit
    refine (est_bind_ok _ _ _ _ _ hcl).trans ?_
    refine (est_bind_ok _ _ _ _ none hprim).trans ?_
    refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
    simp only [hnumB, ↓reduceIte]
    refine (est_bind_ok _ _ _ _ 0 hlen).trans ?_
    refine (est_bind_ok _ _ _ _ elemLayout hlo).trans ?_
    refine (est_bind_ok _ _ _ _ Miri.ABI.Size.ZERO hsr).trans ?_
    rfl

private theorem est_forIn_range'_firstErr {ε σ β : Type}
    (f : Nat → β → EStateM ε σ (ForInStep β)) (Inv : Nat → β → Prop)
    (st st' : σ) (err : ε) (k : Nat)
    (hprefix : ∀ i, i < k → ∀ b, Inv i b → ∃ b', f i b st = .ok (.yield b') st ∧ Inv (i + 1) b')
    (hk : ∀ b, Inv k b → f k b st = .error err st') :
    ∀ (n j : Nat) (b : β), j ≤ k → k < j + n → Inv j b →
      (forIn (List.range' j n 1) b f : EStateM ε σ β) st = .error err st' := by
  intro n
  induction n with
  | zero => intro j b hjk hkn _; omega
  | succ n ih =>
    intro j b hjk hkn hInv
    rw [List.range'_succ, List.forIn_cons]
    rcases Nat.lt_or_eq_of_le hjk with hlt | rfl
    · obtain ⟨b', hfb, hInv'⟩ := hprefix j hlt b hInv
      refine (est_bind_ok _ _ _ _ _ hfb).trans ?_
      exact ih (j + 1) b' hlt (by omega) hInv'
    · exact est_bind_err _ _ _ _ _ (hk b hInv)

private theorem visit_array_wideDyn_elemK_vtableErr {S C E F A Pad : Type}
    (h : Miri.Interpreter.ValidityVisitor.Hooks Miri.Memory.Provenance S C E F A Pad) (c : C)
    (fuel : Nat) (session : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance)
    (arrPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance) (st : S)
    (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
    (elemLayout fieldLayout : Miri.Interpreter.LocalLayout) (stride : Miri.ABI.Size) (count : UInt64)
    (len : UInt64) (endOff : Miri.ABI.Size) (unitLo : Miri.Interpreter.LocalLayout)
    (endPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
    (k : Nat) (offK : Miri.ABI.Size)
    (elemKPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
    (Inv : Nat → Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance → Prop)
    (innerMut : Bool) (expected : Nat)
    (innerImm : Miri.Interpreter.RvalueImmTy Miri.Memory.Provenance)
    (innerTarget : Miri.Interpreter.MPlaceTy Miri.Memory.Provenance)
    (metaScalar : Miri.Memory.Scalar Miri.Memory.Provenance)
    (vtPtr : Miri.Memory.Pointer (Option Miri.Memory.Provenance))
    (err : Miri.Interpreter.StepError) (st' : S)
    (hctfe : session.ctfeMode = none)
    (harrCl : h.classify c arrPlace.layout.ty st = .ok (.sequence elemTy) st)
    (hecl : h.classify c elemTy st = .ok elemKind st)
    (hni : elemKind ≠ .integer) (hnf : elemKind ≠ .float)
    (helo : h.projection.layoutOf c elemTy st = .ok elemLayout st)
    (hnonZst : elemLayout.layout.isZst = false)
    (harrFields : arrPlace.layout.layout.fields = .Array stride count)
    (hlen : Miri.Interpreter.PlaceDynamic.length h.projection c arrPlace st = .ok len st)
    (hk : k < len.toNat)
    (hefield : h.projection.field c arrPlace.layout 0 st = .ok fieldLayout st)
    (hendMul : stride.mul len = .ok endOff)
    (hunit : h.unitLayout c st = .ok unitLo st)
    (hendOff : Miri.Interpreter.PlaceDynamic.offsetWithMeta h.projection c arrPlace endOff .inbounds .none unitLo st = .ok endPlace st)
    (hInv0 : Inv 0 session)
    (hprefix : ∀ i, i < k →
      ∀ sess : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance, Inv i sess →
      ∃ (off : Miri.ABI.Size) (child : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
        (r : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance),
        stride.mul (UInt64.ofNat i) = .ok off ∧
        Miri.Interpreter.PlaceDynamic.offsetWithMeta h.projection c arrPlace off .wrapping .none fieldLayout st = .ok child st ∧
        Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1)
          { sess with path := sess.path.push (.arrayElem i) } child st = .ok r st ∧
        Inv (i + 1) { r with path := sess.path })
    (hInvK : ∀ sess : Miri.Interpreter.ValidityVisitor.Session Miri.Memory.Provenance,
      Inv k sess → sess.flags.resetProvenanceAndPadding = false)
    (hmulK : stride.mul (UInt64.ofNat k) = .ok offK)
    (hprojK : Miri.Interpreter.PlaceDynamic.offsetWithMeta h.projection c arrPlace offK .wrapping .none fieldLayout st = .ok elemKPlace st)
    (hinnerCl : h.classify c elemKPlace.layout.ty st = .ok (.reference innerMut) st)
    (hinnerRd : h.readImmediate c elemKPlace .reference st = .ok innerImm st)
    (hinnerPt : h.ptrToPlace c innerImm st = .ok innerTarget st)
    (hinnerUns : innerTarget.layout.layout.isSized = false)
    (hinnerMt : h.metadataTail c innerTarget.layout.ty st = .ok (.dynamic expected) st)
    (hunwrap : innerTarget.mplace.metadata.unwrapMeta = .ok metaScalar)
    (htoptr : metaScalar.toPointer h.target.base = .ok vtPtr)
    (hvtErr : Miri.Interpreter.VTable.getPtrVTableType h.vtable c vtPtr (some expected) st = .error err st') :
    Miri.Interpreter.ValidityVisitor.visit h c (fuel + 2) session arrPlace st = .error err st' := by
  have hprim : (miri_etm_private% Miri.Interpreter.ValidityVisitor
      Miri.Interpreter.ValidityVisitor.primitive) h c session arrPlace (.sequence elemTy) st = .ok none st := rfl
  have hniB : (elemKind == .integer) = false := beq_false_of_ne hni
  have hnfB : (elemKind == .float) = false := beq_false_of_ne hnf
  have hsrEnd : miriVVSizeResult (stride.mul len) st = .ok endOff st := by rw [hendMul]; rfl
  conv => lhs; unfold Miri.Interpreter.ValidityVisitor.visit
  refine (est_bind_ok _ _ _ _ _ harrCl).trans ?_
  refine (est_bind_ok _ _ _ _ none hprim).trans ?_
  dsimp only
  rw [hctfe]
  dsimp only
  refine (est_bind_ok _ _ _ _ elemKind hecl).trans ?_
  simp only [hniB, hnfB, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
  refine (est_bind_ok _ _ _ _ elemLayout helo).trans ?_
  simp only [hnonZst, Bool.false_eq_true, ↓reduceIte, harrFields]
  refine (est_bind_ok _ _ _ _ len hlen).trans ?_
  refine (est_bind_ok _ _ _ _ fieldLayout hefield).trans ?_
  refine (est_bind_ok _ _ _ _ endOff hsrEnd).trans ?_
  refine (est_bind_ok _ _ _ _ unitLo hunit).trans ?_
  refine (est_bind_ok _ _ _ _ endPlace hendOff).trans ?_
  simp only [Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size,
    Nat.sub_zero, Nat.add_sub_cancel, Nat.div_one]
  refine (est_bind_err _ _ _ _ err ?_).trans rfl
  refine est_forIn_range'_firstErr _ Inv st st' err k ?_ ?_ len.toNat 0 session
    (Nat.zero_le k) (by omega) hInv0
  · intro i hi sess hs
    obtain ⟨off, child, r, hmul, hproj, hvis, hInv'⟩ := hprefix i hi sess hs
    have hsr : miriVVSizeResult (stride.mul (UInt64.ofNat i)) st = .ok off st := by rw [hmul]; rfl
    refine ⟨{ r with path := sess.path }, ?_, hInv'⟩
    refine (est_bind_ok _ _ _ _ off hsr).trans ?_
    refine (est_bind_ok _ _ _ _ child hproj).trans ?_
    exact (est_bind_ok _ _ _ _ r hvis).trans rfl
  · intro sess hs
    have heKErr : Miri.Interpreter.ValidityVisitor.visit h c (fuel + 1)
        { sess with path := sess.path.push (.arrayElem k) } elemKPlace st = .error err st' :=
      visit_wideDyn_checkSafe_vtableBeforeDataUB h c fuel
        { sess with path := sess.path.push (.arrayElem k) } elemKPlace st innerMut
        expected innerImm innerTarget metaScalar vtPtr err st' (hInvK sess hs)
        hinnerCl hinnerRd hinnerPt hinnerUns hinnerMt hunwrap htoptr hvtErr
    have hsr : miriVVSizeResult (stride.mul (UInt64.ofNat k)) st = .ok offK st := by rw [hmulK]; rfl
    refine (est_bind_ok _ _ _ _ offK hsr).trans ?_
    refine (est_bind_ok _ _ _ _ elemKPlace hprojK).trans ?_
    exact (est_bind_err _ _ _ _ err heKErr).trans rfl

/-- **Full `ValidityVisitor.validatePlace` direct `[&dyn Trait; N]` FIRST-invalid-vtable precedence at
an arbitrary index `k < N` (`lean-miri#75`, `#79`, `#82`)**: direct validation (`reset = false`,
either `recursive` flag) of an array with a non-numeric, non-ZST element type
(`fields = .Array stride count`, dynamic length `len`, `k < len.toNat`) whose elements `0..k-1`
validate successfully without changing the state, and whose element `k` is a safe reference to an
unsized `.dynamic expected` pointee with an invalid vtable, returns exactly the
`VTable.getPtrVTableType` failure `.error err st'`. No hypothesis constrains a data-pointer hook
on element `k` (`sizeAndAlign`, `checkPointerAccess`, null, inhabitedness, alignment) or the
projection, read or visit of any element after `k`: the vtable failure precedes all of them.

The validated prefix is described by a caller-chosen, index-dependent session invariant `Inv`:
`hInv0` states it for the initial session at index `0`; `hprefix` states that every element
`i < k`, projected at offset `stride.mul i`, validates from any session satisfying `Inv i` with
the state unchanged, ending in a session that satisfies `Inv (i + 1)` once the array path is
restored; `hInvK` states that `Inv k` implies `resetProvenanceAndPadding = false`. Choosing
`Inv i s := s = sᵢ` describes one concrete run, and `Inv _ s := s.flags.resetProvenanceAndPadding =
false` gives a session-independent prefix hypothesis. Elements are projected with the
`projection.field` layout `fieldLayout`, which need not equal the `layoutOf` result `elemLayout`.
For `k = 0` the prefix is empty; with `fieldLayout = elemLayout` this is
`validatePlace_array_wideDyn_invalidVTable_precedes_dataPtr`.

Scope: every hook result other than the failing vtable lookup is assumed to leave the state
unchanged and `withGhostValidation` is assumed transparent; nothing is claimed for a run in which
an element before `k` fails or changes the state. -/
theorem validatePlace_array_wideDyn_firstInvalidVTable_precedes {S C E F A Pad : Type}
    (h : Miri.Interpreter.ValidityVisitor.Hooks Miri.Memory.Provenance S C E F A Pad) (c : C)
    (fuel : Nat) (arrPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
    (recursive : Bool) (st : S) (name : String)
    (elemTy : Nat) (elemKind : Miri.Interpreter.ValidityVisitor.TypeKind)
    (elemLayout fieldLayout : Miri.Interpreter.LocalLayout) (stride : Miri.ABI.Size) (count : UInt64)
    (len : UInt64) (endOff : Miri.ABI.Size) (unitLo : Miri.Interpreter.LocalLayout)
    (endPlace : Miri.Interpreter.RuntimePlace Miri.Memory.Provenance)
    (k : Nat) (offK : Miri.ABI.Size)
