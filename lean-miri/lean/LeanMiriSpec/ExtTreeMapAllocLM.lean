    obtain ⟨accN, hnorm, hstEq, hrtEq⟩ := performNormalAccessAt_unexposed_lt_packed initTree0 initLoc ⟨0⟩ 0 rfl .Write
      ((⟨#[]⟩ : Miri.TreeBorrows.ProtectedTags).insert ⟨3, by decide⟩ .StrongProtector)
