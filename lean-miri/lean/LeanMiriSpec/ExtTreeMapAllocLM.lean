theorem stackPopReleaseAll_canary :
    let t2 : Miri.Memory.BorTag := ⟨2, by decide⟩
    let t3 : Miri.Memory.BorTag := ⟨3, by decide⟩
    let t4 : Miri.Memory.BorTag := ⟨4, by decide⟩
