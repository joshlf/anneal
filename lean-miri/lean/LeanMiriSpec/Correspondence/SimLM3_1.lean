    dsimp only []
    rw [hglob_none]
  · rw [hsz8, hmptr]
    have hsz8_nat : (Miri.ABI.Size.ofBytes 8).bytes.toNat = 8 := rfl
    unfold evalDerefReadScalarMiri
    dsimp only []
    rw [hsz8_nat]
    have hchk := checkAndDerefPtr_live_oob_err
      allocId borTag ptrVal.offsetBytes 8 localAlloc .memoryAccess
