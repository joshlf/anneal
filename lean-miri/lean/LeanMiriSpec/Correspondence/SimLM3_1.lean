  · rcases hmain with ⟨ha_ub, hm_ub⟩ | ⟨_, _, _, _, _, _, ⟨_, ha_ok, _⟩, ⟨_, _, _, hm_ok, _⟩⟩
    · exact ⟨fun _ => hm_ub, fun _ => ha_ub⟩
    · refine ⟨fun h => ?_, fun ⟨_, _, h⟩ => ?_⟩
