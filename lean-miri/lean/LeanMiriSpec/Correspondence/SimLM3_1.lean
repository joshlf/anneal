private theorem checkAndDerefPtr_congr_resolve
    {Prov ProvExtra : Type}
    (target : Miri.Memory.PointerArithmetic)
    (ptr : Miri.Memory.Pointer (Option Prov))
    (signedSize : Int)
    (msg : Miri.Memory.CheckInAllocMsg)
    (resolve₁ resolve₂ : Miri.Memory.PointerResolver Prov ProvExtra)
    (lookup : Miri.Memory.LiveAllocationLookup)
    (hres : resolve₁ ptr signedSize = resolve₂ ptr signedSize) :
    Miri.Memory.checkAndDerefPtr target ptr signedSize msg resolve₁ lookup =
      Miri.Memory.checkAndDerefPtr target ptr signedSize msg resolve₂ lookup := by
  unfold Miri.Memory.checkAndDerefPtr
  rw [hres]

private theorem annealReadImmediate_indirect_prim_eq
    {ty : Ty} {ly : LayoutTable} (hprim : IsPrimScalarTy ty)
    (mp : Miri.Interpreter.MemPlace AnnealProv) :
    annealReadImmediate ⟨.indirect mp, translateTy ty ly⟩ =
      annealReadMemoryPlace mp (translateTy ty ly) := by
  have hf : (translateTy ty ly).layout.fields = .Primitive := by
    rcases hprim with hk | hk | ⟨it, hk⟩ | ⟨ut, hk⟩ <;>
      (try cases it) <;> (try cases ut) <;>
      (unfold translateTy; rw [hk]; rfl)
  funext st
  unfold annealReadImmediate
  dsimp only
  rw [hf]

private theorem annealResolvePtrWrapping_eq_of_resolvePtr_ok
    {mach : AnnealMachine} {ptr : Miri.Memory.Pointer (Option AnnealProv)}
    {n : Int} {r : Miri.Memory.ResolvedPointer Miri.Memory.BorTag}
    (hok : annealResolvePtr mach ptr n = .ok r) :
    annealResolvePtrWrapping mach ptr n = .ok r := by
  unfold annealResolvePtr at hok
  unfold annealResolvePtrWrapping
  cases hp : ptr.provenance with
  | none => rw [hp] at hok; cases hok
  | some prov =>
    rw [hp] at hok
    cases prov with
    | wildcard => cases hok
    | concrete allocId borTag =>
      dsimp only at hok ⊢
      cases hb : mach.lookupBaseAddr allocId with
      | none => rw [hb] at hok; cases hok
      | some baseAddr =>
        rw [hb] at hok
        dsimp only at hok ⊢
        by_cases hle : baseAddr ≤ ptr.offset.bytes
        · simp only [hle, ↓reduceIte] at hok
          exact hok
        · simp only [hle, ↓reduceIte] at hok
          cases hok

private theorem checkAndDerefPtr_wrapping_of_ok
    {mach : AnnealMachine} {ptr : Miri.Memory.Pointer (Option AnnealProv)}
    {n : Int} {msg : Miri.Memory.CheckInAllocMsg}
    {checked : Option (Miri.Memory.CheckedPointerAccess Miri.Memory.BorTag)}
    (hchk : Miri.Memory.checkAndDerefPtr annealPointerArithmetic ptr n
      msg (annealResolvePtr mach) (annealLookupAlloc mach) = .ok checked) :
    Miri.Memory.checkAndDerefPtr annealPointerArithmetic ptr n
      msg (annealResolvePtrWrapping mach) (annealLookupAlloc mach) = .ok checked := by
  cases hr : annealResolvePtr mach ptr n with
  | ok r =>
    have hw := annealResolvePtrWrapping_eq_of_resolvePtr_ok hr
    rw [checkAndDerefPtr_congr_resolve _ _ _ _ _ _ _ (hw.trans hr.symm)]
    exact hchk
  | error addr =>
    by_cases hf : fitsI64Pub n = true
    · unfold fitsI64Pub at hf
      rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hf
      by_cases hz : n = 0
      · subst hz
        exact hchk
      · rw [checkAndDerefPtr_nonzero_eq _ _ _ _ _ _ hf.1 hf.2 hz, hr] at hchk
        cases hchk
    · have hff : fitsI64Pub n = false := Bool.eq_false_iff.mpr hf
      have hbad : Miri.Memory.checkAndDerefPtr annealPointerArithmetic ptr n msg
          (annealResolvePtr mach) (annealLookupAlloc mach) = .error (.signedSizeOutsideI64 n) := by
        change (if !fitsI64Pub n then
            Except.error (Miri.Memory.AccessError.signedSizeOutsideI64 n) else _) = _
        simp [hff]
      rw [hbad] at hchk
      cases hchk

