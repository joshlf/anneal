    have hrhs_dead_un := hrhs_ub_after s₁ (.ptr ptrVal₁ 8) hslot_l hcopy₁ hmove₁
    cases evalRawPtrLocalOperand_lm3_1 hstate₁ hopKind₂ hdecl_rhs hrhs_ty
        (hmono₁ rhsIdx (himm_rhs.cache_layout hlt_d _)) knownR with
    | ub m'' msg ha_r hm_r =>
