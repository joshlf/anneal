  cases evalRawPtrLocalOperand_lm3_1 hstate_a (Or.inr rfl) hdecl_ptr hptr_ty
      (himm_p.cache_layout hlt_d _) (some (translateTy dstDecl.ty body.layouts)) with
  | ub _ _ ha_l _ =>
