            { ty := 25, layout := scalarLayoutData 8 false }⟩) { m with stack := ⟨#[tfc]⟩ }
        rw [hf]; unfold annealScalarOpsHooks
        simp only [classifyEncodedTyId, bind, EStateM.bind, pure, EStateM.pure]
      rw [hp_tr, hr_tr, hbin_eq]
