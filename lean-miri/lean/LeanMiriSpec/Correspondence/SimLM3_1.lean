    hid hoff hbase hdead hgt0 hlt63
  rw [← checkAndDerefPtr_congr_resolve _ _ _ _ _ _ _ (hw.trans hr.symm)] at hchk
  exact ⟨_, annealReadMemoryPlace_of_check_err _ _ _ st hsz _ hchk⟩

