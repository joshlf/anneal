  obtain ⟨hid_lt, _, _⟩ := halloc.base_addr_valid e he
  obtain ⟨slot_p, mls_p, _, _, hslot_p', hmls_p, _, hloc_p⟩ := hfr.lookup_local hdecl_ptr
