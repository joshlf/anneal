                obtain ⟨la', hfind_la', _, _, hshape_la'⟩ := hsh_fn tgtDecl hdecl_tgt
                have hla_eq : localAlloc = la' := by
                  rw [hfind_la] at hfind_la'; injection hfind_la' with hp; exact (Prod.mk.inj hp).2
