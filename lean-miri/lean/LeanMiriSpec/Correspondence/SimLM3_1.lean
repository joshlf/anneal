  have hchk := checkAndDerefPtr_withoutProvenance_err st.machine addr _ .memoryAccess hgt0 hlt63
  rw [← checkAndDerefPtr_congr_resolve _ _ _ _ (annealResolvePtrWrapping st.machine)
    (annealResolvePtr st.machine) _ rfl] at hchk
  exact ⟨_, annealReadMemoryPlace_of_check_err _ _ _ st hsz _ hchk⟩

