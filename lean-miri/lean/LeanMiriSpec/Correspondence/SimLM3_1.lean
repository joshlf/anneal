  obtain ⟨_, borTag, hprov_eq, _, _, _, e', he'_mem, he'_tag, rfl⟩ := hptrRel
  have he_eq : e' = e :=
    allocMap_mem_tag_injective halloc.tags_nodup he'_mem he_mem (he'_tag.trans he_tag.symm)
  subst he_eq
  refine ⟨hrel_step, ha, m', tf', borTag, hm, hfr', ?_⟩
