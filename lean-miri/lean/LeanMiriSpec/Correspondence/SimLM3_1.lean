  obtain ⟨_, _, hsh_fn⟩ := (halloc.local_alloc_sync tf hframes e he).1 slot_t hslot_t ht_ne
  obtain ⟨localAlloc, hfind_la, _, _, hshape_la⟩ := hsh_fn tgtDecl hdecl_tgt
  obtain ⟨hid_lt, _, _⟩ := halloc.base_addr_valid e he
