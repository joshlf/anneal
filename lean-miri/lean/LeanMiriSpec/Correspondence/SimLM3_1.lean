private theorem int64_neg_ofNat_u64_cancel (n : Nat) (_hlt : n < 2 ^ 32) :
    UInt64.ofNat n + (Int64.ofInt (-((n : Nat) : Int))).toUInt64 = 0 := by
  have heq : Int64.ofInt (-((n : Nat) : Int)) = -(Int64.ofNat n) := by
    rw [Int64.ofInt_neg]; rfl
