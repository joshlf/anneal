theorem annealReadMemoryPlace_of_check_ok_misaligned
    (ptr : Miri.Memory.Pointer (Option AnnealProv))
    (bad : Miri.Memory.Misalignment)
    (lay : Miri.Interpreter.LocalLayout) (n : Int) (st : AnnealStepState)
