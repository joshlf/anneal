      have hbin_err : Miri.Interpreter.ScalarOps.binary
          (annealScalarOpsHooks body.localDecls body.layouts) () .Offset
          ⟨.scalar (.fromScalarInt msc_p), translateTy ptrDecl.ty body.layouts⟩
