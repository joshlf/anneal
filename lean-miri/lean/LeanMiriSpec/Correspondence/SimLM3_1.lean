  let nextPtr : Miri.Memory.Pointer AnnealProv → Miri.Memory.Pointer AnnealProv :=
    fun mptr => ⟨Miri.ABI.Size.ofBytes (annealStackBaseAddr e.allocId + 8), mptr.provenance⟩
  have hrel_next : ∀ mptr, PtrRel allocMap ptrVal mptr →
