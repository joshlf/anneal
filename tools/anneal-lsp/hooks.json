{
  "anneal-spec-lock-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|code_action|write_to_file|replace_file_content|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/anneal-lean}/hooks/pre_tool_use.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "anneal-lean-auto-feedback": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|code_action|write_to_file|replace_file_content|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/anneal-lean}/hooks/post_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
